============================== PROOF =================================

% Proof 1 at 0.12 (+ 0.01) seconds.
% Length of proof is 66.
% Level of proof is 18.
% Maximum clause weight is 35.000.
% Given clauses 217.

1 T(T(x,y),z) = T(T(x,z),y) # label(non_clause) # label(goal).  [goal].
2 0 * x = x.  [assumption].
3 x * 0 = x.  [assumption].
4 x * (x \ y) = y.  [assumption].
5 x \ (x * y) = y.  [assumption].
8 (x * y) * z = (x * (y * z)) * a(x,y,z).  [assumption].
