cnf(c_7621, plain, L(A,T(B,C),(K(B,C) * T(B,D)) / T(B,C)) = K(B,D) * (R(K(B,D),T(B,C),A) \ A),
    inference(paramod, [status(thm)], [c_3964, c_7608])).
