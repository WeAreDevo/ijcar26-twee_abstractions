cnf(c_5357, plain, ((a(A,B,B \ 1) \ B) * ((C * a(A,B,B \ 1)) / C)) / (A \ (A / (B \ 1))) = (C * (B / (B / a(A,B,B \ 1)))) / C,
    inference(paramod, [status(thm)], [c_2267, c_5002])).
