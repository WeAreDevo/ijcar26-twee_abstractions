The conjecture is true! Here is a proof.

Axiom 1 (ax2): ldiv(X, op(X, Y)) = Y.
Axiom 2 (ax3): rdiv(op(X, Y), Y) = X.
Axiom 3 (ax1): op(X, ldiv(X, Y)) = Y.
Axiom 4 (ax4): op(rdiv(X, Y), Y) = X.
Axiom 5 (ax5): op(X, op(Y, op(Z, X))) = op(op(X, op(Y, Z)), X).

Lemma 6: ldiv(rdiv(X, Y), X) = Y.
Proof:
  ldiv(rdiv(X, Y), X)
= { by axiom 4 (ax4) R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), Y)) (peak)
= { by axiom 1 (ax2) }
  Y

Lemma 7: rdiv(op(X, op(Y, op(Z, X))), X) = op(X, op(Y, Z)).
Proof:
  rdiv(op(X, op(Y, op(Z, X))), X)
= { by axiom 5 (ax5) }
  rdiv(op(op(X, op(Y, Z)), X), X) (peak)
= { by axiom 2 (ax3) }
  op(X, op(Y, Z))

Lemma 8: op(X, op(rdiv(Y, op(Z, X)), Z)) = rdiv(op(X, Y), X).
Proof:
  op(X, op(rdiv(Y, op(Z, X)), Z))
= { by lemma 7 R->L }
  rdiv(op(X, op(rdiv(Y, op(Z, X)), op(Z, X))), X) (peak)
= { by axiom 4 (ax4) }
  rdiv(op(X, Y), X)

Lemma 9: op(rdiv(Y, op(Z, X)), Z) = ldiv(X, rdiv(op(X, Y), X)).
Proof:
  op(rdiv(Y, op(Z, X)), Z)
= { by axiom 1 (ax2) R->L }
  ldiv(X, op(X, op(rdiv(Y, op(Z, X)), Z))) (peak)
= { by lemma 8 }
  ldiv(X, rdiv(op(X, Y), X))

Lemma 10: op(rdiv(X, op(Y, X)), Y) = ldiv(X, X).
Proof:
  op(rdiv(X, op(Y, X)), Y) (peak)
= { by lemma 9 }
  ldiv(X, rdiv(op(X, X), X)) (peak)
= { by axiom 2 (ax3) }
  ldiv(X, X)

Lemma 11: rdiv(ldiv(X, X), Y) = rdiv(X, op(Y, X)).
Proof:
  rdiv(ldiv(X, X), Y)
= { by lemma 10 R->L }
  rdiv(op(rdiv(X, op(Y, X)), Y), Y) (peak)
= { by axiom 2 (ax3) }
  rdiv(X, op(Y, X))

Lemma 12: op(X, op(Y, op(ldiv(Y, Z), X))) = op(op(X, Z), X).
Proof:
  op(X, op(Y, op(ldiv(Y, Z), X)))
= { by axiom 5 (ax5) }
  op(op(X, op(Y, ldiv(Y, Z))), X) (peak)
= { by axiom 3 (ax1) }
  op(op(X, Z), X)

Lemma 13: op(X, op(ldiv(X, Y), Z)) = ldiv(Z, op(op(Z, Y), Z)).
Proof:
  op(X, op(ldiv(X, Y), Z))
= { by axiom 1 (ax2) R->L }
  ldiv(Z, op(Z, op(X, op(ldiv(X, Y), Z)))) (peak)
= { by lemma 12 }
  ldiv(Z, op(op(Z, Y), Z))

Lemma 14: op(rdiv(X, op(W, Z)), W) = op(rdiv(X, op(Y, Z)), Y).
Proof:
  op(rdiv(X, op(W, Z)), W)
= { by axiom 1 (ax2) R->L }
  ldiv(Z, op(Z, op(rdiv(X, op(W, Z)), W))) (peak)
= { by lemma 8 }
  ldiv(Z, rdiv(op(Z, X), Z))
= { by lemma 8 R->L }
  ldiv(Z, op(Z, op(rdiv(X, op(Y, Z)), Y))) (peak)
= { by axiom 1 (ax2) }
  op(rdiv(X, op(Y, Z)), Y)

Lemma 15: op(rdiv(X, W), rdiv(W, Z)) = op(rdiv(X, Y), rdiv(Y, Z)).
Proof:
  op(rdiv(X, W), rdiv(W, Z))
= { by axiom 4 (ax4) R->L }
  op(rdiv(X, op(rdiv(W, Z), Z)), rdiv(W, Z)) (peak)
= { by lemma 14 R->L }
  op(rdiv(X, op(rdiv(Y, Z), Z)), rdiv(Y, Z)) (peak)
= { by axiom 4 (ax4) }
  op(rdiv(X, Y), rdiv(Y, Z))

Lemma 16: op(rdiv(op(X, Y), Z), rdiv(Z, W)) = op(X, rdiv(Y, W)).
Proof:
  op(rdiv(op(X, Y), Z), rdiv(Z, W)) (peak)
= { by lemma 15 }
  op(rdiv(op(X, Y), Y), rdiv(Y, W)) (peak)
= { by axiom 2 (ax3) }
  op(X, rdiv(Y, W))

Lemma 17: op(rdiv(Y, Z), rdiv(Z, X)) = ldiv(X, rdiv(op(X, Y), X)).
Proof:
  op(rdiv(Y, Z), rdiv(Z, X))
= { by axiom 4 (ax4) R->L }
  op(rdiv(Y, op(rdiv(Z, X), X)), rdiv(Z, X)) (peak)
= { by lemma 9 }
  ldiv(X, rdiv(op(X, Y), X))

Lemma 18: op(rdiv(X, Y), rdiv(Y, X)) = ldiv(X, X).
Proof:
  op(rdiv(X, Y), rdiv(Y, X)) (peak)
= { by lemma 17 }
  ldiv(X, rdiv(op(X, X), X)) (peak)
= { by axiom 2 (ax3) }
  ldiv(X, X)

Lemma 19: op(X, rdiv(Y, op(X, Y))) = ldiv(op(X, Y), op(X, Y)).
Proof:
  op(X, rdiv(Y, op(X, Y)))
= { by lemma 16 R->L }
  op(rdiv(op(X, Y), Z), rdiv(Z, op(X, Y))) (peak)
= { by lemma 18 }
  ldiv(op(X, Y), op(X, Y))

Lemma 20: op(W, op(ldiv(W, Y), Z)) = op(X, op(ldiv(X, Y), Z)).
Proof:
  op(W, op(ldiv(W, Y), Z))
= { by axiom 1 (ax2) R->L }
  ldiv(Z, op(Z, op(W, op(ldiv(W, Y), Z)))) (peak)
= { by lemma 12 }
  ldiv(Z, op(op(Z, Y), Z))
= { by lemma 12 R->L }
  ldiv(Z, op(Z, op(X, op(ldiv(X, Y), Z)))) (peak)
= { by axiom 1 (ax2) }
  op(X, op(ldiv(X, Y), Z))

Lemma 21: op(rdiv(X, Y), op(Y, Z)) = op(W, op(ldiv(W, X), Z)).
Proof:
  op(rdiv(X, Y), op(Y, Z))
= { by lemma 6 R->L }
  op(rdiv(X, Y), op(ldiv(rdiv(X, Y), X), Z)) (peak)
= { by lemma 20 R->L }
  op(W, op(ldiv(W, X), Z)) (peak)

Lemma 22: op(rdiv(Y, Z), op(Z, X)) = ldiv(X, op(op(X, Y), X)).
Proof:
  op(rdiv(Y, Z), op(Z, X)) (peak)
= { by lemma 21 }
  op(W, op(ldiv(W, Y), X)) (peak)
= { by lemma 13 }
  ldiv(X, op(op(X, Y), X)) (peak)

Lemma 23: op(rdiv(X, W), op(W, Z)) = op(rdiv(X, Y), op(Y, Z)).
Proof:
  op(rdiv(X, W), op(W, Z)) (peak)
= { by lemma 21 }
  op(V, op(ldiv(V, X), Z)) (peak)
= { by lemma 13 }
  ldiv(Z, op(op(Z, X), Z)) (peak)
= { by lemma 22 R->L }
  op(rdiv(X, Y), op(Y, Z)) (peak)

Lemma 24: op(rdiv(op(X, op(Y, Z)), op(W, Z)), W) = op(X, Y).
Proof:
  op(rdiv(op(X, op(Y, Z)), op(W, Z)), W) (peak)
= { by lemma 9 }
  ldiv(Z, rdiv(op(Z, op(X, op(Y, Z))), Z))
= { by axiom 5 (ax5) }
  ldiv(Z, rdiv(op(op(Z, op(X, Y)), Z), Z)) (peak)
= { by axiom 2 (ax3) }
  ldiv(Z, op(Z, op(X, Y)))
= { by axiom 1 (ax2) }
  op(X, Y)

Lemma 25: rdiv(op(X, op(Y, W)), op(Z, W)) = rdiv(op(X, Y), Z).
Proof:
  rdiv(op(X, op(Y, W)), op(Z, W))
= { by axiom 2 (ax3) R->L }
  rdiv(op(rdiv(op(X, op(Y, W)), op(Z, W)), Z), Z) (peak)
= { by lemma 24 }
  rdiv(op(X, Y), Z)

Lemma 26: rdiv(op(rdiv(X, Y), op(Y, Z)), op(W, Z)) = rdiv(X, W).
Proof:
  rdiv(op(rdiv(X, Y), op(Y, Z)), op(W, Z)) (peak)
= { by lemma 23 }
  rdiv(op(rdiv(X, W), op(W, Z)), op(W, Z)) (peak)
= { by axiom 2 (ax3) }
  rdiv(X, W)

Lemma 27: op(rdiv(op(X, Y), Z), op(Z, W)) = op(X, op(Y, W)).
Proof:
  op(rdiv(op(X, Y), Z), op(Z, W)) (peak)
= { by lemma 22 }
  ldiv(W, op(op(W, op(X, Y)), W)) (peak)
= { by axiom 5 (ax5) R->L }
  ldiv(W, op(W, op(X, op(Y, W))))
= { by axiom 1 (ax2) }
  op(X, op(Y, W))

Lemma 28: op(rdiv(ldiv(op(X, X), op(X, X)), Y), op(Y, X)) = X.
Proof:
  op(rdiv(ldiv(op(X, X), op(X, X)), Y), op(Y, X))
= { by lemma 19 R->L }
  op(rdiv(op(X, rdiv(X, op(X, X))), Y), op(Y, X)) (peak)
= { by lemma 27 }
  op(X, op(rdiv(X, op(X, X)), X))
= { by lemma 8 }
  rdiv(op(X, X), X)
= { by axiom 2 (ax3) }
  X

Lemma 29: rdiv(op(X, X), op(Y, op(X, X))) = rdiv(X, op(Y, X)).
Proof:
  rdiv(op(X, X), op(Y, op(X, X)))
= { by lemma 11 R->L }
  rdiv(ldiv(op(X, X), op(X, X)), Y)
= { by lemma 26 R->L }
  rdiv(op(rdiv(ldiv(op(X, X), op(X, X)), Z), op(Z, X)), op(Y, X)) (peak)
= { by lemma 28 }
  rdiv(X, op(Y, X))

Lemma 30: ldiv(op(X, op(Y, Y)), op(X, op(Y, Y))) = ldiv(op(X, Y), op(X, Y)).
Proof:
  ldiv(op(X, op(Y, Y)), op(X, op(Y, Y)))
= { by lemma 19 R->L }
  op(X, rdiv(op(Y, Y), op(X, op(Y, Y)))) (peak)
= { by lemma 29 }
  op(X, rdiv(Y, op(X, Y)))
= { by lemma 19 }
  ldiv(op(X, Y), op(X, Y))

Lemma 31: rdiv(op(X, op(Y, W)), op(op(Z, op(X, Y)), W)) = rdiv(op(X, op(Y, Y)), op(Z, op(X, op(Y, Y)))).
Proof:
  rdiv(op(X, op(Y, W)), op(op(Z, op(X, Y)), W)) (peak)
= { by lemma 25 }
  rdiv(op(X, Y), op(Z, op(X, Y)))
= { by lemma 11 R->L }
  rdiv(ldiv(op(X, Y), op(X, Y)), Z)
= { by lemma 30 R->L }
  rdiv(ldiv(op(X, op(Y, Y)), op(X, op(Y, Y))), Z) (peak)
= { by lemma 11 }
  rdiv(op(X, op(Y, Y)), op(Z, op(X, op(Y, Y))))

Lemma 32: op(op(X, op(Y, Z)), Z) = op(X, op(Y, op(Z, Z))).
Proof:
  op(op(X, op(Y, Z)), Z)
= { by lemma 6 R->L }
  ldiv(rdiv(op(Y, op(Z, Z)), op(op(X, op(Y, Z)), Z)), op(Y, op(Z, Z))) (peak)
= { by lemma 31 }
  ldiv(rdiv(op(Y, op(Z, Z)), op(X, op(Y, op(Z, Z)))), op(Y, op(Z, Z)))
= { by lemma 6 }
  op(X, op(Y, op(Z, Z)))

Goal 1 (goal): op(sk_a, op(sk_b, op(sk_c, sk_c))) = op(op(sk_a, op(sk_b, sk_c)), sk_c).
Proof:
  op(sk_a, op(sk_b, op(sk_c, sk_c)))
= { by lemma 32 R->L }
  op(op(sk_a, op(sk_b, sk_c)), sk_c) (peak)

RESULT: Unsatisfiable (the axioms are contradictory).
