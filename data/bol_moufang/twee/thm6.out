The conjecture is true! Here is a proof.

Axiom 1 (ax2): ldiv(X, op(X, Y)) = Y.
Axiom 2 (ax3): rdiv(op(X, Y), Y) = X.
Axiom 3 (ax1): op(X, ldiv(X, Y)) = Y.
Axiom 4 (ax4): op(rdiv(X, Y), Y) = X.
Axiom 5 (ax5): op(X, op(Y, op(Z, Z))) = op(op(X, op(Y, Z)), Z).

Lemma 6: rdiv(op(X, op(Y, op(Z, Z))), Z) = op(X, op(Y, Z)).
Proof:
  rdiv(op(X, op(Y, op(Z, Z))), Z)
= { by axiom 5 (ax5) }
  rdiv(op(op(X, op(Y, Z)), Z), Z) (peak)
= { by axiom 2 (ax3) }
  op(X, op(Y, Z))

Lemma 7: op(X, op(rdiv(Y, op(Z, Z)), Z)) = rdiv(op(X, Y), Z).
Proof:
  op(X, op(rdiv(Y, op(Z, Z)), Z))
= { by lemma 6 R->L }
  rdiv(op(X, op(rdiv(Y, op(Z, Z)), op(Z, Z))), Z) (peak)
= { by axiom 4 (ax4) }
  rdiv(op(X, Y), Z)

Lemma 8: op(rdiv(X, op(Y, Y)), Y) = ldiv(Z, rdiv(op(Z, X), Y)).
Proof:
  op(rdiv(X, op(Y, Y)), Y)
= { by axiom 1 (ax2) R->L }
  ldiv(Z, op(Z, op(rdiv(X, op(Y, Y)), Y))) (peak)
= { by lemma 7 }
  ldiv(Z, rdiv(op(Z, X), Y))

Lemma 9: ldiv(Y, Y) = ldiv(X, X).
Proof:
  ldiv(Y, Y)
= { by axiom 2 (ax3) R->L }
  ldiv(Y, rdiv(op(Y, Z), Z)) (peak)
= { by lemma 8 R->L }
  op(rdiv(Z, op(Z, Z)), Z) (peak)
= { by lemma 8 }
  ldiv(X, rdiv(op(X, Z), Z)) (peak)
= { by axiom 2 (ax3) }
  ldiv(X, X)

Lemma 10: op(rdiv(X, op(X, X)), X) = ldiv(Y, Y).
Proof:
  op(rdiv(X, op(X, X)), X) (peak)
= { by lemma 8 }
  ldiv(Y, rdiv(op(Y, X), X)) (peak)
= { by axiom 2 (ax3) }
  ldiv(Y, Y)

Lemma 11: op(X, ldiv(Y, Y)) = X.
Proof:
  op(X, ldiv(Y, Y)) (peak)
= { by lemma 10 R->L }
  op(X, op(rdiv(Z, op(Z, Z)), Z)) (peak)
= { by lemma 7 }
  rdiv(op(X, Z), Z)
= { by axiom 2 (ax3) }
  X

Lemma 12: ldiv(W, rdiv(op(W, Y), Z)) = ldiv(X, rdiv(op(X, Y), Z)).
Proof:
  ldiv(W, rdiv(op(W, Y), Z))
= { by lemma 7 R->L }
  ldiv(W, op(W, op(rdiv(Y, op(Z, Z)), Z))) (peak)
= { by axiom 1 (ax2) }
  op(rdiv(Y, op(Z, Z)), Z)
= { by axiom 1 (ax2) R->L }
  ldiv(X, op(X, op(rdiv(Y, op(Z, Z)), Z))) (peak)
= { by lemma 7 }
  ldiv(X, rdiv(op(X, Y), Z))

Lemma 13: ldiv(Z, rdiv(Z, Y)) = ldiv(X, rdiv(X, Y)).
Proof:
  ldiv(Z, rdiv(Z, Y))
= { by lemma 11 R->L }
  ldiv(Z, rdiv(op(Z, ldiv(W, W)), Y)) (peak)
= { by lemma 12 }
  ldiv(X, rdiv(op(X, ldiv(W, W)), Y)) (peak)
= { by lemma 11 }
  ldiv(X, rdiv(X, Y))

Lemma 14: rdiv(X, ldiv(Y, X)) = Y.
Proof:
  rdiv(X, ldiv(Y, X))
= { by axiom 3 (ax1) R->L }
  rdiv(op(Y, ldiv(Y, X)), ldiv(Y, X)) (peak)
= { by axiom 2 (ax3) }
  Y

Lemma 15: rdiv(X, ldiv(Y, Y)) = X.
Proof:
  rdiv(X, ldiv(Y, Y)) (peak)
= { by lemma 9 }
  rdiv(X, ldiv(X, X)) (peak)
= { by lemma 14 }
  X

Lemma 16: op(rdiv(Y, op(Z, Z)), Z) = ldiv(rdiv(X, Y), rdiv(X, Z)).
Proof:
  op(rdiv(Y, op(Z, Z)), Z) (peak)
= { by lemma 8 }
  ldiv(rdiv(X, Y), rdiv(op(rdiv(X, Y), Y), Z)) (peak)
= { by axiom 4 (ax4) }
  ldiv(rdiv(X, Y), rdiv(X, Z))

Lemma 17: op(rdiv(X, op(Y, Y)), Y) = ldiv(rdiv(op(Z, Y), X), Z).
Proof:
  op(rdiv(X, op(Y, Y)), Y)
= { by lemma 16 }
  ldiv(rdiv(op(Z, Y), X), rdiv(op(Z, Y), Y)) (peak)
= { by axiom 2 (ax3) }
  ldiv(rdiv(op(Z, Y), X), Z)

Lemma 18: ldiv(rdiv(op(X, Y), ldiv(Z, W)), X) = ldiv(Z, rdiv(W, Y)).
Proof:
  ldiv(rdiv(op(X, Y), ldiv(Z, W)), X) (peak)
= { by lemma 17 R->L }
  op(rdiv(ldiv(Z, W), op(Y, Y)), Y) (peak)
= { by lemma 8 }
  ldiv(Z, rdiv(op(Z, ldiv(Z, W)), Y)) (peak)
= { by axiom 3 (ax1) }
  ldiv(Z, rdiv(W, Y))

Lemma 19: ldiv(op(Z, Y), Z) = ldiv(X, rdiv(X, Y)).
Proof:
  ldiv(op(Z, Y), Z)
= { by lemma 15 R->L }
  ldiv(rdiv(op(Z, Y), ldiv(W, W)), Z) (peak)
= { by lemma 9 }
  ldiv(rdiv(op(Z, Y), ldiv(X, X)), Z) (peak)
= { by lemma 18 }
  ldiv(X, rdiv(X, Y))

Lemma 20: ldiv(op(Z, Y), Z) = ldiv(op(X, Y), X).
Proof:
  ldiv(op(Z, Y), Z) (peak)
= { by lemma 19 }
  ldiv(op(X, Y), rdiv(op(X, Y), Y)) (peak)
= { by axiom 2 (ax3) }
  ldiv(op(X, Y), X)

Lemma 21: ldiv(rdiv(X, Y), X) = Y.
Proof:
  ldiv(rdiv(X, Y), X)
= { by axiom 4 (ax4) R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), Y)) (peak)
= { by axiom 1 (ax2) }
  Y

Lemma 22: op(X, op(rdiv(Y, Z), op(Z, Z))) = op(op(X, Y), Z).
Proof:
  op(X, op(rdiv(Y, Z), op(Z, Z)))
= { by axiom 5 (ax5) }
  op(op(X, op(rdiv(Y, Z), Z)), Z) (peak)
= { by axiom 4 (ax4) }
  op(op(X, Y), Z)

Lemma 23: op(rdiv(X, Y), op(Y, Y)) = ldiv(Z, op(op(Z, X), Y)).
Proof:
  op(rdiv(X, Y), op(Y, Y))
= { by axiom 1 (ax2) R->L }
  ldiv(Z, op(Z, op(rdiv(X, Y), op(Y, Y)))) (peak)
= { by lemma 22 }
  ldiv(Z, op(op(Z, X), Y))

Lemma 24: ldiv(W, op(op(W, Y), Z)) = ldiv(X, op(op(X, Y), Z)).
Proof:
  ldiv(W, op(op(W, Y), Z))
= { by lemma 22 R->L }
  ldiv(W, op(W, op(rdiv(Y, Z), op(Z, Z)))) (peak)
= { by axiom 1 (ax2) }
  op(rdiv(Y, Z), op(Z, Z))
= { by axiom 1 (ax2) R->L }
  ldiv(X, op(X, op(rdiv(Y, Z), op(Z, Z)))) (peak)
= { by lemma 22 }
  ldiv(X, op(op(X, Y), Z))

Lemma 25: ldiv(rdiv(X, Y), op(X, Z)) = ldiv(W, op(op(W, Y), Z)).
Proof:
  ldiv(rdiv(X, Y), op(X, Z))
= { by axiom 4 (ax4) R->L }
  ldiv(rdiv(X, Y), op(op(rdiv(X, Y), Y), Z)) (peak)
= { by lemma 24 R->L }
  ldiv(W, op(op(W, Y), Z)) (peak)

Lemma 26: op(rdiv(X, Y), op(Y, Y)) = ldiv(rdiv(Z, X), op(Z, Y)).
Proof:
  op(rdiv(X, Y), op(Y, Y)) (peak)
= { by lemma 23 }
  ldiv(W, op(op(W, X), Y)) (peak)
= { by lemma 25 R->L }
  ldiv(rdiv(Z, X), op(Z, Y)) (peak)

Lemma 27: op(rdiv(X, op(Y, op(Z, Z))), op(Y, Z)) = rdiv(X, Z).
Proof:
  op(rdiv(X, op(Y, op(Z, Z))), op(Y, Z))
= { by lemma 6 R->L }
  rdiv(op(rdiv(X, op(Y, op(Z, Z))), op(Y, op(Z, Z))), Z) (peak)
= { by axiom 4 (ax4) }
  rdiv(X, Z)

Lemma 28: rdiv(rdiv(X, Y), op(Z, Y)) = rdiv(X, op(Z, op(Y, Y))).
Proof:
  rdiv(rdiv(X, Y), op(Z, Y))
= { by lemma 27 R->L }
  rdiv(op(rdiv(X, op(Z, op(Y, Y))), op(Z, Y)), op(Z, Y)) (peak)
= { by axiom 2 (ax3) }
  rdiv(X, op(Z, op(Y, Y)))

Lemma 29: rdiv(X, ldiv(rdiv(Y, Z), op(Y, W))) = rdiv(rdiv(X, W), Z).
Proof:
  rdiv(X, ldiv(rdiv(Y, Z), op(Y, W))) (peak)
= { by lemma 26 R->L }
  rdiv(X, op(rdiv(Z, W), op(W, W)))
= { by lemma 28 R->L }
  rdiv(rdiv(X, W), op(rdiv(Z, W), W)) (peak)
= { by axiom 4 (ax4) }
  rdiv(rdiv(X, W), Z)

Lemma 30: op(rdiv(X, op(Y, Z)), op(Y, op(Z, Z))) = op(X, Z).
Proof:
  op(rdiv(X, op(Y, Z)), op(Y, op(Z, Z)))
= { by axiom 5 (ax5) }
  op(op(rdiv(X, op(Y, Z)), op(Y, Z)), Z) (peak)
= { by axiom 4 (ax4) }
  op(X, Z)

Lemma 31: rdiv(op(X, Y), op(Z, op(Y, Y))) = rdiv(X, op(Z, Y)).
Proof:
  rdiv(op(X, Y), op(Z, op(Y, Y)))
= { by lemma 30 R->L }
  rdiv(op(rdiv(X, op(Z, Y)), op(Z, op(Y, Y))), op(Z, op(Y, Y))) (peak)
= { by axiom 2 (ax3) }
  rdiv(X, op(Z, Y))

Lemma 32: rdiv(X, ldiv(Y, rdiv(op(Y, Z), W))) = rdiv(op(X, W), Z).
Proof:
  rdiv(X, ldiv(Y, rdiv(op(Y, Z), W))) (peak)
= { by lemma 8 R->L }
  rdiv(X, op(rdiv(Z, op(W, W)), W))
= { by lemma 31 R->L }
  rdiv(op(X, W), op(rdiv(Z, op(W, W)), op(W, W))) (peak)
= { by axiom 4 (ax4) }
  rdiv(op(X, W), Z)

Lemma 33: op(X, ldiv(rdiv(Y, Z), op(Y, W))) = op(op(X, Z), W).
Proof:
  op(X, ldiv(rdiv(Y, Z), op(Y, W))) (peak)
= { by lemma 26 R->L }
  op(X, op(rdiv(Z, W), op(W, W))) (peak)
= { by lemma 22 }
  op(op(X, Z), W)

Lemma 34: rdiv(X, ldiv(Y, rdiv(Y, Z))) = op(X, Z).
Proof:
  rdiv(X, ldiv(Y, rdiv(Y, Z)))
= { by axiom 2 (ax3) R->L }
  rdiv(X, ldiv(Y, rdiv(rdiv(op(Y, W), W), Z)))
= { by lemma 29 R->L }
  rdiv(X, ldiv(Y, rdiv(op(Y, W), ldiv(rdiv(V, Z), op(V, W))))) (peak)
= { by lemma 32 }
  rdiv(op(X, ldiv(rdiv(V, Z), op(V, W))), W)
= { by lemma 33 }
  rdiv(op(op(X, Z), W), W)
= { by axiom 2 (ax3) }
  op(X, Z)

Lemma 35: ldiv(X, rdiv(X, ldiv(Y, Z))) = ldiv(Z, Y).
Proof:
  ldiv(X, rdiv(X, ldiv(Y, Z))) (peak)
= { by lemma 13 }
  ldiv(Z, rdiv(Z, ldiv(Y, Z))) (peak)
= { by lemma 14 }
  ldiv(Z, Y)

Lemma 36: op(X, ldiv(Y, Z)) = rdiv(X, ldiv(Z, Y)).
Proof:
  op(X, ldiv(Y, Z))
= { by lemma 34 R->L }
  rdiv(X, ldiv(W, rdiv(W, ldiv(Y, Z)))) (peak)
= { by lemma 35 }
  rdiv(X, ldiv(Z, Y))

Lemma 37: ldiv(X, op(op(X, ldiv(Y, Z)), W)) = ldiv(Y, op(Z, W)).
Proof:
  ldiv(X, op(op(X, ldiv(Y, Z)), W)) (peak)
= { by lemma 24 }
  ldiv(Y, op(op(Y, ldiv(Y, Z)), W)) (peak)
= { by axiom 3 (ax1) }
  ldiv(Y, op(Z, W))

Lemma 38: ldiv(rdiv(X, ldiv(Y, Z)), op(X, W)) = ldiv(Y, op(Z, W)).
Proof:
  ldiv(rdiv(X, ldiv(Y, Z)), op(X, W)) (peak)
= { by lemma 25 }
  ldiv(V, op(op(V, ldiv(Y, Z)), W)) (peak)
= { by lemma 37 }
  ldiv(Y, op(Z, W))

Lemma 39: rdiv(op(X, Y), ldiv(Z, op(W, Y))) = rdiv(X, ldiv(Z, W)).
Proof:
  rdiv(op(X, Y), ldiv(Z, op(W, Y)))
= { by lemma 38 R->L }
  rdiv(op(X, Y), ldiv(rdiv(X, ldiv(Z, W)), op(X, Y))) (peak)
= { by lemma 14 }
  rdiv(X, ldiv(Z, W))

Lemma 40: rdiv(op(X, Z), ldiv(Y, ldiv(W, W))) = rdiv(X, ldiv(Y, rdiv(Z, op(Z, Z)))).
Proof:
  rdiv(op(X, Z), ldiv(Y, ldiv(W, W))) (peak)
= { by lemma 10 R->L }
  rdiv(op(X, Z), ldiv(Y, op(rdiv(Z, op(Z, Z)), Z))) (peak)
= { by lemma 39 }
  rdiv(X, ldiv(Y, rdiv(Z, op(Z, Z))))

Lemma 41: rdiv(op(X, Y), ldiv(Z, W)) = rdiv(X, ldiv(Z, rdiv(W, Y))).
Proof:
  rdiv(op(X, Y), ldiv(Z, W))
= { by lemma 32 R->L }
  rdiv(X, ldiv(Z, rdiv(op(Z, ldiv(Z, W)), Y))) (peak)
= { by axiom 3 (ax1) }
  rdiv(X, ldiv(Z, rdiv(W, Y)))

Lemma 42: rdiv(X, ldiv(op(Y, Z), Y)) = op(X, Z).
Proof:
  rdiv(X, ldiv(op(Y, Z), Y)) (peak)
= { by lemma 20 }
  rdiv(X, ldiv(op(X, Z), X)) (peak)
= { by lemma 14 }
  op(X, Z)

Lemma 43: op(X, ldiv(Y, op(op(Y, Z), W))) = op(op(X, Z), W).
Proof:
  op(X, ldiv(Y, op(op(Y, Z), W))) (peak)
= { by lemma 23 R->L }
  op(X, op(rdiv(Z, W), op(W, W))) (peak)
= { by lemma 22 }
  op(op(X, Z), W)

Lemma 44: op(op(X, ldiv(Y, Z)), W) = op(X, ldiv(Y, op(Z, W))).
Proof:
  op(op(X, ldiv(Y, Z)), W)
= { by lemma 43 R->L }
  op(X, ldiv(V, op(op(V, ldiv(Y, Z)), W))) (peak)
= { by lemma 37 }
  op(X, ldiv(Y, op(Z, W)))

Lemma 45: op(X, ldiv(op(Y, Z), Y)) = rdiv(X, Z).
Proof:
  op(X, ldiv(op(Y, Z), Y)) (peak)
= { by lemma 19 }
  op(X, ldiv(X, rdiv(X, Z))) (peak)
= { by axiom 3 (ax1) }
  rdiv(X, Z)

Lemma 46: op(X, ldiv(op(W, Y), op(W, Z))) = op(rdiv(X, Y), Z).
Proof:
  op(X, ldiv(op(W, Y), op(W, Z)))
= { by lemma 42 R->L }
  op(X, ldiv(rdiv(W, ldiv(op(V, Y), V)), op(W, Z))) (peak)
= { by lemma 33 }
  op(op(X, ldiv(op(V, Y), V)), Z)
= { by lemma 45 }
  op(rdiv(X, Y), Z)

Lemma 47: rdiv(X, ldiv(op(Y, Z), op(Y, op(Z, Z)))) = ldiv(rdiv(op(W, Z), X), W).
Proof:
  rdiv(X, ldiv(op(Y, Z), op(Y, op(Z, Z))))
= { by lemma 36 R->L }
  op(X, ldiv(op(Y, op(Z, Z)), op(Y, Z)))
= { by lemma 42 R->L }
  op(X, ldiv(rdiv(Y, ldiv(op(V, op(Z, Z)), V)), op(Y, Z))) (peak)
= { by lemma 33 }
  op(op(X, ldiv(op(V, op(Z, Z)), V)), Z)
= { by lemma 44 }
  op(X, ldiv(op(V, op(Z, Z)), op(V, Z)))
= { by lemma 46 }
  op(rdiv(X, op(Z, Z)), Z)
= { by lemma 17 }
  ldiv(rdiv(op(W, Z), X), W) (peak)

Lemma 48: rdiv(X, op(Y, rdiv(ldiv(Z, X), ldiv(X, Z)))) = rdiv(Z, rdiv(Y, ldiv(X, Z))).
Proof:
  rdiv(X, op(Y, rdiv(ldiv(Z, X), ldiv(X, Z))))
= { by lemma 36 R->L }
  rdiv(X, op(Y, op(ldiv(Z, X), ldiv(Z, X))))
= { by axiom 3 (ax1) R->L }
  rdiv(op(Z, ldiv(Z, X)), op(Y, op(ldiv(Z, X), ldiv(Z, X)))) (peak)
= { by lemma 31 }
  rdiv(Z, op(Y, ldiv(Z, X)))
= { by lemma 36 }
  rdiv(Z, rdiv(Y, ldiv(X, Z)))

Lemma 49: rdiv(op(X, ldiv(Y, op(Z, W))), W) = rdiv(X, ldiv(Z, Y)).
Proof:
  rdiv(op(X, ldiv(Y, op(Z, W))), W)
= { by lemma 32 R->L }
  rdiv(X, ldiv(Z, rdiv(op(Z, W), ldiv(Y, op(Z, W))))) (peak)
= { by lemma 14 }
  rdiv(X, ldiv(Z, Y))

Lemma 50: rdiv(op(X, Y), ldiv(rdiv(op(Y, Y), Z), ldiv(W, W))) = rdiv(op(X, Y), rdiv(Z, op(Y, Y))).
Proof:
  rdiv(op(X, Y), ldiv(rdiv(op(Y, Y), Z), ldiv(W, W))) (peak)
= { by lemma 40 }
  rdiv(X, ldiv(rdiv(op(Y, Y), Z), rdiv(Y, op(Y, Y))))
= { by lemma 41 R->L }
  rdiv(op(X, op(Y, Y)), ldiv(rdiv(op(Y, Y), Z), Y))
= { by lemma 47 R->L }
  rdiv(op(X, op(Y, Y)), rdiv(Z, ldiv(op(X, Y), op(X, op(Y, Y)))))
= { by lemma 48 R->L }
  rdiv(op(X, Y), op(Z, rdiv(ldiv(op(X, op(Y, Y)), op(X, Y)), ldiv(op(X, Y), op(X, op(Y, Y)))))) (peak)
= { by lemma 47 }
  rdiv(op(X, Y), op(Z, ldiv(rdiv(op(V, Y), ldiv(op(X, op(Y, Y)), op(X, Y))), V))) (peak)
= { by lemma 36 }
  rdiv(op(X, Y), rdiv(Z, ldiv(V, rdiv(op(V, Y), ldiv(op(X, op(Y, Y)), op(X, Y))))))
= { by lemma 32 }
  rdiv(op(X, Y), rdiv(op(Z, ldiv(op(X, op(Y, Y)), op(X, Y))), Y))
= { by lemma 49 }
  rdiv(op(X, Y), rdiv(Z, ldiv(X, op(X, op(Y, Y)))))
= { by axiom 1 (ax2) }
  rdiv(op(X, Y), rdiv(Z, op(Y, Y)))

Lemma 51: ldiv(rdiv(op(X, X), Y), ldiv(Z, Z)) = rdiv(Y, op(X, X)).
Proof:
  ldiv(rdiv(op(X, X), Y), ldiv(Z, Z))
= { by lemma 21 R->L }
  ldiv(rdiv(op(W, X), ldiv(rdiv(op(X, X), Y), ldiv(Z, Z))), op(W, X)) (peak)
= { by lemma 50 }
  ldiv(rdiv(op(W, X), rdiv(Y, op(X, X))), op(W, X))
= { by lemma 21 }
  rdiv(Y, op(X, X))

Lemma 52: rdiv(ldiv(X, op(Y, Y)), op(Y, Y)) = ldiv(X, ldiv(Z, Z)).
Proof:
  rdiv(ldiv(X, op(Y, Y)), op(Y, Y))
= { by lemma 51 R->L }
  ldiv(rdiv(op(Y, Y), ldiv(X, op(Y, Y))), ldiv(Z, Z)) (peak)
= { by lemma 14 }
  ldiv(X, ldiv(Z, Z))

Lemma 53: ldiv(rdiv(X, Y), ldiv(Z, Z)) = rdiv(Y, X).
Proof:
  ldiv(rdiv(X, Y), ldiv(Z, Z)) (peak)
= { by lemma 52 R->L }
  rdiv(ldiv(rdiv(X, Y), op(X, X)), op(X, X))
= { by lemma 26 R->L }
  rdiv(op(rdiv(Y, X), op(X, X)), op(X, X)) (peak)
= { by axiom 2 (ax3) }
  rdiv(Y, X)

Lemma 54: ldiv(rdiv(X, Y), rdiv(X, Z)) = ldiv(W, rdiv(op(W, Y), Z)).
Proof:
  ldiv(rdiv(X, Y), rdiv(X, Z))
= { by axiom 4 (ax4) R->L }
  ldiv(rdiv(X, Y), rdiv(op(rdiv(X, Y), Y), Z)) (peak)
= { by lemma 12 R->L }
  ldiv(W, rdiv(op(W, Y), Z)) (peak)

Lemma 55: ldiv(rdiv(op(W, Z), Y), W) = ldiv(X, rdiv(op(X, Y), Z)).
Proof:
  ldiv(rdiv(op(W, Z), Y), W)
= { by axiom 2 (ax3) R->L }
  ldiv(rdiv(op(W, Z), Y), rdiv(op(W, Z), Z)) (peak)
= { by lemma 54 }
  ldiv(X, rdiv(op(X, Y), Z)) (peak)

Lemma 56: rdiv(X, ldiv(rdiv(op(Y, Z), W), Y)) = rdiv(op(X, Z), W).
Proof:
  rdiv(X, ldiv(rdiv(op(Y, Z), W), Y)) (peak)
= { by lemma 55 }
  rdiv(X, ldiv(V, rdiv(op(V, W), Z))) (peak)
= { by lemma 32 }
  rdiv(op(X, Z), W)

Lemma 57: op(op(X, Y), ldiv(op(Z, Y), W)) = op(X, ldiv(Z, W)).
Proof:
  op(op(X, Y), ldiv(op(Z, Y), W))
= { by lemma 43 R->L }
  op(X, ldiv(Z, op(op(Z, Y), ldiv(op(Z, Y), W)))) (peak)
= { by axiom 3 (ax1) }
  op(X, ldiv(Z, W))

Lemma 58: op(rdiv(X, Y), ldiv(Z, W)) = op(X, ldiv(op(Z, Y), W)).
Proof:
  op(rdiv(X, Y), ldiv(Z, W))
= { by lemma 57 R->L }
  op(op(rdiv(X, Y), Y), ldiv(op(Z, Y), W)) (peak)
= { by axiom 4 (ax4) }
  op(X, ldiv(op(Z, Y), W))

Lemma 59: rdiv(X, ldiv(op(Y, Z), op(Y, W))) = op(rdiv(X, W), Z).
Proof:
  rdiv(X, ldiv(op(Y, Z), op(Y, W)))
= { by lemma 36 R->L }
  op(X, ldiv(op(Y, W), op(Y, Z)))
= { by lemma 58 R->L }
  op(rdiv(X, W), ldiv(Y, op(Y, Z))) (peak)
= { by axiom 1 (ax2) }
  op(rdiv(X, W), Z)

Lemma 60: ldiv(X, op(op(X, op(Y, Z)), Z)) = op(Y, op(Z, Z)).
Proof:
  ldiv(X, op(op(X, op(Y, Z)), Z)) (peak)
= { by axiom 5 (ax5) R->L }
  ldiv(X, op(X, op(Y, op(Z, Z))))
= { by axiom 1 (ax2) }
  op(Y, op(Z, Z))

Lemma 61: ldiv(rdiv(X, op(Y, Z)), op(X, Z)) = op(Y, op(Z, Z)).
Proof:
  ldiv(rdiv(X, op(Y, Z)), op(X, Z))
= { by axiom 4 (ax4) R->L }
  ldiv(rdiv(X, op(Y, Z)), op(op(rdiv(X, op(Y, Z)), op(Y, Z)), Z)) (peak)
= { by lemma 60 }
  op(Y, op(Z, Z))

Lemma 62: rdiv(ldiv(rdiv(X, op(Y, op(Z, Z))), op(X, op(Z, Z))), Z) = op(Y, op(op(Z, Z), Z)).
Proof:
  rdiv(ldiv(rdiv(X, op(Y, op(Z, Z))), op(X, op(Z, Z))), Z) (peak)
= { by lemma 61 }
  rdiv(op(Y, op(op(Z, Z), op(Z, Z))), Z)
= { by lemma 6 }
  op(Y, op(op(Z, Z), Z))

Lemma 63: ldiv(rdiv(op(X, Y), Z), op(X, W)) = ldiv(V, op(rdiv(op(V, Z), Y), W)).
Proof:
  ldiv(rdiv(op(X, Y), Z), op(X, W))
= { by lemma 32 R->L }
  ldiv(rdiv(X, ldiv(V, rdiv(op(V, Z), Y))), op(X, W)) (peak)
= { by lemma 38 }
  ldiv(V, op(rdiv(op(V, Z), Y), W))

Lemma 64: ldiv(op(W, Y), op(W, Z)) = ldiv(X, op(rdiv(X, Y), Z)).
Proof:
  ldiv(op(W, Y), op(W, Z))
= { by lemma 37 R->L }
  ldiv(V, op(op(V, ldiv(op(W, Y), W)), Z)) (peak)
= { by lemma 19 }
  ldiv(V, op(op(V, ldiv(X, rdiv(X, Y))), Z)) (peak)
= { by lemma 37 }
  ldiv(X, op(rdiv(X, Y), Z))

Lemma 65: ldiv(op(Z, op(X, X)), op(Z, X)) = ldiv(X, ldiv(Y, Y)).
Proof:
  ldiv(op(Z, op(X, X)), op(Z, X)) (peak)
= { by lemma 64 }
  ldiv(X, op(rdiv(X, op(X, X)), X)) (peak)
= { by lemma 10 }
  ldiv(X, ldiv(Y, Y)) (peak)

Lemma 66: op(X, rdiv(ldiv(X, Y), ldiv(Y, X))) = ldiv(rdiv(X, Y), Y).
Proof:
  op(X, rdiv(ldiv(X, Y), ldiv(Y, X)))
= { by lemma 36 R->L }
  op(X, op(ldiv(X, Y), ldiv(X, Y)))
= { by lemma 14 R->L }
  op(rdiv(Y, ldiv(X, Y)), op(ldiv(X, Y), ldiv(X, Y))) (peak)
= { by lemma 23 }
  ldiv(Z, op(op(Z, Y), ldiv(X, Y))) (peak)
= { by lemma 36 }
  ldiv(Z, rdiv(op(Z, Y), ldiv(Y, X)))
= { by lemma 41 }
  ldiv(Z, rdiv(Z, ldiv(Y, rdiv(X, Y))))
= { by lemma 35 }
  ldiv(rdiv(X, Y), Y)

Lemma 67: rdiv(ldiv(X, X), Y) = rdiv(Y, op(Y, Y)).
Proof:
  rdiv(ldiv(X, X), Y) (peak)
= { by lemma 10 R->L }
  rdiv(op(rdiv(Y, op(Y, Y)), Y), Y) (peak)
= { by axiom 2 (ax3) }
  rdiv(Y, op(Y, Y))

Lemma 68: ldiv(ldiv(X, X), rdiv(Y, op(Y, Y))) = ldiv(op(Z, Y), Z).
Proof:
  ldiv(ldiv(X, X), rdiv(Y, op(Y, Y))) (peak)
= { by lemma 67 R->L }
  ldiv(ldiv(X, X), rdiv(ldiv(X, X), Y)) (peak)
= { by lemma 19 R->L }
  ldiv(op(Z, Y), Z) (peak)

Lemma 69: ldiv(op(Z, Y), op(Z, op(Y, Y))) = ldiv(ldiv(X, X), Y).
Proof:
  ldiv(op(Z, Y), op(Z, op(Y, Y)))
= { by lemma 38 R->L }
  ldiv(rdiv(W, ldiv(op(Z, Y), Z)), op(W, op(Y, Y))) (peak)
= { by lemma 68 R->L }
  ldiv(rdiv(W, ldiv(ldiv(X, X), rdiv(Y, op(Y, Y)))), op(W, op(Y, Y))) (peak)
= { by lemma 38 }
  ldiv(ldiv(X, X), op(rdiv(Y, op(Y, Y)), op(Y, Y)))
= { by axiom 4 (ax4) }
  ldiv(ldiv(X, X), Y)

Lemma 70: op(op(X, Y), ldiv(op(op(Z, op(X, X)), Y), op(Z, X))) = ldiv(W, W).
Proof:
  op(op(X, Y), ldiv(op(op(Z, op(X, X)), Y), op(Z, X))) (peak)
= { by lemma 57 }
  op(X, ldiv(op(Z, op(X, X)), op(Z, X)))
= { by lemma 65 }
  op(X, ldiv(X, ldiv(W, W))) (peak)
= { by axiom 3 (ax1) }
  ldiv(W, W)

Lemma 71: ldiv(op(X, op(Y, Y)), op(X, Y)) = rdiv(Y, op(Y, Y)).
Proof:
  ldiv(op(X, op(Y, Y)), op(X, Y)) (peak)
= { by lemma 65 }
  ldiv(Y, ldiv(Z, Z))
= { by lemma 15 R->L }
  ldiv(rdiv(Y, ldiv(Z, Z)), ldiv(Z, Z))
= { by lemma 66 R->L }
  op(Y, rdiv(ldiv(Y, ldiv(Z, Z)), ldiv(ldiv(Z, Z), Y))) (peak)
= { by lemma 65 R->L }
  op(Y, rdiv(ldiv(op(W, op(Y, Y)), op(W, Y)), ldiv(ldiv(Z, Z), Y))) (peak)
= { by lemma 69 R->L }
  op(Y, rdiv(ldiv(op(W, op(Y, Y)), op(W, Y)), ldiv(op(V, Y), op(V, op(Y, Y))))) (peak)
= { by lemma 47 }
  op(Y, ldiv(rdiv(op(U, Y), ldiv(op(W, op(Y, Y)), op(W, Y))), U)) (peak)
= { by lemma 36 }
  rdiv(Y, ldiv(U, rdiv(op(U, Y), ldiv(op(W, op(Y, Y)), op(W, Y)))))
= { by lemma 32 }
  rdiv(op(Y, ldiv(op(W, op(Y, Y)), op(W, Y))), Y)
= { by lemma 57 R->L }
  rdiv(op(op(Y, T), ldiv(op(op(W, op(Y, Y)), T), op(W, Y))), Y) (peak)
= { by lemma 70 }
  rdiv(ldiv(S, S), Y) (peak)
= { by lemma 67 }
  rdiv(Y, op(Y, Y)) (peak)

Lemma 72: ldiv(op(X, op(op(Y, Y), Y)), op(X, op(Y, Y))) = rdiv(Y, op(Y, Y)).
Proof:
  ldiv(op(X, op(op(Y, Y), Y)), op(X, op(Y, Y)))
= { by lemma 62 R->L }
  ldiv(rdiv(ldiv(rdiv(Z, op(X, op(Y, Y))), op(Z, op(Y, Y))), Y), op(X, op(Y, Y))) (peak)
= { by lemma 61 }
  ldiv(rdiv(op(X, op(op(Y, Y), op(Y, Y))), Y), op(X, op(Y, Y)))
= { by lemma 63 }
  ldiv(Y, op(rdiv(op(Y, Y), op(op(Y, Y), op(Y, Y))), op(Y, Y))) (peak)
= { by lemma 8 }
  ldiv(Y, ldiv(W, rdiv(op(W, op(Y, Y)), op(Y, Y)))) (peak)
= { by axiom 2 (ax3) }
  ldiv(Y, ldiv(W, W))
= { by lemma 65 R->L }
  ldiv(op(V, op(Y, Y)), op(V, Y)) (peak)
= { by lemma 71 }
  rdiv(Y, op(Y, Y))

Lemma 73: rdiv(X, ldiv(op(Y, op(Z, Z)), op(Y, Z))) = ldiv(rdiv(W, X), op(W, Z)).
Proof:
  rdiv(X, ldiv(op(Y, op(Z, Z)), op(Y, Z))) (peak)
= { by lemma 59 }
  op(rdiv(X, Z), op(Z, Z))
= { by lemma 26 }
  ldiv(rdiv(W, X), op(W, Z)) (peak)

Lemma 74: rdiv(X, rdiv(Y, op(Y, Y))) = ldiv(rdiv(Z, X), op(Z, Y)).
Proof:
  rdiv(X, rdiv(Y, op(Y, Y)))
= { by lemma 71 R->L }
  rdiv(X, ldiv(op(W, op(Y, Y)), op(W, Y))) (peak)
= { by lemma 73 }
  ldiv(rdiv(Z, X), op(Z, Y)) (peak)

Lemma 75: op(rdiv(X, op(Y, Y)), op(op(Y, Y), Y)) = ldiv(rdiv(Z, X), op(Z, Y)).
Proof:
  op(rdiv(X, op(Y, Y)), op(op(Y, Y), Y))
= { by lemma 59 R->L }
  rdiv(X, ldiv(op(W, op(op(Y, Y), Y)), op(W, op(Y, Y)))) (peak)
= { by lemma 72 }
  rdiv(X, rdiv(Y, op(Y, Y)))
= { by lemma 74 }
  ldiv(rdiv(Z, X), op(Z, Y)) (peak)

Lemma 76: rdiv(ldiv(X, rdiv(op(X, Y), Z)), Z) = rdiv(Y, op(Z, Z)).
Proof:
  rdiv(ldiv(X, rdiv(op(X, Y), Z)), Z) (peak)
= { by lemma 8 R->L }
  rdiv(op(rdiv(Y, op(Z, Z)), Z), Z) (peak)
= { by axiom 2 (ax3) }
  rdiv(Y, op(Z, Z))

Lemma 77: rdiv(ldiv(rdiv(op(X, Y), Z), X), Y) = rdiv(Z, op(Y, Y)).
Proof:
  rdiv(ldiv(rdiv(op(X, Y), Z), X), Y) (peak)
= { by lemma 55 }
  rdiv(ldiv(W, rdiv(op(W, Z), Y)), Y) (peak)
= { by lemma 76 }
  rdiv(Z, op(Y, Y))

Lemma 78: ldiv(rdiv(op(X, op(Y, Y)), Z), op(X, Y)) = rdiv(Z, Y).
Proof:
  ldiv(rdiv(op(X, op(Y, Y)), Z), op(X, Y))
= { by lemma 38 R->L }
  ldiv(rdiv(W, ldiv(rdiv(op(X, op(Y, Y)), Z), X)), op(W, Y)) (peak)
= { by lemma 75 R->L }
  op(rdiv(ldiv(rdiv(op(X, op(Y, Y)), Z), X), op(Y, Y)), op(op(Y, Y), Y)) (peak)
= { by lemma 77 }
  op(rdiv(Z, op(op(Y, Y), op(Y, Y))), op(op(Y, Y), Y))
= { by lemma 27 }
  rdiv(Z, Y)

Lemma 79: rdiv(op(X, op(Y, Y)), Z) = rdiv(op(X, Y), rdiv(Z, Y)).
Proof:
  rdiv(op(X, op(Y, Y)), Z)
= { by lemma 56 R->L }
  rdiv(X, ldiv(rdiv(op(W, op(Y, Y)), Z), W))
= { by lemma 39 R->L }
  rdiv(op(X, Y), ldiv(rdiv(op(W, op(Y, Y)), Z), op(W, Y))) (peak)
= { by lemma 78 }
  rdiv(op(X, Y), rdiv(Z, Y))

Lemma 80: rdiv(ldiv(rdiv(op(X, op(Y, Y)), Z), X), Y) = rdiv(Z, op(Y, op(Y, Y))).
Proof:
  rdiv(ldiv(rdiv(op(X, op(Y, Y)), Z), X), Y)
= { by lemma 53 R->L }
  ldiv(rdiv(Y, ldiv(rdiv(op(X, op(Y, Y)), Z), X)), ldiv(W, W)) (peak)
= { by lemma 56 }
  ldiv(rdiv(op(Y, op(Y, Y)), Z), ldiv(W, W))
= { by lemma 79 }
  ldiv(rdiv(op(Y, Y), rdiv(Z, Y)), ldiv(W, W))
= { by lemma 51 }
  rdiv(rdiv(Z, Y), op(Y, Y))
= { by lemma 28 }
  rdiv(Z, op(Y, op(Y, Y)))

Lemma 81: op(rdiv(X, op(Y, op(Y, Y))), Y) = ldiv(rdiv(op(Z, op(Y, Y)), X), Z).
Proof:
  op(rdiv(X, op(Y, op(Y, Y))), Y)
= { by lemma 80 R->L }
  op(rdiv(ldiv(rdiv(op(Z, op(Y, Y)), X), Z), Y), Y) (peak)
= { by axiom 4 (ax4) }
  ldiv(rdiv(op(Z, op(Y, Y)), X), Z)

Lemma 82: op(X, ldiv(rdiv(op(Y, Z), W), Y)) = rdiv(op(X, W), Z).
Proof:
  op(X, ldiv(rdiv(op(Y, Z), W), Y)) (peak)
= { by lemma 55 }
  op(X, ldiv(V, rdiv(op(V, W), Z)))
= { by lemma 45 R->L }
  op(X, ldiv(V, op(op(V, W), ldiv(op(U, Z), U)))) (peak)
= { by lemma 43 }
  op(op(X, W), ldiv(op(U, Z), U))
= { by lemma 45 }
  rdiv(op(X, W), Z)

Lemma 83: rdiv(op(X, rdiv(Y, Z)), Z) = rdiv(op(X, Y), op(Z, Z)).
Proof:
  rdiv(op(X, rdiv(Y, Z)), Z)
= { by lemma 27 R->L }
  rdiv(op(X, op(rdiv(Y, op(Z, op(Z, Z))), op(Z, Z))), Z) (peak)
= { by lemma 6 }
  op(X, op(rdiv(Y, op(Z, op(Z, Z))), Z))
= { by lemma 81 }
  op(X, ldiv(rdiv(op(W, op(Z, Z)), Y), W)) (peak)
= { by lemma 82 }
  rdiv(op(X, Y), op(Z, Z))

Lemma 84: rdiv(op(X, op(Y, Z)), op(Z, Z)) = rdiv(op(X, Y), Z).
Proof:
  rdiv(op(X, op(Y, Z)), op(Z, Z))
= { by lemma 83 R->L }
  rdiv(op(X, rdiv(op(Y, Z), Z)), Z) (peak)
= { by axiom 2 (ax3) }
  rdiv(op(X, Y), Z)

Lemma 85: ldiv(rdiv(X, op(Y, Z)), op(X, W)) = op(Y, op(Z, W)).
Proof:
  ldiv(rdiv(X, op(Y, Z)), op(X, W)) (peak)
= { by lemma 26 R->L }
  op(rdiv(op(Y, Z), W), op(W, W))
= { by lemma 84 R->L }
  op(rdiv(op(Y, op(Z, W)), op(W, W)), op(W, W)) (peak)
= { by axiom 4 (ax4) }
  op(Y, op(Z, W))

Lemma 86: ldiv(rdiv(ldiv(X, X), Y), Y) = op(Y, Y).
Proof:
  ldiv(rdiv(ldiv(X, X), Y), Y) (peak)
= { by lemma 67 }
  ldiv(rdiv(Y, op(Y, Y)), Y) (peak)
= { by lemma 21 }
  op(Y, Y)

Lemma 87: rdiv(ldiv(X, X), rdiv(Y, Z)) = rdiv(Z, Y).
Proof:
  rdiv(ldiv(X, X), rdiv(Y, Z))
= { by lemma 53 R->L }
  rdiv(ldiv(X, X), ldiv(rdiv(Z, Y), ldiv(X, X))) (peak)
= { by lemma 14 }
  rdiv(Z, Y)

Lemma 88: op(rdiv(X, Y), rdiv(X, Y)) = ldiv(rdiv(Y, X), rdiv(X, Y)).
Proof:
  op(rdiv(X, Y), rdiv(X, Y))
= { by lemma 86 R->L }
  ldiv(rdiv(ldiv(Z, Z), rdiv(X, Y)), rdiv(X, Y)) (peak)
= { by lemma 87 }
  ldiv(rdiv(Y, X), rdiv(X, Y))

Lemma 89: op(rdiv(X, Y), X) = ldiv(rdiv(Y, X), X).
Proof:
  op(rdiv(X, Y), X)
= { by axiom 4 (ax4) R->L }
  op(rdiv(X, Y), op(rdiv(X, Y), Y))
= { by lemma 85 R->L }
  ldiv(rdiv(Z, op(rdiv(X, Y), rdiv(X, Y))), op(Z, Y)) (peak)
= { by lemma 88 }
  ldiv(rdiv(Z, ldiv(rdiv(Y, X), rdiv(X, Y))), op(Z, Y))
= { by lemma 38 }
  ldiv(rdiv(Y, X), op(rdiv(X, Y), Y))
= { by axiom 4 (ax4) }
  ldiv(rdiv(Y, X), X)

Lemma 90: op(rdiv(X, ldiv(Y, Z)), W) = rdiv(X, ldiv(op(Y, W), Z)).
Proof:
  op(rdiv(X, ldiv(Y, Z)), W)
= { by lemma 49 R->L }
  op(rdiv(op(X, ldiv(Z, op(Y, W))), W), W) (peak)
= { by axiom 4 (ax4) }
  op(X, ldiv(Z, op(Y, W)))
= { by lemma 36 }
  rdiv(X, ldiv(op(Y, W), Z))

Lemma 91: ldiv(X, rdiv(op(X, Y), ldiv(op(Z, W), V))) = ldiv(rdiv(V, Y), op(Z, W)).
Proof:
  ldiv(X, rdiv(op(X, Y), ldiv(op(Z, W), V)))
= { by lemma 90 R->L }
  ldiv(X, op(rdiv(op(X, Y), ldiv(Z, V)), W)) (peak)
= { by lemma 63 R->L }
  ldiv(rdiv(op(Z, ldiv(Z, V)), Y), op(Z, W)) (peak)
= { by axiom 3 (ax1) }
  ldiv(rdiv(V, Y), op(Z, W))

Lemma 92: ldiv(X, ldiv(Y, op(op(Y, op(X, Z)), Z))) = op(Z, Z).
Proof:
  ldiv(X, ldiv(Y, op(op(Y, op(X, Z)), Z))) (peak)
= { by lemma 60 }
  ldiv(X, op(X, op(Z, Z)))
= { by axiom 1 (ax2) }
  op(Z, Z)

Lemma 93: ldiv(rdiv(op(X, Y), Z), op(X, op(Y, Z))) = op(Z, Z).
Proof:
  ldiv(rdiv(op(X, Y), Z), op(X, op(Y, Z)))
= { by lemma 91 R->L }
  ldiv(Y, rdiv(op(Y, Z), ldiv(op(X, op(Y, Z)), op(X, Y))))
= { by lemma 36 R->L }
  ldiv(Y, op(op(Y, Z), ldiv(op(X, Y), op(X, op(Y, Z))))) (peak)
= { by lemma 46 }
  ldiv(Y, op(rdiv(op(Y, Z), Y), op(Y, Z)))
= { by lemma 89 }
  ldiv(Y, ldiv(rdiv(Y, op(Y, Z)), op(Y, Z)))
= { by lemma 25 }
  ldiv(Y, ldiv(W, op(op(W, op(Y, Z)), Z))) (peak)
= { by lemma 92 }
  op(Z, Z)

Lemma 94: ldiv(X, op(op(X, op(Y, Z)), W)) = op(Y, op(Z, W)).
Proof:
  ldiv(X, op(op(X, op(Y, Z)), W)) (peak)
= { by lemma 23 R->L }
  op(rdiv(op(Y, Z), W), op(W, W))
= { by lemma 93 R->L }
  op(rdiv(op(Y, Z), W), ldiv(rdiv(op(Y, Z), W), op(Y, op(Z, W)))) (peak)
= { by axiom 3 (ax1) }
  op(Y, op(Z, W))

Lemma 95: op(op(X, op(Y, Z)), W) = op(X, op(Y, op(Z, W))).
Proof:
  op(op(X, op(Y, Z)), W)
= { by axiom 3 (ax1) R->L }
  op(X, ldiv(X, op(op(X, op(Y, Z)), W))) (peak)
= { by lemma 94 }
  op(X, op(Y, op(Z, W)))

Goal 1 (goal): op(sk_a, op(sk_b, op(sk_b, sk_c))) = op(op(sk_a, op(sk_b, sk_b)), sk_c).
Proof:
  op(sk_a, op(sk_b, op(sk_b, sk_c)))
= { by lemma 95 R->L }
  op(op(sk_a, op(sk_b, sk_b)), sk_c) (peak)

RESULT: Unsatisfiable (the axioms are contradictory).
