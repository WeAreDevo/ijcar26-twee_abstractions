The conjecture is true! Here is a proof.

Axiom 1 (ax2): ldiv(X, op(X, Y)) = Y.
Axiom 2 (ax3): rdiv(op(X, Y), Y) = X.
Axiom 3 (ax1): op(X, ldiv(X, Y)) = Y.
Axiom 4 (ax4): op(rdiv(X, Y), Y) = X.
Axiom 5 (ax5): op(X, op(Y, op(Z, Z))) = op(op(X, op(Y, Z)), Z).

Lemma 6: rdiv(op(X, op(Y, op(Z, Z))), Z) = op(X, op(Y, Z)).
Proof:
  rdiv(op(X, op(Y, op(Z, Z))), Z)
= { by axiom 5 (ax5) }
  rdiv(op(op(X, op(Y, Z)), Z), Z) (peak)
= { by axiom 2 (ax3) }
  op(X, op(Y, Z))

Lemma 7: op(X, op(rdiv(Y, op(Z, Z)), Z)) = rdiv(op(X, Y), Z).
Proof:
  op(X, op(rdiv(Y, op(Z, Z)), Z))
= { by lemma 6 R->L }
  rdiv(op(X, op(rdiv(Y, op(Z, Z)), op(Z, Z))), Z) (peak)
= { by axiom 4 (ax4) }
  rdiv(op(X, Y), Z)

Lemma 8: ldiv(W, rdiv(op(W, Y), Z)) = ldiv(X, rdiv(op(X, Y), Z)).
Proof:
  ldiv(W, rdiv(op(W, Y), Z))
= { by lemma 7 R->L }
  ldiv(W, op(W, op(rdiv(Y, op(Z, Z)), Z))) (peak)
= { by axiom 1 (ax2) }
  op(rdiv(Y, op(Z, Z)), Z)
= { by axiom 1 (ax2) R->L }
  ldiv(X, op(X, op(rdiv(Y, op(Z, Z)), Z))) (peak)
= { by lemma 7 }
  ldiv(X, rdiv(op(X, Y), Z))

Lemma 9: ldiv(Y, Y) = ldiv(X, X).
Proof:
  ldiv(Y, Y)
= { by axiom 2 (ax3) R->L }
  ldiv(Y, rdiv(op(Y, Z), Z)) (peak)
= { by lemma 8 }
  ldiv(X, rdiv(op(X, Z), Z)) (peak)
= { by axiom 2 (ax3) }
  ldiv(X, X)

Lemma 10: op(X, ldiv(Y, Y)) = X.
Proof:
  op(X, ldiv(Y, Y)) (peak)
= { by lemma 9 }
  op(X, ldiv(X, X)) (peak)
= { by axiom 3 (ax1) }
  X

Lemma 11: ldiv(Z, rdiv(Z, Y)) = ldiv(X, rdiv(X, Y)).
Proof:
  ldiv(Z, rdiv(Z, Y))
= { by lemma 10 R->L }
  ldiv(Z, rdiv(op(Z, ldiv(W, W)), Y)) (peak)
= { by lemma 8 }
  ldiv(X, rdiv(op(X, ldiv(W, W)), Y)) (peak)
= { by lemma 10 }
  ldiv(X, rdiv(X, Y))

Lemma 12: ldiv(op(X, Y), X) = ldiv(Z, rdiv(Z, Y)).
Proof:
  ldiv(op(X, Y), X)
= { by axiom 2 (ax3) R->L }
  ldiv(op(X, Y), rdiv(op(X, Y), Y)) (peak)
= { by lemma 11 R->L }
  ldiv(Z, rdiv(Z, Y)) (peak)

Lemma 13: ldiv(rdiv(X, Y), X) = Y.
Proof:
  ldiv(rdiv(X, Y), X)
= { by axiom 4 (ax4) R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), Y)) (peak)
= { by axiom 1 (ax2) }
  Y

Lemma 14: rdiv(X, ldiv(Y, X)) = Y.
Proof:
  rdiv(X, ldiv(Y, X))
= { by axiom 3 (ax1) R->L }
  rdiv(op(Y, ldiv(Y, X)), ldiv(Y, X)) (peak)
= { by axiom 2 (ax3) }
  Y

Lemma 15: ldiv(X, rdiv(X, ldiv(Y, Z))) = ldiv(Z, Y).
Proof:
  ldiv(X, rdiv(X, ldiv(Y, Z))) (peak)
= { by lemma 11 }
  ldiv(Z, rdiv(Z, ldiv(Y, Z))) (peak)
= { by lemma 14 }
  ldiv(Z, Y)

Lemma 16: op(X, ldiv(Y, rdiv(Y, Z))) = rdiv(X, Z).
Proof:
  op(X, ldiv(Y, rdiv(Y, Z))) (peak)
= { by lemma 11 }
  op(X, ldiv(X, rdiv(X, Z))) (peak)
= { by axiom 3 (ax1) }
  rdiv(X, Z)

Lemma 17: op(X, ldiv(Y, Z)) = rdiv(X, ldiv(Z, Y)).
Proof:
  op(X, ldiv(Y, Z))
= { by lemma 15 R->L }
  op(X, ldiv(W, rdiv(W, ldiv(Z, Y)))) (peak)
= { by lemma 16 }
  rdiv(X, ldiv(Z, Y))

Lemma 18: op(rdiv(X, op(Y, Y)), Y) = ldiv(Z, rdiv(op(Z, X), Y)).
Proof:
  op(rdiv(X, op(Y, Y)), Y)
= { by axiom 1 (ax2) R->L }
  ldiv(Z, op(Z, op(rdiv(X, op(Y, Y)), Y))) (peak)
= { by lemma 7 }
  ldiv(Z, rdiv(op(Z, X), Y))

Lemma 19: rdiv(ldiv(X, rdiv(op(X, Y), Z)), Z) = rdiv(Y, op(Z, Z)).
Proof:
  rdiv(ldiv(X, rdiv(op(X, Y), Z)), Z) (peak)
= { by lemma 18 R->L }
  rdiv(op(rdiv(Y, op(Z, Z)), Z), Z) (peak)
= { by axiom 2 (ax3) }
  rdiv(Y, op(Z, Z))

Lemma 20: rdiv(ldiv(Y, Y), X) = rdiv(X, op(X, X)).
Proof:
  rdiv(ldiv(Y, Y), X)
= { by axiom 2 (ax3) R->L }
  rdiv(ldiv(Y, rdiv(op(Y, X), X)), X) (peak)
= { by lemma 19 }
  rdiv(X, op(X, X))

Lemma 21: op(X, op(rdiv(Y, Z), op(Z, Z))) = op(op(X, Y), Z).
Proof:
  op(X, op(rdiv(Y, Z), op(Z, Z)))
= { by axiom 5 (ax5) }
  op(op(X, op(rdiv(Y, Z), Z)), Z) (peak)
= { by axiom 4 (ax4) }
  op(op(X, Y), Z)

Lemma 22: ldiv(W, op(op(W, Y), Z)) = ldiv(X, op(op(X, Y), Z)).
Proof:
  ldiv(W, op(op(W, Y), Z))
= { by lemma 21 R->L }
  ldiv(W, op(W, op(rdiv(Y, Z), op(Z, Z)))) (peak)
= { by axiom 1 (ax2) }
  op(rdiv(Y, Z), op(Z, Z))
= { by axiom 1 (ax2) R->L }
  ldiv(X, op(X, op(rdiv(Y, Z), op(Z, Z)))) (peak)
= { by lemma 21 }
  ldiv(X, op(op(X, Y), Z))

Lemma 23: ldiv(X, op(rdiv(X, ldiv(Y, Z)), W)) = ldiv(Z, op(Y, W)).
Proof:
  ldiv(X, op(rdiv(X, ldiv(Y, Z)), W))
= { by lemma 17 R->L }
  ldiv(X, op(op(X, ldiv(Z, Y)), W)) (peak)
= { by lemma 22 }
  ldiv(Z, op(op(Z, ldiv(Z, Y)), W)) (peak)
= { by axiom 3 (ax1) }
  ldiv(Z, op(Y, W))

Lemma 24: ldiv(op(X, Y), op(X, Z)) = ldiv(W, op(rdiv(W, Y), Z)).
Proof:
  ldiv(op(X, Y), op(X, Z))
= { by lemma 23 R->L }
  ldiv(W, op(rdiv(W, ldiv(X, op(X, Y))), Z)) (peak)
= { by axiom 1 (ax2) }
  ldiv(W, op(rdiv(W, Y), Z))

Lemma 25: ldiv(rdiv(X, Y), op(X, Z)) = ldiv(W, op(op(W, Y), Z)).
Proof:
  ldiv(rdiv(X, Y), op(X, Z))
= { by axiom 4 (ax4) R->L }
  ldiv(rdiv(X, Y), op(op(rdiv(X, Y), Y), Z)) (peak)
= { by lemma 22 R->L }
  ldiv(W, op(op(W, Y), Z)) (peak)

Lemma 26: ldiv(op(rdiv(X, Y), Z), X) = ldiv(W, op(rdiv(W, Z), Y)).
Proof:
  ldiv(op(rdiv(X, Y), Z), X)
= { by axiom 4 (ax4) R->L }
  ldiv(op(rdiv(X, Y), Z), op(rdiv(X, Y), Y)) (peak)
= { by lemma 24 }
  ldiv(W, op(rdiv(W, Z), Y)) (peak)

Lemma 27: ldiv(rdiv(ldiv(X, X), Y), Y) = op(Y, Y).
Proof:
  ldiv(rdiv(ldiv(X, X), Y), Y) (peak)
= { by lemma 20 }
  ldiv(rdiv(Y, op(Y, Y)), Y) (peak)
= { by lemma 13 }
  op(Y, Y)

Lemma 28: op(rdiv(X, Y), op(Y, Y)) = ldiv(Z, op(op(Z, X), Y)).
Proof:
  op(rdiv(X, Y), op(Y, Y))
= { by axiom 1 (ax2) R->L }
  ldiv(Z, op(Z, op(rdiv(X, Y), op(Y, Y)))) (peak)
= { by lemma 21 }
  ldiv(Z, op(op(Z, X), Y))

Lemma 29: rdiv(X, ldiv(op(op(Y, Z), W), Y)) = op(op(X, Z), W).
Proof:
  rdiv(X, ldiv(op(op(Y, Z), W), Y))
= { by lemma 17 R->L }
  op(X, ldiv(Y, op(op(Y, Z), W))) (peak)
= { by lemma 28 R->L }
  op(X, op(rdiv(Z, W), op(W, W))) (peak)
= { by lemma 21 }
  op(op(X, Z), W)

Lemma 30: op(rdiv(X, ldiv(Y, Z)), W) = rdiv(X, ldiv(op(Y, W), Z)).
Proof:
  op(rdiv(X, ldiv(Y, Z)), W)
= { by lemma 17 R->L }
  op(op(X, ldiv(Z, Y)), W)
= { by lemma 29 R->L }
  rdiv(X, ldiv(op(op(Z, ldiv(Z, Y)), W), Z)) (peak)
= { by axiom 3 (ax1) }
  rdiv(X, ldiv(op(Y, W), Z))

Lemma 31: rdiv(X, ldiv(Y, op(rdiv(Y, Z), W))) = op(rdiv(X, W), Z).
Proof:
  rdiv(X, ldiv(Y, op(rdiv(Y, Z), W))) (peak)
= { by lemma 26 R->L }
  rdiv(X, ldiv(op(rdiv(V, W), Z), V))
= { by lemma 30 R->L }
  op(rdiv(X, ldiv(rdiv(V, W), V)), Z) (peak)
= { by lemma 13 }
  op(rdiv(X, W), Z)

Lemma 32: op(rdiv(X, op(Y, Z)), op(Y, op(Z, Z))) = op(X, Z).
Proof:
  op(rdiv(X, op(Y, Z)), op(Y, op(Z, Z)))
= { by axiom 5 (ax5) }
  op(op(rdiv(X, op(Y, Z)), op(Y, Z)), Z) (peak)
= { by axiom 4 (ax4) }
  op(X, Z)

Lemma 33: rdiv(op(X, Y), op(Z, op(Y, Y))) = rdiv(X, op(Z, Y)).
Proof:
  rdiv(op(X, Y), op(Z, op(Y, Y)))
= { by lemma 32 R->L }
  rdiv(op(rdiv(X, op(Z, Y)), op(Z, op(Y, Y))), op(Z, op(Y, Y))) (peak)
= { by axiom 2 (ax3) }
  rdiv(X, op(Z, Y))

Lemma 34: rdiv(rdiv(X, Y), op(Z, Y)) = rdiv(X, op(Z, op(Y, Y))).
Proof:
  rdiv(rdiv(X, Y), op(Z, Y))
= { by lemma 33 R->L }
  rdiv(op(rdiv(X, Y), Y), op(Z, op(Y, Y))) (peak)
= { by axiom 4 (ax4) }
  rdiv(X, op(Z, op(Y, Y)))

Lemma 35: rdiv(X, ldiv(Y, op(op(Y, Z), W))) = rdiv(rdiv(X, W), Z).
Proof:
  rdiv(X, ldiv(Y, op(op(Y, Z), W))) (peak)
= { by lemma 28 R->L }
  rdiv(X, op(rdiv(Z, W), op(W, W)))
= { by lemma 34 R->L }
  rdiv(rdiv(X, W), op(rdiv(Z, W), W)) (peak)
= { by axiom 4 (ax4) }
  rdiv(rdiv(X, W), Z)

Lemma 36: rdiv(X, ldiv(Y, rdiv(op(Y, Z), W))) = rdiv(op(X, W), Z).
Proof:
  rdiv(X, ldiv(Y, rdiv(op(Y, Z), W))) (peak)
= { by lemma 18 R->L }
  rdiv(X, op(rdiv(Z, op(W, W)), W))
= { by lemma 33 R->L }
  rdiv(op(X, W), op(rdiv(Z, op(W, W)), op(W, W))) (peak)
= { by axiom 4 (ax4) }
  rdiv(op(X, W), Z)

Lemma 37: rdiv(op(X, Y), ldiv(Z, W)) = rdiv(X, ldiv(Z, rdiv(W, Y))).
Proof:
  rdiv(op(X, Y), ldiv(Z, W))
= { by lemma 36 R->L }
  rdiv(X, ldiv(Z, rdiv(op(Z, ldiv(Z, W)), Y))) (peak)
= { by axiom 3 (ax1) }
  rdiv(X, ldiv(Z, rdiv(W, Y)))

Lemma 38: rdiv(X, ldiv(Y, rdiv(Y, Z))) = op(X, Z).
Proof:
  rdiv(X, ldiv(Y, rdiv(Y, Z))) (peak)
= { by lemma 12 R->L }
  rdiv(X, ldiv(op(W, Z), W))
= { by lemma 10 R->L }
  rdiv(X, ldiv(op(op(W, Z), ldiv(V, V)), W)) (peak)
= { by lemma 29 }
  op(op(X, Z), ldiv(V, V))
= { by lemma 10 }
  op(X, Z)

Lemma 39: rdiv(rdiv(X, ldiv(Y, Z)), W) = rdiv(X, ldiv(rdiv(Y, W), Z)).
Proof:
  rdiv(rdiv(X, ldiv(Y, Z)), W)
= { by lemma 17 R->L }
  rdiv(op(X, ldiv(Z, Y)), W)
= { by lemma 36 R->L }
  rdiv(X, ldiv(V, rdiv(op(V, W), ldiv(Z, Y)))) (peak)
= { by lemma 37 }
  rdiv(X, ldiv(V, rdiv(V, ldiv(Z, rdiv(Y, W)))))
= { by lemma 38 }
  op(X, ldiv(Z, rdiv(Y, W)))
= { by lemma 17 }
  rdiv(X, ldiv(rdiv(Y, W), Z))

Lemma 40: ldiv(rdiv(X, Y), ldiv(Z, op(op(Z, X), Y))) = op(Y, Y).
Proof:
  ldiv(rdiv(X, Y), ldiv(Z, op(op(Z, X), Y))) (peak)
= { by lemma 28 R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), op(Y, Y))) (peak)
= { by axiom 1 (ax2) }
  op(Y, Y)

Lemma 41: rdiv(ldiv(X, Y), ldiv(Y, X)) = ldiv(X, ldiv(rdiv(X, Y), Y)).
Proof:
  rdiv(ldiv(X, Y), ldiv(Y, X))
= { by lemma 17 R->L }
  op(ldiv(X, Y), ldiv(X, Y))
= { by lemma 40 R->L }
  ldiv(rdiv(Y, ldiv(X, Y)), ldiv(Z, op(op(Z, Y), ldiv(X, Y)))) (peak)
= { by lemma 14 }
  ldiv(X, ldiv(Z, op(op(Z, Y), ldiv(X, Y))))
= { by lemma 17 }
  ldiv(X, ldiv(Z, rdiv(op(Z, Y), ldiv(Y, X))))
= { by lemma 37 }
  ldiv(X, ldiv(Z, rdiv(Z, ldiv(Y, rdiv(X, Y)))))
= { by lemma 15 }
  ldiv(X, ldiv(rdiv(X, Y), Y))

Lemma 42: rdiv(X, rdiv(Y, ldiv(ldiv(rdiv(Z, X), X), Z))) = rdiv(Z, rdiv(Y, ldiv(X, Z))).
Proof:
  rdiv(X, rdiv(Y, ldiv(ldiv(rdiv(Z, X), X), Z)))
= { by lemma 17 R->L }
  rdiv(X, op(Y, ldiv(Z, ldiv(rdiv(Z, X), X))))
= { by lemma 41 R->L }
  rdiv(X, op(Y, rdiv(ldiv(Z, X), ldiv(X, Z))))
= { by lemma 17 R->L }
  rdiv(X, op(Y, op(ldiv(Z, X), ldiv(Z, X))))
= { by axiom 3 (ax1) R->L }
  rdiv(op(Z, ldiv(Z, X)), op(Y, op(ldiv(Z, X), ldiv(Z, X)))) (peak)
= { by lemma 33 }
  rdiv(Z, op(Y, ldiv(Z, X)))
= { by lemma 17 }
  rdiv(Z, rdiv(Y, ldiv(X, Z)))

Lemma 43: rdiv(X, ldiv(ldiv(rdiv(Y, Z), Z), Y)) = ldiv(rdiv(Y, rdiv(X, ldiv(Z, Y))), Z).
Proof:
  rdiv(X, ldiv(ldiv(rdiv(Y, Z), Z), Y))
= { by lemma 13 R->L }
  ldiv(rdiv(Z, rdiv(X, ldiv(ldiv(rdiv(Y, Z), Z), Y))), Z) (peak)
= { by lemma 42 }
  ldiv(rdiv(Y, rdiv(X, ldiv(Z, Y))), Z)

Lemma 44: rdiv(X, rdiv(Y, ldiv(Z, ldiv(rdiv(X, Z), Z)))) = rdiv(Z, Y).
Proof:
  rdiv(X, rdiv(Y, ldiv(Z, ldiv(rdiv(X, Z), Z))))
= { by lemma 14 R->L }
  rdiv(X, rdiv(Y, ldiv(Z, ldiv(rdiv(X, rdiv(X, ldiv(Z, X))), Z))))
= { by lemma 43 R->L }
  rdiv(X, rdiv(Y, ldiv(Z, rdiv(X, ldiv(ldiv(rdiv(X, Z), Z), X)))))
= { by lemma 37 R->L }
  rdiv(X, rdiv(op(Y, ldiv(ldiv(rdiv(X, Z), Z), X)), ldiv(Z, X)))
= { by lemma 42 R->L }
  rdiv(Z, rdiv(op(Y, ldiv(ldiv(rdiv(X, Z), Z), X)), ldiv(ldiv(rdiv(X, Z), Z), X))) (peak)
= { by axiom 2 (ax3) }
  rdiv(Z, Y)

Lemma 45: rdiv(ldiv(X, X), rdiv(Y, Z)) = rdiv(Z, Y).
Proof:
  rdiv(ldiv(X, X), rdiv(Y, Z)) (peak)
= { by lemma 20 }
  rdiv(rdiv(Y, Z), op(rdiv(Y, Z), rdiv(Y, Z)))
= { by axiom 1 (ax2) R->L }
  rdiv(rdiv(Y, Z), op(rdiv(Y, Z), rdiv(Y, ldiv(Z, op(Z, Z)))))
= { by lemma 31 R->L }
  rdiv(rdiv(Y, Z), rdiv(Y, ldiv(W, op(rdiv(W, rdiv(Y, ldiv(Z, op(Z, Z)))), Z)))) (peak)
= { by lemma 24 R->L }
  rdiv(rdiv(Y, Z), rdiv(Y, ldiv(op(Z, rdiv(Y, ldiv(Z, op(Z, Z)))), op(Z, Z))))
= { by lemma 35 R->L }
  rdiv(Y, ldiv(V, op(op(V, rdiv(Y, ldiv(op(Z, rdiv(Y, ldiv(Z, op(Z, Z)))), op(Z, Z)))), Z))) (peak)
= { by lemma 25 R->L }
  rdiv(Y, ldiv(rdiv(Z, rdiv(Y, ldiv(op(Z, rdiv(Y, ldiv(Z, op(Z, Z)))), op(Z, Z)))), op(Z, Z)))
= { by lemma 27 R->L }
  rdiv(Y, ldiv(rdiv(Z, rdiv(Y, ldiv(op(Z, rdiv(Y, ldiv(Z, ldiv(rdiv(ldiv(U, U), Z), Z)))), op(Z, Z)))), op(Z, Z)))
= { by lemma 27 R->L }
  rdiv(Y, ldiv(rdiv(Z, rdiv(Y, ldiv(op(Z, rdiv(Y, ldiv(Z, ldiv(rdiv(ldiv(U, U), Z), Z)))), ldiv(rdiv(ldiv(U, U), Z), Z)))), op(Z, Z)))
= { by lemma 27 R->L }
  rdiv(Y, ldiv(rdiv(Z, rdiv(Y, ldiv(op(Z, rdiv(Y, ldiv(Z, ldiv(rdiv(ldiv(U, U), Z), Z)))), ldiv(rdiv(ldiv(U, U), Z), Z)))), ldiv(rdiv(ldiv(U, U), Z), Z)))
= { by lemma 30 R->L }
  rdiv(Y, ldiv(rdiv(Z, op(rdiv(Y, ldiv(Z, ldiv(rdiv(ldiv(U, U), Z), Z))), rdiv(Y, ldiv(Z, ldiv(rdiv(ldiv(U, U), Z), Z))))), ldiv(rdiv(ldiv(U, U), Z), Z)))
= { by lemma 39 R->L }
  rdiv(rdiv(Y, ldiv(Z, ldiv(rdiv(ldiv(U, U), Z), Z))), op(rdiv(Y, ldiv(Z, ldiv(rdiv(ldiv(U, U), Z), Z))), rdiv(Y, ldiv(Z, ldiv(rdiv(ldiv(U, U), Z), Z))))) (peak)
= { by lemma 20 R->L }
  rdiv(ldiv(U, U), rdiv(Y, ldiv(Z, ldiv(rdiv(ldiv(U, U), Z), Z))))
= { by lemma 44 }
  rdiv(Z, Y)

Lemma 46: rdiv(op(X, Y), ldiv(Z, op(op(Z, W), Y))) = rdiv(X, W).
Proof:
  rdiv(op(X, Y), ldiv(Z, op(op(Z, W), Y))) (peak)
= { by lemma 25 R->L }
  rdiv(op(X, Y), ldiv(rdiv(X, W), op(X, Y))) (peak)
= { by lemma 14 }
  rdiv(X, W)

Lemma 47: rdiv(ldiv(X, op(op(X, op(Y, Z)), W)), op(Z, W)) = Y.
Proof:
  rdiv(ldiv(X, op(op(X, op(Y, Z)), W)), op(Z, W))
= { by lemma 45 R->L }
  rdiv(ldiv(V, V), rdiv(op(Z, W), ldiv(X, op(op(X, op(Y, Z)), W)))) (peak)
= { by lemma 46 }
  rdiv(ldiv(V, V), rdiv(Z, op(Y, Z)))
= { by lemma 45 }
  rdiv(op(Y, Z), Z)
= { by axiom 2 (ax3) }
  Y

Lemma 48: ldiv(X, op(op(X, op(Y, Z)), W)) = op(Y, op(Z, W)).
Proof:
  ldiv(X, op(op(X, op(Y, Z)), W))
= { by axiom 4 (ax4) R->L }
  op(rdiv(ldiv(X, op(op(X, op(Y, Z)), W)), op(Z, W)), op(Z, W)) (peak)
= { by lemma 47 }
  op(Y, op(Z, W))

Lemma 49: op(op(X, op(Y, Z)), W) = op(X, op(Y, op(Z, W))).
Proof:
  op(op(X, op(Y, Z)), W)
= { by axiom 3 (ax1) R->L }
  op(X, ldiv(X, op(op(X, op(Y, Z)), W))) (peak)
= { by lemma 48 }
  op(X, op(Y, op(Z, W)))

Goal 1 (goal): op(sk_a, op(sk_b, op(sk_c, sk_b))) = op(op(sk_a, op(sk_b, sk_c)), sk_b).
Proof:
  op(sk_a, op(sk_b, op(sk_c, sk_b)))
= { by lemma 49 R->L }
  op(op(sk_a, op(sk_b, sk_c)), sk_b) (peak)

RESULT: Unsatisfiable (the axioms are contradictory).
