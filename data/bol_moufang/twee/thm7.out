The conjecture is true! Here is a proof.

Axiom 1 (ax2): ldiv(X, op(X, Y)) = Y.
Axiom 2 (ax3): rdiv(op(X, Y), Y) = X.
Axiom 3 (ax1): op(X, ldiv(X, Y)) = Y.
Axiom 4 (ax4): op(rdiv(X, Y), Y) = X.
Axiom 5 (ax5): op(X, op(Y, op(Y, Z))) = op(op(X, op(Y, Y)), Z).

Lemma 6: ldiv(rdiv(X, Y), X) = Y.
Proof:
  ldiv(rdiv(X, Y), X)
= { by axiom 4 (ax4) R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), Y)) (peak)
= { by axiom 1 (ax2) }
  Y

Lemma 7: rdiv(op(X, op(Y, op(Y, Z))), Z) = op(X, op(Y, Y)).
Proof:
  rdiv(op(X, op(Y, op(Y, Z))), Z)
= { by axiom 5 (ax5) }
  rdiv(op(op(X, op(Y, Y)), Z), Z) (peak)
= { by axiom 2 (ax3) }
  op(X, op(Y, Y))

Lemma 8: rdiv(op(X, op(Y, Z)), ldiv(Y, Z)) = op(X, op(Y, Y)).
Proof:
  rdiv(op(X, op(Y, Z)), ldiv(Y, Z))
= { by axiom 3 (ax1) R->L }
  rdiv(op(X, op(Y, op(Y, ldiv(Y, Z)))), ldiv(Y, Z)) (peak)
= { by lemma 7 }
  op(X, op(Y, Y))

Lemma 9: rdiv(op(X, Y), ldiv(Z, ldiv(Z, Y))) = op(X, op(Z, Z)).
Proof:
  rdiv(op(X, Y), ldiv(Z, ldiv(Z, Y)))
= { by axiom 3 (ax1) R->L }
  rdiv(op(X, op(Z, ldiv(Z, Y))), ldiv(Z, ldiv(Z, Y))) (peak)
= { by lemma 8 }
  op(X, op(Z, Z))

Lemma 10: op(rdiv(X, Y), op(Z, Z)) = rdiv(X, ldiv(Z, ldiv(Z, Y))).
Proof:
  op(rdiv(X, Y), op(Z, Z))
= { by lemma 9 R->L }
  rdiv(op(rdiv(X, Y), Y), ldiv(Z, ldiv(Z, Y))) (peak)
= { by axiom 4 (ax4) }
  rdiv(X, ldiv(Z, ldiv(Z, Y)))

Lemma 11: rdiv(X, ldiv(Y, Y)) = X.
Proof:
  rdiv(X, ldiv(Y, Y))
= { by axiom 1 (ax2) R->L }
  rdiv(X, ldiv(Y, ldiv(Y, op(Y, Y))))
= { by lemma 10 R->L }
  op(rdiv(X, op(Y, Y)), op(Y, Y)) (peak)
= { by axiom 4 (ax4) }
  X

Lemma 12: op(X, ldiv(Y, Y)) = X.
Proof:
  op(X, ldiv(Y, Y))
= { by lemma 11 R->L }
  rdiv(op(X, ldiv(Y, Y)), ldiv(Y, Y)) (peak)
= { by axiom 2 (ax3) }
  X

Lemma 13: rdiv(X, ldiv(Y, X)) = Y.
Proof:
  rdiv(X, ldiv(Y, X))
= { by axiom 3 (ax1) R->L }
  rdiv(op(Y, ldiv(Y, X)), ldiv(Y, X)) (peak)
= { by axiom 2 (ax3) }
  Y

Lemma 14: op(rdiv(X, op(Y, Y)), op(Y, op(Y, Z))) = op(X, Z).
Proof:
  op(rdiv(X, op(Y, Y)), op(Y, op(Y, Z)))
= { by axiom 5 (ax5) }
  op(op(rdiv(X, op(Y, Y)), op(Y, Y)), Z) (peak)
= { by axiom 4 (ax4) }
  op(X, Z)

Lemma 15: ldiv(rdiv(X, op(Y, Y)), op(X, Z)) = op(Y, op(Y, Z)).
Proof:
  ldiv(rdiv(X, op(Y, Y)), op(X, Z))
= { by lemma 14 R->L }
  ldiv(rdiv(X, op(Y, Y)), op(rdiv(X, op(Y, Y)), op(Y, op(Y, Z)))) (peak)
= { by axiom 1 (ax2) }
  op(Y, op(Y, Z))

Lemma 16: op(X, op(X, ldiv(Y, Z))) = ldiv(rdiv(Y, op(X, X)), Z).
Proof:
  op(X, op(X, ldiv(Y, Z)))
= { by lemma 15 R->L }
  ldiv(rdiv(Y, op(X, X)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 3 (ax1) }
  ldiv(rdiv(Y, op(X, X)), Z)

Lemma 17: ldiv(rdiv(X, op(X, X)), Y) = op(X, Y).
Proof:
  ldiv(rdiv(X, op(X, X)), Y)
= { by lemma 16 R->L }
  op(X, op(X, ldiv(X, Y))) (peak)
= { by axiom 3 (ax1) }
  op(X, Y)

Lemma 18: rdiv(Z, op(Y, Z)) = rdiv(X, op(Y, X)).
Proof:
  rdiv(Z, op(Y, Z))
= { by lemma 17 R->L }
  rdiv(Z, ldiv(rdiv(Y, op(Y, Y)), Z)) (peak)
= { by lemma 13 }
  rdiv(Y, op(Y, Y))
= { by lemma 13 R->L }
  rdiv(X, ldiv(rdiv(Y, op(Y, Y)), X)) (peak)
= { by lemma 17 }
  rdiv(X, op(Y, X))

Lemma 19: rdiv(ldiv(X, X), Y) = rdiv(Z, op(Y, Z)).
Proof:
  rdiv(ldiv(X, X), Y)
= { by lemma 12 R->L }
  rdiv(ldiv(X, X), op(Y, ldiv(X, X))) (peak)
= { by lemma 18 R->L }
  rdiv(Z, op(Y, Z)) (peak)

Lemma 20: ldiv(X, rdiv(op(X, op(Y, op(Y, Z))), Z)) = op(Y, Y).
Proof:
  ldiv(X, rdiv(op(X, op(Y, op(Y, Z))), Z)) (peak)
= { by lemma 7 }
  ldiv(X, op(X, op(Y, Y)))
= { by axiom 1 (ax2) }
  op(Y, Y)

Lemma 21: ldiv(rdiv(X, op(Y, op(Y, Z))), rdiv(X, Z)) = op(Y, Y).
Proof:
  ldiv(rdiv(X, op(Y, op(Y, Z))), rdiv(X, Z))
= { by axiom 4 (ax4) R->L }
  ldiv(rdiv(X, op(Y, op(Y, Z))), rdiv(op(rdiv(X, op(Y, op(Y, Z))), op(Y, op(Y, Z))), Z)) (peak)
= { by lemma 20 }
  op(Y, Y)

Lemma 22: rdiv(rdiv(X, Y), op(Z, Z)) = rdiv(X, op(Z, op(Z, Y))).
Proof:
  rdiv(rdiv(X, Y), op(Z, Z))
= { by lemma 21 R->L }
  rdiv(rdiv(X, Y), ldiv(rdiv(X, op(Z, op(Z, Y))), rdiv(X, Y))) (peak)
= { by lemma 13 }
  rdiv(X, op(Z, op(Z, Y)))

Lemma 23: rdiv(W, op(op(Y, op(Y, Z)), W)) = rdiv(X, op(Y, op(Y, op(Z, X)))).
Proof:
  rdiv(W, op(op(Y, op(Y, Z)), W)) (peak)
= { by lemma 19 R->L }
  rdiv(ldiv(U, U), op(Y, op(Y, Z)))
= { by lemma 22 R->L }
  rdiv(rdiv(ldiv(U, U), Z), op(Y, Y)) (peak)
= { by lemma 19 }
  rdiv(rdiv(V, op(Z, V)), op(Y, Y)) (peak)
= { by lemma 18 }
  rdiv(rdiv(X, op(Z, X)), op(Y, Y)) (peak)
= { by lemma 22 }
  rdiv(X, op(Y, op(Y, op(Z, X))))

Lemma 24: op(op(X, op(X, Y)), Z) = op(X, op(X, op(Y, Z))).
Proof:
  op(op(X, op(X, Y)), Z)
= { by lemma 6 R->L }
  ldiv(rdiv(Z, op(op(X, op(X, Y)), Z)), Z) (peak)
= { by lemma 23 }
  ldiv(rdiv(Z, op(X, op(X, op(Y, Z)))), Z)
= { by lemma 6 }
  op(X, op(X, op(Y, Z)))

Goal 1 (goal): op(sk_a, op(sk_a, op(sk_b, sk_c))) = op(op(sk_a, op(sk_a, sk_b)), sk_c).
Proof:
  op(sk_a, op(sk_a, op(sk_b, sk_c)))
= { by lemma 24 R->L }
  op(op(sk_a, op(sk_a, sk_b)), sk_c) (peak)

RESULT: Unsatisfiable (the axioms are contradictory).
