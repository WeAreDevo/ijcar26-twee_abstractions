= { by lemma 6 }
  rdiv(op(rdiv(X, Y), op(rdiv(X, Y), Y)), X)
= { by axiom 3 (ax4) }
  rdiv(op(rdiv(X, Y), X), X)
= { by axiom 2 (ax3) }
  rdiv(X, Y)

Lemma 8: op(rdiv(X, Y), rdiv(X, Y)) = rdiv(rdiv(X, Y), rdiv(Y, X)).
Proof:
  op(rdiv(X, Y), rdiv(X, Y))
= { by axiom 2 (ax3) R->L }
  rdiv(op(op(rdiv(X, Y), rdiv(X, Y)), rdiv(Y, X)), rdiv(Y, X)) (peak)
= { by lemma 7 }
  rdiv(rdiv(X, Y), rdiv(Y, X))

Lemma 9: op(rdiv(X, Y), op(rdiv(X, Y), op(rdiv(Y, X), Z))) = op(rdiv(X, Y), Z).
Proof:
  op(rdiv(X, Y), op(rdiv(X, Y), op(rdiv(Y, X), Z)))
= { by axiom 4 (ax5) }
  op(op(op(rdiv(X, Y), rdiv(X, Y)), rdiv(Y, X)), Z) (peak)
