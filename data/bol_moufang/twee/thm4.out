= { by axiom 4 (ax5) }
  rdiv(op(op(op(X, X), Y), Z), Z) (peak)
= { by axiom 2 (ax3) }
  op(op(X, X), Y)

Lemma 6: op(op(X, X), rdiv(Y, Z)) = rdiv(op(X, op(X, Y)), Z).
Proof:
  op(op(X, X), rdiv(Y, Z))
= { by lemma 5 R->L }
  rdiv(op(X, op(X, op(rdiv(Y, Z), Z))), Z) (peak)
= { by axiom 3 (ax4) }
  rdiv(op(X, op(X, Y)), Z)

Lemma 7: op(op(rdiv(X, Y), rdiv(X, Y)), rdiv(Y, X)) = rdiv(X, Y).
Proof:
