(21.0) 1711. T4 -> T5

The conjecture is true! Here is a proof.

Axiom 1 (sos): op(X, zero) = X.
Axiom 2 (sos): op(zero, X) = X.
Axiom 3 (sos): rdiv(op(X, Y), Y) = X.
Axiom 4 (sos): ldiv(X, op(X, Y)) = Y.
Axiom 5 (sos): T(X, Y) = ldiv(Y, op(X, Y)).
Axiom 6 (sos): K(X, K(Y, Z)) = 1.
Axiom 7 (sos): K(K(X, Y), Z) = 1.
Axiom 8 (sos): op(X, ldiv(X, Y)) = Y.
Axiom 9 (sos): op(rdiv(X, Y), Y) = X.
Axiom 10 (sos): K(X, a(Y, Z, W)) = 1.
Axiom 11 (sos): a(X, Y, K(Z, W)) = 1.
Axiom 12 (sos): a(X, K(Y, Z), W) = 1.
Axiom 13 (sos): a(K(X, Y), Z, W) = 1.
Axiom 14 (sos): a(X, Y, a(Z, W, V)) = 1.
Axiom 15 (sos): op(X, Y) = op(op(Y, X), K(X, Y)).
Axiom 16 (sos): R(X, Y, Z) = rdiv(op(op(X, Y), Z), op(Y, Z)).
Axiom 17 (sos): L(X, Y, Z) = ldiv(op(Z, Y), op(Z, op(Y, X))).
Axiom 18 (sos): op(op(X, Y), Z) = op(op(X, op(Y, Z)), a(X, Y, Z)).

Lemma 19: op(X, K(zero, X)) = X.
Proof:
  op(X, K(zero, X))
= { by axiom 1 (sos) R->L }
  op(op(X, zero), K(zero, X)) (peak)
= { by axiom 15 (sos) R->L }
  op(zero, X)
= { by axiom 2 (sos) }
  X

Lemma 20: ldiv(X, X) = zero.
Proof:
  ldiv(X, X)
= { by axiom 1 (sos) R->L }
  ldiv(X, op(X, zero)) (peak)
= { by axiom 4 (sos) }
  zero

Lemma 21: K(zero, X) = zero.
Proof:
  K(zero, X)
= { by axiom 4 (sos) R->L }
  ldiv(X, op(X, K(zero, X))) (peak)
= { by lemma 19 }
  ldiv(X, X)
= { by lemma 20 }
  zero

Lemma 22: 1 = zero.
Proof:
  1
= { by axiom 6 (sos) R->L }
  K(zero, K(X, Y)) (peak)
= { by lemma 21 }
  zero

Lemma 23: rdiv(X, zero) = X.
Proof:
  rdiv(X, zero)
= { by axiom 1 (sos) R->L }
  rdiv(op(X, zero), zero) (peak)
= { by axiom 3 (sos) }
  X

Lemma 24: rdiv(op(X, Y), K(X, Y)) = op(Y, X).
Proof:
  rdiv(op(X, Y), K(X, Y))
= { by axiom 15 (sos) }
  rdiv(op(op(Y, X), K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  op(Y, X)

Lemma 25: op(K(X, Y), Z) = op(Z, K(X, Y)).
Proof:
  op(K(X, Y), Z)
= { by lemma 24 R->L }
  rdiv(op(Z, K(X, Y)), K(Z, K(X, Y))) (peak)
= { by axiom 6 (sos) }
  rdiv(op(Z, K(X, Y)), 1)
= { by lemma 22 }
  rdiv(op(Z, K(X, Y)), zero)
= { by lemma 23 }
  op(Z, K(X, Y))

Lemma 26: op(op(X, K(Y, Z)), W) = op(K(Y, Z), op(X, W)).
Proof:
  op(op(X, K(Y, Z)), W) (peak)
= { by lemma 25 R->L }
  op(op(K(Y, Z), X), W)
= { by axiom 18 (sos) }
  op(op(K(Y, Z), op(X, W)), a(K(Y, Z), X, W)) (peak)
= { by lemma 25 }
  op(op(op(X, W), K(Y, Z)), a(K(Y, Z), X, W)) (peak)
= { by axiom 13 (sos) }
  op(op(op(X, W), K(Y, Z)), 1)
= { by lemma 22 }
  op(op(op(X, W), K(Y, Z)), zero)
= { by axiom 1 (sos) }
  op(op(X, W), K(Y, Z))
= { by lemma 25 R->L }
  op(K(Y, Z), op(X, W))

Lemma 27: op(K(X, Y), op(Z, W)) = op(Z, op(W, K(X, Y))).
Proof:
  op(K(X, Y), op(Z, W))
= { by lemma 26 R->L }
  op(op(Z, K(X, Y)), W)
= { by axiom 18 (sos) }
  op(op(Z, op(K(X, Y), W)), a(Z, K(X, Y), W)) (peak)
= { by lemma 25 }
  op(op(Z, op(W, K(X, Y))), a(Z, K(X, Y), W)) (peak)
= { by axiom 12 (sos) }
  op(op(Z, op(W, K(X, Y))), 1)
= { by lemma 22 }
  op(op(Z, op(W, K(X, Y))), zero)
= { by axiom 1 (sos) }
  op(Z, op(W, K(X, Y)))

Lemma 28: op(K(X, Y), op(Y, X)) = op(X, Y).
Proof:
  op(K(X, Y), op(Y, X))
= { by axiom 15 (sos) }
  op(op(op(Y, X), K(X, Y)), K(K(X, Y), op(Y, X))) (peak)
= { by axiom 15 (sos) R->L }
  op(op(X, Y), K(K(X, Y), op(Y, X)))
= { by axiom 7 (sos) }
  op(op(X, Y), 1)
= { by lemma 22 }
  op(op(X, Y), zero)
= { by axiom 1 (sos) }
  op(X, Y)

Lemma 29: op(X, op(Y, K(Y, X))) = op(Y, X).
Proof:
  op(X, op(Y, K(Y, X)))
= { by lemma 27 R->L }
  op(K(Y, X), op(X, Y)) (peak)
= { by lemma 28 }
  op(Y, X)

Lemma 30: op(X, K(X, Y)) = T(X, Y).
Proof:
  op(X, K(X, Y))
= { by axiom 4 (sos) R->L }
  ldiv(Y, op(Y, op(X, K(X, Y)))) (peak)
= { by lemma 29 }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 31: op(op(X, K(Y, X)), Y) = op(Y, X).
Proof:
  op(op(X, K(Y, X)), Y)
= { by lemma 25 R->L }
  op(op(K(Y, X), X), Y)
= { by axiom 18 (sos) }
  op(op(K(Y, X), op(X, Y)), a(K(Y, X), X, Y)) (peak)
= { by lemma 28 }
  op(op(Y, X), a(K(Y, X), X, Y))
= { by axiom 13 (sos) }
  op(op(Y, X), 1)
= { by lemma 22 }
  op(op(Y, X), zero)
= { by axiom 1 (sos) }
  op(Y, X)

Lemma 32: op(X, K(Y, X)) = rdiv(op(Y, X), Y).
Proof:
  op(X, K(Y, X))
= { by axiom 3 (sos) R->L }
  rdiv(op(op(X, K(Y, X)), Y), Y) (peak)
= { by lemma 31 }
  rdiv(op(Y, X), Y)

Lemma 33: rdiv(op(X, Z), op(Y, Z)) = R(rdiv(X, Y), Y, Z).
Proof:
  rdiv(op(X, Z), op(Y, Z))
= { by axiom 9 (sos) R->L }
  rdiv(op(op(rdiv(X, Y), Y), Z), op(Y, Z)) (peak)
= { by axiom 16 (sos) R->L }
  R(rdiv(X, Y), Y, Z)

Lemma 34: R(rdiv(zero, X), X, Y) = rdiv(Y, op(X, Y)).
Proof:
  R(rdiv(zero, X), X, Y) (peak)
= { by lemma 33 R->L }
  rdiv(op(zero, Y), op(X, Y)) (peak)
= { by axiom 2 (sos) }
  rdiv(Y, op(X, Y))

Lemma 35: ldiv(rdiv(X, Y), X) = Y.
Proof:
  ldiv(rdiv(X, Y), X)
= { by axiom 9 (sos) R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), Y)) (peak)
= { by axiom 4 (sos) }
  Y

Lemma 36: ldiv(R(rdiv(zero, X), X, Y), Y) = op(X, Y).
Proof:
  ldiv(R(rdiv(zero, X), X, Y), Y) (peak)
= { by lemma 34 }
  ldiv(rdiv(Y, op(X, Y)), Y) (peak)
= { by lemma 35 }
  op(X, Y)

Lemma 37: op(X, K(Y, rdiv(X, Y))) = op(Y, rdiv(X, Y)).
Proof:
  op(X, K(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  op(op(rdiv(X, Y), Y), K(Y, rdiv(X, Y))) (peak)
= { by axiom 15 (sos) R->L }
  op(Y, rdiv(X, Y))

Lemma 38: op(K(X, Y), rdiv(Z, K(X, Y))) = Z.
Proof:
  op(K(X, Y), rdiv(Z, K(X, Y)))
= { by lemma 37 R->L }
  op(Z, K(K(X, Y), rdiv(Z, K(X, Y)))) (peak)
= { by axiom 7 (sos) }
  op(Z, 1)
= { by lemma 22 }
  op(Z, zero)
= { by axiom 1 (sos) }
  Z

Lemma 39: T(rdiv(X, Y), Y) = ldiv(Y, X).
Proof:
  T(rdiv(X, Y), Y)
= { by axiom 5 (sos) }
  ldiv(Y, op(rdiv(X, Y), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(Y, X)

Lemma 40: T(X, K(Y, Z)) = X.
Proof:
  T(X, K(Y, Z))
= { by axiom 5 (sos) }
  ldiv(K(Y, Z), op(X, K(Y, Z))) (peak)
= { by lemma 25 R->L }
  ldiv(K(Y, Z), op(K(Y, Z), X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 41: ldiv(K(X, Y), Z) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(K(X, Y), Z)
= { by lemma 39 R->L }
  T(rdiv(Z, K(X, Y)), K(X, Y)) (peak)
= { by lemma 40 }
  rdiv(Z, K(X, Y))

Lemma 42: rdiv(op(op(X, Y), ldiv(Y, Z)), Z) = R(X, Y, ldiv(Y, Z)).
Proof:
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z)
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, Y), ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 16 (sos) R->L }
  R(X, Y, ldiv(Y, Z))

Lemma 43: op(op(K(X, Y), Z), W) = op(Z, op(W, K(X, Y))).
Proof:
  op(op(K(X, Y), Z), W) (peak)
= { by lemma 25 }
  op(op(Z, K(X, Y)), W) (peak)
= { by lemma 26 }
  op(K(X, Y), op(Z, W))
= { by lemma 27 }
  op(Z, op(W, K(X, Y)))

Lemma 44: R(X, K(Y, Z), rdiv(W, K(Y, Z))) = X.
Proof:
  R(X, K(Y, Z), rdiv(W, K(Y, Z)))
= { by lemma 41 R->L }
  R(X, K(Y, Z), ldiv(K(Y, Z), W))
= { by lemma 42 R->L }
  rdiv(op(op(X, K(Y, Z)), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 25 R->L }
  rdiv(op(op(K(Y, Z), X), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 43 }
  rdiv(op(X, op(ldiv(K(Y, Z), W), K(Y, Z))), W)
= { by lemma 41 }
  rdiv(op(X, op(rdiv(W, K(Y, Z)), K(Y, Z))), W)
= { by axiom 9 (sos) }
  rdiv(op(X, W), W)
= { by axiom 3 (sos) }
  X

Lemma 45: rdiv(rdiv(X, K(Y, Z)), X) = rdiv(zero, K(Y, Z)).
Proof:
  rdiv(rdiv(X, K(Y, Z)), X)
= { by lemma 38 R->L }
  rdiv(rdiv(X, K(Y, Z)), op(K(Y, Z), rdiv(X, K(Y, Z)))) (peak)
= { by lemma 34 R->L }
  R(rdiv(zero, K(Y, Z)), K(Y, Z), rdiv(X, K(Y, Z)))
= { by lemma 44 }
  rdiv(zero, K(Y, Z))

Lemma 46: rdiv(op(X, Y), op(Y, X)) = K(X, Y).
Proof:
  rdiv(op(X, Y), op(Y, X))
= { by lemma 28 R->L }
  rdiv(op(K(X, Y), op(Y, X)), op(Y, X)) (peak)
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 47: rdiv(zero, K(X, Y)) = K(Y, X).
Proof:
  rdiv(zero, K(X, Y))
= { by lemma 45 R->L }
  rdiv(rdiv(op(X, Y), K(X, Y)), op(X, Y)) (peak)
= { by lemma 24 }
  rdiv(op(Y, X), op(X, Y))
= { by lemma 46 }
  K(Y, X)

Lemma 48: rdiv(op(X, K(Y, Z)), X) = K(Y, Z).
Proof:
  rdiv(op(X, K(Y, Z)), X) (peak)
= { by lemma 25 R->L }
  rdiv(op(K(Y, Z), X), X) (peak)
= { by axiom 3 (sos) }
  K(Y, Z)

Lemma 49: R(rdiv(X, Y), Y, ldiv(Y, Z)) = rdiv(op(X, ldiv(Y, Z)), Z).
Proof:
  R(rdiv(X, Y), Y, ldiv(Y, Z))
= { by lemma 33 R->L }
  rdiv(op(X, ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 8 (sos) }
  rdiv(op(X, ldiv(Y, Z)), Z)

Lemma 50: R(K(X, Y), Z, ldiv(Z, W)) = K(X, Y).
Proof:
  R(K(X, Y), Z, ldiv(Z, W))
= { by lemma 48 R->L }
  R(rdiv(op(Z, K(X, Y)), Z), Z, ldiv(Z, W)) (peak)
= { by lemma 49 }
  rdiv(op(op(Z, K(X, Y)), ldiv(Z, W)), W) (peak)
= { by lemma 26 }
  rdiv(op(K(X, Y), op(Z, ldiv(Z, W))), W)
= { by axiom 8 (sos) }
  rdiv(op(K(X, Y), W), W)
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 51: R(K(X, Y), Z, W) = K(X, Y).
Proof:
  R(K(X, Y), Z, W)
= { by axiom 4 (sos) R->L }
  R(K(X, Y), Z, ldiv(Z, op(Z, W))) (peak)
= { by lemma 50 }
  K(X, Y)

Lemma 52: op(K(X, Y), Z) = rdiv(Z, K(Y, X)).
Proof:
  op(K(X, Y), Z)
= { by lemma 36 R->L }
  ldiv(R(rdiv(zero, K(X, Y)), K(X, Y), Z), Z) (peak)
= { by lemma 47 }
  ldiv(R(K(Y, X), K(X, Y), Z), Z)
= { by lemma 51 }
  ldiv(K(Y, X), Z)
= { by lemma 41 }
  rdiv(Z, K(Y, X))

Lemma 53: op(X, K(Y, Z)) = rdiv(X, K(Z, Y)).
Proof:
  op(X, K(Y, Z))
= { by axiom 15 (sos) }
  op(op(K(Y, Z), X), K(X, K(Y, Z))) (peak)
= { by lemma 52 }
  op(rdiv(X, K(Z, Y)), K(X, K(Y, Z)))
= { by axiom 6 (sos) }
  op(rdiv(X, K(Z, Y)), 1)
= { by lemma 22 }
  op(rdiv(X, K(Z, Y)), zero)
= { by axiom 1 (sos) }
  rdiv(X, K(Z, Y))

Lemma 54: op(X, T(Y, X)) = op(Y, X).
Proof:
  op(X, T(Y, X))
= { by axiom 5 (sos) }
  op(X, ldiv(X, op(Y, X))) (peak)
= { by axiom 8 (sos) }
  op(Y, X)

Lemma 55: op(K(X, Y), X) = T(X, Y).
Proof:
  op(K(X, Y), X)
= { by axiom 15 (sos) }
  op(op(X, K(X, Y)), K(K(X, Y), X)) (peak)
= { by lemma 30 }
  op(T(X, Y), K(K(X, Y), X))
= { by axiom 7 (sos) }
  op(T(X, Y), 1)
= { by lemma 22 }
  op(T(X, Y), zero)
= { by axiom 1 (sos) }
  T(X, Y)

Lemma 56: op(K(X, Y), Y) = rdiv(op(X, Y), X).
Proof:
  op(K(X, Y), Y)
= { by axiom 15 (sos) }
  op(op(Y, K(X, Y)), K(K(X, Y), Y)) (peak)
= { by lemma 32 }
  op(rdiv(op(X, Y), X), K(K(X, Y), Y)) (peak)
= { by axiom 7 (sos) }
  op(rdiv(op(X, Y), X), 1)
= { by lemma 22 }
  op(rdiv(op(X, Y), X), zero)
= { by axiom 1 (sos) }
  rdiv(op(X, Y), X)

Lemma 57: ldiv(X, T(X, Y)) = K(X, Y).
Proof:
  ldiv(X, T(X, Y))
= { by lemma 30 R->L }
  ldiv(X, op(X, K(X, Y))) (peak)
= { by axiom 4 (sos) }
  K(X, Y)

Lemma 58: rdiv(X, ldiv(Y, X)) = Y.
Proof:
  rdiv(X, ldiv(Y, X))
= { by axiom 8 (sos) R->L }
  rdiv(op(Y, ldiv(Y, X)), ldiv(Y, X)) (peak)
= { by axiom 3 (sos) }
  Y

Lemma 59: rdiv(op(X, Y), T(X, Y)) = Y.
Proof:
  rdiv(op(X, Y), T(X, Y))
= { by axiom 5 (sos) }
  rdiv(op(X, Y), ldiv(Y, op(X, Y))) (peak)
= { by lemma 58 }
  Y

Lemma 60: rdiv(T(X, Y), X) = K(X, Y).
Proof:
  rdiv(T(X, Y), X)
= { by lemma 40 R->L }
  rdiv(T(X, Y), T(X, K(X, Y)))
= { by lemma 30 R->L }
  rdiv(op(X, K(X, Y)), T(X, K(X, Y))) (peak)
= { by lemma 59 }
  K(X, Y)

Lemma 61: ldiv(X, T(X, Y)) = rdiv(T(X, Y), X).
Proof:
  ldiv(X, T(X, Y)) (peak)
= { by lemma 57 }
  K(X, Y)
= { by lemma 60 R->L }
  rdiv(T(X, Y), X)

Lemma 62: ldiv(X, rdiv(op(Y, X), Y)) = K(Y, X).
Proof:
  ldiv(X, rdiv(op(Y, X), Y)) (peak)
= { by lemma 32 R->L }
  ldiv(X, op(X, K(Y, X))) (peak)
= { by axiom 4 (sos) }
  K(Y, X)

Lemma 63: K(X, T(Y, X)) = ldiv(T(Y, X), Y).
Proof:
  K(X, T(Y, X))
= { by lemma 62 R->L }
  ldiv(T(Y, X), rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 54 }
  ldiv(T(Y, X), rdiv(op(Y, X), X))
= { by axiom 3 (sos) }
  ldiv(T(Y, X), Y)

Lemma 64: ldiv(op(X, Y), op(Y, X)) = K(Y, X).
Proof:
  ldiv(op(X, Y), op(Y, X))
= { by axiom 15 (sos) }
  ldiv(op(X, Y), op(op(X, Y), K(Y, X))) (peak)
= { by axiom 4 (sos) }
  K(Y, X)

Lemma 65: K(X, rdiv(op(X, Y), X)) = L(K(X, Y), Y, X).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 32 R->L }
  K(X, op(Y, K(X, Y)))
= { by lemma 64 R->L }
  ldiv(op(op(Y, K(X, Y)), X), op(X, op(Y, K(X, Y)))) (peak)
= { by lemma 31 }
  ldiv(op(X, Y), op(X, op(Y, K(X, Y))))
= { by axiom 17 (sos) R->L }
  L(K(X, Y), Y, X)

Lemma 66: T(K(X, Y), Z) = K(X, Y).
Proof:
  T(K(X, Y), Z)
= { by axiom 5 (sos) }
  ldiv(Z, op(K(X, Y), Z)) (peak)
= { by lemma 25 }
  ldiv(Z, op(Z, K(X, Y))) (peak)
= { by axiom 4 (sos) }
  K(X, Y)

Lemma 67: L(K(X, Y), Z, W) = K(X, Y).
Proof:
  L(K(X, Y), Z, W)
= { by axiom 17 (sos) }
  ldiv(op(W, Z), op(W, op(Z, K(X, Y)))) (peak)
= { by lemma 27 R->L }
  ldiv(op(W, Z), op(K(X, Y), op(W, Z))) (peak)
= { by axiom 5 (sos) R->L }
  T(K(X, Y), op(W, Z))
= { by lemma 66 }
  K(X, Y)

Lemma 68: K(X, rdiv(op(X, Y), X)) = K(X, Y).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 65 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 67 }
  K(X, Y)

Lemma 69: K(X, T(Y, X)) = K(X, Y).
Proof:
  K(X, T(Y, X))
= { by lemma 68 R->L }
  K(X, rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 54 }
  K(X, rdiv(op(Y, X), X))
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 70: ldiv(T(X, Y), X) = K(Y, X).
Proof:
  ldiv(T(X, Y), X) (peak)
= { by lemma 63 R->L }
  K(Y, T(X, Y)) (peak)
= { by lemma 69 }
  K(Y, X)

Lemma 71: T(X, ldiv(X, Y)) = ldiv(ldiv(X, Y), Y).
Proof:
  T(X, ldiv(X, Y))
= { by axiom 5 (sos) }
  ldiv(ldiv(X, Y), op(X, ldiv(X, Y))) (peak)
= { by axiom 8 (sos) }
  ldiv(ldiv(X, Y), Y)

Lemma 72: rdiv(X, T(Y, ldiv(Y, X))) = ldiv(Y, X).
Proof:
  rdiv(X, T(Y, ldiv(Y, X))) (peak)
= { by lemma 71 }
  rdiv(X, ldiv(ldiv(Y, X), X)) (peak)
= { by lemma 58 }
  ldiv(Y, X)

Lemma 73: T(X, ldiv(T(Y, Z), Y)) = X.
Proof:
  T(X, ldiv(T(Y, Z), Y)) (peak)
= { by lemma 63 R->L }
  T(X, K(Z, T(Y, Z))) (peak)
= { by lemma 40 }
  X

Lemma 74: ldiv(T(X, Y), X) = rdiv(X, T(X, Y)).
Proof:
  ldiv(T(X, Y), X)
= { by lemma 72 R->L }
  rdiv(X, T(T(X, Y), ldiv(T(X, Y), X))) (peak)
= { by lemma 73 }
  rdiv(X, T(X, Y))

Lemma 75: rdiv(X, K(Y, X)) = T(X, Y).
Proof:
  rdiv(X, K(Y, X))
= { by lemma 70 R->L }
  rdiv(X, ldiv(T(X, Y), X)) (peak)
= { by lemma 58 }
  T(X, Y)

Lemma 76: L(rdiv(X, T(X, Y)), Z, W) = rdiv(X, T(X, Y)).
Proof:
  L(rdiv(X, T(X, Y)), Z, W)
= { by lemma 74 R->L }
  L(ldiv(T(X, Y), X), Z, W) (peak)
= { by lemma 63 R->L }
  L(K(Y, T(X, Y)), Z, W) (peak)
= { by lemma 67 }
  K(Y, T(X, Y))
= { by lemma 63 }
  ldiv(T(X, Y), X) (peak)
= { by lemma 74 }
  rdiv(X, T(X, Y))

Lemma 77: L(rdiv(X, T(X, Y)), T(X, Y), Y) = K(Y, X).
Proof:
  L(rdiv(X, T(X, Y)), T(X, Y), Y)
= { by lemma 74 R->L }
  L(ldiv(T(X, Y), X), T(X, Y), Y) (peak)
= { by lemma 63 R->L }
  L(K(Y, T(X, Y)), T(X, Y), Y) (peak)
= { by lemma 65 R->L }
  K(Y, rdiv(op(Y, T(X, Y)), Y))
= { by lemma 54 }
  K(Y, rdiv(op(X, Y), Y))
= { by axiom 3 (sos) }
  K(Y, X)

Lemma 78: rdiv(Y, T(Y, X)) = K(X, Y).
Proof:
  rdiv(Y, T(Y, X))
= { by lemma 76 R->L }
  L(rdiv(Y, T(Y, X)), T(Y, X), X) (peak)
= { by lemma 77 }
  K(X, Y)

Lemma 79: K(X, ldiv(X, Y)) = K(X, rdiv(Y, X)).
Proof:
  K(X, ldiv(X, Y))
= { by lemma 68 R->L }
  K(X, rdiv(op(X, ldiv(X, Y)), X)) (peak)
= { by axiom 8 (sos) }
  K(X, rdiv(Y, X))

Lemma 80: rdiv(rdiv(op(X, Y), X), Y) = K(X, Y).
Proof:
  rdiv(rdiv(op(X, Y), X), Y)
= { by lemma 40 R->L }
  rdiv(rdiv(op(X, Y), X), T(Y, K(X, Y))) (peak)
= { by lemma 32 R->L }
  rdiv(op(Y, K(X, Y)), T(Y, K(X, Y))) (peak)
= { by lemma 59 }
  K(X, Y)

Lemma 81: K(X, T(Y, X)) = rdiv(Y, T(Y, X)).
Proof:
  K(X, T(Y, X))
= { by lemma 80 R->L }
  rdiv(rdiv(op(X, T(Y, X)), X), T(Y, X)) (peak)
= { by lemma 54 }
  rdiv(rdiv(op(Y, X), X), T(Y, X))
= { by axiom 3 (sos) }
  rdiv(Y, T(Y, X))

Lemma 82: op(X, rdiv(Y, T(Y, Z))) = rdiv(X, rdiv(T(Y, Z), Y)).
Proof:
  op(X, rdiv(Y, T(Y, Z))) (peak)
= { by lemma 78 }
  op(X, K(Z, Y))
= { by lemma 53 }
  rdiv(X, K(Y, Z))
= { by lemma 60 R->L }
  rdiv(X, rdiv(T(Y, Z), Y))

Lemma 83: op(rdiv(op(Z, X), Z), Y) = op(X, op(Y, K(Z, X))).
Proof:
  op(rdiv(op(Z, X), Z), Y) (peak)
= { by lemma 32 R->L }
  op(op(X, K(Z, X)), Y) (peak)
= { by lemma 26 }
  op(K(Z, X), op(X, Y))
= { by lemma 27 }
  op(X, op(Y, K(Z, X)))

Lemma 84: op(T(X, Y), op(Z, rdiv(X, T(X, Y)))) = op(X, Z).
Proof:
  op(T(X, Y), op(Z, rdiv(X, T(X, Y))))
= { by lemma 74 R->L }
  op(T(X, Y), op(Z, ldiv(T(X, Y), X))) (peak)
= { by lemma 63 R->L }
  op(T(X, Y), op(Z, K(Y, T(X, Y)))) (peak)
= { by lemma 83 R->L }
  op(rdiv(op(Y, T(X, Y)), Y), Z)
= { by lemma 54 }
  op(rdiv(op(X, Y), Y), Z)
= { by axiom 3 (sos) }
  op(X, Z)

Lemma 85: a(X, Y, rdiv(Z, T(Z, W))) = zero.
Proof:
  a(X, Y, rdiv(Z, T(Z, W)))
= { by lemma 74 R->L }
  a(X, Y, ldiv(T(Z, W), Z)) (peak)
= { by lemma 63 R->L }
  a(X, Y, K(W, T(Z, W))) (peak)
= { by axiom 11 (sos) }
  1
= { by lemma 22 }
  zero

Lemma 86: rdiv(op(T(X, Y), Z), rdiv(T(X, Y), X)) = op(X, Z).
Proof:
  rdiv(op(T(X, Y), Z), rdiv(T(X, Y), X))
= { by lemma 82 R->L }
  op(op(T(X, Y), Z), rdiv(X, T(X, Y)))
= { by axiom 18 (sos) }
  op(op(T(X, Y), op(Z, rdiv(X, T(X, Y)))), a(T(X, Y), Z, rdiv(X, T(X, Y)))) (peak)
= { by lemma 84 }
  op(op(X, Z), a(T(X, Y), Z, rdiv(X, T(X, Y))))
= { by lemma 85 }
  op(op(X, Z), zero)
= { by axiom 1 (sos) }
  op(X, Z)

Lemma 87: op(rdiv(X, T(X, Y)), Z) = rdiv(Z, rdiv(T(X, Y), X)).
Proof:
  op(rdiv(X, T(X, Y)), Z) (peak)
= { by lemma 78 }
  op(K(Y, X), Z)
= { by lemma 52 }
  rdiv(Z, K(X, Y))
= { by lemma 60 R->L }
  rdiv(Z, rdiv(T(X, Y), X))

Lemma 88: op(K(X, Y), op(Z, Y)) = op(Z, rdiv(op(X, Y), X)).
Proof:
  op(K(X, Y), op(Z, Y)) (peak)
= { by lemma 27 }
  op(Z, op(Y, K(X, Y))) (peak)
= { by lemma 32 }
  op(Z, rdiv(op(X, Y), X)) (peak)

Lemma 89: rdiv(op(X, T(Y, Z)), rdiv(T(Y, Z), Y)) = op(X, Y).
Proof:
  rdiv(op(X, T(Y, Z)), rdiv(T(Y, Z), Y))
= { by lemma 87 R->L }
  op(rdiv(Y, T(Y, Z)), op(X, T(Y, Z)))
= { by lemma 74 R->L }
  op(ldiv(T(Y, Z), Y), op(X, T(Y, Z))) (peak)
= { by lemma 63 R->L }
  op(K(Z, T(Y, Z)), op(X, T(Y, Z))) (peak)
= { by lemma 88 }
  op(X, rdiv(op(Z, T(Y, Z)), Z))
= { by lemma 54 }
  op(X, rdiv(op(Y, Z), Z))
= { by axiom 3 (sos) }
  op(X, Y)

Lemma 90: op(X, T(Y, T(X, Z))) = op(Y, X).
Proof:
  op(X, T(Y, T(X, Z)))
= { by lemma 86 R->L }
  rdiv(op(T(X, Z), T(Y, T(X, Z))), rdiv(T(X, Z), X)) (peak)
= { by lemma 54 }
  rdiv(op(Y, T(X, Z)), rdiv(T(X, Z), X))
= { by lemma 89 }
  op(Y, X)

Lemma 91: T(X, T(Y, Z)) = T(X, Y).
Proof:
  T(X, T(Y, Z))
= { by axiom 4 (sos) R->L }
  ldiv(Y, op(Y, T(X, T(Y, Z)))) (peak)
= { by lemma 90 }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 92: K(X, T(Y, Z)) = rdiv(T(X, Y), X).
Proof:
  K(X, T(Y, Z))
= { by lemma 57 R->L }
  ldiv(X, T(X, T(Y, Z))) (peak)
= { by lemma 91 }
  ldiv(X, T(X, Y))
= { by lemma 61 }
  rdiv(T(X, Y), X)

Lemma 93: T(X, ldiv(X, Y)) = T(X, rdiv(Y, X)).
Proof:
  T(X, ldiv(X, Y))
= { by lemma 30 R->L }
  op(X, K(X, ldiv(X, Y))) (peak)
= { by lemma 79 }
  op(X, K(X, rdiv(Y, X)))
= { by lemma 30 }
  T(X, rdiv(Y, X))

Lemma 94: K(ldiv(X, Y), X) = K(rdiv(Y, X), X).
Proof:
  K(ldiv(X, Y), X)
= { by lemma 69 R->L }
  K(ldiv(X, Y), T(X, ldiv(X, Y))) (peak)
= { by lemma 63 }
  ldiv(T(X, ldiv(X, Y)), X)
= { by lemma 93 }
  ldiv(T(X, rdiv(Y, X)), X)
= { by lemma 70 }
  K(rdiv(Y, X), X)

Lemma 95: K(T(X, Z), Y) = K(X, Y).
Proof:
  K(T(X, Z), Y)
= { by lemma 70 R->L }
  ldiv(T(Y, T(X, Z)), Y) (peak)
= { by lemma 91 }
  ldiv(T(Y, X), Y)
= { by lemma 63 R->L }
  K(X, T(Y, X)) (peak)
= { by lemma 69 }
  K(X, Y)

Lemma 96: ldiv(op(Z, X), op(Z, Y)) = L(ldiv(X, Y), X, Z).
Proof:
  ldiv(op(Z, X), op(Z, Y))
= { by axiom 8 (sos) R->L }
  ldiv(op(Z, X), op(Z, op(X, ldiv(X, Y)))) (peak)
= { by axiom 17 (sos) R->L }
  L(ldiv(X, Y), X, Z)

Lemma 97: ldiv(op(X, Y), op(X, op(Z, Y))) = L(T(Z, Y), Y, X).
Proof:
  ldiv(op(X, Y), op(X, op(Z, Y))) (peak)
= { by lemma 96 }
  L(ldiv(Y, op(Z, Y)), Y, X) (peak)
= { by axiom 5 (sos) R->L }
  L(T(Z, Y), Y, X)

Lemma 98: op(op(X, Y), K(Z, W)) = op(X, op(Y, K(Z, W))).
Proof:
  op(op(X, Y), K(Z, W)) (peak)
= { by lemma 25 R->L }
  op(K(Z, W), op(X, Y)) (peak)
= { by lemma 27 }
  op(X, op(Y, K(Z, W))) (peak)

Lemma 99: L(T(X, Y), Y, K(Z, W)) = T(X, rdiv(Y, K(W, Z))).
Proof:
  L(T(X, Y), Y, K(Z, W))
= { by lemma 97 R->L }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(X, Y))) (peak)
= { by lemma 25 }
  ldiv(op(K(Z, W), Y), op(op(X, Y), K(Z, W))) (peak)
= { by lemma 52 }
  ldiv(rdiv(Y, K(W, Z)), op(op(X, Y), K(Z, W)))
= { by lemma 98 }
  ldiv(rdiv(Y, K(W, Z)), op(X, op(Y, K(Z, W))))
= { by lemma 53 }
  ldiv(rdiv(Y, K(W, Z)), op(X, rdiv(Y, K(W, Z))))
= { by axiom 5 (sos) R->L }
  T(X, rdiv(Y, K(W, Z)))

Lemma 100: a(K(X, Y), Z, W) = zero.
Proof:
  a(K(X, Y), Z, W) (peak)
= { by axiom 13 (sos) }
  1
= { by lemma 22 }
  zero

Lemma 101: op(a(X, Y, Z), W) = op(W, a(X, Y, Z)).
Proof:
  op(a(X, Y, Z), W)
= { by lemma 24 R->L }
  rdiv(op(W, a(X, Y, Z)), K(W, a(X, Y, Z))) (peak)
= { by axiom 10 (sos) }
  rdiv(op(W, a(X, Y, Z)), 1)
= { by lemma 22 }
  rdiv(op(W, a(X, Y, Z)), zero)
= { by lemma 23 }
  op(W, a(X, Y, Z))

Lemma 102: op(op(X, Y), a(Z, W, V)) = op(X, op(Y, a(Z, W, V))).
Proof:
  op(op(X, Y), a(Z, W, V))
= { by axiom 18 (sos) }
  op(op(X, op(Y, a(Z, W, V))), a(X, Y, a(Z, W, V))) (peak)
= { by lemma 101 R->L }
  op(op(X, op(a(Z, W, V), Y)), a(X, Y, a(Z, W, V))) (peak)
= { by axiom 14 (sos) }
  op(op(X, op(a(Z, W, V), Y)), 1)
= { by lemma 22 }
  op(op(X, op(a(Z, W, V), Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(a(Z, W, V), Y))
= { by lemma 101 }
  op(X, op(Y, a(Z, W, V)))

Lemma 103: op(X, op(Y, op(Z, a(X, Y, Z)))) = op(op(X, Y), Z).
Proof:
  op(X, op(Y, op(Z, a(X, Y, Z))))
= { by lemma 102 R->L }
  op(X, op(op(Y, Z), a(X, Y, Z)))
= { by lemma 102 R->L }
  op(op(X, op(Y, Z)), a(X, Y, Z)) (peak)
= { by axiom 18 (sos) R->L }
  op(op(X, Y), Z)

Lemma 104: L(op(X, a(Y, Z, X)), Z, Y) = X.
Proof:
  L(op(X, a(Y, Z, X)), Z, Y)
= { by axiom 17 (sos) }
  ldiv(op(Y, Z), op(Y, op(Z, op(X, a(Y, Z, X))))) (peak)
= { by lemma 103 }
  ldiv(op(Y, Z), op(op(Y, Z), X))
= { by axiom 4 (sos) }
  X

Lemma 105: L(X, Y, K(Z, W)) = X.
Proof:
  L(X, Y, K(Z, W))
= { by axiom 1 (sos) R->L }
  L(op(X, zero), Y, K(Z, W))
= { by lemma 100 R->L }
  L(op(X, a(K(Z, W), Y, X)), Y, K(Z, W)) (peak)
= { by lemma 104 }
  X

Lemma 106: T(X, rdiv(Y, K(Z, W))) = T(X, Y).
Proof:
  T(X, rdiv(Y, K(Z, W)))
= { by lemma 99 R->L }
  L(T(X, Y), Y, K(W, Z)) (peak)
= { by lemma 105 }
  T(X, Y)

Lemma 107: op(X, K(rdiv(Y, X), X)) = rdiv(Y, rdiv(Y, X)).
Proof:
  op(X, K(rdiv(Y, X), X))
= { by lemma 32 }
  rdiv(op(rdiv(Y, X), X), rdiv(Y, X)) (peak)
= { by axiom 9 (sos) }
  rdiv(Y, rdiv(Y, X))

Lemma 108: rdiv(ldiv(X, Y), K(rdiv(Y, X), X)) = rdiv(Y, X).
Proof:
  rdiv(ldiv(X, Y), K(rdiv(Y, X), X))
= { by lemma 53 R->L }
  op(ldiv(X, Y), K(X, rdiv(Y, X)))
= { by lemma 79 R->L }
  op(ldiv(X, Y), K(X, ldiv(X, Y)))
= { by lemma 58 R->L }
  op(ldiv(X, Y), K(rdiv(Y, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 107 }
  rdiv(Y, rdiv(Y, ldiv(X, Y)))
= { by lemma 58 }
  rdiv(Y, X)

Lemma 109: T(X, ldiv(Y, Z)) = T(X, rdiv(Z, Y)).
Proof:
  T(X, ldiv(Y, Z))
= { by lemma 106 R->L }
  T(X, rdiv(ldiv(Y, Z), K(rdiv(Z, Y), Y))) (peak)
= { by lemma 108 }
  T(X, rdiv(Z, Y))

Lemma 110: ldiv(rdiv(X, T(X, Y)), Z) = rdiv(Z, rdiv(X, T(X, Y))).
Proof:
  ldiv(rdiv(X, T(X, Y)), Z)
= { by lemma 74 R->L }
  ldiv(ldiv(T(X, Y), X), Z) (peak)
= { by lemma 63 R->L }
  ldiv(K(Y, T(X, Y)), Z) (peak)
= { by lemma 41 }
  rdiv(Z, K(Y, T(X, Y)))
= { by lemma 63 }
  rdiv(Z, ldiv(T(X, Y), X)) (peak)
= { by lemma 74 }
  rdiv(Z, rdiv(X, T(X, Y)))

Lemma 111: rdiv(X, rdiv(X, T(X, Y))) = T(X, Y).
Proof:
  rdiv(X, rdiv(X, T(X, Y)))
= { by lemma 110 R->L }
  ldiv(rdiv(X, T(X, Y)), X) (peak)
= { by lemma 35 }
  T(X, Y)

Lemma 112: rdiv(X, rdiv(T(Y, X), Y)) = T(X, T(Y, Z)).
Proof:
  rdiv(X, rdiv(T(Y, X), Y))
= { by lemma 61 R->L }
  rdiv(X, ldiv(Y, T(Y, X))) (peak)
= { by lemma 57 }
  rdiv(X, K(Y, X))
= { by lemma 75 }
  T(X, Y)
= { by lemma 91 R->L }
  T(X, T(Y, Z)) (peak)

Lemma 113: op(X, rdiv(Y, T(Y, Z))) = ldiv(T(Y, Z), op(Y, X)).
Proof:
  op(X, rdiv(Y, T(Y, Z)))
= { by axiom 4 (sos) R->L }
  ldiv(T(Y, Z), op(T(Y, Z), op(X, rdiv(Y, T(Y, Z))))) (peak)
= { by lemma 84 }
  ldiv(T(Y, Z), op(Y, X))

Lemma 114: K(rdiv(X, T(X, Y)), Z) = zero.
Proof:
  K(rdiv(X, T(X, Y)), Z)
= { by lemma 74 R->L }
  K(ldiv(T(X, Y), X), Z) (peak)
= { by lemma 63 R->L }
  K(K(Y, T(X, Y)), Z) (peak)
= { by axiom 7 (sos) }
  1
= { by lemma 22 }
  zero

Lemma 115: op(rdiv(X, T(X, Y)), Z) = ldiv(T(X, Y), op(X, Z)).
Proof:
  op(rdiv(X, T(X, Y)), Z)
= { by axiom 15 (sos) }
  op(op(Z, rdiv(X, T(X, Y))), K(rdiv(X, T(X, Y)), Z)) (peak)
= { by lemma 113 }
  op(ldiv(T(X, Y), op(X, Z)), K(rdiv(X, T(X, Y)), Z))
= { by lemma 114 }
  op(ldiv(T(X, Y), op(X, Z)), zero)
= { by axiom 1 (sos) }
  ldiv(T(X, Y), op(X, Z))

Lemma 116: op(op(X, Y), L(Z, Y, X)) = op(X, op(Y, Z)).
Proof:
  op(op(X, Y), L(Z, Y, X))
= { by axiom 17 (sos) }
  op(op(X, Y), ldiv(op(X, Y), op(X, op(Y, Z)))) (peak)
= { by axiom 8 (sos) }
  op(X, op(Y, Z))

Lemma 117: op(X, L(Y, ldiv(Z, X), Z)) = op(Z, op(ldiv(Z, X), Y)).
Proof:
  op(X, L(Y, ldiv(Z, X), Z))
= { by axiom 8 (sos) R->L }
  op(op(Z, ldiv(Z, X)), L(Y, ldiv(Z, X), Z)) (peak)
= { by lemma 116 }
  op(Z, op(ldiv(Z, X), Y))

Lemma 118: op(X, op(ldiv(X, zero), Y)) = L(Y, ldiv(X, zero), X).
Proof:
  op(X, op(ldiv(X, zero), Y))
= { by lemma 117 R->L }
  op(zero, L(Y, ldiv(X, zero), X)) (peak)
= { by axiom 2 (sos) }
  L(Y, ldiv(X, zero), X)

Lemma 119: op(X, ldiv(T(X, Y), zero)) = rdiv(X, T(X, Y)).
Proof:
  op(X, ldiv(T(X, Y), zero))
= { by lemma 84 R->L }
  op(T(X, Y), op(ldiv(T(X, Y), zero), rdiv(X, T(X, Y)))) (peak)
= { by lemma 118 }
  L(rdiv(X, T(X, Y)), ldiv(T(X, Y), zero), T(X, Y))
= { by lemma 76 }
  rdiv(X, T(X, Y))

Lemma 120: R(rdiv(X, Y), Y, ldiv(X, Z)) = rdiv(Z, op(Y, ldiv(X, Z))).
Proof:
  R(rdiv(X, Y), Y, ldiv(X, Z)) (peak)
= { by lemma 33 R->L }
  rdiv(op(X, ldiv(X, Z)), op(Y, ldiv(X, Z))) (peak)
= { by axiom 8 (sos) }
  rdiv(Z, op(Y, ldiv(X, Z)))

Lemma 121: ldiv(op(ldiv(X, Y), X), Y) = K(X, ldiv(X, Y)).
Proof:
  ldiv(op(ldiv(X, Y), X), Y)
= { by axiom 8 (sos) R->L }
  ldiv(op(ldiv(X, Y), X), op(X, ldiv(X, Y))) (peak)
= { by lemma 64 }
  K(X, ldiv(X, Y))

Lemma 122: ldiv(X, op(Y, T(X, Y))) = Y.
Proof:
  ldiv(X, op(Y, T(X, Y))) (peak)
= { by lemma 54 }
  ldiv(X, op(X, Y))
= { by axiom 4 (sos) }
  Y

Lemma 123: L(ldiv(X, T(X, Y)), X, Y) = K(X, Y).
Proof:
  L(ldiv(X, T(X, Y)), X, Y) (peak)
= { by lemma 96 R->L }
  ldiv(op(Y, X), op(Y, T(X, Y))) (peak)
= { by lemma 54 }
  ldiv(op(Y, X), op(X, Y))
= { by lemma 64 }
  K(X, Y)

Lemma 124: K(X, rdiv(op(Y, T(X, Y)), X)) = rdiv(T(X, Y), X).
Proof:
  K(X, rdiv(op(Y, T(X, Y)), X))
= { by lemma 79 R->L }
  K(X, ldiv(X, op(Y, T(X, Y))))
= { by lemma 121 R->L }
  ldiv(op(ldiv(X, op(Y, T(X, Y))), X), op(Y, T(X, Y))) (peak)
= { by lemma 122 }
  ldiv(op(Y, X), op(Y, T(X, Y)))
= { by lemma 96 }
  L(ldiv(X, T(X, Y)), X, Y)
= { by lemma 123 }
  K(X, Y)
= { by lemma 60 R->L }
  rdiv(T(X, Y), X)

Lemma 125: R(rdiv(T(X, Y), X), Z, W) = rdiv(T(X, Y), X).
Proof:
  R(rdiv(T(X, Y), X), Z, W)
= { by lemma 124 R->L }
  R(K(X, rdiv(op(Y, T(X, Y)), X)), Z, W) (peak)
= { by lemma 51 }
  K(X, rdiv(op(Y, T(X, Y)), X))
= { by lemma 124 }
  rdiv(T(X, Y), X)

Lemma 126: rdiv(zero, rdiv(X, T(X, Y))) = rdiv(T(X, Y), X).
Proof:
  rdiv(zero, rdiv(X, T(X, Y)))
= { by lemma 119 R->L }
  rdiv(zero, op(X, ldiv(T(X, Y), zero)))
= { by lemma 120 R->L }
  R(rdiv(T(X, Y), X), X, ldiv(T(X, Y), zero)) (peak)
= { by lemma 125 }
  rdiv(T(X, Y), X)

Lemma 127: ldiv(rdiv(T(X, Y), X), Z) = rdiv(Z, rdiv(T(X, Y), X)).
Proof:
  ldiv(rdiv(T(X, Y), X), Z)
= { by lemma 124 R->L }
  ldiv(K(X, rdiv(op(Y, T(X, Y)), X)), Z) (peak)
= { by lemma 41 }
  rdiv(Z, K(X, rdiv(op(Y, T(X, Y)), X)))
= { by lemma 124 }
  rdiv(Z, rdiv(T(X, Y), X))

Lemma 128: ldiv(T(X, Y), op(X, Z)) = rdiv(Z, rdiv(T(X, Y), X)).
Proof:
  ldiv(T(X, Y), op(X, Z))
= { by lemma 115 R->L }
  op(rdiv(X, T(X, Y)), Z)
= { by lemma 36 R->L }
  ldiv(R(rdiv(zero, rdiv(X, T(X, Y))), rdiv(X, T(X, Y)), Z), Z) (peak)
= { by lemma 126 }
  ldiv(R(rdiv(T(X, Y), X), rdiv(X, T(X, Y)), Z), Z)
= { by lemma 125 }
  ldiv(rdiv(T(X, Y), X), Z)
= { by lemma 127 }
  rdiv(Z, rdiv(T(X, Y), X))

Lemma 129: op(K(X, Y), op(X, T(Y, X))) = op(X, Y).
Proof:
  op(K(X, Y), op(X, T(Y, X)))
= { by lemma 25 }
  op(op(X, T(Y, X)), K(X, Y)) (peak)
= { by lemma 54 }
  op(op(Y, X), K(X, Y))
= { by axiom 15 (sos) R->L }
  op(X, Y)

Lemma 130: rdiv(op(X, Y), op(X, T(Y, X))) = rdiv(Y, T(Y, X)).
Proof:
  rdiv(op(X, Y), op(X, T(Y, X)))
= { by lemma 129 R->L }
  rdiv(op(K(X, Y), op(X, T(Y, X))), op(X, T(Y, X))) (peak)
= { by axiom 3 (sos) }
  K(X, Y)
= { by lemma 78 R->L }
  rdiv(Y, T(Y, X))

Lemma 131: ldiv(op(rdiv(Z, op(Y, X)), Y), Z) = L(X, Y, rdiv(Z, op(Y, X))).
Proof:
  ldiv(op(rdiv(Z, op(Y, X)), Y), Z)
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(Z, op(Y, X)), Y), op(rdiv(Z, op(Y, X)), op(Y, X))) (peak)
= { by axiom 17 (sos) R->L }
  L(X, Y, rdiv(Z, op(Y, X)))

Lemma 132: rdiv(op(X, Y), op(X, T(Y, X))) = K(X, Y).
Proof:
  rdiv(op(X, Y), op(X, T(Y, X))) (peak)
= { by lemma 54 }
  rdiv(op(X, Y), op(Y, X))
= { by lemma 46 }
  K(X, Y)

Lemma 133: ldiv(T(X, Y), op(X, Y)) = T(Y, T(X, Y)).
Proof:
  ldiv(T(X, Y), op(X, Y))
= { by lemma 54 R->L }
  ldiv(T(X, Y), op(Y, T(X, Y))) (peak)
= { by axiom 5 (sos) R->L }
  T(Y, T(X, Y))

Lemma 134: L(T(X, Y), Y, rdiv(X, T(X, Y))) = T(X, Y).
Proof:
  L(T(X, Y), Y, rdiv(X, T(X, Y)))
= { by lemma 130 R->L }
  L(T(X, Y), Y, rdiv(op(Y, X), op(Y, T(X, Y))))
= { by lemma 131 R->L }
  ldiv(op(rdiv(op(Y, X), op(Y, T(X, Y))), Y), op(Y, X)) (peak)
= { by lemma 132 }
  ldiv(op(K(Y, X), Y), op(Y, X))
= { by lemma 55 }
  ldiv(T(Y, X), op(Y, X))
= { by lemma 133 }
  T(X, T(Y, X))
= { by lemma 91 }
  T(X, Y)

Lemma 135: ldiv(T(X, T(T(Y, Z), W)), op(X, Y)) = T(Y, X).
Proof:
  ldiv(T(X, T(T(Y, Z), W)), op(X, Y)) (peak)
= { by lemma 91 }
  ldiv(T(X, T(Y, Z)), op(X, Y))
= { by lemma 112 R->L }
  ldiv(rdiv(X, rdiv(T(Y, X), Y)), op(X, Y))
= { by lemma 128 R->L }
  ldiv(ldiv(T(Y, X), op(Y, X)), op(X, Y))
= { by lemma 115 R->L }
  ldiv(op(rdiv(Y, T(Y, X)), X), op(X, Y))
= { by lemma 130 R->L }
  ldiv(op(rdiv(op(X, Y), op(X, T(Y, X))), X), op(X, Y)) (peak)
= { by lemma 131 }
  L(T(Y, X), X, rdiv(op(X, Y), op(X, T(Y, X))))
= { by lemma 132 }
  L(T(Y, X), X, K(X, Y))
= { by lemma 78 R->L }
  L(T(Y, X), X, rdiv(Y, T(Y, X)))
= { by lemma 134 }
  T(Y, X)

Lemma 136: ldiv(ldiv(ldiv(X, Y), Y), Y) = T(ldiv(X, Y), X).
Proof:
  ldiv(ldiv(ldiv(X, Y), Y), Y)
= { by axiom 8 (sos) R->L }
  ldiv(ldiv(ldiv(X, Y), Y), op(X, ldiv(X, Y))) (peak)
= { by lemma 71 R->L }
  ldiv(T(X, ldiv(X, Y)), op(X, ldiv(X, Y))) (peak)
= { by lemma 133 }
  T(ldiv(X, Y), T(X, ldiv(X, Y)))
= { by lemma 91 }
  T(ldiv(X, Y), X)

Lemma 137: rdiv(X, T(ldiv(Y, X), Y)) = ldiv(ldiv(Y, X), X).
Proof:
  rdiv(X, T(ldiv(Y, X), Y)) (peak)
= { by lemma 136 R->L }
  rdiv(X, ldiv(ldiv(ldiv(Y, X), X), X)) (peak)
= { by lemma 58 }
  ldiv(ldiv(Y, X), X)

Lemma 138: rdiv(op(X, Y), T(Y, X)) = T(X, Y).
Proof:
  rdiv(op(X, Y), T(Y, X))
= { by axiom 4 (sos) R->L }
  rdiv(op(X, Y), T(ldiv(X, op(X, Y)), X)) (peak)
= { by lemma 137 }
  ldiv(ldiv(X, op(X, Y)), op(X, Y))
= { by axiom 4 (sos) }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 139: rdiv(op(X, Y), T(Y, X)) = T(X, T(Y, Z)).
Proof:
  rdiv(op(X, Y), T(Y, X)) (peak)
= { by lemma 138 }
  T(X, Y)
= { by lemma 91 R->L }
  T(X, T(Y, Z)) (peak)

Lemma 140: ldiv(ldiv(X, Y), rdiv(Y, X)) = K(X, rdiv(Y, X)).
Proof:
  ldiv(ldiv(X, Y), rdiv(Y, X))
= { by axiom 8 (sos) R->L }
  ldiv(ldiv(X, Y), rdiv(op(X, ldiv(X, Y)), X)) (peak)
= { by lemma 62 }
  K(X, ldiv(X, Y))
= { by lemma 79 }
  K(X, rdiv(Y, X))

Lemma 141: ldiv(T(X, rdiv(Y, X)), Y) = T(ldiv(X, Y), X).
Proof:
  ldiv(T(X, rdiv(Y, X)), Y)
= { by lemma 93 R->L }
  ldiv(T(X, ldiv(X, Y)), Y)
= { by lemma 39 R->L }
  T(rdiv(Y, T(X, ldiv(X, Y))), T(X, ldiv(X, Y))) (peak)
= { by lemma 72 }
  T(ldiv(X, Y), T(X, ldiv(X, Y)))
= { by lemma 91 }
  T(ldiv(X, Y), X)

Lemma 142: ldiv(T(X, Y), op(Y, X)) = T(T(Y, X), X).
Proof:
  ldiv(T(X, Y), op(Y, X))
= { by axiom 3 (sos) R->L }
  ldiv(T(X, rdiv(op(Y, X), X)), op(Y, X)) (peak)
= { by lemma 141 }
  T(ldiv(X, op(Y, X)), X)
= { by axiom 5 (sos) R->L }
  T(T(Y, X), X)

Lemma 143: K(T(X, Y), T(Y, X)) = K(X, Y).
Proof:
  K(T(X, Y), T(Y, X))
= { by lemma 138 R->L }
  K(T(X, Y), rdiv(op(Y, X), T(X, Y)))
= { by lemma 140 R->L }
  ldiv(ldiv(T(X, Y), op(Y, X)), rdiv(op(Y, X), T(X, Y))) (peak)
= { by lemma 142 }
  ldiv(T(T(Y, X), X), rdiv(op(Y, X), T(X, Y)))
= { by lemma 138 }
  ldiv(T(T(Y, X), X), T(Y, X))
= { by lemma 70 }
  K(X, T(Y, X))
= { by lemma 69 }
  K(X, Y)

Lemma 144: K(T(T(X, Y), Z), T(Y, W)) = rdiv(T(X, Y), X).
Proof:
  K(T(T(X, Y), Z), T(Y, W))
= { by lemma 69 R->L }
  K(T(T(X, Y), Z), T(T(Y, W), T(T(X, Y), Z))) (peak)
= { by lemma 91 }
  K(T(T(X, Y), Z), T(T(Y, W), T(X, Y)))
= { by lemma 95 }
  K(T(X, Y), T(T(Y, W), T(X, Y)))
= { by lemma 91 R->L }
  K(T(X, T(Y, W)), T(T(Y, W), T(X, Y))) (peak)
= { by lemma 91 }
  K(T(X, T(Y, W)), T(T(Y, W), X))
= { by lemma 143 }
  K(X, T(Y, W))
= { by lemma 92 }
  rdiv(T(X, Y), X)

Lemma 145: rdiv(T(X, Y), K(X, Y)) = X.
Proof:
  rdiv(T(X, Y), K(X, Y))
= { by lemma 30 R->L }
  rdiv(op(X, K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  X

Lemma 146: rdiv(T(X, Y), rdiv(T(X, Y), X)) = X.
Proof:
  rdiv(T(X, Y), rdiv(T(X, Y), X)) (peak)
= { by lemma 60 }
  rdiv(T(X, Y), K(X, Y))
= { by lemma 145 }
  X

Lemma 147: rdiv(op(X, Y), T(X, T(T(Y, Z), W))) = Y.
Proof:
  rdiv(op(X, Y), T(X, T(T(Y, Z), W))) (peak)
= { by lemma 91 }
  rdiv(op(X, Y), T(X, T(Y, Z)))
= { by lemma 139 R->L }
  rdiv(op(X, Y), rdiv(op(X, Y), T(Y, X)))
= { by lemma 107 R->L }
  op(T(Y, X), K(rdiv(op(X, Y), T(Y, X)), T(Y, X)))
= { by lemma 53 }
  rdiv(T(Y, X), K(T(Y, X), rdiv(op(X, Y), T(Y, X))))
= { by lemma 95 R->L }
  rdiv(T(Y, X), K(T(T(Y, X), V), rdiv(op(X, Y), T(Y, X)))) (peak)
= { by lemma 139 }
  rdiv(T(Y, X), K(T(T(Y, X), V), T(X, T(Y, U)))) (peak)
= { by lemma 144 }
  rdiv(T(Y, X), rdiv(T(Y, X), Y))
= { by lemma 146 }
  Y

Lemma 148: T(X, T(T(Y, Z), W)) = T(X, Y).
Proof:
  T(X, T(T(Y, Z), W)) (peak)
= { by lemma 91 }
  T(X, T(Y, Z))
= { by lemma 135 R->L }
  T(X, ldiv(T(Z, T(T(Y, V), U)), op(Z, Y))) (peak)
= { by lemma 109 }
  T(X, rdiv(op(Z, Y), T(Z, T(T(Y, V), U))))
= { by lemma 147 }
  T(X, Y)

Lemma 149: K(X, T(T(Y, Z), W)) = K(X, Y).
Proof:
  K(X, T(T(Y, Z), W))
= { by lemma 57 R->L }
  ldiv(X, T(X, T(T(Y, Z), W))) (peak)
= { by lemma 148 }
  ldiv(X, T(X, Y))
= { by lemma 57 }
  K(X, Y)

Lemma 150: rdiv(T(X, Z), T(T(X, Z), Y)) = rdiv(X, T(X, Y)).
Proof:
  rdiv(T(X, Z), T(T(X, Z), Y)) (peak)
= { by lemma 81 R->L }
  K(Y, T(T(X, Z), Y)) (peak)
= { by lemma 149 }
  K(Y, X)
= { by lemma 78 R->L }
  rdiv(X, T(X, Y)) (peak)

Lemma 151: op(rdiv(T(X, Y), X), Z) = rdiv(Z, rdiv(X, T(X, Y))).
Proof:
  op(rdiv(T(X, Y), X), Z)
= { by lemma 61 R->L }
  op(ldiv(X, T(X, Y)), Z) (peak)
= { by lemma 57 }
  op(K(X, Y), Z)
= { by lemma 52 }
  rdiv(Z, K(Y, X))
= { by lemma 78 R->L }
  rdiv(Z, rdiv(X, T(X, Y)))

Lemma 152: op(X, rdiv(T(Y, Z), Y)) = rdiv(X, rdiv(Y, T(Y, Z))).
Proof:
  op(X, rdiv(T(Y, Z), Y)) (peak)
= { by lemma 92 R->L }
  op(X, K(Y, T(Z, W))) (peak)
= { by lemma 25 R->L }
  op(K(Y, T(Z, W)), X) (peak)
= { by lemma 92 }
  op(rdiv(T(Y, Z), Y), X) (peak)
= { by lemma 151 }
  rdiv(X, rdiv(Y, T(Y, Z)))

Lemma 153: ldiv(X, op(ldiv(Y, X), Y)) = K(ldiv(Y, X), Y).
Proof:
  ldiv(X, op(ldiv(Y, X), Y))
= { by axiom 8 (sos) R->L }
  ldiv(op(Y, ldiv(Y, X)), op(ldiv(Y, X), Y)) (peak)
= { by lemma 64 }
  K(ldiv(Y, X), Y)

Lemma 154: K(rdiv(op(X, T(Y, X)), Y), Y) = rdiv(Y, T(Y, X)).
Proof:
  K(rdiv(op(X, T(Y, X)), Y), Y)
= { by lemma 94 R->L }
  K(ldiv(Y, op(X, T(Y, X))), Y)
= { by lemma 153 R->L }
  ldiv(op(X, T(Y, X)), op(ldiv(Y, op(X, T(Y, X))), Y)) (peak)
= { by lemma 122 }
  ldiv(op(X, T(Y, X)), op(X, Y))
= { by lemma 96 }
  L(ldiv(T(Y, X), Y), T(Y, X), X)
= { by lemma 74 }
  L(rdiv(Y, T(Y, X)), T(Y, X), X)
= { by lemma 77 }
  K(X, Y)
= { by lemma 78 R->L }
  rdiv(Y, T(Y, X))

Lemma 155: op(X, rdiv(Y, rdiv(Z, T(Z, W)))) = rdiv(op(X, Y), rdiv(Z, T(Z, W))).
Proof:
  op(X, rdiv(Y, rdiv(Z, T(Z, W))))
= { by lemma 152 R->L }
  op(X, op(Y, rdiv(T(Z, W), Z)))
= { by lemma 124 R->L }
  op(X, op(Y, K(Z, rdiv(op(W, T(Z, W)), Z)))) (peak)
= { by lemma 27 R->L }
  op(K(Z, rdiv(op(W, T(Z, W)), Z)), op(X, Y)) (peak)
= { by lemma 52 }
  rdiv(op(X, Y), K(rdiv(op(W, T(Z, W)), Z), Z))
= { by lemma 154 }
  rdiv(op(X, Y), rdiv(Z, T(Z, W)))

Lemma 156: op(X, rdiv(Y, K(Y, X))) = op(T(X, Y), Y).
Proof:
  op(X, rdiv(Y, K(Y, X)))
= { by lemma 69 R->L }
  op(X, rdiv(Y, K(Y, T(X, Y))))
= { by lemma 53 R->L }
  op(X, op(Y, K(T(X, Y), Y)))
= { by lemma 98 R->L }
  op(op(X, Y), K(T(X, Y), Y))
= { by lemma 54 R->L }
  op(op(Y, T(X, Y)), K(T(X, Y), Y)) (peak)
= { by axiom 15 (sos) R->L }
  op(T(X, Y), Y)

Lemma 157: K(X, rdiv(Y, K(Y, X))) = K(X, Y).
Proof:
  K(X, rdiv(Y, K(Y, X)))
= { by lemma 52 R->L }
  K(X, op(K(X, Y), Y)) (peak)
= { by lemma 56 }
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 65 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 67 }
  K(X, Y)

Lemma 158: op(T(X, Y), T(Y, X)) = op(X, Y).
Proof:
  op(T(X, Y), T(Y, X))
= { by lemma 138 R->L }
  op(rdiv(op(X, Y), T(Y, X)), T(Y, X)) (peak)
= { by axiom 9 (sos) }
  op(X, Y)

Lemma 159: op(rdiv(X, K(X, Y)), Y) = op(Y, X).
Proof:
  op(rdiv(X, K(X, Y)), Y)
= { by axiom 15 (sos) }
  op(op(Y, rdiv(X, K(X, Y))), K(rdiv(X, K(X, Y)), Y)) (peak)
= { by lemma 156 }
  op(op(T(Y, X), X), K(rdiv(X, K(X, Y)), Y))
= { by lemma 98 }
  op(T(Y, X), op(X, K(rdiv(X, K(X, Y)), Y)))
= { by lemma 53 }
  op(T(Y, X), rdiv(X, K(Y, rdiv(X, K(X, Y)))))
= { by lemma 157 }
  op(T(Y, X), rdiv(X, K(Y, X)))
= { by lemma 75 }
  op(T(Y, X), T(X, Y))
= { by lemma 158 }
  op(Y, X)

Lemma 160: op(X, rdiv(Y, K(Z, W))) = rdiv(op(X, Y), K(Z, W)).
Proof:
  op(X, rdiv(Y, K(Z, W)))
= { by lemma 53 R->L }
  op(X, op(Y, K(W, Z)))
= { by lemma 43 R->L }
  op(op(K(W, Z), X), Y)
= { by lemma 159 R->L }
  op(op(rdiv(X, K(X, K(W, Z))), K(W, Z)), Y) (peak)
= { by lemma 26 }
  op(K(W, Z), op(rdiv(X, K(X, K(W, Z))), Y))
= { by lemma 52 }
  rdiv(op(rdiv(X, K(X, K(W, Z))), Y), K(Z, W))
= { by axiom 6 (sos) }
  rdiv(op(rdiv(X, 1), Y), K(Z, W))
= { by lemma 22 }
  rdiv(op(rdiv(X, zero), Y), K(Z, W))
= { by lemma 23 }
  rdiv(op(X, Y), K(Z, W))

Lemma 161: K(X, rdiv(Y, T(Y, Z))) = zero.
Proof:
  K(X, rdiv(Y, T(Y, Z)))
= { by lemma 74 R->L }
  K(X, ldiv(T(Y, Z), Y)) (peak)
= { by lemma 63 R->L }
  K(X, K(Z, T(Y, Z))) (peak)
= { by axiom 6 (sos) }
  1
= { by lemma 22 }
  zero

Lemma 162: rdiv(op(X, Y), rdiv(Y, T(Y, Z))) = op(X, T(Y, Z)).
Proof:
  rdiv(op(X, Y), rdiv(Y, T(Y, Z)))
= { by lemma 155 R->L }
  op(X, rdiv(Y, rdiv(Y, T(Y, Z))))
= { by lemma 107 R->L }
  op(X, op(T(Y, Z), K(rdiv(Y, T(Y, Z)), T(Y, Z))))
= { by lemma 53 }
  op(X, rdiv(T(Y, Z), K(T(Y, Z), rdiv(Y, T(Y, Z)))))
= { by lemma 160 }
  rdiv(op(X, T(Y, Z)), K(T(Y, Z), rdiv(Y, T(Y, Z))))
= { by lemma 95 R->L }
  rdiv(op(X, T(Y, Z)), K(T(T(Y, Z), W), rdiv(Y, T(Y, Z)))) (peak)
= { by lemma 161 }
  rdiv(op(X, T(Y, Z)), zero)
= { by lemma 23 }
  op(X, T(Y, Z))

Lemma 163: op(rdiv(X, Y), T(Y, Z)) = rdiv(X, rdiv(Y, T(Y, Z))).
Proof:
  op(rdiv(X, Y), T(Y, Z))
= { by lemma 162 R->L }
  rdiv(op(rdiv(X, Y), Y), rdiv(Y, T(Y, Z))) (peak)
= { by axiom 9 (sos) }
  rdiv(X, rdiv(Y, T(Y, Z)))

Lemma 164: T(X, T(T(Y, V), U)) = T(X, T(T(Y, Z), W)).
Proof:
  T(X, T(T(Y, V), U)) (peak)
= { by lemma 148 }
  T(X, Y)
= { by lemma 147 R->L }
  T(X, rdiv(op(Z, Y), T(Z, T(T(Y, T), S))))
= { by lemma 109 R->L }
  T(X, ldiv(T(Z, T(T(Y, T), S)), op(Z, Y))) (peak)
= { by lemma 135 }
  T(X, T(Y, Z))
= { by lemma 91 R->L }
  T(X, T(T(Y, Z), W)) (peak)

Lemma 165: K(T(T(X, V), U), W) = K(T(T(X, Y), Z), W).
Proof:
  K(T(T(X, V), U), W)
= { by lemma 78 R->L }
  rdiv(W, T(W, T(T(X, V), U)))
= { by lemma 74 R->L }
  ldiv(T(W, T(T(X, V), U)), W) (peak)
= { by lemma 164 }
  ldiv(T(W, T(T(X, Y), Z)), W) (peak)
= { by lemma 70 }
  K(T(T(X, Y), Z), W)

Lemma 166: rdiv(T(T(X, Z), Y), T(X, Z)) = rdiv(T(X, Y), X).
Proof:
  rdiv(T(T(X, Z), Y), T(X, Z))
= { by lemma 61 R->L }
  ldiv(T(X, Z), T(T(X, Z), Y))
= { by lemma 91 R->L }
  ldiv(T(X, Z), T(T(X, Z), T(Y, V))) (peak)
= { by lemma 57 }
  K(T(X, Z), T(Y, V))
= { by lemma 95 R->L }
  K(T(T(X, Z), U), T(Y, V)) (peak)
= { by lemma 165 R->L }
  K(T(T(X, Y), W), T(Y, V)) (peak)
= { by lemma 144 }
  rdiv(T(X, Y), X) (peak)

Lemma 167: T(T(X, Z), Y) = T(T(X, Y), Z).
Proof:
  T(T(X, Z), Y)
= { by lemma 111 R->L }
  rdiv(T(X, Z), rdiv(T(X, Z), T(T(X, Z), Y))) (peak)
= { by lemma 150 }
  rdiv(T(X, Z), rdiv(X, T(X, Y)))
= { by lemma 163 R->L }
  op(rdiv(T(X, Z), X), T(X, Y))
= { by lemma 166 R->L }
  op(rdiv(T(T(X, Y), Z), T(X, Y)), T(X, Y)) (peak)
= { by lemma 151 }
  rdiv(T(X, Y), rdiv(T(X, Y), T(T(X, Y), Z)))
= { by lemma 111 }
  T(T(X, Y), Z)

Goal 1 (goals): T(T(x0, x1), x2) = T(T(x0, x2), x1).
Proof:
  T(T(x0, x1), x2)
= { by lemma 167 }
  T(T(x0, x2), x1) (peak)

RESULT: Theorem (the conjecture is true).
