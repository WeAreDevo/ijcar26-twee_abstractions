Proof:
  ldiv(T(X, Y), X) (peak)
= { by lemma 64 R->L }
  K(Y, T(X, Y)) (peak)
= { by lemma 70 }
  K(Y, X)

Lemma 72: rdiv(X, ldiv(Y, X)) = Y.
Proof:
  rdiv(X, ldiv(Y, X))
= { by axiom 8 (sos) R->L }
  rdiv(op(Y, ldiv(Y, X)), ldiv(Y, X)) (peak)
= { by axiom 3 (sos) }
  Y

Lemma 73: rdiv(X, K(Y, X)) = T(X, Y).
Proof:
  rdiv(X, K(Y, X))
= { by lemma 71 R->L }
  rdiv(X, ldiv(T(X, Y), X)) (peak)
= { by lemma 72 }
  T(X, Y)

Lemma 74: K(X, ldiv(X, Y)) = K(X, rdiv(Y, X)).
Proof:
  K(X, ldiv(X, Y))
= { by lemma 69 R->L }
  K(X, rdiv(op(X, ldiv(X, Y)), X)) (peak)
= { by axiom 8 (sos) }
  K(X, rdiv(Y, X))

Lemma 75: ldiv(op(Z, X), op(Z, Y)) = L(ldiv(X, Y), X, Z).
Proof:
  ldiv(op(Z, X), op(Z, Y))
= { by axiom 8 (sos) R->L }
  ldiv(op(Z, X), op(Z, op(X, ldiv(X, Y)))) (peak)
= { by axiom 19 (sos) R->L }
  L(ldiv(X, Y), X, Z)

Lemma 76: ldiv(op(X, Y), op(X, op(Z, Y))) = L(T(Z, Y), Y, X).
Proof:
  ldiv(op(X, Y), op(X, op(Z, Y))) (peak)
= { by lemma 75 }
  L(ldiv(Y, op(Z, Y)), Y, X) (peak)
= { by axiom 5 (sos) R->L }
  L(T(Z, Y), Y, X)

Lemma 77: op(op(X, Y), K(Z, W)) = op(X, op(Y, K(Z, W))).
Proof:
  op(op(X, Y), K(Z, W)) (peak)
= { by lemma 29 R->L }
  op(K(Z, W), op(X, Y)) (peak)
= { by lemma 31 }
  op(X, op(Y, K(Z, W))) (peak)

Lemma 78: L(T(X, Y), Y, K(Z, W)) = T(X, rdiv(Y, K(W, Z))).
Proof:
  L(T(X, Y), Y, K(Z, W))
= { by lemma 76 R->L }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(X, Y))) (peak)
= { by lemma 29 }
  ldiv(op(K(Z, W), Y), op(op(X, Y), K(Z, W))) (peak)
= { by lemma 56 }
  ldiv(rdiv(Y, K(W, Z)), op(op(X, Y), K(Z, W)))
= { by lemma 77 }
  ldiv(rdiv(Y, K(W, Z)), op(X, op(Y, K(Z, W))))
= { by lemma 57 }
  ldiv(rdiv(Y, K(W, Z)), op(X, rdiv(Y, K(W, Z))))
= { by axiom 5 (sos) R->L }
  T(X, rdiv(Y, K(W, Z)))

Lemma 79: R(X, K(Y, Z), W) = X.
Proof:
  R(X, K(Y, Z), W)
= { by axiom 3 (sos) R->L }
  R(X, K(Y, Z), rdiv(op(W, K(Y, Z)), K(Y, Z))) (peak)
= { by lemma 48 }
  X

Lemma 80: ldiv(R(X, Y, Z), op(op(X, Y), Z)) = op(Y, Z).
Proof:
  ldiv(R(X, Y, Z), op(op(X, Y), Z))
= { by axiom 18 (sos) }
  ldiv(rdiv(op(op(X, Y), Z), op(Y, Z)), op(op(X, Y), Z)) (peak)
= { by lemma 39 }
  op(Y, Z)

Lemma 81: ldiv(op(X, Y), op(op(Y, X), Z)) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(op(X, Y), op(op(Y, X), Z))
= { by lemma 79 R->L }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(Y, X), Z))
= { by axiom 17 (sos) }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(op(X, Y), K(Y, X)), Z)) (peak)
= { by lemma 80 }
  op(K(Y, X), Z)
= { by lemma 56 }
  rdiv(Z, K(X, Y))

Lemma 82: L(X, Y, K(Z, W)) = X.
Proof:
  L(X, Y, K(Z, W))
= { by axiom 19 (sos) }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(Y, X)))
= { by lemma 30 R->L }
  ldiv(op(K(Z, W), Y), op(op(Y, K(Z, W)), X)) (peak)
= { by lemma 81 }
  rdiv(X, K(K(Z, W), Y))
= { by axiom 7 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 83: T(X, rdiv(Y, K(Z, W))) = T(X, Y).
Proof:
  T(X, rdiv(Y, K(Z, W)))
= { by lemma 78 R->L }
  L(T(X, Y), Y, K(W, Z)) (peak)
= { by lemma 82 }
  T(X, Y)

Lemma 84: rdiv(T(X, Y), K(X, Y)) = X.
Proof:
  rdiv(T(X, Y), K(X, Y))
= { by lemma 34 R->L }
  rdiv(op(X, K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  X

Lemma 85: T(X, T(Y, Z)) = T(X, Y).
Proof:
  T(X, T(Y, Z))
= { by lemma 83 R->L }
  T(X, rdiv(T(Y, Z), K(Y, Z))) (peak)
= { by lemma 84 }
  T(X, Y)

Lemma 86: K(X, T(Y, Z)) = K(X, Y).
Proof:
  K(X, T(Y, Z))
= { by lemma 61 R->L }
  ldiv(X, T(X, T(Y, Z))) (peak)
= { by lemma 85 }
  ldiv(X, T(X, Y))
= { by lemma 61 }
  K(X, Y)

Lemma 87: K(T(X, Y), Z) = K(X, Z).
Proof:
  K(T(X, Y), Z)
= { by lemma 70 R->L }
  K(T(X, Y), T(Z, T(X, Y))) (peak)
= { by lemma 64 }
  ldiv(T(Z, T(X, Y)), Z) (peak)
= { by lemma 85 }
  ldiv(T(Z, X), Z)
= { by lemma 71 }
  K(X, Z)

Lemma 88: K(ldiv(X, Y), Z) = K(rdiv(Y, X), Z).
Proof:
  K(ldiv(X, Y), Z)
= { by lemma 43 R->L }
  K(T(rdiv(Y, X), X), Z) (peak)
= { by lemma 87 }
  K(rdiv(Y, X), Z)

Lemma 89: op(X, rdiv(Y, K(Y, X))) = op(T(X, Y), Y).
Proof:
  op(X, rdiv(Y, K(Y, X)))
= { by lemma 70 R->L }
  op(X, rdiv(Y, K(Y, T(X, Y))))
= { by lemma 57 R->L }
  op(X, op(Y, K(T(X, Y), Y)))
= { by lemma 77 R->L }
  op(op(X, Y), K(T(X, Y), Y))
= { by lemma 58 R->L }
  op(op(Y, T(X, Y)), K(T(X, Y), Y)) (peak)
= { by axiom 17 (sos) R->L }
  op(T(X, Y), Y)

Lemma 90: rdiv(op(op(X, rdiv(Y, Z)), Z), Y) = R(X, rdiv(Y, Z), Z).
Proof:
  rdiv(op(op(X, rdiv(Y, Z)), Z), Y)
= { by axiom 9 (sos) R->L }
  rdiv(op(op(X, rdiv(Y, Z)), Z), op(rdiv(Y, Z), Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(X, rdiv(Y, Z), Z)

Lemma 91: R(X, Y, K(Z, W)) = X.
Proof:
  R(X, Y, K(Z, W))
= { by axiom 18 (sos) }
  rdiv(op(op(X, Y), K(Z, W)), op(Y, K(Z, W))) (peak)
= { by lemma 77 }
  rdiv(op(X, op(Y, K(Z, W))), op(Y, K(Z, W)))
= { by axiom 3 (sos) }
  X

Lemma 92: rdiv(op(T(X, Y), T(Y, X)), Y) = X.
Proof:
  rdiv(op(T(X, Y), T(Y, X)), Y)
= { by lemma 34 R->L }
  rdiv(op(T(X, Y), op(Y, K(Y, X))), Y)
= { by lemma 77 R->L }
  rdiv(op(op(T(X, Y), Y), K(Y, X)), Y)
= { by lemma 89 R->L }
  rdiv(op(op(X, rdiv(Y, K(Y, X))), K(Y, X)), Y) (peak)
= { by lemma 90 }
  R(X, rdiv(Y, K(Y, X)), K(Y, X))
= { by lemma 91 }
  X

Lemma 93: op(T(X, Y), T(Y, X)) = op(X, Y).
Proof:
  op(T(X, Y), T(Y, X))
= { by axiom 9 (sos) R->L }
  op(rdiv(op(T(X, Y), T(Y, X)), Y), Y) (peak)
= { by lemma 92 }
  op(X, Y)

Lemma 94: K(X, rdiv(Y, K(Y, X))) = K(X, Y).
Proof:
  K(X, rdiv(Y, K(Y, X)))
= { by lemma 56 R->L }
  K(X, op(K(X, Y), Y)) (peak)
= { by lemma 60 }
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 66 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 68 }
  K(X, Y)

Lemma 95: op(rdiv(X, K(X, Y)), Y) = op(T(Y, X), T(X, Y)).
Proof:
  op(rdiv(X, K(X, Y)), Y)
= { by axiom 17 (sos) }
  op(op(Y, rdiv(X, K(X, Y))), K(rdiv(X, K(X, Y)), Y)) (peak)
= { by lemma 89 }
  op(op(T(Y, X), X), K(rdiv(X, K(X, Y)), Y))
= { by lemma 77 }
  op(T(Y, X), op(X, K(rdiv(X, K(X, Y)), Y)))
= { by lemma 57 }
  op(T(Y, X), rdiv(X, K(Y, rdiv(X, K(X, Y)))))
= { by lemma 94 }
  op(T(Y, X), rdiv(X, K(Y, X)))
= { by lemma 73 }
  op(T(Y, X), T(X, Y))

Lemma 96: op(X, rdiv(Y, K(Z, W))) = rdiv(op(X, Y), K(Z, W)).
Proof:
  op(X, rdiv(Y, K(Z, W)))
= { by lemma 57 R->L }
  op(X, op(Y, K(W, Z)))
= { by lemma 47 R->L }
  op(op(K(W, Z), X), Y)
= { by lemma 93 R->L }
  op(op(T(K(W, Z), X), T(X, K(W, Z))), Y)
= { by lemma 95 R->L }
  op(op(rdiv(X, K(X, K(W, Z))), K(W, Z)), Y) (peak)
= { by lemma 30 }
  op(K(W, Z), op(rdiv(X, K(X, K(W, Z))), Y))
= { by lemma 56 }
  rdiv(op(rdiv(X, K(X, K(W, Z))), Y), K(Z, W))
= { by axiom 6 (sos) }
  rdiv(op(rdiv(X, 1), Y), K(Z, W))
= { by lemma 24 }
  rdiv(op(rdiv(X, zero), Y), K(Z, W))
= { by lemma 27 }
  rdiv(op(X, Y), K(Z, W))

Lemma 97: rdiv(op(op(X, Y), Z), a(X, Y, Z)) = op(X, op(Y, Z)).
Proof:
  rdiv(op(op(X, Y), Z), a(X, Y, Z))
= { by axiom 20 (sos) }
  rdiv(op(op(X, op(Y, Z)), a(X, Y, Z)), a(X, Y, Z)) (peak)
= { by axiom 3 (sos) }
  op(X, op(Y, Z))

Lemma 98: rdiv(op(op(X, Y), Z), K(X, Y)) = op(op(Y, X), Z).
Proof:
  rdiv(op(op(X, Y), Z), K(X, Y))
= { by lemma 96 R->L }
  op(op(X, Y), rdiv(Z, K(X, Y)))
= { by lemma 56 R->L }
  op(op(X, Y), op(K(Y, X), Z))
= { by lemma 97 R->L }
  rdiv(op(op(op(X, Y), K(Y, X)), Z), a(op(X, Y), K(Y, X), Z)) (peak)
= { by axiom 17 (sos) R->L }
  rdiv(op(op(Y, X), Z), a(op(X, Y), K(Y, X), Z))
= { by axiom 12 (sos) }
  rdiv(op(op(Y, X), Z), 1)
= { by lemma 24 }
  rdiv(op(op(Y, X), Z), zero)
= { by lemma 27 }
  op(op(Y, X), Z)

Lemma 99: rdiv(op(X, op(Y, Z)), K(Y, Z)) = op(X, op(Z, Y)).
Proof:
  rdiv(op(X, op(Y, Z)), K(Y, Z))
= { by lemma 56 R->L }
  op(K(Z, Y), op(X, op(Y, Z)))
= { by lemma 30 R->L }
  op(op(X, K(Z, Y)), op(Y, Z))
= { by axiom 20 (sos) }
  op(op(X, op(K(Z, Y), op(Y, Z))), a(X, K(Z, Y), op(Y, Z))) (peak)
= { by lemma 32 }
  op(op(X, op(Z, Y)), a(X, K(Z, Y), op(Y, Z)))
= { by axiom 12 (sos) }
  op(op(X, op(Z, Y)), 1)
= { by lemma 24 }
  op(op(X, op(Z, Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(Z, Y))

Lemma 100: op(op(X, Y), T(Z, op(Y, X))) = op(Z, op(X, Y)).
Proof:
  op(op(X, Y), T(Z, op(Y, X)))
= { by lemma 98 R->L }
  rdiv(op(op(Y, X), T(Z, op(Y, X))), K(Y, X)) (peak)
= { by lemma 58 }
  rdiv(op(Z, op(Y, X)), K(Y, X))
= { by lemma 99 }
  op(Z, op(X, Y))

Lemma 101: T(X, op(Y, Z)) = T(X, op(Z, Y)).
Proof:
  T(X, op(Y, Z))
= { by axiom 4 (sos) R->L }
  ldiv(op(Z, Y), op(op(Z, Y), T(X, op(Y, Z)))) (peak)
= { by lemma 100 }
  ldiv(op(Z, Y), op(X, op(Z, Y)))
= { by axiom 5 (sos) R->L }
  T(X, op(Z, Y))

Lemma 102: T(X, ldiv(Y, Z)) = T(X, rdiv(Z, Y)).
Proof:
  T(X, ldiv(Y, Z))
= { by lemma 43 R->L }
  T(X, T(rdiv(Z, Y), Y)) (peak)
= { by lemma 85 }
  T(X, rdiv(Z, Y))

Lemma 103: op(a(X, Y, Z), W) = op(W, a(X, Y, Z)).
Proof:
  op(a(X, Y, Z), W)
= { by lemma 28 R->L }
  rdiv(op(W, a(X, Y, Z)), K(W, a(X, Y, Z))) (peak)
= { by axiom 10 (sos) }
  rdiv(op(W, a(X, Y, Z)), 1)
= { by lemma 24 }
  rdiv(op(W, a(X, Y, Z)), zero)
= { by lemma 27 }
  op(W, a(X, Y, Z))

Lemma 104: rdiv(op(X, a(Y, Z, W)), X) = a(Y, Z, W).
Proof:
  rdiv(op(X, a(Y, Z, W)), X) (peak)
= { by lemma 103 R->L }
  rdiv(op(a(Y, Z, W), X), X) (peak)
= { by axiom 3 (sos) }
  a(Y, Z, W)

Lemma 105: op(op(X, Y), a(Z, W, V)) = op(X, op(Y, a(Z, W, V))).
Proof:
  op(op(X, Y), a(Z, W, V))
= { by axiom 20 (sos) }
  op(op(X, op(Y, a(Z, W, V))), a(X, Y, a(Z, W, V))) (peak)
= { by lemma 103 R->L }
  op(op(X, op(a(Z, W, V), Y)), a(X, Y, a(Z, W, V))) (peak)
= { by axiom 14 (sos) }
  op(op(X, op(a(Z, W, V), Y)), 1)
= { by lemma 24 }
  op(op(X, op(a(Z, W, V), Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(a(Z, W, V), Y))
= { by lemma 103 }
  op(X, op(Y, a(Z, W, V)))

Lemma 106: R(X, Y, a(Z, W, V)) = X.
Proof:
  R(X, Y, a(Z, W, V))
= { by axiom 18 (sos) }
  rdiv(op(op(X, Y), a(Z, W, V)), op(Y, a(Z, W, V))) (peak)
= { by lemma 105 }
  rdiv(op(X, op(Y, a(Z, W, V))), op(Y, a(Z, W, V)))
= { by axiom 3 (sos) }
  X

Lemma 107: op(X, op(Y, a(Z, X, Y))) = ldiv(Z, op(op(Z, X), Y)).
Proof:
  op(X, op(Y, a(Z, X, Y)))
= { by lemma 105 R->L }
  op(op(X, Y), a(Z, X, Y))
= { by lemma 80 R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, op(X, Y)), a(Z, X, Y))) (peak)
= { by axiom 20 (sos) R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, X), Y))
= { by lemma 106 }
  ldiv(Z, op(op(Z, X), Y))

Lemma 108: ldiv(Z, ldiv(Y, op(op(Y, Z), X))) = op(X, a(Y, Z, X)).
Proof:
  ldiv(Z, ldiv(Y, op(op(Y, Z), X))) (peak)
= { by lemma 107 R->L }
  ldiv(Z, op(Z, op(X, a(Y, Z, X)))) (peak)
= { by axiom 4 (sos) }
  op(X, a(Y, Z, X))

Lemma 109: op(op(X, Y), L(Z, Y, X)) = op(X, op(Y, Z)).
Proof:
  op(op(X, Y), L(Z, Y, X))
= { by axiom 19 (sos) }
  op(op(X, Y), ldiv(op(X, Y), op(X, op(Y, Z)))) (peak)
= { by axiom 8 (sos) }
  op(X, op(Y, Z))

Lemma 110: op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))) = X.
Proof:
  op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))) (peak)
= { by lemma 108 R->L }
  ldiv(Y, ldiv(Z, op(op(Z, Y), L(X, Y, Z))))
= { by lemma 109 }
  ldiv(Y, ldiv(Z, op(Z, op(Y, X))))
= { by axiom 4 (sos) }
  ldiv(Y, op(Y, X))
= { by axiom 4 (sos) }
  X

Lemma 111: a(X, Y, L(Z, Y, X)) = rdiv(Z, L(Z, Y, X)).
Proof:
  a(X, Y, L(Z, Y, X))
= { by lemma 104 R->L }
  rdiv(op(L(Z, Y, X), a(X, Y, L(Z, Y, X))), L(Z, Y, X)) (peak)
= { by lemma 110 }
  rdiv(Z, L(Z, Y, X))

Lemma 112: op(a(X, Y, Z), rdiv(W, a(X, Y, Z))) = W.
Proof:
  op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))
= { by lemma 41 R->L }
  op(W, K(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 11 (sos) }
  op(W, 1)
= { by lemma 24 }
  op(W, zero)
= { by axiom 1 (sos) }
  W

Lemma 113: ldiv(a(X, Y, Z), W) = rdiv(W, a(X, Y, Z)).
Proof:
  ldiv(a(X, Y, Z), W)
= { by lemma 112 R->L }
  ldiv(a(X, Y, Z), op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 4 (sos) }
  rdiv(W, a(X, Y, Z))

Lemma 114: T(X, a(Y, Z, W)) = X.
Proof:
  T(X, a(Y, Z, W))
= { by axiom 5 (sos) }
  ldiv(a(Y, Z, W), op(X, a(Y, Z, W))) (peak)
= { by lemma 103 R->L }
  ldiv(a(Y, Z, W), op(a(Y, Z, W), X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 115: op(op(X, a(Y, Z, W)), V) = op(op(X, V), a(Y, Z, W)).
Proof:
  op(op(X, a(Y, Z, W)), V) (peak)
= { by lemma 103 R->L }
  op(op(a(Y, Z, W), X), V)
= { by axiom 20 (sos) }
  op(op(a(Y, Z, W), op(X, V)), a(a(Y, Z, W), X, V)) (peak)
= { by lemma 103 }
  op(op(op(X, V), a(Y, Z, W)), a(a(Y, Z, W), X, V)) (peak)
= { by axiom 16 (sos) }
  op(op(op(X, V), a(Y, Z, W)), 1)
= { by lemma 24 }
  op(op(op(X, V), a(Y, Z, W)), zero)
= { by axiom 1 (sos) }
  op(op(X, V), a(Y, Z, W))

Lemma 116: op(op(a(X, Y, Z), W), V) = op(W, op(V, a(X, Y, Z))).
Proof:
  op(op(a(X, Y, Z), W), V) (peak)
= { by lemma 103 }
  op(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 115 }
  op(op(W, V), a(X, Y, Z)) (peak)
= { by lemma 105 }
  op(W, op(V, a(X, Y, Z)))

Lemma 117: L(X, a(Y, Z, W), V) = X.
Proof:
  L(X, a(Y, Z, W), V)
= { by lemma 114 R->L }
  L(T(X, a(Y, Z, W)), a(Y, Z, W), V)
= { by lemma 76 R->L }
  ldiv(op(V, a(Y, Z, W)), op(V, op(X, a(Y, Z, W))))
= { by lemma 116 R->L }
  ldiv(op(V, a(Y, Z, W)), op(op(a(Y, Z, W), V), X)) (peak)
= { by lemma 81 }
  rdiv(X, K(V, a(Y, Z, W)))
= { by axiom 10 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 118: L(ldiv(X, zero), X, Y) = ldiv(op(Y, X), Y).
Proof:
  L(ldiv(X, zero), X, Y) (peak)
= { by lemma 75 R->L }
  ldiv(op(Y, X), op(Y, zero)) (peak)
= { by axiom 1 (sos) }
  ldiv(op(Y, X), Y)

Lemma 119: rdiv(zero, rdiv(X, L(X, Y, Z))) = ldiv(X, L(X, Y, Z)).
Proof:
  rdiv(zero, rdiv(X, L(X, Y, Z))) (peak)
= { by lemma 111 R->L }
  rdiv(zero, a(Z, Y, L(X, Y, Z)))
= { by lemma 113 R->L }
  ldiv(a(Z, Y, L(X, Y, Z)), zero)
= { by lemma 117 R->L }
  L(ldiv(a(Z, Y, L(X, Y, Z)), zero), a(Z, Y, L(X, Y, Z)), L(X, Y, Z)) (peak)
= { by lemma 118 }
  ldiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), L(X, Y, Z))
= { by lemma 110 }
  ldiv(X, L(X, Y, Z))

Lemma 120: ldiv(X, op(rdiv(X, Y), op(Y, Z))) = L(Z, Y, rdiv(X, Y)).
Proof:
  ldiv(X, op(rdiv(X, Y), op(Y, Z)))
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(X, Y), Y), op(rdiv(X, Y), op(Y, Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, Y, rdiv(X, Y))

Lemma 121: L(X, rdiv(Y, X), rdiv(Z, rdiv(Y, X))) = ldiv(Z, op(rdiv(Z, rdiv(Y, X)), Y)).
Proof:
  L(X, rdiv(Y, X), rdiv(Z, rdiv(Y, X)))
= { by lemma 120 R->L }
  ldiv(Z, op(rdiv(Z, rdiv(Y, X)), op(rdiv(Y, X), X))) (peak)
= { by axiom 9 (sos) }
  ldiv(Z, op(rdiv(Z, rdiv(Y, X)), Y))

Lemma 122: ldiv(X, rdiv(op(X, Y), K(Z, W))) = rdiv(Y, K(Z, W)).
Proof:
  ldiv(X, rdiv(op(X, Y), K(Z, W)))
= { by lemma 56 R->L }
  ldiv(X, op(K(W, Z), op(X, Y)))
= { by lemma 91 R->L }
  ldiv(R(X, Y, K(W, Z)), op(K(W, Z), op(X, Y))) (peak)
= { by lemma 29 }
  ldiv(R(X, Y, K(W, Z)), op(op(X, Y), K(W, Z))) (peak)
= { by lemma 80 }
  op(Y, K(W, Z))
= { by lemma 57 }
  rdiv(Y, K(Z, W))

Lemma 123: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, ldiv(Y, X), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by axiom 8 (sos) R->L }
  ldiv(op(Y, ldiv(Y, X)), op(Y, op(ldiv(Y, X), Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, ldiv(Y, X), Y)

Lemma 124: L(ldiv(X, ldiv(Y, Z)), X, Y) = ldiv(op(Y, X), Z).
Proof:
  L(ldiv(X, ldiv(Y, Z)), X, Y) (peak)
= { by lemma 75 R->L }
  ldiv(op(Y, X), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 8 (sos) }
  ldiv(op(Y, X), Z)

Lemma 125: ldiv(rdiv(X, K(Y, Z)), W) = ldiv(X, rdiv(W, K(Z, Y))).
Proof:
  ldiv(rdiv(X, K(Y, Z)), W)
= { by lemma 56 R->L }
  ldiv(op(K(Z, Y), X), W)
= { by lemma 124 R->L }
  L(ldiv(X, ldiv(K(Z, Y), W)), X, K(Z, Y)) (peak)
= { by lemma 82 }
  ldiv(X, ldiv(K(Z, Y), W))
= { by lemma 45 }
  ldiv(X, rdiv(W, K(Z, Y)))

Lemma 126: ldiv(X, rdiv(Y, K(Z, W))) = rdiv(ldiv(X, Y), K(Z, W)).
Proof:
  ldiv(X, rdiv(Y, K(Z, W)))
= { by axiom 8 (sos) R->L }
  ldiv(X, rdiv(op(X, ldiv(X, Y)), K(Z, W))) (peak)
= { by lemma 122 }
  rdiv(ldiv(X, Y), K(Z, W))

Lemma 127: op(rdiv(X, K(Y, Z)), W) = rdiv(op(X, W), K(Y, Z)).
Proof:
  op(rdiv(X, K(Y, Z)), W)
= { by lemma 57 R->L }
  op(op(X, K(Z, Y)), W) (peak)
= { by lemma 29 R->L }
  op(op(K(Z, Y), X), W) (peak)
= { by lemma 47 }
  op(X, op(W, K(Z, Y)))
= { by lemma 57 }
  op(X, rdiv(W, K(Y, Z)))
= { by lemma 96 }
  rdiv(op(X, W), K(Y, Z))

Lemma 128: R(rdiv(rdiv(X, Y), Z), Z, Y) = rdiv(X, op(Z, Y)).
Proof:
  R(rdiv(rdiv(X, Y), Z), Z, Y) (peak)
= { by lemma 37 R->L }
  rdiv(op(rdiv(X, Y), Y), op(Z, Y)) (peak)
= { by axiom 9 (sos) }
  rdiv(X, op(Z, Y))

Lemma 129: rdiv(rdiv(X, Y), K(Z, W)) = rdiv(X, rdiv(Y, K(W, Z))).
Proof:
  rdiv(rdiv(X, Y), K(Z, W))
= { by lemma 79 R->L }
  R(rdiv(rdiv(X, Y), K(Z, W)), K(Z, W), Y) (peak)
= { by lemma 128 }
  rdiv(X, op(K(Z, W), Y))
= { by lemma 56 }
  rdiv(X, rdiv(Y, K(W, Z)))

Lemma 130: L(X, rdiv(Y, K(Z, W)), V) = L(X, Y, V).
Proof:
  L(X, rdiv(Y, K(Z, W)), V)
= { by lemma 122 R->L }
  L(X, ldiv(V, rdiv(op(V, Y), K(Z, W))), V)
= { by lemma 123 R->L }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(ldiv(V, rdiv(op(V, Y), K(Z, W))), X))) (peak)
= { by lemma 122 }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(rdiv(Y, K(Z, W)), X)))
= { by lemma 125 }
  ldiv(op(V, Y), rdiv(op(V, op(rdiv(Y, K(Z, W)), X)), K(W, Z)))
= { by lemma 126 }
  rdiv(ldiv(op(V, Y), op(V, op(rdiv(Y, K(Z, W)), X))), K(W, Z))
= { by lemma 127 }
  rdiv(ldiv(op(V, Y), op(V, rdiv(op(Y, X), K(Z, W)))), K(W, Z))
= { by lemma 96 }
  rdiv(ldiv(op(V, Y), rdiv(op(V, op(Y, X)), K(Z, W))), K(W, Z))
= { by lemma 126 }
  rdiv(rdiv(ldiv(op(V, Y), op(V, op(Y, X))), K(Z, W)), K(W, Z))
= { by lemma 129 }
  rdiv(ldiv(op(V, Y), op(V, op(Y, X))), rdiv(K(Z, W), K(Z, W)))
= { by axiom 19 (sos) R->L }
  rdiv(L(X, Y, V), rdiv(K(Z, W), K(Z, W)))
= { by lemma 26 }
  rdiv(L(X, Y, V), zero)
= { by lemma 27 }
  L(X, Y, V)

Lemma 131: L(X, op(Y, Z), W) = L(X, op(Z, Y), W).
Proof:
  L(X, op(Y, Z), W)
= { by lemma 130 R->L }
  L(X, rdiv(op(Y, Z), K(Y, Z)), W) (peak)
= { by lemma 28 }
  L(X, op(Z, Y), W)

Lemma 132: op(X, K(rdiv(Y, X), X)) = rdiv(Y, rdiv(Y, X)).
Proof:
  op(X, K(rdiv(Y, X), X))
= { by lemma 36 }
  rdiv(op(rdiv(Y, X), X), rdiv(Y, X)) (peak)
= { by axiom 9 (sos) }
  rdiv(Y, rdiv(Y, X))

Lemma 133: op(ldiv(X, Y), K(X, rdiv(Y, X))) = rdiv(Y, X).
Proof:
  op(ldiv(X, Y), K(X, rdiv(Y, X)))
= { by lemma 74 R->L }
  op(ldiv(X, Y), K(X, ldiv(X, Y)))
= { by lemma 72 R->L }
  op(ldiv(X, Y), K(rdiv(Y, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 132 }
  rdiv(Y, rdiv(Y, ldiv(X, Y)))
= { by lemma 72 }
  rdiv(Y, X)

Lemma 134: L(X, ldiv(Y, Z), W) = L(X, rdiv(Z, Y), W).
Proof:
  L(X, ldiv(Y, Z), W)
= { by lemma 130 R->L }
  L(X, rdiv(ldiv(Y, Z), K(rdiv(Z, Y), Y)), W)
= { by lemma 56 R->L }
  L(X, op(K(Y, rdiv(Z, Y)), ldiv(Y, Z)), W) (peak)
= { by lemma 131 R->L }
  L(X, op(ldiv(Y, Z), K(Y, rdiv(Z, Y))), W)
= { by lemma 133 }
  L(X, rdiv(Z, Y), W)

Lemma 135: rdiv(op(Y, Z), op(ldiv(X, Y), Z)) = R(X, ldiv(X, Y), Z).
Proof:
  rdiv(op(Y, Z), op(ldiv(X, Y), Z))
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, ldiv(X, Y)), Z), op(ldiv(X, Y), Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(X, ldiv(X, Y), Z)

Lemma 136: ldiv(R(X, ldiv(X, Y), Z), op(Y, Z)) = op(ldiv(X, Y), Z).
Proof:
  ldiv(R(X, ldiv(X, Y), Z), op(Y, Z)) (peak)
= { by lemma 135 R->L }
  ldiv(rdiv(op(Y, Z), op(ldiv(X, Y), Z)), op(Y, Z)) (peak)
= { by lemma 39 }
  op(ldiv(X, Y), Z)

Lemma 137: rdiv(ldiv(X, op(Y, Z)), K(Y, Z)) = ldiv(X, op(Z, Y)).
Proof:
  rdiv(ldiv(X, op(Y, Z)), K(Y, Z))
= { by lemma 57 R->L }
  op(ldiv(X, op(Y, Z)), K(Z, Y))
= { by lemma 136 R->L }
  ldiv(R(X, ldiv(X, op(Y, Z)), K(Z, Y)), op(op(Y, Z), K(Z, Y))) (peak)
= { by axiom 17 (sos) R->L }
  ldiv(R(X, ldiv(X, op(Y, Z)), K(Z, Y)), op(Z, Y))
= { by lemma 91 }
  ldiv(X, op(Z, Y))

Lemma 138: L(X, rdiv(op(Z, Y), W), V) = L(X, rdiv(op(Y, Z), W), V).
Proof:
  L(X, rdiv(op(Z, Y), W), V)
= { by lemma 134 R->L }
  L(X, ldiv(W, op(Z, Y)), V)
= { by lemma 137 R->L }
  L(X, rdiv(ldiv(W, op(Y, Z)), K(Y, Z)), V) (peak)
= { by lemma 130 }
  L(X, ldiv(W, op(Y, Z)), V)
= { by lemma 134 }
  L(X, rdiv(op(Y, Z), W), V)

Lemma 139: L(X, rdiv(op(Y, Z), Y), W) = L(X, Z, W).
Proof:
  L(X, rdiv(op(Y, Z), Y), W) (peak)
= { by lemma 138 }
  L(X, rdiv(op(Z, Y), Y), W) (peak)
= { by axiom 3 (sos) }
  L(X, Z, W)

Lemma 140: L(X, rdiv(Y, L(Y, Z, W)), V) = X.
Proof:
  L(X, rdiv(Y, L(Y, Z, W)), V)
= { by lemma 110 R->L }
  L(X, rdiv(op(L(Y, Z, W), a(W, Z, L(Y, Z, W))), L(Y, Z, W)), V) (peak)
= { by lemma 139 }
  L(X, a(W, Z, L(Y, Z, W)), V)
= { by lemma 117 }
  X

Lemma 141: op(ldiv(X, L(X, Y, Z)), X) = L(X, Y, Z).
Proof:
  op(ldiv(X, L(X, Y, Z)), X)
= { by lemma 25 R->L }
  ldiv(zero, op(ldiv(X, L(X, Y, Z)), X))
= { by lemma 119 R->L }
  ldiv(zero, op(rdiv(zero, rdiv(X, L(X, Y, Z))), X))
= { by lemma 121 R->L }
  L(L(X, Y, Z), rdiv(X, L(X, Y, Z)), rdiv(zero, rdiv(X, L(X, Y, Z)))) (peak)
= { by lemma 140 }
  L(X, Y, Z)

Lemma 142: ldiv(X, L(X, Y, Z)) = rdiv(L(X, Y, Z), X).
Proof:
  ldiv(X, L(X, Y, Z))
= { by axiom 3 (sos) R->L }
  rdiv(op(ldiv(X, L(X, Y, Z)), X), X) (peak)
= { by lemma 141 }
  rdiv(L(X, Y, Z), X)

Lemma 143: a(X, Y, L(Z, Y, X)) = ldiv(L(Z, Y, X), Z).
Proof:
  a(X, Y, L(Z, Y, X))
= { by axiom 4 (sos) R->L }
  ldiv(L(Z, Y, X), op(L(Z, Y, X), a(X, Y, L(Z, Y, X)))) (peak)
= { by lemma 110 }
  ldiv(L(Z, Y, X), Z)

Lemma 144: rdiv(op(X, Y), T(X, Y)) = Y.
Proof:
  rdiv(op(X, Y), T(X, Y))
= { by axiom 5 (sos) }
  rdiv(op(X, Y), ldiv(Y, op(X, Y))) (peak)
= { by lemma 72 }
  Y

Lemma 145: ldiv(L(X, Y, Z), X) = rdiv(X, L(X, Y, Z)).
Proof:
  ldiv(L(X, Y, Z), X) (peak)
= { by lemma 143 R->L }
  a(Z, Y, L(X, Y, Z))
= { by lemma 144 R->L }
  rdiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), T(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))) (peak)
= { by lemma 110 }
  rdiv(X, T(L(X, Y, Z), a(Z, Y, L(X, Y, Z))))
= { by lemma 114 }
  rdiv(X, L(X, Y, Z))

Lemma 146: ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) = op(Y, Z).
Proof:
  ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) (peak)
= { by lemma 37 R->L }
  ldiv(rdiv(op(X, Z), op(Y, Z)), op(X, Z)) (peak)
= { by lemma 39 }
  op(Y, Z)

Lemma 147: ldiv(rdiv(X, Y), op(X, a(Z, W, V))) = op(Y, a(Z, W, V)).
Proof:
  ldiv(rdiv(X, Y), op(X, a(Z, W, V))) (peak)
= { by lemma 103 R->L }
  ldiv(rdiv(X, Y), op(a(Z, W, V), X))
= { by lemma 106 R->L }
  ldiv(R(rdiv(X, Y), Y, a(Z, W, V)), op(a(Z, W, V), X)) (peak)
= { by lemma 103 }
  ldiv(R(rdiv(X, Y), Y, a(Z, W, V)), op(X, a(Z, W, V))) (peak)
= { by lemma 146 }
  op(Y, a(Z, W, V))

Lemma 148: rdiv(op(X, op(Y, Z)), L(Z, Y, X)) = op(X, Y).
Proof:
  rdiv(op(X, op(Y, Z)), L(Z, Y, X))
= { by lemma 109 R->L }
  rdiv(op(op(X, Y), L(Z, Y, X)), L(Z, Y, X)) (peak)
= { by axiom 3 (sos) }
  op(X, Y)

Lemma 149: op(L(X, V, U), a(Y, Z, W)) = L(op(X, a(Y, Z, W)), V, U).
Proof:
  op(L(X, V, U), a(Y, Z, W))
= { by lemma 147 R->L }
  ldiv(rdiv(op(U, op(V, X)), L(X, V, U)), op(op(U, op(V, X)), a(Y, Z, W))) (peak)
= { by lemma 148 }
  ldiv(op(U, V), op(op(U, op(V, X)), a(Y, Z, W)))
= { by lemma 105 }
  ldiv(op(U, V), op(U, op(op(V, X), a(Y, Z, W))))
= { by lemma 105 }
  ldiv(op(U, V), op(U, op(V, op(X, a(Y, Z, W)))))
= { by axiom 19 (sos) R->L }
  L(op(X, a(Y, Z, W)), V, U)

Lemma 150: op(X, op(Y, a(X, Z, ldiv(Z, Y)))) = op(op(X, Z), ldiv(Z, Y)).
Proof:
  op(X, op(Y, a(X, Z, ldiv(Z, Y))))
= { by lemma 105 R->L }
  op(op(X, Y), a(X, Z, ldiv(Z, Y)))
= { by axiom 8 (sos) R->L }
  op(op(X, op(Z, ldiv(Z, Y))), a(X, Z, ldiv(Z, Y))) (peak)
= { by axiom 20 (sos) R->L }
  op(op(X, Z), ldiv(Z, Y))

Lemma 151: op(X, op(Y, op(Z, a(X, Y, Z)))) = op(op(X, Y), Z).
Proof:
  op(X, op(Y, op(Z, a(X, Y, Z))))
= { by lemma 105 R->L }
  op(X, op(op(Y, Z), a(X, Y, Z)))
= { by axiom 4 (sos) R->L }
  op(X, op(op(Y, Z), a(X, Y, ldiv(Y, op(Y, Z))))) (peak)
= { by lemma 150 }
  op(op(X, Y), ldiv(Y, op(Y, Z)))
= { by axiom 4 (sos) }
  op(op(X, Y), Z)

Lemma 152: L(op(X, a(Y, Z, X)), Z, Y) = X.
Proof:
  L(op(X, a(Y, Z, X)), Z, Y)
= { by axiom 19 (sos) }
  ldiv(op(Y, Z), op(Y, op(Z, op(X, a(Y, Z, X))))) (peak)
= { by lemma 151 }
  ldiv(op(Y, Z), op(op(Y, Z), X))
= { by axiom 4 (sos) }
  X

Lemma 153: op(L(X, Y, Z), a(Z, Y, X)) = X.
Proof:
  op(L(X, Y, Z), a(Z, Y, X)) (peak)
= { by lemma 149 }
  L(op(X, a(Z, Y, X)), Y, Z)
= { by lemma 152 }
  X

Lemma 154: rdiv(Z, L(Z, Y, X)) = a(X, Y, Z).
Proof:
  rdiv(Z, L(Z, Y, X))
= { by lemma 145 R->L }
  ldiv(L(Z, Y, X), Z)
= { by lemma 153 R->L }
  ldiv(L(Z, Y, X), op(L(Z, Y, X), a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 155: op(rdiv(X, op(Y, Z)), op(Z, Y)) = rdiv(X, K(Y, Z)).
Proof:
  op(rdiv(X, op(Y, Z)), op(Z, Y))
= { by lemma 99 R->L }
  rdiv(op(rdiv(X, op(Y, Z)), op(Y, Z)), K(Y, Z)) (peak)
= { by axiom 9 (sos) }
  rdiv(X, K(Y, Z))

Lemma 156: rdiv(op(X, Y), K(Z, Y)) = op(X, T(Y, Z)).
Proof:
  rdiv(op(X, Y), K(Z, Y))
= { by lemma 56 R->L }
  op(K(Y, Z), op(X, Y)) (peak)
= { by lemma 31 }
  op(X, op(Y, K(Y, Z))) (peak)
= { by lemma 34 }
  op(X, T(Y, Z))

Lemma 157: op(R(X, Y, Z), op(Z, Y)) = op(op(X, Y), T(Z, Y)).
Proof:
  op(R(X, Y, Z), op(Z, Y))
= { by axiom 18 (sos) }
  op(rdiv(op(op(X, Y), Z), op(Y, Z)), op(Z, Y)) (peak)
= { by lemma 155 }
  rdiv(op(op(X, Y), Z), K(Y, Z))
= { by lemma 156 }
  op(op(X, Y), T(Z, Y))

Lemma 158: op(R(X, Y, rdiv(Z, Y)), Z) = op(op(X, Y), ldiv(Y, Z)).
Proof:
  op(R(X, Y, rdiv(Z, Y)), Z)
= { by axiom 9 (sos) R->L }
  op(R(X, Y, rdiv(Z, Y)), op(rdiv(Z, Y), Y)) (peak)
= { by lemma 157 }
  op(op(X, Y), T(rdiv(Z, Y), Y))
= { by lemma 43 }
  op(op(X, Y), ldiv(Y, Z))

Lemma 159: rdiv(op(op(X, Y), ldiv(Y, Z)), Z) = R(X, Y, rdiv(Z, Y)).
Proof:
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z)
= { by lemma 158 R->L }
  rdiv(op(R(X, Y, rdiv(Z, Y)), Z), Z) (peak)
= { by axiom 3 (sos) }
  R(X, Y, rdiv(Z, Y))

Lemma 160: R(X, Y, ldiv(Y, Z)) = R(X, Y, rdiv(Z, Y)).
Proof:
  R(X, Y, ldiv(Y, Z))
= { by axiom 3 (sos) R->L }
  R(rdiv(op(X, Y), Y), Y, ldiv(Y, Z)) (peak)
= { by lemma 53 }
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z) (peak)
= { by lemma 159 }
  R(X, Y, rdiv(Z, Y))

Lemma 161: R(X, Y, T(Z, Y)) = R(X, Y, Z).
Proof:
  R(X, Y, T(Z, Y))
= { by axiom 5 (sos) }
  R(X, Y, ldiv(Y, op(Z, Y))) (peak)
= { by lemma 160 }
  R(X, Y, rdiv(op(Z, Y), Y))
= { by axiom 3 (sos) }
  R(X, Y, Z)

Lemma 162: rdiv(op(X, T(Z, Y)), op(Z, Y)) = R(rdiv(X, Y), Y, T(Z, Y)).
Proof:
  rdiv(op(X, T(Z, Y)), op(Z, Y))
= { by lemma 58 R->L }
  rdiv(op(X, T(Z, Y)), op(Y, T(Z, Y))) (peak)
= { by lemma 37 }
  R(rdiv(X, Y), Y, T(Z, Y))

Lemma 163: rdiv(op(X, Y), rdiv(Y, K(Z, W))) = rdiv(X, K(W, Z)).
Proof:
  rdiv(op(X, Y), rdiv(Y, K(Z, W)))
= { by lemma 56 R->L }
  rdiv(op(X, Y), op(K(W, Z), Y))
= { by lemma 44 R->L }
  rdiv(op(X, T(Y, K(W, Z))), op(K(W, Z), Y)) (peak)
= { by lemma 29 }
  rdiv(op(X, T(Y, K(W, Z))), op(Y, K(W, Z))) (peak)
= { by lemma 162 }
  R(rdiv(X, K(W, Z)), K(W, Z), T(Y, K(W, Z))) (peak)
= { by lemma 79 }
  rdiv(X, K(W, Z))

Lemma 164: rdiv(rdiv(X, K(Y, Z)), W) = rdiv(X, rdiv(W, K(Z, Y))).
Proof:
  rdiv(rdiv(X, K(Y, Z)), W)
= { by lemma 91 R->L }
  R(rdiv(rdiv(X, K(Y, Z)), W), W, K(Y, Z)) (peak)
= { by lemma 128 }
  rdiv(X, op(W, K(Y, Z)))
= { by lemma 57 }
  rdiv(X, rdiv(W, K(Z, Y)))

Lemma 165: L(X, Y, rdiv(Z, K(W, V))) = L(X, Y, Z).
Proof:
  L(X, Y, rdiv(Z, K(W, V)))
= { by lemma 163 R->L }
  L(X, Y, rdiv(op(Z, Y), rdiv(Y, K(V, W))))
= { by lemma 130 R->L }
  L(X, rdiv(Y, K(V, W)), rdiv(op(Z, Y), rdiv(Y, K(V, W))))
= { by lemma 120 R->L }
  ldiv(op(Z, Y), op(rdiv(op(Z, Y), rdiv(Y, K(V, W))), op(rdiv(Y, K(V, W)), X))) (peak)
= { by lemma 163 }
  ldiv(op(Z, Y), op(rdiv(Z, K(W, V)), op(rdiv(Y, K(V, W)), X)))
= { by lemma 127 }
  ldiv(op(Z, Y), rdiv(op(Z, op(rdiv(Y, K(V, W)), X)), K(W, V)))
= { by lemma 126 }
  rdiv(ldiv(op(Z, Y), op(Z, op(rdiv(Y, K(V, W)), X))), K(W, V))
= { by lemma 127 }
  rdiv(ldiv(op(Z, Y), op(Z, rdiv(op(Y, X), K(V, W)))), K(W, V))
= { by lemma 96 }
  rdiv(ldiv(op(Z, Y), rdiv(op(Z, op(Y, X)), K(V, W))), K(W, V))
= { by lemma 126 }
  rdiv(rdiv(ldiv(op(Z, Y), op(Z, op(Y, X))), K(V, W)), K(W, V))
= { by lemma 164 }
  rdiv(ldiv(op(Z, Y), op(Z, op(Y, X))), rdiv(K(W, V), K(W, V)))
= { by axiom 19 (sos) R->L }
  rdiv(L(X, Y, Z), rdiv(K(W, V), K(W, V)))
= { by lemma 26 }
  rdiv(L(X, Y, Z), zero)
= { by lemma 27 }
  L(X, Y, Z)

Lemma 166: op(X, K(ldiv(Y, X), Y)) = op(ldiv(Y, X), Y).
Proof:
  op(X, K(ldiv(Y, X), Y))
= { by axiom 8 (sos) R->L }
  op(op(Y, ldiv(Y, X)), K(ldiv(Y, X), Y)) (peak)
= { by axiom 17 (sos) R->L }
  op(ldiv(Y, X), Y)

Lemma 167: rdiv(X, K(rdiv(X, Y), Y)) = op(Y, rdiv(X, Y)).
Proof:
  rdiv(X, K(rdiv(X, Y), Y))
= { by axiom 9 (sos) R->L }
  rdiv(op(rdiv(X, Y), Y), K(rdiv(X, Y), Y)) (peak)
= { by lemma 28 }
  op(Y, rdiv(X, Y))

Lemma 168: op(ldiv(ldiv(X, Y), Y), ldiv(X, Y)) = op(X, rdiv(Y, X)).
Proof:
  op(ldiv(ldiv(X, Y), Y), ldiv(X, Y))
= { by lemma 166 R->L }
  op(Y, K(ldiv(ldiv(X, Y), Y), ldiv(X, Y))) (peak)
= { by lemma 62 }
  op(Y, K(T(X, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 57 }
  rdiv(Y, K(ldiv(X, Y), T(X, ldiv(X, Y))))
= { by lemma 88 }
  rdiv(Y, K(rdiv(Y, X), T(X, ldiv(X, Y))))
= { by lemma 86 }
  rdiv(Y, K(rdiv(Y, X), X))
= { by lemma 167 }
  op(X, rdiv(Y, X))

Lemma 169: op(T(X, rdiv(Y, X)), ldiv(X, Y)) = op(X, rdiv(Y, X)).
Proof:
  op(T(X, rdiv(Y, X)), ldiv(X, Y))
= { by lemma 102 R->L }
  op(T(X, ldiv(X, Y)), ldiv(X, Y)) (peak)
= { by lemma 62 R->L }
  op(ldiv(ldiv(X, Y), Y), ldiv(X, Y)) (peak)
= { by lemma 168 }
  op(X, rdiv(Y, X))

Lemma 170: rdiv(ldiv(X, Y), K(rdiv(Y, X), X)) = rdiv(Y, X).
Proof:
  rdiv(ldiv(X, Y), K(rdiv(Y, X), X))
= { by lemma 70 R->L }
  rdiv(ldiv(X, Y), K(rdiv(Y, X), T(X, rdiv(Y, X))))
= { by lemma 88 R->L }
  rdiv(ldiv(X, Y), K(ldiv(X, Y), T(X, rdiv(Y, X))))
= { by lemma 57 R->L }
  op(ldiv(X, Y), K(T(X, rdiv(Y, X)), ldiv(X, Y)))
= { by lemma 36 }
  rdiv(op(T(X, rdiv(Y, X)), ldiv(X, Y)), T(X, rdiv(Y, X))) (peak)
= { by lemma 169 }
  rdiv(op(X, rdiv(Y, X)), T(X, rdiv(Y, X)))
= { by lemma 144 }
  rdiv(Y, X)

Lemma 171: L(X, Y, ldiv(Z, W)) = L(X, Y, rdiv(W, Z)).
Proof:
  L(X, Y, ldiv(Z, W))
= { by lemma 165 R->L }
  L(X, Y, rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))) (peak)
= { by lemma 170 }
  L(X, Y, rdiv(W, Z))

Lemma 172: rdiv(op(X, Y), K(Z, X)) = op(T(X, Z), Y).
Proof:
  rdiv(op(X, Y), K(Z, X))
= { by lemma 56 R->L }
  op(K(X, Z), op(X, Y))
= { by lemma 30 R->L }
  op(op(X, K(X, Z)), Y) (peak)
= { by lemma 34 }
  op(T(X, Z), Y)

Lemma 173: L(X, K(Y, Z), Y) = X.
Proof:
  L(X, K(Y, Z), Y)
= { by lemma 44 R->L }
  L(T(X, K(Y, Z)), K(Y, Z), Y)
= { by lemma 76 R->L }
  ldiv(op(Y, K(Y, Z)), op(Y, op(X, K(Y, Z)))) (peak)
= { by lemma 34 }
  ldiv(T(Y, Z), op(Y, op(X, K(Y, Z))))
= { by lemma 57 }
  ldiv(T(Y, Z), op(Y, rdiv(X, K(Z, Y))))
= { by lemma 96 }
  ldiv(T(Y, Z), rdiv(op(Y, X), K(Z, Y)))
= { by lemma 172 }
  ldiv(T(Y, Z), op(T(Y, Z), X))
= { by axiom 4 (sos) }
  X

Lemma 174: op(op(X, a(Y, Z, W)), V) = op(X, op(V, a(Y, Z, W))).
Proof:
  op(op(X, a(Y, Z, W)), V)
= { by axiom 20 (sos) }
  op(op(X, op(a(Y, Z, W), V)), a(X, a(Y, Z, W), V)) (peak)
= { by lemma 103 }
  op(op(X, op(V, a(Y, Z, W))), a(X, a(Y, Z, W), V)) (peak)
= { by axiom 15 (sos) }
  op(op(X, op(V, a(Y, Z, W))), 1)
= { by lemma 24 }
  op(op(X, op(V, a(Y, Z, W))), zero)
= { by axiom 1 (sos) }
  op(X, op(V, a(Y, Z, W)))

Lemma 175: op(a(X, Y, Z), op(W, V)) = op(W, op(V, a(X, Y, Z))).
Proof:
  op(a(X, Y, Z), op(W, V)) (peak)
= { by lemma 103 }
  op(op(W, V), a(X, Y, Z)) (peak)
= { by lemma 115 R->L }
  op(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 174 }
  op(W, op(V, a(X, Y, Z)))

Lemma 176: op(a(X, Y, Z), op(W, V)) = op(W, op(a(X, Y, Z), V)).
Proof:
  op(a(X, Y, Z), op(W, V)) (peak)
= { by lemma 175 }
  op(W, op(V, a(X, Y, Z))) (peak)
= { by lemma 103 R->L }
  op(W, op(a(X, Y, Z), V)) (peak)

Lemma 177: op(X, L(Y, ldiv(Z, X), Z)) = op(Z, op(ldiv(Z, X), Y)).
Proof:
  op(X, L(Y, ldiv(Z, X), Z))
= { by axiom 8 (sos) R->L }
  op(op(Z, ldiv(Z, X)), L(Y, ldiv(Z, X), Z)) (peak)
= { by lemma 109 }
  op(Z, op(ldiv(Z, X), Y))

Lemma 178: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, rdiv(X, Y), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by lemma 177 R->L }
  ldiv(X, op(X, L(Z, ldiv(Y, X), Y))) (peak)
= { by axiom 4 (sos) }
  L(Z, ldiv(Y, X), Y)
= { by lemma 134 }
  L(Z, rdiv(X, Y), Y)

Lemma 179: op(rdiv(X, a(Y, Z, W)), V) = rdiv(op(X, V), a(Y, Z, W)).
Proof:
  op(rdiv(X, a(Y, Z, W)), V)
= { by axiom 1 (sos) R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, zero))
= { by lemma 24 R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, 1))
= { by axiom 16 (sos) R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, a(a(Y, Z, W), rdiv(X, a(Y, Z, W)), V))) (peak)
= { by lemma 107 }
  ldiv(a(Y, Z, W), op(op(a(Y, Z, W), rdiv(X, a(Y, Z, W))), V))
= { by lemma 112 }
  ldiv(a(Y, Z, W), op(X, V))
= { by lemma 113 }
  rdiv(op(X, V), a(Y, Z, W))

Lemma 180: L(X, rdiv(Y, a(Z, W, V)), a(Z, W, V)) = X.
Proof:
  L(X, rdiv(Y, a(Z, W, V)), a(Z, W, V))
= { by lemma 178 R->L }
  ldiv(Y, op(a(Z, W, V), op(ldiv(a(Z, W, V), Y), X))) (peak)
= { by lemma 113 }
  ldiv(Y, op(a(Z, W, V), op(rdiv(Y, a(Z, W, V)), X)))
= { by lemma 179 }
  ldiv(Y, op(a(Z, W, V), rdiv(op(Y, X), a(Z, W, V))))
= { by lemma 112 }
  ldiv(Y, op(Y, X))
= { by axiom 4 (sos) }
  X

Lemma 181: L(X, Y, a(Z, W, V)) = X.
Proof:
  L(X, Y, a(Z, W, V))
= { by axiom 3 (sos) R->L }
  L(X, rdiv(op(Y, a(Z, W, V)), a(Z, W, V)), a(Z, W, V)) (peak)
= { by lemma 180 }
  X

Lemma 182: T(X, op(Y, a(Z, W, V))) = T(X, Y).
Proof:
  T(X, op(Y, a(Z, W, V))) (peak)
= { by lemma 101 R->L }
  T(X, op(a(Z, W, V), Y))
= { by axiom 5 (sos) }
  ldiv(op(a(Z, W, V), Y), op(X, op(a(Z, W, V), Y))) (peak)
= { by lemma 176 R->L }
  ldiv(op(a(Z, W, V), Y), op(a(Z, W, V), op(X, Y))) (peak)
= { by lemma 76 }
  L(T(X, Y), Y, a(Z, W, V))
= { by lemma 181 }
  T(X, Y)

Lemma 183: T(X, op(a(Y, Z, W), V)) = T(X, V).
Proof:
  T(X, op(a(Y, Z, W), V)) (peak)
= { by lemma 103 }
  T(X, op(V, a(Y, Z, W))) (peak)
= { by lemma 182 }
  T(X, V)

Lemma 184: T(X, L(Y, Z, W)) = T(X, Y).
Proof:
  T(X, L(Y, Z, W))
= { by lemma 183 R->L }
  T(X, op(a(W, Z, L(Y, Z, W)), L(Y, Z, W))) (peak)
= { by lemma 101 R->L }
  T(X, op(L(Y, Z, W), a(W, Z, L(Y, Z, W))))
= { by lemma 110 }
  T(X, Y)

Lemma 185: T(X, L(Y, V, U)) = T(X, L(Y, Z, W)).
Proof:
  T(X, L(Y, V, U)) (peak)
= { by lemma 184 }
  T(X, Y)
= { by lemma 110 R->L }
  T(X, op(L(Y, Z, W), a(W, Z, L(Y, Z, W))))
= { by lemma 101 }
  T(X, op(a(W, Z, L(Y, Z, W)), L(Y, Z, W))) (peak)
= { by lemma 183 }
  T(X, L(Y, Z, W))

Lemma 186: T(a(X, Y, Z), W) = a(X, Y, Z).
Proof:
  T(a(X, Y, Z), W)
= { by axiom 5 (sos) }
  ldiv(W, op(a(X, Y, Z), W)) (peak)
= { by lemma 103 }
  ldiv(W, op(W, a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 187: op(R(X, Y, Z), op(Y, Z)) = op(op(X, Y), Z).
Proof:
  op(R(X, Y, Z), op(Y, Z))
= { by axiom 18 (sos) }
  op(rdiv(op(op(X, Y), Z), op(Y, Z)), op(Y, Z)) (peak)
= { by axiom 9 (sos) }
  op(op(X, Y), Z)

Lemma 188: op(R(X, Y, ldiv(Y, Z)), Z) = op(op(X, Y), ldiv(Y, Z)).
Proof:
  op(R(X, Y, ldiv(Y, Z)), Z)
= { by axiom 8 (sos) R->L }
  op(R(X, Y, ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by lemma 187 }
  op(op(X, Y), ldiv(Y, Z))

Lemma 189: op(op(X, Y), ldiv(Y, zero)) = R(X, Y, ldiv(Y, zero)).
Proof:
  op(op(X, Y), ldiv(Y, zero))
= { by lemma 188 R->L }
  op(R(X, Y, ldiv(Y, zero)), zero) (peak)
= { by axiom 1 (sos) }
  R(X, Y, ldiv(Y, zero))

Lemma 190: op(X, L(Y, Z, rdiv(X, Z))) = op(rdiv(X, Z), op(Z, Y)).
Proof:
  op(X, L(Y, Z, rdiv(X, Z)))
= { by axiom 9 (sos) R->L }
  op(op(rdiv(X, Z), Z), L(Y, Z, rdiv(X, Z))) (peak)
= { by lemma 109 }
  op(rdiv(X, Z), op(Z, Y))

Lemma 191: op(rdiv(zero, X), op(X, Y)) = L(Y, X, rdiv(zero, X)).
Proof:
  op(rdiv(zero, X), op(X, Y))
= { by lemma 190 R->L }
  op(zero, L(Y, X, rdiv(zero, X))) (peak)
= { by axiom 2 (sos) }
  L(Y, X, rdiv(zero, X))

Lemma 192: op(rdiv(op(Z, X), Z), Y) = op(X, op(Y, K(Z, X))).
Proof:
  op(rdiv(op(Z, X), Z), Y) (peak)
= { by lemma 36 R->L }
  op(op(X, K(Z, X)), Y) (peak)
= { by lemma 30 }
  op(K(Z, X), op(X, Y))
= { by lemma 31 }
  op(X, op(Y, K(Z, X)))

Lemma 193: op(rdiv(op(X, Y), X), Z) = rdiv(op(Y, Z), K(Y, X)).
Proof:
  op(rdiv(op(X, Y), X), Z) (peak)
= { by lemma 192 }
  op(Y, op(Z, K(X, Y))) (peak)
= { by lemma 29 R->L }
  op(Y, op(K(X, Y), Z)) (peak)
= { by lemma 56 }
  op(Y, rdiv(Z, K(Y, X)))
= { by lemma 96 }
  rdiv(op(Y, Z), K(Y, X))

Lemma 194: ldiv(rdiv(X, Y), T(X, Z)) = rdiv(Y, K(Z, X)).
Proof:
  ldiv(rdiv(X, Y), T(X, Z))
= { by lemma 91 R->L }
  ldiv(R(rdiv(X, Y), Y, K(X, Z)), T(X, Z))
= { by lemma 34 R->L }
  ldiv(R(rdiv(X, Y), Y, K(X, Z)), op(X, K(X, Z))) (peak)
= { by lemma 146 }
  op(Y, K(X, Z))
= { by lemma 57 }
  rdiv(Y, K(Z, X))

Lemma 195: ldiv(op(Z, rdiv(Y, X)), op(Z, Y)) = L(X, rdiv(Y, X), Z).
Proof:
  ldiv(op(Z, rdiv(Y, X)), op(Z, Y))
= { by axiom 9 (sos) R->L }
  ldiv(op(Z, rdiv(Y, X)), op(Z, op(rdiv(Y, X), X))) (peak)
= { by axiom 19 (sos) R->L }
  L(X, rdiv(Y, X), Z)

Lemma 196: rdiv(op(X, Y), L(Z, rdiv(Y, Z), X)) = op(X, rdiv(Y, Z)).
Proof:
  rdiv(op(X, Y), L(Z, rdiv(Y, Z), X)) (peak)
= { by lemma 195 R->L }
  rdiv(op(X, Y), ldiv(op(X, rdiv(Y, Z)), op(X, Y))) (peak)
= { by lemma 72 }
  op(X, rdiv(Y, Z))

Lemma 197: rdiv(X, rdiv(Y, K(X, Z))) = rdiv(T(X, Z), Y).
Proof:
  rdiv(X, rdiv(Y, K(X, Z)))
= { by lemma 129 R->L }
  rdiv(rdiv(X, Y), K(Z, X))
= { by lemma 56 R->L }
  op(K(X, Z), rdiv(X, Y))
= { by lemma 196 R->L }
  rdiv(op(K(X, Z), X), L(Y, rdiv(X, Y), K(X, Z))) (peak)
= { by lemma 59 }
  rdiv(T(X, Z), L(Y, rdiv(X, Y), K(X, Z)))
= { by lemma 82 }
  rdiv(T(X, Z), Y)

Lemma 198: rdiv(op(X, Y), T(Y, X)) = T(X, Y).
Proof:
  rdiv(op(X, Y), T(Y, X))
= { by lemma 93 R->L }
  rdiv(op(T(X, Y), T(Y, X)), T(Y, X)) (peak)
= { by axiom 3 (sos) }
  T(X, Y)

Lemma 199: rdiv(X, T(Y, rdiv(X, Y))) = ldiv(Y, X).
Proof:
  rdiv(X, T(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  rdiv(op(rdiv(X, Y), Y), T(Y, rdiv(X, Y))) (peak)
= { by lemma 198 }
  T(rdiv(X, Y), Y)
= { by lemma 43 }
  ldiv(Y, X)

Lemma 200: rdiv(op(X, Y), T(Y, Z)) = rdiv(X, K(Y, Z)).
Proof:
  rdiv(op(X, Y), T(Y, Z))
= { by lemma 44 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), T(Y, Z))
= { by lemma 34 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), op(Y, K(Y, Z)))
= { by lemma 162 }
  R(rdiv(X, K(Y, Z)), K(Y, Z), T(Y, K(Y, Z))) (peak)
= { by lemma 79 }
  rdiv(X, K(Y, Z))

Lemma 201: rdiv(ldiv(X, Y), K(X, Z)) = ldiv(T(X, Z), Y).
Proof:
  rdiv(ldiv(X, Y), K(X, Z))
= { by lemma 45 R->L }
  ldiv(K(X, Z), ldiv(X, Y))
= { by lemma 173 R->L }
  L(ldiv(K(X, Z), ldiv(X, Y)), K(X, Z), X) (peak)
= { by lemma 124 }
  ldiv(op(X, K(X, Z)), Y)
= { by lemma 34 }
  ldiv(T(X, Z), Y)

Lemma 202: rdiv(ldiv(X, Y), K(Z, Y)) = ldiv(X, T(Y, Z)).
Proof:
  rdiv(ldiv(X, Y), K(Z, Y))
= { by lemma 194 R->L }
  ldiv(rdiv(Y, ldiv(X, Y)), T(Y, Z)) (peak)
= { by lemma 72 }
  ldiv(X, T(Y, Z))

Lemma 203: a(a(X, Y, Z), W, V) = zero.
Proof:
  a(a(X, Y, Z), W, V) (peak)
= { by axiom 16 (sos) }
  1
= { by lemma 24 }
  zero

Lemma 204: R(X, a(Y, Z, W), rdiv(V, a(Y, Z, W))) = X.
Proof:
  R(X, a(Y, Z, W), rdiv(V, a(Y, Z, W)))
= { by lemma 113 R->L }
  R(X, a(Y, Z, W), ldiv(a(Y, Z, W), V))
= { by lemma 46 R->L }
  rdiv(op(op(X, a(Y, Z, W)), ldiv(a(Y, Z, W), V)), V) (peak)
= { by lemma 174 }
  rdiv(op(X, op(ldiv(a(Y, Z, W), V), a(Y, Z, W))), V)
= { by lemma 113 }
  rdiv(op(X, op(rdiv(V, a(Y, Z, W)), a(Y, Z, W))), V)
= { by axiom 9 (sos) }
  rdiv(op(X, V), V)
= { by axiom 3 (sos) }
  X

Lemma 205: R(X, a(Y, Z, W), V) = X.
Proof:
  R(X, a(Y, Z, W), V)
= { by axiom 3 (sos) R->L }
  R(X, a(Y, Z, W), rdiv(op(V, a(Y, Z, W)), a(Y, Z, W))) (peak)
= { by lemma 204 }
  X

Lemma 206: L(a(X, Y, Z), W, V) = a(X, Y, Z).
Proof:
  L(a(X, Y, Z), W, V)
= { by axiom 19 (sos) }
  ldiv(op(V, W), op(V, op(W, a(X, Y, Z))))
= { by lemma 105 R->L }
  ldiv(op(V, W), op(op(V, W), a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 207: op(X, rdiv(L(X, Y, Z), X)) = L(X, Y, Z).
Proof:
  op(X, rdiv(L(X, Y, Z), X))
= { by lemma 167 R->L }
  rdiv(L(X, Y, Z), K(rdiv(L(X, Y, Z), X), X))
= { by lemma 88 R->L }
  rdiv(L(X, Y, Z), K(ldiv(X, L(X, Y, Z)), X))
= { by lemma 141 R->L }
  rdiv(op(ldiv(X, L(X, Y, Z)), X), K(ldiv(X, L(X, Y, Z)), X)) (peak)
= { by lemma 28 }
  op(X, ldiv(X, L(X, Y, Z)))
= { by axiom 8 (sos) }
  L(X, Y, Z)

Lemma 208: op(X, T(Y, L(X, Z, W))) = op(Y, X).
Proof:
  op(X, T(Y, L(X, Z, W))) (peak)
= { by lemma 184 }
  op(X, T(Y, X))
= { by lemma 58 }
  op(Y, X)

Lemma 209: T(rdiv(X, L(Y, Z, W)), L(L(Y, V, U), T, S)) = ldiv(L(Y, Z, W), X).
Proof:
  T(rdiv(X, L(Y, Z, W)), L(L(Y, V, U), T, S)) (peak)
= { by lemma 184 }
  T(rdiv(X, L(Y, Z, W)), L(Y, V, U))
= { by lemma 185 }
  T(rdiv(X, L(Y, Z, W)), L(Y, Z, W)) (peak)
= { by lemma 43 }
  ldiv(L(Y, Z, W), X)

Lemma 210: op(rdiv(X, L(Y, Z, W)), L(Y, V, U)) = op(L(Y, V, U), ldiv(L(Y, Z, W), X)).
Proof:
  op(rdiv(X, L(Y, Z, W)), L(Y, V, U))
= { by lemma 208 R->L }
  op(L(Y, V, U), T(rdiv(X, L(Y, Z, W)), L(L(Y, V, U), T, S))) (peak)
= { by lemma 209 }
  op(L(Y, V, U), ldiv(L(Y, Z, W), X))

Lemma 211: rdiv(R(X, Y, rdiv(zero, Y)), ldiv(Y, zero)) = op(X, Y).
Proof:
  rdiv(R(X, Y, rdiv(zero, Y)), ldiv(Y, zero))
= { by lemma 160 R->L }
  rdiv(R(X, Y, ldiv(Y, zero)), ldiv(Y, zero))
= { by lemma 189 R->L }
  rdiv(op(op(X, Y), ldiv(Y, zero)), ldiv(Y, zero)) (peak)
= { by axiom 3 (sos) }
  op(X, Y)

Lemma 212: R(X, rdiv(Y, L(Y, Z, W)), V) = X.
Proof:
  R(X, rdiv(Y, L(Y, Z, W)), V)
= { by lemma 145 R->L }
  R(X, ldiv(L(Y, Z, W), Y), V) (peak)
= { by lemma 143 R->L }
  R(X, a(W, Z, L(Y, Z, W)), V) (peak)
= { by lemma 205 }
  X

Lemma 213: ldiv(rdiv(X, L(X, Y, Z)), W) = rdiv(W, rdiv(X, L(X, Y, Z))).
Proof:
  ldiv(rdiv(X, L(X, Y, Z)), W)
= { by lemma 145 R->L }
  ldiv(ldiv(L(X, Y, Z), X), W) (peak)
= { by lemma 143 R->L }
  ldiv(a(Z, Y, L(X, Y, Z)), W) (peak)
= { by lemma 113 }
  rdiv(W, a(Z, Y, L(X, Y, Z)))
= { by lemma 111 }
  rdiv(W, rdiv(X, L(X, Y, Z))) (peak)

Lemma 214: op(X, rdiv(Y, L(Y, Z, W))) = rdiv(X, rdiv(L(Y, Z, W), Y)).
Proof:
  op(X, rdiv(Y, L(Y, Z, W)))
= { by lemma 211 R->L }
  rdiv(R(X, rdiv(Y, L(Y, Z, W)), rdiv(zero, rdiv(Y, L(Y, Z, W)))), ldiv(rdiv(Y, L(Y, Z, W)), zero)) (peak)
= { by lemma 119 }
  rdiv(R(X, rdiv(Y, L(Y, Z, W)), ldiv(Y, L(Y, Z, W))), ldiv(rdiv(Y, L(Y, Z, W)), zero))
= { by lemma 212 }
  rdiv(X, ldiv(rdiv(Y, L(Y, Z, W)), zero))
= { by lemma 213 }
  rdiv(X, rdiv(zero, rdiv(Y, L(Y, Z, W))))
= { by lemma 119 }
  rdiv(X, ldiv(Y, L(Y, Z, W)))
= { by lemma 142 }
  rdiv(X, rdiv(L(Y, Z, W), Y))

Lemma 215: rdiv(op(X, Y), K(rdiv(X, Z), Z)) = op(op(Z, rdiv(X, Z)), Y).
Proof:
  rdiv(op(X, Y), K(rdiv(X, Z), Z))
= { by lemma 96 R->L }
  op(X, rdiv(Y, K(rdiv(X, Z), Z)))
= { by lemma 56 R->L }
  op(X, op(K(Z, rdiv(X, Z)), Y))
= { by lemma 97 R->L }
  rdiv(op(op(X, K(Z, rdiv(X, Z))), Y), a(X, K(Z, rdiv(X, Z)), Y)) (peak)
= { by lemma 41 }
  rdiv(op(op(Z, rdiv(X, Z)), Y), a(X, K(Z, rdiv(X, Z)), Y))
= { by axiom 12 (sos) }
  rdiv(op(op(Z, rdiv(X, Z)), Y), 1)
= { by lemma 24 }
  rdiv(op(op(Z, rdiv(X, Z)), Y), zero)
= { by lemma 27 }
  op(op(Z, rdiv(X, Z)), Y)

Lemma 216: L(T(X, rdiv(Y, Z)), rdiv(Y, Z), Z) = ldiv(Y, op(Z, op(X, ldiv(Z, Y)))).
Proof:
  L(T(X, rdiv(Y, Z)), rdiv(Y, Z), Z)
= { by lemma 102 R->L }
  L(T(X, ldiv(Z, Y)), rdiv(Y, Z), Z)
= { by lemma 134 R->L }
  L(T(X, ldiv(Z, Y)), ldiv(Z, Y), Z)
= { by lemma 123 R->L }
  ldiv(Y, op(Z, op(ldiv(Z, Y), T(X, ldiv(Z, Y))))) (peak)
= { by lemma 58 }
  ldiv(Y, op(Z, op(X, ldiv(Z, Y))))

Lemma 217: T(X, op(Y, op(Z, rdiv(W, Z)))) = T(X, op(Y, W)).
Proof:
  T(X, op(Y, op(Z, rdiv(W, Z)))) (peak)
= { by lemma 101 R->L }
  T(X, op(op(Z, rdiv(W, Z)), Y))
= { by lemma 82 R->L }
  L(T(X, op(op(Z, rdiv(W, Z)), Y)), op(W, Y), K(rdiv(W, Z), Z))
= { by lemma 130 R->L }
  L(T(X, op(op(Z, rdiv(W, Z)), Y)), rdiv(op(W, Y), K(rdiv(W, Z), Z)), K(rdiv(W, Z), Z))
= { by lemma 215 R->L }
  L(T(X, rdiv(op(W, Y), K(rdiv(W, Z), Z))), rdiv(op(W, Y), K(rdiv(W, Z), Z)), K(rdiv(W, Z), Z)) (peak)
= { by lemma 216 }
  ldiv(op(W, Y), op(K(rdiv(W, Z), Z), op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y)))))
= { by lemma 56 }
  ldiv(op(W, Y), rdiv(op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y))), K(Z, rdiv(W, Z))))
= { by lemma 126 }
  rdiv(ldiv(op(W, Y), op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y)))), K(Z, rdiv(W, Z)))
= { by lemma 45 }
  rdiv(ldiv(op(W, Y), op(X, rdiv(op(W, Y), K(rdiv(W, Z), Z)))), K(Z, rdiv(W, Z)))
= { by lemma 96 }
  rdiv(ldiv(op(W, Y), rdiv(op(X, op(W, Y)), K(rdiv(W, Z), Z))), K(Z, rdiv(W, Z)))
= { by lemma 126 }
  rdiv(rdiv(ldiv(op(W, Y), op(X, op(W, Y))), K(rdiv(W, Z), Z)), K(Z, rdiv(W, Z)))
= { by lemma 164 }
  rdiv(ldiv(op(W, Y), op(X, op(W, Y))), rdiv(K(Z, rdiv(W, Z)), K(Z, rdiv(W, Z))))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, op(W, Y)), rdiv(K(Z, rdiv(W, Z)), K(Z, rdiv(W, Z))))
= { by lemma 26 }
  rdiv(T(X, op(W, Y)), zero)
= { by lemma 27 }
  T(X, op(W, Y))
= { by lemma 101 }
  T(X, op(Y, W))

Lemma 218: T(X, op(Y, T(Z, W))) = T(X, op(Y, Z)).
Proof:
  T(X, op(Y, T(Z, W))) (peak)
= { by lemma 101 R->L }
  T(X, op(T(Z, W), Y))
= { by lemma 172 R->L }
  T(X, rdiv(op(Z, Y), K(W, Z))) (peak)
= { by lemma 83 }
  T(X, op(Z, Y))
= { by lemma 101 }
  T(X, op(Y, Z))

Lemma 219: T(X, op(Y, ldiv(Z, W))) = T(X, op(Y, rdiv(W, Z))).
Proof:
  T(X, op(Y, ldiv(Z, W)))
= { by lemma 217 R->L }
  T(X, op(Y, op(K(rdiv(W, Z), Z), rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))))) (peak)
= { by lemma 170 }
  T(X, op(Y, op(K(rdiv(W, Z), Z), rdiv(W, Z))))
= { by lemma 59 }
  T(X, op(Y, T(rdiv(W, Z), Z)))
= { by lemma 218 }
  T(X, op(Y, rdiv(W, Z)))

Lemma 220: T(X, rdiv(Y, rdiv(L(Z, W, V), Z))) = T(X, Y).
Proof:
  T(X, rdiv(Y, rdiv(L(Z, W, V), Z)))
= { by lemma 214 R->L }
  T(X, op(Y, rdiv(Z, L(Z, W, V))))
= { by lemma 219 R->L }
  T(X, op(Y, ldiv(L(Z, W, V), Z))) (peak)
= { by lemma 143 R->L }
  T(X, op(Y, a(V, W, L(Z, W, V)))) (peak)
= { by lemma 182 }
  T(X, Y)

Lemma 221: ldiv(rdiv(L(X, Y, Z), W), X) = rdiv(W, rdiv(L(X, Y, Z), X)).
Proof:
  ldiv(rdiv(L(X, Y, Z), W), X)
= { by lemma 106 R->L }
  ldiv(R(rdiv(L(X, Y, Z), W), W, a(Z, Y, L(X, Y, Z))), X)
= { by lemma 110 R->L }
  ldiv(R(rdiv(L(X, Y, Z), W), W, a(Z, Y, L(X, Y, Z))), op(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))) (peak)
= { by lemma 146 }
  op(W, a(Z, Y, L(X, Y, Z)))
= { by lemma 111 }
  op(W, rdiv(X, L(X, Y, Z)))
= { by lemma 214 }
  rdiv(W, rdiv(L(X, Y, Z), X))

Lemma 222: rdiv(ldiv(X, L(Y, Z, W)), rdiv(L(Y, Z, W), Y)) = ldiv(X, Y).
Proof:
  rdiv(ldiv(X, L(Y, Z, W)), rdiv(L(Y, Z, W), Y))
= { by lemma 221 R->L }
  ldiv(rdiv(L(Y, Z, W), ldiv(X, L(Y, Z, W))), Y) (peak)
= { by lemma 72 }
  ldiv(X, Y)

Lemma 223: T(X, rdiv(L(Y, W, V), Z)) = T(X, rdiv(Y, Z)).
Proof:
  T(X, rdiv(L(Y, W, V), Z))
= { by lemma 102 R->L }
  T(X, ldiv(Z, L(Y, W, V)))
= { by lemma 220 R->L }
  T(X, rdiv(ldiv(Z, L(Y, W, V)), rdiv(L(Y, W, V), Y))) (peak)
= { by lemma 222 }
  T(X, ldiv(Z, Y))
= { by lemma 102 }
  T(X, rdiv(Y, Z))

Lemma 224: T(X, rdiv(Y, L(Y, Z, W))) = X.
Proof:
  T(X, rdiv(Y, L(Y, Z, W)))
= { by lemma 102 R->L }
  T(X, ldiv(L(Y, Z, W), Y)) (peak)
= { by lemma 143 R->L }
  T(X, a(W, Z, L(Y, Z, W))) (peak)
= { by lemma 114 }
  X

Lemma 225: T(X, rdiv(L(Y, Z, W), L(Y, V, U))) = X.
Proof:
  T(X, rdiv(L(Y, Z, W), L(Y, V, U))) (peak)
= { by lemma 223 }
  T(X, rdiv(Y, L(Y, V, U)))
= { by lemma 224 }
  X

Lemma 226: ldiv(L(X, Y, Z), L(X, W, V)) = rdiv(L(X, W, V), L(X, Y, Z)).
Proof:
  ldiv(L(X, Y, Z), L(X, W, V))
= { by lemma 199 R->L }
  rdiv(L(X, W, V), T(L(X, Y, Z), rdiv(L(X, W, V), L(X, Y, Z)))) (peak)
= { by lemma 225 }
  rdiv(L(X, W, V), L(X, Y, Z))

Lemma 227: op(X, op(Y, a(X, rdiv(Y, Z), Z))) = op(op(X, rdiv(Y, Z)), Z).
Proof:
  op(X, op(Y, a(X, rdiv(Y, Z), Z)))
= { by lemma 105 R->L }
  op(op(X, Y), a(X, rdiv(Y, Z), Z))
= { by axiom 9 (sos) R->L }
  op(op(X, op(rdiv(Y, Z), Z)), a(X, rdiv(Y, Z), Z)) (peak)
= { by axiom 20 (sos) R->L }
  op(op(X, rdiv(Y, Z)), Z)

Lemma 228: op(rdiv(X, Y), op(Y, a(Z, W, V))) = op(X, a(Z, W, V)).
Proof:
  op(rdiv(X, Y), op(Y, a(Z, W, V)))
= { by lemma 116 R->L }
  op(op(a(Z, W, V), rdiv(X, Y)), Y)
= { by lemma 227 R->L }
  op(a(Z, W, V), op(X, a(a(Z, W, V), rdiv(X, Y), Y))) (peak)
= { by lemma 203 }
  op(a(Z, W, V), op(X, zero))
= { by axiom 1 (sos) }
  op(a(Z, W, V), X)
= { by lemma 103 }
  op(X, a(Z, W, V))

Lemma 229: op(rdiv(X, L(Y, Z, W)), Y) = rdiv(X, rdiv(L(Y, Z, W), Y)).
Proof:
  op(rdiv(X, L(Y, Z, W)), Y)
= { by lemma 110 R->L }
  op(rdiv(X, L(Y, Z, W)), op(L(Y, Z, W), a(W, Z, L(Y, Z, W)))) (peak)
= { by lemma 228 }
  op(X, a(W, Z, L(Y, Z, W)))
= { by lemma 111 }
  op(X, rdiv(Y, L(Y, Z, W)))
= { by lemma 214 }
  rdiv(X, rdiv(L(Y, Z, W), Y))

Lemma 230: rdiv(rdiv(X, rdiv(L(Y, Z, W), Y)), Y) = rdiv(X, L(Y, Z, W)).
Proof:
  rdiv(rdiv(X, rdiv(L(Y, Z, W), Y)), Y)
= { by lemma 229 R->L }
  rdiv(op(rdiv(X, L(Y, Z, W)), Y), Y) (peak)
= { by axiom 3 (sos) }
  rdiv(X, L(Y, Z, W))

Lemma 231: rdiv(ldiv(X, L(Y, Z, W)), L(Y, Z, W)) = rdiv(ldiv(X, Y), Y).
Proof:
  rdiv(ldiv(X, L(Y, Z, W)), L(Y, Z, W))
= { by lemma 230 R->L }
  rdiv(rdiv(ldiv(X, L(Y, Z, W)), rdiv(L(Y, Z, W), Y)), Y) (peak)
= { by lemma 222 }
  rdiv(ldiv(X, Y), Y)

Lemma 232: op(rdiv(zero, L(X, Y, Z)), X) = rdiv(X, L(X, Y, Z)).
Proof:
  op(rdiv(zero, L(X, Y, Z)), X)
= { by lemma 110 R->L }
  op(rdiv(zero, L(X, Y, Z)), op(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))) (peak)
= { by lemma 191 }
  L(a(Z, Y, L(X, Y, Z)), L(X, Y, Z), rdiv(zero, L(X, Y, Z)))
= { by lemma 206 }
  a(Z, Y, L(X, Y, Z))
= { by lemma 111 }
  rdiv(X, L(X, Y, Z))

Lemma 233: rdiv(rdiv(X, L(X, Y, Z)), X) = rdiv(zero, L(X, Y, Z)).
Proof:
  rdiv(rdiv(X, L(X, Y, Z)), X)
= { by lemma 232 R->L }
  rdiv(op(rdiv(zero, L(X, Y, Z)), X), X) (peak)
= { by axiom 3 (sos) }
  rdiv(zero, L(X, Y, Z))

Lemma 234: rdiv(rdiv(L(X, Y, Z), L(X, W, V)), L(X, Y, Z)) = rdiv(zero, L(X, W, V)).
Proof:
  rdiv(rdiv(L(X, Y, Z), L(X, W, V)), L(X, Y, Z))
= { by lemma 226 R->L }
  rdiv(ldiv(L(X, W, V), L(X, Y, Z)), L(X, Y, Z)) (peak)
= { by lemma 231 }
  rdiv(ldiv(L(X, W, V), X), X)
= { by lemma 145 }
  rdiv(rdiv(X, L(X, W, V)), X)
= { by lemma 233 }
  rdiv(zero, L(X, W, V))

Lemma 235: op(L(X, Y, Z), ldiv(L(X, W, V), zero)) = rdiv(L(X, Y, Z), L(X, W, V)).
Proof:
  op(L(X, Y, Z), ldiv(L(X, W, V), zero)) (peak)
= { by lemma 210 R->L }
  op(rdiv(zero, L(X, W, V)), L(X, Y, Z))
= { by lemma 234 R->L }
  op(rdiv(rdiv(L(X, Y, Z), L(X, W, V)), L(X, Y, Z)), L(X, Y, Z)) (peak)
= { by axiom 9 (sos) }
  rdiv(L(X, Y, Z), L(X, W, V))

Lemma 236: T(rdiv(X, Y), L(L(Y, Z, W), V, U)) = ldiv(Y, X).
Proof:
  T(rdiv(X, Y), L(L(Y, Z, W), V, U)) (peak)
= { by lemma 184 }
  T(rdiv(X, Y), L(Y, Z, W))
= { by lemma 184 }
  T(rdiv(X, Y), Y)
= { by lemma 43 }
  ldiv(Y, X)

Lemma 237: op(L(Y, Z, W), ldiv(Y, X)) = op(rdiv(X, Y), L(Y, Z, W)).
Proof:
  op(L(Y, Z, W), ldiv(Y, X))
= { by lemma 236 R->L }
  op(L(Y, Z, W), T(rdiv(X, Y), L(L(Y, Z, W), V, U))) (peak)
= { by lemma 208 }
  op(rdiv(X, Y), L(Y, Z, W))

Lemma 238: ldiv(op(rdiv(Z, op(Y, X)), Y), Z) = L(X, Y, rdiv(Z, op(Y, X))).
Proof:
  ldiv(op(rdiv(Z, op(Y, X)), Y), Z)
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(Z, op(Y, X)), Y), op(rdiv(Z, op(Y, X)), op(Y, X))) (peak)
= { by axiom 19 (sos) R->L }
  L(X, Y, rdiv(Z, op(Y, X)))

Lemma 239: ldiv(op(L(X, Y, Z), ldiv(X, W)), W) = rdiv(X, L(X, Y, Z)).
Proof:
  ldiv(op(L(X, Y, Z), ldiv(X, W)), W) (peak)
= { by lemma 237 }
  ldiv(op(rdiv(W, X), L(X, Y, Z)), W)
= { by lemma 110 R->L }
  ldiv(op(rdiv(W, op(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))), L(X, Y, Z)), W) (peak)
= { by lemma 238 }
  L(a(Z, Y, L(X, Y, Z)), L(X, Y, Z), rdiv(W, op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))))) (peak)
= { by lemma 206 }
  a(Z, Y, L(X, Y, Z))
= { by lemma 111 }
  rdiv(X, L(X, Y, Z))

Lemma 240: op(L(X, Y, Z), ldiv(X, W)) = rdiv(W, rdiv(X, L(X, Y, Z))).
Proof:
  op(L(X, Y, Z), ldiv(X, W))
= { by lemma 72 R->L }
  rdiv(W, ldiv(op(L(X, Y, Z), ldiv(X, W)), W)) (peak)
= { by lemma 239 }
  rdiv(W, rdiv(X, L(X, Y, Z)))

Lemma 241: rdiv(rdiv(X, L(X, Y, Z)), rdiv(X, L(X, W, V))) = op(L(X, W, V), ldiv(L(X, Y, Z), zero)).
Proof:
  rdiv(rdiv(X, L(X, Y, Z)), rdiv(X, L(X, W, V)))
= { by lemma 240 R->L }
  op(L(X, W, V), ldiv(X, rdiv(X, L(X, Y, Z)))) (peak)
= { by lemma 237 }
  op(rdiv(rdiv(X, L(X, Y, Z)), X), L(X, W, V)) (peak)
= { by lemma 233 }
  op(rdiv(zero, L(X, Y, Z)), L(X, W, V))
= { by lemma 210 }
  op(L(X, W, V), ldiv(L(X, Y, Z), zero))

Lemma 242: op(rdiv(X, L(X, Y, Z)), W) = ldiv(rdiv(L(X, Y, Z), X), W).
Proof:
  op(rdiv(X, L(X, Y, Z)), W)
= { by lemma 40 R->L }
  ldiv(R(rdiv(zero, rdiv(X, L(X, Y, Z))), rdiv(X, L(X, Y, Z)), W), W) (peak)
= { by lemma 119 }
  ldiv(R(ldiv(X, L(X, Y, Z)), rdiv(X, L(X, Y, Z)), W), W)
= { by lemma 212 }
  ldiv(ldiv(X, L(X, Y, Z)), W)
= { by lemma 142 }
  ldiv(rdiv(L(X, Y, Z), X), W)

Lemma 243: rdiv(op(X, a(Y, Z, W)), V) = rdiv(X, rdiv(V, a(Y, Z, W))).
Proof:
  rdiv(op(X, a(Y, Z, W)), V)
= { by lemma 186 R->L }
  rdiv(op(X, T(a(Y, Z, W), rdiv(V, a(Y, Z, W)))), V)
= { by lemma 112 R->L }
  rdiv(op(X, T(a(Y, Z, W), rdiv(V, a(Y, Z, W)))), op(a(Y, Z, W), rdiv(V, a(Y, Z, W))))
= { by lemma 162 }
  R(rdiv(X, rdiv(V, a(Y, Z, W))), rdiv(V, a(Y, Z, W)), T(a(Y, Z, W), rdiv(V, a(Y, Z, W)))) (peak)
= { by lemma 186 }
  R(rdiv(X, rdiv(V, a(Y, Z, W))), rdiv(V, a(Y, Z, W)), a(Y, Z, W))
= { by lemma 106 }
  rdiv(X, rdiv(V, a(Y, Z, W)))

Lemma 244: rdiv(op(a(X, Y, Z), W), V) = rdiv(W, rdiv(V, a(X, Y, Z))).
Proof:
  rdiv(op(a(X, Y, Z), W), V) (peak)
= { by lemma 103 }
  rdiv(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 243 }
  rdiv(W, rdiv(V, a(X, Y, Z)))

Lemma 245: rdiv(X, rdiv(zero, a(Y, Z, W))) = op(X, a(Y, Z, W)).
Proof:
  rdiv(X, rdiv(zero, a(Y, Z, W)))
= { by lemma 243 R->L }
  rdiv(op(X, a(Y, Z, W)), zero) (peak)
= { by lemma 27 }
  op(X, a(Y, Z, W))

Lemma 246: ldiv(rdiv(L(X, Y, Z), X), W) = rdiv(W, rdiv(L(X, Y, Z), X)).
Proof:
  ldiv(rdiv(L(X, Y, Z), X), W)
= { by lemma 242 R->L }
  op(rdiv(X, L(X, Y, Z)), W)
= { by lemma 110 R->L }
  op(rdiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), L(X, Y, Z)), W)
= { by lemma 193 }
  rdiv(op(a(Z, Y, L(X, Y, Z)), W), K(a(Z, Y, L(X, Y, Z)), L(X, Y, Z))) (peak)
= { by lemma 244 }
  rdiv(W, rdiv(K(a(Z, Y, L(X, Y, Z)), L(X, Y, Z)), a(Z, Y, L(X, Y, Z))))
= { by axiom 11 (sos) }
  rdiv(W, rdiv(1, a(Z, Y, L(X, Y, Z))))
= { by lemma 24 }
  rdiv(W, rdiv(zero, a(Z, Y, L(X, Y, Z))))
= { by lemma 245 }
  op(W, a(Z, Y, L(X, Y, Z)))
= { by lemma 111 }
  op(W, rdiv(X, L(X, Y, Z)))
= { by lemma 214 }
  rdiv(W, rdiv(L(X, Y, Z), X))

Lemma 247: L(ldiv(X, Y), X, rdiv(Z, Y)) = ldiv(op(rdiv(Z, Y), X), Z).
Proof:
  L(ldiv(X, Y), X, rdiv(Z, Y)) (peak)
= { by lemma 75 R->L }
  ldiv(op(rdiv(Z, Y), X), op(rdiv(Z, Y), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(op(rdiv(Z, Y), X), Z)

Lemma 248: L(X, Y, rdiv(op(Z, W), Z)) = L(X, Y, W).
Proof:
  L(X, Y, rdiv(op(Z, W), Z))
= { by lemma 171 R->L }
  L(X, Y, ldiv(Z, op(Z, W))) (peak)
= { by axiom 4 (sos) }
  L(X, Y, W)

Lemma 249: L(X, Y, rdiv(Z, L(Z, W, V))) = X.
Proof:
  L(X, Y, rdiv(Z, L(Z, W, V)))
= { by lemma 110 R->L }
  L(X, Y, rdiv(op(L(Z, W, V), a(V, W, L(Z, W, V))), L(Z, W, V))) (peak)
= { by lemma 248 }
  L(X, Y, a(V, W, L(Z, W, V)))
= { by lemma 181 }
  X

Lemma 250: ldiv(rdiv(X, rdiv(L(Y, Z, W), Y)), Y) = ldiv(X, L(Y, Z, W)).
Proof:
  ldiv(rdiv(X, rdiv(L(Y, Z, W), Y)), Y)
= { by lemma 246 R->L }
  ldiv(ldiv(rdiv(L(Y, Z, W), Y), X), Y)
= { by lemma 242 R->L }
  ldiv(op(rdiv(Y, L(Y, Z, W)), X), Y)
= { by lemma 247 R->L }
  L(ldiv(X, L(Y, Z, W)), X, rdiv(Y, L(Y, Z, W))) (peak)
= { by lemma 249 }
  ldiv(X, L(Y, Z, W))

Lemma 251: rdiv(Y, ldiv(X, L(Y, Z, W))) = rdiv(X, rdiv(L(Y, Z, W), Y)).
Proof:
  rdiv(Y, ldiv(X, L(Y, Z, W)))
= { by lemma 250 R->L }
  rdiv(Y, ldiv(rdiv(X, rdiv(L(Y, Z, W), Y)), Y)) (peak)
= { by lemma 72 }
  rdiv(X, rdiv(L(Y, Z, W), Y))

Lemma 252: op(rdiv(X, Y), a(Z, W, V)) = rdiv(X, rdiv(Y, a(Z, W, V))).
Proof:
  op(rdiv(X, Y), a(Z, W, V)) (peak)
= { by lemma 103 R->L }
  op(a(Z, W, V), rdiv(X, Y))
= { by lemma 196 R->L }
  rdiv(op(a(Z, W, V), X), L(Y, rdiv(X, Y), a(Z, W, V))) (peak)
= { by lemma 103 }
  rdiv(op(X, a(Z, W, V)), L(Y, rdiv(X, Y), a(Z, W, V))) (peak)
= { by lemma 243 }
  rdiv(X, rdiv(L(Y, rdiv(X, Y), a(Z, W, V)), a(Z, W, V)))
= { by lemma 181 }
  rdiv(X, rdiv(Y, a(Z, W, V)))

Lemma 253: rdiv(Z, ldiv(rdiv(X, Y), L(Z, W, V))) = rdiv(X, rdiv(Y, rdiv(Z, L(Z, W, V)))).
Proof:
  rdiv(Z, ldiv(rdiv(X, Y), L(Z, W, V))) (peak)
= { by lemma 251 }
  rdiv(rdiv(X, Y), rdiv(L(Z, W, V), Z))
= { by lemma 214 R->L }
  op(rdiv(X, Y), rdiv(Z, L(Z, W, V))) (peak)
= { by lemma 111 R->L }
  op(rdiv(X, Y), a(V, W, L(Z, W, V))) (peak)
= { by lemma 252 }
  rdiv(X, rdiv(Y, a(V, W, L(Z, W, V))))
= { by lemma 143 }
  rdiv(X, rdiv(Y, ldiv(L(Z, W, V), Z))) (peak)
= { by lemma 145 }
  rdiv(X, rdiv(Y, rdiv(Z, L(Z, W, V))))

Lemma 254: rdiv(op(X, T(Y, Z)), op(Y, Z)) = R(rdiv(X, Z), Z, Y).
Proof:
  rdiv(op(X, T(Y, Z)), op(Y, Z))
= { by lemma 58 R->L }
  rdiv(op(X, T(Y, Z)), op(Z, T(Y, Z))) (peak)
= { by lemma 37 }
  R(rdiv(X, Z), Z, T(Y, Z))
= { by lemma 161 }
  R(rdiv(X, Z), Z, Y)

Lemma 255: rdiv(op(X, L(Y, Z, W)), Y) = rdiv(X, rdiv(Y, L(Y, Z, W))).
Proof:
  rdiv(op(X, L(Y, Z, W)), Y)
= { by lemma 114 R->L }
  rdiv(op(X, T(L(Y, Z, W), a(W, Z, L(Y, Z, W)))), Y)
= { by lemma 110 R->L }
  rdiv(op(X, T(L(Y, Z, W), a(W, Z, L(Y, Z, W)))), op(L(Y, Z, W), a(W, Z, L(Y, Z, W)))) (peak)
= { by lemma 254 }
  R(rdiv(X, a(W, Z, L(Y, Z, W))), a(W, Z, L(Y, Z, W)), L(Y, Z, W))
= { by lemma 205 }
  rdiv(X, a(W, Z, L(Y, Z, W)))
= { by lemma 111 }
  rdiv(X, rdiv(Y, L(Y, Z, W)))

Lemma 256: rdiv(rdiv(X, L(Y, Z, W)), rdiv(Y, L(Y, Z, W))) = rdiv(X, Y).
Proof:
  rdiv(rdiv(X, L(Y, Z, W)), rdiv(Y, L(Y, Z, W)))
= { by lemma 255 R->L }
  rdiv(op(rdiv(X, L(Y, Z, W)), L(Y, Z, W)), Y) (peak)
= { by axiom 9 (sos) }
  rdiv(X, Y)

Lemma 257: rdiv(X, ldiv(rdiv(Y, X), L(X, Z, W))) = rdiv(Y, L(X, Z, W)).
Proof:
  rdiv(X, ldiv(rdiv(Y, X), L(X, Z, W)))
= { by lemma 251 }
  rdiv(rdiv(Y, X), rdiv(L(X, Z, W), X))
= { by lemma 214 R->L }
  op(rdiv(Y, X), rdiv(X, L(X, Z, W)))
= { by lemma 256 R->L }
  op(rdiv(rdiv(Y, L(X, Z, W)), rdiv(X, L(X, Z, W))), rdiv(X, L(X, Z, W))) (peak)
= { by axiom 9 (sos) }
  rdiv(Y, L(X, Z, W))

Lemma 258: rdiv(rdiv(X, L(Y, Z, W)), rdiv(L(Y, V, U), L(Y, Z, W))) = rdiv(X, L(Y, V, U)).
Proof:
  rdiv(rdiv(X, L(Y, Z, W)), rdiv(L(Y, V, U), L(Y, Z, W)))
= { by lemma 235 R->L }
  rdiv(rdiv(X, L(Y, Z, W)), op(L(Y, V, U), ldiv(L(Y, Z, W), zero)))
= { by lemma 241 R->L }
  rdiv(rdiv(X, L(Y, Z, W)), rdiv(rdiv(Y, L(Y, Z, W)), rdiv(Y, L(Y, V, U)))) (peak)
= { by lemma 253 R->L }
  rdiv(Y, ldiv(rdiv(rdiv(X, L(Y, Z, W)), rdiv(Y, L(Y, Z, W))), L(Y, V, U)))
= { by lemma 256 }
  rdiv(Y, ldiv(rdiv(X, Y), L(Y, V, U)))
= { by lemma 257 }
  rdiv(X, L(Y, V, U))

Lemma 259: ldiv(rdiv(L(X, Y, Z), L(X, W, V)), U) = rdiv(U, rdiv(L(X, Y, Z), L(X, W, V))).
Proof:
  ldiv(rdiv(L(X, Y, Z), L(X, W, V)), U)
= { by lemma 43 R->L }
  T(rdiv(U, rdiv(L(X, Y, Z), L(X, W, V))), rdiv(L(X, Y, Z), L(X, W, V))) (peak)
= { by lemma 225 }
  rdiv(U, rdiv(L(X, Y, Z), L(X, W, V)))

Lemma 260: T(X, op(Y, rdiv(Z, Y))) = T(X, Z).
Proof:
  T(X, op(Y, rdiv(Z, Y)))
= { by lemma 101 R->L }
  T(X, op(rdiv(Z, Y), Y)) (peak)
= { by axiom 9 (sos) }
  T(X, Z)

Lemma 261: T(X, rdiv(Y, T(Z, W))) = T(X, rdiv(Y, Z)).
Proof:
  T(X, rdiv(Y, T(Z, W)))
= { by lemma 83 R->L }
  T(X, rdiv(rdiv(Y, T(Z, W)), K(W, Z)))
= { by lemma 56 R->L }
  T(X, op(K(Z, W), rdiv(Y, T(Z, W))))
= { by lemma 219 R->L }
  T(X, op(K(Z, W), ldiv(T(Z, W), Y)))
= { by lemma 201 R->L }
  T(X, op(K(Z, W), rdiv(ldiv(Z, Y), K(Z, W)))) (peak)
= { by lemma 260 }
  T(X, ldiv(Z, Y))
= { by lemma 102 }
  T(X, rdiv(Y, Z))

Lemma 262: T(X, L(L(Y, T, S), X2, Y2)) = T(X, L(L(Y, Z, W), V, U)).
Proof:
  T(X, L(L(Y, T, S), X2, Y2)) (peak)
= { by lemma 184 }
  T(X, L(Y, T, S))
= { by lemma 185 }
  T(X, L(Y, Z, W))
= { by lemma 110 R->L }
  T(X, op(L(L(Y, Z, W), V, U), a(U, V, L(L(Y, Z, W), V, U))))
= { by lemma 101 }
  T(X, op(a(U, V, L(L(Y, Z, W), V, U)), L(L(Y, Z, W), V, U))) (peak)
= { by lemma 183 }
  T(X, L(L(Y, Z, W), V, U))

Lemma 263: rdiv(L(L(X, Y, Z), W, V), K(U, L(L(X, T, S), X2, Y2))) = T(L(L(X, Y, Z), W, V), U).
Proof:
  rdiv(L(L(X, Y, Z), W, V), K(U, L(L(X, T, S), X2, Y2)))
= { by lemma 200 R->L }
  rdiv(op(L(L(X, Y, Z), W, V), U), T(U, L(L(X, T, S), X2, Y2))) (peak)
= { by lemma 262 }
  rdiv(op(L(L(X, Y, Z), W, V), U), T(U, L(L(X, Y, Z), W, V))) (peak)
= { by lemma 198 }
  T(L(L(X, Y, Z), W, V), U)

Lemma 264: rdiv(T(X, L(L(Y, Z, W), V, U)), L(L(Y, T, S), X2, Y2)) = rdiv(X, T(L(L(Y, T, S), X2, Y2), X)).
Proof:
  rdiv(T(X, L(L(Y, Z, W), V, U)), L(L(Y, T, S), X2, Y2))
= { by lemma 197 R->L }
  rdiv(X, rdiv(L(L(Y, T, S), X2, Y2), K(X, L(L(Y, Z, W), V, U)))) (peak)
= { by lemma 263 }
  rdiv(X, T(L(L(Y, T, S), X2, Y2), X))

Lemma 265: T(X, rdiv(T(Y, Z), W)) = T(X, rdiv(Y, W)).
Proof:
  T(X, rdiv(T(Y, Z), W))
= { by lemma 83 R->L }
  T(X, rdiv(rdiv(T(Y, Z), W), K(Y, Z)))
= { by lemma 56 R->L }
  T(X, op(K(Z, Y), rdiv(T(Y, Z), W)))
= { by lemma 219 R->L }
  T(X, op(K(Z, Y), ldiv(W, T(Y, Z))))
= { by lemma 202 R->L }
  T(X, op(K(Z, Y), rdiv(ldiv(W, Y), K(Z, Y)))) (peak)
= { by lemma 260 }
  T(X, ldiv(W, Y))
= { by lemma 102 }
  T(X, rdiv(Y, W))

Lemma 266: T(X, rdiv(L(Y, U, T), V)) = T(X, rdiv(L(Y, Z, W), V)).
Proof:
  T(X, rdiv(L(Y, U, T), V)) (peak)
= { by lemma 223 }
  T(X, rdiv(Y, V))
= { by lemma 102 R->L }
  T(X, ldiv(V, Y))
= { by lemma 222 R->L }
  T(X, rdiv(ldiv(V, L(Y, Z, W)), rdiv(L(Y, Z, W), Y))) (peak)
= { by lemma 220 }
  T(X, ldiv(V, L(Y, Z, W)))
= { by lemma 102 }
  T(X, rdiv(L(Y, Z, W), V))

Lemma 267: T(X, rdiv(L(Y, Z, W), L(L(Y, V, U), T, S))) = X.
Proof:
  T(X, rdiv(L(Y, Z, W), L(L(Y, V, U), T, S))) (peak)
= { by lemma 266 }
  T(X, rdiv(L(Y, V, U), L(L(Y, V, U), T, S))) (peak)
= { by lemma 224 }
  X

Lemma 268: T(X, rdiv(L(L(Y, Z, W), V, U), L(L(Y, T, S), X2, Y2))) = X.
Proof:
  T(X, rdiv(L(L(Y, Z, W), V, U), L(L(Y, T, S), X2, Y2)))
= { by lemma 261 R->L }
  T(X, rdiv(L(L(Y, Z, W), V, U), T(L(L(Y, T, S), X2, Y2), L(Y, Z, W)))) (peak)
= { by lemma 223 }
  T(X, rdiv(L(Y, Z, W), T(L(L(Y, T, S), X2, Y2), L(Y, Z, W))))
= { by lemma 264 R->L }
  T(X, rdiv(T(L(Y, Z, W), L(L(Y, Z2, W2), V2, U2)), L(L(Y, T, S), X2, Y2))) (peak)
= { by lemma 265 }
  T(X, rdiv(L(Y, Z, W), L(L(Y, T, S), X2, Y2)))
= { by lemma 267 }
  X

Lemma 269: op(rdiv(L(L(Y, Z, W), V, U), L(L(Y, T, S), X2, Y2)), X) = op(X, rdiv(L(L(Y, Z, W), V, U), L(L(Y, T, S), X2, Y2))).
Proof:
  op(rdiv(L(L(Y, Z, W), V, U), L(L(Y, T, S), X2, Y2)), X)
= { by lemma 268 R->L }
  op(rdiv(L(L(Y, Z, W), V, U), L(L(Y, T, S), X2, Y2)), T(X, rdiv(L(L(Y, Z, W), V, U), L(L(Y, T, S), X2, Y2)))) (peak)
= { by lemma 58 }
  op(X, rdiv(L(L(Y, Z, W), V, U), L(L(Y, T, S), X2, Y2)))

Lemma 270: ldiv(X, op(L(X, Y, Z), W)) = rdiv(W, rdiv(X, L(X, Y, Z))).
Proof:
  ldiv(X, op(L(X, Y, Z), W))
= { by lemma 110 R->L }
  ldiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), op(L(X, Y, Z), W))
= { by lemma 75 }
  L(ldiv(a(Z, Y, L(X, Y, Z)), W), a(Z, Y, L(X, Y, Z)), L(X, Y, Z)) (peak)
= { by lemma 117 }
  ldiv(a(Z, Y, L(X, Y, Z)), W)
= { by lemma 113 }
  rdiv(W, a(Z, Y, L(X, Y, Z)))
= { by lemma 111 }
  rdiv(W, rdiv(X, L(X, Y, Z)))

Lemma 271: ldiv(L(X, Y, Z), L(L(X, W, V), U, T)) = rdiv(L(L(X, W, V), U, T), L(X, Y, Z)).
Proof:
  ldiv(L(X, Y, Z), L(L(X, W, V), U, T))
= { by axiom 9 (sos) R->L }
  ldiv(L(X, Y, Z), op(rdiv(L(L(X, W, V), U, T), L(L(X, Y, Z), S, X2)), L(L(X, Y, Z), S, X2))) (peak)
= { by lemma 269 }
  ldiv(L(X, Y, Z), op(L(L(X, Y, Z), S, X2), rdiv(L(L(X, W, V), U, T), L(L(X, Y, Z), S, X2))))
= { by lemma 270 }
  rdiv(rdiv(L(L(X, W, V), U, T), L(L(X, Y, Z), S, X2)), rdiv(L(X, Y, Z), L(L(X, Y, Z), S, X2)))
= { by lemma 256 }
  rdiv(L(L(X, W, V), U, T), L(X, Y, Z))

Lemma 272: rdiv(L(L(X, Y, Z), W, V), rdiv(L(X, Y, Z), X)) = L(X, W, V).
Proof:
  rdiv(L(L(X, Y, Z), W, V), rdiv(L(X, Y, Z), X))
= { by lemma 214 R->L }
  op(L(L(X, Y, Z), W, V), rdiv(X, L(X, Y, Z))) (peak)
= { by lemma 154 }
  op(L(L(X, Y, Z), W, V), a(Z, Y, X))
= { by lemma 149 }
  L(op(L(X, Y, Z), a(Z, Y, X)), W, V)
= { by lemma 153 }
  L(X, W, V)

Lemma 273: rdiv(L(L(X, Y, Z), W, V), L(X, W, V)) = rdiv(L(X, Y, Z), X).
Proof:
  rdiv(L(L(X, Y, Z), W, V), L(X, W, V))
= { by lemma 271 R->L }
  ldiv(L(X, W, V), L(L(X, Y, Z), W, V))
= { by lemma 272 R->L }
  ldiv(rdiv(L(L(X, Y, Z), W, V), rdiv(L(X, Y, Z), X)), L(L(X, Y, Z), W, V)) (peak)
= { by lemma 39 }
  rdiv(L(X, Y, Z), X)

Lemma 274: L(ldiv(X, Y), X, rdiv(Z, X)) = ldiv(Z, op(rdiv(Z, X), Y)).
Proof:
  L(ldiv(X, Y), X, rdiv(Z, X))
= { by lemma 75 R->L }
  ldiv(op(rdiv(Z, X), X), op(rdiv(Z, X), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(Z, op(rdiv(Z, X), Y))

Lemma 275: L(ldiv(X, zero), X, rdiv(Y, X)) = ldiv(Y, rdiv(Y, X)).
Proof:
  L(ldiv(X, zero), X, rdiv(Y, X)) (peak)
= { by lemma 274 }
  ldiv(Y, op(rdiv(Y, X), zero)) (peak)
= { by axiom 1 (sos) }
  ldiv(Y, rdiv(Y, X))

Lemma 276: ldiv(rdiv(X, L(Y, Z, W)), rdiv(X, Y)) = rdiv(L(Y, Z, W), Y).
Proof:
  ldiv(rdiv(X, L(Y, Z, W)), rdiv(X, Y))
= { by lemma 256 R->L }
  ldiv(rdiv(X, L(Y, Z, W)), rdiv(rdiv(X, L(Y, Z, W)), rdiv(Y, L(Y, Z, W)))) (peak)
= { by lemma 275 R->L }
  L(ldiv(rdiv(Y, L(Y, Z, W)), zero), rdiv(Y, L(Y, Z, W)), rdiv(rdiv(X, L(Y, Z, W)), rdiv(Y, L(Y, Z, W)))) (peak)
= { by lemma 140 }
  ldiv(rdiv(Y, L(Y, Z, W)), zero)
= { by lemma 213 }
  rdiv(zero, rdiv(Y, L(Y, Z, W)))
= { by lemma 119 }
  ldiv(Y, L(Y, Z, W))
= { by lemma 142 }
  rdiv(L(Y, Z, W), Y)

Lemma 277: rdiv(L(L(X, W, V), Y, Z), L(X, W, V)) = rdiv(L(X, Y, Z), X).
Proof:
  rdiv(L(L(X, W, V), Y, Z), L(X, W, V))
= { by lemma 258 R->L }
  rdiv(rdiv(L(L(X, W, V), Y, Z), L(X, Y, Z)), rdiv(L(X, W, V), L(X, Y, Z)))
= { by lemma 259 R->L }
  ldiv(rdiv(L(X, W, V), L(X, Y, Z)), rdiv(L(L(X, W, V), Y, Z), L(X, Y, Z))) (peak)
= { by lemma 273 }
  ldiv(rdiv(L(X, W, V), L(X, Y, Z)), rdiv(L(X, W, V), X))
= { by lemma 276 }
  rdiv(L(X, Y, Z), X)

Lemma 278: rdiv(L(L(X, Y, Z), W, V), rdiv(L(L(X, U, T), Y, Z), L(X, U, T))) = L(X, W, V).
Proof:
  rdiv(L(L(X, Y, Z), W, V), rdiv(L(L(X, U, T), Y, Z), L(X, U, T))) (peak)
= { by lemma 277 }
  rdiv(L(L(X, Y, Z), W, V), rdiv(L(X, Y, Z), X))
= { by lemma 214 R->L }
  op(L(L(X, Y, Z), W, V), rdiv(X, L(X, Y, Z)))
= { by lemma 154 }
  op(L(L(X, Y, Z), W, V), a(Z, Y, X))
= { by lemma 149 }
  L(op(L(X, Y, Z), a(Z, Y, X)), W, V)
= { by lemma 153 }
  L(X, W, V)

Lemma 279: L(L(X, W, V), Y, Z) = L(L(X, Y, Z), W, V).
Proof:
  L(L(X, W, V), Y, Z)
= { by lemma 207 R->L }
  op(L(X, W, V), rdiv(L(L(X, W, V), Y, Z), L(X, W, V)))
= { by lemma 278 R->L }
  op(rdiv(L(L(X, Y, Z), W, V), rdiv(L(L(X, W, V), Y, Z), L(X, W, V))), rdiv(L(L(X, W, V), Y, Z), L(X, W, V))) (peak)
= { by axiom 9 (sos) }
  L(L(X, Y, Z), W, V)

Goal 1 (goals): L(L(x16, x17, x18), x19, x20) = L(L(x16, x19, x20), x17, x18).
Proof:
  L(L(x16, x17, x18), x19, x20)
= { by lemma 279 }
  L(L(x16, x19, x20), x17, x18) (peak)

RESULT: Theorem (the conjecture is true).
