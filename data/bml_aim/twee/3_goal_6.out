The conjecture is true! Here is a proof.

Axiom 1 (sos): op(X, zero) = X.
Axiom 2 (sos): op(zero, X) = X.
Axiom 3 (sos): rdiv(op(X, Y), Y) = X.
Axiom 4 (sos): ldiv(X, op(X, Y)) = Y.
Axiom 5 (sos): T(X, Y) = ldiv(Y, op(X, Y)).
Axiom 6 (sos): K(X, K(Y, Z)) = 1.
Axiom 7 (sos): K(K(X, Y), Z) = 1.
Axiom 8 (sos): op(X, ldiv(X, Y)) = Y.
Axiom 9 (sos): op(rdiv(X, Y), Y) = X.
Axiom 10 (sos): K(X, a(Y, Z, W)) = 1.
Axiom 11 (sos): K(a(X, Y, Z), W) = 1.
Axiom 12 (sos): a(X, K(Y, Z), W) = 1.
Axiom 13 (sos): a(K(X, Y), Z, W) = 1.
Axiom 14 (sos): a(X, Y, a(Z, W, V)) = 1.
Axiom 15 (sos): a(X, a(Y, Z, W), V) = 1.
Axiom 16 (sos): a(a(X, Y, Z), W, V) = 1.
Axiom 17 (sos): op(X, Y) = op(op(Y, X), K(X, Y)).
Axiom 18 (sos): R(X, Y, Z) = rdiv(op(op(X, Y), Z), op(Y, Z)).
Axiom 19 (sos): L(X, Y, Z) = ldiv(op(Z, Y), op(Z, op(Y, X))).
Axiom 20 (sos): op(op(X, Y), Z) = op(op(X, op(Y, Z)), a(X, Y, Z)).

Lemma 21: op(X, K(zero, X)) = X.
Proof:
  op(X, K(zero, X))
= { by axiom 1 (sos) R->L }
  op(op(X, zero), K(zero, X)) (peak)
= { by axiom 17 (sos) R->L }
  op(zero, X)
= { by axiom 2 (sos) }
  X

Lemma 22: ldiv(X, X) = zero.
Proof:
  ldiv(X, X)
= { by axiom 1 (sos) R->L }
  ldiv(X, op(X, zero)) (peak)
= { by axiom 4 (sos) }
  zero

Lemma 23: K(zero, X) = zero.
Proof:
  K(zero, X)
= { by axiom 4 (sos) R->L }
  ldiv(X, op(X, K(zero, X))) (peak)
= { by lemma 21 }
  ldiv(X, X)
= { by lemma 22 }
  zero

Lemma 24: 1 = zero.
Proof:
  1
= { by axiom 6 (sos) R->L }
  K(zero, K(X, Y)) (peak)
= { by lemma 23 }
  zero

Lemma 25: ldiv(zero, X) = X.
Proof:
  ldiv(zero, X)
= { by axiom 2 (sos) R->L }
  ldiv(zero, op(zero, X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 26: rdiv(X, X) = zero.
Proof:
  rdiv(X, X)
= { by axiom 2 (sos) R->L }
  rdiv(op(zero, X), X) (peak)
= { by axiom 3 (sos) }
  zero

Lemma 27: rdiv(X, zero) = X.
Proof:
  rdiv(X, zero)
= { by axiom 1 (sos) R->L }
  rdiv(op(X, zero), zero) (peak)
= { by axiom 3 (sos) }
  X

Lemma 28: T(X, X) = X.
Proof:
  T(X, X)
= { by axiom 5 (sos) }
  ldiv(X, op(X, X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 29: L(X, zero, Y) = X.
Proof:
  L(X, zero, Y)
= { by axiom 19 (sos) }
  ldiv(op(Y, zero), op(Y, op(zero, X))) (peak)
= { by axiom 1 (sos) }
  ldiv(Y, op(Y, op(zero, X)))
= { by axiom 4 (sos) }
  op(zero, X)
= { by axiom 2 (sos) }
  X

Lemma 30: ldiv(rdiv(X, Y), X) = Y.
Proof:
  ldiv(rdiv(X, Y), X)
= { by axiom 9 (sos) R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), Y)) (peak)
= { by axiom 4 (sos) }
  Y

Lemma 31: op(X, K(ldiv(Y, X), Y)) = op(ldiv(Y, X), Y).
Proof:
  op(X, K(ldiv(Y, X), Y))
= { by axiom 8 (sos) R->L }
  op(op(Y, ldiv(Y, X)), K(ldiv(Y, X), Y)) (peak)
= { by axiom 17 (sos) R->L }
  op(ldiv(Y, X), Y)

Lemma 32: op(ldiv(X, zero), X) = K(ldiv(X, zero), X).
Proof:
  op(ldiv(X, zero), X)
= { by lemma 31 R->L }
  op(zero, K(ldiv(X, zero), X)) (peak)
= { by axiom 2 (sos) }
  K(ldiv(X, zero), X)

Lemma 33: op(X, rdiv(zero, X)) = K(X, rdiv(zero, X)).
Proof:
  op(X, rdiv(zero, X))
= { by lemma 30 R->L }
  op(ldiv(rdiv(zero, X), zero), rdiv(zero, X)) (peak)
= { by lemma 32 }
  K(ldiv(rdiv(zero, X), zero), rdiv(zero, X))
= { by lemma 30 }
  K(X, rdiv(zero, X))

Lemma 34: rdiv(op(X, Y), K(X, Y)) = op(Y, X).
Proof:
  rdiv(op(X, Y), K(X, Y))
= { by axiom 17 (sos) }
  rdiv(op(op(Y, X), K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  op(Y, X)

Lemma 35: op(K(X, Y), Z) = op(Z, K(X, Y)).
Proof:
  op(K(X, Y), Z)
= { by lemma 34 R->L }
  rdiv(op(Z, K(X, Y)), K(Z, K(X, Y))) (peak)
= { by axiom 6 (sos) }
  rdiv(op(Z, K(X, Y)), 1)
= { by lemma 24 }
  rdiv(op(Z, K(X, Y)), zero)
= { by lemma 27 }
  op(Z, K(X, Y))

Lemma 36: op(op(X, K(Y, Z)), W) = op(K(Y, Z), op(X, W)).
Proof:
  op(op(X, K(Y, Z)), W) (peak)
= { by lemma 35 R->L }
  op(op(K(Y, Z), X), W)
= { by axiom 20 (sos) }
  op(op(K(Y, Z), op(X, W)), a(K(Y, Z), X, W)) (peak)
= { by lemma 35 }
  op(op(op(X, W), K(Y, Z)), a(K(Y, Z), X, W)) (peak)
= { by axiom 13 (sos) }
  op(op(op(X, W), K(Y, Z)), 1)
= { by lemma 24 }
  op(op(op(X, W), K(Y, Z)), zero)
= { by axiom 1 (sos) }
  op(op(X, W), K(Y, Z))
= { by lemma 35 R->L }
  op(K(Y, Z), op(X, W))

Lemma 37: op(K(X, Y), op(Z, W)) = op(Z, op(W, K(X, Y))).
Proof:
  op(K(X, Y), op(Z, W))
= { by lemma 36 R->L }
  op(op(Z, K(X, Y)), W)
= { by axiom 20 (sos) }
  op(op(Z, op(K(X, Y), W)), a(Z, K(X, Y), W)) (peak)
= { by lemma 35 }
  op(op(Z, op(W, K(X, Y))), a(Z, K(X, Y), W)) (peak)
= { by axiom 12 (sos) }
  op(op(Z, op(W, K(X, Y))), 1)
= { by lemma 24 }
  op(op(Z, op(W, K(X, Y))), zero)
= { by axiom 1 (sos) }
  op(Z, op(W, K(X, Y)))

Lemma 38: op(K(X, Y), op(Y, X)) = op(X, Y).
Proof:
  op(K(X, Y), op(Y, X))
= { by axiom 17 (sos) }
  op(op(op(Y, X), K(X, Y)), K(K(X, Y), op(Y, X))) (peak)
= { by axiom 17 (sos) R->L }
  op(op(X, Y), K(K(X, Y), op(Y, X)))
= { by axiom 7 (sos) }
  op(op(X, Y), 1)
= { by lemma 24 }
  op(op(X, Y), zero)
= { by axiom 1 (sos) }
  op(X, Y)

Lemma 39: op(X, op(Y, K(Y, X))) = op(Y, X).
Proof:
  op(X, op(Y, K(Y, X)))
= { by lemma 37 R->L }
  op(K(Y, X), op(X, Y)) (peak)
= { by lemma 38 }
  op(Y, X)

Lemma 40: op(X, K(X, Y)) = T(X, Y).
Proof:
  op(X, K(X, Y))
= { by axiom 4 (sos) R->L }
  ldiv(Y, op(Y, op(X, K(X, Y)))) (peak)
= { by lemma 39 }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 41: op(op(X, K(Y, X)), Y) = op(Y, X).
Proof:
  op(op(X, K(Y, X)), Y)
= { by lemma 35 R->L }
  op(op(K(Y, X), X), Y)
= { by axiom 20 (sos) }
  op(op(K(Y, X), op(X, Y)), a(K(Y, X), X, Y)) (peak)
= { by lemma 38 }
  op(op(Y, X), a(K(Y, X), X, Y))
= { by axiom 13 (sos) }
  op(op(Y, X), 1)
= { by lemma 24 }
  op(op(Y, X), zero)
= { by axiom 1 (sos) }
  op(Y, X)

Lemma 42: op(X, K(Y, X)) = rdiv(op(Y, X), Y).
Proof:
  op(X, K(Y, X))
= { by axiom 3 (sos) R->L }
  rdiv(op(op(X, K(Y, X)), Y), Y) (peak)
= { by lemma 41 }
  rdiv(op(Y, X), Y)

Lemma 43: rdiv(op(X, Z), op(Y, Z)) = R(rdiv(X, Y), Y, Z).
Proof:
  rdiv(op(X, Z), op(Y, Z))
= { by axiom 9 (sos) R->L }
  rdiv(op(op(rdiv(X, Y), Y), Z), op(Y, Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(rdiv(X, Y), Y, Z)

Lemma 44: R(rdiv(zero, X), X, Y) = rdiv(Y, op(X, Y)).
Proof:
  R(rdiv(zero, X), X, Y) (peak)
= { by lemma 43 R->L }
  rdiv(op(zero, Y), op(X, Y)) (peak)
= { by axiom 2 (sos) }
  rdiv(Y, op(X, Y))

Lemma 45: ldiv(R(rdiv(zero, X), X, Y), Y) = op(X, Y).
Proof:
  ldiv(R(rdiv(zero, X), X, Y), Y) (peak)
= { by lemma 44 }
  ldiv(rdiv(Y, op(X, Y)), Y) (peak)
= { by lemma 30 }
  op(X, Y)

Lemma 46: op(X, K(Y, rdiv(X, Y))) = op(Y, rdiv(X, Y)).
Proof:
  op(X, K(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  op(op(rdiv(X, Y), Y), K(Y, rdiv(X, Y))) (peak)
= { by axiom 17 (sos) R->L }
  op(Y, rdiv(X, Y))

Lemma 47: op(K(X, Y), rdiv(Z, K(X, Y))) = Z.
Proof:
  op(K(X, Y), rdiv(Z, K(X, Y)))
= { by lemma 46 R->L }
  op(Z, K(K(X, Y), rdiv(Z, K(X, Y)))) (peak)
= { by axiom 7 (sos) }
  op(Z, 1)
= { by lemma 24 }
  op(Z, zero)
= { by axiom 1 (sos) }
  Z

Lemma 48: T(rdiv(X, Y), Y) = ldiv(Y, X).
Proof:
  T(rdiv(X, Y), Y)
= { by axiom 5 (sos) }
  ldiv(Y, op(rdiv(X, Y), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(Y, X)

Lemma 49: T(X, K(Y, Z)) = X.
Proof:
  T(X, K(Y, Z))
= { by axiom 5 (sos) }
  ldiv(K(Y, Z), op(X, K(Y, Z))) (peak)
= { by lemma 35 R->L }
  ldiv(K(Y, Z), op(K(Y, Z), X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 50: ldiv(K(X, Y), Z) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(K(X, Y), Z)
= { by lemma 48 R->L }
  T(rdiv(Z, K(X, Y)), K(X, Y)) (peak)
= { by lemma 49 }
  rdiv(Z, K(X, Y))

Lemma 51: rdiv(op(op(X, Y), ldiv(Y, Z)), Z) = R(X, Y, ldiv(Y, Z)).
Proof:
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z)
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, Y), ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 18 (sos) R->L }
  R(X, Y, ldiv(Y, Z))

Lemma 52: op(op(K(X, Y), Z), W) = op(Z, op(W, K(X, Y))).
Proof:
  op(op(K(X, Y), Z), W) (peak)
= { by lemma 35 }
  op(op(Z, K(X, Y)), W) (peak)
= { by lemma 36 }
  op(K(X, Y), op(Z, W))
= { by lemma 37 }
  op(Z, op(W, K(X, Y)))

Lemma 53: R(X, K(Y, Z), rdiv(W, K(Y, Z))) = X.
Proof:
  R(X, K(Y, Z), rdiv(W, K(Y, Z)))
= { by lemma 50 R->L }
  R(X, K(Y, Z), ldiv(K(Y, Z), W))
= { by lemma 51 R->L }
  rdiv(op(op(X, K(Y, Z)), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 35 R->L }
  rdiv(op(op(K(Y, Z), X), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 52 }
  rdiv(op(X, op(ldiv(K(Y, Z), W), K(Y, Z))), W)
= { by lemma 50 }
  rdiv(op(X, op(rdiv(W, K(Y, Z)), K(Y, Z))), W)
= { by axiom 9 (sos) }
  rdiv(op(X, W), W)
= { by axiom 3 (sos) }
  X

Lemma 54: rdiv(rdiv(X, K(Y, Z)), X) = rdiv(zero, K(Y, Z)).
Proof:
  rdiv(rdiv(X, K(Y, Z)), X)
= { by lemma 47 R->L }
  rdiv(rdiv(X, K(Y, Z)), op(K(Y, Z), rdiv(X, K(Y, Z)))) (peak)
= { by lemma 44 R->L }
  R(rdiv(zero, K(Y, Z)), K(Y, Z), rdiv(X, K(Y, Z)))
= { by lemma 53 }
  rdiv(zero, K(Y, Z))

Lemma 55: rdiv(op(X, Y), op(Y, X)) = K(X, Y).
Proof:
  rdiv(op(X, Y), op(Y, X))
= { by lemma 38 R->L }
  rdiv(op(K(X, Y), op(Y, X)), op(Y, X)) (peak)
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 56: rdiv(zero, K(X, Y)) = K(Y, X).
Proof:
  rdiv(zero, K(X, Y))
= { by lemma 54 R->L }
  rdiv(rdiv(op(X, Y), K(X, Y)), op(X, Y)) (peak)
= { by lemma 34 }
  rdiv(op(Y, X), op(X, Y))
= { by lemma 55 }
  K(Y, X)

Lemma 57: rdiv(op(X, K(Y, Z)), X) = K(Y, Z).
Proof:
  rdiv(op(X, K(Y, Z)), X) (peak)
= { by lemma 35 R->L }
  rdiv(op(K(Y, Z), X), X) (peak)
= { by axiom 3 (sos) }
  K(Y, Z)

Lemma 58: R(rdiv(X, Y), Y, ldiv(Y, Z)) = rdiv(op(X, ldiv(Y, Z)), Z).
Proof:
  R(rdiv(X, Y), Y, ldiv(Y, Z))
= { by lemma 43 R->L }
  rdiv(op(X, ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 8 (sos) }
  rdiv(op(X, ldiv(Y, Z)), Z)

Lemma 59: R(K(X, Y), Z, ldiv(Z, W)) = K(X, Y).
Proof:
  R(K(X, Y), Z, ldiv(Z, W))
= { by lemma 57 R->L }
  R(rdiv(op(Z, K(X, Y)), Z), Z, ldiv(Z, W)) (peak)
= { by lemma 58 }
  rdiv(op(op(Z, K(X, Y)), ldiv(Z, W)), W) (peak)
= { by lemma 36 }
  rdiv(op(K(X, Y), op(Z, ldiv(Z, W))), W)
= { by axiom 8 (sos) }
  rdiv(op(K(X, Y), W), W)
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 60: R(K(X, Y), Z, W) = K(X, Y).
Proof:
  R(K(X, Y), Z, W)
= { by axiom 4 (sos) R->L }
  R(K(X, Y), Z, ldiv(Z, op(Z, W))) (peak)
= { by lemma 59 }
  K(X, Y)

Lemma 61: op(K(X, Y), Z) = rdiv(Z, K(Y, X)).
Proof:
  op(K(X, Y), Z)
= { by lemma 45 R->L }
  ldiv(R(rdiv(zero, K(X, Y)), K(X, Y), Z), Z) (peak)
= { by lemma 56 }
  ldiv(R(K(Y, X), K(X, Y), Z), Z)
= { by lemma 60 }
  ldiv(K(Y, X), Z)
= { by lemma 50 }
  rdiv(Z, K(Y, X))

Lemma 62: op(X, K(Y, Z)) = rdiv(X, K(Z, Y)).
Proof:
  op(X, K(Y, Z))
= { by axiom 17 (sos) }
  op(op(K(Y, Z), X), K(X, K(Y, Z))) (peak)
= { by lemma 61 }
  op(rdiv(X, K(Z, Y)), K(X, K(Y, Z)))
= { by axiom 6 (sos) }
  op(rdiv(X, K(Z, Y)), 1)
= { by lemma 24 }
  op(rdiv(X, K(Z, Y)), zero)
= { by axiom 1 (sos) }
  rdiv(X, K(Z, Y))

Lemma 63: op(X, T(Y, X)) = op(Y, X).
Proof:
  op(X, T(Y, X))
= { by axiom 5 (sos) }
  op(X, ldiv(X, op(Y, X))) (peak)
= { by axiom 8 (sos) }
  op(Y, X)

Lemma 64: op(K(X, Y), X) = T(X, Y).
Proof:
  op(K(X, Y), X)
= { by axiom 17 (sos) }
  op(op(X, K(X, Y)), K(K(X, Y), X)) (peak)
= { by lemma 40 }
  op(T(X, Y), K(K(X, Y), X))
= { by axiom 7 (sos) }
  op(T(X, Y), 1)
= { by lemma 24 }
  op(T(X, Y), zero)
= { by axiom 1 (sos) }
  T(X, Y)

Lemma 65: op(K(X, Y), Y) = rdiv(op(X, Y), X).
Proof:
  op(K(X, Y), Y)
= { by axiom 17 (sos) }
  op(op(Y, K(X, Y)), K(K(X, Y), Y)) (peak)
= { by lemma 42 }
  op(rdiv(op(X, Y), X), K(K(X, Y), Y)) (peak)
= { by axiom 7 (sos) }
  op(rdiv(op(X, Y), X), 1)
= { by lemma 24 }
  op(rdiv(op(X, Y), X), zero)
= { by axiom 1 (sos) }
  rdiv(op(X, Y), X)

Lemma 66: ldiv(X, T(X, Y)) = K(X, Y).
Proof:
  ldiv(X, T(X, Y))
= { by lemma 40 R->L }
  ldiv(X, op(X, K(X, Y))) (peak)
= { by axiom 4 (sos) }
  K(X, Y)

Lemma 67: ldiv(ldiv(X, Y), Y) = T(X, ldiv(X, Y)).
Proof:
  ldiv(ldiv(X, Y), Y)
= { by axiom 8 (sos) R->L }
  ldiv(ldiv(X, Y), op(X, ldiv(X, Y))) (peak)
= { by axiom 5 (sos) R->L }
  T(X, ldiv(X, Y))

Lemma 68: ldiv(op(Z, X), op(Z, Y)) = L(ldiv(X, Y), X, Z).
Proof:
  ldiv(op(Z, X), op(Z, Y))
= { by axiom 8 (sos) R->L }
  ldiv(op(Z, X), op(Z, op(X, ldiv(X, Y)))) (peak)
= { by axiom 19 (sos) R->L }
  L(ldiv(X, Y), X, Z)

Lemma 69: ldiv(op(X, Y), op(X, op(Z, Y))) = L(T(Z, Y), Y, X).
Proof:
  ldiv(op(X, Y), op(X, op(Z, Y))) (peak)
= { by lemma 68 }
  L(ldiv(Y, op(Z, Y)), Y, X) (peak)
= { by axiom 5 (sos) R->L }
  L(T(Z, Y), Y, X)

Lemma 70: op(op(X, Y), K(Z, W)) = op(X, op(Y, K(Z, W))).
Proof:
  op(op(X, Y), K(Z, W)) (peak)
= { by lemma 35 R->L }
  op(K(Z, W), op(X, Y)) (peak)
= { by lemma 37 }
  op(X, op(Y, K(Z, W))) (peak)

Lemma 71: L(T(X, Y), Y, K(Z, W)) = T(X, rdiv(Y, K(W, Z))).
Proof:
  L(T(X, Y), Y, K(Z, W))
= { by lemma 69 R->L }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(X, Y))) (peak)
= { by lemma 35 }
  ldiv(op(K(Z, W), Y), op(op(X, Y), K(Z, W))) (peak)
= { by lemma 61 }
  ldiv(rdiv(Y, K(W, Z)), op(op(X, Y), K(Z, W)))
= { by lemma 70 }
  ldiv(rdiv(Y, K(W, Z)), op(X, op(Y, K(Z, W))))
= { by lemma 62 }
  ldiv(rdiv(Y, K(W, Z)), op(X, rdiv(Y, K(W, Z))))
= { by axiom 5 (sos) R->L }
  T(X, rdiv(Y, K(W, Z)))

Lemma 72: R(X, K(Y, Z), W) = X.
Proof:
  R(X, K(Y, Z), W)
= { by axiom 3 (sos) R->L }
  R(X, K(Y, Z), rdiv(op(W, K(Y, Z)), K(Y, Z))) (peak)
= { by lemma 53 }
  X

Lemma 73: ldiv(R(X, Y, Z), op(op(X, Y), Z)) = op(Y, Z).
Proof:
  ldiv(R(X, Y, Z), op(op(X, Y), Z))
= { by axiom 18 (sos) }
  ldiv(rdiv(op(op(X, Y), Z), op(Y, Z)), op(op(X, Y), Z)) (peak)
= { by lemma 30 }
  op(Y, Z)

Lemma 74: ldiv(op(X, Y), op(op(Y, X), Z)) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(op(X, Y), op(op(Y, X), Z))
= { by lemma 72 R->L }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(Y, X), Z))
= { by axiom 17 (sos) }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(op(X, Y), K(Y, X)), Z)) (peak)
= { by lemma 73 }
  op(K(Y, X), Z)
= { by lemma 61 }
  rdiv(Z, K(X, Y))

Lemma 75: L(X, Y, K(Z, W)) = X.
Proof:
  L(X, Y, K(Z, W))
= { by axiom 19 (sos) }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(Y, X)))
= { by lemma 36 R->L }
  ldiv(op(K(Z, W), Y), op(op(Y, K(Z, W)), X)) (peak)
= { by lemma 74 }
  rdiv(X, K(K(Z, W), Y))
= { by axiom 7 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 76: T(X, rdiv(Y, K(Z, W))) = T(X, Y).
Proof:
  T(X, rdiv(Y, K(Z, W)))
= { by lemma 71 R->L }
  L(T(X, Y), Y, K(W, Z)) (peak)
= { by lemma 75 }
  T(X, Y)

Lemma 77: rdiv(T(X, Y), K(X, Y)) = X.
Proof:
  rdiv(T(X, Y), K(X, Y))
= { by lemma 40 R->L }
  rdiv(op(X, K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  X

Lemma 78: T(X, T(Y, Z)) = T(X, Y).
Proof:
  T(X, T(Y, Z))
= { by lemma 76 R->L }
  T(X, rdiv(T(Y, Z), K(Y, Z))) (peak)
= { by lemma 77 }
  T(X, Y)

Lemma 79: T(X, ldiv(Y, Z)) = T(X, rdiv(Z, Y)).
Proof:
  T(X, ldiv(Y, Z))
= { by lemma 48 R->L }
  T(X, T(rdiv(Z, Y), Y)) (peak)
= { by lemma 78 }
  T(X, rdiv(Z, Y))

Lemma 80: ldiv(ldiv(X, Y), Y) = T(X, rdiv(Y, X)).
Proof:
  ldiv(ldiv(X, Y), Y) (peak)
= { by lemma 67 }
  T(X, ldiv(X, Y)) (peak)
= { by lemma 79 }
  T(X, rdiv(Y, X))

Lemma 81: ldiv(X, rdiv(op(Y, X), Y)) = K(Y, X).
Proof:
  ldiv(X, rdiv(op(Y, X), Y)) (peak)
= { by lemma 42 R->L }
  ldiv(X, op(X, K(Y, X))) (peak)
= { by axiom 4 (sos) }
  K(Y, X)

Lemma 82: K(X, T(Y, X)) = ldiv(T(Y, X), Y).
Proof:
  K(X, T(Y, X))
= { by lemma 81 R->L }
  ldiv(T(Y, X), rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 63 }
  ldiv(T(Y, X), rdiv(op(Y, X), X))
= { by axiom 3 (sos) }
  ldiv(T(Y, X), Y)

Lemma 83: ldiv(op(X, Y), op(Y, X)) = K(Y, X).
Proof:
  ldiv(op(X, Y), op(Y, X))
= { by axiom 17 (sos) }
  ldiv(op(X, Y), op(op(X, Y), K(Y, X))) (peak)
= { by axiom 4 (sos) }
  K(Y, X)

Lemma 84: K(X, rdiv(op(X, Y), X)) = L(K(X, Y), Y, X).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 42 R->L }
  K(X, op(Y, K(X, Y)))
= { by lemma 83 R->L }
  ldiv(op(op(Y, K(X, Y)), X), op(X, op(Y, K(X, Y)))) (peak)
= { by lemma 41 }
  ldiv(op(X, Y), op(X, op(Y, K(X, Y))))
= { by axiom 19 (sos) R->L }
  L(K(X, Y), Y, X)

Lemma 85: T(K(X, Y), Z) = K(X, Y).
Proof:
  T(K(X, Y), Z)
= { by axiom 5 (sos) }
  ldiv(Z, op(K(X, Y), Z)) (peak)
= { by lemma 35 }
  ldiv(Z, op(Z, K(X, Y))) (peak)
= { by axiom 4 (sos) }
  K(X, Y)

Lemma 86: L(K(X, Y), Z, W) = K(X, Y).
Proof:
  L(K(X, Y), Z, W)
= { by axiom 19 (sos) }
  ldiv(op(W, Z), op(W, op(Z, K(X, Y)))) (peak)
= { by lemma 37 R->L }
  ldiv(op(W, Z), op(K(X, Y), op(W, Z))) (peak)
= { by axiom 5 (sos) R->L }
  T(K(X, Y), op(W, Z))
= { by lemma 85 }
  K(X, Y)

Lemma 87: K(X, rdiv(op(X, Y), X)) = K(X, Y).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 84 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 86 }
  K(X, Y)

Lemma 88: K(X, T(Y, X)) = K(X, Y).
Proof:
  K(X, T(Y, X))
= { by lemma 87 R->L }
  K(X, rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 63 }
  K(X, rdiv(op(Y, X), X))
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 89: ldiv(T(X, Y), X) = K(Y, X).
Proof:
  ldiv(T(X, Y), X) (peak)
= { by lemma 82 R->L }
  K(Y, T(X, Y)) (peak)
= { by lemma 88 }
  K(Y, X)

Lemma 90: rdiv(X, ldiv(Y, X)) = Y.
Proof:
  rdiv(X, ldiv(Y, X))
= { by axiom 8 (sos) R->L }
  rdiv(op(Y, ldiv(Y, X)), ldiv(Y, X)) (peak)
= { by axiom 3 (sos) }
  Y

Lemma 91: rdiv(X, T(Y, ldiv(Y, X))) = ldiv(Y, X).
Proof:
  rdiv(X, T(Y, ldiv(Y, X))) (peak)
= { by lemma 67 R->L }
  rdiv(X, ldiv(ldiv(Y, X), X)) (peak)
= { by lemma 90 }
  ldiv(Y, X)

Lemma 92: ldiv(T(X, Y), X) = rdiv(X, T(X, Y)).
Proof:
  ldiv(T(X, Y), X)
= { by lemma 91 R->L }
  rdiv(X, T(T(X, Y), ldiv(T(X, Y), X))) (peak)
= { by lemma 82 R->L }
  rdiv(X, T(T(X, Y), K(Y, T(X, Y)))) (peak)
= { by lemma 49 }
  rdiv(X, T(X, Y))

Lemma 93: rdiv(X, K(Y, X)) = T(X, Y).
Proof:
  rdiv(X, K(Y, X))
= { by lemma 89 R->L }
  rdiv(X, ldiv(T(X, Y), X)) (peak)
= { by lemma 90 }
  T(X, Y)

Lemma 94: rdiv(op(X, Y), T(X, Y)) = Y.
Proof:
  rdiv(op(X, Y), T(X, Y))
= { by axiom 5 (sos) }
  rdiv(op(X, Y), ldiv(Y, op(X, Y))) (peak)
= { by lemma 90 }
  Y

Lemma 95: rdiv(rdiv(op(X, Y), X), Y) = K(X, Y).
Proof:
  rdiv(rdiv(op(X, Y), X), Y)
= { by lemma 49 R->L }
  rdiv(rdiv(op(X, Y), X), T(Y, K(X, Y))) (peak)
= { by lemma 42 R->L }
  rdiv(op(Y, K(X, Y)), T(Y, K(X, Y))) (peak)
= { by lemma 94 }
  K(X, Y)

Lemma 96: K(X, T(Y, X)) = rdiv(Y, T(Y, X)).
Proof:
  K(X, T(Y, X))
= { by lemma 95 R->L }
  rdiv(rdiv(op(X, T(Y, X)), X), T(Y, X)) (peak)
= { by lemma 63 }
  rdiv(rdiv(op(Y, X), X), T(Y, X))
= { by axiom 3 (sos) }
  rdiv(Y, T(Y, X))

Lemma 97: rdiv(X, T(X, Y)) = K(Y, X).
Proof:
  rdiv(X, T(X, Y)) (peak)
= { by lemma 96 R->L }
  K(Y, T(X, Y)) (peak)
= { by lemma 88 }
  K(Y, X)

Lemma 98: rdiv(op(X, Y), X) = rdiv(Y, K(Y, X)).
Proof:
  rdiv(op(X, Y), X) (peak)
= { by lemma 65 R->L }
  op(K(X, Y), Y) (peak)
= { by lemma 61 }
  rdiv(Y, K(Y, X))

Lemma 99: op(X, rdiv(Y, K(Y, X))) = op(T(X, Y), Y).
Proof:
  op(X, rdiv(Y, K(Y, X)))
= { by lemma 88 R->L }
  op(X, rdiv(Y, K(Y, T(X, Y))))
= { by lemma 62 R->L }
  op(X, op(Y, K(T(X, Y), Y)))
= { by lemma 70 R->L }
  op(op(X, Y), K(T(X, Y), Y))
= { by lemma 63 R->L }
  op(op(Y, T(X, Y)), K(T(X, Y), Y)) (peak)
= { by axiom 17 (sos) R->L }
  op(T(X, Y), Y)

Lemma 100: rdiv(op(op(X, rdiv(Y, Z)), Z), Y) = R(X, rdiv(Y, Z), Z).
Proof:
  rdiv(op(op(X, rdiv(Y, Z)), Z), Y)
= { by axiom 9 (sos) R->L }
  rdiv(op(op(X, rdiv(Y, Z)), Z), op(rdiv(Y, Z), Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(X, rdiv(Y, Z), Z)

Lemma 101: R(X, Y, K(Z, W)) = X.
Proof:
  R(X, Y, K(Z, W))
= { by axiom 18 (sos) }
  rdiv(op(op(X, Y), K(Z, W)), op(Y, K(Z, W))) (peak)
= { by lemma 70 }
  rdiv(op(X, op(Y, K(Z, W))), op(Y, K(Z, W)))
= { by axiom 3 (sos) }
  X

Lemma 102: rdiv(op(T(X, Y), T(Y, X)), Y) = X.
Proof:
  rdiv(op(T(X, Y), T(Y, X)), Y)
= { by lemma 40 R->L }
  rdiv(op(T(X, Y), op(Y, K(Y, X))), Y)
= { by lemma 70 R->L }
  rdiv(op(op(T(X, Y), Y), K(Y, X)), Y)
= { by lemma 99 R->L }
  rdiv(op(op(X, rdiv(Y, K(Y, X))), K(Y, X)), Y) (peak)
= { by lemma 100 }
  R(X, rdiv(Y, K(Y, X)), K(Y, X))
= { by lemma 101 }
  X

Lemma 103: op(T(X, Y), T(Y, X)) = op(X, Y).
Proof:
  op(T(X, Y), T(Y, X))
= { by axiom 9 (sos) R->L }
  op(rdiv(op(T(X, Y), T(Y, X)), Y), Y) (peak)
= { by lemma 102 }
  op(X, Y)

Lemma 104: K(X, rdiv(Y, K(Y, X))) = K(X, Y).
Proof:
  K(X, rdiv(Y, K(Y, X)))
= { by lemma 61 R->L }
  K(X, op(K(X, Y), Y)) (peak)
= { by lemma 65 }
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 84 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 86 }
  K(X, Y)

Lemma 105: op(rdiv(X, K(X, Y)), Y) = op(T(Y, X), T(X, Y)).
Proof:
  op(rdiv(X, K(X, Y)), Y)
= { by axiom 17 (sos) }
  op(op(Y, rdiv(X, K(X, Y))), K(rdiv(X, K(X, Y)), Y)) (peak)
= { by lemma 99 }
  op(op(T(Y, X), X), K(rdiv(X, K(X, Y)), Y))
= { by lemma 70 }
  op(T(Y, X), op(X, K(rdiv(X, K(X, Y)), Y)))
= { by lemma 62 }
  op(T(Y, X), rdiv(X, K(Y, rdiv(X, K(X, Y)))))
= { by lemma 104 }
  op(T(Y, X), rdiv(X, K(Y, X)))
= { by lemma 93 }
  op(T(Y, X), T(X, Y))

Lemma 106: op(X, rdiv(Y, K(Z, W))) = rdiv(op(X, Y), K(Z, W)).
Proof:
  op(X, rdiv(Y, K(Z, W)))
= { by lemma 62 R->L }
  op(X, op(Y, K(W, Z)))
= { by lemma 52 R->L }
  op(op(K(W, Z), X), Y)
= { by lemma 103 R->L }
  op(op(T(K(W, Z), X), T(X, K(W, Z))), Y)
= { by lemma 105 R->L }
  op(op(rdiv(X, K(X, K(W, Z))), K(W, Z)), Y) (peak)
= { by lemma 36 }
  op(K(W, Z), op(rdiv(X, K(X, K(W, Z))), Y))
= { by lemma 61 }
  rdiv(op(rdiv(X, K(X, K(W, Z))), Y), K(Z, W))
= { by axiom 6 (sos) }
  rdiv(op(rdiv(X, 1), Y), K(Z, W))
= { by lemma 24 }
  rdiv(op(rdiv(X, zero), Y), K(Z, W))
= { by lemma 27 }
  rdiv(op(X, Y), K(Z, W))

Lemma 107: rdiv(op(op(X, Y), Z), a(X, Y, Z)) = op(X, op(Y, Z)).
Proof:
  rdiv(op(op(X, Y), Z), a(X, Y, Z))
= { by axiom 20 (sos) }
  rdiv(op(op(X, op(Y, Z)), a(X, Y, Z)), a(X, Y, Z)) (peak)
= { by axiom 3 (sos) }
  op(X, op(Y, Z))

Lemma 108: rdiv(op(op(X, Y), Z), K(X, Y)) = op(op(Y, X), Z).
Proof:
  rdiv(op(op(X, Y), Z), K(X, Y))
= { by lemma 106 R->L }
  op(op(X, Y), rdiv(Z, K(X, Y)))
= { by lemma 61 R->L }
  op(op(X, Y), op(K(Y, X), Z))
= { by lemma 107 R->L }
  rdiv(op(op(op(X, Y), K(Y, X)), Z), a(op(X, Y), K(Y, X), Z)) (peak)
= { by axiom 17 (sos) R->L }
  rdiv(op(op(Y, X), Z), a(op(X, Y), K(Y, X), Z))
= { by axiom 12 (sos) }
  rdiv(op(op(Y, X), Z), 1)
= { by lemma 24 }
  rdiv(op(op(Y, X), Z), zero)
= { by lemma 27 }
  op(op(Y, X), Z)

Lemma 109: rdiv(op(X, op(Y, Z)), K(Y, Z)) = op(X, op(Z, Y)).
Proof:
  rdiv(op(X, op(Y, Z)), K(Y, Z))
= { by lemma 61 R->L }
  op(K(Z, Y), op(X, op(Y, Z)))
= { by lemma 36 R->L }
  op(op(X, K(Z, Y)), op(Y, Z))
= { by axiom 20 (sos) }
  op(op(X, op(K(Z, Y), op(Y, Z))), a(X, K(Z, Y), op(Y, Z))) (peak)
= { by lemma 38 }
  op(op(X, op(Z, Y)), a(X, K(Z, Y), op(Y, Z)))
= { by axiom 12 (sos) }
  op(op(X, op(Z, Y)), 1)
= { by lemma 24 }
  op(op(X, op(Z, Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(Z, Y))

Lemma 110: op(op(X, Y), T(Z, op(Y, X))) = op(Z, op(X, Y)).
Proof:
  op(op(X, Y), T(Z, op(Y, X)))
= { by lemma 108 R->L }
  rdiv(op(op(Y, X), T(Z, op(Y, X))), K(Y, X)) (peak)
= { by lemma 63 }
  rdiv(op(Z, op(Y, X)), K(Y, X))
= { by lemma 109 }
  op(Z, op(X, Y))

Lemma 111: T(X, op(Y, Z)) = T(X, op(Z, Y)).
Proof:
  T(X, op(Y, Z))
= { by axiom 4 (sos) R->L }
  ldiv(op(Z, Y), op(op(Z, Y), T(X, op(Y, Z)))) (peak)
= { by lemma 110 }
  ldiv(op(Z, Y), op(X, op(Z, Y)))
= { by axiom 5 (sos) R->L }
  T(X, op(Z, Y))

Lemma 112: K(X, op(Z, Y)) = K(X, op(Y, Z)).
Proof:
  K(X, op(Z, Y))
= { by lemma 66 R->L }
  ldiv(X, T(X, op(Z, Y))) (peak)
= { by lemma 111 R->L }
  ldiv(X, T(X, op(Y, Z))) (peak)
= { by lemma 66 }
  K(X, op(Y, Z))

Lemma 113: K(X, ldiv(X, Y)) = K(X, rdiv(Y, X)).
Proof:
  K(X, ldiv(X, Y))
= { by lemma 87 R->L }
  K(X, rdiv(op(X, ldiv(X, Y)), X)) (peak)
= { by axiom 8 (sos) }
  K(X, rdiv(Y, X))

Lemma 114: K(X, T(Y, Z)) = K(X, Y).
Proof:
  K(X, T(Y, Z))
= { by lemma 66 R->L }
  ldiv(X, T(X, T(Y, Z))) (peak)
= { by lemma 78 }
  ldiv(X, T(X, Y))
= { by lemma 66 }
  K(X, Y)

Lemma 115: K(X, ldiv(Y, Z)) = K(X, rdiv(Z, Y)).
Proof:
  K(X, ldiv(Y, Z))
= { by lemma 48 R->L }
  K(X, T(rdiv(Z, Y), Y)) (peak)
= { by lemma 114 }
  K(X, rdiv(Z, Y))

Lemma 116: K(T(X, Y), Z) = K(X, Z).
Proof:
  K(T(X, Y), Z)
= { by lemma 88 R->L }
  K(T(X, Y), T(Z, T(X, Y))) (peak)
= { by lemma 82 }
  ldiv(T(Z, T(X, Y)), Z) (peak)
= { by lemma 78 }
  ldiv(T(Z, X), Z)
= { by lemma 89 }
  K(X, Z)

Lemma 117: K(ldiv(X, Y), Z) = K(rdiv(Y, X), Z).
Proof:
  K(ldiv(X, Y), Z)
= { by lemma 48 R->L }
  K(T(rdiv(Y, X), X), Z) (peak)
= { by lemma 116 }
  K(rdiv(Y, X), Z)

Lemma 118: op(a(X, Y, Z), W) = op(W, a(X, Y, Z)).
Proof:
  op(a(X, Y, Z), W)
= { by lemma 34 R->L }
  rdiv(op(W, a(X, Y, Z)), K(W, a(X, Y, Z))) (peak)
= { by axiom 10 (sos) }
  rdiv(op(W, a(X, Y, Z)), 1)
= { by lemma 24 }
  rdiv(op(W, a(X, Y, Z)), zero)
= { by lemma 27 }
  op(W, a(X, Y, Z))

Lemma 119: T(X, a(Y, Z, W)) = X.
Proof:
  T(X, a(Y, Z, W))
= { by axiom 5 (sos) }
  ldiv(a(Y, Z, W), op(X, a(Y, Z, W))) (peak)
= { by lemma 118 R->L }
  ldiv(a(Y, Z, W), op(a(Y, Z, W), X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 120: op(rdiv(X, op(Y, Z)), op(Z, Y)) = rdiv(X, K(Y, Z)).
Proof:
  op(rdiv(X, op(Y, Z)), op(Z, Y))
= { by lemma 109 R->L }
  rdiv(op(rdiv(X, op(Y, Z)), op(Y, Z)), K(Y, Z)) (peak)
= { by axiom 9 (sos) }
  rdiv(X, K(Y, Z))

Lemma 121: rdiv(op(X, Y), K(Z, Y)) = op(X, T(Y, Z)).
Proof:
  rdiv(op(X, Y), K(Z, Y))
= { by lemma 61 R->L }
  op(K(Y, Z), op(X, Y)) (peak)
= { by lemma 37 }
  op(X, op(Y, K(Y, Z))) (peak)
= { by lemma 40 }
  op(X, T(Y, Z))

Lemma 122: op(R(X, Y, Z), op(Z, Y)) = op(op(X, Y), T(Z, Y)).
Proof:
  op(R(X, Y, Z), op(Z, Y))
= { by axiom 18 (sos) }
  op(rdiv(op(op(X, Y), Z), op(Y, Z)), op(Z, Y)) (peak)
= { by lemma 120 }
  rdiv(op(op(X, Y), Z), K(Y, Z))
= { by lemma 121 }
  op(op(X, Y), T(Z, Y))

Lemma 123: op(R(X, Y, rdiv(Z, Y)), Z) = op(op(X, Y), ldiv(Y, Z)).
Proof:
  op(R(X, Y, rdiv(Z, Y)), Z)
= { by axiom 9 (sos) R->L }
  op(R(X, Y, rdiv(Z, Y)), op(rdiv(Z, Y), Y)) (peak)
= { by lemma 122 }
  op(op(X, Y), T(rdiv(Z, Y), Y))
= { by lemma 48 }
  op(op(X, Y), ldiv(Y, Z))

Lemma 124: rdiv(op(op(X, Y), ldiv(Y, Z)), Z) = R(X, Y, rdiv(Z, Y)).
Proof:
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z)
= { by lemma 123 R->L }
  rdiv(op(R(X, Y, rdiv(Z, Y)), Z), Z) (peak)
= { by axiom 3 (sos) }
  R(X, Y, rdiv(Z, Y))

Lemma 125: R(X, Y, ldiv(Y, Z)) = R(X, Y, rdiv(Z, Y)).
Proof:
  R(X, Y, ldiv(Y, Z))
= { by axiom 3 (sos) R->L }
  R(rdiv(op(X, Y), Y), Y, ldiv(Y, Z)) (peak)
= { by lemma 58 }
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z) (peak)
= { by lemma 124 }
  R(X, Y, rdiv(Z, Y))

Lemma 126: R(X, Y, T(Z, Y)) = R(X, Y, Z).
Proof:
  R(X, Y, T(Z, Y))
= { by axiom 5 (sos) }
  R(X, Y, ldiv(Y, op(Z, Y))) (peak)
= { by lemma 125 }
  R(X, Y, rdiv(op(Z, Y), Y))
= { by axiom 3 (sos) }
  R(X, Y, Z)

Lemma 127: rdiv(op(X, T(Y, Z)), op(Y, Z)) = R(rdiv(X, Z), Z, Y).
Proof:
  rdiv(op(X, T(Y, Z)), op(Y, Z))
= { by lemma 63 R->L }
  rdiv(op(X, T(Y, Z)), op(Z, T(Y, Z))) (peak)
= { by lemma 43 }
  R(rdiv(X, Z), Z, T(Y, Z))
= { by lemma 126 }
  R(rdiv(X, Z), Z, Y)

Lemma 128: op(a(X, Y, Z), rdiv(W, a(X, Y, Z))) = W.
Proof:
  op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))
= { by lemma 46 R->L }
  op(W, K(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 11 (sos) }
  op(W, 1)
= { by lemma 24 }
  op(W, zero)
= { by axiom 1 (sos) }
  W

Lemma 129: ldiv(a(X, Y, Z), W) = rdiv(W, a(X, Y, Z)).
Proof:
  ldiv(a(X, Y, Z), W)
= { by lemma 128 R->L }
  ldiv(a(X, Y, Z), op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 4 (sos) }
  rdiv(W, a(X, Y, Z))

Lemma 130: op(op(X, a(Y, Z, W)), V) = op(X, op(V, a(Y, Z, W))).
Proof:
  op(op(X, a(Y, Z, W)), V)
= { by axiom 20 (sos) }
  op(op(X, op(a(Y, Z, W), V)), a(X, a(Y, Z, W), V)) (peak)
= { by lemma 118 }
  op(op(X, op(V, a(Y, Z, W))), a(X, a(Y, Z, W), V)) (peak)
= { by axiom 15 (sos) }
  op(op(X, op(V, a(Y, Z, W))), 1)
= { by lemma 24 }
  op(op(X, op(V, a(Y, Z, W))), zero)
= { by axiom 1 (sos) }
  op(X, op(V, a(Y, Z, W)))

Lemma 131: R(X, a(Y, Z, W), rdiv(V, a(Y, Z, W))) = X.
Proof:
  R(X, a(Y, Z, W), rdiv(V, a(Y, Z, W)))
= { by lemma 129 R->L }
  R(X, a(Y, Z, W), ldiv(a(Y, Z, W), V))
= { by lemma 51 R->L }
  rdiv(op(op(X, a(Y, Z, W)), ldiv(a(Y, Z, W), V)), V) (peak)
= { by lemma 130 }
  rdiv(op(X, op(ldiv(a(Y, Z, W), V), a(Y, Z, W))), V)
= { by lemma 129 }
  rdiv(op(X, op(rdiv(V, a(Y, Z, W)), a(Y, Z, W))), V)
= { by axiom 9 (sos) }
  rdiv(op(X, V), V)
= { by axiom 3 (sos) }
  X

Lemma 132: R(X, a(Y, Z, W), V) = X.
Proof:
  R(X, a(Y, Z, W), V)
= { by axiom 3 (sos) R->L }
  R(X, a(Y, Z, W), rdiv(op(V, a(Y, Z, W)), a(Y, Z, W))) (peak)
= { by lemma 131 }
  X

Lemma 133: rdiv(op(X, Y), op(Y, a(Z, W, V))) = rdiv(X, a(Z, W, V)).
Proof:
  rdiv(op(X, Y), op(Y, a(Z, W, V))) (peak)
= { by lemma 118 R->L }
  rdiv(op(X, Y), op(a(Z, W, V), Y))
= { by lemma 119 R->L }
  rdiv(op(X, T(Y, a(Z, W, V))), op(a(Z, W, V), Y)) (peak)
= { by lemma 118 }
  rdiv(op(X, T(Y, a(Z, W, V))), op(Y, a(Z, W, V))) (peak)
= { by lemma 127 }
  R(rdiv(X, a(Z, W, V)), a(Z, W, V), Y)
= { by lemma 132 }
  rdiv(X, a(Z, W, V))

Lemma 134: op(R(X, Y, Z), op(Y, Z)) = op(op(X, Y), Z).
Proof:
  op(R(X, Y, Z), op(Y, Z))
= { by axiom 18 (sos) }
  op(rdiv(op(op(X, Y), Z), op(Y, Z)), op(Y, Z)) (peak)
= { by axiom 9 (sos) }
  op(op(X, Y), Z)

Lemma 135: ldiv(op(X, op(Y, Z)), op(op(X, Y), Z)) = a(X, Y, Z).
Proof:
  ldiv(op(X, op(Y, Z)), op(op(X, Y), Z))
= { by lemma 107 R->L }
  ldiv(rdiv(op(op(X, Y), Z), a(X, Y, Z)), op(op(X, Y), Z)) (peak)
= { by lemma 30 }
  a(X, Y, Z)

Lemma 136: ldiv(op(X, op(Y, Z)), op(R(X, Y, Z), op(Y, Z))) = a(X, Y, Z).
Proof:
  ldiv(op(X, op(Y, Z)), op(R(X, Y, Z), op(Y, Z))) (peak)
= { by lemma 134 }
  ldiv(op(X, op(Y, Z)), op(op(X, Y), Z))
= { by lemma 135 }
  a(X, Y, Z)

Lemma 137: rdiv(Z, op(Y, ldiv(op(X, Y), Z))) = R(X, Y, ldiv(op(X, Y), Z)).
Proof:
  rdiv(Z, op(Y, ldiv(op(X, Y), Z)))
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, Y), ldiv(op(X, Y), Z)), op(Y, ldiv(op(X, Y), Z))) (peak)
= { by axiom 18 (sos) R->L }
  R(X, Y, ldiv(op(X, Y), Z))

Lemma 138: op(op(X, Y), a(Z, W, V)) = op(X, op(Y, a(Z, W, V))).
Proof:
  op(op(X, Y), a(Z, W, V))
= { by axiom 20 (sos) }
  op(op(X, op(Y, a(Z, W, V))), a(X, Y, a(Z, W, V))) (peak)
= { by lemma 118 R->L }
  op(op(X, op(a(Z, W, V), Y)), a(X, Y, a(Z, W, V))) (peak)
= { by axiom 14 (sos) }
  op(op(X, op(a(Z, W, V), Y)), 1)
= { by lemma 24 }
  op(op(X, op(a(Z, W, V), Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(a(Z, W, V), Y))
= { by lemma 118 }
  op(X, op(Y, a(Z, W, V)))

Lemma 139: R(X, Y, a(Z, W, V)) = X.
Proof:
  R(X, Y, a(Z, W, V))
= { by axiom 18 (sos) }
  rdiv(op(op(X, Y), a(Z, W, V)), op(Y, a(Z, W, V))) (peak)
= { by lemma 138 }
  rdiv(op(X, op(Y, a(Z, W, V))), op(Y, a(Z, W, V)))
= { by axiom 3 (sos) }
  X

Lemma 140: rdiv(R(X, Y, Z), a(X, Y, Z)) = X.
Proof:
  rdiv(R(X, Y, Z), a(X, Y, Z))
= { by lemma 133 R->L }
  rdiv(op(R(X, Y, Z), op(Y, Z)), op(op(Y, Z), a(X, Y, Z)))
= { by lemma 136 R->L }
  rdiv(op(R(X, Y, Z), op(Y, Z)), op(op(Y, Z), ldiv(op(X, op(Y, Z)), op(R(X, Y, Z), op(Y, Z))))) (peak)
= { by lemma 137 }
  R(X, op(Y, Z), ldiv(op(X, op(Y, Z)), op(R(X, Y, Z), op(Y, Z))))
= { by lemma 136 }
  R(X, op(Y, Z), a(X, Y, Z))
= { by lemma 139 }
  X

Lemma 141: ldiv(X, R(X, Y, Z)) = a(X, Y, Z).
Proof:
  ldiv(X, R(X, Y, Z))
= { by lemma 140 R->L }
  ldiv(rdiv(R(X, Y, Z), a(X, Y, Z)), R(X, Y, Z)) (peak)
= { by lemma 30 }
  a(X, Y, Z)

Lemma 142: rdiv(X, rdiv(X, a(Y, Z, W))) = a(Y, Z, W).
Proof:
  rdiv(X, rdiv(X, a(Y, Z, W)))
= { by lemma 128 R->L }
  rdiv(op(a(Y, Z, W), rdiv(X, a(Y, Z, W))), rdiv(X, a(Y, Z, W))) (peak)
= { by axiom 3 (sos) }
  a(Y, Z, W)

Lemma 143: rdiv(R(X, Y, Z), X) = a(X, Y, Z).
Proof:
  rdiv(R(X, Y, Z), X)
= { by lemma 140 R->L }
  rdiv(R(X, Y, Z), rdiv(R(X, Y, Z), a(X, Y, Z))) (peak)
= { by lemma 142 }
  a(X, Y, Z)

Lemma 144: ldiv(X, R(X, Y, Z)) = rdiv(R(X, Y, Z), X).
Proof:
  ldiv(X, R(X, Y, Z)) (peak)
= { by lemma 141 }
  a(X, Y, Z)
= { by lemma 143 R->L }
  rdiv(R(X, Y, Z), X)

Lemma 145: rdiv(op(X, a(Y, Z, W)), X) = a(Y, Z, W).
Proof:
  rdiv(op(X, a(Y, Z, W)), X) (peak)
= { by lemma 118 R->L }
  rdiv(op(a(Y, Z, W), X), X) (peak)
= { by axiom 3 (sos) }
  a(Y, Z, W)

Lemma 146: op(X, op(Y, a(Z, X, Y))) = ldiv(Z, op(op(Z, X), Y)).
Proof:
  op(X, op(Y, a(Z, X, Y)))
= { by lemma 138 R->L }
  op(op(X, Y), a(Z, X, Y))
= { by lemma 73 R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, op(X, Y)), a(Z, X, Y))) (peak)
= { by axiom 20 (sos) R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, X), Y))
= { by lemma 139 }
  ldiv(Z, op(op(Z, X), Y))

Lemma 147: ldiv(Z, ldiv(Y, op(op(Y, Z), X))) = op(X, a(Y, Z, X)).
Proof:
  ldiv(Z, ldiv(Y, op(op(Y, Z), X))) (peak)
= { by lemma 146 R->L }
  ldiv(Z, op(Z, op(X, a(Y, Z, X)))) (peak)
= { by axiom 4 (sos) }
  op(X, a(Y, Z, X))

Lemma 148: op(op(X, Y), L(Z, Y, X)) = op(X, op(Y, Z)).
Proof:
  op(op(X, Y), L(Z, Y, X))
= { by axiom 19 (sos) }
  op(op(X, Y), ldiv(op(X, Y), op(X, op(Y, Z)))) (peak)
= { by axiom 8 (sos) }
  op(X, op(Y, Z))

Lemma 149: op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))) = X.
Proof:
  op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))) (peak)
= { by lemma 147 R->L }
  ldiv(Y, ldiv(Z, op(op(Z, Y), L(X, Y, Z))))
= { by lemma 148 }
  ldiv(Y, ldiv(Z, op(Z, op(Y, X))))
= { by axiom 4 (sos) }
  ldiv(Y, op(Y, X))
= { by axiom 4 (sos) }
  X

Lemma 150: a(X, Y, L(Z, Y, X)) = rdiv(Z, L(Z, Y, X)).
Proof:
  a(X, Y, L(Z, Y, X))
= { by lemma 145 R->L }
  rdiv(op(L(Z, Y, X), a(X, Y, L(Z, Y, X))), L(Z, Y, X)) (peak)
= { by lemma 149 }
  rdiv(Z, L(Z, Y, X))

Lemma 151: op(op(X, a(Y, Z, W)), V) = op(op(X, V), a(Y, Z, W)).
Proof:
  op(op(X, a(Y, Z, W)), V) (peak)
= { by lemma 118 R->L }
  op(op(a(Y, Z, W), X), V)
= { by axiom 20 (sos) }
  op(op(a(Y, Z, W), op(X, V)), a(a(Y, Z, W), X, V)) (peak)
= { by lemma 118 }
  op(op(op(X, V), a(Y, Z, W)), a(a(Y, Z, W), X, V)) (peak)
= { by axiom 16 (sos) }
  op(op(op(X, V), a(Y, Z, W)), 1)
= { by lemma 24 }
  op(op(op(X, V), a(Y, Z, W)), zero)
= { by axiom 1 (sos) }
  op(op(X, V), a(Y, Z, W))

Lemma 152: op(op(a(X, Y, Z), W), V) = op(W, op(V, a(X, Y, Z))).
Proof:
  op(op(a(X, Y, Z), W), V) (peak)
= { by lemma 118 }
  op(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 151 }
  op(op(W, V), a(X, Y, Z)) (peak)
= { by lemma 138 }
  op(W, op(V, a(X, Y, Z)))

Lemma 153: L(X, a(Y, Z, W), V) = X.
Proof:
  L(X, a(Y, Z, W), V)
= { by lemma 119 R->L }
  L(T(X, a(Y, Z, W)), a(Y, Z, W), V)
= { by lemma 69 R->L }
  ldiv(op(V, a(Y, Z, W)), op(V, op(X, a(Y, Z, W))))
= { by lemma 152 R->L }
  ldiv(op(V, a(Y, Z, W)), op(op(a(Y, Z, W), V), X)) (peak)
= { by lemma 74 }
  rdiv(X, K(V, a(Y, Z, W)))
= { by axiom 10 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 154: L(ldiv(X, zero), X, Y) = ldiv(op(Y, X), Y).
Proof:
  L(ldiv(X, zero), X, Y) (peak)
= { by lemma 68 R->L }
  ldiv(op(Y, X), op(Y, zero)) (peak)
= { by axiom 1 (sos) }
  ldiv(op(Y, X), Y)

Lemma 155: rdiv(zero, rdiv(X, L(X, Y, Z))) = ldiv(X, L(X, Y, Z)).
Proof:
  rdiv(zero, rdiv(X, L(X, Y, Z))) (peak)
= { by lemma 150 R->L }
  rdiv(zero, a(Z, Y, L(X, Y, Z)))
= { by lemma 129 R->L }
  ldiv(a(Z, Y, L(X, Y, Z)), zero)
= { by lemma 153 R->L }
  L(ldiv(a(Z, Y, L(X, Y, Z)), zero), a(Z, Y, L(X, Y, Z)), L(X, Y, Z)) (peak)
= { by lemma 154 }
  ldiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), L(X, Y, Z))
= { by lemma 149 }
  ldiv(X, L(X, Y, Z))

Lemma 156: ldiv(X, op(rdiv(X, Y), op(Y, Z))) = L(Z, Y, rdiv(X, Y)).
Proof:
  ldiv(X, op(rdiv(X, Y), op(Y, Z)))
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(X, Y), Y), op(rdiv(X, Y), op(Y, Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, Y, rdiv(X, Y))

Lemma 157: L(X, rdiv(Y, X), rdiv(Z, rdiv(Y, X))) = ldiv(Z, op(rdiv(Z, rdiv(Y, X)), Y)).
Proof:
  L(X, rdiv(Y, X), rdiv(Z, rdiv(Y, X)))
= { by lemma 156 R->L }
  ldiv(Z, op(rdiv(Z, rdiv(Y, X)), op(rdiv(Y, X), X))) (peak)
= { by axiom 9 (sos) }
  ldiv(Z, op(rdiv(Z, rdiv(Y, X)), Y))

Lemma 158: ldiv(X, rdiv(op(X, Y), K(Z, W))) = rdiv(Y, K(Z, W)).
Proof:
  ldiv(X, rdiv(op(X, Y), K(Z, W)))
= { by lemma 61 R->L }
  ldiv(X, op(K(W, Z), op(X, Y)))
= { by lemma 101 R->L }
  ldiv(R(X, Y, K(W, Z)), op(K(W, Z), op(X, Y))) (peak)
= { by lemma 35 }
  ldiv(R(X, Y, K(W, Z)), op(op(X, Y), K(W, Z))) (peak)
= { by lemma 73 }
  op(Y, K(W, Z))
= { by lemma 62 }
  rdiv(Y, K(Z, W))

Lemma 159: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, ldiv(Y, X), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by axiom 8 (sos) R->L }
  ldiv(op(Y, ldiv(Y, X)), op(Y, op(ldiv(Y, X), Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, ldiv(Y, X), Y)

Lemma 160: L(ldiv(X, ldiv(Y, Z)), X, Y) = ldiv(op(Y, X), Z).
Proof:
  L(ldiv(X, ldiv(Y, Z)), X, Y) (peak)
= { by lemma 68 R->L }
  ldiv(op(Y, X), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 8 (sos) }
  ldiv(op(Y, X), Z)

Lemma 161: ldiv(rdiv(X, K(Y, Z)), W) = ldiv(X, rdiv(W, K(Z, Y))).
Proof:
  ldiv(rdiv(X, K(Y, Z)), W)
= { by lemma 61 R->L }
  ldiv(op(K(Z, Y), X), W)
= { by lemma 160 R->L }
  L(ldiv(X, ldiv(K(Z, Y), W)), X, K(Z, Y)) (peak)
= { by lemma 75 }
  ldiv(X, ldiv(K(Z, Y), W))
= { by lemma 50 }
  ldiv(X, rdiv(W, K(Z, Y)))

Lemma 162: ldiv(X, rdiv(Y, K(Z, W))) = rdiv(ldiv(X, Y), K(Z, W)).
Proof:
  ldiv(X, rdiv(Y, K(Z, W)))
= { by axiom 8 (sos) R->L }
  ldiv(X, rdiv(op(X, ldiv(X, Y)), K(Z, W))) (peak)
= { by lemma 158 }
  rdiv(ldiv(X, Y), K(Z, W))

Lemma 163: op(rdiv(X, K(Y, Z)), W) = rdiv(op(X, W), K(Y, Z)).
Proof:
  op(rdiv(X, K(Y, Z)), W)
= { by lemma 62 R->L }
  op(op(X, K(Z, Y)), W) (peak)
= { by lemma 35 R->L }
  op(op(K(Z, Y), X), W) (peak)
= { by lemma 52 }
  op(X, op(W, K(Z, Y)))
= { by lemma 62 }
  op(X, rdiv(W, K(Y, Z)))
= { by lemma 106 }
  rdiv(op(X, W), K(Y, Z))

Lemma 164: R(rdiv(rdiv(X, Y), Z), Z, Y) = rdiv(X, op(Z, Y)).
Proof:
  R(rdiv(rdiv(X, Y), Z), Z, Y) (peak)
= { by lemma 43 R->L }
  rdiv(op(rdiv(X, Y), Y), op(Z, Y)) (peak)
= { by axiom 9 (sos) }
  rdiv(X, op(Z, Y))

Lemma 165: rdiv(rdiv(X, Y), K(Z, W)) = rdiv(X, rdiv(Y, K(W, Z))).
Proof:
  rdiv(rdiv(X, Y), K(Z, W))
= { by lemma 72 R->L }
  R(rdiv(rdiv(X, Y), K(Z, W)), K(Z, W), Y) (peak)
= { by lemma 164 }
  rdiv(X, op(K(Z, W), Y))
= { by lemma 61 }
  rdiv(X, rdiv(Y, K(W, Z)))

Lemma 166: L(X, rdiv(Y, K(Z, W)), V) = L(X, Y, V).
Proof:
  L(X, rdiv(Y, K(Z, W)), V)
= { by lemma 158 R->L }
  L(X, ldiv(V, rdiv(op(V, Y), K(Z, W))), V)
= { by lemma 159 R->L }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(ldiv(V, rdiv(op(V, Y), K(Z, W))), X))) (peak)
= { by lemma 158 }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(rdiv(Y, K(Z, W)), X)))
= { by lemma 161 }
  ldiv(op(V, Y), rdiv(op(V, op(rdiv(Y, K(Z, W)), X)), K(W, Z)))
= { by lemma 162 }
  rdiv(ldiv(op(V, Y), op(V, op(rdiv(Y, K(Z, W)), X))), K(W, Z))
= { by lemma 163 }
  rdiv(ldiv(op(V, Y), op(V, rdiv(op(Y, X), K(Z, W)))), K(W, Z))
= { by lemma 106 }
  rdiv(ldiv(op(V, Y), rdiv(op(V, op(Y, X)), K(Z, W))), K(W, Z))
= { by lemma 162 }
  rdiv(rdiv(ldiv(op(V, Y), op(V, op(Y, X))), K(Z, W)), K(W, Z))
= { by lemma 165 }
  rdiv(ldiv(op(V, Y), op(V, op(Y, X))), rdiv(K(Z, W), K(Z, W)))
= { by axiom 19 (sos) R->L }
  rdiv(L(X, Y, V), rdiv(K(Z, W), K(Z, W)))
= { by lemma 26 }
  rdiv(L(X, Y, V), zero)
= { by lemma 27 }
  L(X, Y, V)

Lemma 167: L(X, op(Y, Z), W) = L(X, op(Z, Y), W).
Proof:
  L(X, op(Y, Z), W)
= { by lemma 166 R->L }
  L(X, rdiv(op(Y, Z), K(Y, Z)), W) (peak)
= { by lemma 34 }
  L(X, op(Z, Y), W)

Lemma 168: op(X, K(rdiv(Y, X), X)) = rdiv(Y, rdiv(Y, X)).
Proof:
  op(X, K(rdiv(Y, X), X))
= { by lemma 42 }
  rdiv(op(rdiv(Y, X), X), rdiv(Y, X)) (peak)
= { by axiom 9 (sos) }
  rdiv(Y, rdiv(Y, X))

Lemma 169: op(ldiv(X, Y), K(X, rdiv(Y, X))) = rdiv(Y, X).
Proof:
  op(ldiv(X, Y), K(X, rdiv(Y, X)))
= { by lemma 113 R->L }
  op(ldiv(X, Y), K(X, ldiv(X, Y)))
= { by lemma 90 R->L }
  op(ldiv(X, Y), K(rdiv(Y, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 168 }
  rdiv(Y, rdiv(Y, ldiv(X, Y)))
= { by lemma 90 }
  rdiv(Y, X)

Lemma 170: L(X, ldiv(Y, Z), W) = L(X, rdiv(Z, Y), W).
Proof:
  L(X, ldiv(Y, Z), W)
= { by lemma 166 R->L }
  L(X, rdiv(ldiv(Y, Z), K(rdiv(Z, Y), Y)), W)
= { by lemma 61 R->L }
  L(X, op(K(Y, rdiv(Z, Y)), ldiv(Y, Z)), W) (peak)
= { by lemma 167 R->L }
  L(X, op(ldiv(Y, Z), K(Y, rdiv(Z, Y))), W)
= { by lemma 169 }
  L(X, rdiv(Z, Y), W)

Lemma 171: rdiv(op(Y, Z), op(ldiv(X, Y), Z)) = R(X, ldiv(X, Y), Z).
Proof:
  rdiv(op(Y, Z), op(ldiv(X, Y), Z))
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, ldiv(X, Y)), Z), op(ldiv(X, Y), Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(X, ldiv(X, Y), Z)

Lemma 172: ldiv(R(X, ldiv(X, Y), Z), op(Y, Z)) = op(ldiv(X, Y), Z).
Proof:
  ldiv(R(X, ldiv(X, Y), Z), op(Y, Z)) (peak)
= { by lemma 171 R->L }
  ldiv(rdiv(op(Y, Z), op(ldiv(X, Y), Z)), op(Y, Z)) (peak)
= { by lemma 30 }
  op(ldiv(X, Y), Z)

Lemma 173: rdiv(ldiv(X, op(Y, Z)), K(Y, Z)) = ldiv(X, op(Z, Y)).
Proof:
  rdiv(ldiv(X, op(Y, Z)), K(Y, Z))
= { by lemma 62 R->L }
  op(ldiv(X, op(Y, Z)), K(Z, Y))
= { by lemma 172 R->L }
  ldiv(R(X, ldiv(X, op(Y, Z)), K(Z, Y)), op(op(Y, Z), K(Z, Y))) (peak)
= { by axiom 17 (sos) R->L }
  ldiv(R(X, ldiv(X, op(Y, Z)), K(Z, Y)), op(Z, Y))
= { by lemma 101 }
  ldiv(X, op(Z, Y))

Lemma 174: L(X, rdiv(op(Z, Y), W), V) = L(X, rdiv(op(Y, Z), W), V).
Proof:
  L(X, rdiv(op(Z, Y), W), V)
= { by lemma 170 R->L }
  L(X, ldiv(W, op(Z, Y)), V)
= { by lemma 173 R->L }
  L(X, rdiv(ldiv(W, op(Y, Z)), K(Y, Z)), V) (peak)
= { by lemma 166 }
  L(X, ldiv(W, op(Y, Z)), V)
= { by lemma 170 }
  L(X, rdiv(op(Y, Z), W), V)

Lemma 175: L(X, rdiv(op(Y, Z), Y), W) = L(X, Z, W).
Proof:
  L(X, rdiv(op(Y, Z), Y), W) (peak)
= { by lemma 174 }
  L(X, rdiv(op(Z, Y), Y), W) (peak)
= { by axiom 3 (sos) }
  L(X, Z, W)

Lemma 176: L(X, rdiv(Y, L(Y, Z, W)), V) = X.
Proof:
  L(X, rdiv(Y, L(Y, Z, W)), V)
= { by lemma 149 R->L }
  L(X, rdiv(op(L(Y, Z, W), a(W, Z, L(Y, Z, W))), L(Y, Z, W)), V) (peak)
= { by lemma 175 }
  L(X, a(W, Z, L(Y, Z, W)), V)
= { by lemma 153 }
  X

Lemma 177: op(ldiv(X, L(X, Y, Z)), X) = L(X, Y, Z).
Proof:
  op(ldiv(X, L(X, Y, Z)), X)
= { by lemma 25 R->L }
  ldiv(zero, op(ldiv(X, L(X, Y, Z)), X))
= { by lemma 155 R->L }
  ldiv(zero, op(rdiv(zero, rdiv(X, L(X, Y, Z))), X))
= { by lemma 157 R->L }
  L(L(X, Y, Z), rdiv(X, L(X, Y, Z)), rdiv(zero, rdiv(X, L(X, Y, Z)))) (peak)
= { by lemma 176 }
  L(X, Y, Z)

Lemma 178: ldiv(X, L(X, Y, Z)) = rdiv(L(X, Y, Z), X).
Proof:
  ldiv(X, L(X, Y, Z))
= { by axiom 3 (sos) R->L }
  rdiv(op(ldiv(X, L(X, Y, Z)), X), X) (peak)
= { by lemma 177 }
  rdiv(L(X, Y, Z), X)

Lemma 179: L(ldiv(X, Y), X, rdiv(Z, X)) = ldiv(Z, op(rdiv(Z, X), Y)).
Proof:
  L(ldiv(X, Y), X, rdiv(Z, X))
= { by lemma 68 R->L }
  ldiv(op(rdiv(Z, X), X), op(rdiv(Z, X), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(Z, op(rdiv(Z, X), Y))

Lemma 180: L(ldiv(X, zero), X, rdiv(Y, X)) = ldiv(Y, rdiv(Y, X)).
Proof:
  L(ldiv(X, zero), X, rdiv(Y, X)) (peak)
= { by lemma 179 }
  ldiv(Y, op(rdiv(Y, X), zero)) (peak)
= { by axiom 1 (sos) }
  ldiv(Y, rdiv(Y, X))

Lemma 181: rdiv(zero, rdiv(R(X, Y, Z), X)) = ldiv(R(X, Y, Z), X).
Proof:
  rdiv(zero, rdiv(R(X, Y, Z), X))
= { by lemma 143 }
  rdiv(zero, a(X, Y, Z))
= { by lemma 129 R->L }
  ldiv(a(X, Y, Z), zero)
= { by lemma 153 R->L }
  L(ldiv(a(X, Y, Z), zero), a(X, Y, Z), rdiv(R(X, Y, Z), a(X, Y, Z))) (peak)
= { by lemma 180 }
  ldiv(R(X, Y, Z), rdiv(R(X, Y, Z), a(X, Y, Z)))
= { by lemma 140 }
  ldiv(R(X, Y, Z), X)

Lemma 182: L(X, rdiv(R(Y, Z, W), Y), V) = X.
Proof:
  L(X, rdiv(R(Y, Z, W), Y), V)
= { by lemma 170 R->L }
  L(X, ldiv(Y, R(Y, Z, W)), V) (peak)
= { by lemma 141 }
  L(X, a(Y, Z, W), V)
= { by lemma 153 }
  X

Lemma 183: op(ldiv(R(X, Y, Z), X), R(X, Y, Z)) = X.
Proof:
  op(ldiv(R(X, Y, Z), X), R(X, Y, Z))
= { by lemma 25 R->L }
  ldiv(zero, op(ldiv(R(X, Y, Z), X), R(X, Y, Z)))
= { by lemma 181 R->L }
  ldiv(zero, op(rdiv(zero, rdiv(R(X, Y, Z), X)), R(X, Y, Z)))
= { by lemma 157 R->L }
  L(X, rdiv(R(X, Y, Z), X), rdiv(zero, rdiv(R(X, Y, Z), X))) (peak)
= { by lemma 182 }
  X

Lemma 184: ldiv(R(X, Y, Z), X) = rdiv(X, R(X, Y, Z)).
Proof:
  ldiv(R(X, Y, Z), X)
= { by axiom 3 (sos) R->L }
  rdiv(op(ldiv(R(X, Y, Z), X), R(X, Y, Z)), R(X, Y, Z)) (peak)
= { by lemma 183 }
  rdiv(X, R(X, Y, Z))

Lemma 185: a(X, Y, L(Z, Y, X)) = ldiv(L(Z, Y, X), Z).
Proof:
  a(X, Y, L(Z, Y, X))
= { by axiom 4 (sos) R->L }
  ldiv(L(Z, Y, X), op(L(Z, Y, X), a(X, Y, L(Z, Y, X)))) (peak)
= { by lemma 149 }
  ldiv(L(Z, Y, X), Z)

Lemma 186: ldiv(L(X, Y, Z), X) = rdiv(X, L(X, Y, Z)).
Proof:
  ldiv(L(X, Y, Z), X) (peak)
= { by lemma 185 R->L }
  a(Z, Y, L(X, Y, Z))
= { by lemma 94 R->L }
  rdiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), T(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))) (peak)
= { by lemma 149 }
  rdiv(X, T(L(X, Y, Z), a(Z, Y, L(X, Y, Z))))
= { by lemma 119 }
  rdiv(X, L(X, Y, Z))

Lemma 187: K(X, a(Y, Z, W)) = zero.
Proof:
  K(X, a(Y, Z, W)) (peak)
= { by axiom 10 (sos) }
  1
= { by lemma 24 }
  zero

Lemma 188: op(a(X, Y, Z), op(W, V)) = op(W, op(V, a(X, Y, Z))).
Proof:
  op(a(X, Y, Z), op(W, V)) (peak)
= { by lemma 118 }
  op(op(W, V), a(X, Y, Z)) (peak)
= { by lemma 151 R->L }
  op(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 130 }
  op(W, op(V, a(X, Y, Z)))

Lemma 189: op(a(X, Y, Z), op(W, V)) = op(W, op(a(X, Y, Z), V)).
Proof:
  op(a(X, Y, Z), op(W, V)) (peak)
= { by lemma 188 }
  op(W, op(V, a(X, Y, Z))) (peak)
= { by lemma 118 R->L }
  op(W, op(a(X, Y, Z), V)) (peak)

Lemma 190: T(a(X, Y, Z), W) = a(X, Y, Z).
Proof:
  T(a(X, Y, Z), W)
= { by axiom 5 (sos) }
  ldiv(W, op(a(X, Y, Z), W)) (peak)
= { by lemma 118 }
  ldiv(W, op(W, a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 191: rdiv(op(X, T(Z, Y)), op(Z, Y)) = R(rdiv(X, Y), Y, T(Z, Y)).
Proof:
  rdiv(op(X, T(Z, Y)), op(Z, Y))
= { by lemma 63 R->L }
  rdiv(op(X, T(Z, Y)), op(Y, T(Z, Y))) (peak)
= { by lemma 43 }
  R(rdiv(X, Y), Y, T(Z, Y))

Lemma 192: rdiv(op(X, a(Y, Z, W)), V) = rdiv(X, rdiv(V, a(Y, Z, W))).
Proof:
  rdiv(op(X, a(Y, Z, W)), V)
= { by lemma 190 R->L }
  rdiv(op(X, T(a(Y, Z, W), rdiv(V, a(Y, Z, W)))), V)
= { by lemma 128 R->L }
  rdiv(op(X, T(a(Y, Z, W), rdiv(V, a(Y, Z, W)))), op(a(Y, Z, W), rdiv(V, a(Y, Z, W))))
= { by lemma 191 }
  R(rdiv(X, rdiv(V, a(Y, Z, W))), rdiv(V, a(Y, Z, W)), T(a(Y, Z, W), rdiv(V, a(Y, Z, W)))) (peak)
= { by lemma 190 }
  R(rdiv(X, rdiv(V, a(Y, Z, W))), rdiv(V, a(Y, Z, W)), a(Y, Z, W))
= { by lemma 139 }
  rdiv(X, rdiv(V, a(Y, Z, W)))

Lemma 193: rdiv(op(a(X, Y, Z), W), V) = rdiv(W, rdiv(V, a(X, Y, Z))).
Proof:
  rdiv(op(a(X, Y, Z), W), V) (peak)
= { by lemma 118 }
  rdiv(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 192 }
  rdiv(W, rdiv(V, a(X, Y, Z)))

Lemma 194: L(a(X, Y, Z), W, V) = a(X, Y, Z).
Proof:
  L(a(X, Y, Z), W, V)
= { by axiom 19 (sos) }
  ldiv(op(V, W), op(V, op(W, a(X, Y, Z))))
= { by lemma 138 R->L }
  ldiv(op(V, W), op(op(V, W), a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 195: rdiv(op(X, op(Y, Z)), L(Z, Y, X)) = op(X, Y).
Proof:
  rdiv(op(X, op(Y, Z)), L(Z, Y, X))
= { by axiom 19 (sos) }
  rdiv(op(X, op(Y, Z)), ldiv(op(X, Y), op(X, op(Y, Z)))) (peak)
= { by lemma 90 }
  op(X, Y)

Lemma 196: rdiv(op(X, op(Y, a(Z, W, V))), a(Z, W, V)) = op(X, Y).
Proof:
  rdiv(op(X, op(Y, a(Z, W, V))), a(Z, W, V)) (peak)
= { by lemma 118 R->L }
  rdiv(op(X, op(a(Z, W, V), Y)), a(Z, W, V))
= { by lemma 194 R->L }
  rdiv(op(X, op(a(Z, W, V), Y)), L(a(Z, W, V), Y, X)) (peak)
= { by lemma 118 }
  rdiv(op(X, op(Y, a(Z, W, V))), L(a(Z, W, V), Y, X)) (peak)
= { by lemma 195 }
  op(X, Y)

Lemma 197: K(X, op(Y, a(Z, W, V))) = K(X, Y).
Proof:
  K(X, op(Y, a(Z, W, V))) (peak)
= { by lemma 112 }
  K(X, op(a(Z, W, V), Y))
= { by lemma 55 R->L }
  rdiv(op(X, op(a(Z, W, V), Y)), op(op(a(Z, W, V), Y), X)) (peak)
= { by lemma 189 R->L }
  rdiv(op(a(Z, W, V), op(X, Y)), op(op(a(Z, W, V), Y), X)) (peak)
= { by lemma 193 }
  rdiv(op(X, Y), rdiv(op(op(a(Z, W, V), Y), X), a(Z, W, V)))
= { by lemma 152 }
  rdiv(op(X, Y), rdiv(op(Y, op(X, a(Z, W, V))), a(Z, W, V)))
= { by lemma 196 }
  rdiv(op(X, Y), op(Y, X))
= { by lemma 55 }
  K(X, Y)

Lemma 198: K(X, L(Y, Z, W)) = K(X, Y).
Proof:
  K(X, L(Y, Z, W))
= { by lemma 197 R->L }
  K(X, op(L(Y, Z, W), a(W, Z, L(Y, Z, W)))) (peak)
= { by lemma 149 }
  K(X, Y)

Lemma 199: K(op(X, a(Y, Z, W)), V) = K(X, V).
Proof:
  K(op(X, a(Y, Z, W)), V)
= { by lemma 56 R->L }
  rdiv(zero, K(V, op(X, a(Y, Z, W)))) (peak)
= { by lemma 197 }
  rdiv(zero, K(V, X))
= { by lemma 56 }
  K(X, V)

Lemma 200: K(L(X, Y, Z), W) = K(X, W).
Proof:
  K(L(X, Y, Z), W)
= { by lemma 199 R->L }
  K(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), W) (peak)
= { by lemma 149 }
  K(X, W)

Lemma 201: rdiv(op(X, Y), rdiv(Y, K(Z, W))) = rdiv(X, K(W, Z)).
Proof:
  rdiv(op(X, Y), rdiv(Y, K(Z, W)))
= { by lemma 61 R->L }
  rdiv(op(X, Y), op(K(W, Z), Y))
= { by lemma 49 R->L }
  rdiv(op(X, T(Y, K(W, Z))), op(K(W, Z), Y)) (peak)
= { by lemma 35 }
  rdiv(op(X, T(Y, K(W, Z))), op(Y, K(W, Z))) (peak)
= { by lemma 191 }
  R(rdiv(X, K(W, Z)), K(W, Z), T(Y, K(W, Z))) (peak)
= { by lemma 72 }
  rdiv(X, K(W, Z))

Lemma 202: rdiv(rdiv(X, K(Y, Z)), W) = rdiv(X, rdiv(W, K(Z, Y))).
Proof:
  rdiv(rdiv(X, K(Y, Z)), W)
= { by lemma 101 R->L }
  R(rdiv(rdiv(X, K(Y, Z)), W), W, K(Y, Z)) (peak)
= { by lemma 164 }
  rdiv(X, op(W, K(Y, Z)))
= { by lemma 62 }
  rdiv(X, rdiv(W, K(Z, Y)))

Lemma 203: L(X, Y, rdiv(Z, K(W, V))) = L(X, Y, Z).
Proof:
  L(X, Y, rdiv(Z, K(W, V)))
= { by lemma 201 R->L }
  L(X, Y, rdiv(op(Z, Y), rdiv(Y, K(V, W))))
= { by lemma 166 R->L }
  L(X, rdiv(Y, K(V, W)), rdiv(op(Z, Y), rdiv(Y, K(V, W))))
= { by lemma 156 R->L }
  ldiv(op(Z, Y), op(rdiv(op(Z, Y), rdiv(Y, K(V, W))), op(rdiv(Y, K(V, W)), X))) (peak)
= { by lemma 201 }
  ldiv(op(Z, Y), op(rdiv(Z, K(W, V)), op(rdiv(Y, K(V, W)), X)))
= { by lemma 163 }
  ldiv(op(Z, Y), rdiv(op(Z, op(rdiv(Y, K(V, W)), X)), K(W, V)))
= { by lemma 162 }
  rdiv(ldiv(op(Z, Y), op(Z, op(rdiv(Y, K(V, W)), X))), K(W, V))
= { by lemma 163 }
  rdiv(ldiv(op(Z, Y), op(Z, rdiv(op(Y, X), K(V, W)))), K(W, V))
= { by lemma 106 }
  rdiv(ldiv(op(Z, Y), rdiv(op(Z, op(Y, X)), K(V, W))), K(W, V))
= { by lemma 162 }
  rdiv(rdiv(ldiv(op(Z, Y), op(Z, op(Y, X))), K(V, W)), K(W, V))
= { by lemma 202 }
  rdiv(ldiv(op(Z, Y), op(Z, op(Y, X))), rdiv(K(W, V), K(W, V)))
= { by axiom 19 (sos) R->L }
  rdiv(L(X, Y, Z), rdiv(K(W, V), K(W, V)))
= { by lemma 26 }
  rdiv(L(X, Y, Z), zero)
= { by lemma 27 }
  L(X, Y, Z)

Lemma 204: rdiv(X, K(rdiv(X, Y), Y)) = op(Y, rdiv(X, Y)).
Proof:
  rdiv(X, K(rdiv(X, Y), Y))
= { by axiom 9 (sos) R->L }
  rdiv(op(rdiv(X, Y), Y), K(rdiv(X, Y), Y)) (peak)
= { by lemma 34 }
  op(Y, rdiv(X, Y))

Lemma 205: op(ldiv(ldiv(X, Y), Y), ldiv(X, Y)) = op(X, rdiv(Y, X)).
Proof:
  op(ldiv(ldiv(X, Y), Y), ldiv(X, Y))
= { by lemma 31 R->L }
  op(Y, K(ldiv(ldiv(X, Y), Y), ldiv(X, Y))) (peak)
= { by lemma 67 }
  op(Y, K(T(X, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 62 }
  rdiv(Y, K(ldiv(X, Y), T(X, ldiv(X, Y))))
= { by lemma 117 }
  rdiv(Y, K(rdiv(Y, X), T(X, ldiv(X, Y))))
= { by lemma 114 }
  rdiv(Y, K(rdiv(Y, X), X))
= { by lemma 204 }
  op(X, rdiv(Y, X))

Lemma 206: op(T(X, rdiv(Y, X)), ldiv(X, Y)) = op(X, rdiv(Y, X)).
Proof:
  op(T(X, rdiv(Y, X)), ldiv(X, Y))
= { by lemma 79 R->L }
  op(T(X, ldiv(X, Y)), ldiv(X, Y)) (peak)
= { by lemma 67 R->L }
  op(ldiv(ldiv(X, Y), Y), ldiv(X, Y)) (peak)
= { by lemma 205 }
  op(X, rdiv(Y, X))

Lemma 207: rdiv(ldiv(X, Y), K(rdiv(Y, X), X)) = rdiv(Y, X).
Proof:
  rdiv(ldiv(X, Y), K(rdiv(Y, X), X))
= { by lemma 88 R->L }
  rdiv(ldiv(X, Y), K(rdiv(Y, X), T(X, rdiv(Y, X))))
= { by lemma 117 R->L }
  rdiv(ldiv(X, Y), K(ldiv(X, Y), T(X, rdiv(Y, X))))
= { by lemma 62 R->L }
  op(ldiv(X, Y), K(T(X, rdiv(Y, X)), ldiv(X, Y)))
= { by lemma 42 }
  rdiv(op(T(X, rdiv(Y, X)), ldiv(X, Y)), T(X, rdiv(Y, X))) (peak)
= { by lemma 206 }
  rdiv(op(X, rdiv(Y, X)), T(X, rdiv(Y, X)))
= { by lemma 94 }
  rdiv(Y, X)

Lemma 208: L(X, Y, ldiv(Z, W)) = L(X, Y, rdiv(W, Z)).
Proof:
  L(X, Y, ldiv(Z, W))
= { by lemma 203 R->L }
  L(X, Y, rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))) (peak)
= { by lemma 207 }
  L(X, Y, rdiv(W, Z))

Lemma 209: L(X, K(Y, Z), W) = X.
Proof:
  L(X, K(Y, Z), W)
= { by lemma 49 R->L }
  L(T(X, K(Y, Z)), K(Y, Z), W)
= { by lemma 69 R->L }
  ldiv(op(W, K(Y, Z)), op(W, op(X, K(Y, Z))))
= { by lemma 52 R->L }
  ldiv(op(W, K(Y, Z)), op(op(K(Y, Z), W), X)) (peak)
= { by lemma 74 }
  rdiv(X, K(W, K(Y, Z)))
= { by axiom 6 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 210: op(X, L(Y, ldiv(Z, X), Z)) = op(Z, op(ldiv(Z, X), Y)).
Proof:
  op(X, L(Y, ldiv(Z, X), Z))
= { by axiom 8 (sos) R->L }
  op(op(Z, ldiv(Z, X)), L(Y, ldiv(Z, X), Z)) (peak)
= { by lemma 148 }
  op(Z, op(ldiv(Z, X), Y))

Lemma 211: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, rdiv(X, Y), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by lemma 210 R->L }
  ldiv(X, op(X, L(Z, ldiv(Y, X), Y))) (peak)
= { by axiom 4 (sos) }
  L(Z, ldiv(Y, X), Y)
= { by lemma 170 }
  L(Z, rdiv(X, Y), Y)

Lemma 212: op(rdiv(X, a(Y, Z, W)), V) = rdiv(op(X, V), a(Y, Z, W)).
Proof:
  op(rdiv(X, a(Y, Z, W)), V)
= { by axiom 1 (sos) R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, zero))
= { by lemma 24 R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, 1))
= { by axiom 16 (sos) R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, a(a(Y, Z, W), rdiv(X, a(Y, Z, W)), V))) (peak)
= { by lemma 146 }
  ldiv(a(Y, Z, W), op(op(a(Y, Z, W), rdiv(X, a(Y, Z, W))), V))
= { by lemma 128 }
  ldiv(a(Y, Z, W), op(X, V))
= { by lemma 129 }
  rdiv(op(X, V), a(Y, Z, W))

Lemma 213: L(X, rdiv(Y, a(Z, W, V)), a(Z, W, V)) = X.
Proof:
  L(X, rdiv(Y, a(Z, W, V)), a(Z, W, V))
= { by lemma 211 R->L }
  ldiv(Y, op(a(Z, W, V), op(ldiv(a(Z, W, V), Y), X))) (peak)
= { by lemma 129 }
  ldiv(Y, op(a(Z, W, V), op(rdiv(Y, a(Z, W, V)), X)))
= { by lemma 212 }
  ldiv(Y, op(a(Z, W, V), rdiv(op(Y, X), a(Z, W, V))))
= { by lemma 128 }
  ldiv(Y, op(Y, X))
= { by axiom 4 (sos) }
  X

Lemma 214: L(X, Y, a(Z, W, V)) = X.
Proof:
  L(X, Y, a(Z, W, V))
= { by axiom 3 (sos) R->L }
  L(X, rdiv(op(Y, a(Z, W, V)), a(Z, W, V)), a(Z, W, V)) (peak)
= { by lemma 213 }
  X

Lemma 215: T(X, op(Y, a(Z, W, V))) = T(X, Y).
Proof:
  T(X, op(Y, a(Z, W, V))) (peak)
= { by lemma 111 R->L }
  T(X, op(a(Z, W, V), Y))
= { by axiom 5 (sos) }
  ldiv(op(a(Z, W, V), Y), op(X, op(a(Z, W, V), Y))) (peak)
= { by lemma 189 R->L }
  ldiv(op(a(Z, W, V), Y), op(a(Z, W, V), op(X, Y))) (peak)
= { by lemma 69 }
  L(T(X, Y), Y, a(Z, W, V))
= { by lemma 214 }
  T(X, Y)

Lemma 216: T(X, op(a(Y, Z, W), V)) = T(X, V).
Proof:
  T(X, op(a(Y, Z, W), V)) (peak)
= { by lemma 118 }
  T(X, op(V, a(Y, Z, W))) (peak)
= { by lemma 215 }
  T(X, V)

Lemma 217: T(X, L(Y, Z, W)) = T(X, Y).
Proof:
  T(X, L(Y, Z, W))
= { by lemma 216 R->L }
  T(X, op(a(W, Z, L(Y, Z, W)), L(Y, Z, W))) (peak)
= { by lemma 111 R->L }
  T(X, op(L(Y, Z, W), a(W, Z, L(Y, Z, W))))
= { by lemma 149 }
  T(X, Y)

Lemma 218: L(T(X, rdiv(Y, Z)), rdiv(Y, Z), Z) = ldiv(Y, op(Z, op(X, ldiv(Z, Y)))).
Proof:
  L(T(X, rdiv(Y, Z)), rdiv(Y, Z), Z)
= { by lemma 79 R->L }
  L(T(X, ldiv(Z, Y)), rdiv(Y, Z), Z)
= { by lemma 170 R->L }
  L(T(X, ldiv(Z, Y)), ldiv(Z, Y), Z)
= { by lemma 159 R->L }
  ldiv(Y, op(Z, op(ldiv(Z, Y), T(X, ldiv(Z, Y))))) (peak)
= { by lemma 63 }
  ldiv(Y, op(Z, op(X, ldiv(Z, Y))))

Lemma 219: op(X, rdiv(Y, a(Z, W, V))) = rdiv(op(X, Y), a(Z, W, V)).
Proof:
  op(X, rdiv(Y, a(Z, W, V)))
= { by lemma 196 R->L }
  rdiv(op(X, op(rdiv(Y, a(Z, W, V)), a(Z, W, V))), a(Z, W, V)) (peak)
= { by axiom 9 (sos) }
  rdiv(op(X, Y), a(Z, W, V))

Lemma 220: T(X, L(Y, Z, W)) = T(X, R(Y, V, U)).
Proof:
  T(X, L(Y, Z, W)) (peak)
= { by lemma 217 }
  T(X, Y)
= { by lemma 213 R->L }
  L(T(X, Y), rdiv(R(Y, V, U), a(Y, V, U)), a(Y, V, U))
= { by lemma 140 R->L }
  L(T(X, rdiv(R(Y, V, U), a(Y, V, U))), rdiv(R(Y, V, U), a(Y, V, U)), a(Y, V, U)) (peak)
= { by lemma 218 }
  ldiv(R(Y, V, U), op(a(Y, V, U), op(X, ldiv(a(Y, V, U), R(Y, V, U)))))
= { by lemma 129 }
  ldiv(R(Y, V, U), op(a(Y, V, U), op(X, rdiv(R(Y, V, U), a(Y, V, U)))))
= { by lemma 219 }
  ldiv(R(Y, V, U), op(a(Y, V, U), rdiv(op(X, R(Y, V, U)), a(Y, V, U))))
= { by lemma 128 }
  ldiv(R(Y, V, U), op(X, R(Y, V, U)))
= { by axiom 5 (sos) R->L }
  T(X, R(Y, V, U))

Lemma 221: op(K(X, Y), op(Z, Y)) = op(Z, rdiv(op(X, Y), X)).
Proof:
  op(K(X, Y), op(Z, Y)) (peak)
= { by lemma 37 }
  op(Z, op(Y, K(X, Y))) (peak)
= { by lemma 42 }
  op(Z, rdiv(op(X, Y), X)) (peak)

Lemma 222: op(X, rdiv(op(Z, Y), Z)) = rdiv(op(X, Y), K(Y, Z)).
Proof:
  op(X, rdiv(op(Z, Y), Z)) (peak)
= { by lemma 221 R->L }
  op(K(Z, Y), op(X, Y)) (peak)
= { by lemma 35 }
  op(op(X, Y), K(Z, Y)) (peak)
= { by lemma 62 }
  rdiv(op(X, Y), K(Y, Z))

Lemma 223: rdiv(op(X, Y), K(Z, X)) = op(T(X, Z), Y).
Proof:
  rdiv(op(X, Y), K(Z, X))
= { by lemma 61 R->L }
  op(K(X, Z), op(X, Y))
= { by lemma 36 R->L }
  op(op(X, K(X, Z)), Y) (peak)
= { by lemma 40 }
  op(T(X, Z), Y)

Lemma 224: op(X, rdiv(op(X, Y), X)) = op(T(X, Y), Y).
Proof:
  op(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 222 }
  rdiv(op(X, Y), K(Y, X)) (peak)
= { by lemma 223 }
  op(T(X, Y), Y)

Lemma 225: op(R(X, Y, ldiv(Y, Z)), Z) = op(op(X, Y), ldiv(Y, Z)).
Proof:
  op(R(X, Y, ldiv(Y, Z)), Z)
= { by axiom 8 (sos) R->L }
  op(R(X, Y, ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by lemma 134 }
  op(op(X, Y), ldiv(Y, Z))

Lemma 226: op(op(X, Y), ldiv(Y, zero)) = R(X, Y, ldiv(Y, zero)).
Proof:
  op(op(X, Y), ldiv(Y, zero))
= { by lemma 225 R->L }
  op(R(X, Y, ldiv(Y, zero)), zero) (peak)
= { by axiom 1 (sos) }
  R(X, Y, ldiv(Y, zero))

Lemma 227: op(R(X, rdiv(Y, Z), Z), Y) = op(op(X, rdiv(Y, Z)), Z).
Proof:
  op(R(X, rdiv(Y, Z), Z), Y)
= { by axiom 9 (sos) R->L }
  op(R(X, rdiv(Y, Z), Z), op(rdiv(Y, Z), Z)) (peak)
= { by lemma 134 }
  op(op(X, rdiv(Y, Z)), Z)

Lemma 228: op(op(X, rdiv(zero, Y)), Y) = R(X, rdiv(zero, Y), Y).
Proof:
  op(op(X, rdiv(zero, Y)), Y)
= { by lemma 227 R->L }
  op(R(X, rdiv(zero, Y), Y), zero) (peak)
= { by axiom 1 (sos) }
  R(X, rdiv(zero, Y), Y)

Lemma 229: op(rdiv(op(Z, X), Z), Y) = op(X, op(Y, K(Z, X))).
Proof:
  op(rdiv(op(Z, X), Z), Y) (peak)
= { by lemma 42 R->L }
  op(op(X, K(Z, X)), Y) (peak)
= { by lemma 36 }
  op(K(Z, X), op(X, Y))
= { by lemma 37 }
  op(X, op(Y, K(Z, X)))

Lemma 230: ldiv(op(Z, rdiv(Y, X)), op(Z, Y)) = L(X, rdiv(Y, X), Z).
Proof:
  ldiv(op(Z, rdiv(Y, X)), op(Z, Y))
= { by axiom 9 (sos) R->L }
  ldiv(op(Z, rdiv(Y, X)), op(Z, op(rdiv(Y, X), X))) (peak)
= { by axiom 19 (sos) R->L }
  L(X, rdiv(Y, X), Z)

Lemma 231: rdiv(op(X, Y), L(Z, rdiv(Y, Z), X)) = op(X, rdiv(Y, Z)).
Proof:
  rdiv(op(X, Y), L(Z, rdiv(Y, Z), X)) (peak)
= { by lemma 230 R->L }
  rdiv(op(X, Y), ldiv(op(X, rdiv(Y, Z)), op(X, Y))) (peak)
= { by lemma 90 }
  op(X, rdiv(Y, Z))

Lemma 232: rdiv(X, rdiv(Y, K(X, Z))) = rdiv(T(X, Z), Y).
Proof:
  rdiv(X, rdiv(Y, K(X, Z)))
= { by lemma 165 R->L }
  rdiv(rdiv(X, Y), K(Z, X))
= { by lemma 61 R->L }
  op(K(X, Z), rdiv(X, Y))
= { by lemma 231 R->L }
  rdiv(op(K(X, Z), X), L(Y, rdiv(X, Y), K(X, Z))) (peak)
= { by lemma 64 }
  rdiv(T(X, Z), L(Y, rdiv(X, Y), K(X, Z)))
= { by lemma 75 }
  rdiv(T(X, Z), Y)

Lemma 233: T(rdiv(X, K(X, Y)), op(Y, X)) = L(X, Y, rdiv(X, K(X, Y))).
Proof:
  T(rdiv(X, K(X, Y)), op(Y, X)) (peak)
= { by lemma 98 R->L }
  T(rdiv(op(Y, X), Y), op(Y, X))
= { by axiom 5 (sos) }
  ldiv(op(Y, X), op(rdiv(op(Y, X), Y), op(Y, X))) (peak)
= { by lemma 156 }
  L(X, Y, rdiv(op(Y, X), Y))
= { by lemma 98 }
  L(X, Y, rdiv(X, K(X, Y)))

Lemma 234: L(op(X, Y), K(Y, X), op(X, Y)) = T(op(X, Y), op(Y, X)).
Proof:
  L(op(X, Y), K(Y, X), op(X, Y))
= { by lemma 27 R->L }
  L(op(X, Y), K(Y, X), rdiv(op(X, Y), zero))
= { by lemma 24 R->L }
  L(op(X, Y), K(Y, X), rdiv(op(X, Y), 1))
= { by axiom 6 (sos) R->L }
  L(op(X, Y), K(Y, X), rdiv(op(X, Y), K(op(X, Y), K(Y, X))))
= { by lemma 233 R->L }
  T(rdiv(op(X, Y), K(op(X, Y), K(Y, X))), op(K(Y, X), op(X, Y))) (peak)
= { by lemma 38 }
  T(rdiv(op(X, Y), K(op(X, Y), K(Y, X))), op(Y, X))
= { by axiom 6 (sos) }
  T(rdiv(op(X, Y), 1), op(Y, X))
= { by lemma 24 }
  T(rdiv(op(X, Y), zero), op(Y, X))
= { by lemma 27 }
  T(op(X, Y), op(Y, X))

Lemma 235: rdiv(X, K(X, rdiv(Y, X))) = rdiv(Y, rdiv(Y, X)).
Proof:
  rdiv(X, K(X, rdiv(Y, X)))
= { by lemma 28 R->L }
  T(rdiv(X, K(X, rdiv(Y, X))), rdiv(X, K(X, rdiv(Y, X))))
= { by lemma 61 R->L }
  T(rdiv(X, K(X, rdiv(Y, X))), op(K(rdiv(Y, X), X), X))
= { by lemma 62 R->L }
  T(op(X, K(rdiv(Y, X), X)), op(K(rdiv(Y, X), X), X))
= { by lemma 234 R->L }
  L(op(X, K(rdiv(Y, X), X)), K(K(rdiv(Y, X), X), X), op(X, K(rdiv(Y, X), X))) (peak)
= { by lemma 168 }
  L(rdiv(Y, rdiv(Y, X)), K(K(rdiv(Y, X), X), X), op(X, K(rdiv(Y, X), X))) (peak)
= { by axiom 7 (sos) }
  L(rdiv(Y, rdiv(Y, X)), 1, op(X, K(rdiv(Y, X), X)))
= { by lemma 24 }
  L(rdiv(Y, rdiv(Y, X)), zero, op(X, K(rdiv(Y, X), X)))
= { by lemma 29 }
  rdiv(Y, rdiv(Y, X))

Lemma 236: rdiv(op(X, Y), T(Y, X)) = T(X, Y).
Proof:
  rdiv(op(X, Y), T(Y, X))
= { by lemma 103 R->L }
  rdiv(op(T(X, Y), T(Y, X)), T(Y, X)) (peak)
= { by axiom 3 (sos) }
  T(X, Y)

Lemma 237: rdiv(op(X, Y), T(Y, Z)) = rdiv(X, K(Y, Z)).
Proof:
  rdiv(op(X, Y), T(Y, Z))
= { by lemma 49 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), T(Y, Z))
= { by lemma 40 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), op(Y, K(Y, Z)))
= { by lemma 191 }
  R(rdiv(X, K(Y, Z)), K(Y, Z), T(Y, K(Y, Z))) (peak)
= { by lemma 72 }
  rdiv(X, K(Y, Z))

Lemma 238: rdiv(ldiv(X, Y), K(X, Z)) = ldiv(T(X, Z), Y).
Proof:
  rdiv(ldiv(X, Y), K(X, Z))
= { by lemma 50 R->L }
  ldiv(K(X, Z), ldiv(X, Y))
= { by lemma 209 R->L }
  L(ldiv(K(X, Z), ldiv(X, Y)), K(X, Z), X) (peak)
= { by lemma 160 }
  ldiv(op(X, K(X, Z)), Y)
= { by lemma 40 }
  ldiv(T(X, Z), Y)

Lemma 239: rdiv(rdiv(X, Y), ldiv(Y, X)) = K(Y, rdiv(X, Y)).
Proof:
  rdiv(rdiv(X, Y), ldiv(Y, X))
= { by axiom 8 (sos) R->L }
  rdiv(rdiv(op(Y, ldiv(Y, X)), Y), ldiv(Y, X)) (peak)
= { by lemma 95 }
  K(Y, ldiv(Y, X))
= { by lemma 113 }
  K(Y, rdiv(X, Y))

Lemma 240: rdiv(K(X, Y), K(X, Z)) = rdiv(T(X, Y), T(X, Z)).
Proof:
  rdiv(K(X, Y), K(X, Z))
= { by lemma 237 R->L }
  rdiv(op(K(X, Y), X), T(X, Z)) (peak)
= { by lemma 64 }
  rdiv(T(X, Y), T(X, Z))

Lemma 241: rdiv(op(X, Y), K(Z, rdiv(X, Z))) = op(op(ldiv(Z, X), Z), Y).
Proof:
  rdiv(op(X, Y), K(Z, rdiv(X, Z)))
= { by lemma 113 R->L }
  rdiv(op(X, Y), K(Z, ldiv(Z, X)))
= { by lemma 106 R->L }
  op(X, rdiv(Y, K(Z, ldiv(Z, X))))
= { by lemma 61 R->L }
  op(X, op(K(ldiv(Z, X), Z), Y))
= { by lemma 107 R->L }
  rdiv(op(op(X, K(ldiv(Z, X), Z)), Y), a(X, K(ldiv(Z, X), Z), Y)) (peak)
= { by lemma 31 }
  rdiv(op(op(ldiv(Z, X), Z), Y), a(X, K(ldiv(Z, X), Z), Y))
= { by axiom 12 (sos) }
  rdiv(op(op(ldiv(Z, X), Z), Y), 1)
= { by lemma 24 }
  rdiv(op(op(ldiv(Z, X), Z), Y), zero)
= { by lemma 27 }
  op(op(ldiv(Z, X), Z), Y)

Lemma 242: op(ldiv(X, Y), T(X, rdiv(Y, X))) = Y.
Proof:
  op(ldiv(X, Y), T(X, rdiv(Y, X)))
= { by lemma 40 R->L }
  op(ldiv(X, Y), op(X, K(X, rdiv(Y, X))))
= { by lemma 70 R->L }
  op(op(ldiv(X, Y), X), K(X, rdiv(Y, X)))
= { by lemma 241 R->L }
  rdiv(op(Y, K(X, rdiv(Y, X))), K(X, rdiv(Y, X))) (peak)
= { by axiom 3 (sos) }
  Y

Lemma 243: op(ldiv(ldiv(X, Y), Y), T(ldiv(X, Y), X)) = Y.
Proof:
  op(ldiv(ldiv(X, Y), Y), T(ldiv(X, Y), X))
= { by lemma 90 R->L }
  op(ldiv(ldiv(X, Y), Y), T(ldiv(X, Y), rdiv(Y, ldiv(X, Y)))) (peak)
= { by lemma 242 }
  Y

Lemma 244: rdiv(op(X, Y), K(rdiv(X, Z), Z)) = op(op(Z, rdiv(X, Z)), Y).
Proof:
  rdiv(op(X, Y), K(rdiv(X, Z), Z))
= { by lemma 106 R->L }
  op(X, rdiv(Y, K(rdiv(X, Z), Z)))
= { by lemma 61 R->L }
  op(X, op(K(Z, rdiv(X, Z)), Y))
= { by lemma 107 R->L }
  rdiv(op(op(X, K(Z, rdiv(X, Z))), Y), a(X, K(Z, rdiv(X, Z)), Y)) (peak)
= { by lemma 46 }
  rdiv(op(op(Z, rdiv(X, Z)), Y), a(X, K(Z, rdiv(X, Z)), Y))
= { by axiom 12 (sos) }
  rdiv(op(op(Z, rdiv(X, Z)), Y), 1)
= { by lemma 24 }
  rdiv(op(op(Z, rdiv(X, Z)), Y), zero)
= { by lemma 27 }
  op(op(Z, rdiv(X, Z)), Y)

Lemma 245: rdiv(op(Z, X), op(Y, T(Z, X))) = R(rdiv(X, Y), Y, T(Z, X)).
Proof:
  rdiv(op(Z, X), op(Y, T(Z, X)))
= { by lemma 63 R->L }
  rdiv(op(X, T(Z, X)), op(Y, T(Z, X))) (peak)
= { by lemma 43 }
  R(rdiv(X, Y), Y, T(Z, X)) (peak)

Lemma 246: rdiv(op(X, Y), rdiv(Z, K(Y, X))) = rdiv(op(Y, X), Z).
Proof:
  rdiv(op(X, Y), rdiv(Z, K(Y, X)))
= { by lemma 62 R->L }
  rdiv(op(X, Y), op(Z, K(X, Y)))
= { by lemma 85 R->L }
  rdiv(op(X, Y), op(Z, T(K(X, Y), op(Y, X))))
= { by lemma 38 R->L }
  rdiv(op(K(X, Y), op(Y, X)), op(Z, T(K(X, Y), op(Y, X)))) (peak)
= { by lemma 245 }
  R(rdiv(op(Y, X), Z), Z, T(K(X, Y), op(Y, X))) (peak)
= { by lemma 85 }
  R(rdiv(op(Y, X), Z), Z, K(X, Y))
= { by lemma 101 }
  rdiv(op(Y, X), Z)

Lemma 247: rdiv(op(X, rdiv(Y, X)), op(op(X, rdiv(Y, X)), Z)) = rdiv(Y, op(Y, Z)).
Proof:
  rdiv(op(X, rdiv(Y, X)), op(op(X, rdiv(Y, X)), Z))
= { by lemma 244 R->L }
  rdiv(op(X, rdiv(Y, X)), rdiv(op(Y, Z), K(rdiv(Y, X), X))) (peak)
= { by lemma 246 }
  rdiv(op(rdiv(Y, X), X), op(Y, Z))
= { by axiom 9 (sos) }
  rdiv(Y, op(Y, Z))

Lemma 248: rdiv(ldiv(X, Y), op(ldiv(X, Y), Z)) = rdiv(rdiv(Y, X), op(rdiv(Y, X), Z)).
Proof:
  rdiv(ldiv(X, Y), op(ldiv(X, Y), Z))
= { by lemma 48 R->L }
  rdiv(T(rdiv(Y, X), X), op(ldiv(X, Y), Z))
= { by lemma 232 R->L }
  rdiv(rdiv(Y, X), rdiv(op(ldiv(X, Y), Z), K(rdiv(Y, X), X)))
= { by lemma 61 R->L }
  rdiv(rdiv(Y, X), op(K(X, rdiv(Y, X)), op(ldiv(X, Y), Z)))
= { by lemma 36 R->L }
  rdiv(rdiv(Y, X), op(op(ldiv(X, Y), K(X, rdiv(Y, X))), Z))
= { by lemma 239 R->L }
  rdiv(rdiv(Y, X), op(op(ldiv(X, Y), rdiv(rdiv(Y, X), ldiv(X, Y))), Z))
= { by lemma 169 R->L }
  rdiv(op(ldiv(X, Y), K(X, rdiv(Y, X))), op(op(ldiv(X, Y), rdiv(rdiv(Y, X), ldiv(X, Y))), Z))
= { by lemma 239 R->L }
  rdiv(op(ldiv(X, Y), rdiv(rdiv(Y, X), ldiv(X, Y))), op(op(ldiv(X, Y), rdiv(rdiv(Y, X), ldiv(X, Y))), Z)) (peak)
= { by lemma 247 }
  rdiv(rdiv(Y, X), op(rdiv(Y, X), Z))

Lemma 249: rdiv(T(X, rdiv(Y, X)), Y) = rdiv(X, op(ldiv(X, Y), X)).
Proof:
  rdiv(T(X, rdiv(Y, X)), Y) (peak)
= { by lemma 80 R->L }
  rdiv(ldiv(ldiv(X, Y), Y), Y)
= { by lemma 243 R->L }
  rdiv(ldiv(ldiv(X, Y), Y), op(ldiv(ldiv(X, Y), Y), T(ldiv(X, Y), X))) (peak)
= { by lemma 248 }
  rdiv(rdiv(Y, ldiv(X, Y)), op(rdiv(Y, ldiv(X, Y)), T(ldiv(X, Y), X)))
= { by lemma 90 }
  rdiv(rdiv(Y, ldiv(X, Y)), op(X, T(ldiv(X, Y), X)))
= { by lemma 90 }
  rdiv(X, op(X, T(ldiv(X, Y), X)))
= { by lemma 63 }
  rdiv(X, op(ldiv(X, Y), X))

Lemma 250: op(ldiv(X, Y), a(Z, W, V)) = ldiv(X, op(Y, a(Z, W, V))).
Proof:
  op(ldiv(X, Y), a(Z, W, V))
= { by lemma 172 R->L }
  ldiv(R(X, ldiv(X, Y), a(Z, W, V)), op(Y, a(Z, W, V))) (peak)
= { by lemma 118 R->L }
  ldiv(R(X, ldiv(X, Y), a(Z, W, V)), op(a(Z, W, V), Y)) (peak)
= { by lemma 139 }
  ldiv(X, op(a(Z, W, V), Y))
= { by lemma 118 }
  ldiv(X, op(Y, a(Z, W, V)))

Lemma 251: rdiv(ldiv(X, op(Y, a(Z, W, V))), a(Z, W, V)) = ldiv(X, Y).
Proof:
  rdiv(ldiv(X, op(Y, a(Z, W, V))), a(Z, W, V))
= { by lemma 250 R->L }
  rdiv(op(ldiv(X, Y), a(Z, W, V)), a(Z, W, V)) (peak)
= { by axiom 3 (sos) }
  ldiv(X, Y)

Lemma 252: ldiv(X, rdiv(Y, a(Z, W, V))) = rdiv(ldiv(X, Y), a(Z, W, V)).
Proof:
  ldiv(X, rdiv(Y, a(Z, W, V)))
= { by lemma 251 R->L }
  rdiv(ldiv(X, op(rdiv(Y, a(Z, W, V)), a(Z, W, V))), a(Z, W, V)) (peak)
= { by axiom 9 (sos) }
  rdiv(ldiv(X, Y), a(Z, W, V))

Lemma 253: T(R(rdiv(X, Y), Y, Z), op(Y, Z)) = ldiv(op(Y, Z), op(X, Z)).
Proof:
  T(R(rdiv(X, Y), Y, Z), op(Y, Z)) (peak)
= { by lemma 43 R->L }
  T(rdiv(op(X, Z), op(Y, Z)), op(Y, Z)) (peak)
= { by lemma 48 }
  ldiv(op(Y, Z), op(X, Z))

Lemma 254: ldiv(op(X, a(Y, Z, W)), op(V, a(Y, Z, W))) = ldiv(X, V).
Proof:
  ldiv(op(X, a(Y, Z, W)), op(V, a(Y, Z, W)))
= { by lemma 253 R->L }
  T(R(rdiv(V, X), X, a(Y, Z, W)), op(X, a(Y, Z, W))) (peak)
= { by lemma 118 R->L }
  T(R(rdiv(V, X), X, a(Y, Z, W)), op(a(Y, Z, W), X)) (peak)
= { by lemma 216 }
  T(R(rdiv(V, X), X, a(Y, Z, W)), X)
= { by lemma 139 }
  T(rdiv(V, X), X)
= { by lemma 48 }
  ldiv(X, V)

Lemma 255: ldiv(rdiv(X, a(Y, Z, W)), V) = ldiv(X, op(V, a(Y, Z, W))).
Proof:
  ldiv(rdiv(X, a(Y, Z, W)), V)
= { by lemma 254 R->L }
  ldiv(op(rdiv(X, a(Y, Z, W)), a(Y, Z, W)), op(V, a(Y, Z, W))) (peak)
= { by axiom 9 (sos) }
  ldiv(X, op(V, a(Y, Z, W)))

Lemma 256: a(X, Y, rdiv(Z, a(W, V, U))) = a(X, Y, Z).
Proof:
  a(X, Y, rdiv(Z, a(W, V, U)))
= { by lemma 135 R->L }
  ldiv(op(X, op(Y, rdiv(Z, a(W, V, U)))), op(op(X, Y), rdiv(Z, a(W, V, U)))) (peak)
= { by lemma 219 }
  ldiv(op(X, op(Y, rdiv(Z, a(W, V, U)))), rdiv(op(op(X, Y), Z), a(W, V, U)))
= { by lemma 252 }
  rdiv(ldiv(op(X, op(Y, rdiv(Z, a(W, V, U)))), op(op(X, Y), Z)), a(W, V, U))
= { by lemma 219 }
  rdiv(ldiv(op(X, rdiv(op(Y, Z), a(W, V, U))), op(op(X, Y), Z)), a(W, V, U))
= { by lemma 219 }
  rdiv(ldiv(rdiv(op(X, op(Y, Z)), a(W, V, U)), op(op(X, Y), Z)), a(W, V, U))
= { by lemma 255 }
  rdiv(ldiv(op(X, op(Y, Z)), op(op(op(X, Y), Z), a(W, V, U))), a(W, V, U))
= { by lemma 251 }
  ldiv(op(X, op(Y, Z)), op(op(X, Y), Z))
= { by lemma 135 }
  a(X, Y, Z)

Lemma 257: a(X, Y, R(Z, W, V)) = a(X, Y, Z).
Proof:
  a(X, Y, R(Z, W, V))
= { by lemma 256 R->L }
  a(X, Y, rdiv(R(Z, W, V), a(Z, W, V))) (peak)
= { by lemma 140 }
  a(X, Y, Z)

Lemma 258: a(a(X, Y, Z), W, V) = zero.
Proof:
  a(a(X, Y, Z), W, V) (peak)
= { by axiom 16 (sos) }
  1
= { by lemma 24 }
  zero

Lemma 259: rdiv(op(T(X, Y), Z), K(X, Y)) = op(X, Z).
Proof:
  rdiv(op(T(X, Y), Z), K(X, Y))
= { by lemma 116 R->L }
  rdiv(op(T(X, Y), Z), K(T(X, Y), Y))
= { by lemma 106 R->L }
  op(T(X, Y), rdiv(Z, K(T(X, Y), Y)))
= { by lemma 62 R->L }
  op(T(X, Y), op(Z, K(Y, T(X, Y)))) (peak)
= { by lemma 229 R->L }
  op(rdiv(op(Y, T(X, Y)), Y), Z)
= { by lemma 63 }
  op(rdiv(op(X, Y), Y), Z)
= { by axiom 3 (sos) }
  op(X, Z)

Lemma 260: ldiv(op(T(X, Y), Z), op(X, Z)) = K(Y, X).
Proof:
  ldiv(op(T(X, Y), Z), op(X, Z))
= { by lemma 259 R->L }
  ldiv(op(T(X, Y), Z), rdiv(op(T(X, Y), Z), K(X, Y))) (peak)
= { by lemma 180 R->L }
  L(ldiv(K(X, Y), zero), K(X, Y), rdiv(op(T(X, Y), Z), K(X, Y))) (peak)
= { by lemma 209 }
  ldiv(K(X, Y), zero)
= { by lemma 50 }
  rdiv(zero, K(X, Y))
= { by lemma 56 }
  K(Y, X)

Lemma 261: ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) = op(Y, Z).
Proof:
  ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) (peak)
= { by lemma 43 R->L }
  ldiv(rdiv(op(X, Z), op(Y, Z)), op(X, Z)) (peak)
= { by lemma 30 }
  op(Y, Z)

Lemma 262: ldiv(op(X, rdiv(Y, X)), op(Y, Z)) = rdiv(Z, K(X, rdiv(Y, X))).
Proof:
  ldiv(op(X, rdiv(Y, X)), op(Y, Z))
= { by lemma 72 R->L }
  ldiv(R(op(X, rdiv(Y, X)), K(rdiv(Y, X), X), Z), op(Y, Z))
= { by lemma 204 R->L }
  ldiv(R(rdiv(Y, K(rdiv(Y, X), X)), K(rdiv(Y, X), X), Z), op(Y, Z)) (peak)
= { by lemma 261 }
  op(K(rdiv(Y, X), X), Z)
= { by lemma 61 }
  rdiv(Z, K(X, rdiv(Y, X)))

Lemma 263: rdiv(ldiv(X, Y), K(Z, rdiv(X, Z))) = ldiv(op(Z, rdiv(X, Z)), Y).
Proof:
  rdiv(ldiv(X, Y), K(Z, rdiv(X, Z)))
= { by lemma 262 R->L }
  ldiv(op(Z, rdiv(X, Z)), op(X, ldiv(X, Y))) (peak)
= { by axiom 8 (sos) }
  ldiv(op(Z, rdiv(X, Z)), Y)

Lemma 264: T(X, rdiv(Y, op(Z, rdiv(W, Z)))) = T(X, rdiv(Y, W)).
Proof:
  T(X, rdiv(Y, op(Z, rdiv(W, Z))))
= { by lemma 79 R->L }
  T(X, ldiv(op(Z, rdiv(W, Z)), Y))
= { by lemma 75 R->L }
  L(T(X, ldiv(op(Z, rdiv(W, Z)), Y)), rdiv(Y, W), K(Z, rdiv(W, Z)))
= { by lemma 170 R->L }
  L(T(X, ldiv(op(Z, rdiv(W, Z)), Y)), ldiv(W, Y), K(Z, rdiv(W, Z)))
= { by lemma 166 R->L }
  L(T(X, ldiv(op(Z, rdiv(W, Z)), Y)), rdiv(ldiv(W, Y), K(Z, rdiv(W, Z))), K(Z, rdiv(W, Z)))
= { by lemma 263 R->L }
  L(T(X, rdiv(ldiv(W, Y), K(Z, rdiv(W, Z)))), rdiv(ldiv(W, Y), K(Z, rdiv(W, Z))), K(Z, rdiv(W, Z))) (peak)
= { by lemma 218 }
  ldiv(ldiv(W, Y), op(K(Z, rdiv(W, Z)), op(X, ldiv(K(Z, rdiv(W, Z)), ldiv(W, Y)))))
= { by lemma 61 }
  ldiv(ldiv(W, Y), rdiv(op(X, ldiv(K(Z, rdiv(W, Z)), ldiv(W, Y))), K(rdiv(W, Z), Z)))
= { by lemma 162 }
  rdiv(ldiv(ldiv(W, Y), op(X, ldiv(K(Z, rdiv(W, Z)), ldiv(W, Y)))), K(rdiv(W, Z), Z))
= { by lemma 50 }
  rdiv(ldiv(ldiv(W, Y), op(X, rdiv(ldiv(W, Y), K(Z, rdiv(W, Z))))), K(rdiv(W, Z), Z))
= { by lemma 106 }
  rdiv(ldiv(ldiv(W, Y), rdiv(op(X, ldiv(W, Y)), K(Z, rdiv(W, Z)))), K(rdiv(W, Z), Z))
= { by lemma 162 }
  rdiv(rdiv(ldiv(ldiv(W, Y), op(X, ldiv(W, Y))), K(Z, rdiv(W, Z))), K(rdiv(W, Z), Z))
= { by lemma 202 }
  rdiv(ldiv(ldiv(W, Y), op(X, ldiv(W, Y))), rdiv(K(rdiv(W, Z), Z), K(rdiv(W, Z), Z)))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, ldiv(W, Y)), rdiv(K(rdiv(W, Z), Z), K(rdiv(W, Z), Z)))
= { by lemma 79 }
  rdiv(T(X, rdiv(Y, W)), rdiv(K(rdiv(W, Z), Z), K(rdiv(W, Z), Z)))
= { by lemma 240 }
  rdiv(T(X, rdiv(Y, W)), rdiv(T(rdiv(W, Z), Z), T(rdiv(W, Z), Z)))
= { by lemma 26 }
  rdiv(T(X, rdiv(Y, W)), zero)
= { by lemma 27 }
  T(X, rdiv(Y, W))

Lemma 265: T(X, op(Y, op(Z, rdiv(W, Z)))) = T(X, op(Y, W)).
Proof:
  T(X, op(Y, op(Z, rdiv(W, Z)))) (peak)
= { by lemma 111 R->L }
  T(X, op(op(Z, rdiv(W, Z)), Y))
= { by lemma 75 R->L }
  L(T(X, op(op(Z, rdiv(W, Z)), Y)), op(W, Y), K(rdiv(W, Z), Z))
= { by lemma 166 R->L }
  L(T(X, op(op(Z, rdiv(W, Z)), Y)), rdiv(op(W, Y), K(rdiv(W, Z), Z)), K(rdiv(W, Z), Z))
= { by lemma 244 R->L }
  L(T(X, rdiv(op(W, Y), K(rdiv(W, Z), Z))), rdiv(op(W, Y), K(rdiv(W, Z), Z)), K(rdiv(W, Z), Z)) (peak)
= { by lemma 218 }
  ldiv(op(W, Y), op(K(rdiv(W, Z), Z), op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y)))))
= { by lemma 61 }
  ldiv(op(W, Y), rdiv(op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y))), K(Z, rdiv(W, Z))))
= { by lemma 162 }
  rdiv(ldiv(op(W, Y), op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y)))), K(Z, rdiv(W, Z)))
= { by lemma 50 }
  rdiv(ldiv(op(W, Y), op(X, rdiv(op(W, Y), K(rdiv(W, Z), Z)))), K(Z, rdiv(W, Z)))
= { by lemma 106 }
  rdiv(ldiv(op(W, Y), rdiv(op(X, op(W, Y)), K(rdiv(W, Z), Z))), K(Z, rdiv(W, Z)))
= { by lemma 162 }
  rdiv(rdiv(ldiv(op(W, Y), op(X, op(W, Y))), K(rdiv(W, Z), Z)), K(Z, rdiv(W, Z)))
= { by lemma 202 }
  rdiv(ldiv(op(W, Y), op(X, op(W, Y))), rdiv(K(Z, rdiv(W, Z)), K(Z, rdiv(W, Z))))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, op(W, Y)), rdiv(K(Z, rdiv(W, Z)), K(Z, rdiv(W, Z))))
= { by lemma 26 }
  rdiv(T(X, op(W, Y)), zero)
= { by lemma 27 }
  T(X, op(W, Y))
= { by lemma 111 }
  T(X, op(Y, W))

Lemma 266: T(X, op(Y, T(Z, W))) = T(X, op(Y, Z)).
Proof:
  T(X, op(Y, T(Z, W))) (peak)
= { by lemma 111 R->L }
  T(X, op(T(Z, W), Y))
= { by lemma 223 R->L }
  T(X, rdiv(op(Z, Y), K(W, Z))) (peak)
= { by lemma 76 }
  T(X, op(Z, Y))
= { by lemma 111 }
  T(X, op(Y, Z))

Lemma 267: T(X, op(Y, ldiv(Z, W))) = T(X, op(Y, rdiv(W, Z))).
Proof:
  T(X, op(Y, ldiv(Z, W)))
= { by lemma 265 R->L }
  T(X, op(Y, op(K(rdiv(W, Z), Z), rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))))) (peak)
= { by lemma 207 }
  T(X, op(Y, op(K(rdiv(W, Z), Z), rdiv(W, Z))))
= { by lemma 64 }
  T(X, op(Y, T(rdiv(W, Z), Z)))
= { by lemma 266 }
  T(X, op(Y, rdiv(W, Z)))

Lemma 268: T(X, op(Y, rdiv(Z, Y))) = T(X, Z).
Proof:
  T(X, op(Y, rdiv(Z, Y)))
= { by lemma 111 R->L }
  T(X, op(rdiv(Z, Y), Y)) (peak)
= { by axiom 9 (sos) }
  T(X, Z)

Lemma 269: T(X, rdiv(Y, T(Z, W))) = T(X, rdiv(Y, Z)).
Proof:
  T(X, rdiv(Y, T(Z, W)))
= { by lemma 76 R->L }
  T(X, rdiv(rdiv(Y, T(Z, W)), K(W, Z)))
= { by lemma 61 R->L }
  T(X, op(K(Z, W), rdiv(Y, T(Z, W))))
= { by lemma 267 R->L }
  T(X, op(K(Z, W), ldiv(T(Z, W), Y)))
= { by lemma 238 R->L }
  T(X, op(K(Z, W), rdiv(ldiv(Z, Y), K(Z, W)))) (peak)
= { by lemma 268 }
  T(X, ldiv(Z, Y))
= { by lemma 79 }
  T(X, rdiv(Y, Z))

Lemma 270: T(X, rdiv(Y, ldiv(Z, W))) = T(X, rdiv(Y, rdiv(W, Z))).
Proof:
  T(X, rdiv(Y, ldiv(Z, W)))
= { by lemma 264 R->L }
  T(X, rdiv(Y, op(K(rdiv(W, Z), Z), rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))))) (peak)
= { by lemma 207 }
  T(X, rdiv(Y, op(K(rdiv(W, Z), Z), rdiv(W, Z))))
= { by lemma 64 }
  T(X, rdiv(Y, T(rdiv(W, Z), Z)))
= { by lemma 269 }
  T(X, rdiv(Y, rdiv(W, Z)))

Lemma 271: K(rdiv(X, ldiv(Y, Z)), W) = K(rdiv(X, rdiv(Z, Y)), W).
Proof:
  K(rdiv(X, ldiv(Y, Z)), W)
= { by lemma 260 R->L }
  ldiv(op(T(W, rdiv(X, ldiv(Y, Z))), V), op(W, V)) (peak)
= { by lemma 270 }
  ldiv(op(T(W, rdiv(X, rdiv(Z, Y))), V), op(W, V))
= { by lemma 260 }
  K(rdiv(X, rdiv(Z, Y)), W)

Lemma 272: T(X, R(L(Y, V, U), T, S)) = T(X, R(Y, Z, W)).
Proof:
  T(X, R(L(Y, V, U), T, S))
= { by axiom 5 (sos) }
  ldiv(R(L(Y, V, U), T, S), op(X, R(L(Y, V, U), T, S)))
= { by lemma 128 R->L }
  ldiv(R(L(Y, V, U), T, S), op(a(L(Y, V, U), T, S), rdiv(op(X, R(L(Y, V, U), T, S)), a(L(Y, V, U), T, S))))
= { by lemma 219 R->L }
  ldiv(R(L(Y, V, U), T, S), op(a(L(Y, V, U), T, S), op(X, rdiv(R(L(Y, V, U), T, S), a(L(Y, V, U), T, S)))))
= { by lemma 129 R->L }
  ldiv(R(L(Y, V, U), T, S), op(a(L(Y, V, U), T, S), op(X, ldiv(a(L(Y, V, U), T, S), R(L(Y, V, U), T, S)))))
= { by lemma 218 R->L }
  L(T(X, rdiv(R(L(Y, V, U), T, S), a(L(Y, V, U), T, S))), rdiv(R(L(Y, V, U), T, S), a(L(Y, V, U), T, S)), a(L(Y, V, U), T, S)) (peak)
= { by lemma 140 }
  L(T(X, L(Y, V, U)), rdiv(R(L(Y, V, U), T, S), a(L(Y, V, U), T, S)), a(L(Y, V, U), T, S))
= { by lemma 213 }
  T(X, L(Y, V, U))
= { by lemma 220 }
  T(X, R(Y, Z, W)) (peak)

Lemma 273: K(X, R(L(Y, V, U), T, S)) = K(X, R(Y, Z, W)).
Proof:
  K(X, R(L(Y, V, U), T, S))
= { by lemma 66 R->L }
  ldiv(X, T(X, R(L(Y, V, U), T, S))) (peak)
= { by lemma 272 }
  ldiv(X, T(X, R(Y, Z, W))) (peak)
= { by lemma 66 }
  K(X, R(Y, Z, W))

Lemma 274: rdiv(L(X, Y, Z), K(W, X)) = T(L(X, Y, Z), W).
Proof:
  rdiv(L(X, Y, Z), K(W, X))
= { by lemma 237 R->L }
  rdiv(op(L(X, Y, Z), W), T(W, X))
= { by lemma 217 R->L }
  rdiv(op(L(X, Y, Z), W), T(W, L(X, Y, Z))) (peak)
= { by lemma 236 }
  T(L(X, Y, Z), W)

Lemma 275: rdiv(L(R(X, Y, Z), W, V), K(U, R(L(X, T, S), X2, Y2))) = T(L(R(X, Y, Z), W, V), U).
Proof:
  rdiv(L(R(X, Y, Z), W, V), K(U, R(L(X, T, S), X2, Y2))) (peak)
= { by lemma 273 }
  rdiv(L(R(X, Y, Z), W, V), K(U, R(X, Y, Z))) (peak)
= { by lemma 274 }
  T(L(R(X, Y, Z), W, V), U)

Lemma 276: rdiv(R(X, Y, rdiv(zero, Y)), ldiv(Y, zero)) = op(X, Y).
Proof:
  rdiv(R(X, Y, rdiv(zero, Y)), ldiv(Y, zero))
= { by lemma 125 R->L }
  rdiv(R(X, Y, ldiv(Y, zero)), ldiv(Y, zero))
= { by lemma 226 R->L }
  rdiv(op(op(X, Y), ldiv(Y, zero)), ldiv(Y, zero)) (peak)
= { by axiom 3 (sos) }
  op(X, Y)

Lemma 277: R(X, rdiv(Y, L(Y, Z, W)), V) = X.
Proof:
  R(X, rdiv(Y, L(Y, Z, W)), V)
= { by lemma 186 R->L }
  R(X, ldiv(L(Y, Z, W), Y), V) (peak)
= { by lemma 185 R->L }
  R(X, a(W, Z, L(Y, Z, W)), V) (peak)
= { by lemma 132 }
  X

Lemma 278: ldiv(rdiv(X, L(X, Y, Z)), W) = rdiv(W, rdiv(X, L(X, Y, Z))).
Proof:
  ldiv(rdiv(X, L(X, Y, Z)), W)
= { by lemma 186 R->L }
  ldiv(ldiv(L(X, Y, Z), X), W) (peak)
= { by lemma 185 R->L }
  ldiv(a(Z, Y, L(X, Y, Z)), W) (peak)
= { by lemma 129 }
  rdiv(W, a(Z, Y, L(X, Y, Z)))
= { by lemma 150 }
  rdiv(W, rdiv(X, L(X, Y, Z))) (peak)

Lemma 279: op(X, rdiv(Y, L(Y, Z, W))) = rdiv(X, rdiv(L(Y, Z, W), Y)).
Proof:
  op(X, rdiv(Y, L(Y, Z, W)))
= { by lemma 276 R->L }
  rdiv(R(X, rdiv(Y, L(Y, Z, W)), rdiv(zero, rdiv(Y, L(Y, Z, W)))), ldiv(rdiv(Y, L(Y, Z, W)), zero)) (peak)
= { by lemma 155 }
  rdiv(R(X, rdiv(Y, L(Y, Z, W)), ldiv(Y, L(Y, Z, W))), ldiv(rdiv(Y, L(Y, Z, W)), zero))
= { by lemma 277 }
  rdiv(X, ldiv(rdiv(Y, L(Y, Z, W)), zero))
= { by lemma 278 }
  rdiv(X, rdiv(zero, rdiv(Y, L(Y, Z, W))))
= { by lemma 155 }
  rdiv(X, ldiv(Y, L(Y, Z, W)))
= { by lemma 178 }
  rdiv(X, rdiv(L(Y, Z, W), Y))

Lemma 280: T(X, rdiv(Y, rdiv(L(Z, W, V), Z))) = T(X, Y).
Proof:
  T(X, rdiv(Y, rdiv(L(Z, W, V), Z)))
= { by lemma 279 R->L }
  T(X, op(Y, rdiv(Z, L(Z, W, V))))
= { by lemma 267 R->L }
  T(X, op(Y, ldiv(L(Z, W, V), Z))) (peak)
= { by lemma 185 R->L }
  T(X, op(Y, a(V, W, L(Z, W, V)))) (peak)
= { by lemma 215 }
  T(X, Y)

Lemma 281: ldiv(rdiv(L(X, Y, Z), W), X) = rdiv(W, rdiv(L(X, Y, Z), X)).
Proof:
  ldiv(rdiv(L(X, Y, Z), W), X)
= { by lemma 139 R->L }
  ldiv(R(rdiv(L(X, Y, Z), W), W, a(Z, Y, L(X, Y, Z))), X)
= { by lemma 149 R->L }
  ldiv(R(rdiv(L(X, Y, Z), W), W, a(Z, Y, L(X, Y, Z))), op(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))) (peak)
= { by lemma 261 }
  op(W, a(Z, Y, L(X, Y, Z)))
= { by lemma 150 }
  op(W, rdiv(X, L(X, Y, Z)))
= { by lemma 279 }
  rdiv(W, rdiv(L(X, Y, Z), X))

Lemma 282: rdiv(ldiv(X, L(Y, Z, W)), rdiv(L(Y, Z, W), Y)) = ldiv(X, Y).
Proof:
  rdiv(ldiv(X, L(Y, Z, W)), rdiv(L(Y, Z, W), Y))
= { by lemma 281 R->L }
  ldiv(rdiv(L(Y, Z, W), ldiv(X, L(Y, Z, W))), Y) (peak)
= { by lemma 90 }
  ldiv(X, Y)

Lemma 283: T(X, rdiv(L(Y, Z, W), V)) = T(X, rdiv(Y, V)).
Proof:
  T(X, rdiv(L(Y, Z, W), V))
= { by lemma 79 R->L }
  T(X, ldiv(V, L(Y, Z, W)))
= { by lemma 280 R->L }
  T(X, rdiv(ldiv(V, L(Y, Z, W)), rdiv(L(Y, Z, W), Y))) (peak)
= { by lemma 282 }
  T(X, ldiv(V, Y))
= { by lemma 79 }
  T(X, rdiv(Y, V))

Lemma 284: op(X, op(Y, a(X, Z, ldiv(Z, Y)))) = op(op(X, Z), ldiv(Z, Y)).
Proof:
  op(X, op(Y, a(X, Z, ldiv(Z, Y))))
= { by lemma 138 R->L }
  op(op(X, Y), a(X, Z, ldiv(Z, Y)))
= { by axiom 8 (sos) R->L }
  op(op(X, op(Z, ldiv(Z, Y))), a(X, Z, ldiv(Z, Y))) (peak)
= { by axiom 20 (sos) R->L }
  op(op(X, Z), ldiv(Z, Y))

Lemma 285: op(X, a(X, Y, ldiv(Y, zero))) = R(X, Y, rdiv(zero, Y)).
Proof:
  op(X, a(X, Y, ldiv(Y, zero)))
= { by axiom 2 (sos) R->L }
  op(X, op(zero, a(X, Y, ldiv(Y, zero)))) (peak)
= { by lemma 284 }
  op(op(X, Y), ldiv(Y, zero))
= { by lemma 226 }
  R(X, Y, ldiv(Y, zero))
= { by lemma 125 }
  R(X, Y, rdiv(zero, Y))

Lemma 286: T(X, R(Y, Z, rdiv(zero, Z))) = T(X, Y).
Proof:
  T(X, R(Y, Z, rdiv(zero, Z)))
= { by lemma 285 R->L }
  T(X, op(Y, a(Y, Z, ldiv(Z, zero)))) (peak)
= { by lemma 215 }
  T(X, Y)

Lemma 287: T(X, op(Y, rdiv(zero, Z))) = T(X, rdiv(Y, Z)).
Proof:
  T(X, op(Y, rdiv(zero, Z)))
= { by lemma 76 R->L }
  T(X, rdiv(op(Y, rdiv(zero, Z)), K(Z, rdiv(zero, Z))))
= { by lemma 33 R->L }
  T(X, rdiv(op(Y, rdiv(zero, Z)), op(Z, rdiv(zero, Z)))) (peak)
= { by lemma 43 }
  T(X, R(rdiv(Y, Z), Z, rdiv(zero, Z)))
= { by lemma 286 }
  T(X, rdiv(Y, Z))

Lemma 288: T(X, rdiv(op(Z, Y), W)) = T(X, rdiv(op(Y, Z), W)).
Proof:
  T(X, rdiv(op(Z, Y), W))
= { by lemma 79 R->L }
  T(X, ldiv(W, op(Z, Y)))
= { by lemma 75 R->L }
  L(T(X, ldiv(W, op(Z, Y))), rdiv(op(Y, Z), W), K(Y, Z))
= { by lemma 170 R->L }
  L(T(X, ldiv(W, op(Z, Y))), ldiv(W, op(Y, Z)), K(Y, Z))
= { by lemma 166 R->L }
  L(T(X, ldiv(W, op(Z, Y))), rdiv(ldiv(W, op(Y, Z)), K(Y, Z)), K(Y, Z))
= { by lemma 173 R->L }
  L(T(X, rdiv(ldiv(W, op(Y, Z)), K(Y, Z))), rdiv(ldiv(W, op(Y, Z)), K(Y, Z)), K(Y, Z)) (peak)
= { by lemma 218 }
  ldiv(ldiv(W, op(Y, Z)), op(K(Y, Z), op(X, ldiv(K(Y, Z), ldiv(W, op(Y, Z))))))
= { by lemma 61 }
  ldiv(ldiv(W, op(Y, Z)), rdiv(op(X, ldiv(K(Y, Z), ldiv(W, op(Y, Z)))), K(Z, Y)))
= { by lemma 162 }
  rdiv(ldiv(ldiv(W, op(Y, Z)), op(X, ldiv(K(Y, Z), ldiv(W, op(Y, Z))))), K(Z, Y))
= { by lemma 50 }
  rdiv(ldiv(ldiv(W, op(Y, Z)), op(X, rdiv(ldiv(W, op(Y, Z)), K(Y, Z)))), K(Z, Y))
= { by lemma 106 }
  rdiv(ldiv(ldiv(W, op(Y, Z)), rdiv(op(X, ldiv(W, op(Y, Z))), K(Y, Z))), K(Z, Y))
= { by lemma 162 }
  rdiv(rdiv(ldiv(ldiv(W, op(Y, Z)), op(X, ldiv(W, op(Y, Z)))), K(Y, Z)), K(Z, Y))
= { by lemma 202 }
  rdiv(ldiv(ldiv(W, op(Y, Z)), op(X, ldiv(W, op(Y, Z)))), rdiv(K(Z, Y), K(Z, Y)))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, ldiv(W, op(Y, Z))), rdiv(K(Z, Y), K(Z, Y)))
= { by lemma 79 }
  rdiv(T(X, rdiv(op(Y, Z), W)), rdiv(K(Z, Y), K(Z, Y)))
= { by lemma 26 }
  rdiv(T(X, rdiv(op(Y, Z), W)), zero)
= { by lemma 27 }
  T(X, rdiv(op(Y, Z), W))

Lemma 289: op(X, op(Y, a(X, rdiv(Y, Z), Z))) = op(op(X, rdiv(Y, Z)), Z).
Proof:
  op(X, op(Y, a(X, rdiv(Y, Z), Z)))
= { by lemma 138 R->L }
  op(op(X, Y), a(X, rdiv(Y, Z), Z))
= { by axiom 9 (sos) R->L }
  op(op(X, op(rdiv(Y, Z), Z)), a(X, rdiv(Y, Z), Z)) (peak)
= { by axiom 20 (sos) R->L }
  op(op(X, rdiv(Y, Z)), Z)

Lemma 290: op(rdiv(X, Y), op(Y, a(Z, W, V))) = op(X, a(Z, W, V)).
Proof:
  op(rdiv(X, Y), op(Y, a(Z, W, V)))
= { by lemma 152 R->L }
  op(op(a(Z, W, V), rdiv(X, Y)), Y)
= { by lemma 289 R->L }
  op(a(Z, W, V), op(X, a(a(Z, W, V), rdiv(X, Y), Y))) (peak)
= { by lemma 258 }
  op(a(Z, W, V), op(X, zero))
= { by axiom 1 (sos) }
  op(a(Z, W, V), X)
= { by lemma 118 }
  op(X, a(Z, W, V))

Lemma 291: op(rdiv(X, L(Y, Z, W)), Y) = rdiv(X, rdiv(L(Y, Z, W), Y)).
Proof:
  op(rdiv(X, L(Y, Z, W)), Y)
= { by lemma 149 R->L }
  op(rdiv(X, L(Y, Z, W)), op(L(Y, Z, W), a(W, Z, L(Y, Z, W)))) (peak)
= { by lemma 290 }
  op(X, a(W, Z, L(Y, Z, W)))
= { by lemma 150 }
  op(X, rdiv(Y, L(Y, Z, W)))
= { by lemma 279 }
  rdiv(X, rdiv(L(Y, Z, W), Y))

Lemma 292: rdiv(op(X, L(Y, Z, W)), rdiv(L(Y, Z, W), Y)) = op(X, Y).
Proof:
  rdiv(op(X, L(Y, Z, W)), rdiv(L(Y, Z, W), Y))
= { by lemma 291 R->L }
  op(rdiv(op(X, L(Y, Z, W)), L(Y, Z, W)), Y) (peak)
= { by axiom 3 (sos) }
  op(X, Y)

Lemma 293: T(X, op(Y, L(Z, W, V))) = T(X, op(Y, Z)).
Proof:
  T(X, op(Y, L(Z, W, V))) (peak)
= { by lemma 111 R->L }
  T(X, op(L(Z, W, V), Y))
= { by lemma 280 R->L }
  T(X, rdiv(op(L(Z, W, V), Y), rdiv(L(Z, W, V), Z))) (peak)
= { by lemma 288 }
  T(X, rdiv(op(Y, L(Z, W, V)), rdiv(L(Z, W, V), Z))) (peak)
= { by lemma 292 }
  T(X, op(Y, Z))

Lemma 294: T(X, op(Y, op(W, Z))) = T(X, op(Y, op(Z, W))).
Proof:
  T(X, op(Y, op(W, Z)))
= { by lemma 109 R->L }
  T(X, rdiv(op(Y, op(Z, W)), K(Z, W))) (peak)
= { by lemma 76 }
  T(X, op(Y, op(Z, W)))

Lemma 295: rdiv(op(X, Y), a(Z, ldiv(Z, X), Y)) = op(Z, op(ldiv(Z, X), Y)).
Proof:
  rdiv(op(X, Y), a(Z, ldiv(Z, X), Y))
= { by axiom 8 (sos) R->L }
  rdiv(op(op(Z, ldiv(Z, X)), Y), a(Z, ldiv(Z, X), Y)) (peak)
= { by lemma 107 }
  op(Z, op(ldiv(Z, X), Y))

Lemma 296: T(X, op(Y, op(Z, ldiv(Y, W)))) = T(X, op(Z, W)).
Proof:
  T(X, op(Y, op(Z, ldiv(Y, W)))) (peak)
= { by lemma 294 }
  T(X, op(Y, op(ldiv(Y, W), Z)))
= { by lemma 213 R->L }
  L(T(X, op(Y, op(ldiv(Y, W), Z))), rdiv(op(W, Z), a(Y, ldiv(Y, W), Z)), a(Y, ldiv(Y, W), Z))
= { by lemma 295 R->L }
  L(T(X, rdiv(op(W, Z), a(Y, ldiv(Y, W), Z))), rdiv(op(W, Z), a(Y, ldiv(Y, W), Z)), a(Y, ldiv(Y, W), Z)) (peak)
= { by lemma 218 }
  ldiv(op(W, Z), op(a(Y, ldiv(Y, W), Z), op(X, ldiv(a(Y, ldiv(Y, W), Z), op(W, Z)))))
= { by lemma 129 }
  ldiv(op(W, Z), op(a(Y, ldiv(Y, W), Z), op(X, rdiv(op(W, Z), a(Y, ldiv(Y, W), Z)))))
= { by lemma 219 }
  ldiv(op(W, Z), op(a(Y, ldiv(Y, W), Z), rdiv(op(X, op(W, Z)), a(Y, ldiv(Y, W), Z))))
= { by lemma 128 }
  ldiv(op(W, Z), op(X, op(W, Z)))
= { by axiom 5 (sos) R->L }
  T(X, op(W, Z))
= { by lemma 111 }
  T(X, op(Z, W))

Lemma 297: T(X, op(Y, rdiv(Z, ldiv(W, Y)))) = T(X, op(Z, W)).
Proof:
  T(X, op(Y, rdiv(Z, ldiv(W, Y))))
= { by lemma 111 R->L }
  T(X, op(rdiv(Z, ldiv(W, Y)), Y))
= { by lemma 296 R->L }
  T(X, op(W, op(rdiv(Z, ldiv(W, Y)), ldiv(W, Y)))) (peak)
= { by axiom 9 (sos) }
  T(X, op(W, Z))
= { by lemma 111 }
  T(X, op(Z, W))

Lemma 298: T(X, op(Y, rdiv(Z, W))) = T(X, op(Z, rdiv(Y, W))).
Proof:
  T(X, op(Y, rdiv(Z, W)))
= { by lemma 297 R->L }
  T(X, op(Z, rdiv(Y, ldiv(rdiv(Z, W), Z)))) (peak)
= { by lemma 30 }
  T(X, op(Z, rdiv(Y, W)))

Lemma 299: T(X, rdiv(Y, a(Z, W, V))) = T(X, Y).
Proof:
  T(X, rdiv(Y, a(Z, W, V)))
= { by lemma 215 R->L }
  T(X, op(rdiv(Y, a(Z, W, V)), a(Z, W, V))) (peak)
= { by axiom 9 (sos) }
  T(X, Y)

Lemma 300: T(X, op(Y, L(Z, W, V))) = T(X, op(Y, R(Z, U, T))).
Proof:
  T(X, op(Y, L(Z, W, V))) (peak)
= { by lemma 293 }
  T(X, op(Y, Z))
= { by lemma 140 R->L }
  T(X, op(Y, rdiv(R(Z, U, T), a(Z, U, T)))) (peak)
= { by lemma 298 }
  T(X, op(R(Z, U, T), rdiv(Y, a(Z, U, T)))) (peak)
= { by lemma 219 }
  T(X, rdiv(op(R(Z, U, T), Y), a(Z, U, T)))
= { by lemma 299 }
  T(X, op(R(Z, U, T), Y))
= { by lemma 111 }
  T(X, op(Y, R(Z, U, T)))

Lemma 301: T(X, op(L(Y, Z, W), V)) = T(X, op(V, R(Y, U, T))).
Proof:
  T(X, op(L(Y, Z, W), V)) (peak)
= { by lemma 111 R->L }
  T(X, op(V, L(Y, Z, W))) (peak)
= { by lemma 300 }
  T(X, op(V, R(Y, U, T))) (peak)

Lemma 302: T(X, op(rdiv(Y, Z), W)) = T(X, op(Y, rdiv(W, Z))).
Proof:
  T(X, op(rdiv(Y, Z), W)) (peak)
= { by lemma 111 R->L }
  T(X, op(W, rdiv(Y, Z))) (peak)
= { by lemma 298 }
  T(X, op(Y, rdiv(W, Z))) (peak)

Lemma 303: T(X, rdiv(L(Y, Z, W), V)) = T(X, rdiv(R(Y, U, T), V)).
Proof:
  T(X, rdiv(L(Y, Z, W), V))
= { by lemma 287 R->L }
  T(X, op(L(Y, Z, W), rdiv(zero, V))) (peak)
= { by lemma 301 }
  T(X, op(rdiv(zero, V), R(Y, U, T))) (peak)
= { by lemma 302 }
  T(X, op(zero, rdiv(R(Y, U, T), V)))
= { by axiom 2 (sos) }
  T(X, rdiv(R(Y, U, T), V))

Lemma 304: K(X, rdiv(L(Y, Z, W), V)) = K(X, rdiv(R(Y, U, T), V)).
Proof:
  K(X, rdiv(L(Y, Z, W), V))
= { by lemma 66 R->L }
  ldiv(X, T(X, rdiv(L(Y, Z, W), V))) (peak)
= { by lemma 303 }
  ldiv(X, T(X, rdiv(R(Y, U, T), V))) (peak)
= { by lemma 66 }
  K(X, rdiv(R(Y, U, T), V))

Lemma 305: rdiv(R(X, rdiv(zero, Y), Y), Y) = op(X, rdiv(zero, Y)).
Proof:
  rdiv(R(X, rdiv(zero, Y), Y), Y)
= { by lemma 228 R->L }
  rdiv(op(op(X, rdiv(zero, Y)), Y), Y) (peak)
= { by axiom 3 (sos) }
  op(X, rdiv(zero, Y))

Lemma 306: R(X, Y, rdiv(R(Z, W, V), Z)) = X.
Proof:
  R(X, Y, rdiv(R(Z, W, V), Z))
= { by lemma 144 R->L }
  R(X, Y, ldiv(Z, R(Z, W, V))) (peak)
= { by lemma 141 }
  R(X, Y, a(Z, W, V))
= { by lemma 139 }
  X

Lemma 307: op(X, rdiv(Y, R(Y, Z, W))) = rdiv(X, rdiv(R(Y, Z, W), Y)).
Proof:
  op(X, rdiv(Y, R(Y, Z, W)))
= { by lemma 184 R->L }
  op(X, ldiv(R(Y, Z, W), Y))
= { by lemma 181 R->L }
  op(X, rdiv(zero, rdiv(R(Y, Z, W), Y)))
= { by lemma 305 R->L }
  rdiv(R(X, rdiv(zero, rdiv(R(Y, Z, W), Y)), rdiv(R(Y, Z, W), Y)), rdiv(R(Y, Z, W), Y)) (peak)
= { by lemma 181 }
  rdiv(R(X, ldiv(R(Y, Z, W), Y), rdiv(R(Y, Z, W), Y)), rdiv(R(Y, Z, W), Y))
= { by lemma 306 }
  rdiv(X, rdiv(R(Y, Z, W), Y))

Lemma 308: ldiv(rdiv(R(X, Y, Z), X), W) = rdiv(W, rdiv(R(X, Y, Z), X)).
Proof:
  ldiv(rdiv(R(X, Y, Z), X), W)
= { by lemma 144 R->L }
  ldiv(ldiv(X, R(X, Y, Z)), W) (peak)
= { by lemma 141 }
  ldiv(a(X, Y, Z), W)
= { by lemma 129 }
  rdiv(W, a(X, Y, Z))
= { by lemma 143 R->L }
  rdiv(W, rdiv(R(X, Y, Z), X))

Lemma 309: op(rdiv(X, R(X, Y, Z)), W) = rdiv(W, rdiv(R(X, Y, Z), X)).
Proof:
  op(rdiv(X, R(X, Y, Z)), W)
= { by lemma 184 R->L }
  op(ldiv(R(X, Y, Z), X), W)
= { by lemma 25 R->L }
  ldiv(zero, op(ldiv(R(X, Y, Z), X), W))
= { by lemma 181 R->L }
  ldiv(zero, op(rdiv(zero, rdiv(R(X, Y, Z), X)), W))
= { by lemma 179 R->L }
  L(ldiv(rdiv(R(X, Y, Z), X), W), rdiv(R(X, Y, Z), X), rdiv(zero, rdiv(R(X, Y, Z), X))) (peak)
= { by lemma 182 }
  ldiv(rdiv(R(X, Y, Z), X), W)
= { by lemma 308 }
  rdiv(W, rdiv(R(X, Y, Z), X))

Lemma 310: K(X, rdiv(R(Y, Z, W), R(L(Y, V, U), T, S))) = zero.
Proof:
  K(X, rdiv(R(Y, Z, W), R(L(Y, V, U), T, S))) (peak)
= { by lemma 304 R->L }
  K(X, rdiv(L(Y, V, U), R(L(Y, V, U), T, S)))
= { by lemma 83 R->L }
  ldiv(op(rdiv(L(Y, V, U), R(L(Y, V, U), T, S)), X), op(X, rdiv(L(Y, V, U), R(L(Y, V, U), T, S)))) (peak)
= { by lemma 307 }
  ldiv(op(rdiv(L(Y, V, U), R(L(Y, V, U), T, S)), X), rdiv(X, rdiv(R(L(Y, V, U), T, S), L(Y, V, U))))
= { by lemma 309 }
  ldiv(rdiv(X, rdiv(R(L(Y, V, U), T, S), L(Y, V, U))), rdiv(X, rdiv(R(L(Y, V, U), T, S), L(Y, V, U))))
= { by lemma 22 }
  zero

Lemma 311: T(X, rdiv(R(Y, Z, W), R(L(Y, V, U), T, S))) = X.
Proof:
  T(X, rdiv(R(Y, Z, W), R(L(Y, V, U), T, S)))
= { by lemma 40 R->L }
  op(X, K(X, rdiv(R(Y, Z, W), R(L(Y, V, U), T, S)))) (peak)
= { by lemma 310 }
  op(X, zero)
= { by axiom 1 (sos) }
  X

Lemma 312: op(R(L(X, Y, Z), W, V), rdiv(L(R(X, U, T), S, X2), R(L(X, Y, Z), W, V))) = L(R(X, U, T), S, X2).
Proof:
  op(R(L(X, Y, Z), W, V), rdiv(L(R(X, U, T), S, X2), R(L(X, Y, Z), W, V)))
= { by lemma 204 R->L }
  rdiv(L(R(X, U, T), S, X2), K(rdiv(L(R(X, U, T), S, X2), R(L(X, Y, Z), W, V)), R(L(X, Y, Z), W, V))) (peak)
= { by lemma 275 }
  T(L(R(X, U, T), S, X2), rdiv(L(R(X, U, T), S, X2), R(L(X, Y, Z), W, V)))
= { by lemma 283 }
  T(L(R(X, U, T), S, X2), rdiv(R(X, U, T), R(L(X, Y, Z), W, V)))
= { by lemma 311 }
  L(R(X, U, T), S, X2)

Lemma 313: ldiv(R(X, Y, Z), op(X, W)) = rdiv(W, rdiv(R(X, Y, Z), X)).
Proof:
  ldiv(R(X, Y, Z), op(X, W))
= { by lemma 140 R->L }
  ldiv(R(X, Y, Z), op(rdiv(R(X, Y, Z), a(X, Y, Z)), W))
= { by lemma 179 R->L }
  L(ldiv(a(X, Y, Z), W), a(X, Y, Z), rdiv(R(X, Y, Z), a(X, Y, Z))) (peak)
= { by lemma 153 }
  ldiv(a(X, Y, Z), W)
= { by lemma 129 }
  rdiv(W, a(X, Y, Z))
= { by lemma 143 R->L }
  rdiv(W, rdiv(R(X, Y, Z), X))

Lemma 314: rdiv(ldiv(X, Y), rdiv(R(X, Z, W), X)) = ldiv(R(X, Z, W), Y).
Proof:
  rdiv(ldiv(X, Y), rdiv(R(X, Z, W), X))
= { by lemma 313 R->L }
  ldiv(R(X, Z, W), op(X, ldiv(X, Y))) (peak)
= { by axiom 8 (sos) }
  ldiv(R(X, Z, W), Y)

Lemma 315: ldiv(op(X, op(Y, Z)), op(X, op(Z, Y))) = K(Z, Y).
Proof:
  ldiv(op(X, op(Y, Z)), op(X, op(Z, Y)))
= { by lemma 34 R->L }
  ldiv(op(X, rdiv(op(Z, Y), K(Z, Y))), op(X, op(Z, Y))) (peak)
= { by lemma 230 }
  L(K(Z, Y), rdiv(op(Z, Y), K(Z, Y)), X)
= { by lemma 86 }
  K(Z, Y)

Lemma 316: K(rdiv(X, a(Y, Z, W)), V) = K(X, V).
Proof:
  K(rdiv(X, a(Y, Z, W)), V)
= { by lemma 315 R->L }
  ldiv(op(U, op(V, rdiv(X, a(Y, Z, W)))), op(U, op(rdiv(X, a(Y, Z, W)), V))) (peak)
= { by lemma 212 }
  ldiv(op(U, op(V, rdiv(X, a(Y, Z, W)))), op(U, rdiv(op(X, V), a(Y, Z, W))))
= { by lemma 219 }
  ldiv(op(U, rdiv(op(V, X), a(Y, Z, W))), op(U, rdiv(op(X, V), a(Y, Z, W))))
= { by lemma 219 }
  ldiv(rdiv(op(U, op(V, X)), a(Y, Z, W)), op(U, rdiv(op(X, V), a(Y, Z, W))))
= { by lemma 255 }
  ldiv(op(U, op(V, X)), op(op(U, rdiv(op(X, V), a(Y, Z, W))), a(Y, Z, W)))
= { by lemma 138 }
  ldiv(op(U, op(V, X)), op(U, op(rdiv(op(X, V), a(Y, Z, W)), a(Y, Z, W))))
= { by lemma 212 }
  ldiv(op(U, op(V, X)), op(U, rdiv(op(op(X, V), a(Y, Z, W)), a(Y, Z, W))))
= { by lemma 219 }
  ldiv(op(U, op(V, X)), rdiv(op(U, op(op(X, V), a(Y, Z, W))), a(Y, Z, W)))
= { by lemma 196 }
  ldiv(op(U, op(V, X)), op(U, op(X, V)))
= { by lemma 315 }
  K(X, V)

Lemma 317: K(rdiv(X, rdiv(R(Y, Z, W), Y)), V) = K(X, V).
Proof:
  K(rdiv(X, rdiv(R(Y, Z, W), Y)), V)
= { by lemma 271 R->L }
  K(rdiv(X, ldiv(Y, R(Y, Z, W))), V) (peak)
= { by lemma 141 }
  K(rdiv(X, a(Y, Z, W)), V)
= { by lemma 316 }
  K(X, V)

Lemma 318: ldiv(X, op(L(X, Y, Z), W)) = rdiv(W, rdiv(X, L(X, Y, Z))).
Proof:
  ldiv(X, op(L(X, Y, Z), W))
= { by lemma 149 R->L }
  ldiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), op(L(X, Y, Z), W))
= { by lemma 68 }
  L(ldiv(a(Z, Y, L(X, Y, Z)), W), a(Z, Y, L(X, Y, Z)), L(X, Y, Z)) (peak)
= { by lemma 153 }
  ldiv(a(Z, Y, L(X, Y, Z)), W)
= { by lemma 129 }
  rdiv(W, a(Z, Y, L(X, Y, Z)))
= { by lemma 150 }
  rdiv(W, rdiv(X, L(X, Y, Z)))

Lemma 319: rdiv(ldiv(L(X, Y, Z), W), rdiv(X, L(X, Y, Z))) = ldiv(X, W).
Proof:
  rdiv(ldiv(L(X, Y, Z), W), rdiv(X, L(X, Y, Z)))
= { by lemma 318 R->L }
  ldiv(X, op(L(X, Y, Z), ldiv(L(X, Y, Z), W))) (peak)
= { by axiom 8 (sos) }
  ldiv(X, W)

Lemma 320: op(rdiv(Y, L(Y, Z, W)), X) = op(X, rdiv(Y, L(Y, Z, W))).
Proof:
  op(rdiv(Y, L(Y, Z, W)), X)
= { by lemma 186 R->L }
  op(ldiv(L(Y, Z, W), Y), X) (peak)
= { by lemma 185 R->L }
  op(a(W, Z, L(Y, Z, W)), X) (peak)
= { by lemma 118 }
  op(X, a(W, Z, L(Y, Z, W))) (peak)
= { by lemma 150 }
  op(X, rdiv(Y, L(Y, Z, W))) (peak)

Lemma 321: op(rdiv(X, L(X, Y, Z)), W) = rdiv(W, rdiv(L(X, Y, Z), X)).
Proof:
  op(rdiv(X, L(X, Y, Z)), W) (peak)
= { by lemma 320 }
  op(W, rdiv(X, L(X, Y, Z))) (peak)
= { by lemma 279 }
  rdiv(W, rdiv(L(X, Y, Z), X))

Lemma 322: T(X, rdiv(Y, L(Z, W, V))) = T(X, rdiv(Y, Z)).
Proof:
  T(X, rdiv(Y, L(Z, W, V)))
= { by lemma 79 R->L }
  T(X, ldiv(L(Z, W, V), Y))
= { by lemma 268 R->L }
  T(X, op(rdiv(Z, L(Z, W, V)), rdiv(ldiv(L(Z, W, V), Y), rdiv(Z, L(Z, W, V))))) (peak)
= { by lemma 319 }
  T(X, op(rdiv(Z, L(Z, W, V)), ldiv(Z, Y)))
= { by lemma 267 }
  T(X, op(rdiv(Z, L(Z, W, V)), rdiv(Y, Z)))
= { by lemma 321 }
  T(X, rdiv(rdiv(Y, Z), rdiv(L(Z, W, V), Z)))
= { by lemma 280 }
  T(X, rdiv(Y, Z))

Lemma 323: K(rdiv(X, L(Y, W, V)), Z) = K(rdiv(X, Y), Z).
Proof:
  K(rdiv(X, L(Y, W, V)), Z)
= { by lemma 97 R->L }
  rdiv(Z, T(Z, rdiv(X, L(Y, W, V))))
= { by lemma 92 R->L }
  ldiv(T(Z, rdiv(X, L(Y, W, V))), Z) (peak)
= { by lemma 322 }
  ldiv(T(Z, rdiv(X, Y)), Z)
= { by lemma 89 }
  K(rdiv(X, Y), Z)

Lemma 324: K(rdiv(X, L(Y, Z, W)), V) = K(rdiv(X, R(Y, U, T)), V).
Proof:
  K(rdiv(X, L(Y, Z, W)), V) (peak)
= { by lemma 323 }
  K(rdiv(X, Y), V)
= { by lemma 117 R->L }
  K(ldiv(Y, X), V)
= { by lemma 317 R->L }
  K(rdiv(ldiv(Y, X), rdiv(R(Y, U, T), Y)), V) (peak)
= { by lemma 314 }
  K(ldiv(R(Y, U, T), X), V)
= { by lemma 117 }
  K(rdiv(X, R(Y, U, T)), V)

Lemma 325: K(rdiv(X, R(L(Y, U, T), S, X2)), V) = K(rdiv(X, R(Y, Z, W)), V).
Proof:
  K(rdiv(X, R(L(Y, U, T), S, X2)), V)
= { by lemma 117 R->L }
  K(ldiv(R(L(Y, U, T), S, X2), X), V)
= { by lemma 314 R->L }
  K(rdiv(ldiv(L(Y, U, T), X), rdiv(R(L(Y, U, T), S, X2), L(Y, U, T))), V) (peak)
= { by lemma 317 }
  K(ldiv(L(Y, U, T), X), V)
= { by lemma 117 }
  K(rdiv(X, L(Y, U, T)), V)
= { by lemma 324 }
  K(rdiv(X, R(Y, Z, W)), V) (peak)

Lemma 326: op(R(L(X, V, U), T, S), rdiv(W, R(L(X, V, U), T, S))) = op(R(X, Y, Z), rdiv(W, R(X, Y, Z))).
Proof:
  op(R(L(X, V, U), T, S), rdiv(W, R(L(X, V, U), T, S)))
= { by lemma 204 R->L }
  rdiv(W, K(rdiv(W, R(L(X, V, U), T, S)), R(L(X, V, U), T, S))) (peak)
= { by lemma 273 }
  rdiv(W, K(rdiv(W, R(L(X, V, U), T, S)), R(X, Y, Z))) (peak)
= { by lemma 325 }
  rdiv(W, K(rdiv(W, R(X, Y, Z)), R(X, Y, Z))) (peak)
= { by lemma 204 }
  op(R(X, Y, Z), rdiv(W, R(X, Y, Z)))

Lemma 327: ldiv(rdiv(X, Y), op(X, a(Z, W, V))) = op(Y, a(Z, W, V)).
Proof:
  ldiv(rdiv(X, Y), op(X, a(Z, W, V))) (peak)
= { by lemma 118 R->L }
  ldiv(rdiv(X, Y), op(a(Z, W, V), X))
= { by lemma 139 R->L }
  ldiv(R(rdiv(X, Y), Y, a(Z, W, V)), op(a(Z, W, V), X)) (peak)
= { by lemma 118 }
  ldiv(R(rdiv(X, Y), Y, a(Z, W, V)), op(X, a(Z, W, V))) (peak)
= { by lemma 261 }
  op(Y, a(Z, W, V))

Lemma 328: op(L(X, V, U), a(Y, Z, W)) = L(op(X, a(Y, Z, W)), V, U).
Proof:
  op(L(X, V, U), a(Y, Z, W))
= { by lemma 327 R->L }
  ldiv(rdiv(op(U, op(V, X)), L(X, V, U)), op(op(U, op(V, X)), a(Y, Z, W))) (peak)
= { by lemma 195 }
  ldiv(op(U, V), op(op(U, op(V, X)), a(Y, Z, W)))
= { by lemma 138 }
  ldiv(op(U, V), op(U, op(op(V, X), a(Y, Z, W))))
= { by lemma 138 }
  ldiv(op(U, V), op(U, op(V, op(X, a(Y, Z, W)))))
= { by axiom 19 (sos) R->L }
  L(op(X, a(Y, Z, W)), V, U)

Lemma 329: op(L(X, Y, Z), rdiv(R(X, W, V), X)) = L(R(X, W, V), Y, Z).
Proof:
  op(L(X, Y, Z), rdiv(R(X, W, V), X)) (peak)
= { by lemma 143 }
  op(L(X, Y, Z), a(X, W, V))
= { by lemma 328 }
  L(op(X, a(X, W, V)), Y, Z)
= { by lemma 141 R->L }
  L(op(X, ldiv(X, R(X, W, V))), Y, Z)
= { by axiom 8 (sos) }
  L(R(X, W, V), Y, Z)

Lemma 330: T(rdiv(X, Y), L(Y, Z, W)) = ldiv(Y, X).
Proof:
  T(rdiv(X, Y), L(Y, Z, W)) (peak)
= { by lemma 217 }
  T(rdiv(X, Y), Y)
= { by lemma 48 }
  ldiv(Y, X)

Lemma 331: op(L(Y, Z, W), ldiv(Y, X)) = op(rdiv(X, Y), L(Y, Z, W)).
Proof:
  op(L(Y, Z, W), ldiv(Y, X))
= { by lemma 330 R->L }
  op(L(Y, Z, W), T(rdiv(X, Y), L(Y, Z, W))) (peak)
= { by lemma 63 }
  op(rdiv(X, Y), L(Y, Z, W))

Lemma 332: ldiv(op(rdiv(Z, op(Y, X)), Y), Z) = L(X, Y, rdiv(Z, op(Y, X))).
Proof:
  ldiv(op(rdiv(Z, op(Y, X)), Y), Z)
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(Z, op(Y, X)), Y), op(rdiv(Z, op(Y, X)), op(Y, X))) (peak)
= { by axiom 19 (sos) R->L }
  L(X, Y, rdiv(Z, op(Y, X)))

Lemma 333: ldiv(op(L(X, Y, Z), ldiv(X, W)), W) = rdiv(X, L(X, Y, Z)).
Proof:
  ldiv(op(L(X, Y, Z), ldiv(X, W)), W) (peak)
= { by lemma 331 }
  ldiv(op(rdiv(W, X), L(X, Y, Z)), W)
= { by lemma 149 R->L }
  ldiv(op(rdiv(W, op(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))), L(X, Y, Z)), W) (peak)
= { by lemma 332 }
  L(a(Z, Y, L(X, Y, Z)), L(X, Y, Z), rdiv(W, op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))))) (peak)
= { by lemma 194 }
  a(Z, Y, L(X, Y, Z))
= { by lemma 150 }
  rdiv(X, L(X, Y, Z))

Lemma 334: ldiv(op(L(X, Y, Z), W), op(X, W)) = rdiv(X, L(X, Y, Z)).
Proof:
  ldiv(op(L(X, Y, Z), W), op(X, W))
= { by axiom 4 (sos) R->L }
  ldiv(op(L(X, Y, Z), ldiv(X, op(X, W))), op(X, W)) (peak)
= { by lemma 333 }
  rdiv(X, L(X, Y, Z))

Lemma 335: ldiv(op(L(X, Y, Z), W), op(W, X)) = rdiv(X, T(L(X, Y, Z), W)).
Proof:
  ldiv(op(L(X, Y, Z), W), op(W, X))
= { by lemma 173 R->L }
  rdiv(ldiv(op(L(X, Y, Z), W), op(X, W)), K(X, W)) (peak)
= { by lemma 334 }
  rdiv(rdiv(X, L(X, Y, Z)), K(X, W))
= { by lemma 165 }
  rdiv(X, rdiv(L(X, Y, Z), K(W, X)))
= { by lemma 198 R->L }
  rdiv(X, rdiv(L(X, Y, Z), K(W, L(X, Y, Z)))) (peak)
= { by lemma 93 }
  rdiv(X, T(L(X, Y, Z), W))

Lemma 336: T(X, rdiv(R(Y, Z, W), L(Y, V, U))) = X.
Proof:
  T(X, rdiv(R(Y, Z, W), L(Y, V, U))) (peak)
= { by lemma 322 }
  T(X, rdiv(R(Y, Z, W), Y))
= { by lemma 79 R->L }
  T(X, ldiv(Y, R(Y, Z, W)))
= { by lemma 141 }
  T(X, a(Y, Z, W))
= { by lemma 119 }
  X

Lemma 337: rdiv(R(X, W, V), L(R(X, W, V), Y, Z)) = rdiv(X, L(X, Y, Z)).
Proof:
  rdiv(R(X, W, V), L(R(X, W, V), Y, Z))
= { by lemma 186 R->L }
  ldiv(L(R(X, W, V), Y, Z), R(X, W, V))
= { by axiom 9 (sos) R->L }
  ldiv(L(R(X, W, V), Y, Z), op(rdiv(R(X, W, V), X), X))
= { by lemma 329 R->L }
  ldiv(op(L(X, Y, Z), rdiv(R(X, W, V), X)), op(rdiv(R(X, W, V), X), X)) (peak)
= { by lemma 335 }
  rdiv(X, T(L(X, Y, Z), rdiv(R(X, W, V), X)))
= { by lemma 322 R->L }
  rdiv(X, T(L(X, Y, Z), rdiv(R(X, W, V), L(X, U, T)))) (peak)
= { by lemma 336 }
  rdiv(X, L(X, Y, Z))

Lemma 338: rdiv(R(Z, W, V), L(R(Z, W, V), Y, X)) = a(X, Y, L(Z, Y, X)).
Proof:
  rdiv(R(Z, W, V), L(R(Z, W, V), Y, X)) (peak)
= { by lemma 337 }
  rdiv(Z, L(Z, Y, X))
= { by lemma 149 R->L }
  rdiv(op(L(Z, Y, X), a(X, Y, L(Z, Y, X))), L(Z, Y, X)) (peak)
= { by lemma 145 }
  a(X, Y, L(Z, Y, X))

Lemma 339: rdiv(R(Z, U, T), L(R(Z, U, T), Y, X)) = a(X, Y, R(L(Z, Y, X), W, V)).
Proof:
  rdiv(R(Z, U, T), L(R(Z, U, T), Y, X)) (peak)
= { by lemma 338 }
  a(X, Y, L(Z, Y, X))
= { by lemma 257 R->L }
  a(X, Y, R(L(Z, Y, X), W, V)) (peak)

Lemma 340: rdiv(op(X, Y), rdiv(Y, a(Z, W, V))) = op(X, a(Z, W, V)).
Proof:
  rdiv(op(X, Y), rdiv(Y, a(Z, W, V)))
= { by lemma 214 R->L }
  rdiv(op(X, Y), rdiv(L(Y, X, a(Z, W, V)), a(Z, W, V)))
= { by lemma 192 R->L }
  rdiv(op(op(X, Y), a(Z, W, V)), L(Y, X, a(Z, W, V))) (peak)
= { by lemma 118 R->L }
  rdiv(op(a(Z, W, V), op(X, Y)), L(Y, X, a(Z, W, V))) (peak)
= { by lemma 195 }
  op(a(Z, W, V), X)
= { by lemma 118 }
  op(X, a(Z, W, V))

Lemma 341: rdiv(op(R(X, Y, W), op(Y, W)), op(Z, W)) = R(rdiv(op(X, Y), Z), Z, W).
Proof:
  rdiv(op(R(X, Y, W), op(Y, W)), op(Z, W)) (peak)
= { by lemma 134 }
  rdiv(op(op(X, Y), W), op(Z, W))
= { by lemma 43 }
  R(rdiv(op(X, Y), Z), Z, W) (peak)

Lemma 342: rdiv(rdiv(X, a(Y, Z, W)), V) = rdiv(X, op(V, a(Y, Z, W))).
Proof:
  rdiv(rdiv(X, a(Y, Z, W)), V)
= { by lemma 139 R->L }
  R(rdiv(rdiv(X, a(Y, Z, W)), V), V, a(Y, Z, W)) (peak)
= { by lemma 164 }
  rdiv(X, op(V, a(Y, Z, W)))

Lemma 343: R(X, rdiv(Y, a(Z, W, V)), U) = R(X, Y, U).
Proof:
  R(X, rdiv(Y, a(Z, W, V)), U)
= { by axiom 18 (sos) }
  rdiv(op(op(X, rdiv(Y, a(Z, W, V))), U), op(rdiv(Y, a(Z, W, V)), U)) (peak)
= { by lemma 212 }
  rdiv(op(op(X, rdiv(Y, a(Z, W, V))), U), rdiv(op(Y, U), a(Z, W, V)))
= { by lemma 219 }
  rdiv(op(rdiv(op(X, Y), a(Z, W, V)), U), rdiv(op(Y, U), a(Z, W, V)))
= { by lemma 212 }
  rdiv(rdiv(op(op(X, Y), U), a(Z, W, V)), rdiv(op(Y, U), a(Z, W, V)))
= { by lemma 342 }
  rdiv(op(op(X, Y), U), op(rdiv(op(Y, U), a(Z, W, V)), a(Z, W, V)))
= { by lemma 212 }
  rdiv(op(op(X, Y), U), rdiv(op(op(Y, U), a(Z, W, V)), a(Z, W, V)))
= { by lemma 192 }
  rdiv(op(op(X, Y), U), rdiv(op(Y, U), rdiv(a(Z, W, V), a(Z, W, V))))
= { by lemma 26 }
  rdiv(op(op(X, Y), U), rdiv(op(Y, U), zero))
= { by lemma 27 }
  rdiv(op(op(X, Y), U), op(Y, U))
= { by axiom 18 (sos) R->L }
  R(X, Y, U)

Lemma 344: op(R(X, V, U), a(Y, Z, W)) = R(op(X, a(Y, Z, W)), V, U).
Proof:
  op(R(X, V, U), a(Y, Z, W))
= { by lemma 340 R->L }
  rdiv(op(R(X, V, U), op(V, U)), rdiv(op(V, U), a(Y, Z, W)))
= { by lemma 212 R->L }
  rdiv(op(R(X, V, U), op(V, U)), op(rdiv(V, a(Y, Z, W)), U)) (peak)
= { by lemma 341 }
  R(rdiv(op(X, V), rdiv(V, a(Y, Z, W))), rdiv(V, a(Y, Z, W)), U) (peak)
= { by lemma 340 }
  R(op(X, a(Y, Z, W)), rdiv(V, a(Y, Z, W)), U)
= { by lemma 343 }
  R(op(X, a(Y, Z, W)), V, U)

Lemma 345: ldiv(L(X, Y, Z), L(R(X, W, V), Y, Z)) = rdiv(R(X, W, V), X).
Proof:
  ldiv(L(X, Y, Z), L(R(X, W, V), Y, Z))
= { by lemma 329 R->L }
  ldiv(L(X, Y, Z), op(L(X, Y, Z), rdiv(R(X, W, V), X))) (peak)
= { by axiom 4 (sos) }
  rdiv(R(X, W, V), X)

Lemma 346: op(L(X, Y, Z), ldiv(X, W)) = rdiv(W, rdiv(X, L(X, Y, Z))).
Proof:
  op(L(X, Y, Z), ldiv(X, W))
= { by lemma 90 R->L }
  rdiv(W, ldiv(op(L(X, Y, Z), ldiv(X, W)), W)) (peak)
= { by lemma 333 }
  rdiv(W, rdiv(X, L(X, Y, Z)))

Lemma 347: rdiv(L(X, Y, Z), rdiv(W, rdiv(X, L(X, Y, Z)))) = rdiv(X, W).
Proof:
  rdiv(L(X, Y, Z), rdiv(W, rdiv(X, L(X, Y, Z)))) (peak)
= { by lemma 150 R->L }
  rdiv(L(X, Y, Z), rdiv(W, a(Z, Y, L(X, Y, Z))))
= { by lemma 193 R->L }
  rdiv(op(a(Z, Y, L(X, Y, Z)), L(X, Y, Z)), W)
= { by lemma 246 R->L }
  rdiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), rdiv(W, K(a(Z, Y, L(X, Y, Z)), L(X, Y, Z)))) (peak)
= { by lemma 149 }
  rdiv(X, rdiv(W, K(a(Z, Y, L(X, Y, Z)), L(X, Y, Z))))
= { by axiom 11 (sos) }
  rdiv(X, rdiv(W, 1))
= { by lemma 24 }
  rdiv(X, rdiv(W, zero))
= { by lemma 27 }
  rdiv(X, W)

Lemma 348: rdiv(L(X, W, V), L(R(X, Y, Z), W, V)) = rdiv(X, R(X, Y, Z)).
Proof:
  rdiv(L(X, W, V), L(R(X, Y, Z), W, V))
= { by lemma 336 R->L }
  rdiv(T(L(X, W, V), rdiv(R(X, Y, Z), L(X, W, V))), L(R(X, Y, Z), W, V))
= { by lemma 283 R->L }
  rdiv(T(L(X, W, V), rdiv(L(R(X, Y, Z), W, V), L(X, W, V))), L(R(X, Y, Z), W, V)) (peak)
= { by lemma 249 }
  rdiv(L(X, W, V), op(ldiv(L(X, W, V), L(R(X, Y, Z), W, V)), L(X, W, V)))
= { by lemma 345 }
  rdiv(L(X, W, V), op(rdiv(R(X, Y, Z), X), L(X, W, V)))
= { by lemma 331 R->L }
  rdiv(L(X, W, V), op(L(X, W, V), ldiv(X, R(X, Y, Z))))
= { by lemma 346 }
  rdiv(L(X, W, V), rdiv(R(X, Y, Z), rdiv(X, L(X, W, V))))
= { by lemma 347 }
  rdiv(X, R(X, Y, Z))

Lemma 349: rdiv(L(X, W, V), L(R(X, Y, Z), W, V)) = ldiv(R(X, Y, Z), X).
Proof:
  rdiv(L(X, W, V), L(R(X, Y, Z), W, V)) (peak)
= { by lemma 348 }
  rdiv(X, R(X, Y, Z))
= { by lemma 183 R->L }
  rdiv(op(ldiv(R(X, Y, Z), X), R(X, Y, Z)), R(X, Y, Z)) (peak)
= { by axiom 3 (sos) }
  ldiv(R(X, Y, Z), X)

Lemma 350: R(X, rdiv(R(Y, Z, W), Y), V) = X.
Proof:
  R(X, rdiv(R(Y, Z, W), Y), V)
= { by lemma 144 R->L }
  R(X, ldiv(Y, R(Y, Z, W)), V) (peak)
= { by lemma 141 }
  R(X, a(Y, Z, W), V)
= { by lemma 132 }
  X

Lemma 351: rdiv(X, rdiv(L(Y, V, U), L(R(Y, Z, W), V, U))) = op(X, rdiv(R(Y, Z, W), Y)).
Proof:
  rdiv(X, rdiv(L(Y, V, U), L(R(Y, Z, W), V, U))) (peak)
= { by lemma 349 }
  rdiv(X, ldiv(R(Y, Z, W), Y))
= { by lemma 181 R->L }
  rdiv(X, rdiv(zero, rdiv(R(Y, Z, W), Y)))
= { by lemma 308 R->L }
  rdiv(X, ldiv(rdiv(R(Y, Z, W), Y), zero))
= { by lemma 350 R->L }
  rdiv(R(X, rdiv(R(Y, Z, W), Y), ldiv(R(Y, Z, W), Y)), ldiv(rdiv(R(Y, Z, W), Y), zero))
= { by lemma 181 R->L }
  rdiv(R(X, rdiv(R(Y, Z, W), Y), rdiv(zero, rdiv(R(Y, Z, W), Y))), ldiv(rdiv(R(Y, Z, W), Y), zero)) (peak)
= { by lemma 276 }
  op(X, rdiv(R(Y, Z, W), Y))

Lemma 352: T(rdiv(R(X, Y, Z), X), W) = rdiv(R(X, Y, Z), X).
Proof:
  T(rdiv(R(X, Y, Z), X), W)
= { by lemma 144 R->L }
  T(ldiv(X, R(X, Y, Z)), W) (peak)
= { by lemma 141 }
  T(a(X, Y, Z), W)
= { by lemma 190 }
  a(X, Y, Z)
= { by lemma 143 R->L }
  rdiv(R(X, Y, Z), X)

Lemma 353: op(rdiv(R(Y, Z, W), Y), X) = op(X, rdiv(R(Y, Z, W), Y)).
Proof:
  op(rdiv(R(Y, Z, W), Y), X)
= { by lemma 144 R->L }
  op(ldiv(Y, R(Y, Z, W)), X) (peak)
= { by lemma 141 }
  op(a(Y, Z, W), X)
= { by lemma 118 }
  op(X, a(Y, Z, W))
= { by lemma 143 R->L }
  op(X, rdiv(R(Y, Z, W), Y)) (peak)

Lemma 354: L(ldiv(X, Y), X, rdiv(Z, Y)) = ldiv(op(rdiv(Z, Y), X), Z).
Proof:
  L(ldiv(X, Y), X, rdiv(Z, Y)) (peak)
= { by lemma 68 R->L }
  ldiv(op(rdiv(Z, Y), X), op(rdiv(Z, Y), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(op(rdiv(Z, Y), X), Z)

Lemma 355: rdiv(X, L(ldiv(Y, Z), Y, rdiv(X, Z))) = op(rdiv(X, Z), Y).
Proof:
  rdiv(X, L(ldiv(Y, Z), Y, rdiv(X, Z))) (peak)
= { by lemma 354 }
  rdiv(X, ldiv(op(rdiv(X, Z), Y), X)) (peak)
= { by lemma 90 }
  op(rdiv(X, Z), Y)

Lemma 356: L(X, Y, rdiv(R(Z, W, V), Z)) = X.
Proof:
  L(X, Y, rdiv(R(Z, W, V), Z))
= { by lemma 208 R->L }
  L(X, Y, ldiv(Z, R(Z, W, V))) (peak)
= { by lemma 141 }
  L(X, Y, a(Z, W, V))
= { by lemma 214 }
  X

Lemma 357: op(rdiv(R(X, Y, Z), X), W) = rdiv(R(X, Y, Z), ldiv(W, X)).
Proof:
  op(rdiv(R(X, Y, Z), X), W)
= { by lemma 355 R->L }
  rdiv(R(X, Y, Z), L(ldiv(W, X), W, rdiv(R(X, Y, Z), X))) (peak)
= { by lemma 356 }
  rdiv(R(X, Y, Z), ldiv(W, X))

Lemma 358: rdiv(W, rdiv(L(X, V, U), L(R(X, Y, Z), V, U))) = rdiv(R(X, Y, Z), ldiv(W, X)).
Proof:
  rdiv(W, rdiv(L(X, V, U), L(R(X, Y, Z), V, U))) (peak)
= { by lemma 351 }
  op(W, rdiv(R(X, Y, Z), X))
= { by lemma 352 R->L }
  op(W, T(rdiv(R(X, Y, Z), X), T))
= { by lemma 121 R->L }
  rdiv(op(W, rdiv(R(X, Y, Z), X)), K(T, rdiv(R(X, Y, Z), X))) (peak)
= { by lemma 353 R->L }
  rdiv(op(rdiv(R(X, Y, Z), X), W), K(T, rdiv(R(X, Y, Z), X))) (peak)
= { by lemma 223 }
  op(T(rdiv(R(X, Y, Z), X), T), W)
= { by lemma 352 }
  op(rdiv(R(X, Y, Z), X), W)
= { by lemma 357 }
  rdiv(R(X, Y, Z), ldiv(W, X))

Lemma 359: op(rdiv(X, rdiv(L(Y, Z, W), L(R(Y, V, U), Z, W))), T) = op(X, rdiv(T, rdiv(L(Y, S, X2), L(R(Y, V, U), S, X2)))).
Proof:
  op(rdiv(X, rdiv(L(Y, Z, W), L(R(Y, V, U), Z, W))), T) (peak)
= { by lemma 351 }
  op(op(X, rdiv(R(Y, V, U), Y)), T)
= { by lemma 143 }
  op(op(X, a(Y, V, U)), T)
= { by lemma 130 }
  op(X, op(T, a(Y, V, U)))
= { by lemma 141 R->L }
  op(X, op(T, ldiv(Y, R(Y, V, U))))
= { by lemma 144 }
  op(X, op(T, rdiv(R(Y, V, U), Y)))
= { by lemma 351 R->L }
  op(X, rdiv(T, rdiv(L(Y, S, X2), L(R(Y, V, U), S, X2)))) (peak)

Lemma 360: K(X, rdiv(Y, L(Y, Z, W))) = zero.
Proof:
  K(X, rdiv(Y, L(Y, Z, W)))
= { by lemma 115 R->L }
  K(X, ldiv(L(Y, Z, W), Y)) (peak)
= { by lemma 185 R->L }
  K(X, a(W, Z, L(Y, Z, W))) (peak)
= { by lemma 187 }
  zero

Lemma 361: op(L(X, Y, Z), rdiv(W, rdiv(L(X, V, U), L(R(X, T, S), V, U)))) = op(L(R(X, T, S), Y, Z), W).
Proof:
  op(L(X, Y, Z), rdiv(W, rdiv(L(X, V, U), L(R(X, T, S), V, U)))) (peak)
= { by lemma 359 R->L }
  op(rdiv(L(X, Y, Z), rdiv(L(X, Y, Z), L(R(X, T, S), Y, Z))), W)
= { by lemma 235 R->L }
  op(rdiv(L(R(X, T, S), Y, Z), K(L(R(X, T, S), Y, Z), rdiv(L(X, Y, Z), L(R(X, T, S), Y, Z)))), W) (peak)
= { by lemma 163 }
  rdiv(op(L(R(X, T, S), Y, Z), W), K(L(R(X, T, S), Y, Z), rdiv(L(X, Y, Z), L(R(X, T, S), Y, Z))))
= { by lemma 200 }
  rdiv(op(L(R(X, T, S), Y, Z), W), K(R(X, T, S), rdiv(L(X, Y, Z), L(R(X, T, S), Y, Z))))
= { by lemma 304 }
  rdiv(op(L(R(X, T, S), Y, Z), W), K(R(X, T, S), rdiv(R(X, T, S), L(R(X, T, S), Y, Z)))) (peak)
= { by lemma 360 }
  rdiv(op(L(R(X, T, S), Y, Z), W), zero)
= { by lemma 27 }
  op(L(R(X, T, S), Y, Z), W)

Lemma 362: op(L(X, Y, Z), rdiv(R(X, W, V), ldiv(U, X))) = op(L(R(X, W, V), Y, Z), U).
Proof:
  op(L(X, Y, Z), rdiv(R(X, W, V), ldiv(U, X)))
= { by lemma 358 R->L }
  op(L(X, Y, Z), rdiv(U, rdiv(L(X, T, S), L(R(X, W, V), T, S)))) (peak)
= { by lemma 361 }
  op(L(R(X, W, V), Y, Z), U)

Lemma 363: op(L(R(X, W, V), Y, Z), rdiv(X, U)) = op(L(X, Y, Z), rdiv(R(X, W, V), U)).
Proof:
  op(L(R(X, W, V), Y, Z), rdiv(X, U))
= { by lemma 362 R->L }
  op(L(X, Y, Z), rdiv(R(X, W, V), ldiv(rdiv(X, U), X))) (peak)
= { by lemma 30 }
  op(L(X, Y, Z), rdiv(R(X, W, V), U))

Lemma 364: K(rdiv(L(X, Y, Z), W), V) = K(rdiv(R(X, U, T), W), V).
Proof:
  K(rdiv(L(X, Y, Z), W), V)
= { by lemma 89 R->L }
  ldiv(T(V, rdiv(L(X, Y, Z), W)), V) (peak)
= { by lemma 303 }
  ldiv(T(V, rdiv(R(X, U, T), W)), V) (peak)
= { by lemma 92 }
  rdiv(V, T(V, rdiv(R(X, U, T), W)))
= { by lemma 97 }
  K(rdiv(R(X, U, T), W), V)

Lemma 365: K(rdiv(R(X, W, V), Y), Z) = K(rdiv(X, Y), Z).
Proof:
  K(rdiv(R(X, W, V), Y), Z) (peak)
= { by lemma 364 R->L }
  K(rdiv(L(X, U, T), Y), Z)
= { by lemma 97 R->L }
  rdiv(Z, T(Z, rdiv(L(X, U, T), Y)))
= { by lemma 92 R->L }
  ldiv(T(Z, rdiv(L(X, U, T), Y)), Z) (peak)
= { by lemma 283 }
  ldiv(T(Z, rdiv(X, Y)), Z)
= { by lemma 89 }
  K(rdiv(X, Y), Z)

Lemma 366: R(X, rdiv(Y, K(Z, W)), V) = R(X, Y, V).
Proof:
  R(X, rdiv(Y, K(Z, W)), V)
= { by axiom 18 (sos) }
  rdiv(op(op(X, rdiv(Y, K(Z, W))), V), op(rdiv(Y, K(Z, W)), V)) (peak)
= { by lemma 106 }
  rdiv(op(rdiv(op(X, Y), K(Z, W)), V), op(rdiv(Y, K(Z, W)), V))
= { by lemma 163 }
  rdiv(rdiv(op(op(X, Y), V), K(Z, W)), op(rdiv(Y, K(Z, W)), V))
= { by lemma 202 }
  rdiv(op(op(X, Y), V), rdiv(op(rdiv(Y, K(Z, W)), V), K(W, Z)))
= { by lemma 163 }
  rdiv(op(op(X, Y), V), rdiv(rdiv(op(Y, V), K(Z, W)), K(W, Z)))
= { by lemma 202 }
  rdiv(op(op(X, Y), V), rdiv(op(Y, V), rdiv(K(W, Z), K(W, Z))))
= { by lemma 240 }
  rdiv(op(op(X, Y), V), rdiv(op(Y, V), rdiv(T(W, Z), T(W, Z))))
= { by lemma 26 }
  rdiv(op(op(X, Y), V), rdiv(op(Y, V), zero))
= { by lemma 27 }
  rdiv(op(op(X, Y), V), op(Y, V))
= { by axiom 18 (sos) R->L }
  R(X, Y, V)

Lemma 367: R(rdiv(X, K(Y, Z)), W, V) = rdiv(R(X, W, V), K(Y, Z)).
Proof:
  R(rdiv(X, K(Y, Z)), W, V)
= { by lemma 366 R->L }
  R(rdiv(X, K(Y, Z)), rdiv(W, K(Z, Y)), V)
= { by lemma 201 R->L }
  R(rdiv(op(X, W), rdiv(W, K(Z, Y))), rdiv(W, K(Z, Y)), V) (peak)
= { by lemma 341 R->L }
  rdiv(op(R(X, W, V), op(W, V)), op(rdiv(W, K(Z, Y)), V)) (peak)
= { by lemma 163 }
  rdiv(op(R(X, W, V), op(W, V)), rdiv(op(W, V), K(Z, Y)))
= { by lemma 201 }
  rdiv(R(X, W, V), K(Y, Z))

Lemma 368: op(X, rdiv(R(Y, Z, W), X)) = R(op(X, rdiv(Y, X)), Z, W).
Proof:
  op(X, rdiv(R(Y, Z, W), X))
= { by lemma 204 R->L }
  rdiv(R(Y, Z, W), K(rdiv(R(Y, Z, W), X), X)) (peak)
= { by lemma 365 }
  rdiv(R(Y, Z, W), K(rdiv(Y, X), X))
= { by lemma 367 R->L }
  R(rdiv(Y, K(rdiv(Y, X), X)), Z, W)
= { by lemma 204 }
  R(op(X, rdiv(Y, X)), Z, W)

Lemma 369: op(L(X, Y, Z), rdiv(X, L(X, Y, Z))) = X.
Proof:
  op(L(X, Y, Z), rdiv(X, L(X, Y, Z)))
= { by lemma 149 R->L }
  op(L(X, Y, Z), rdiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), L(X, Y, Z))) (peak)
= { by lemma 224 }
  op(T(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), a(Z, Y, L(X, Y, Z)))
= { by lemma 119 }
  op(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))
= { by lemma 149 }
  X

Lemma 370: rdiv(R(L(X, Y, Z), W, V), rdiv(L(R(X, U, T), Y, Z), R(X, U, T))) = R(X, W, V).
Proof:
  rdiv(R(L(X, Y, Z), W, V), rdiv(L(R(X, U, T), Y, Z), R(X, U, T)))
= { by lemma 279 R->L }
  op(R(L(X, Y, Z), W, V), rdiv(R(X, U, T), L(R(X, U, T), Y, Z))) (peak)
= { by lemma 339 }
  op(R(L(X, Y, Z), W, V), a(Z, Y, R(L(X, Y, Z), S, X2))) (peak)
= { by lemma 344 }
  R(op(L(X, Y, Z), a(Z, Y, R(L(X, Y, Z), S, X2))), W, V)
= { by lemma 339 R->L }
  R(op(L(X, Y, Z), rdiv(R(X, W, V), L(R(X, W, V), Y, Z))), W, V)
= { by lemma 363 R->L }
  R(op(L(R(X, W, V), Y, Z), rdiv(X, L(R(X, W, V), Y, Z))), W, V)
= { by lemma 368 R->L }
  op(L(R(X, W, V), Y, Z), rdiv(R(X, W, V), L(R(X, W, V), Y, Z))) (peak)
= { by lemma 369 }
  R(X, W, V)

Lemma 371: L(R(X, Y, Z), W, V) = R(L(X, W, V), Y, Z).
Proof:
  L(R(X, Y, Z), W, V)
= { by lemma 312 R->L }
  op(R(L(X, U, T), S, X2), rdiv(L(R(X, Y, Z), W, V), R(L(X, U, T), S, X2))) (peak)
= { by lemma 326 }
  op(R(X, Y, Z), rdiv(L(R(X, Y, Z), W, V), R(X, Y, Z)))
= { by lemma 370 R->L }
  op(rdiv(R(L(X, W, V), Y, Z), rdiv(L(R(X, Y, Z), W, V), R(X, Y, Z))), rdiv(L(R(X, Y, Z), W, V), R(X, Y, Z))) (peak)
= { by axiom 9 (sos) }
  R(L(X, W, V), Y, Z)

Goal 1 (goals): R(L(x21, x22, x23), x24, x25) = L(R(x21, x24, x25), x22, x23).
Proof:
  R(L(x21, x22, x23), x24, x25)
= { by lemma 371 R->L }
  L(R(x21, x24, x25), x22, x23) (peak)

RESULT: Theorem (the conjecture is true).
