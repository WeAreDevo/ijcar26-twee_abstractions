= { by axiom 4 (sos) }
  K(Y, X)

Lemma 69: K(X, rdiv(op(X, Y), X)) = L(K(X, Y), Y, X).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 36 R->L }
  K(X, op(Y, K(X, Y)))
= { by lemma 68 R->L }
  ldiv(op(op(Y, K(X, Y)), X), op(X, op(Y, K(X, Y)))) (peak)
= { by lemma 35 }
  ldiv(op(X, Y), op(X, op(Y, K(X, Y))))
= { by axiom 20 (sos) R->L }
  L(K(X, Y), Y, X)

Lemma 70: T(K(X, Y), Z) = K(X, Y).
Proof:
  T(K(X, Y), Z)
= { by axiom 5 (sos) }
  ldiv(Z, op(K(X, Y), Z)) (peak)
= { by lemma 29 }
  ldiv(Z, op(Z, K(X, Y))) (peak)
= { by axiom 4 (sos) }
  K(X, Y)

Lemma 71: L(K(X, Y), Z, W) = K(X, Y).
Proof:
  L(K(X, Y), Z, W)
= { by axiom 20 (sos) }
  ldiv(op(W, Z), op(W, op(Z, K(X, Y)))) (peak)
= { by lemma 31 R->L }
  ldiv(op(W, Z), op(K(X, Y), op(W, Z))) (peak)
= { by axiom 5 (sos) R->L }
  T(K(X, Y), op(W, Z))
= { by lemma 70 }
  K(X, Y)

Lemma 72: K(X, rdiv(op(X, Y), X)) = K(X, Y).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 69 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 71 }
  K(X, Y)

Lemma 73: K(X, T(Y, X)) = K(X, Y).
Proof:
  K(X, T(Y, X))
= { by lemma 72 R->L }
  K(X, rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 58 }
  K(X, rdiv(op(Y, X), X))
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 74: ldiv(T(X, Y), X) = K(Y, X).
Proof:
  ldiv(T(X, Y), X) (peak)
= { by lemma 67 R->L }
  K(Y, T(X, Y)) (peak)
= { by lemma 73 }
  K(Y, X)

Lemma 75: T(X, ldiv(X, Y)) = ldiv(ldiv(X, Y), Y).
Proof:
  T(X, ldiv(X, Y))
= { by axiom 5 (sos) }
  ldiv(ldiv(X, Y), op(X, ldiv(X, Y))) (peak)
= { by axiom 8 (sos) }
  ldiv(ldiv(X, Y), Y)

Lemma 76: rdiv(X, T(Y, ldiv(Y, X))) = ldiv(Y, X).
Proof:
  rdiv(X, T(Y, ldiv(Y, X))) (peak)
= { by lemma 75 }
  rdiv(X, ldiv(ldiv(Y, X), X)) (peak)
= { by lemma 62 }
  ldiv(Y, X)

Lemma 77: T(X, ldiv(T(Y, Z), Y)) = X.
Proof:
  T(X, ldiv(T(Y, Z), Y)) (peak)
= { by lemma 67 R->L }
  T(X, K(Z, T(Y, Z))) (peak)
= { by lemma 44 }
  X

Lemma 78: ldiv(T(X, Y), X) = rdiv(X, T(X, Y)).
Proof:
  ldiv(T(X, Y), X)
= { by lemma 76 R->L }
  rdiv(X, T(T(X, Y), ldiv(T(X, Y), X))) (peak)
= { by lemma 77 }
  rdiv(X, T(X, Y))

Lemma 79: rdiv(X, K(Y, X)) = T(X, Y).
Proof:
  rdiv(X, K(Y, X))
= { by lemma 74 R->L }
  rdiv(X, ldiv(T(X, Y), X)) (peak)
= { by lemma 62 }
  T(X, Y)

Lemma 80: L(rdiv(X, T(X, Y)), Z, W) = rdiv(X, T(X, Y)).
Proof:
  L(rdiv(X, T(X, Y)), Z, W)
= { by lemma 78 R->L }
  L(ldiv(T(X, Y), X), Z, W) (peak)
= { by lemma 67 R->L }
  L(K(Y, T(X, Y)), Z, W) (peak)
= { by lemma 71 }
  K(Y, T(X, Y))
= { by lemma 67 }
  ldiv(T(X, Y), X) (peak)
= { by lemma 78 }
  rdiv(X, T(X, Y))

Lemma 81: L(rdiv(X, T(X, Y)), T(X, Y), Y) = K(Y, X).
Proof:
  L(rdiv(X, T(X, Y)), T(X, Y), Y)
= { by lemma 78 R->L }
  L(ldiv(T(X, Y), X), T(X, Y), Y) (peak)
= { by lemma 67 R->L }
  L(K(Y, T(X, Y)), T(X, Y), Y) (peak)
= { by lemma 69 R->L }
  K(Y, rdiv(op(Y, T(X, Y)), Y))
= { by lemma 58 }
  K(Y, rdiv(op(X, Y), Y))
= { by axiom 3 (sos) }
  K(Y, X)

Lemma 82: rdiv(Y, T(Y, X)) = K(X, Y).
Proof:
  rdiv(Y, T(Y, X))
= { by lemma 80 R->L }
  L(rdiv(Y, T(Y, X)), T(Y, X), X) (peak)
= { by lemma 81 }
  K(X, Y)

Lemma 83: K(X, ldiv(X, Y)) = K(X, rdiv(Y, X)).
Proof:
  K(X, ldiv(X, Y))
= { by lemma 72 R->L }
  K(X, rdiv(op(X, ldiv(X, Y)), X)) (peak)
= { by axiom 8 (sos) }
  K(X, rdiv(Y, X))

Lemma 84: rdiv(op(X, T(Y, X)), X) = Y.
Proof:
  rdiv(op(X, T(Y, X)), X) (peak)
= { by lemma 58 }
  rdiv(op(Y, X), X)
= { by axiom 3 (sos) }
  Y

Lemma 85: K(X, T(Y, X)) = rdiv(Y, T(Y, X)).
Proof:
  K(X, T(Y, X))
= { by lemma 66 R->L }
  ldiv(T(Y, X), rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 84 }
  ldiv(T(Y, X), Y)
= { by lemma 78 }
  rdiv(Y, T(Y, X))

Lemma 86: op(X, rdiv(Y, T(Y, X))) = T(X, T(Y, X)).
Proof:
  op(X, rdiv(Y, T(Y, X)))
= { by lemma 78 R->L }
  op(X, ldiv(T(Y, X), Y)) (peak)
= { by lemma 67 R->L }
  op(X, K(X, T(Y, X))) (peak)
= { by lemma 34 }
  T(X, T(Y, X))

Lemma 87: op(X, rdiv(Y, T(Y, X))) = T(X, Y).
Proof:
  op(X, rdiv(Y, T(Y, X))) (peak)
= { by lemma 82 }
  op(X, K(X, Y))
= { by lemma 34 }
  T(X, Y)

Lemma 88: T(X, T(Y, X)) = T(X, Y).
Proof:
  T(X, T(Y, X))
= { by lemma 86 R->L }
  op(X, rdiv(Y, T(Y, X))) (peak)
= { by lemma 87 }
  T(X, Y)

Lemma 89: K(T(X, Y), Y) = rdiv(T(X, Y), X).
Proof:
  K(T(X, Y), Y)
= { by lemma 74 R->L }
  ldiv(T(Y, T(X, Y)), Y) (peak)
= { by lemma 88 }
  ldiv(T(Y, X), Y)
= { by lemma 74 }
  K(X, Y)
= { by lemma 64 R->L }
  rdiv(T(X, Y), X) (peak)

Lemma 90: op(K(X, Y), op(Z, Y)) = op(Z, rdiv(op(X, Y), X)).
Proof:
  op(K(X, Y), op(Z, Y)) (peak)
= { by lemma 31 }
  op(Z, op(Y, K(X, Y))) (peak)
= { by lemma 36 }
  op(Z, rdiv(op(X, Y), X)) (peak)

Lemma 91: op(X, rdiv(op(Z, Y), Z)) = rdiv(op(X, Y), K(Y, Z)).
Proof:
  op(X, rdiv(op(Z, Y), Z)) (peak)
= { by lemma 90 R->L }
  op(K(Z, Y), op(X, Y)) (peak)
= { by lemma 29 }
  op(op(X, Y), K(Z, Y)) (peak)
= { by lemma 57 }
  rdiv(op(X, Y), K(Y, Z))

Lemma 92: rdiv(op(X, T(Y, Z)), rdiv(T(Y, Z), Y)) = op(X, Y).
Proof:
  rdiv(op(X, T(Y, Z)), rdiv(T(Y, Z), Y)) (peak)
= { by lemma 89 R->L }
  rdiv(op(X, T(Y, Z)), K(T(Y, Z), Z)) (peak)
= { by lemma 91 R->L }
  op(X, rdiv(op(Z, T(Y, Z)), Z))
= { by lemma 58 }
  op(X, rdiv(op(Y, Z), Z))
= { by axiom 3 (sos) }
  op(X, Y)

Lemma 93: op(rdiv(op(Z, X), Z), Y) = op(X, op(Y, K(Z, X))).
Proof:
  op(rdiv(op(Z, X), Z), Y) (peak)
= { by lemma 36 R->L }
  op(op(X, K(Z, X)), Y) (peak)
= { by lemma 30 }
  op(K(Z, X), op(X, Y))
= { by lemma 31 }
  op(X, op(Y, K(Z, X)))

Lemma 94: op(T(X, Y), op(Z, rdiv(X, T(X, Y)))) = op(X, Z).
Proof:
  op(T(X, Y), op(Z, rdiv(X, T(X, Y))))
= { by lemma 78 R->L }
  op(T(X, Y), op(Z, ldiv(T(X, Y), X))) (peak)
= { by lemma 67 R->L }
  op(T(X, Y), op(Z, K(Y, T(X, Y)))) (peak)
= { by lemma 93 R->L }
  op(rdiv(op(Y, T(X, Y)), Y), Z)
= { by lemma 84 }
  op(X, Z)

Lemma 95: op(X, rdiv(Y, T(Y, Z))) = ldiv(T(Y, Z), op(Y, X)).
Proof:
  op(X, rdiv(Y, T(Y, Z)))
= { by axiom 4 (sos) R->L }
  ldiv(T(Y, Z), op(T(Y, Z), op(X, rdiv(Y, T(Y, Z))))) (peak)
= { by lemma 94 }
  ldiv(T(Y, Z), op(Y, X))

Lemma 96: K(rdiv(X, T(X, Y)), Z) = zero.
Proof:
  K(rdiv(X, T(X, Y)), Z)
= { by lemma 78 R->L }
  K(ldiv(T(X, Y), X), Z) (peak)
= { by lemma 67 R->L }
  K(K(Y, T(X, Y)), Z) (peak)
= { by axiom 7 (sos) }
  1
= { by lemma 25 }
  zero

Lemma 97: op(rdiv(X, T(X, Y)), Z) = ldiv(T(X, Y), op(X, Z)).
Proof:
  op(rdiv(X, T(X, Y)), Z)
= { by axiom 18 (sos) }
  op(op(Z, rdiv(X, T(X, Y))), K(rdiv(X, T(X, Y)), Z)) (peak)
= { by lemma 95 }
  op(ldiv(T(X, Y), op(X, Z)), K(rdiv(X, T(X, Y)), Z))
= { by lemma 96 }
  op(ldiv(T(X, Y), op(X, Z)), zero)
= { by axiom 1 (sos) }
  ldiv(T(X, Y), op(X, Z))

Lemma 98: op(op(X, Y), L(Z, Y, X)) = op(X, op(Y, Z)).
Proof:
  op(op(X, Y), L(Z, Y, X))
= { by axiom 20 (sos) }
  op(op(X, Y), ldiv(op(X, Y), op(X, op(Y, Z)))) (peak)
= { by axiom 8 (sos) }
  op(X, op(Y, Z))

Lemma 99: op(X, L(Y, ldiv(Z, X), Z)) = op(Z, op(ldiv(Z, X), Y)).
Proof:
  op(X, L(Y, ldiv(Z, X), Z))
= { by axiom 8 (sos) R->L }
  op(op(Z, ldiv(Z, X)), L(Y, ldiv(Z, X), Z)) (peak)
= { by lemma 98 }
  op(Z, op(ldiv(Z, X), Y))

Lemma 100: op(X, op(ldiv(X, zero), Y)) = L(Y, ldiv(X, zero), X).
Proof:
  op(X, op(ldiv(X, zero), Y))
= { by lemma 99 R->L }
  op(zero, L(Y, ldiv(X, zero), X)) (peak)
= { by axiom 2 (sos) }
  L(Y, ldiv(X, zero), X)

Lemma 101: op(X, ldiv(T(X, Y), zero)) = rdiv(X, T(X, Y)).
Proof:
  op(X, ldiv(T(X, Y), zero))
= { by lemma 94 R->L }
  op(T(X, Y), op(ldiv(T(X, Y), zero), rdiv(X, T(X, Y)))) (peak)
= { by lemma 100 }
  L(rdiv(X, T(X, Y)), ldiv(T(X, Y), zero), T(X, Y))
= { by lemma 80 }
  rdiv(X, T(X, Y))

Lemma 102: R(rdiv(X, Y), Y, ldiv(X, Z)) = rdiv(Z, op(Y, ldiv(X, Z))).
Proof:
  R(rdiv(X, Y), Y, ldiv(X, Z)) (peak)
= { by lemma 37 R->L }
  rdiv(op(X, ldiv(X, Z)), op(Y, ldiv(X, Z))) (peak)
= { by axiom 8 (sos) }
  rdiv(Z, op(Y, ldiv(X, Z)))

Lemma 103: ldiv(op(ldiv(X, Y), X), Y) = K(X, ldiv(X, Y)).
Proof:
  ldiv(op(ldiv(X, Y), X), Y)
= { by axiom 8 (sos) R->L }
  ldiv(op(ldiv(X, Y), X), op(X, ldiv(X, Y))) (peak)
= { by lemma 68 }
  K(X, ldiv(X, Y))

Lemma 104: ldiv(X, op(Y, T(X, Y))) = Y.
Proof:
  ldiv(X, op(Y, T(X, Y))) (peak)
= { by lemma 58 }
  ldiv(X, op(X, Y))
= { by axiom 4 (sos) }
  Y

Lemma 105: ldiv(op(Z, X), op(Z, Y)) = L(ldiv(X, Y), X, Z).
Proof:
  ldiv(op(Z, X), op(Z, Y))
= { by axiom 8 (sos) R->L }
  ldiv(op(Z, X), op(Z, op(X, ldiv(X, Y)))) (peak)
= { by axiom 20 (sos) R->L }
  L(ldiv(X, Y), X, Z)

Lemma 106: L(ldiv(X, T(X, Y)), X, Y) = K(X, Y).
Proof:
  L(ldiv(X, T(X, Y)), X, Y) (peak)
= { by lemma 105 R->L }
  ldiv(op(Y, X), op(Y, T(X, Y))) (peak)
= { by lemma 58 }
  ldiv(op(Y, X), op(X, Y))
= { by lemma 68 }
  K(X, Y)

Lemma 107: K(X, rdiv(op(Y, T(X, Y)), X)) = rdiv(T(X, Y), X).
Proof:
  K(X, rdiv(op(Y, T(X, Y)), X))
= { by lemma 83 R->L }
  K(X, ldiv(X, op(Y, T(X, Y))))
= { by lemma 103 R->L }
  ldiv(op(ldiv(X, op(Y, T(X, Y))), X), op(Y, T(X, Y))) (peak)
= { by lemma 104 }
  ldiv(op(Y, X), op(Y, T(X, Y)))
= { by lemma 105 }
  L(ldiv(X, T(X, Y)), X, Y)
= { by lemma 106 }
  K(X, Y)
= { by lemma 64 R->L }
  rdiv(T(X, Y), X)

Lemma 108: R(rdiv(T(X, Y), X), Z, W) = rdiv(T(X, Y), X).
Proof:
  R(rdiv(T(X, Y), X), Z, W)
= { by lemma 107 R->L }
  R(K(X, rdiv(op(Y, T(X, Y)), X)), Z, W) (peak)
= { by lemma 55 }
  K(X, rdiv(op(Y, T(X, Y)), X))
= { by lemma 107 }
  rdiv(T(X, Y), X)

Lemma 109: rdiv(zero, rdiv(X, T(X, Y))) = rdiv(T(X, Y), X).
Proof:
  rdiv(zero, rdiv(X, T(X, Y)))
= { by lemma 101 R->L }
  rdiv(zero, op(X, ldiv(T(X, Y), zero)))
= { by lemma 102 R->L }
  R(rdiv(T(X, Y), X), X, ldiv(T(X, Y), zero)) (peak)
= { by lemma 108 }
  rdiv(T(X, Y), X)

Lemma 110: ldiv(rdiv(T(X, Y), X), Z) = rdiv(Z, rdiv(T(X, Y), X)).
Proof:
  ldiv(rdiv(T(X, Y), X), Z)
= { by lemma 107 R->L }
  ldiv(K(X, rdiv(op(Y, T(X, Y)), X)), Z) (peak)
= { by lemma 45 }
  rdiv(Z, K(X, rdiv(op(Y, T(X, Y)), X)))
= { by lemma 107 }
  rdiv(Z, rdiv(T(X, Y), X))

Lemma 111: ldiv(T(X, Y), op(X, Z)) = rdiv(Z, rdiv(T(X, Y), X)).
Proof:
  ldiv(T(X, Y), op(X, Z))
= { by lemma 97 R->L }
  op(rdiv(X, T(X, Y)), Z)
= { by lemma 40 R->L }
  ldiv(R(rdiv(zero, rdiv(X, T(X, Y))), rdiv(X, T(X, Y)), Z), Z) (peak)
= { by lemma 109 }
  ldiv(R(rdiv(T(X, Y), X), rdiv(X, T(X, Y)), Z), Z)
= { by lemma 108 }
  ldiv(rdiv(T(X, Y), X), Z)
= { by lemma 110 }
  rdiv(Z, rdiv(T(X, Y), X))

Lemma 112: a(X, Y, rdiv(Z, T(Z, W))) = zero.
Proof:
  a(X, Y, rdiv(Z, T(Z, W)))
= { by lemma 78 R->L }
  a(X, Y, ldiv(T(Z, W), Z)) (peak)
= { by lemma 67 R->L }
  a(X, Y, K(W, T(Z, W))) (peak)
= { by axiom 12 (sos) }
  1
= { by lemma 25 }
  zero

Lemma 113: rdiv(op(T(X, Y), Z), rdiv(T(X, Y), X)) = op(X, Z).
Proof:
  rdiv(op(T(X, Y), Z), rdiv(T(X, Y), X))
= { by lemma 111 R->L }
  ldiv(T(X, Y), op(X, op(T(X, Y), Z)))
= { by lemma 95 R->L }
  op(op(T(X, Y), Z), rdiv(X, T(X, Y)))
= { by axiom 21 (sos) }
  op(op(T(X, Y), op(Z, rdiv(X, T(X, Y)))), a(T(X, Y), Z, rdiv(X, T(X, Y)))) (peak)
= { by lemma 94 }
  op(op(X, Z), a(T(X, Y), Z, rdiv(X, T(X, Y))))
= { by lemma 112 }
  op(op(X, Z), zero)
= { by axiom 1 (sos) }
  op(X, Z)

Lemma 114: rdiv(op(X, Y), K(X, T(Y, Z))) = op(Y, X).
Proof:
  rdiv(op(X, Y), K(X, T(Y, Z)))
= { by lemma 56 R->L }
  op(K(T(Y, Z), X), op(X, Y))
= { by lemma 30 R->L }
  op(op(X, K(T(Y, Z), X)), Y)
= { by lemma 92 R->L }
  rdiv(op(op(X, K(T(Y, Z), X)), T(Y, Z)), rdiv(T(Y, Z), Y)) (peak)
= { by lemma 35 }
  rdiv(op(T(Y, Z), X), rdiv(T(Y, Z), Y))
= { by lemma 113 }
  op(Y, X)

Lemma 115: K(X, T(Y, Z)) = K(X, Y).
Proof:
  K(X, T(Y, Z))
= { by lemma 39 R->L }
  ldiv(rdiv(op(X, Y), K(X, T(Y, Z))), op(X, Y)) (peak)
= { by lemma 114 }
  ldiv(op(Y, X), op(X, Y))
= { by lemma 68 }
  K(X, Y)

Lemma 116: op(op(X, Y), K(Z, W)) = op(X, op(Y, K(Z, W))).
Proof:
  op(op(X, Y), K(Z, W)) (peak)
= { by lemma 29 R->L }
  op(K(Z, W), op(X, Y)) (peak)
= { by lemma 31 }
  op(X, op(Y, K(Z, W))) (peak)

Lemma 117: op(X, rdiv(Y, K(Y, X))) = op(T(X, Y), Y).
Proof:
  op(X, rdiv(Y, K(Y, X)))
= { by lemma 73 R->L }
  op(X, rdiv(Y, K(Y, T(X, Y))))
= { by lemma 57 R->L }
  op(X, op(Y, K(T(X, Y), Y)))
= { by lemma 116 R->L }
  op(op(X, Y), K(T(X, Y), Y))
= { by lemma 58 R->L }
  op(op(Y, T(X, Y)), K(T(X, Y), Y)) (peak)
= { by axiom 18 (sos) R->L }
  op(T(X, Y), Y)

Lemma 118: K(X, rdiv(Y, K(Y, X))) = K(X, Y).
Proof:
  K(X, rdiv(Y, K(Y, X)))
= { by lemma 56 R->L }
  K(X, op(K(X, Y), Y)) (peak)
= { by lemma 60 }
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 69 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 71 }
  K(X, Y)

Lemma 119: ldiv(T(X, Y), op(X, Y)) = T(Y, T(X, Y)).
Proof:
  ldiv(T(X, Y), op(X, Y))
= { by lemma 58 R->L }
  ldiv(T(X, Y), op(Y, T(X, Y))) (peak)
= { by axiom 5 (sos) R->L }
  T(Y, T(X, Y))

Lemma 120: ldiv(ldiv(ldiv(X, Y), Y), Y) = T(ldiv(X, Y), X).
Proof:
  ldiv(ldiv(ldiv(X, Y), Y), Y)
= { by axiom 8 (sos) R->L }
  ldiv(ldiv(ldiv(X, Y), Y), op(X, ldiv(X, Y))) (peak)
= { by lemma 75 R->L }
  ldiv(T(X, ldiv(X, Y)), op(X, ldiv(X, Y))) (peak)
= { by lemma 119 }
  T(ldiv(X, Y), T(X, ldiv(X, Y)))
= { by lemma 88 }
  T(ldiv(X, Y), X)

Lemma 121: rdiv(X, T(ldiv(Y, X), Y)) = ldiv(ldiv(Y, X), X).
Proof:
  rdiv(X, T(ldiv(Y, X), Y)) (peak)
= { by lemma 120 R->L }
  rdiv(X, ldiv(ldiv(ldiv(Y, X), X), X)) (peak)
= { by lemma 62 }
  ldiv(ldiv(Y, X), X)

Lemma 122: rdiv(op(X, Y), T(Y, X)) = T(X, Y).
Proof:
  rdiv(op(X, Y), T(Y, X))
= { by axiom 4 (sos) R->L }
  rdiv(op(X, Y), T(ldiv(X, op(X, Y)), X)) (peak)
= { by lemma 121 }
  ldiv(ldiv(X, op(X, Y)), op(X, Y))
= { by axiom 4 (sos) }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 123: op(T(X, Y), T(Y, X)) = op(X, Y).
Proof:
  op(T(X, Y), T(Y, X))
= { by lemma 122 R->L }
  op(rdiv(op(X, Y), T(Y, X)), T(Y, X)) (peak)
= { by axiom 9 (sos) }
  op(X, Y)

Lemma 124: op(rdiv(X, K(X, Y)), Y) = op(Y, X).
Proof:
  op(rdiv(X, K(X, Y)), Y)
= { by axiom 18 (sos) }
  op(op(Y, rdiv(X, K(X, Y))), K(rdiv(X, K(X, Y)), Y)) (peak)
= { by lemma 117 }
  op(op(T(Y, X), X), K(rdiv(X, K(X, Y)), Y))
= { by lemma 116 }
  op(T(Y, X), op(X, K(rdiv(X, K(X, Y)), Y)))
= { by lemma 57 }
  op(T(Y, X), rdiv(X, K(Y, rdiv(X, K(X, Y)))))
= { by lemma 118 }
  op(T(Y, X), rdiv(X, K(Y, X)))
= { by lemma 79 }
  op(T(Y, X), T(X, Y))
= { by lemma 123 }
  op(Y, X)

Lemma 125: op(X, rdiv(Y, K(Z, W))) = rdiv(op(X, Y), K(Z, W)).
Proof:
  op(X, rdiv(Y, K(Z, W)))
= { by lemma 57 R->L }
  op(X, op(Y, K(W, Z)))
= { by lemma 47 R->L }
  op(op(K(W, Z), X), Y)
= { by lemma 124 R->L }
  op(op(rdiv(X, K(X, K(W, Z))), K(W, Z)), Y) (peak)
= { by lemma 30 }
  op(K(W, Z), op(rdiv(X, K(X, K(W, Z))), Y))
= { by lemma 56 }
  rdiv(op(rdiv(X, K(X, K(W, Z))), Y), K(Z, W))
= { by axiom 6 (sos) }
  rdiv(op(rdiv(X, 1), Y), K(Z, W))
= { by lemma 25 }
  rdiv(op(rdiv(X, zero), Y), K(Z, W))
= { by lemma 27 }
  rdiv(op(X, Y), K(Z, W))

Lemma 126: rdiv(op(op(X, Y), Z), a(X, Y, Z)) = op(X, op(Y, Z)).
Proof:
  rdiv(op(op(X, Y), Z), a(X, Y, Z))
= { by axiom 21 (sos) }
  rdiv(op(op(X, op(Y, Z)), a(X, Y, Z)), a(X, Y, Z)) (peak)
= { by axiom 3 (sos) }
  op(X, op(Y, Z))

Lemma 127: rdiv(op(op(X, Y), Z), K(X, Y)) = op(op(Y, X), Z).
Proof:
  rdiv(op(op(X, Y), Z), K(X, Y))
= { by lemma 125 R->L }
  op(op(X, Y), rdiv(Z, K(X, Y)))
= { by lemma 56 R->L }
  op(op(X, Y), op(K(Y, X), Z))
= { by lemma 126 R->L }
  rdiv(op(op(op(X, Y), K(Y, X)), Z), a(op(X, Y), K(Y, X), Z)) (peak)
= { by axiom 18 (sos) R->L }
  rdiv(op(op(Y, X), Z), a(op(X, Y), K(Y, X), Z))
= { by axiom 13 (sos) }
  rdiv(op(op(Y, X), Z), 1)
= { by lemma 25 }
  rdiv(op(op(Y, X), Z), zero)
= { by lemma 27 }
  op(op(Y, X), Z)

Lemma 128: rdiv(op(X, op(Y, Z)), K(Y, Z)) = op(X, op(Z, Y)).
Proof:
  rdiv(op(X, op(Y, Z)), K(Y, Z))
= { by lemma 56 R->L }
  op(K(Z, Y), op(X, op(Y, Z)))
= { by lemma 30 R->L }
  op(op(X, K(Z, Y)), op(Y, Z))
= { by axiom 21 (sos) }
  op(op(X, op(K(Z, Y), op(Y, Z))), a(X, K(Z, Y), op(Y, Z))) (peak)
= { by lemma 32 }
  op(op(X, op(Z, Y)), a(X, K(Z, Y), op(Y, Z)))
= { by axiom 13 (sos) }
  op(op(X, op(Z, Y)), 1)
= { by lemma 25 }
  op(op(X, op(Z, Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(Z, Y))

Lemma 129: op(op(X, Y), T(Z, op(Y, X))) = op(Z, op(X, Y)).
Proof:
  op(op(X, Y), T(Z, op(Y, X)))
= { by lemma 127 R->L }
  rdiv(op(op(Y, X), T(Z, op(Y, X))), K(Y, X)) (peak)
= { by lemma 58 }
  rdiv(op(Z, op(Y, X)), K(Y, X))
= { by lemma 128 }
  op(Z, op(X, Y))

Lemma 130: T(X, op(Y, Z)) = T(X, op(Z, Y)).
Proof:
  T(X, op(Y, Z))
= { by axiom 4 (sos) R->L }
  ldiv(op(Z, Y), op(op(Z, Y), T(X, op(Y, Z)))) (peak)
= { by lemma 129 }
  ldiv(op(Z, Y), op(X, op(Z, Y)))
= { by axiom 5 (sos) R->L }
  T(X, op(Z, Y))

Lemma 131: ldiv(op(X, Y), op(X, op(Z, Y))) = L(T(Z, Y), Y, X).
Proof:
  ldiv(op(X, Y), op(X, op(Z, Y))) (peak)
= { by lemma 105 }
  L(ldiv(Y, op(Z, Y)), Y, X) (peak)
= { by axiom 5 (sos) R->L }
  L(T(Z, Y), Y, X)

Lemma 132: L(T(X, Y), Y, K(Z, W)) = T(X, rdiv(Y, K(W, Z))).
Proof:
  L(T(X, Y), Y, K(Z, W))
= { by lemma 131 R->L }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(X, Y))) (peak)
= { by lemma 29 }
  ldiv(op(K(Z, W), Y), op(op(X, Y), K(Z, W))) (peak)
= { by lemma 56 }
  ldiv(rdiv(Y, K(W, Z)), op(op(X, Y), K(Z, W)))
= { by lemma 116 }
  ldiv(rdiv(Y, K(W, Z)), op(X, op(Y, K(Z, W))))
= { by lemma 57 }
  ldiv(rdiv(Y, K(W, Z)), op(X, rdiv(Y, K(W, Z))))
= { by axiom 5 (sos) R->L }
  T(X, rdiv(Y, K(W, Z)))

Lemma 133: R(X, K(Y, Z), W) = X.
Proof:
  R(X, K(Y, Z), W)
= { by axiom 3 (sos) R->L }
  R(X, K(Y, Z), rdiv(op(W, K(Y, Z)), K(Y, Z))) (peak)
= { by lemma 48 }
  X

Lemma 134: ldiv(R(X, Y, Z), op(op(X, Y), Z)) = op(Y, Z).
Proof:
  ldiv(R(X, Y, Z), op(op(X, Y), Z))
= { by axiom 19 (sos) }
  ldiv(rdiv(op(op(X, Y), Z), op(Y, Z)), op(op(X, Y), Z)) (peak)
= { by lemma 39 }
  op(Y, Z)

Lemma 135: ldiv(op(X, Y), op(op(Y, X), Z)) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(op(X, Y), op(op(Y, X), Z))
= { by lemma 133 R->L }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(Y, X), Z))
= { by axiom 18 (sos) }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(op(X, Y), K(Y, X)), Z)) (peak)
= { by lemma 134 }
  op(K(Y, X), Z)
= { by lemma 56 }
  rdiv(Z, K(X, Y))

Lemma 136: L(X, Y, K(Z, W)) = X.
Proof:
  L(X, Y, K(Z, W))
= { by axiom 20 (sos) }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(Y, X)))
= { by lemma 30 R->L }
  ldiv(op(K(Z, W), Y), op(op(Y, K(Z, W)), X)) (peak)
= { by lemma 135 }
  rdiv(X, K(K(Z, W), Y))
= { by axiom 7 (sos) }
  rdiv(X, 1)
= { by lemma 25 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 137: T(X, rdiv(Y, K(Z, W))) = T(X, Y).
Proof:
  T(X, rdiv(Y, K(Z, W)))
= { by lemma 132 R->L }
  L(T(X, Y), Y, K(W, Z)) (peak)
= { by lemma 136 }
  T(X, Y)

Lemma 138: rdiv(T(X, Y), K(X, Y)) = X.
Proof:
  rdiv(T(X, Y), K(X, Y))
= { by lemma 34 R->L }
  rdiv(op(X, K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  X

Lemma 139: T(X, T(Y, Z)) = T(X, Y).
Proof:
  T(X, T(Y, Z))
= { by lemma 137 R->L }
  T(X, rdiv(T(Y, Z), K(Y, Z))) (peak)
= { by lemma 138 }
  T(X, Y)

Lemma 140: T(X, ldiv(Y, Z)) = T(X, rdiv(Z, Y)).
Proof:
  T(X, ldiv(Y, Z))
= { by lemma 43 R->L }
  T(X, T(rdiv(Z, Y), Y)) (peak)
= { by lemma 139 }
  T(X, rdiv(Z, Y))

Lemma 141: op(a(X, Y, Z), W) = op(W, a(X, Y, Z)).
Proof:
  op(a(X, Y, Z), W)
= { by lemma 28 R->L }
  rdiv(op(W, a(X, Y, Z)), K(W, a(X, Y, Z))) (peak)
= { by axiom 10 (sos) }
  rdiv(op(W, a(X, Y, Z)), 1)
= { by lemma 25 }
  rdiv(op(W, a(X, Y, Z)), zero)
= { by lemma 27 }
  op(W, a(X, Y, Z))

Lemma 142: op(a(X, Y, Z), rdiv(W, a(X, Y, Z))) = W.
Proof:
  op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))
= { by lemma 41 R->L }
  op(W, K(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 11 (sos) }
  op(W, 1)
= { by lemma 25 }
  op(W, zero)
= { by axiom 1 (sos) }
  W

Lemma 143: ldiv(a(X, Y, Z), W) = rdiv(W, a(X, Y, Z)).
Proof:
  ldiv(a(X, Y, Z), W)
= { by lemma 142 R->L }
  ldiv(a(X, Y, Z), op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 4 (sos) }
  rdiv(W, a(X, Y, Z))

Lemma 144: op(op(X, Y), a(Z, W, V)) = op(X, op(Y, a(Z, W, V))).
Proof:
  op(op(X, Y), a(Z, W, V))
= { by axiom 21 (sos) }
  op(op(X, op(Y, a(Z, W, V))), a(X, Y, a(Z, W, V))) (peak)
= { by lemma 141 R->L }
  op(op(X, op(a(Z, W, V), Y)), a(X, Y, a(Z, W, V))) (peak)
= { by axiom 15 (sos) }
  op(op(X, op(a(Z, W, V), Y)), 1)
= { by lemma 25 }
  op(op(X, op(a(Z, W, V), Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(a(Z, W, V), Y))
= { by lemma 141 }
  op(X, op(Y, a(Z, W, V)))

Lemma 145: op(X, op(Y, op(Z, a(X, Y, Z)))) = op(op(X, Y), Z).
Proof:
  op(X, op(Y, op(Z, a(X, Y, Z))))
= { by lemma 144 R->L }
  op(X, op(op(Y, Z), a(X, Y, Z)))
= { by lemma 144 R->L }
  op(op(X, op(Y, Z)), a(X, Y, Z)) (peak)
= { by axiom 21 (sos) R->L }
  op(op(X, Y), Z)

Lemma 146: L(op(X, a(Y, Z, X)), Z, Y) = X.
Proof:
  L(op(X, a(Y, Z, X)), Z, Y)
= { by axiom 20 (sos) }
  ldiv(op(Y, Z), op(Y, op(Z, op(X, a(Y, Z, X))))) (peak)
= { by lemma 145 }
  ldiv(op(Y, Z), op(op(Y, Z), X))
= { by axiom 4 (sos) }
  X

Lemma 147: R(X, Y, K(Z, W)) = X.
Proof:
  R(X, Y, K(Z, W))
= { by axiom 19 (sos) }
  rdiv(op(op(X, Y), K(Z, W)), op(Y, K(Z, W))) (peak)
= { by lemma 116 }
  rdiv(op(X, op(Y, K(Z, W))), op(Y, K(Z, W)))
= { by axiom 3 (sos) }
  X

Lemma 148: ldiv(X, rdiv(op(X, Y), K(Z, W))) = rdiv(Y, K(Z, W)).
Proof:
  ldiv(X, rdiv(op(X, Y), K(Z, W)))
= { by lemma 56 R->L }
  ldiv(X, op(K(W, Z), op(X, Y)))
= { by lemma 147 R->L }
  ldiv(R(X, Y, K(W, Z)), op(K(W, Z), op(X, Y))) (peak)
= { by lemma 29 }
  ldiv(R(X, Y, K(W, Z)), op(op(X, Y), K(W, Z))) (peak)
= { by lemma 134 }
  op(Y, K(W, Z))
= { by lemma 57 }
  rdiv(Y, K(Z, W))

Lemma 149: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, ldiv(Y, X), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by axiom 8 (sos) R->L }
  ldiv(op(Y, ldiv(Y, X)), op(Y, op(ldiv(Y, X), Z))) (peak)
= { by axiom 20 (sos) R->L }
  L(Z, ldiv(Y, X), Y)

Lemma 150: L(ldiv(X, ldiv(Y, Z)), X, Y) = ldiv(op(Y, X), Z).
Proof:
  L(ldiv(X, ldiv(Y, Z)), X, Y) (peak)
= { by lemma 105 R->L }
  ldiv(op(Y, X), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 8 (sos) }
  ldiv(op(Y, X), Z)

Lemma 151: ldiv(rdiv(X, K(Y, Z)), W) = ldiv(X, rdiv(W, K(Z, Y))).
Proof:
  ldiv(rdiv(X, K(Y, Z)), W)
= { by lemma 56 R->L }
  ldiv(op(K(Z, Y), X), W)
= { by lemma 150 R->L }
  L(ldiv(X, ldiv(K(Z, Y), W)), X, K(Z, Y)) (peak)
= { by lemma 136 }
  ldiv(X, ldiv(K(Z, Y), W))
= { by lemma 45 }
  ldiv(X, rdiv(W, K(Z, Y)))

Lemma 152: ldiv(X, rdiv(Y, K(Z, W))) = rdiv(ldiv(X, Y), K(Z, W)).
Proof:
  ldiv(X, rdiv(Y, K(Z, W)))
= { by axiom 8 (sos) R->L }
  ldiv(X, rdiv(op(X, ldiv(X, Y)), K(Z, W))) (peak)
= { by lemma 148 }
  rdiv(ldiv(X, Y), K(Z, W))

Lemma 153: op(rdiv(X, K(Y, Z)), W) = rdiv(op(X, W), K(Y, Z)).
Proof:
  op(rdiv(X, K(Y, Z)), W)
= { by lemma 57 R->L }
  op(op(X, K(Z, Y)), W) (peak)
= { by lemma 29 R->L }
  op(op(K(Z, Y), X), W) (peak)
= { by lemma 47 }
  op(X, op(W, K(Z, Y)))
= { by lemma 57 }
  op(X, rdiv(W, K(Y, Z)))
= { by lemma 125 }
  rdiv(op(X, W), K(Y, Z))

Lemma 154: R(rdiv(rdiv(X, Y), Z), Z, Y) = rdiv(X, op(Z, Y)).
Proof:
  R(rdiv(rdiv(X, Y), Z), Z, Y) (peak)
= { by lemma 37 R->L }
  rdiv(op(rdiv(X, Y), Y), op(Z, Y)) (peak)
= { by axiom 9 (sos) }
  rdiv(X, op(Z, Y))

Lemma 155: rdiv(rdiv(X, Y), K(Z, W)) = rdiv(X, rdiv(Y, K(W, Z))).
Proof:
  rdiv(rdiv(X, Y), K(Z, W))
= { by lemma 133 R->L }
  R(rdiv(rdiv(X, Y), K(Z, W)), K(Z, W), Y) (peak)
= { by lemma 154 }
  rdiv(X, op(K(Z, W), Y))
= { by lemma 56 }
  rdiv(X, rdiv(Y, K(W, Z)))

Lemma 156: L(X, rdiv(Y, K(Z, W)), V) = L(X, Y, V).
Proof:
  L(X, rdiv(Y, K(Z, W)), V)
= { by lemma 148 R->L }
  L(X, ldiv(V, rdiv(op(V, Y), K(Z, W))), V)
= { by lemma 149 R->L }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(ldiv(V, rdiv(op(V, Y), K(Z, W))), X))) (peak)
= { by lemma 148 }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(rdiv(Y, K(Z, W)), X)))
= { by lemma 151 }
  ldiv(op(V, Y), rdiv(op(V, op(rdiv(Y, K(Z, W)), X)), K(W, Z)))
= { by lemma 152 }
  rdiv(ldiv(op(V, Y), op(V, op(rdiv(Y, K(Z, W)), X))), K(W, Z))
= { by lemma 153 }
  rdiv(ldiv(op(V, Y), op(V, rdiv(op(Y, X), K(Z, W)))), K(W, Z))
= { by lemma 125 }
  rdiv(ldiv(op(V, Y), rdiv(op(V, op(Y, X)), K(Z, W))), K(W, Z))
= { by lemma 152 }
  rdiv(rdiv(ldiv(op(V, Y), op(V, op(Y, X))), K(Z, W)), K(W, Z))
= { by lemma 155 }
  rdiv(ldiv(op(V, Y), op(V, op(Y, X))), rdiv(K(Z, W), K(Z, W)))
= { by axiom 20 (sos) R->L }
  rdiv(L(X, Y, V), rdiv(K(Z, W), K(Z, W)))
= { by lemma 26 }
  rdiv(L(X, Y, V), zero)
= { by lemma 27 }
  L(X, Y, V)

Lemma 157: L(X, op(Y, Z), W) = L(X, op(Z, Y), W).
Proof:
  L(X, op(Y, Z), W)
= { by lemma 156 R->L }
  L(X, rdiv(op(Y, Z), K(Y, Z)), W) (peak)
= { by lemma 28 }
  L(X, op(Z, Y), W)

Lemma 158: op(X, K(rdiv(Y, X), X)) = rdiv(Y, rdiv(Y, X)).
Proof:
  op(X, K(rdiv(Y, X), X))
= { by lemma 36 }
  rdiv(op(rdiv(Y, X), X), rdiv(Y, X)) (peak)
= { by axiom 9 (sos) }
  rdiv(Y, rdiv(Y, X))

Lemma 159: op(ldiv(X, Y), K(X, rdiv(Y, X))) = rdiv(Y, X).
Proof:
  op(ldiv(X, Y), K(X, rdiv(Y, X)))
= { by lemma 83 R->L }
  op(ldiv(X, Y), K(X, ldiv(X, Y)))
= { by lemma 62 R->L }
  op(ldiv(X, Y), K(rdiv(Y, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 158 }
  rdiv(Y, rdiv(Y, ldiv(X, Y)))
= { by lemma 62 }
  rdiv(Y, X)

Lemma 160: L(X, ldiv(Y, Z), W) = L(X, rdiv(Z, Y), W).
Proof:
  L(X, ldiv(Y, Z), W)
= { by lemma 156 R->L }
  L(X, rdiv(ldiv(Y, Z), K(rdiv(Z, Y), Y)), W)
= { by lemma 56 R->L }
  L(X, op(K(Y, rdiv(Z, Y)), ldiv(Y, Z)), W) (peak)
= { by lemma 157 R->L }
  L(X, op(ldiv(Y, Z), K(Y, rdiv(Z, Y))), W)
= { by lemma 159 }
  L(X, rdiv(Z, Y), W)

Lemma 161: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, rdiv(X, Y), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by axiom 8 (sos) R->L }
  ldiv(op(Y, ldiv(Y, X)), op(Y, op(ldiv(Y, X), Z))) (peak)
= { by axiom 20 (sos) R->L }
  L(Z, ldiv(Y, X), Y)
= { by lemma 160 }
  L(Z, rdiv(X, Y), Y)

Lemma 162: ldiv(op(X, Y), op(Y, op(T(X, Y), Z))) = L(Z, X, Y).
Proof:
  ldiv(op(X, Y), op(Y, op(T(X, Y), Z)))
= { by axiom 5 (sos) }
  ldiv(op(X, Y), op(Y, op(ldiv(Y, op(X, Y)), Z))) (peak)
= { by lemma 161 }
  L(Z, rdiv(op(X, Y), Y), Y)
= { by axiom 3 (sos) }
  L(Z, X, Y)

Lemma 163: a(a(X, Y, Z), W, V) = zero.
Proof:
  a(a(X, Y, Z), W, V) (peak)
= { by axiom 17 (sos) }
  1
= { by lemma 25 }
  zero

Lemma 164: L(X, Y, a(Z, W, V)) = X.
Proof:
  L(X, Y, a(Z, W, V))
= { by axiom 1 (sos) R->L }
  L(op(X, zero), Y, a(Z, W, V))
= { by lemma 163 R->L }
  L(op(X, a(a(Z, W, V), Y, X)), Y, a(Z, W, V)) (peak)
= { by lemma 146 }
  X

Lemma 165: a(X, a(Y, Z, W), V) = zero.
Proof:
  a(X, a(Y, Z, W), V) (peak)
= { by axiom 16 (sos) }
  1
= { by lemma 25 }
  zero

Lemma 166: L(X, a(Y, Z, W), V) = X.
Proof:
  L(X, a(Y, Z, W), V)
= { by axiom 1 (sos) R->L }
  L(op(X, zero), a(Y, Z, W), V)
= { by lemma 165 R->L }
  L(op(X, a(V, a(Y, Z, W), X)), a(Y, Z, W), V) (peak)
= { by lemma 146 }
  X

Lemma 167: ldiv(op(X, a(Y, Z, W)), V) = rdiv(ldiv(X, V), a(Y, Z, W)).
Proof:
  ldiv(op(X, a(Y, Z, W)), V)
= { by lemma 150 R->L }
  L(ldiv(a(Y, Z, W), ldiv(X, V)), a(Y, Z, W), X) (peak)
= { by lemma 166 }
  ldiv(a(Y, Z, W), ldiv(X, V))
= { by lemma 143 }
  rdiv(ldiv(X, V), a(Y, Z, W))

Lemma 168: ldiv(X, rdiv(Y, a(Z, W, V))) = rdiv(ldiv(X, Y), a(Z, W, V)).
Proof:
  ldiv(X, rdiv(Y, a(Z, W, V)))
= { by lemma 143 R->L }
  ldiv(X, ldiv(a(Z, W, V), Y))
= { by lemma 164 R->L }
  L(ldiv(X, ldiv(a(Z, W, V), Y)), X, a(Z, W, V)) (peak)
= { by lemma 150 }
  ldiv(op(a(Z, W, V), X), Y)
= { by lemma 141 }
  ldiv(op(X, a(Z, W, V)), Y)
= { by lemma 167 }
  rdiv(ldiv(X, Y), a(Z, W, V))

Lemma 169: R(X, Y, a(Z, W, V)) = X.
Proof:
  R(X, Y, a(Z, W, V))
= { by axiom 19 (sos) }
  rdiv(op(op(X, Y), a(Z, W, V)), op(Y, a(Z, W, V))) (peak)
= { by lemma 144 }
  rdiv(op(X, op(Y, a(Z, W, V))), op(Y, a(Z, W, V)))
= { by axiom 3 (sos) }
  X

Lemma 170: op(X, op(Y, a(Z, X, Y))) = ldiv(Z, op(op(Z, X), Y)).
Proof:
  op(X, op(Y, a(Z, X, Y)))
= { by lemma 144 R->L }
  op(op(X, Y), a(Z, X, Y))
= { by lemma 134 R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, op(X, Y)), a(Z, X, Y))) (peak)
= { by axiom 21 (sos) R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, X), Y))
= { by lemma 169 }
  ldiv(Z, op(op(Z, X), Y))

Lemma 171: op(rdiv(X, a(Y, Z, W)), V) = rdiv(op(X, V), a(Y, Z, W)).
Proof:
  op(rdiv(X, a(Y, Z, W)), V)
= { by axiom 1 (sos) R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, zero))
= { by lemma 25 R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, 1))
= { by axiom 17 (sos) R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, a(a(Y, Z, W), rdiv(X, a(Y, Z, W)), V))) (peak)
= { by lemma 170 }
  ldiv(a(Y, Z, W), op(op(a(Y, Z, W), rdiv(X, a(Y, Z, W))), V))
= { by lemma 142 }
  ldiv(a(Y, Z, W), op(X, V))
= { by lemma 143 }
  rdiv(op(X, V), a(Y, Z, W))

Lemma 172: L(ldiv(ldiv(X, Y), Z), rdiv(Y, X), X) = ldiv(Y, op(X, Z)).
Proof:
  L(ldiv(ldiv(X, Y), Z), rdiv(Y, X), X)
= { by lemma 161 R->L }
  ldiv(Y, op(X, op(ldiv(X, Y), ldiv(ldiv(X, Y), Z)))) (peak)
= { by axiom 8 (sos) }
  ldiv(Y, op(X, Z))

Lemma 173: ldiv(rdiv(X, a(Y, Z, W)), V) = ldiv(X, op(V, a(Y, Z, W))).
Proof:
  ldiv(rdiv(X, a(Y, Z, W)), V)
= { by lemma 143 R->L }
  ldiv(ldiv(a(Y, Z, W), X), V)
= { by lemma 164 R->L }
  L(ldiv(ldiv(a(Y, Z, W), X), V), rdiv(X, a(Y, Z, W)), a(Y, Z, W)) (peak)
= { by lemma 172 }
  ldiv(X, op(a(Y, Z, W), V))
= { by lemma 141 }
  ldiv(X, op(V, a(Y, Z, W)))

Lemma 174: L(a(X, Y, Z), W, V) = a(X, Y, Z).
Proof:
  L(a(X, Y, Z), W, V)
= { by axiom 20 (sos) }
  ldiv(op(V, W), op(V, op(W, a(X, Y, Z))))
= { by lemma 144 R->L }
  ldiv(op(V, W), op(op(V, W), a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 175: rdiv(op(X, op(Y, Z)), L(Z, Y, X)) = op(X, Y).
Proof:
  rdiv(op(X, op(Y, Z)), L(Z, Y, X))
= { by axiom 20 (sos) }
  rdiv(op(X, op(Y, Z)), ldiv(op(X, Y), op(X, op(Y, Z)))) (peak)
= { by lemma 62 }
  op(X, Y)

Lemma 176: rdiv(op(X, op(Y, a(Z, W, V))), a(Z, W, V)) = op(X, Y).
Proof:
  rdiv(op(X, op(Y, a(Z, W, V))), a(Z, W, V)) (peak)
= { by lemma 141 R->L }
  rdiv(op(X, op(a(Z, W, V), Y)), a(Z, W, V))
= { by lemma 174 R->L }
  rdiv(op(X, op(a(Z, W, V), Y)), L(a(Z, W, V), Y, X)) (peak)
= { by lemma 141 }
  rdiv(op(X, op(Y, a(Z, W, V))), L(a(Z, W, V), Y, X)) (peak)
= { by lemma 175 }
  op(X, Y)

Lemma 177: op(X, rdiv(Y, a(Z, W, V))) = rdiv(op(X, Y), a(Z, W, V)).
Proof:
  op(X, rdiv(Y, a(Z, W, V)))
= { by lemma 176 R->L }
  rdiv(op(X, op(rdiv(Y, a(Z, W, V)), a(Z, W, V))), a(Z, W, V)) (peak)
= { by axiom 9 (sos) }
  rdiv(op(X, Y), a(Z, W, V))

Lemma 178: rdiv(op(op(X, rdiv(Y, Z)), Z), Y) = R(X, rdiv(Y, Z), Z).
Proof:
  rdiv(op(op(X, rdiv(Y, Z)), Z), Y)
= { by axiom 9 (sos) R->L }
  rdiv(op(op(X, rdiv(Y, Z)), Z), op(rdiv(Y, Z), Z)) (peak)
= { by axiom 19 (sos) R->L }
  R(X, rdiv(Y, Z), Z)

Lemma 179: ldiv(X, op(op(Y, rdiv(X, Z)), Z)) = T(R(Y, rdiv(X, Z), Z), X).
Proof:
  ldiv(X, op(op(Y, rdiv(X, Z)), Z))
= { by lemma 43 R->L }
  T(rdiv(op(op(Y, rdiv(X, Z)), Z), X), X) (peak)
= { by lemma 178 }
  T(R(Y, rdiv(X, Z), Z), X)

Lemma 180: T(X, rdiv(Y, a(Z, W, V))) = T(X, Y).
Proof:
  T(X, rdiv(Y, a(Z, W, V)))
= { by axiom 5 (sos) }
  ldiv(rdiv(Y, a(Z, W, V)), op(X, rdiv(Y, a(Z, W, V)))) (peak)
= { by lemma 173 }
  ldiv(Y, op(op(X, rdiv(Y, a(Z, W, V))), a(Z, W, V)))
= { by lemma 179 }
  T(R(X, rdiv(Y, a(Z, W, V)), a(Z, W, V)), Y)
= { by lemma 169 }
  T(X, Y)

Lemma 181: ldiv(op(a(X, Y, Z), W), V) = rdiv(ldiv(W, V), a(X, Y, Z)).
Proof:
  ldiv(op(a(X, Y, Z), W), V) (peak)
= { by lemma 141 }
  ldiv(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 167 }
  rdiv(ldiv(W, V), a(X, Y, Z))

Lemma 182: L(ldiv(X, T(Y, Z)), X, Z) = ldiv(op(Z, X), op(Y, Z)).
Proof:
  L(ldiv(X, T(Y, Z)), X, Z) (peak)
= { by lemma 105 R->L }
  ldiv(op(Z, X), op(Z, T(Y, Z))) (peak)
= { by lemma 58 }
  ldiv(op(Z, X), op(Y, Z))

Lemma 183: T(X, a(Y, Z, W)) = X.
Proof:
  T(X, a(Y, Z, W))
= { by axiom 5 (sos) }
  ldiv(a(Y, Z, W), op(X, a(Y, Z, W))) (peak)
= { by lemma 141 R->L }
  ldiv(a(Y, Z, W), op(a(Y, Z, W), X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 184: rdiv(ldiv(X, op(Y, a(Z, W, V))), a(Z, W, V)) = ldiv(X, Y).
Proof:
  rdiv(ldiv(X, op(Y, a(Z, W, V))), a(Z, W, V))
= { by lemma 181 R->L }
  ldiv(op(a(Z, W, V), X), op(Y, a(Z, W, V)))
= { by lemma 182 R->L }
  L(ldiv(X, T(Y, a(Z, W, V))), X, a(Z, W, V)) (peak)
= { by lemma 164 }
  ldiv(X, T(Y, a(Z, W, V)))
= { by lemma 183 }
  ldiv(X, Y)

Lemma 185: L(X, Y, rdiv(Z, a(W, V, U))) = L(X, Y, Z).
Proof:
  L(X, Y, rdiv(Z, a(W, V, U)))
= { by lemma 162 R->L }
  ldiv(op(Y, rdiv(Z, a(W, V, U))), op(rdiv(Z, a(W, V, U)), op(T(Y, rdiv(Z, a(W, V, U))), X))) (peak)
= { by lemma 171 }
  ldiv(op(Y, rdiv(Z, a(W, V, U))), rdiv(op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X)), a(W, V, U)))
= { by lemma 168 }
  rdiv(ldiv(op(Y, rdiv(Z, a(W, V, U))), op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X))), a(W, V, U))
= { by lemma 177 }
  rdiv(ldiv(rdiv(op(Y, Z), a(W, V, U)), op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X))), a(W, V, U))
= { by lemma 173 }
  rdiv(ldiv(op(Y, Z), op(op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X)), a(W, V, U))), a(W, V, U))
= { by lemma 184 }
  ldiv(op(Y, Z), op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X)))
= { by lemma 180 }
  ldiv(op(Y, Z), op(Z, op(T(Y, Z), X)))
= { by lemma 162 }
  L(X, Y, Z)

Lemma 186: rdiv(L(op(X, a(Y, Z, W)), V, U), a(Y, Z, W)) = L(X, V, U).
Proof:
  rdiv(L(op(X, a(Y, Z, W)), V, U), a(Y, Z, W))
= { by lemma 162 R->L }
  rdiv(ldiv(op(V, U), op(U, op(T(V, U), op(X, a(Y, Z, W))))), a(Y, Z, W))
= { by lemma 144 R->L }
  rdiv(ldiv(op(V, U), op(U, op(op(T(V, U), X), a(Y, Z, W)))), a(Y, Z, W))
= { by lemma 168 R->L }
  ldiv(op(V, U), rdiv(op(U, op(op(T(V, U), X), a(Y, Z, W))), a(Y, Z, W)))
= { by lemma 171 R->L }
  ldiv(op(V, U), op(rdiv(U, a(Y, Z, W)), op(op(T(V, U), X), a(Y, Z, W))))
= { by lemma 144 R->L }
  ldiv(op(V, U), op(op(rdiv(U, a(Y, Z, W)), op(T(V, U), X)), a(Y, Z, W)))
= { by lemma 173 R->L }
  ldiv(rdiv(op(V, U), a(Y, Z, W)), op(rdiv(U, a(Y, Z, W)), op(T(V, U), X)))
= { by lemma 177 R->L }
  ldiv(op(V, rdiv(U, a(Y, Z, W))), op(rdiv(U, a(Y, Z, W)), op(T(V, U), X)))
= { by lemma 180 R->L }
  ldiv(op(V, rdiv(U, a(Y, Z, W))), op(rdiv(U, a(Y, Z, W)), op(T(V, rdiv(U, a(Y, Z, W))), X))) (peak)
= { by lemma 162 }
  L(X, V, rdiv(U, a(Y, Z, W)))
= { by lemma 185 }
  L(X, V, U)

Lemma 187: rdiv(X, a(Y, Z, X)) = L(X, Z, Y).
Proof:
  rdiv(X, a(Y, Z, X))
= { by lemma 146 R->L }
  rdiv(L(op(X, a(Y, Z, X)), Z, Y), a(Y, Z, X)) (peak)
= { by lemma 186 }
  L(X, Z, Y)

Lemma 188: ldiv(op(X, op(Y, Z)), op(op(X, Y), Z)) = a(X, Y, Z).
Proof:
  ldiv(op(X, op(Y, Z)), op(op(X, Y), Z))
= { by lemma 126 R->L }
  ldiv(rdiv(op(op(X, Y), Z), a(X, Y, Z)), op(op(X, Y), Z)) (peak)
= { by lemma 39 }
  a(X, Y, Z)

Lemma 189: rdiv(rdiv(X, K(Y, Z)), W) = rdiv(X, rdiv(W, K(Z, Y))).
Proof:
  rdiv(rdiv(X, K(Y, Z)), W)
= { by lemma 147 R->L }
  R(rdiv(rdiv(X, K(Y, Z)), W), W, K(Y, Z)) (peak)
= { by lemma 154 }
  rdiv(X, op(W, K(Y, Z)))
= { by lemma 57 }
  rdiv(X, rdiv(W, K(Z, Y)))

Lemma 190: rdiv(op(X, T(Z, Y)), op(Z, Y)) = R(rdiv(X, Y), Y, T(Z, Y)).
Proof:
  rdiv(op(X, T(Z, Y)), op(Z, Y))
= { by lemma 58 R->L }
  rdiv(op(X, T(Z, Y)), op(Y, T(Z, Y))) (peak)
= { by lemma 37 }
  R(rdiv(X, Y), Y, T(Z, Y))

Lemma 191: rdiv(op(X, Y), T(Y, Z)) = rdiv(X, K(Y, Z)).
Proof:
  rdiv(op(X, Y), T(Y, Z))
= { by lemma 44 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), T(Y, Z))
= { by lemma 34 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), op(Y, K(Y, Z)))
= { by lemma 190 }
  R(rdiv(X, K(Y, Z)), K(Y, Z), T(Y, K(Y, Z))) (peak)
= { by lemma 133 }
  rdiv(X, K(Y, Z))

Lemma 192: rdiv(K(X, Y), K(X, Z)) = rdiv(T(X, Y), T(X, Z)).
Proof:
  rdiv(K(X, Y), K(X, Z))
= { by lemma 191 R->L }
  rdiv(op(K(X, Y), X), T(X, Z)) (peak)
= { by lemma 59 }
  rdiv(T(X, Y), T(X, Z))

Lemma 193: a(rdiv(X, K(Y, Z)), W, V) = a(X, W, V).
Proof:
  a(rdiv(X, K(Y, Z)), W, V)
= { by lemma 188 R->L }
  ldiv(op(rdiv(X, K(Y, Z)), op(W, V)), op(op(rdiv(X, K(Y, Z)), W), V)) (peak)
= { by lemma 153 }
  ldiv(rdiv(op(X, op(W, V)), K(Y, Z)), op(op(rdiv(X, K(Y, Z)), W), V))
= { by lemma 151 }
  ldiv(op(X, op(W, V)), rdiv(op(op(rdiv(X, K(Y, Z)), W), V), K(Z, Y)))
= { by lemma 152 }
  rdiv(ldiv(op(X, op(W, V)), op(op(rdiv(X, K(Y, Z)), W), V)), K(Z, Y))
= { by lemma 153 }
  rdiv(ldiv(op(X, op(W, V)), op(rdiv(op(X, W), K(Y, Z)), V)), K(Z, Y))
= { by lemma 153 }
  rdiv(ldiv(op(X, op(W, V)), rdiv(op(op(X, W), V), K(Y, Z))), K(Z, Y))
= { by lemma 152 }
  rdiv(rdiv(ldiv(op(X, op(W, V)), op(op(X, W), V)), K(Y, Z)), K(Z, Y))
= { by lemma 189 }
  rdiv(ldiv(op(X, op(W, V)), op(op(X, W), V)), rdiv(K(Z, Y), K(Z, Y)))
= { by lemma 188 }
  rdiv(a(X, W, V), rdiv(K(Z, Y), K(Z, Y)))
= { by lemma 192 }
  rdiv(a(X, W, V), rdiv(T(Z, Y), T(Z, Y)))
= { by lemma 26 }
  rdiv(a(X, W, V), zero)
= { by lemma 27 }
  a(X, W, V)

Lemma 194: a(T(X, Y), Z, W) = a(X, Z, W).
Proof:
  a(T(X, Y), Z, W)
= { by lemma 193 R->L }
  a(rdiv(T(X, Y), K(X, Y)), Z, W) (peak)
= { by lemma 138 }
  a(X, Z, W)

Lemma 195: T(X, op(Y, a(Z, W, V))) = T(X, Y).
Proof:
  T(X, op(Y, a(Z, W, V)))
= { by lemma 180 R->L }
  T(X, rdiv(op(Y, a(Z, W, V)), a(Z, W, V))) (peak)
= { by axiom 3 (sos) }
  T(X, Y)

Lemma 196: T(X, op(a(Y, Z, W), V)) = T(X, V).
Proof:
  T(X, op(a(Y, Z, W), V)) (peak)
= { by lemma 141 }
  T(X, op(V, a(Y, Z, W))) (peak)
= { by lemma 195 }
  T(X, V)

Lemma 197: T(X, op(Y, rdiv(Z, Y))) = T(X, Z).
Proof:
  T(X, op(Y, rdiv(Z, Y)))
= { by lemma 130 R->L }
  T(X, op(rdiv(Z, Y), Y)) (peak)
= { by axiom 9 (sos) }
  T(X, Z)

Lemma 198: T(X, L(Y, Z, W)) = T(X, Y).
Proof:
  T(X, L(Y, Z, W))
= { by lemma 196 R->L }
  T(X, op(a(W, Z, Y), L(Y, Z, W)))
= { by lemma 187 R->L }
  T(X, op(a(W, Z, Y), rdiv(Y, a(W, Z, Y)))) (peak)
= { by lemma 197 }
  T(X, Y)

Lemma 199: rdiv(X, K(rdiv(X, Y), Y)) = op(Y, rdiv(X, Y)).
Proof:
  rdiv(X, K(rdiv(X, Y), Y))
= { by axiom 9 (sos) R->L }
  rdiv(op(rdiv(X, Y), Y), K(rdiv(X, Y), Y)) (peak)
= { by lemma 28 }
  op(Y, rdiv(X, Y))

Lemma 200: ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) = op(Y, Z).
Proof:
  ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) (peak)
= { by lemma 37 R->L }
  ldiv(rdiv(op(X, Z), op(Y, Z)), op(X, Z)) (peak)
= { by lemma 39 }
  op(Y, Z)

Lemma 201: ldiv(op(X, rdiv(Y, X)), op(Y, Z)) = rdiv(Z, K(X, rdiv(Y, X))).
Proof:
  ldiv(op(X, rdiv(Y, X)), op(Y, Z))
= { by lemma 133 R->L }
  ldiv(R(op(X, rdiv(Y, X)), K(rdiv(Y, X), X), Z), op(Y, Z))
= { by lemma 199 R->L }
  ldiv(R(rdiv(Y, K(rdiv(Y, X), X)), K(rdiv(Y, X), X), Z), op(Y, Z)) (peak)
= { by lemma 200 }
  op(K(rdiv(Y, X), X), Z)
= { by lemma 56 }
  rdiv(Z, K(X, rdiv(Y, X)))

Lemma 202: rdiv(ldiv(X, Y), K(Z, rdiv(X, Z))) = ldiv(op(Z, rdiv(X, Z)), Y).
Proof:
  rdiv(ldiv(X, Y), K(Z, rdiv(X, Z)))
= { by lemma 201 R->L }
  ldiv(op(Z, rdiv(X, Z)), op(X, ldiv(X, Y))) (peak)
= { by axiom 8 (sos) }
  ldiv(op(Z, rdiv(X, Z)), Y)

Lemma 203: L(T(X, rdiv(Y, Z)), rdiv(Y, Z), Z) = ldiv(Y, op(Z, op(X, ldiv(Z, Y)))).
Proof:
  L(T(X, rdiv(Y, Z)), rdiv(Y, Z), Z)
= { by lemma 140 R->L }
  L(T(X, ldiv(Z, Y)), rdiv(Y, Z), Z)
= { by lemma 161 R->L }
  ldiv(Y, op(Z, op(ldiv(Z, Y), T(X, ldiv(Z, Y))))) (peak)
= { by lemma 58 }
  ldiv(Y, op(Z, op(X, ldiv(Z, Y))))

Lemma 204: T(X, rdiv(Y, op(Z, rdiv(W, Z)))) = T(X, rdiv(Y, W)).
Proof:
  T(X, rdiv(Y, op(Z, rdiv(W, Z))))
= { by lemma 140 R->L }
  T(X, ldiv(op(Z, rdiv(W, Z)), Y))
= { by lemma 136 R->L }
  L(T(X, ldiv(op(Z, rdiv(W, Z)), Y)), rdiv(Y, W), K(Z, rdiv(W, Z)))
= { by lemma 160 R->L }
  L(T(X, ldiv(op(Z, rdiv(W, Z)), Y)), ldiv(W, Y), K(Z, rdiv(W, Z)))
= { by lemma 156 R->L }
  L(T(X, ldiv(op(Z, rdiv(W, Z)), Y)), rdiv(ldiv(W, Y), K(Z, rdiv(W, Z))), K(Z, rdiv(W, Z)))
= { by lemma 202 R->L }
  L(T(X, rdiv(ldiv(W, Y), K(Z, rdiv(W, Z)))), rdiv(ldiv(W, Y), K(Z, rdiv(W, Z))), K(Z, rdiv(W, Z))) (peak)
= { by lemma 203 }
  ldiv(ldiv(W, Y), op(K(Z, rdiv(W, Z)), op(X, ldiv(K(Z, rdiv(W, Z)), ldiv(W, Y)))))
= { by lemma 56 }
  ldiv(ldiv(W, Y), rdiv(op(X, ldiv(K(Z, rdiv(W, Z)), ldiv(W, Y))), K(rdiv(W, Z), Z)))
= { by lemma 152 }
  rdiv(ldiv(ldiv(W, Y), op(X, ldiv(K(Z, rdiv(W, Z)), ldiv(W, Y)))), K(rdiv(W, Z), Z))
= { by lemma 45 }
  rdiv(ldiv(ldiv(W, Y), op(X, rdiv(ldiv(W, Y), K(Z, rdiv(W, Z))))), K(rdiv(W, Z), Z))
= { by lemma 125 }
  rdiv(ldiv(ldiv(W, Y), rdiv(op(X, ldiv(W, Y)), K(Z, rdiv(W, Z)))), K(rdiv(W, Z), Z))
= { by lemma 152 }
  rdiv(rdiv(ldiv(ldiv(W, Y), op(X, ldiv(W, Y))), K(Z, rdiv(W, Z))), K(rdiv(W, Z), Z))
= { by lemma 189 }
  rdiv(ldiv(ldiv(W, Y), op(X, ldiv(W, Y))), rdiv(K(rdiv(W, Z), Z), K(rdiv(W, Z), Z)))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, ldiv(W, Y)), rdiv(K(rdiv(W, Z), Z), K(rdiv(W, Z), Z)))
= { by lemma 140 }
  rdiv(T(X, rdiv(Y, W)), rdiv(K(rdiv(W, Z), Z), K(rdiv(W, Z), Z)))
= { by lemma 192 }
  rdiv(T(X, rdiv(Y, W)), rdiv(T(rdiv(W, Z), Z), T(rdiv(W, Z), Z)))
= { by lemma 26 }
  rdiv(T(X, rdiv(Y, W)), zero)
= { by lemma 27 }
  T(X, rdiv(Y, W))

Lemma 205: rdiv(ldiv(X, Y), K(rdiv(Y, X), X)) = rdiv(Y, X).
Proof:
  rdiv(ldiv(X, Y), K(rdiv(Y, X), X))
= { by lemma 57 R->L }
  op(ldiv(X, Y), K(X, rdiv(Y, X)))
= { by lemma 83 R->L }
  op(ldiv(X, Y), K(X, ldiv(X, Y)))
= { by lemma 62 R->L }
  op(ldiv(X, Y), K(rdiv(Y, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 158 }
  rdiv(Y, rdiv(Y, ldiv(X, Y)))
= { by lemma 62 }
  rdiv(Y, X)

Lemma 206: rdiv(op(X, Y), K(rdiv(X, Z), Z)) = op(op(Z, rdiv(X, Z)), Y).
Proof:
  rdiv(op(X, Y), K(rdiv(X, Z), Z))
= { by lemma 125 R->L }
  op(X, rdiv(Y, K(rdiv(X, Z), Z)))
= { by lemma 56 R->L }
  op(X, op(K(Z, rdiv(X, Z)), Y))
= { by lemma 126 R->L }
  rdiv(op(op(X, K(Z, rdiv(X, Z))), Y), a(X, K(Z, rdiv(X, Z)), Y)) (peak)
= { by lemma 41 }
  rdiv(op(op(Z, rdiv(X, Z)), Y), a(X, K(Z, rdiv(X, Z)), Y))
= { by axiom 13 (sos) }
  rdiv(op(op(Z, rdiv(X, Z)), Y), 1)
= { by lemma 25 }
  rdiv(op(op(Z, rdiv(X, Z)), Y), zero)
= { by lemma 27 }
  op(op(Z, rdiv(X, Z)), Y)

Lemma 207: T(X, op(Y, op(Z, rdiv(W, Z)))) = T(X, op(Y, W)).
Proof:
  T(X, op(Y, op(Z, rdiv(W, Z)))) (peak)
= { by lemma 130 R->L }
  T(X, op(op(Z, rdiv(W, Z)), Y))
= { by lemma 136 R->L }
  L(T(X, op(op(Z, rdiv(W, Z)), Y)), op(W, Y), K(rdiv(W, Z), Z))
= { by lemma 156 R->L }
  L(T(X, op(op(Z, rdiv(W, Z)), Y)), rdiv(op(W, Y), K(rdiv(W, Z), Z)), K(rdiv(W, Z), Z))
= { by lemma 206 R->L }
  L(T(X, rdiv(op(W, Y), K(rdiv(W, Z), Z))), rdiv(op(W, Y), K(rdiv(W, Z), Z)), K(rdiv(W, Z), Z)) (peak)
= { by lemma 203 }
  ldiv(op(W, Y), op(K(rdiv(W, Z), Z), op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y)))))
= { by lemma 56 }
  ldiv(op(W, Y), rdiv(op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y))), K(Z, rdiv(W, Z))))
= { by lemma 152 }
  rdiv(ldiv(op(W, Y), op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y)))), K(Z, rdiv(W, Z)))
= { by lemma 45 }
  rdiv(ldiv(op(W, Y), op(X, rdiv(op(W, Y), K(rdiv(W, Z), Z)))), K(Z, rdiv(W, Z)))
= { by lemma 125 }
  rdiv(ldiv(op(W, Y), rdiv(op(X, op(W, Y)), K(rdiv(W, Z), Z))), K(Z, rdiv(W, Z)))
= { by lemma 152 }
  rdiv(rdiv(ldiv(op(W, Y), op(X, op(W, Y))), K(rdiv(W, Z), Z)), K(Z, rdiv(W, Z)))
= { by lemma 189 }
  rdiv(ldiv(op(W, Y), op(X, op(W, Y))), rdiv(K(Z, rdiv(W, Z)), K(Z, rdiv(W, Z))))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, op(W, Y)), rdiv(K(Z, rdiv(W, Z)), K(Z, rdiv(W, Z))))
= { by lemma 26 }
  rdiv(T(X, op(W, Y)), zero)
= { by lemma 27 }
  T(X, op(W, Y))
= { by lemma 130 }
  T(X, op(Y, W))

Lemma 208: rdiv(op(X, Y), K(Z, X)) = op(T(X, Z), Y).
Proof:
  rdiv(op(X, Y), K(Z, X))
= { by lemma 56 R->L }
  op(K(X, Z), op(X, Y))
= { by lemma 30 R->L }
  op(op(X, K(X, Z)), Y) (peak)
= { by lemma 34 }
  op(T(X, Z), Y)

Lemma 209: T(X, op(Y, T(Z, W))) = T(X, op(Y, Z)).
Proof:
  T(X, op(Y, T(Z, W))) (peak)
= { by lemma 130 R->L }
  T(X, op(T(Z, W), Y))
= { by lemma 208 R->L }
  T(X, rdiv(op(Z, Y), K(W, Z))) (peak)
= { by lemma 137 }
  T(X, op(Z, Y))
= { by lemma 130 }
  T(X, op(Y, Z))

Lemma 210: T(X, op(Y, ldiv(Z, W))) = T(X, op(Y, rdiv(W, Z))).
Proof:
  T(X, op(Y, ldiv(Z, W)))
= { by lemma 207 R->L }
  T(X, op(Y, op(K(rdiv(W, Z), Z), rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))))) (peak)
= { by lemma 205 }
  T(X, op(Y, op(K(rdiv(W, Z), Z), rdiv(W, Z))))
= { by lemma 59 }
  T(X, op(Y, T(rdiv(W, Z), Z)))
= { by lemma 209 }
  T(X, op(Y, rdiv(W, Z)))

Lemma 211: L(X, K(Y, Z), Y) = X.
Proof:
  L(X, K(Y, Z), Y)
= { by lemma 44 R->L }
  L(T(X, K(Y, Z)), K(Y, Z), Y)
= { by lemma 131 R->L }
  ldiv(op(Y, K(Y, Z)), op(Y, op(X, K(Y, Z)))) (peak)
= { by lemma 34 }
  ldiv(T(Y, Z), op(Y, op(X, K(Y, Z))))
= { by lemma 57 }
  ldiv(T(Y, Z), op(Y, rdiv(X, K(Z, Y))))
= { by lemma 125 }
  ldiv(T(Y, Z), rdiv(op(Y, X), K(Z, Y)))
= { by lemma 208 }
  ldiv(T(Y, Z), op(T(Y, Z), X))
= { by axiom 4 (sos) }
  X

Lemma 212: rdiv(ldiv(X, Y), K(X, Z)) = ldiv(T(X, Z), Y).
Proof:
  rdiv(ldiv(X, Y), K(X, Z))
= { by lemma 45 R->L }
  ldiv(K(X, Z), ldiv(X, Y))
= { by lemma 211 R->L }
  L(ldiv(K(X, Z), ldiv(X, Y)), K(X, Z), X) (peak)
= { by lemma 150 }
  ldiv(op(X, K(X, Z)), Y)
= { by lemma 34 }
  ldiv(T(X, Z), Y)

Lemma 213: T(X, rdiv(Y, T(Z, W))) = T(X, rdiv(Y, Z)).
Proof:
  T(X, rdiv(Y, T(Z, W)))
= { by lemma 137 R->L }
  T(X, rdiv(rdiv(Y, T(Z, W)), K(W, Z)))
= { by lemma 56 R->L }
  T(X, op(K(Z, W), rdiv(Y, T(Z, W))))
= { by lemma 210 R->L }
  T(X, op(K(Z, W), ldiv(T(Z, W), Y)))
= { by lemma 212 R->L }
  T(X, op(K(Z, W), rdiv(ldiv(Z, Y), K(Z, W)))) (peak)
= { by lemma 197 }
  T(X, ldiv(Z, Y))
= { by lemma 140 }
  T(X, rdiv(Y, Z))

Lemma 214: T(X, rdiv(Y, ldiv(Z, W))) = T(X, rdiv(Y, rdiv(W, Z))).
Proof:
  T(X, rdiv(Y, ldiv(Z, W)))
= { by lemma 204 R->L }
  T(X, rdiv(Y, op(K(rdiv(W, Z), Z), rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))))) (peak)
= { by lemma 205 }
  T(X, rdiv(Y, op(K(rdiv(W, Z), Z), rdiv(W, Z))))
= { by lemma 59 }
  T(X, rdiv(Y, T(rdiv(W, Z), Z)))
= { by lemma 213 }
  T(X, rdiv(Y, rdiv(W, Z)))

Lemma 215: T(X, rdiv(op(Y, Z), W)) = T(X, rdiv(Z, rdiv(W, Y))).
Proof:
  T(X, rdiv(op(Y, Z), W))
= { by lemma 140 R->L }
  T(X, ldiv(W, op(Y, Z)))
= { by lemma 172 R->L }
  T(X, L(ldiv(ldiv(Y, W), Z), rdiv(W, Y), Y)) (peak)
= { by lemma 198 }
  T(X, ldiv(ldiv(Y, W), Z))
= { by lemma 140 }
  T(X, rdiv(Z, ldiv(Y, W)))
= { by lemma 214 }
  T(X, rdiv(Z, rdiv(W, Y)))

Lemma 216: ldiv(rdiv(op(X, Y), Z), op(Y, X)) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(rdiv(op(X, Y), Z), op(Y, X))
= { by lemma 147 R->L }
  ldiv(R(rdiv(op(X, Y), Z), Z, K(Y, X)), op(Y, X))
= { by axiom 18 (sos) }
  ldiv(R(rdiv(op(X, Y), Z), Z, K(Y, X)), op(op(X, Y), K(Y, X))) (peak)
= { by lemma 200 }
  op(Z, K(Y, X))
= { by lemma 57 }
  rdiv(Z, K(X, Y))

Lemma 217: rdiv(ldiv(X, op(Y, Z)), K(Y, Z)) = ldiv(X, op(Z, Y)).
Proof:
  rdiv(ldiv(X, op(Y, Z)), K(Y, Z))
= { by lemma 216 R->L }
  ldiv(rdiv(op(Y, Z), ldiv(X, op(Y, Z))), op(Z, Y)) (peak)
= { by lemma 62 }
  ldiv(X, op(Z, Y))

Lemma 218: T(X, rdiv(Y, rdiv(Z, W))) = T(X, rdiv(W, rdiv(Z, Y))).
Proof:
  T(X, rdiv(Y, rdiv(Z, W)))
= { by lemma 215 R->L }
  T(X, rdiv(op(W, Y), Z))
= { by lemma 27 R->L }
  rdiv(T(X, rdiv(op(W, Y), Z)), zero)
= { by lemma 26 R->L }
  rdiv(T(X, rdiv(op(W, Y), Z)), rdiv(K(Y, W), K(Y, W)))
= { by lemma 140 R->L }
  rdiv(T(X, ldiv(Z, op(W, Y))), rdiv(K(Y, W), K(Y, W)))
= { by axiom 5 (sos) }
  rdiv(ldiv(ldiv(Z, op(W, Y)), op(X, ldiv(Z, op(W, Y)))), rdiv(K(Y, W), K(Y, W)))
= { by lemma 189 R->L }
  rdiv(rdiv(ldiv(ldiv(Z, op(W, Y)), op(X, ldiv(Z, op(W, Y)))), K(W, Y)), K(Y, W))
= { by lemma 152 R->L }
  rdiv(ldiv(ldiv(Z, op(W, Y)), rdiv(op(X, ldiv(Z, op(W, Y))), K(W, Y))), K(Y, W))
= { by lemma 125 R->L }
  rdiv(ldiv(ldiv(Z, op(W, Y)), op(X, rdiv(ldiv(Z, op(W, Y)), K(W, Y)))), K(Y, W))
= { by lemma 45 R->L }
  rdiv(ldiv(ldiv(Z, op(W, Y)), op(X, ldiv(K(W, Y), ldiv(Z, op(W, Y))))), K(Y, W))
= { by lemma 152 R->L }
  ldiv(ldiv(Z, op(W, Y)), rdiv(op(X, ldiv(K(W, Y), ldiv(Z, op(W, Y)))), K(Y, W)))
= { by lemma 56 R->L }
  ldiv(ldiv(Z, op(W, Y)), op(K(W, Y), op(X, ldiv(K(W, Y), ldiv(Z, op(W, Y))))))
= { by lemma 203 R->L }
  L(T(X, rdiv(ldiv(Z, op(W, Y)), K(W, Y))), rdiv(ldiv(Z, op(W, Y)), K(W, Y)), K(W, Y)) (peak)
= { by lemma 217 }
  L(T(X, ldiv(Z, op(Y, W))), rdiv(ldiv(Z, op(W, Y)), K(W, Y)), K(W, Y))
= { by lemma 156 }
  L(T(X, ldiv(Z, op(Y, W))), ldiv(Z, op(W, Y)), K(W, Y))
= { by lemma 160 }
  L(T(X, ldiv(Z, op(Y, W))), rdiv(op(W, Y), Z), K(W, Y))
= { by lemma 136 }
  T(X, ldiv(Z, op(Y, W)))
= { by lemma 140 }
  T(X, rdiv(op(Y, W), Z))
= { by lemma 215 }
  T(X, rdiv(W, rdiv(Z, Y)))

Lemma 219: T(X, rdiv(op(Y, Z), W)) = T(X, rdiv(Y, rdiv(W, Z))).
Proof:
  T(X, rdiv(op(Y, Z), W))
= { by lemma 140 R->L }
  T(X, ldiv(W, op(Y, Z)))
= { by lemma 172 R->L }
  T(X, L(ldiv(ldiv(Y, W), Z), rdiv(W, Y), Y)) (peak)
= { by lemma 198 }
  T(X, ldiv(ldiv(Y, W), Z))
= { by lemma 140 }
  T(X, rdiv(Z, ldiv(Y, W)))
= { by lemma 214 }
  T(X, rdiv(Z, rdiv(W, Y)))
= { by lemma 218 }
  T(X, rdiv(Y, rdiv(W, Z)))

Lemma 220: rdiv(X, K(X, rdiv(Y, X))) = rdiv(Y, rdiv(Y, X)).
Proof:
  rdiv(X, K(X, rdiv(Y, X)))
= { by lemma 44 R->L }
  rdiv(T(X, K(Z, W)), K(X, rdiv(Y, X)))
= { by lemma 57 R->L }
  op(T(X, K(Z, W)), K(rdiv(Y, X), X))
= { by lemma 208 R->L }
  rdiv(op(X, K(rdiv(Y, X), X)), K(K(Z, W), X)) (peak)
= { by lemma 158 }
  rdiv(rdiv(Y, rdiv(Y, X)), K(K(Z, W), X)) (peak)
= { by axiom 7 (sos) }
  rdiv(rdiv(Y, rdiv(Y, X)), 1)
= { by lemma 25 }
  rdiv(rdiv(Y, rdiv(Y, X)), zero)
= { by lemma 27 }
  rdiv(Y, rdiv(Y, X))

Lemma 221: T(X, rdiv(Y, rdiv(Y, Z))) = T(X, Z).
Proof:
  T(X, rdiv(Y, rdiv(Y, Z))) (peak)
= { by lemma 220 R->L }
  T(X, rdiv(Z, K(Z, rdiv(Y, Z)))) (peak)
= { by lemma 137 }
  T(X, Z)

Lemma 222: T(X, R(Y, Z, W)) = T(X, Y).
Proof:
  T(X, R(Y, Z, W))
= { by axiom 19 (sos) }
  T(X, rdiv(op(op(Y, Z), W), op(Z, W))) (peak)
= { by lemma 219 }
  T(X, rdiv(op(Y, Z), rdiv(op(Z, W), W)))
= { by lemma 215 }
  T(X, rdiv(Z, rdiv(rdiv(op(Z, W), W), Y)))
= { by axiom 3 (sos) }
  T(X, rdiv(Z, rdiv(Z, Y)))
= { by lemma 221 }
  T(X, Y)

Lemma 223: K(X, R(Y, W, V)) = K(X, T(Y, Z)).
Proof:
  K(X, R(Y, W, V))
= { by lemma 61 R->L }
  ldiv(X, T(X, R(Y, W, V))) (peak)
= { by lemma 222 }
  ldiv(X, T(X, Y))
= { by lemma 61 }
  K(X, Y)
= { by lemma 115 R->L }
  K(X, T(Y, Z)) (peak)

Lemma 224: T(X, R(Y, W, V)) = T(X, T(Y, Z)).
Proof:
  T(X, R(Y, W, V)) (peak)
= { by lemma 222 }
  T(X, Y)
= { by lemma 139 R->L }
  T(X, T(Y, Z)) (peak)

Lemma 225: K(R(X, W, V), Z) = K(T(X, Y), Z).
Proof:
  K(R(X, W, V), Z)
= { by lemma 82 R->L }
  rdiv(Z, T(Z, R(X, W, V)))
= { by lemma 78 R->L }
  ldiv(T(Z, R(X, W, V)), Z) (peak)
= { by lemma 224 }
  ldiv(T(Z, T(X, Y)), Z) (peak)
= { by lemma 74 }
  K(T(X, Y), Z)

Lemma 226: op(X, rdiv(T(Y, Z), Y)) = rdiv(X, rdiv(Y, T(Y, Z))).
Proof:
  op(X, rdiv(T(Y, Z), Y))
= { by lemma 65 R->L }
  op(X, ldiv(Y, T(Y, Z))) (peak)
= { by lemma 61 }
  op(X, K(Y, Z))
= { by lemma 57 }
  rdiv(X, K(Z, Y))
= { by lemma 82 R->L }
  rdiv(X, rdiv(Y, T(Y, Z)))

Lemma 227: rdiv(op(X, Y), rdiv(Y, T(Y, Z))) = op(X, T(Y, Z)).
Proof:
  rdiv(op(X, Y), rdiv(Y, T(Y, Z)))
= { by lemma 226 R->L }
  op(op(X, Y), rdiv(T(Y, Z), Y))
= { by lemma 92 R->L }
  op(rdiv(op(X, T(Y, Z)), rdiv(T(Y, Z), Y)), rdiv(T(Y, Z), Y)) (peak)
= { by axiom 9 (sos) }
  op(X, T(Y, Z))

Lemma 228: rdiv(R(X, Z, W), T(R(X, Z, W), Y)) = rdiv(X, T(X, Y)).
Proof:
  rdiv(R(X, Z, W), T(R(X, Z, W), Y)) (peak)
= { by lemma 82 }
  K(Y, R(X, Z, W))
= { by lemma 223 }
  K(Y, T(X, Y)) (peak)
= { by lemma 85 }
  rdiv(X, T(X, Y)) (peak)

Lemma 229: rdiv(op(X, Y), rdiv(X, T(X, Z))) = op(T(X, Z), Y).
Proof:
  rdiv(op(X, Y), rdiv(X, T(X, Z)))
= { by lemma 80 R->L }
  rdiv(op(X, Y), L(rdiv(X, T(X, Z)), Y, T(X, Z)))
= { by lemma 94 R->L }
  rdiv(op(T(X, Z), op(Y, rdiv(X, T(X, Z)))), L(rdiv(X, T(X, Z)), Y, T(X, Z))) (peak)
= { by lemma 175 }
  op(T(X, Z), Y)

Lemma 230: op(T(X, Y), ldiv(X, Z)) = rdiv(Z, rdiv(X, T(X, Y))).
Proof:
  op(T(X, Y), ldiv(X, Z))
= { by lemma 229 R->L }
  rdiv(op(X, ldiv(X, Z)), rdiv(X, T(X, Y))) (peak)
= { by axiom 8 (sos) }
  rdiv(Z, rdiv(X, T(X, Y)))

Lemma 231: K(R(T(X, V), U, T), W) = K(R(X, Y, Z), W).
Proof:
  K(R(T(X, V), U, T), W)
= { by lemma 82 R->L }
  rdiv(W, T(W, R(T(X, V), U, T)))
= { by lemma 78 R->L }
  ldiv(T(W, R(T(X, V), U, T)), W) (peak)
= { by lemma 222 }
  ldiv(T(W, T(X, V)), W)
= { by lemma 74 }
  K(T(X, V), W)
= { by lemma 225 R->L }
  K(R(X, Y, Z), W) (peak)

Lemma 232: op(R(X, Y, Z), op(Y, Z)) = op(op(X, Y), Z).
Proof:
  op(R(X, Y, Z), op(Y, Z))
= { by axiom 19 (sos) }
  op(rdiv(op(op(X, Y), Z), op(Y, Z)), op(Y, Z)) (peak)
= { by axiom 9 (sos) }
  op(op(X, Y), Z)

Lemma 233: ldiv(op(X, op(Y, Z)), op(R(X, Y, Z), op(Y, Z))) = a(T(X, W), Y, Z).
Proof:
  ldiv(op(X, op(Y, Z)), op(R(X, Y, Z), op(Y, Z))) (peak)
= { by lemma 232 }
  ldiv(op(X, op(Y, Z)), op(op(X, Y), Z))
= { by lemma 188 }
  a(X, Y, Z)
= { by lemma 194 R->L }
  a(T(X, W), Y, Z) (peak)

Lemma 234: rdiv(Z, op(Y, ldiv(op(X, Y), Z))) = R(X, Y, ldiv(op(X, Y), Z)).
Proof:
  rdiv(Z, op(Y, ldiv(op(X, Y), Z)))
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, Y), ldiv(op(X, Y), Z)), op(Y, ldiv(op(X, Y), Z))) (peak)
= { by axiom 19 (sos) R->L }
  R(X, Y, ldiv(op(X, Y), Z))

Lemma 235: ldiv(R(X, Y, ldiv(op(X, Y), Z)), Z) = op(Y, ldiv(op(X, Y), Z)).
Proof:
  ldiv(R(X, Y, ldiv(op(X, Y), Z)), Z) (peak)
= { by lemma 234 R->L }
  ldiv(rdiv(Z, op(Y, ldiv(op(X, Y), Z))), Z) (peak)
= { by lemma 39 }
  op(Y, ldiv(op(X, Y), Z))

Lemma 236: ldiv(T(X, W), op(R(T(X, W), Y, Z), op(Y, Z))) = ldiv(X, op(R(X, Y, Z), op(Y, Z))).
Proof:
  ldiv(T(X, W), op(R(T(X, W), Y, Z), op(Y, Z))) (peak)
= { by lemma 232 }
  ldiv(T(X, W), op(op(T(X, W), Y), Z))
= { by lemma 170 R->L }
  op(Y, op(Z, a(T(X, W), Y, Z)))
= { by lemma 144 R->L }
  op(op(Y, Z), a(T(X, W), Y, Z))
= { by lemma 233 R->L }
  op(op(Y, Z), ldiv(op(X, op(Y, Z)), op(R(X, Y, Z), op(Y, Z))))
= { by lemma 235 R->L }
  ldiv(R(X, op(Y, Z), ldiv(op(X, op(Y, Z)), op(R(X, Y, Z), op(Y, Z)))), op(R(X, Y, Z), op(Y, Z))) (peak)
= { by lemma 233 }
  ldiv(R(X, op(Y, Z), a(T(X, V), Y, Z)), op(R(X, Y, Z), op(Y, Z))) (peak)
= { by lemma 169 }
  ldiv(X, op(R(X, Y, Z), op(Y, Z)))

Lemma 237: ldiv(T(X, W), op(op(Y, Z), R(T(X, W), Y, Z))) = ldiv(X, op(op(Y, Z), R(X, Y, Z))).
Proof:
  ldiv(T(X, W), op(op(Y, Z), R(T(X, W), Y, Z)))
= { by lemma 217 R->L }
  rdiv(ldiv(T(X, W), op(R(T(X, W), Y, Z), op(Y, Z))), K(R(T(X, W), Y, Z), op(Y, Z))) (peak)
= { by lemma 231 }
  rdiv(ldiv(T(X, W), op(R(T(X, W), Y, Z), op(Y, Z))), K(R(X, Y, Z), op(Y, Z)))
= { by lemma 236 }
  rdiv(ldiv(X, op(R(X, Y, Z), op(Y, Z))), K(R(X, Y, Z), op(Y, Z)))
= { by lemma 217 }
  ldiv(X, op(op(Y, Z), R(X, Y, Z)))

Lemma 238: op(op(X, Y), T(R(Z, X, Y), W)) = op(op(X, Y), R(T(Z, W), X, Y)).
Proof:
  op(op(X, Y), T(R(Z, X, Y), W))
= { by lemma 227 R->L }
  rdiv(op(op(X, Y), R(Z, X, Y)), rdiv(R(Z, X, Y), T(R(Z, X, Y), W))) (peak)
= { by lemma 228 }
  rdiv(op(op(X, Y), R(Z, X, Y)), rdiv(Z, T(Z, W)))
= { by lemma 230 R->L }
  op(T(Z, W), ldiv(Z, op(op(X, Y), R(Z, X, Y))))
= { by lemma 237 R->L }
  op(T(Z, W), ldiv(T(Z, W), op(op(X, Y), R(T(Z, W), X, Y)))) (peak)
= { by axiom 8 (sos) }
  op(op(X, Y), R(T(Z, W), X, Y))

Lemma 239: T(R(X, Y, Z), W) = R(T(X, W), Y, Z).
Proof:
  T(R(X, Y, Z), W)
= { by axiom 4 (sos) R->L }
  ldiv(op(Y, Z), op(op(Y, Z), T(R(X, Y, Z), W))) (peak)
= { by lemma 238 }
  ldiv(op(Y, Z), op(op(Y, Z), R(T(X, W), Y, Z)))
= { by axiom 4 (sos) }
  R(T(X, W), Y, Z)

Goal 1 (goals): T(R(x3, x4, x5), x6) = R(T(x3, x6), x4, x5).
Proof:
  T(R(x3, x4, x5), x6) (peak)
= { by lemma 239 }
  R(T(x3, x6), x4, x5)

RESULT: Theorem (the conjecture is true).
