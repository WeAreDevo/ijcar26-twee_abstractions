The conjecture is true! Here is a proof.

Axiom 1 (sos): op(X, zero) = X.
Axiom 2 (sos): op(zero, X) = X.
Axiom 3 (sos): rdiv(op(X, Y), Y) = X.
Axiom 4 (sos): ldiv(X, op(X, Y)) = Y.
Axiom 5 (sos): T(X, Y) = ldiv(Y, op(X, Y)).
Axiom 6 (sos): K(X, K(Y, Z)) = 1.
Axiom 7 (sos): K(K(X, Y), Z) = 1.
Axiom 8 (sos): op(X, ldiv(X, Y)) = Y.
Axiom 9 (sos): op(rdiv(X, Y), Y) = X.
Axiom 10 (sos): K(X, a(Y, Z, W)) = 1.
Axiom 11 (sos): K(a(X, Y, Z), W) = 1.
Axiom 12 (sos): a(X, Y, K(Z, W)) = 1.
Axiom 13 (sos): a(X, K(Y, Z), W) = 1.
Axiom 14 (sos): a(K(X, Y), Z, W) = 1.
Axiom 15 (sos): a(X, Y, a(Z, W, V)) = 1.
Axiom 16 (sos): a(X, a(Y, Z, W), V) = 1.
Axiom 17 (sos): a(a(X, Y, Z), W, V) = 1.
Axiom 18 (sos): op(X, Y) = op(op(Y, X), K(X, Y)).
Axiom 19 (sos): R(X, Y, Z) = rdiv(op(op(X, Y), Z), op(Y, Z)).
Axiom 20 (sos): L(X, Y, Z) = ldiv(op(Z, Y), op(Z, op(Y, X))).
Axiom 21 (sos): op(op(X, Y), Z) = op(op(X, op(Y, Z)), a(X, Y, Z)).

Lemma 22: op(X, K(zero, X)) = X.
Proof:
  op(X, K(zero, X))
= { by axiom 1 (sos) R->L }
  op(op(X, zero), K(zero, X)) (peak)
= { by axiom 18 (sos) R->L }
  op(zero, X)
= { by axiom 2 (sos) }
  X

Lemma 23: ldiv(X, X) = zero.
Proof:
  ldiv(X, X)
= { by axiom 1 (sos) R->L }
  ldiv(X, op(X, zero)) (peak)
= { by axiom 4 (sos) }
  zero

Lemma 24: K(zero, X) = zero.
Proof:
  K(zero, X)
= { by axiom 4 (sos) R->L }
  ldiv(X, op(X, K(zero, X))) (peak)
= { by lemma 22 }
  ldiv(X, X)
= { by lemma 23 }
  zero

Lemma 25: 1 = zero.
Proof:
  1
= { by axiom 6 (sos) R->L }
  K(zero, K(X, Y)) (peak)
= { by lemma 24 }
  zero

Lemma 26: rdiv(X, X) = zero.
Proof:
  rdiv(X, X)
= { by axiom 2 (sos) R->L }
  rdiv(op(zero, X), X) (peak)
= { by axiom 3 (sos) }
  zero

Lemma 27: rdiv(X, zero) = X.
Proof:
  rdiv(X, zero)
= { by axiom 1 (sos) R->L }
  rdiv(op(X, zero), zero) (peak)
= { by axiom 3 (sos) }
  X

Lemma 28: rdiv(op(X, Y), K(X, Y)) = op(Y, X).
Proof:
  rdiv(op(X, Y), K(X, Y))
= { by axiom 18 (sos) }
  rdiv(op(op(Y, X), K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  op(Y, X)

Lemma 29: op(K(X, Y), Z) = op(Z, K(X, Y)).
Proof:
  op(K(X, Y), Z)
= { by lemma 28 R->L }
  rdiv(op(Z, K(X, Y)), K(Z, K(X, Y))) (peak)
= { by axiom 6 (sos) }
  rdiv(op(Z, K(X, Y)), 1)
= { by lemma 25 }
  rdiv(op(Z, K(X, Y)), zero)
= { by lemma 27 }
  op(Z, K(X, Y))

Lemma 30: op(op(X, K(Y, Z)), W) = op(K(Y, Z), op(X, W)).
Proof:
  op(op(X, K(Y, Z)), W) (peak)
= { by lemma 29 R->L }
  op(op(K(Y, Z), X), W)
= { by axiom 21 (sos) }
  op(op(K(Y, Z), op(X, W)), a(K(Y, Z), X, W)) (peak)
= { by lemma 29 }
  op(op(op(X, W), K(Y, Z)), a(K(Y, Z), X, W)) (peak)
= { by axiom 14 (sos) }
  op(op(op(X, W), K(Y, Z)), 1)
= { by lemma 25 }
  op(op(op(X, W), K(Y, Z)), zero)
= { by axiom 1 (sos) }
  op(op(X, W), K(Y, Z))
= { by lemma 29 R->L }
  op(K(Y, Z), op(X, W))

Lemma 31: op(K(X, Y), op(Z, W)) = op(Z, op(W, K(X, Y))).
Proof:
  op(K(X, Y), op(Z, W))
= { by lemma 30 R->L }
  op(op(Z, K(X, Y)), W)
= { by axiom 21 (sos) }
  op(op(Z, op(K(X, Y), W)), a(Z, K(X, Y), W)) (peak)
= { by lemma 29 }
  op(op(Z, op(W, K(X, Y))), a(Z, K(X, Y), W)) (peak)
= { by axiom 13 (sos) }
  op(op(Z, op(W, K(X, Y))), 1)
= { by lemma 25 }
  op(op(Z, op(W, K(X, Y))), zero)
= { by axiom 1 (sos) }
  op(Z, op(W, K(X, Y)))

Lemma 32: op(K(X, Y), op(Y, X)) = op(X, Y).
Proof:
  op(K(X, Y), op(Y, X))
= { by axiom 18 (sos) }
  op(op(op(Y, X), K(X, Y)), K(K(X, Y), op(Y, X))) (peak)
= { by axiom 18 (sos) R->L }
  op(op(X, Y), K(K(X, Y), op(Y, X)))
= { by axiom 7 (sos) }
  op(op(X, Y), 1)
= { by lemma 25 }
  op(op(X, Y), zero)
= { by axiom 1 (sos) }
  op(X, Y)

Lemma 33: op(X, op(Y, K(Y, X))) = op(Y, X).
Proof:
  op(X, op(Y, K(Y, X)))
= { by lemma 31 R->L }
  op(K(Y, X), op(X, Y)) (peak)
= { by lemma 32 }
  op(Y, X)

Lemma 34: op(X, K(X, Y)) = T(X, Y).
Proof:
  op(X, K(X, Y))
= { by axiom 4 (sos) R->L }
  ldiv(Y, op(Y, op(X, K(X, Y)))) (peak)
= { by lemma 33 }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 35: op(op(X, K(Y, X)), Y) = op(Y, X).
Proof:
  op(op(X, K(Y, X)), Y)
= { by lemma 29 R->L }
  op(op(K(Y, X), X), Y)
= { by axiom 21 (sos) }
  op(op(K(Y, X), op(X, Y)), a(K(Y, X), X, Y)) (peak)
= { by lemma 32 }
  op(op(Y, X), a(K(Y, X), X, Y))
= { by axiom 14 (sos) }
  op(op(Y, X), 1)
= { by lemma 25 }
  op(op(Y, X), zero)
= { by axiom 1 (sos) }
  op(Y, X)

Lemma 36: op(X, K(Y, X)) = rdiv(op(Y, X), Y).
Proof:
  op(X, K(Y, X))
= { by axiom 3 (sos) R->L }
  rdiv(op(op(X, K(Y, X)), Y), Y) (peak)
= { by lemma 35 }
  rdiv(op(Y, X), Y)

Lemma 37: rdiv(op(X, Z), op(Y, Z)) = R(rdiv(X, Y), Y, Z).
Proof:
  rdiv(op(X, Z), op(Y, Z))
= { by axiom 9 (sos) R->L }
  rdiv(op(op(rdiv(X, Y), Y), Z), op(Y, Z)) (peak)
= { by axiom 19 (sos) R->L }
  R(rdiv(X, Y), Y, Z)

Lemma 38: R(rdiv(zero, X), X, Y) = rdiv(Y, op(X, Y)).
Proof:
  R(rdiv(zero, X), X, Y) (peak)
= { by lemma 37 R->L }
  rdiv(op(zero, Y), op(X, Y)) (peak)
= { by axiom 2 (sos) }
  rdiv(Y, op(X, Y))

Lemma 39: ldiv(rdiv(X, Y), X) = Y.
Proof:
  ldiv(rdiv(X, Y), X)
= { by axiom 9 (sos) R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), Y)) (peak)
= { by axiom 4 (sos) }
  Y

Lemma 40: ldiv(R(rdiv(zero, X), X, Y), Y) = op(X, Y).
Proof:
  ldiv(R(rdiv(zero, X), X, Y), Y) (peak)
= { by lemma 38 }
  ldiv(rdiv(Y, op(X, Y)), Y) (peak)
= { by lemma 39 }
  op(X, Y)

Lemma 41: op(X, K(Y, rdiv(X, Y))) = op(Y, rdiv(X, Y)).
Proof:
  op(X, K(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  op(op(rdiv(X, Y), Y), K(Y, rdiv(X, Y))) (peak)
= { by axiom 18 (sos) R->L }
