Lemma 48: R(X, K(Y, Z), rdiv(W, K(Y, Z))) = X.
Proof:
  R(X, K(Y, Z), rdiv(W, K(Y, Z)))
= { by lemma 45 R->L }
  R(X, K(Y, Z), ldiv(K(Y, Z), W))
= { by lemma 46 R->L }
  rdiv(op(op(X, K(Y, Z)), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 29 R->L }
  rdiv(op(op(K(Y, Z), X), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 47 }
  rdiv(op(X, op(ldiv(K(Y, Z), W), K(Y, Z))), W)
= { by lemma 45 }
  rdiv(op(X, op(rdiv(W, K(Y, Z)), K(Y, Z))), W)
= { by axiom 9 (sos) }
  rdiv(op(X, W), W)
= { by axiom 3 (sos) }
  X

Lemma 49: rdiv(rdiv(X, K(Y, Z)), X) = rdiv(zero, K(Y, Z)).
Proof:
  rdiv(rdiv(X, K(Y, Z)), X)
= { by lemma 42 R->L }
  rdiv(rdiv(X, K(Y, Z)), op(K(Y, Z), rdiv(X, K(Y, Z)))) (peak)
= { by lemma 38 R->L }
  R(rdiv(zero, K(Y, Z)), K(Y, Z), rdiv(X, K(Y, Z)))
= { by lemma 48 }
  rdiv(zero, K(Y, Z))

Lemma 50: rdiv(op(X, Y), op(Y, X)) = K(X, Y).
Proof:
  rdiv(op(X, Y), op(Y, X))
= { by lemma 32 R->L }
  rdiv(op(K(X, Y), op(Y, X)), op(Y, X)) (peak)
