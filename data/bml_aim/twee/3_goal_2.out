Lemma 45: ldiv(K(X, Y), Z) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(K(X, Y), Z)
= { by lemma 43 R->L }
  T(rdiv(Z, K(X, Y)), K(X, Y)) (peak)
= { by lemma 44 }
  rdiv(Z, K(X, Y))

Lemma 46: rdiv(op(op(X, Y), ldiv(Y, Z)), Z) = R(X, Y, ldiv(Y, Z)).
Proof:
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z)
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, Y), ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 19 (sos) R->L }
  R(X, Y, ldiv(Y, Z))

Lemma 47: op(op(K(X, Y), Z), W) = op(Z, op(W, K(X, Y))).
Proof:
  op(op(K(X, Y), Z), W) (peak)
= { by lemma 29 }
  op(op(Z, K(X, Y)), W) (peak)
= { by lemma 30 }
