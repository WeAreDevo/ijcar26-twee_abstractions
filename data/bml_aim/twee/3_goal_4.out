The conjecture is true! Here is a proof.

Axiom 1 (sos): op(X, zero) = X.
Axiom 2 (sos): op(zero, X) = X.
Axiom 3 (sos): rdiv(op(X, Y), Y) = X.
Axiom 4 (sos): ldiv(X, op(X, Y)) = Y.
Axiom 5 (sos): T(X, Y) = ldiv(Y, op(X, Y)).
Axiom 6 (sos): K(X, K(Y, Z)) = 1.
Axiom 7 (sos): K(K(X, Y), Z) = 1.
Axiom 8 (sos): op(X, ldiv(X, Y)) = Y.
Axiom 9 (sos): op(rdiv(X, Y), Y) = X.
Axiom 10 (sos): K(X, a(Y, Z, W)) = 1.
Axiom 11 (sos): K(a(X, Y, Z), W) = 1.
Axiom 12 (sos): a(X, K(Y, Z), W) = 1.
Axiom 13 (sos): a(K(X, Y), Z, W) = 1.
Axiom 14 (sos): a(X, Y, a(Z, W, V)) = 1.
Axiom 15 (sos): a(X, a(Y, Z, W), V) = 1.
Axiom 16 (sos): a(a(X, Y, Z), W, V) = 1.
Axiom 17 (sos): op(X, Y) = op(op(Y, X), K(X, Y)).
Axiom 18 (sos): R(X, Y, Z) = rdiv(op(op(X, Y), Z), op(Y, Z)).
Axiom 19 (sos): L(X, Y, Z) = ldiv(op(Z, Y), op(Z, op(Y, X))).
Axiom 20 (sos): op(op(X, Y), Z) = op(op(X, op(Y, Z)), a(X, Y, Z)).

Lemma 21: op(X, K(zero, X)) = X.
Proof:
  op(X, K(zero, X))
= { by axiom 1 (sos) R->L }
  op(op(X, zero), K(zero, X)) (peak)
= { by axiom 17 (sos) R->L }
  op(zero, X)
= { by axiom 2 (sos) }
  X

Lemma 22: ldiv(X, X) = zero.
Proof:
  ldiv(X, X)
= { by axiom 1 (sos) R->L }
  ldiv(X, op(X, zero)) (peak)
= { by axiom 4 (sos) }
  zero

Lemma 23: K(zero, X) = zero.
Proof:
  K(zero, X)
= { by axiom 4 (sos) R->L }
  ldiv(X, op(X, K(zero, X))) (peak)
= { by lemma 21 }
  ldiv(X, X)
= { by lemma 22 }
  zero

Lemma 24: 1 = zero.
Proof:
  1
= { by axiom 6 (sos) R->L }
  K(zero, K(X, Y)) (peak)
= { by lemma 23 }
  zero

Lemma 25: ldiv(zero, X) = X.
Proof:
  ldiv(zero, X)
= { by axiom 2 (sos) R->L }
  ldiv(zero, op(zero, X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 26: rdiv(X, X) = zero.
Proof:
  rdiv(X, X)
= { by axiom 2 (sos) R->L }
  rdiv(op(zero, X), X) (peak)
= { by axiom 3 (sos) }
  zero

Lemma 27: rdiv(X, zero) = X.
Proof:
  rdiv(X, zero)
= { by axiom 1 (sos) R->L }
  rdiv(op(X, zero), zero) (peak)
= { by axiom 3 (sos) }
  X

Lemma 28: T(X, X) = X.
Proof:
  T(X, X)
= { by axiom 5 (sos) }
  ldiv(X, op(X, X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 29: T(X, zero) = X.
Proof:
  T(X, zero)
= { by axiom 5 (sos) }
  ldiv(zero, op(X, zero)) (peak)
= { by axiom 1 (sos) }
  ldiv(zero, X)
= { by lemma 25 }
  X

Lemma 30: L(X, Y, zero) = X.
Proof:
  L(X, Y, zero)
= { by axiom 19 (sos) }
  ldiv(op(zero, Y), op(zero, op(Y, X))) (peak)
= { by axiom 2 (sos) }
  ldiv(Y, op(zero, op(Y, X)))
= { by axiom 2 (sos) }
  ldiv(Y, op(Y, X))
= { by axiom 4 (sos) }
  X

Lemma 31: L(X, zero, Y) = X.
Proof:
  L(X, zero, Y)
= { by axiom 19 (sos) }
  ldiv(op(Y, zero), op(Y, op(zero, X))) (peak)
= { by axiom 1 (sos) }
  ldiv(Y, op(Y, op(zero, X)))
= { by axiom 4 (sos) }
  op(zero, X)
= { by axiom 2 (sos) }
  X

Lemma 32: ldiv(rdiv(X, Y), X) = Y.
Proof:
  ldiv(rdiv(X, Y), X)
= { by axiom 9 (sos) R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), Y)) (peak)
= { by axiom 4 (sos) }
  Y

Lemma 33: op(X, K(ldiv(Y, X), Y)) = op(ldiv(Y, X), Y).
Proof:
  op(X, K(ldiv(Y, X), Y))
= { by axiom 8 (sos) R->L }
  op(op(Y, ldiv(Y, X)), K(ldiv(Y, X), Y)) (peak)
= { by axiom 17 (sos) R->L }
  op(ldiv(Y, X), Y)

Lemma 34: op(ldiv(X, zero), X) = K(ldiv(X, zero), X).
Proof:
  op(ldiv(X, zero), X)
= { by lemma 33 R->L }
  op(zero, K(ldiv(X, zero), X)) (peak)
= { by axiom 2 (sos) }
  K(ldiv(X, zero), X)

Lemma 35: op(X, rdiv(zero, X)) = K(X, rdiv(zero, X)).
Proof:
  op(X, rdiv(zero, X))
= { by lemma 32 R->L }
  op(ldiv(rdiv(zero, X), zero), rdiv(zero, X)) (peak)
= { by lemma 34 }
  K(ldiv(rdiv(zero, X), zero), rdiv(zero, X))
= { by lemma 32 }
  K(X, rdiv(zero, X))

Lemma 36: rdiv(op(X, Y), K(X, Y)) = op(Y, X).
Proof:
  rdiv(op(X, Y), K(X, Y))
= { by axiom 17 (sos) }
  rdiv(op(op(Y, X), K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  op(Y, X)

Lemma 37: op(K(X, Y), Z) = op(Z, K(X, Y)).
Proof:
  op(K(X, Y), Z)
= { by lemma 36 R->L }
  rdiv(op(Z, K(X, Y)), K(Z, K(X, Y))) (peak)
= { by axiom 6 (sos) }
  rdiv(op(Z, K(X, Y)), 1)
= { by lemma 24 }
  rdiv(op(Z, K(X, Y)), zero)
= { by lemma 27 }
  op(Z, K(X, Y))

Lemma 38: op(op(X, K(Y, Z)), W) = op(K(Y, Z), op(X, W)).
Proof:
  op(op(X, K(Y, Z)), W) (peak)
= { by lemma 37 R->L }
  op(op(K(Y, Z), X), W)
= { by axiom 20 (sos) }
  op(op(K(Y, Z), op(X, W)), a(K(Y, Z), X, W)) (peak)
= { by lemma 37 }
  op(op(op(X, W), K(Y, Z)), a(K(Y, Z), X, W)) (peak)
= { by axiom 13 (sos) }
  op(op(op(X, W), K(Y, Z)), 1)
= { by lemma 24 }
  op(op(op(X, W), K(Y, Z)), zero)
= { by axiom 1 (sos) }
  op(op(X, W), K(Y, Z))
= { by lemma 37 R->L }
  op(K(Y, Z), op(X, W))

Lemma 39: op(K(X, Y), op(Z, W)) = op(Z, op(W, K(X, Y))).
Proof:
  op(K(X, Y), op(Z, W))
= { by lemma 38 R->L }
  op(op(Z, K(X, Y)), W)
= { by axiom 20 (sos) }
  op(op(Z, op(K(X, Y), W)), a(Z, K(X, Y), W)) (peak)
= { by lemma 37 }
  op(op(Z, op(W, K(X, Y))), a(Z, K(X, Y), W)) (peak)
= { by axiom 12 (sos) }
  op(op(Z, op(W, K(X, Y))), 1)
= { by lemma 24 }
  op(op(Z, op(W, K(X, Y))), zero)
= { by axiom 1 (sos) }
  op(Z, op(W, K(X, Y)))

Lemma 40: op(K(X, Y), op(Y, X)) = op(X, Y).
Proof:
  op(K(X, Y), op(Y, X))
= { by axiom 17 (sos) }
  op(op(op(Y, X), K(X, Y)), K(K(X, Y), op(Y, X))) (peak)
= { by axiom 17 (sos) R->L }
  op(op(X, Y), K(K(X, Y), op(Y, X)))
= { by axiom 7 (sos) }
  op(op(X, Y), 1)
= { by lemma 24 }
  op(op(X, Y), zero)
= { by axiom 1 (sos) }
  op(X, Y)

Lemma 41: op(X, op(Y, K(Y, X))) = op(Y, X).
Proof:
  op(X, op(Y, K(Y, X)))
= { by lemma 39 R->L }
  op(K(Y, X), op(X, Y)) (peak)
= { by lemma 40 }
  op(Y, X)

Lemma 42: op(X, K(X, Y)) = T(X, Y).
Proof:
  op(X, K(X, Y))
= { by axiom 4 (sos) R->L }
  ldiv(Y, op(Y, op(X, K(X, Y)))) (peak)
= { by lemma 41 }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 43: op(op(X, K(Y, X)), Y) = op(Y, X).
Proof:
  op(op(X, K(Y, X)), Y)
= { by lemma 37 R->L }
  op(op(K(Y, X), X), Y)
= { by axiom 20 (sos) }
  op(op(K(Y, X), op(X, Y)), a(K(Y, X), X, Y)) (peak)
= { by lemma 40 }
  op(op(Y, X), a(K(Y, X), X, Y))
= { by axiom 13 (sos) }
  op(op(Y, X), 1)
= { by lemma 24 }
  op(op(Y, X), zero)
= { by axiom 1 (sos) }
  op(Y, X)

Lemma 44: op(X, K(Y, X)) = rdiv(op(Y, X), Y).
Proof:
  op(X, K(Y, X))
= { by axiom 3 (sos) R->L }
  rdiv(op(op(X, K(Y, X)), Y), Y) (peak)
= { by lemma 43 }
  rdiv(op(Y, X), Y)

Lemma 45: rdiv(op(X, Z), op(Y, Z)) = R(rdiv(X, Y), Y, Z).
Proof:
  rdiv(op(X, Z), op(Y, Z))
= { by axiom 9 (sos) R->L }
  rdiv(op(op(rdiv(X, Y), Y), Z), op(Y, Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(rdiv(X, Y), Y, Z)

Lemma 46: R(rdiv(zero, X), X, Y) = rdiv(Y, op(X, Y)).
Proof:
  R(rdiv(zero, X), X, Y) (peak)
= { by lemma 45 R->L }
  rdiv(op(zero, Y), op(X, Y)) (peak)
= { by axiom 2 (sos) }
  rdiv(Y, op(X, Y))

Lemma 47: ldiv(R(rdiv(zero, X), X, Y), Y) = op(X, Y).
Proof:
  ldiv(R(rdiv(zero, X), X, Y), Y) (peak)
= { by lemma 46 }
  ldiv(rdiv(Y, op(X, Y)), Y) (peak)
= { by lemma 32 }
  op(X, Y)

Lemma 48: op(X, K(Y, rdiv(X, Y))) = op(Y, rdiv(X, Y)).
Proof:
  op(X, K(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  op(op(rdiv(X, Y), Y), K(Y, rdiv(X, Y))) (peak)
= { by axiom 17 (sos) R->L }
  op(Y, rdiv(X, Y))

Lemma 49: op(K(X, Y), rdiv(Z, K(X, Y))) = Z.
Proof:
  op(K(X, Y), rdiv(Z, K(X, Y)))
= { by lemma 48 R->L }
  op(Z, K(K(X, Y), rdiv(Z, K(X, Y)))) (peak)
= { by axiom 7 (sos) }
  op(Z, 1)
= { by lemma 24 }
  op(Z, zero)
= { by axiom 1 (sos) }
  Z

Lemma 50: T(rdiv(X, Y), Y) = ldiv(Y, X).
Proof:
  T(rdiv(X, Y), Y)
= { by axiom 5 (sos) }
  ldiv(Y, op(rdiv(X, Y), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(Y, X)

Lemma 51: T(X, K(Y, Z)) = X.
Proof:
  T(X, K(Y, Z))
= { by axiom 5 (sos) }
  ldiv(K(Y, Z), op(X, K(Y, Z))) (peak)
= { by lemma 37 R->L }
  ldiv(K(Y, Z), op(K(Y, Z), X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 52: ldiv(K(X, Y), Z) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(K(X, Y), Z)
= { by lemma 50 R->L }
  T(rdiv(Z, K(X, Y)), K(X, Y)) (peak)
= { by lemma 51 }
  rdiv(Z, K(X, Y))

Lemma 53: rdiv(op(op(X, Y), ldiv(Y, Z)), Z) = R(X, Y, ldiv(Y, Z)).
Proof:
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z)
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, Y), ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 18 (sos) R->L }
  R(X, Y, ldiv(Y, Z))

Lemma 54: op(op(K(X, Y), Z), W) = op(Z, op(W, K(X, Y))).
Proof:
  op(op(K(X, Y), Z), W) (peak)
= { by lemma 37 }
  op(op(Z, K(X, Y)), W) (peak)
= { by lemma 38 }
  op(K(X, Y), op(Z, W))
= { by lemma 39 }
  op(Z, op(W, K(X, Y)))

Lemma 55: R(X, K(Y, Z), rdiv(W, K(Y, Z))) = X.
Proof:
  R(X, K(Y, Z), rdiv(W, K(Y, Z)))
= { by lemma 52 R->L }
  R(X, K(Y, Z), ldiv(K(Y, Z), W))
= { by lemma 53 R->L }
  rdiv(op(op(X, K(Y, Z)), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 37 R->L }
  rdiv(op(op(K(Y, Z), X), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 54 }
  rdiv(op(X, op(ldiv(K(Y, Z), W), K(Y, Z))), W)
= { by lemma 52 }
  rdiv(op(X, op(rdiv(W, K(Y, Z)), K(Y, Z))), W)
= { by axiom 9 (sos) }
  rdiv(op(X, W), W)
= { by axiom 3 (sos) }
  X

Lemma 56: rdiv(rdiv(X, K(Y, Z)), X) = rdiv(zero, K(Y, Z)).
Proof:
  rdiv(rdiv(X, K(Y, Z)), X)
= { by lemma 49 R->L }
  rdiv(rdiv(X, K(Y, Z)), op(K(Y, Z), rdiv(X, K(Y, Z)))) (peak)
= { by lemma 46 R->L }
  R(rdiv(zero, K(Y, Z)), K(Y, Z), rdiv(X, K(Y, Z)))
= { by lemma 55 }
  rdiv(zero, K(Y, Z))

Lemma 57: rdiv(op(X, Y), op(Y, X)) = K(X, Y).
Proof:
  rdiv(op(X, Y), op(Y, X))
= { by lemma 40 R->L }
  rdiv(op(K(X, Y), op(Y, X)), op(Y, X)) (peak)
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 58: rdiv(zero, K(X, Y)) = K(Y, X).
Proof:
  rdiv(zero, K(X, Y))
= { by lemma 56 R->L }
  rdiv(rdiv(op(X, Y), K(X, Y)), op(X, Y)) (peak)
= { by lemma 36 }
  rdiv(op(Y, X), op(X, Y))
= { by lemma 57 }
  K(Y, X)

Lemma 59: rdiv(op(X, K(Y, Z)), X) = K(Y, Z).
Proof:
  rdiv(op(X, K(Y, Z)), X) (peak)
= { by lemma 37 R->L }
  rdiv(op(K(Y, Z), X), X) (peak)
= { by axiom 3 (sos) }
  K(Y, Z)

Lemma 60: R(rdiv(X, Y), Y, ldiv(Y, Z)) = rdiv(op(X, ldiv(Y, Z)), Z).
Proof:
  R(rdiv(X, Y), Y, ldiv(Y, Z))
= { by lemma 45 R->L }
  rdiv(op(X, ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 8 (sos) }
  rdiv(op(X, ldiv(Y, Z)), Z)

Lemma 61: R(K(X, Y), Z, ldiv(Z, W)) = K(X, Y).
Proof:
  R(K(X, Y), Z, ldiv(Z, W))
= { by lemma 59 R->L }
  R(rdiv(op(Z, K(X, Y)), Z), Z, ldiv(Z, W)) (peak)
= { by lemma 60 }
  rdiv(op(op(Z, K(X, Y)), ldiv(Z, W)), W) (peak)
= { by lemma 38 }
  rdiv(op(K(X, Y), op(Z, ldiv(Z, W))), W)
= { by axiom 8 (sos) }
  rdiv(op(K(X, Y), W), W)
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 62: R(K(X, Y), Z, W) = K(X, Y).
Proof:
  R(K(X, Y), Z, W)
= { by axiom 4 (sos) R->L }
  R(K(X, Y), Z, ldiv(Z, op(Z, W))) (peak)
= { by lemma 61 }
  K(X, Y)

Lemma 63: op(K(X, Y), Z) = rdiv(Z, K(Y, X)).
Proof:
  op(K(X, Y), Z)
= { by lemma 47 R->L }
  ldiv(R(rdiv(zero, K(X, Y)), K(X, Y), Z), Z) (peak)
= { by lemma 58 }
  ldiv(R(K(Y, X), K(X, Y), Z), Z)
= { by lemma 62 }
  ldiv(K(Y, X), Z)
= { by lemma 52 }
  rdiv(Z, K(Y, X))

Lemma 64: op(X, K(Y, Z)) = rdiv(X, K(Z, Y)).
Proof:
  op(X, K(Y, Z))
= { by axiom 17 (sos) }
  op(op(K(Y, Z), X), K(X, K(Y, Z))) (peak)
= { by lemma 63 }
  op(rdiv(X, K(Z, Y)), K(X, K(Y, Z)))
= { by axiom 6 (sos) }
  op(rdiv(X, K(Z, Y)), 1)
= { by lemma 24 }
  op(rdiv(X, K(Z, Y)), zero)
= { by axiom 1 (sos) }
  rdiv(X, K(Z, Y))

Lemma 65: op(X, T(Y, X)) = op(Y, X).
Proof:
  op(X, T(Y, X))
= { by axiom 5 (sos) }
  op(X, ldiv(X, op(Y, X))) (peak)
= { by axiom 8 (sos) }
  op(Y, X)

Lemma 66: ldiv(op(X, Y), op(Y, X)) = K(Y, X).
Proof:
  ldiv(op(X, Y), op(Y, X))
= { by axiom 17 (sos) }
  ldiv(op(X, Y), op(op(X, Y), K(Y, X))) (peak)
= { by axiom 4 (sos) }
  K(Y, X)

Lemma 67: K(X, rdiv(op(X, Y), X)) = L(K(X, Y), Y, X).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 44 R->L }
  K(X, op(Y, K(X, Y)))
= { by lemma 66 R->L }
  ldiv(op(op(Y, K(X, Y)), X), op(X, op(Y, K(X, Y)))) (peak)
= { by lemma 43 }
  ldiv(op(X, Y), op(X, op(Y, K(X, Y))))
= { by axiom 19 (sos) R->L }
  L(K(X, Y), Y, X)

Lemma 68: T(K(X, Y), Z) = K(X, Y).
Proof:
  T(K(X, Y), Z)
= { by axiom 5 (sos) }
  ldiv(Z, op(K(X, Y), Z)) (peak)
= { by lemma 37 }
  ldiv(Z, op(Z, K(X, Y))) (peak)
= { by axiom 4 (sos) }
  K(X, Y)

Lemma 69: L(K(X, Y), Z, W) = K(X, Y).
Proof:
  L(K(X, Y), Z, W)
= { by axiom 19 (sos) }
  ldiv(op(W, Z), op(W, op(Z, K(X, Y)))) (peak)
= { by lemma 39 R->L }
  ldiv(op(W, Z), op(K(X, Y), op(W, Z))) (peak)
= { by axiom 5 (sos) R->L }
  T(K(X, Y), op(W, Z))
= { by lemma 68 }
  K(X, Y)

Lemma 70: K(X, rdiv(op(X, Y), X)) = K(X, Y).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 67 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 69 }
  K(X, Y)

Lemma 71: K(X, T(Y, X)) = K(X, Y).
Proof:
  K(X, T(Y, X))
= { by lemma 70 R->L }
  K(X, rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 65 }
  K(X, rdiv(op(Y, X), X))
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 72: ldiv(X, rdiv(op(Y, X), Y)) = K(Y, X).
Proof:
  ldiv(X, rdiv(op(Y, X), Y)) (peak)
= { by lemma 44 R->L }
  ldiv(X, op(X, K(Y, X))) (peak)
= { by axiom 4 (sos) }
  K(Y, X)

Lemma 73: K(X, T(Y, X)) = ldiv(T(Y, X), Y).
Proof:
  K(X, T(Y, X))
= { by lemma 72 R->L }
  ldiv(T(Y, X), rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 65 }
  ldiv(T(Y, X), rdiv(op(Y, X), X))
= { by axiom 3 (sos) }
  ldiv(T(Y, X), Y)

Lemma 74: ldiv(op(Z, X), op(Z, Y)) = L(ldiv(X, Y), X, Z).
Proof:
  ldiv(op(Z, X), op(Z, Y))
= { by axiom 8 (sos) R->L }
  ldiv(op(Z, X), op(Z, op(X, ldiv(X, Y)))) (peak)
= { by axiom 19 (sos) R->L }
  L(ldiv(X, Y), X, Z)

Lemma 75: ldiv(op(X, Y), op(X, op(Z, Y))) = L(T(Z, Y), Y, X).
Proof:
  ldiv(op(X, Y), op(X, op(Z, Y))) (peak)
= { by lemma 74 }
  L(ldiv(Y, op(Z, Y)), Y, X) (peak)
= { by axiom 5 (sos) R->L }
  L(T(Z, Y), Y, X)

Lemma 76: op(op(X, Y), K(Z, W)) = op(X, op(Y, K(Z, W))).
Proof:
  op(op(X, Y), K(Z, W)) (peak)
= { by lemma 37 R->L }
  op(K(Z, W), op(X, Y)) (peak)
= { by lemma 39 }
  op(X, op(Y, K(Z, W))) (peak)

Lemma 77: L(T(X, Y), Y, K(Z, W)) = T(X, rdiv(Y, K(W, Z))).
Proof:
  L(T(X, Y), Y, K(Z, W))
= { by lemma 75 R->L }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(X, Y))) (peak)
= { by lemma 37 }
  ldiv(op(K(Z, W), Y), op(op(X, Y), K(Z, W))) (peak)
= { by lemma 63 }
  ldiv(rdiv(Y, K(W, Z)), op(op(X, Y), K(Z, W)))
= { by lemma 76 }
  ldiv(rdiv(Y, K(W, Z)), op(X, op(Y, K(Z, W))))
= { by lemma 64 }
  ldiv(rdiv(Y, K(W, Z)), op(X, rdiv(Y, K(W, Z))))
= { by axiom 5 (sos) R->L }
  T(X, rdiv(Y, K(W, Z)))

Lemma 78: R(X, K(Y, Z), W) = X.
Proof:
  R(X, K(Y, Z), W)
= { by axiom 3 (sos) R->L }
  R(X, K(Y, Z), rdiv(op(W, K(Y, Z)), K(Y, Z))) (peak)
= { by lemma 55 }
  X

Lemma 79: ldiv(R(X, Y, Z), op(op(X, Y), Z)) = op(Y, Z).
Proof:
  ldiv(R(X, Y, Z), op(op(X, Y), Z))
= { by axiom 18 (sos) }
  ldiv(rdiv(op(op(X, Y), Z), op(Y, Z)), op(op(X, Y), Z)) (peak)
= { by lemma 32 }
  op(Y, Z)

Lemma 80: ldiv(op(X, Y), op(op(Y, X), Z)) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(op(X, Y), op(op(Y, X), Z))
= { by lemma 78 R->L }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(Y, X), Z))
= { by axiom 17 (sos) }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(op(X, Y), K(Y, X)), Z)) (peak)
= { by lemma 79 }
  op(K(Y, X), Z)
= { by lemma 63 }
  rdiv(Z, K(X, Y))

Lemma 81: L(X, Y, K(Z, W)) = X.
Proof:
  L(X, Y, K(Z, W))
= { by axiom 19 (sos) }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(Y, X)))
= { by lemma 38 R->L }
  ldiv(op(K(Z, W), Y), op(op(Y, K(Z, W)), X)) (peak)
= { by lemma 80 }
  rdiv(X, K(K(Z, W), Y))
= { by axiom 7 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 82: T(X, rdiv(Y, K(Z, W))) = T(X, Y).
Proof:
  T(X, rdiv(Y, K(Z, W)))
= { by lemma 77 R->L }
  L(T(X, Y), Y, K(W, Z)) (peak)
= { by lemma 81 }
  T(X, Y)

Lemma 83: rdiv(T(X, Y), K(X, Y)) = X.
Proof:
  rdiv(T(X, Y), K(X, Y))
= { by lemma 42 R->L }
  rdiv(op(X, K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  X

Lemma 84: T(X, T(Y, Z)) = T(X, Y).
Proof:
  T(X, T(Y, Z))
= { by lemma 82 R->L }
  T(X, rdiv(T(Y, Z), K(Y, Z))) (peak)
= { by lemma 83 }
  T(X, Y)

Lemma 85: T(X, ldiv(Y, Z)) = T(X, rdiv(Z, Y)).
Proof:
  T(X, ldiv(Y, Z))
= { by lemma 50 R->L }
  T(X, T(rdiv(Z, Y), Y)) (peak)
= { by lemma 84 }
  T(X, rdiv(Z, Y))

Lemma 86: ldiv(T(X, Y), X) = K(Y, X).
Proof:
  ldiv(T(X, Y), X) (peak)
= { by lemma 73 R->L }
  K(Y, T(X, Y)) (peak)
= { by lemma 71 }
  K(Y, X)

Lemma 87: K(ldiv(X, Y), Z) = K(rdiv(Y, X), Z).
Proof:
  K(ldiv(X, Y), Z)
= { by lemma 71 R->L }
  K(ldiv(X, Y), T(Z, ldiv(X, Y))) (peak)
= { by lemma 73 }
  ldiv(T(Z, ldiv(X, Y)), Z) (peak)
= { by lemma 85 }
  ldiv(T(Z, rdiv(Y, X)), Z)
= { by lemma 86 }
  K(rdiv(Y, X), Z)

Lemma 88: op(ldiv(X, zero), X) = K(rdiv(zero, X), X).
Proof:
  op(ldiv(X, zero), X)
= { by lemma 33 R->L }
  op(zero, K(ldiv(X, zero), X)) (peak)
= { by axiom 2 (sos) }
  K(ldiv(X, zero), X)
= { by lemma 87 }
  K(rdiv(zero, X), X)

Lemma 89: op(K(X, Y), X) = T(X, Y).
Proof:
  op(K(X, Y), X)
= { by axiom 17 (sos) }
  op(op(X, K(X, Y)), K(K(X, Y), X)) (peak)
= { by lemma 42 }
  op(T(X, Y), K(K(X, Y), X))
= { by axiom 7 (sos) }
  op(T(X, Y), 1)
= { by lemma 24 }
  op(T(X, Y), zero)
= { by axiom 1 (sos) }
  T(X, Y)

Lemma 90: op(K(X, Y), Y) = rdiv(op(X, Y), X).
Proof:
  op(K(X, Y), Y)
= { by axiom 17 (sos) }
  op(op(Y, K(X, Y)), K(K(X, Y), Y)) (peak)
= { by lemma 44 }
  op(rdiv(op(X, Y), X), K(K(X, Y), Y)) (peak)
= { by axiom 7 (sos) }
  op(rdiv(op(X, Y), X), 1)
= { by lemma 24 }
  op(rdiv(op(X, Y), X), zero)
= { by axiom 1 (sos) }
  rdiv(op(X, Y), X)

Lemma 91: ldiv(X, T(X, Y)) = K(X, Y).
Proof:
  ldiv(X, T(X, Y))
= { by lemma 42 R->L }
  ldiv(X, op(X, K(X, Y))) (peak)
= { by axiom 4 (sos) }
  K(X, Y)

Lemma 92: ldiv(ldiv(X, Y), Y) = T(X, ldiv(X, Y)).
Proof:
  ldiv(ldiv(X, Y), Y)
= { by axiom 8 (sos) R->L }
  ldiv(ldiv(X, Y), op(X, ldiv(X, Y))) (peak)
= { by axiom 5 (sos) R->L }
  T(X, ldiv(X, Y))

Lemma 93: ldiv(ldiv(X, Y), Y) = T(X, rdiv(Y, X)).
Proof:
  ldiv(ldiv(X, Y), Y) (peak)
= { by lemma 92 }
  T(X, ldiv(X, Y)) (peak)
= { by lemma 85 }
  T(X, rdiv(Y, X))

Lemma 94: rdiv(X, ldiv(Y, X)) = Y.
Proof:
  rdiv(X, ldiv(Y, X))
= { by axiom 8 (sos) R->L }
  rdiv(op(Y, ldiv(Y, X)), ldiv(Y, X)) (peak)
= { by axiom 3 (sos) }
  Y

Lemma 95: rdiv(X, T(Y, ldiv(Y, X))) = ldiv(Y, X).
Proof:
  rdiv(X, T(Y, ldiv(Y, X))) (peak)
= { by lemma 92 R->L }
  rdiv(X, ldiv(ldiv(Y, X), X)) (peak)
= { by lemma 94 }
  ldiv(Y, X)

Lemma 96: ldiv(T(X, Y), X) = rdiv(X, T(X, Y)).
Proof:
  ldiv(T(X, Y), X)
= { by lemma 95 R->L }
  rdiv(X, T(T(X, Y), ldiv(T(X, Y), X))) (peak)
= { by lemma 73 R->L }
  rdiv(X, T(T(X, Y), K(Y, T(X, Y)))) (peak)
= { by lemma 51 }
  rdiv(X, T(X, Y))

Lemma 97: rdiv(X, K(Y, X)) = T(X, Y).
Proof:
  rdiv(X, K(Y, X))
= { by lemma 86 R->L }
  rdiv(X, ldiv(T(X, Y), X)) (peak)
= { by lemma 94 }
  T(X, Y)

Lemma 98: rdiv(op(X, Y), T(X, Y)) = Y.
Proof:
  rdiv(op(X, Y), T(X, Y))
= { by axiom 5 (sos) }
  rdiv(op(X, Y), ldiv(Y, op(X, Y))) (peak)
= { by lemma 94 }
  Y

Lemma 99: rdiv(rdiv(op(X, Y), X), Y) = K(X, Y).
Proof:
  rdiv(rdiv(op(X, Y), X), Y)
= { by lemma 51 R->L }
  rdiv(rdiv(op(X, Y), X), T(Y, K(X, Y))) (peak)
= { by lemma 44 R->L }
  rdiv(op(Y, K(X, Y)), T(Y, K(X, Y))) (peak)
= { by lemma 98 }
  K(X, Y)

Lemma 100: K(X, T(Y, X)) = rdiv(Y, T(Y, X)).
Proof:
  K(X, T(Y, X))
= { by lemma 99 R->L }
  rdiv(rdiv(op(X, T(Y, X)), X), T(Y, X)) (peak)
= { by lemma 65 }
  rdiv(rdiv(op(Y, X), X), T(Y, X))
= { by axiom 3 (sos) }
  rdiv(Y, T(Y, X))

Lemma 101: rdiv(X, T(X, Y)) = K(Y, X).
Proof:
  rdiv(X, T(X, Y)) (peak)
= { by lemma 100 R->L }
  K(Y, T(X, Y)) (peak)
= { by lemma 71 }
  K(Y, X)

Lemma 102: rdiv(op(X, Y), X) = rdiv(Y, K(Y, X)).
Proof:
  rdiv(op(X, Y), X) (peak)
= { by lemma 90 R->L }
  op(K(X, Y), Y) (peak)
= { by lemma 63 }
  rdiv(Y, K(Y, X))

Lemma 103: op(X, rdiv(Y, K(Y, X))) = op(T(X, Y), Y).
Proof:
  op(X, rdiv(Y, K(Y, X)))
= { by lemma 71 R->L }
  op(X, rdiv(Y, K(Y, T(X, Y))))
= { by lemma 64 R->L }
  op(X, op(Y, K(T(X, Y), Y)))
= { by lemma 76 R->L }
  op(op(X, Y), K(T(X, Y), Y))
= { by lemma 65 R->L }
  op(op(Y, T(X, Y)), K(T(X, Y), Y)) (peak)
= { by axiom 17 (sos) R->L }
  op(T(X, Y), Y)

Lemma 104: rdiv(op(op(X, rdiv(Y, Z)), Z), Y) = R(X, rdiv(Y, Z), Z).
Proof:
  rdiv(op(op(X, rdiv(Y, Z)), Z), Y)
= { by axiom 9 (sos) R->L }
  rdiv(op(op(X, rdiv(Y, Z)), Z), op(rdiv(Y, Z), Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(X, rdiv(Y, Z), Z)

Lemma 105: R(X, Y, K(Z, W)) = X.
Proof:
  R(X, Y, K(Z, W))
= { by axiom 18 (sos) }
  rdiv(op(op(X, Y), K(Z, W)), op(Y, K(Z, W))) (peak)
= { by lemma 76 }
  rdiv(op(X, op(Y, K(Z, W))), op(Y, K(Z, W)))
= { by axiom 3 (sos) }
  X

Lemma 106: rdiv(op(T(X, Y), T(Y, X)), Y) = X.
Proof:
  rdiv(op(T(X, Y), T(Y, X)), Y)
= { by lemma 42 R->L }
  rdiv(op(T(X, Y), op(Y, K(Y, X))), Y)
= { by lemma 76 R->L }
  rdiv(op(op(T(X, Y), Y), K(Y, X)), Y)
= { by lemma 103 R->L }
  rdiv(op(op(X, rdiv(Y, K(Y, X))), K(Y, X)), Y) (peak)
= { by lemma 104 }
  R(X, rdiv(Y, K(Y, X)), K(Y, X))
= { by lemma 105 }
  X

Lemma 107: op(T(X, Y), T(Y, X)) = op(X, Y).
Proof:
  op(T(X, Y), T(Y, X))
= { by axiom 9 (sos) R->L }
  op(rdiv(op(T(X, Y), T(Y, X)), Y), Y) (peak)
= { by lemma 106 }
  op(X, Y)

Lemma 108: K(X, rdiv(Y, K(Y, X))) = K(X, Y).
Proof:
  K(X, rdiv(Y, K(Y, X)))
= { by lemma 63 R->L }
  K(X, op(K(X, Y), Y)) (peak)
= { by lemma 90 }
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 67 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 69 }
  K(X, Y)

Lemma 109: op(rdiv(X, K(X, Y)), Y) = op(T(Y, X), T(X, Y)).
Proof:
  op(rdiv(X, K(X, Y)), Y)
= { by axiom 17 (sos) }
  op(op(Y, rdiv(X, K(X, Y))), K(rdiv(X, K(X, Y)), Y)) (peak)
= { by lemma 103 }
  op(op(T(Y, X), X), K(rdiv(X, K(X, Y)), Y))
= { by lemma 76 }
  op(T(Y, X), op(X, K(rdiv(X, K(X, Y)), Y)))
= { by lemma 64 }
  op(T(Y, X), rdiv(X, K(Y, rdiv(X, K(X, Y)))))
= { by lemma 108 }
  op(T(Y, X), rdiv(X, K(Y, X)))
= { by lemma 97 }
  op(T(Y, X), T(X, Y))

Lemma 110: op(X, rdiv(Y, K(Z, W))) = rdiv(op(X, Y), K(Z, W)).
Proof:
  op(X, rdiv(Y, K(Z, W)))
= { by lemma 64 R->L }
  op(X, op(Y, K(W, Z)))
= { by lemma 54 R->L }
  op(op(K(W, Z), X), Y)
= { by lemma 107 R->L }
  op(op(T(K(W, Z), X), T(X, K(W, Z))), Y)
= { by lemma 109 R->L }
  op(op(rdiv(X, K(X, K(W, Z))), K(W, Z)), Y) (peak)
= { by lemma 38 }
  op(K(W, Z), op(rdiv(X, K(X, K(W, Z))), Y))
= { by lemma 63 }
  rdiv(op(rdiv(X, K(X, K(W, Z))), Y), K(Z, W))
= { by axiom 6 (sos) }
  rdiv(op(rdiv(X, 1), Y), K(Z, W))
= { by lemma 24 }
  rdiv(op(rdiv(X, zero), Y), K(Z, W))
= { by lemma 27 }
  rdiv(op(X, Y), K(Z, W))

Lemma 111: rdiv(op(op(X, Y), Z), a(X, Y, Z)) = op(X, op(Y, Z)).
Proof:
  rdiv(op(op(X, Y), Z), a(X, Y, Z))
= { by axiom 20 (sos) }
  rdiv(op(op(X, op(Y, Z)), a(X, Y, Z)), a(X, Y, Z)) (peak)
= { by axiom 3 (sos) }
  op(X, op(Y, Z))

Lemma 112: rdiv(op(op(X, Y), Z), K(X, Y)) = op(op(Y, X), Z).
Proof:
  rdiv(op(op(X, Y), Z), K(X, Y))
= { by lemma 110 R->L }
  op(op(X, Y), rdiv(Z, K(X, Y)))
= { by lemma 63 R->L }
  op(op(X, Y), op(K(Y, X), Z))
= { by lemma 111 R->L }
  rdiv(op(op(op(X, Y), K(Y, X)), Z), a(op(X, Y), K(Y, X), Z)) (peak)
= { by axiom 17 (sos) R->L }
  rdiv(op(op(Y, X), Z), a(op(X, Y), K(Y, X), Z))
= { by axiom 12 (sos) }
  rdiv(op(op(Y, X), Z), 1)
= { by lemma 24 }
  rdiv(op(op(Y, X), Z), zero)
= { by lemma 27 }
  op(op(Y, X), Z)

Lemma 113: rdiv(op(X, op(Y, Z)), K(Y, Z)) = op(X, op(Z, Y)).
Proof:
  rdiv(op(X, op(Y, Z)), K(Y, Z))
= { by lemma 63 R->L }
  op(K(Z, Y), op(X, op(Y, Z)))
= { by lemma 38 R->L }
  op(op(X, K(Z, Y)), op(Y, Z))
= { by axiom 20 (sos) }
  op(op(X, op(K(Z, Y), op(Y, Z))), a(X, K(Z, Y), op(Y, Z))) (peak)
= { by lemma 40 }
  op(op(X, op(Z, Y)), a(X, K(Z, Y), op(Y, Z)))
= { by axiom 12 (sos) }
  op(op(X, op(Z, Y)), 1)
= { by lemma 24 }
  op(op(X, op(Z, Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(Z, Y))

Lemma 114: op(op(X, Y), T(Z, op(Y, X))) = op(Z, op(X, Y)).
Proof:
  op(op(X, Y), T(Z, op(Y, X)))
= { by lemma 112 R->L }
  rdiv(op(op(Y, X), T(Z, op(Y, X))), K(Y, X)) (peak)
= { by lemma 65 }
  rdiv(op(Z, op(Y, X)), K(Y, X))
= { by lemma 113 }
  op(Z, op(X, Y))

Lemma 115: T(X, op(Y, Z)) = T(X, op(Z, Y)).
Proof:
  T(X, op(Y, Z))
= { by axiom 4 (sos) R->L }
  ldiv(op(Z, Y), op(op(Z, Y), T(X, op(Y, Z)))) (peak)
= { by lemma 114 }
  ldiv(op(Z, Y), op(X, op(Z, Y)))
= { by axiom 5 (sos) R->L }
  T(X, op(Z, Y))

Lemma 116: K(X, op(Z, Y)) = K(X, op(Y, Z)).
Proof:
  K(X, op(Z, Y))
= { by lemma 91 R->L }
  ldiv(X, T(X, op(Z, Y))) (peak)
= { by lemma 115 R->L }
  ldiv(X, T(X, op(Y, Z))) (peak)
= { by lemma 91 }
  K(X, op(Y, Z))

Lemma 117: K(X, ldiv(X, Y)) = K(X, rdiv(Y, X)).
Proof:
  K(X, ldiv(X, Y))
= { by lemma 70 R->L }
  K(X, rdiv(op(X, ldiv(X, Y)), X)) (peak)
= { by axiom 8 (sos) }
  K(X, rdiv(Y, X))

Lemma 118: K(X, T(Y, Z)) = K(X, Y).
Proof:
  K(X, T(Y, Z))
= { by lemma 91 R->L }
  ldiv(X, T(X, T(Y, Z))) (peak)
= { by lemma 84 }
  ldiv(X, T(X, Y))
= { by lemma 91 }
  K(X, Y)

Lemma 119: K(X, ldiv(Y, Z)) = K(X, rdiv(Z, Y)).
Proof:
  K(X, ldiv(Y, Z))
= { by lemma 50 R->L }
  K(X, T(rdiv(Z, Y), Y)) (peak)
= { by lemma 118 }
  K(X, rdiv(Z, Y))

Lemma 120: K(op(Y, X), Z) = K(op(X, Y), Z).
Proof:
  K(op(Y, X), Z)
= { by lemma 86 R->L }
  ldiv(T(Z, op(Y, X)), Z) (peak)
= { by lemma 115 R->L }
  ldiv(T(Z, op(X, Y)), Z) (peak)
= { by lemma 73 R->L }
  K(op(X, Y), T(Z, op(X, Y))) (peak)
= { by lemma 71 }
  K(op(X, Y), Z)

Lemma 121: K(T(X, Y), Z) = K(X, Z).
Proof:
  K(T(X, Y), Z)
= { by lemma 71 R->L }
  K(T(X, Y), T(Z, T(X, Y))) (peak)
= { by lemma 73 }
  ldiv(T(Z, T(X, Y)), Z) (peak)
= { by lemma 84 }
  ldiv(T(Z, X), Z)
= { by lemma 86 }
  K(X, Z)

Lemma 122: op(a(X, Y, Z), W) = op(W, a(X, Y, Z)).
Proof:
  op(a(X, Y, Z), W)
= { by lemma 36 R->L }
  rdiv(op(W, a(X, Y, Z)), K(W, a(X, Y, Z))) (peak)
= { by axiom 10 (sos) }
  rdiv(op(W, a(X, Y, Z)), 1)
= { by lemma 24 }
  rdiv(op(W, a(X, Y, Z)), zero)
= { by lemma 27 }
  op(W, a(X, Y, Z))

Lemma 123: op(op(X, a(Y, Z, W)), V) = op(X, op(V, a(Y, Z, W))).
Proof:
  op(op(X, a(Y, Z, W)), V)
= { by axiom 20 (sos) }
  op(op(X, op(a(Y, Z, W), V)), a(X, a(Y, Z, W), V)) (peak)
= { by lemma 122 }
  op(op(X, op(V, a(Y, Z, W))), a(X, a(Y, Z, W), V)) (peak)
= { by axiom 15 (sos) }
  op(op(X, op(V, a(Y, Z, W))), 1)
= { by lemma 24 }
  op(op(X, op(V, a(Y, Z, W))), zero)
= { by axiom 1 (sos) }
  op(X, op(V, a(Y, Z, W)))

Lemma 124: rdiv(op(X, op(Y, a(Z, W, V))), Y) = op(X, a(Z, W, V)).
Proof:
  rdiv(op(X, op(Y, a(Z, W, V))), Y)
= { by lemma 123 R->L }
  rdiv(op(op(X, a(Z, W, V)), Y), Y) (peak)
= { by axiom 3 (sos) }
  op(X, a(Z, W, V))

Lemma 125: op(op(X, Y), a(Z, W, V)) = op(X, op(Y, a(Z, W, V))).
Proof:
  op(op(X, Y), a(Z, W, V))
= { by axiom 20 (sos) }
  op(op(X, op(Y, a(Z, W, V))), a(X, Y, a(Z, W, V))) (peak)
= { by lemma 122 R->L }
  op(op(X, op(a(Z, W, V), Y)), a(X, Y, a(Z, W, V))) (peak)
= { by axiom 14 (sos) }
  op(op(X, op(a(Z, W, V), Y)), 1)
= { by lemma 24 }
  op(op(X, op(a(Z, W, V), Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(a(Z, W, V), Y))
= { by lemma 122 }
  op(X, op(Y, a(Z, W, V)))

Lemma 126: op(X, op(Y, a(X, rdiv(Y, Z), Z))) = op(op(X, rdiv(Y, Z)), Z).
Proof:
  op(X, op(Y, a(X, rdiv(Y, Z), Z)))
= { by lemma 125 R->L }
  op(op(X, Y), a(X, rdiv(Y, Z), Z))
= { by axiom 9 (sos) R->L }
  op(op(X, op(rdiv(Y, Z), Z)), a(X, rdiv(Y, Z), Z)) (peak)
= { by axiom 20 (sos) R->L }
  op(op(X, rdiv(Y, Z)), Z)

Lemma 127: op(X, a(X, rdiv(Y, Z), Z)) = R(X, rdiv(Y, Z), Z).
Proof:
  op(X, a(X, rdiv(Y, Z), Z))
= { by lemma 124 R->L }
  rdiv(op(X, op(Y, a(X, rdiv(Y, Z), Z))), Y) (peak)
= { by lemma 126 }
  rdiv(op(op(X, rdiv(Y, Z)), Z), Y)
= { by lemma 104 }
  R(X, rdiv(Y, Z), Z)

Lemma 128: op(X, a(X, Y, Z)) = R(X, Y, Z).
Proof:
  op(X, a(X, Y, Z))
= { by axiom 3 (sos) R->L }
  op(X, a(X, rdiv(op(Y, Z), Z), Z)) (peak)
= { by lemma 127 }
  R(X, rdiv(op(Y, Z), Z), Z)
= { by axiom 3 (sos) }
  R(X, Y, Z)

Lemma 129: ldiv(X, R(X, Y, Z)) = a(X, Y, Z).
Proof:
  ldiv(X, R(X, Y, Z))
= { by lemma 128 R->L }
  ldiv(X, op(X, a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 130: rdiv(op(X, Y), T(Y, X)) = T(X, Y).
Proof:
  rdiv(op(X, Y), T(Y, X))
= { by lemma 107 R->L }
  rdiv(op(T(X, Y), T(Y, X)), T(Y, X)) (peak)
= { by axiom 3 (sos) }
  T(X, Y)

Lemma 131: rdiv(X, T(Y, rdiv(X, Y))) = ldiv(Y, X).
Proof:
  rdiv(X, T(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  rdiv(op(rdiv(X, Y), Y), T(Y, rdiv(X, Y))) (peak)
= { by lemma 130 }
  T(rdiv(X, Y), Y)
= { by lemma 50 }
  ldiv(Y, X)

Lemma 132: T(X, a(Y, Z, W)) = X.
Proof:
  T(X, a(Y, Z, W))
= { by axiom 5 (sos) }
  ldiv(a(Y, Z, W), op(X, a(Y, Z, W))) (peak)
= { by lemma 122 R->L }
  ldiv(a(Y, Z, W), op(a(Y, Z, W), X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 133: T(X, rdiv(R(Y, Z, W), Y)) = X.
Proof:
  T(X, rdiv(R(Y, Z, W), Y))
= { by lemma 85 R->L }
  T(X, ldiv(Y, R(Y, Z, W))) (peak)
= { by lemma 129 }
  T(X, a(Y, Z, W))
= { by lemma 132 }
  X

Lemma 134: ldiv(X, R(X, Y, Z)) = rdiv(R(X, Y, Z), X).
Proof:
  ldiv(X, R(X, Y, Z))
= { by lemma 131 R->L }
  rdiv(R(X, Y, Z), T(X, rdiv(R(X, Y, Z), X))) (peak)
= { by lemma 133 }
  rdiv(R(X, Y, Z), X)

Lemma 135: op(a(X, Y, Z), rdiv(W, a(X, Y, Z))) = W.
Proof:
  op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))
= { by lemma 48 R->L }
  op(W, K(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 11 (sos) }
  op(W, 1)
= { by lemma 24 }
  op(W, zero)
= { by axiom 1 (sos) }
  W

Lemma 136: ldiv(a(X, Y, Z), W) = rdiv(W, a(X, Y, Z)).
Proof:
  ldiv(a(X, Y, Z), W)
= { by lemma 135 R->L }
  ldiv(a(X, Y, Z), op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 4 (sos) }
  rdiv(W, a(X, Y, Z))

Lemma 137: L(ldiv(X, zero), X, Y) = ldiv(op(Y, X), Y).
Proof:
  L(ldiv(X, zero), X, Y) (peak)
= { by lemma 74 R->L }
  ldiv(op(Y, X), op(Y, zero)) (peak)
= { by axiom 1 (sos) }
  ldiv(op(Y, X), Y)

Lemma 138: op(op(X, a(Y, Z, W)), V) = op(op(X, V), a(Y, Z, W)).
Proof:
  op(op(X, a(Y, Z, W)), V) (peak)
= { by lemma 122 R->L }
  op(op(a(Y, Z, W), X), V)
= { by axiom 20 (sos) }
  op(op(a(Y, Z, W), op(X, V)), a(a(Y, Z, W), X, V)) (peak)
= { by lemma 122 }
  op(op(op(X, V), a(Y, Z, W)), a(a(Y, Z, W), X, V)) (peak)
= { by axiom 16 (sos) }
  op(op(op(X, V), a(Y, Z, W)), 1)
= { by lemma 24 }
  op(op(op(X, V), a(Y, Z, W)), zero)
= { by axiom 1 (sos) }
  op(op(X, V), a(Y, Z, W))

Lemma 139: op(op(a(X, Y, Z), W), V) = op(W, op(V, a(X, Y, Z))).
Proof:
  op(op(a(X, Y, Z), W), V) (peak)
= { by lemma 122 }
  op(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 138 }
  op(op(W, V), a(X, Y, Z)) (peak)
= { by lemma 125 }
  op(W, op(V, a(X, Y, Z)))

Lemma 140: L(X, a(Y, Z, W), V) = X.
Proof:
  L(X, a(Y, Z, W), V)
= { by lemma 132 R->L }
  L(T(X, a(Y, Z, W)), a(Y, Z, W), V)
= { by lemma 75 R->L }
  ldiv(op(V, a(Y, Z, W)), op(V, op(X, a(Y, Z, W))))
= { by lemma 139 R->L }
  ldiv(op(V, a(Y, Z, W)), op(op(a(Y, Z, W), V), X)) (peak)
= { by lemma 80 }
  rdiv(X, K(V, a(Y, Z, W)))
= { by axiom 10 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 141: ldiv(R(X, Y, Z), X) = rdiv(zero, a(X, Y, Z)).
Proof:
  ldiv(R(X, Y, Z), X)
= { by lemma 128 R->L }
  ldiv(op(X, a(X, Y, Z)), X)
= { by lemma 137 R->L }
  L(ldiv(a(X, Y, Z), zero), a(X, Y, Z), X) (peak)
= { by lemma 140 }
  ldiv(a(X, Y, Z), zero)
= { by lemma 136 }
  rdiv(zero, a(X, Y, Z))

Lemma 142: rdiv(zero, rdiv(R(X, Y, Z), X)) = ldiv(R(X, Y, Z), X).
Proof:
  rdiv(zero, rdiv(R(X, Y, Z), X))
= { by lemma 134 R->L }
  rdiv(zero, ldiv(X, R(X, Y, Z))) (peak)
= { by lemma 129 }
  rdiv(zero, a(X, Y, Z))
= { by lemma 141 R->L }
  ldiv(R(X, Y, Z), X)

Lemma 143: T(a(X, Y, Z), W) = a(X, Y, Z).
Proof:
  T(a(X, Y, Z), W)
= { by axiom 5 (sos) }
  ldiv(W, op(a(X, Y, Z), W)) (peak)
= { by lemma 122 }
  ldiv(W, op(W, a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 144: rdiv(op(X, Y), K(Z, X)) = op(T(X, Z), Y).
Proof:
  rdiv(op(X, Y), K(Z, X))
= { by lemma 63 R->L }
  op(K(X, Z), op(X, Y))
= { by lemma 38 R->L }
  op(op(X, K(X, Z)), Y) (peak)
= { by lemma 42 }
  op(T(X, Z), Y)

Lemma 145: R(rdiv(rdiv(X, Y), Z), Z, Y) = rdiv(X, op(Z, Y)).
Proof:
  R(rdiv(rdiv(X, Y), Z), Z, Y) (peak)
= { by lemma 45 R->L }
  rdiv(op(rdiv(X, Y), Y), op(Z, Y)) (peak)
= { by axiom 9 (sos) }
  rdiv(X, op(Z, Y))

Lemma 146: rdiv(rdiv(X, K(Y, Z)), W) = rdiv(X, rdiv(W, K(Z, Y))).
Proof:
  rdiv(rdiv(X, K(Y, Z)), W)
= { by lemma 105 R->L }
  R(rdiv(rdiv(X, K(Y, Z)), W), W, K(Y, Z)) (peak)
= { by lemma 145 }
  rdiv(X, op(W, K(Y, Z)))
= { by lemma 64 }
  rdiv(X, rdiv(W, K(Z, Y)))

Lemma 147: rdiv(X, op(T(Y, rdiv(zero, Y)), X)) = R(ldiv(Y, zero), Y, X).
Proof:
  rdiv(X, op(T(Y, rdiv(zero, Y)), X))
= { by lemma 144 R->L }
  rdiv(X, rdiv(op(Y, X), K(rdiv(zero, Y), Y)))
= { by lemma 146 R->L }
  rdiv(rdiv(X, K(Y, rdiv(zero, Y))), op(Y, X))
= { by lemma 63 R->L }
  rdiv(op(K(rdiv(zero, Y), Y), X), op(Y, X))
= { by lemma 88 R->L }
  rdiv(op(op(ldiv(Y, zero), Y), X), op(Y, X)) (peak)
= { by axiom 18 (sos) R->L }
  R(ldiv(Y, zero), Y, X)

Lemma 148: R(X, a(Y, Z, W), rdiv(V, a(Y, Z, W))) = X.
Proof:
  R(X, a(Y, Z, W), rdiv(V, a(Y, Z, W)))
= { by lemma 136 R->L }
  R(X, a(Y, Z, W), ldiv(a(Y, Z, W), V))
= { by lemma 53 R->L }
  rdiv(op(op(X, a(Y, Z, W)), ldiv(a(Y, Z, W), V)), V) (peak)
= { by lemma 123 }
  rdiv(op(X, op(ldiv(a(Y, Z, W), V), a(Y, Z, W))), V)
= { by lemma 136 }
  rdiv(op(X, op(rdiv(V, a(Y, Z, W)), a(Y, Z, W))), V)
= { by axiom 9 (sos) }
  rdiv(op(X, V), V)
= { by axiom 3 (sos) }
  X

Lemma 149: R(X, a(Y, Z, W), V) = X.
Proof:
  R(X, a(Y, Z, W), V)
= { by axiom 3 (sos) R->L }
  R(X, a(Y, Z, W), rdiv(op(V, a(Y, Z, W)), a(Y, Z, W))) (peak)
= { by lemma 148 }
  X

Lemma 150: rdiv(X, op(X, a(Y, Z, W))) = rdiv(zero, a(Y, Z, W)).
Proof:
  rdiv(X, op(X, a(Y, Z, W))) (peak)
= { by lemma 122 R->L }
  rdiv(X, op(a(Y, Z, W), X))
= { by lemma 143 R->L }
  rdiv(X, op(T(a(Y, Z, W), rdiv(zero, a(Y, Z, W))), X)) (peak)
= { by lemma 147 }
  R(ldiv(a(Y, Z, W), zero), a(Y, Z, W), X)
= { by lemma 149 }
  ldiv(a(Y, Z, W), zero)
= { by lemma 136 }
  rdiv(zero, a(Y, Z, W))

Lemma 151: rdiv(zero, a(X, Y, Z)) = rdiv(X, R(X, Y, Z)).
Proof:
  rdiv(zero, a(X, Y, Z))
= { by lemma 150 R->L }
  rdiv(X, op(X, a(X, Y, Z))) (peak)
= { by lemma 128 }
  rdiv(X, R(X, Y, Z))

Lemma 152: ldiv(R(X, Y, Z), X) = rdiv(X, R(X, Y, Z)).
Proof:
  ldiv(R(X, Y, Z), X)
= { by lemma 142 R->L }
  rdiv(zero, rdiv(R(X, Y, Z), X))
= { by lemma 134 R->L }
  rdiv(zero, ldiv(X, R(X, Y, Z))) (peak)
= { by lemma 129 }
  rdiv(zero, a(X, Y, Z))
= { by lemma 151 }
  rdiv(X, R(X, Y, Z))

Lemma 153: rdiv(R(X, Y, Z), X) = a(X, Y, Z).
Proof:
  rdiv(R(X, Y, Z), X)
= { by lemma 134 R->L }
  ldiv(X, R(X, Y, Z)) (peak)
= { by lemma 129 }
  a(X, Y, Z)

Lemma 154: ldiv(op(X, op(Y, Z)), op(op(X, Y), Z)) = a(X, Y, Z).
Proof:
  ldiv(op(X, op(Y, Z)), op(op(X, Y), Z))
= { by axiom 20 (sos) }
  ldiv(op(X, op(Y, Z)), op(op(X, op(Y, Z)), a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 155: L(ldiv(X, ldiv(Y, Z)), X, Y) = ldiv(op(Y, X), Z).
Proof:
  L(ldiv(X, ldiv(Y, Z)), X, Y) (peak)
= { by lemma 74 R->L }
  ldiv(op(Y, X), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 8 (sos) }
  ldiv(op(Y, X), Z)

Lemma 156: ldiv(rdiv(X, K(Y, Z)), W) = ldiv(X, rdiv(W, K(Z, Y))).
Proof:
  ldiv(rdiv(X, K(Y, Z)), W)
= { by lemma 63 R->L }
  ldiv(op(K(Z, Y), X), W)
= { by lemma 155 R->L }
  L(ldiv(X, ldiv(K(Z, Y), W)), X, K(Z, Y)) (peak)
= { by lemma 81 }
  ldiv(X, ldiv(K(Z, Y), W))
= { by lemma 52 }
  ldiv(X, rdiv(W, K(Z, Y)))

Lemma 157: ldiv(X, rdiv(op(X, Y), K(Z, W))) = rdiv(Y, K(Z, W)).
Proof:
  ldiv(X, rdiv(op(X, Y), K(Z, W)))
= { by lemma 63 R->L }
  ldiv(X, op(K(W, Z), op(X, Y)))
= { by lemma 105 R->L }
  ldiv(R(X, Y, K(W, Z)), op(K(W, Z), op(X, Y))) (peak)
= { by lemma 37 }
  ldiv(R(X, Y, K(W, Z)), op(op(X, Y), K(W, Z))) (peak)
= { by lemma 79 }
  op(Y, K(W, Z))
= { by lemma 64 }
  rdiv(Y, K(Z, W))

Lemma 158: ldiv(X, rdiv(Y, K(Z, W))) = rdiv(ldiv(X, Y), K(Z, W)).
Proof:
  ldiv(X, rdiv(Y, K(Z, W)))
= { by axiom 8 (sos) R->L }
  ldiv(X, rdiv(op(X, ldiv(X, Y)), K(Z, W))) (peak)
= { by lemma 157 }
  rdiv(ldiv(X, Y), K(Z, W))

Lemma 159: a(X, Y, rdiv(Z, K(W, V))) = a(X, Y, Z).
Proof:
  a(X, Y, rdiv(Z, K(W, V)))
= { by lemma 154 R->L }
  ldiv(op(X, op(Y, rdiv(Z, K(W, V)))), op(op(X, Y), rdiv(Z, K(W, V)))) (peak)
= { by lemma 110 }
  ldiv(op(X, rdiv(op(Y, Z), K(W, V))), op(op(X, Y), rdiv(Z, K(W, V))))
= { by lemma 110 }
  ldiv(rdiv(op(X, op(Y, Z)), K(W, V)), op(op(X, Y), rdiv(Z, K(W, V))))
= { by lemma 156 }
  ldiv(op(X, op(Y, Z)), rdiv(op(op(X, Y), rdiv(Z, K(W, V))), K(V, W)))
= { by lemma 158 }
  rdiv(ldiv(op(X, op(Y, Z)), op(op(X, Y), rdiv(Z, K(W, V)))), K(V, W))
= { by lemma 110 }
  rdiv(ldiv(op(X, op(Y, Z)), rdiv(op(op(X, Y), Z), K(W, V))), K(V, W))
= { by lemma 158 }
  rdiv(rdiv(ldiv(op(X, op(Y, Z)), op(op(X, Y), Z)), K(W, V)), K(V, W))
= { by lemma 146 }
  rdiv(ldiv(op(X, op(Y, Z)), op(op(X, Y), Z)), rdiv(K(V, W), K(V, W)))
= { by lemma 154 }
  rdiv(a(X, Y, Z), rdiv(K(V, W), K(V, W)))
= { by lemma 26 }
  rdiv(a(X, Y, Z), zero)
= { by lemma 27 }
  a(X, Y, Z)

Lemma 160: rdiv(X, K(rdiv(X, Y), Y)) = op(Y, rdiv(X, Y)).
Proof:
  rdiv(X, K(rdiv(X, Y), Y))
= { by axiom 9 (sos) R->L }
  rdiv(op(rdiv(X, Y), Y), K(rdiv(X, Y), Y)) (peak)
= { by lemma 36 }
  op(Y, rdiv(X, Y))

Lemma 161: op(ldiv(ldiv(X, Y), Y), ldiv(X, Y)) = op(X, rdiv(Y, X)).
Proof:
  op(ldiv(ldiv(X, Y), Y), ldiv(X, Y))
= { by lemma 33 R->L }
  op(Y, K(ldiv(ldiv(X, Y), Y), ldiv(X, Y))) (peak)
= { by lemma 92 }
  op(Y, K(T(X, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 64 }
  rdiv(Y, K(ldiv(X, Y), T(X, ldiv(X, Y))))
= { by lemma 87 }
  rdiv(Y, K(rdiv(Y, X), T(X, ldiv(X, Y))))
= { by lemma 118 }
  rdiv(Y, K(rdiv(Y, X), X))
= { by lemma 160 }
  op(X, rdiv(Y, X))

Lemma 162: op(T(X, rdiv(Y, X)), ldiv(X, Y)) = op(X, rdiv(Y, X)).
Proof:
  op(T(X, rdiv(Y, X)), ldiv(X, Y))
= { by lemma 85 R->L }
  op(T(X, ldiv(X, Y)), ldiv(X, Y)) (peak)
= { by lemma 92 R->L }
  op(ldiv(ldiv(X, Y), Y), ldiv(X, Y)) (peak)
= { by lemma 161 }
  op(X, rdiv(Y, X))

Lemma 163: rdiv(ldiv(X, Y), K(rdiv(Y, X), X)) = rdiv(Y, X).
Proof:
  rdiv(ldiv(X, Y), K(rdiv(Y, X), X))
= { by lemma 71 R->L }
  rdiv(ldiv(X, Y), K(rdiv(Y, X), T(X, rdiv(Y, X))))
= { by lemma 87 R->L }
  rdiv(ldiv(X, Y), K(ldiv(X, Y), T(X, rdiv(Y, X))))
= { by lemma 64 R->L }
  op(ldiv(X, Y), K(T(X, rdiv(Y, X)), ldiv(X, Y)))
= { by lemma 44 }
  rdiv(op(T(X, rdiv(Y, X)), ldiv(X, Y)), T(X, rdiv(Y, X))) (peak)
= { by lemma 162 }
  rdiv(op(X, rdiv(Y, X)), T(X, rdiv(Y, X)))
= { by lemma 98 }
  rdiv(Y, X)

Lemma 164: a(X, Y, ldiv(Z, W)) = a(X, Y, rdiv(W, Z)).
Proof:
  a(X, Y, ldiv(Z, W))
= { by lemma 159 R->L }
  a(X, Y, rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))) (peak)
= { by lemma 163 }
  a(X, Y, rdiv(W, Z))

Lemma 165: op(rdiv(X, K(Y, Z)), W) = rdiv(op(X, W), K(Y, Z)).
Proof:
  op(rdiv(X, K(Y, Z)), W)
= { by lemma 64 R->L }
  op(op(X, K(Z, Y)), W) (peak)
= { by lemma 37 R->L }
  op(op(K(Z, Y), X), W) (peak)
= { by lemma 54 }
  op(X, op(W, K(Z, Y)))
= { by lemma 64 }
  op(X, rdiv(W, K(Y, Z)))
= { by lemma 110 }
  rdiv(op(X, W), K(Y, Z))

Lemma 166: a(X, rdiv(Y, K(Z, W)), V) = a(X, Y, V).
Proof:
  a(X, rdiv(Y, K(Z, W)), V)
= { by lemma 154 R->L }
  ldiv(op(X, op(rdiv(Y, K(Z, W)), V)), op(op(X, rdiv(Y, K(Z, W))), V)) (peak)
= { by lemma 110 }
  ldiv(op(X, op(rdiv(Y, K(Z, W)), V)), op(rdiv(op(X, Y), K(Z, W)), V))
= { by lemma 165 }
  ldiv(op(X, rdiv(op(Y, V), K(Z, W))), op(rdiv(op(X, Y), K(Z, W)), V))
= { by lemma 110 }
  ldiv(rdiv(op(X, op(Y, V)), K(Z, W)), op(rdiv(op(X, Y), K(Z, W)), V))
= { by lemma 156 }
  ldiv(op(X, op(Y, V)), rdiv(op(rdiv(op(X, Y), K(Z, W)), V), K(W, Z)))
= { by lemma 158 }
  rdiv(ldiv(op(X, op(Y, V)), op(rdiv(op(X, Y), K(Z, W)), V)), K(W, Z))
= { by lemma 165 }
  rdiv(ldiv(op(X, op(Y, V)), rdiv(op(op(X, Y), V), K(Z, W))), K(W, Z))
= { by lemma 158 }
  rdiv(rdiv(ldiv(op(X, op(Y, V)), op(op(X, Y), V)), K(Z, W)), K(W, Z))
= { by lemma 146 }
  rdiv(ldiv(op(X, op(Y, V)), op(op(X, Y), V)), rdiv(K(W, Z), K(W, Z)))
= { by lemma 154 }
  rdiv(a(X, Y, V), rdiv(K(W, Z), K(W, Z)))
= { by lemma 26 }
  rdiv(a(X, Y, V), zero)
= { by lemma 27 }
  a(X, Y, V)

Lemma 167: a(X, ldiv(Y, Z), W) = a(X, rdiv(Z, Y), W).
Proof:
  a(X, ldiv(Y, Z), W)
= { by lemma 166 R->L }
  a(X, rdiv(ldiv(Y, Z), K(rdiv(Z, Y), Y)), W) (peak)
= { by lemma 163 }
  a(X, rdiv(Z, Y), W)

Lemma 168: a(rdiv(X, K(Y, Z)), W, V) = a(X, W, V).
Proof:
  a(rdiv(X, K(Y, Z)), W, V)
= { by lemma 64 R->L }
  a(op(X, K(Z, Y)), W, V)
= { by lemma 154 R->L }
  ldiv(op(op(X, K(Z, Y)), op(W, V)), op(op(op(X, K(Z, Y)), W), V)) (peak)
= { by lemma 38 }
  ldiv(op(K(Z, Y), op(X, op(W, V))), op(op(op(X, K(Z, Y)), W), V))
= { by lemma 63 }
  ldiv(rdiv(op(X, op(W, V)), K(Y, Z)), op(op(op(X, K(Z, Y)), W), V))
= { by lemma 156 }
  ldiv(op(X, op(W, V)), rdiv(op(op(op(X, K(Z, Y)), W), V), K(Z, Y)))
= { by lemma 158 }
  rdiv(ldiv(op(X, op(W, V)), op(op(op(X, K(Z, Y)), W), V)), K(Z, Y))
= { by lemma 38 }
  rdiv(ldiv(op(X, op(W, V)), op(op(K(Z, Y), op(X, W)), V)), K(Z, Y))
= { by lemma 54 }
  rdiv(ldiv(op(X, op(W, V)), op(op(X, W), op(V, K(Z, Y)))), K(Z, Y))
= { by lemma 64 }
  rdiv(ldiv(op(X, op(W, V)), op(op(X, W), rdiv(V, K(Y, Z)))), K(Z, Y))
= { by lemma 110 }
  rdiv(ldiv(op(X, op(W, V)), rdiv(op(op(X, W), V), K(Y, Z))), K(Z, Y))
= { by lemma 158 }
  rdiv(rdiv(ldiv(op(X, op(W, V)), op(op(X, W), V)), K(Y, Z)), K(Z, Y))
= { by lemma 146 }
  rdiv(ldiv(op(X, op(W, V)), op(op(X, W), V)), rdiv(K(Z, Y), K(Z, Y)))
= { by lemma 154 }
  rdiv(a(X, W, V), rdiv(K(Z, Y), K(Z, Y)))
= { by lemma 26 }
  rdiv(a(X, W, V), zero)
= { by lemma 27 }
  a(X, W, V)

Lemma 169: a(ldiv(X, Y), Z, W) = a(rdiv(Y, X), Z, W).
Proof:
  a(ldiv(X, Y), Z, W)
= { by lemma 168 R->L }
  a(rdiv(ldiv(X, Y), K(rdiv(Y, X), X)), Z, W) (peak)
= { by lemma 163 }
  a(rdiv(Y, X), Z, W)

Lemma 170: K(X, a(Y, Z, W)) = zero.
Proof:
  K(X, a(Y, Z, W)) (peak)
= { by axiom 10 (sos) }
  1
= { by lemma 24 }
  zero

Lemma 171: op(a(X, Y, Z), op(W, V)) = op(W, op(V, a(X, Y, Z))).
Proof:
  op(a(X, Y, Z), op(W, V)) (peak)
= { by lemma 122 }
  op(op(W, V), a(X, Y, Z)) (peak)
= { by lemma 138 R->L }
  op(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 123 }
  op(W, op(V, a(X, Y, Z)))

Lemma 172: op(a(X, Y, Z), op(W, V)) = op(W, op(a(X, Y, Z), V)).
Proof:
  op(a(X, Y, Z), op(W, V)) (peak)
= { by lemma 171 }
  op(W, op(V, a(X, Y, Z))) (peak)
= { by lemma 122 R->L }
  op(W, op(a(X, Y, Z), V)) (peak)

Lemma 173: rdiv(op(X, T(Z, Y)), op(Z, Y)) = R(rdiv(X, Y), Y, T(Z, Y)).
Proof:
  rdiv(op(X, T(Z, Y)), op(Z, Y))
= { by lemma 65 R->L }
  rdiv(op(X, T(Z, Y)), op(Y, T(Z, Y))) (peak)
= { by lemma 45 }
  R(rdiv(X, Y), Y, T(Z, Y))

Lemma 174: R(X, Y, a(Z, W, V)) = X.
Proof:
  R(X, Y, a(Z, W, V))
= { by axiom 18 (sos) }
  rdiv(op(op(X, Y), a(Z, W, V)), op(Y, a(Z, W, V))) (peak)
= { by lemma 125 }
  rdiv(op(X, op(Y, a(Z, W, V))), op(Y, a(Z, W, V)))
= { by axiom 3 (sos) }
  X

Lemma 175: rdiv(op(X, a(Y, Z, W)), V) = rdiv(X, rdiv(V, a(Y, Z, W))).
Proof:
  rdiv(op(X, a(Y, Z, W)), V)
= { by lemma 143 R->L }
  rdiv(op(X, T(a(Y, Z, W), rdiv(V, a(Y, Z, W)))), V)
= { by lemma 135 R->L }
  rdiv(op(X, T(a(Y, Z, W), rdiv(V, a(Y, Z, W)))), op(a(Y, Z, W), rdiv(V, a(Y, Z, W))))
= { by lemma 173 }
  R(rdiv(X, rdiv(V, a(Y, Z, W))), rdiv(V, a(Y, Z, W)), T(a(Y, Z, W), rdiv(V, a(Y, Z, W)))) (peak)
= { by lemma 143 }
  R(rdiv(X, rdiv(V, a(Y, Z, W))), rdiv(V, a(Y, Z, W)), a(Y, Z, W))
= { by lemma 174 }
  rdiv(X, rdiv(V, a(Y, Z, W)))

Lemma 176: rdiv(op(a(X, Y, Z), W), V) = rdiv(W, rdiv(V, a(X, Y, Z))).
Proof:
  rdiv(op(a(X, Y, Z), W), V) (peak)
= { by lemma 122 }
  rdiv(op(W, a(X, Y, Z)), V) (peak)
= { by lemma 175 }
  rdiv(W, rdiv(V, a(X, Y, Z)))

Lemma 177: L(a(X, Y, Z), W, V) = a(X, Y, Z).
Proof:
  L(a(X, Y, Z), W, V)
= { by axiom 19 (sos) }
  ldiv(op(V, W), op(V, op(W, a(X, Y, Z))))
= { by lemma 125 R->L }
  ldiv(op(V, W), op(op(V, W), a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 178: rdiv(op(X, op(Y, Z)), L(Z, Y, X)) = op(X, Y).
Proof:
  rdiv(op(X, op(Y, Z)), L(Z, Y, X))
= { by axiom 19 (sos) }
  rdiv(op(X, op(Y, Z)), ldiv(op(X, Y), op(X, op(Y, Z)))) (peak)
= { by lemma 94 }
  op(X, Y)

Lemma 179: rdiv(op(X, op(Y, a(Z, W, V))), a(Z, W, V)) = op(X, Y).
Proof:
  rdiv(op(X, op(Y, a(Z, W, V))), a(Z, W, V)) (peak)
= { by lemma 122 R->L }
  rdiv(op(X, op(a(Z, W, V), Y)), a(Z, W, V))
= { by lemma 177 R->L }
  rdiv(op(X, op(a(Z, W, V), Y)), L(a(Z, W, V), Y, X)) (peak)
= { by lemma 122 }
  rdiv(op(X, op(Y, a(Z, W, V))), L(a(Z, W, V), Y, X)) (peak)
= { by lemma 178 }
  op(X, Y)

Lemma 180: K(X, op(Y, a(Z, W, V))) = K(X, Y).
Proof:
  K(X, op(Y, a(Z, W, V))) (peak)
= { by lemma 116 }
  K(X, op(a(Z, W, V), Y))
= { by lemma 57 R->L }
  rdiv(op(X, op(a(Z, W, V), Y)), op(op(a(Z, W, V), Y), X)) (peak)
= { by lemma 172 R->L }
  rdiv(op(a(Z, W, V), op(X, Y)), op(op(a(Z, W, V), Y), X)) (peak)
= { by lemma 176 }
  rdiv(op(X, Y), rdiv(op(op(a(Z, W, V), Y), X), a(Z, W, V)))
= { by lemma 139 }
  rdiv(op(X, Y), rdiv(op(Y, op(X, a(Z, W, V))), a(Z, W, V)))
= { by lemma 179 }
  rdiv(op(X, Y), op(Y, X))
= { by lemma 57 }
  K(X, Y)

Lemma 181: K(X, R(Y, Z, W)) = K(X, Y).
Proof:
  K(X, R(Y, Z, W))
= { by lemma 128 R->L }
  K(X, op(Y, a(Y, Z, W))) (peak)
= { by lemma 180 }
  K(X, Y)

Lemma 182: K(a(X, Y, Z), W) = zero.
Proof:
  K(a(X, Y, Z), W) (peak)
= { by axiom 11 (sos) }
  1
= { by lemma 24 }
  zero

Lemma 183: K(op(X, a(Y, Z, W)), V) = K(X, V).
Proof:
  K(op(X, a(Y, Z, W)), V)
= { by lemma 58 R->L }
  rdiv(zero, K(V, op(X, a(Y, Z, W)))) (peak)
= { by lemma 180 }
  rdiv(zero, K(V, X))
= { by lemma 58 }
  K(X, V)

Lemma 184: K(R(X, Y, Z), W) = K(X, W).
Proof:
  K(R(X, Y, Z), W)
= { by lemma 128 R->L }
  K(op(X, a(X, Y, Z)), W) (peak)
= { by lemma 183 }
  K(X, W)

Lemma 185: op(op(X, Y), L(Z, Y, X)) = op(X, op(Y, Z)).
Proof:
  op(op(X, Y), L(Z, Y, X))
= { by axiom 19 (sos) }
  op(op(X, Y), ldiv(op(X, Y), op(X, op(Y, Z)))) (peak)
= { by axiom 8 (sos) }
  op(X, op(Y, Z))

Lemma 186: op(X, L(Y, ldiv(Z, X), Z)) = op(Z, op(ldiv(Z, X), Y)).
Proof:
  op(X, L(Y, ldiv(Z, X), Z))
= { by axiom 8 (sos) R->L }
  op(op(Z, ldiv(Z, X)), L(Y, ldiv(Z, X), Z)) (peak)
= { by lemma 185 }
  op(Z, op(ldiv(Z, X), Y))

Lemma 187: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, ldiv(Y, X), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by axiom 8 (sos) R->L }
  ldiv(op(Y, ldiv(Y, X)), op(Y, op(ldiv(Y, X), Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, ldiv(Y, X), Y)

Lemma 188: rdiv(rdiv(X, Y), K(Z, W)) = rdiv(X, rdiv(Y, K(W, Z))).
Proof:
  rdiv(rdiv(X, Y), K(Z, W))
= { by lemma 78 R->L }
  R(rdiv(rdiv(X, Y), K(Z, W)), K(Z, W), Y) (peak)
= { by lemma 145 }
  rdiv(X, op(K(Z, W), Y))
= { by lemma 63 }
  rdiv(X, rdiv(Y, K(W, Z)))

Lemma 189: L(X, rdiv(Y, K(Z, W)), V) = L(X, Y, V).
Proof:
  L(X, rdiv(Y, K(Z, W)), V)
= { by lemma 157 R->L }
  L(X, ldiv(V, rdiv(op(V, Y), K(Z, W))), V)
= { by lemma 187 R->L }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(ldiv(V, rdiv(op(V, Y), K(Z, W))), X))) (peak)
= { by lemma 157 }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(rdiv(Y, K(Z, W)), X)))
= { by lemma 156 }
  ldiv(op(V, Y), rdiv(op(V, op(rdiv(Y, K(Z, W)), X)), K(W, Z)))
= { by lemma 158 }
  rdiv(ldiv(op(V, Y), op(V, op(rdiv(Y, K(Z, W)), X))), K(W, Z))
= { by lemma 165 }
  rdiv(ldiv(op(V, Y), op(V, rdiv(op(Y, X), K(Z, W)))), K(W, Z))
= { by lemma 110 }
  rdiv(ldiv(op(V, Y), rdiv(op(V, op(Y, X)), K(Z, W))), K(W, Z))
= { by lemma 158 }
  rdiv(rdiv(ldiv(op(V, Y), op(V, op(Y, X))), K(Z, W)), K(W, Z))
= { by lemma 188 }
  rdiv(ldiv(op(V, Y), op(V, op(Y, X))), rdiv(K(Z, W), K(Z, W)))
= { by axiom 19 (sos) R->L }
  rdiv(L(X, Y, V), rdiv(K(Z, W), K(Z, W)))
= { by lemma 26 }
  rdiv(L(X, Y, V), zero)
= { by lemma 27 }
  L(X, Y, V)

Lemma 190: L(X, op(Y, Z), W) = L(X, op(Z, Y), W).
Proof:
  L(X, op(Y, Z), W)
= { by lemma 189 R->L }
  L(X, rdiv(op(Y, Z), K(Y, Z)), W) (peak)
= { by lemma 36 }
  L(X, op(Z, Y), W)

Lemma 191: op(X, K(rdiv(Y, X), X)) = rdiv(Y, rdiv(Y, X)).
Proof:
  op(X, K(rdiv(Y, X), X))
= { by lemma 44 }
  rdiv(op(rdiv(Y, X), X), rdiv(Y, X)) (peak)
= { by axiom 9 (sos) }
  rdiv(Y, rdiv(Y, X))

Lemma 192: op(ldiv(X, Y), K(X, rdiv(Y, X))) = rdiv(Y, X).
Proof:
  op(ldiv(X, Y), K(X, rdiv(Y, X)))
= { by lemma 117 R->L }
  op(ldiv(X, Y), K(X, ldiv(X, Y)))
= { by lemma 94 R->L }
  op(ldiv(X, Y), K(rdiv(Y, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 191 }
  rdiv(Y, rdiv(Y, ldiv(X, Y)))
= { by lemma 94 }
  rdiv(Y, X)

Lemma 193: L(X, ldiv(Y, Z), W) = L(X, rdiv(Z, Y), W).
Proof:
  L(X, ldiv(Y, Z), W)
= { by lemma 189 R->L }
  L(X, rdiv(ldiv(Y, Z), K(rdiv(Z, Y), Y)), W)
= { by lemma 63 R->L }
  L(X, op(K(Y, rdiv(Z, Y)), ldiv(Y, Z)), W) (peak)
= { by lemma 190 R->L }
  L(X, op(ldiv(Y, Z), K(Y, rdiv(Z, Y))), W)
= { by lemma 192 }
  L(X, rdiv(Z, Y), W)

Lemma 194: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, rdiv(X, Y), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by lemma 186 R->L }
  ldiv(X, op(X, L(Z, ldiv(Y, X), Y))) (peak)
= { by axiom 4 (sos) }
  L(Z, ldiv(Y, X), Y)
= { by lemma 193 }
  L(Z, rdiv(X, Y), Y)

Lemma 195: op(X, op(Y, a(Z, X, Y))) = ldiv(Z, op(op(Z, X), Y)).
Proof:
  op(X, op(Y, a(Z, X, Y)))
= { by lemma 125 R->L }
  op(op(X, Y), a(Z, X, Y))
= { by lemma 79 R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, op(X, Y)), a(Z, X, Y))) (peak)
= { by axiom 20 (sos) R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, X), Y))
= { by lemma 174 }
  ldiv(Z, op(op(Z, X), Y))

Lemma 196: op(rdiv(X, a(Y, Z, W)), V) = rdiv(op(X, V), a(Y, Z, W)).
Proof:
  op(rdiv(X, a(Y, Z, W)), V)
= { by axiom 1 (sos) R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, zero))
= { by lemma 24 R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, 1))
= { by axiom 16 (sos) R->L }
  op(rdiv(X, a(Y, Z, W)), op(V, a(a(Y, Z, W), rdiv(X, a(Y, Z, W)), V))) (peak)
= { by lemma 195 }
  ldiv(a(Y, Z, W), op(op(a(Y, Z, W), rdiv(X, a(Y, Z, W))), V))
= { by lemma 135 }
  ldiv(a(Y, Z, W), op(X, V))
= { by lemma 136 }
  rdiv(op(X, V), a(Y, Z, W))

Lemma 197: L(X, rdiv(Y, a(Z, W, V)), a(Z, W, V)) = X.
Proof:
  L(X, rdiv(Y, a(Z, W, V)), a(Z, W, V))
= { by lemma 194 R->L }
  ldiv(Y, op(a(Z, W, V), op(ldiv(a(Z, W, V), Y), X))) (peak)
= { by lemma 136 }
  ldiv(Y, op(a(Z, W, V), op(rdiv(Y, a(Z, W, V)), X)))
= { by lemma 196 }
  ldiv(Y, op(a(Z, W, V), rdiv(op(Y, X), a(Z, W, V))))
= { by lemma 135 }
  ldiv(Y, op(Y, X))
= { by axiom 4 (sos) }
  X

Lemma 198: L(X, Y, a(Z, W, V)) = X.
Proof:
  L(X, Y, a(Z, W, V))
= { by axiom 3 (sos) R->L }
  L(X, rdiv(op(Y, a(Z, W, V)), a(Z, W, V)), a(Z, W, V)) (peak)
= { by lemma 197 }
  X

Lemma 199: T(X, op(Y, a(Z, W, V))) = T(X, Y).
Proof:
  T(X, op(Y, a(Z, W, V))) (peak)
= { by lemma 115 R->L }
  T(X, op(a(Z, W, V), Y))
= { by axiom 5 (sos) }
  ldiv(op(a(Z, W, V), Y), op(X, op(a(Z, W, V), Y))) (peak)
= { by lemma 172 R->L }
  ldiv(op(a(Z, W, V), Y), op(a(Z, W, V), op(X, Y))) (peak)
= { by lemma 75 }
  L(T(X, Y), Y, a(Z, W, V))
= { by lemma 198 }
  T(X, Y)

Lemma 200: T(X, R(Y, Z, W)) = T(X, Y).
Proof:
  T(X, R(Y, Z, W))
= { by lemma 128 R->L }
  T(X, op(Y, a(Y, Z, W))) (peak)
= { by lemma 199 }
  T(X, Y)

Lemma 201: T(X, R(Y, V, U)) = T(X, R(Y, Z, W)).
Proof:
  T(X, R(Y, V, U)) (peak)
= { by lemma 200 }
  T(X, Y)
= { by lemma 200 R->L }
  T(X, R(Y, Z, W)) (peak)

Lemma 202: K(R(X, V, U), W) = K(R(X, Y, Z), W).
Proof:
  K(R(X, V, U), W)
= { by lemma 101 R->L }
  rdiv(W, T(W, R(X, V, U)))
= { by lemma 96 R->L }
  ldiv(T(W, R(X, V, U)), W) (peak)
= { by lemma 201 }
  ldiv(T(W, R(X, Y, Z)), W) (peak)
= { by lemma 86 }
  K(R(X, Y, Z), W)

Lemma 203: op(R(X, Y, Z), op(Y, Z)) = op(op(X, Y), Z).
Proof:
  op(R(X, Y, Z), op(Y, Z))
= { by axiom 18 (sos) }
  op(rdiv(op(op(X, Y), Z), op(Y, Z)), op(Y, Z)) (peak)
= { by axiom 9 (sos) }
  op(op(X, Y), Z)

Lemma 204: op(R(X, Y, ldiv(Y, Z)), Z) = op(op(X, Y), ldiv(Y, Z)).
Proof:
  op(R(X, Y, ldiv(Y, Z)), Z)
= { by axiom 8 (sos) R->L }
  op(R(X, Y, ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by lemma 203 }
  op(op(X, Y), ldiv(Y, Z))

Lemma 205: op(op(X, Y), ldiv(Y, zero)) = R(X, Y, ldiv(Y, zero)).
Proof:
  op(op(X, Y), ldiv(Y, zero))
= { by lemma 204 R->L }
  op(R(X, Y, ldiv(Y, zero)), zero) (peak)
= { by axiom 1 (sos) }
  R(X, Y, ldiv(Y, zero))

Lemma 206: rdiv(op(X, Y), K(Z, Y)) = op(X, T(Y, Z)).
Proof:
  rdiv(op(X, Y), K(Z, Y))
= { by lemma 63 R->L }
  op(K(Y, Z), op(X, Y)) (peak)
= { by lemma 39 }
  op(X, op(Y, K(Y, Z))) (peak)
= { by lemma 42 }
  op(X, T(Y, Z))

Lemma 207: ldiv(op(X, Y), op(op(Z, X), Y)) = T(R(Z, X, Y), op(X, Y)).
Proof:
  ldiv(op(X, Y), op(op(Z, X), Y))
= { by lemma 50 R->L }
  T(rdiv(op(op(Z, X), Y), op(X, Y)), op(X, Y)) (peak)
= { by axiom 18 (sos) R->L }
  T(R(Z, X, Y), op(X, Y))

Lemma 208: T(X, op(Y, rdiv(Z, Y))) = T(X, Z).
Proof:
  T(X, op(Y, rdiv(Z, Y)))
= { by lemma 115 R->L }
  T(X, op(rdiv(Z, Y), Y)) (peak)
= { by axiom 9 (sos) }
  T(X, Z)

Lemma 209: R(X, Y, ldiv(Y, zero)) = R(X, Y, rdiv(zero, Y)).
Proof:
  R(X, Y, ldiv(Y, zero))
= { by lemma 205 R->L }
  op(op(X, Y), ldiv(Y, zero))
= { by lemma 50 R->L }
  op(op(X, Y), T(rdiv(zero, Y), Y))
= { by lemma 206 R->L }
  rdiv(op(op(X, Y), rdiv(zero, Y)), K(Y, rdiv(zero, Y)))
= { by lemma 52 R->L }
  ldiv(K(Y, rdiv(zero, Y)), op(op(X, Y), rdiv(zero, Y)))
= { by lemma 35 R->L }
  ldiv(op(Y, rdiv(zero, Y)), op(op(X, Y), rdiv(zero, Y))) (peak)
= { by lemma 207 }
  T(R(X, Y, rdiv(zero, Y)), op(Y, rdiv(zero, Y)))
= { by lemma 208 }
  T(R(X, Y, rdiv(zero, Y)), zero)
= { by lemma 29 }
  R(X, Y, rdiv(zero, Y))

Lemma 210: R(X, ldiv(Y, Z), W) = R(X, rdiv(Z, Y), W).
Proof:
  R(X, ldiv(Y, Z), W)
= { by lemma 128 R->L }
  op(X, a(X, ldiv(Y, Z), W)) (peak)
= { by lemma 167 }
  op(X, a(X, rdiv(Z, Y), W))
= { by lemma 128 }
  R(X, rdiv(Z, Y), W)

Lemma 211: R(X, T(Y, Z), W) = R(X, Y, W).
Proof:
  R(X, T(Y, Z), W)
= { by axiom 5 (sos) }
  R(X, ldiv(Z, op(Y, Z)), W) (peak)
= { by lemma 210 }
  R(X, rdiv(op(Y, Z), Z), W)
= { by axiom 3 (sos) }
  R(X, Y, W)

Lemma 212: rdiv(op(op(X, Y), Z), op(T(X, Y), Z)) = R(Y, X, Z).
Proof:
  rdiv(op(op(X, Y), Z), op(T(X, Y), Z))
= { by lemma 65 R->L }
  rdiv(op(op(Y, T(X, Y)), Z), op(T(X, Y), Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(Y, T(X, Y), Z)
= { by lemma 211 }
  R(Y, X, Z)

Lemma 213: rdiv(op(X, Y), T(Y, Z)) = rdiv(X, K(Y, Z)).
Proof:
  rdiv(op(X, Y), T(Y, Z))
= { by lemma 51 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), T(Y, Z))
= { by lemma 42 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), op(Y, K(Y, Z)))
= { by lemma 173 }
  R(rdiv(X, K(Y, Z)), K(Y, Z), T(Y, K(Y, Z))) (peak)
= { by lemma 78 }
  rdiv(X, K(Y, Z))

Lemma 214: rdiv(K(X, Y), K(X, Z)) = rdiv(T(X, Y), T(X, Z)).
Proof:
  rdiv(K(X, Y), K(X, Z))
= { by lemma 213 R->L }
  rdiv(op(K(X, Y), X), T(X, Z)) (peak)
= { by lemma 89 }
  rdiv(T(X, Y), T(X, Z))

Lemma 215: R(X, Y, rdiv(Z, K(W, V))) = R(X, Y, Z).
Proof:
  R(X, Y, rdiv(Z, K(W, V)))
= { by lemma 212 R->L }
  rdiv(op(op(Y, X), rdiv(Z, K(W, V))), op(T(Y, X), rdiv(Z, K(W, V)))) (peak)
= { by lemma 110 }
  rdiv(rdiv(op(op(Y, X), Z), K(W, V)), op(T(Y, X), rdiv(Z, K(W, V))))
= { by lemma 146 }
  rdiv(op(op(Y, X), Z), rdiv(op(T(Y, X), rdiv(Z, K(W, V))), K(V, W)))
= { by lemma 110 }
  rdiv(op(op(Y, X), Z), rdiv(rdiv(op(T(Y, X), Z), K(W, V)), K(V, W)))
= { by lemma 146 }
  rdiv(op(op(Y, X), Z), rdiv(op(T(Y, X), Z), rdiv(K(V, W), K(V, W))))
= { by lemma 214 }
  rdiv(op(op(Y, X), Z), rdiv(op(T(Y, X), Z), rdiv(T(V, W), T(V, W))))
= { by lemma 26 }
  rdiv(op(op(Y, X), Z), rdiv(op(T(Y, X), Z), zero))
= { by lemma 27 }
  rdiv(op(op(Y, X), Z), op(T(Y, X), Z))
= { by lemma 212 }
  R(X, Y, Z)

Lemma 216: R(X, Y, ldiv(Z, W)) = R(X, Y, rdiv(W, Z)).
Proof:
  R(X, Y, ldiv(Z, W))
= { by lemma 215 R->L }
  R(X, Y, rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))) (peak)
= { by lemma 163 }
  R(X, Y, rdiv(W, Z))

Lemma 217: R(X, Y, T(Z, W)) = R(X, Y, Z).
Proof:
  R(X, Y, T(Z, W))
= { by axiom 5 (sos) }
  R(X, Y, ldiv(W, op(Z, W))) (peak)
= { by lemma 216 }
  R(X, Y, rdiv(op(Z, W), W))
= { by axiom 3 (sos) }
  R(X, Y, Z)

Lemma 218: rdiv(op(X, Y), rdiv(Y, K(Z, W))) = rdiv(X, K(W, Z)).
Proof:
  rdiv(op(X, Y), rdiv(Y, K(Z, W)))
= { by lemma 63 R->L }
  rdiv(op(X, Y), op(K(W, Z), Y))
= { by lemma 51 R->L }
  rdiv(op(X, T(Y, K(W, Z))), op(K(W, Z), Y)) (peak)
= { by lemma 37 }
  rdiv(op(X, T(Y, K(W, Z))), op(Y, K(W, Z))) (peak)
= { by lemma 173 }
  R(rdiv(X, K(W, Z)), K(W, Z), T(Y, K(W, Z))) (peak)
= { by lemma 78 }
  rdiv(X, K(W, Z))

Lemma 219: ldiv(X, op(rdiv(X, Y), op(Y, Z))) = L(Z, Y, rdiv(X, Y)).
Proof:
  ldiv(X, op(rdiv(X, Y), op(Y, Z)))
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(X, Y), Y), op(rdiv(X, Y), op(Y, Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, Y, rdiv(X, Y))

Lemma 220: L(X, Y, rdiv(Z, K(W, V))) = L(X, Y, Z).
Proof:
  L(X, Y, rdiv(Z, K(W, V)))
= { by lemma 218 R->L }
  L(X, Y, rdiv(op(Z, Y), rdiv(Y, K(V, W))))
= { by lemma 189 R->L }
  L(X, rdiv(Y, K(V, W)), rdiv(op(Z, Y), rdiv(Y, K(V, W))))
= { by lemma 219 R->L }
  ldiv(op(Z, Y), op(rdiv(op(Z, Y), rdiv(Y, K(V, W))), op(rdiv(Y, K(V, W)), X))) (peak)
= { by lemma 218 }
  ldiv(op(Z, Y), op(rdiv(Z, K(W, V)), op(rdiv(Y, K(V, W)), X)))
= { by lemma 165 }
  ldiv(op(Z, Y), rdiv(op(Z, op(rdiv(Y, K(V, W)), X)), K(W, V)))
= { by lemma 158 }
  rdiv(ldiv(op(Z, Y), op(Z, op(rdiv(Y, K(V, W)), X))), K(W, V))
= { by lemma 165 }
  rdiv(ldiv(op(Z, Y), op(Z, rdiv(op(Y, X), K(V, W)))), K(W, V))
= { by lemma 110 }
  rdiv(ldiv(op(Z, Y), rdiv(op(Z, op(Y, X)), K(V, W))), K(W, V))
= { by lemma 158 }
  rdiv(rdiv(ldiv(op(Z, Y), op(Z, op(Y, X))), K(V, W)), K(W, V))
= { by lemma 146 }
  rdiv(ldiv(op(Z, Y), op(Z, op(Y, X))), rdiv(K(W, V), K(W, V)))
= { by axiom 19 (sos) R->L }
  rdiv(L(X, Y, Z), rdiv(K(W, V), K(W, V)))
= { by lemma 26 }
  rdiv(L(X, Y, Z), zero)
= { by lemma 27 }
  L(X, Y, Z)

Lemma 221: L(X, Y, ldiv(Z, W)) = L(X, Y, rdiv(W, Z)).
Proof:
  L(X, Y, ldiv(Z, W))
= { by lemma 220 R->L }
  L(X, Y, rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))) (peak)
= { by lemma 163 }
  L(X, Y, rdiv(W, Z))

Lemma 222: op(X, op(ldiv(X, zero), Y)) = L(Y, ldiv(X, zero), X).
Proof:
  op(X, op(ldiv(X, zero), Y))
= { by lemma 186 R->L }
  op(zero, L(Y, ldiv(X, zero), X)) (peak)
= { by axiom 2 (sos) }
  L(Y, ldiv(X, zero), X)

Lemma 223: L(X, ldiv(X, zero), X) = rdiv(zero, rdiv(zero, X)).
Proof:
  L(X, ldiv(X, zero), X)
= { by lemma 222 R->L }
  op(X, op(ldiv(X, zero), X)) (peak)
= { by lemma 34 }
  op(X, K(ldiv(X, zero), X))
= { by lemma 87 }
  op(X, K(rdiv(zero, X), X))
= { by lemma 191 }
  rdiv(zero, rdiv(zero, X))

Lemma 224: rdiv(X, K(X, rdiv(zero, X))) = L(X, rdiv(zero, X), X).
Proof:
  rdiv(X, K(X, rdiv(zero, X)))
= { by lemma 52 R->L }
  ldiv(K(X, rdiv(zero, X)), X)
= { by lemma 35 R->L }
  ldiv(op(X, rdiv(zero, X)), X)
= { by lemma 137 R->L }
  L(ldiv(rdiv(zero, X), zero), rdiv(zero, X), X) (peak)
= { by lemma 32 }
  L(X, rdiv(zero, X), X)

Lemma 225: L(X, rdiv(zero, X), X) = rdiv(zero, rdiv(zero, X)).
Proof:
  L(X, rdiv(zero, X), X)
= { by lemma 224 R->L }
  rdiv(X, K(X, rdiv(zero, X)))
= { by lemma 117 R->L }
  rdiv(X, K(X, ldiv(X, zero)))
= { by lemma 64 R->L }
  op(X, K(ldiv(X, zero), X))
= { by lemma 25 R->L }
  ldiv(zero, op(X, K(ldiv(X, zero), X)))
= { by lemma 34 R->L }
  ldiv(zero, op(X, op(ldiv(X, zero), X))) (peak)
= { by lemma 187 }
  L(X, ldiv(X, zero), X)
= { by lemma 223 }
  rdiv(zero, rdiv(zero, X))

Lemma 226: L(X, K(Y, Z), W) = X.
Proof:
  L(X, K(Y, Z), W)
= { by lemma 51 R->L }
  L(T(X, K(Y, Z)), K(Y, Z), W)
= { by lemma 75 R->L }
  ldiv(op(W, K(Y, Z)), op(W, op(X, K(Y, Z))))
= { by lemma 54 R->L }
  ldiv(op(W, K(Y, Z)), op(op(K(Y, Z), W), X)) (peak)
= { by lemma 80 }
  rdiv(X, K(W, K(Y, Z)))
= { by axiom 6 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 227: L(X, T(Y, Z), W) = L(X, Y, W).
Proof:
  L(X, T(Y, Z), W)
= { by lemma 189 R->L }
  L(X, rdiv(T(Y, Z), K(Y, Z)), W) (peak)
= { by lemma 83 }
  L(X, Y, W)

Lemma 228: L(T(X, Y), Y, X) = T(X, op(X, Y)).
Proof:
  L(T(X, Y), Y, X)
= { by axiom 5 (sos) }
  L(ldiv(Y, op(X, Y)), Y, X) (peak)
= { by lemma 74 R->L }
  ldiv(op(X, Y), op(X, op(X, Y))) (peak)
= { by axiom 5 (sos) R->L }
  T(X, op(X, Y))

Lemma 229: K(X, rdiv(Y, K(Z, W))) = K(X, Y).
Proof:
  K(X, rdiv(Y, K(Z, W)))
= { by lemma 91 R->L }
  ldiv(X, T(X, rdiv(Y, K(Z, W)))) (peak)
= { by lemma 82 }
  ldiv(X, T(X, Y))
= { by lemma 91 }
  K(X, Y)

Lemma 230: K(X, rdiv(op(Y, Z), Y)) = K(X, Z).
Proof:
  K(X, rdiv(op(Y, Z), Y)) (peak)
= { by lemma 102 }
  K(X, rdiv(Z, K(Z, Y))) (peak)
= { by lemma 229 }
  K(X, Z)

Lemma 231: op(T(rdiv(X, Y), Z), Y) = rdiv(X, K(Z, rdiv(X, Y))).
Proof:
  op(T(rdiv(X, Y), Z), Y)
= { by lemma 144 R->L }
  rdiv(op(rdiv(X, Y), Y), K(Z, rdiv(X, Y))) (peak)
= { by axiom 9 (sos) }
  rdiv(X, K(Z, rdiv(X, Y)))

Lemma 232: L(ldiv(X, Y), X, rdiv(Y, X)) = T(rdiv(Y, X), Y).
Proof:
  L(ldiv(X, Y), X, rdiv(Y, X))
= { by lemma 50 R->L }
  L(T(rdiv(Y, X), X), X, rdiv(Y, X)) (peak)
= { by lemma 228 }
  T(rdiv(Y, X), op(rdiv(Y, X), X))
= { by axiom 9 (sos) }
  T(rdiv(Y, X), Y)

Lemma 233: L(X, Y, rdiv(op(Z, W), Z)) = L(X, Y, W).
Proof:
  L(X, Y, rdiv(op(Z, W), Z))
= { by lemma 221 R->L }
  L(X, Y, ldiv(Z, op(Z, W))) (peak)
= { by axiom 4 (sos) }
  L(X, Y, W)

Lemma 234: T(rdiv(op(X, Y), X), op(X, Y)) = L(Y, X, Y).
Proof:
  T(rdiv(op(X, Y), X), op(X, Y))
= { by lemma 232 R->L }
  L(ldiv(X, op(X, Y)), X, rdiv(op(X, Y), X)) (peak)
= { by axiom 4 (sos) }
  L(Y, X, rdiv(op(X, Y), X))
= { by lemma 233 }
  L(Y, X, Y)

Lemma 235: op(X, T(Y, op(X, Y))) = op(L(Y, X, Y), X).
Proof:
  op(X, T(Y, op(X, Y)))
= { by lemma 206 R->L }
  rdiv(op(X, Y), K(op(X, Y), Y))
= { by lemma 230 R->L }
  rdiv(op(X, Y), K(op(X, Y), rdiv(op(X, Y), X))) (peak)
= { by lemma 231 R->L }
  op(T(rdiv(op(X, Y), X), op(X, Y)), X)
= { by lemma 234 }
  op(L(Y, X, Y), X)

Lemma 236: op(X, L(Y, Z, rdiv(X, Z))) = op(rdiv(X, Z), op(Z, Y)).
Proof:
  op(X, L(Y, Z, rdiv(X, Z)))
= { by axiom 9 (sos) R->L }
  op(op(rdiv(X, Z), Z), L(Y, Z, rdiv(X, Z))) (peak)
= { by lemma 185 }
  op(rdiv(X, Z), op(Z, Y))

Lemma 237: op(rdiv(zero, X), op(X, Y)) = L(Y, X, rdiv(zero, X)).
Proof:
  op(rdiv(zero, X), op(X, Y))
= { by lemma 236 R->L }
  op(zero, L(Y, X, rdiv(zero, X))) (peak)
= { by axiom 2 (sos) }
  L(Y, X, rdiv(zero, X))

Lemma 238: ldiv(op(Z, rdiv(Y, X)), op(Z, Y)) = L(X, rdiv(Y, X), Z).
Proof:
  ldiv(op(Z, rdiv(Y, X)), op(Z, Y))
= { by axiom 9 (sos) R->L }
  ldiv(op(Z, rdiv(Y, X)), op(Z, op(rdiv(Y, X), X))) (peak)
= { by axiom 19 (sos) R->L }
  L(X, rdiv(Y, X), Z)

Lemma 239: ldiv(op(rdiv(Z, Y), rdiv(Y, X)), Z) = L(X, rdiv(Y, X), rdiv(Z, Y)).
Proof:
  ldiv(op(rdiv(Z, Y), rdiv(Y, X)), Z)
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(Z, Y), rdiv(Y, X)), op(rdiv(Z, Y), Y)) (peak)
= { by lemma 238 }
  L(X, rdiv(Y, X), rdiv(Z, Y)) (peak)

Lemma 240: rdiv(X, L(Y, rdiv(Z, Y), rdiv(X, Z))) = op(rdiv(X, Z), rdiv(Z, Y)).
Proof:
  rdiv(X, L(Y, rdiv(Z, Y), rdiv(X, Z))) (peak)
= { by lemma 239 R->L }
  rdiv(X, ldiv(op(rdiv(X, Z), rdiv(Z, Y)), X)) (peak)
= { by lemma 94 }
  op(rdiv(X, Z), rdiv(Z, Y))

Lemma 241: ldiv(X, L(Y, ldiv(X, zero), X)) = op(ldiv(X, zero), Y).
Proof:
  ldiv(X, L(Y, ldiv(X, zero), X))
= { by lemma 222 R->L }
  ldiv(X, op(X, op(ldiv(X, zero), Y))) (peak)
= { by axiom 4 (sos) }
  op(ldiv(X, zero), Y)

Lemma 242: rdiv(ldiv(X, zero), K(Y, Z)) = ldiv(X, K(Z, Y)).
Proof:
  rdiv(ldiv(X, zero), K(Y, Z))
= { by lemma 64 R->L }
  op(ldiv(X, zero), K(Z, Y))
= { by lemma 241 R->L }
  ldiv(X, L(K(Z, Y), ldiv(X, zero), X)) (peak)
= { by lemma 69 }
  ldiv(X, K(Z, Y))

Lemma 243: L(X, rdiv(K(Y, Z), W), V) = L(X, rdiv(zero, W), V).
Proof:
  L(X, rdiv(K(Y, Z), W), V)
= { by lemma 193 R->L }
  L(X, ldiv(W, K(Y, Z)), V)
= { by lemma 242 R->L }
  L(X, rdiv(ldiv(W, zero), K(Z, Y)), V) (peak)
= { by lemma 189 }
  L(X, ldiv(W, zero), V)
= { by lemma 193 }
  L(X, rdiv(zero, W), V)

Lemma 244: ldiv(op(X, rdiv(zero, Y)), X) = L(Y, rdiv(zero, Y), X).
Proof:
  ldiv(op(X, rdiv(zero, Y)), X) (peak)
= { by lemma 137 R->L }
  L(ldiv(rdiv(zero, Y), zero), rdiv(zero, Y), X) (peak)
= { by lemma 32 }
  L(Y, rdiv(zero, Y), X)

Lemma 245: rdiv(X, L(Y, rdiv(zero, Y), X)) = op(X, rdiv(zero, Y)).
Proof:
  rdiv(X, L(Y, rdiv(zero, Y), X)) (peak)
= { by lemma 244 R->L }
  rdiv(X, ldiv(op(X, rdiv(zero, Y)), X)) (peak)
= { by lemma 94 }
  op(X, rdiv(zero, Y))

Lemma 246: rdiv(op(X, rdiv(K(Y, Z), W)), K(Y, Z)) = op(X, rdiv(zero, W)).
Proof:
  rdiv(op(X, rdiv(K(Y, Z), W)), K(Y, Z))
= { by lemma 165 R->L }
  op(rdiv(X, K(Y, Z)), rdiv(K(Y, Z), W))
= { by lemma 240 R->L }
  rdiv(X, L(W, rdiv(K(Y, Z), W), rdiv(X, K(Y, Z)))) (peak)
= { by lemma 220 }
  rdiv(X, L(W, rdiv(K(Y, Z), W), X))
= { by lemma 243 }
  rdiv(X, L(W, rdiv(zero, W), X))
= { by lemma 245 }
  op(X, rdiv(zero, W))

Lemma 247: op(rdiv(op(Z, X), Z), Y) = op(X, op(Y, K(Z, X))).
Proof:
  op(rdiv(op(Z, X), Z), Y) (peak)
= { by lemma 44 R->L }
  op(op(X, K(Z, X)), Y) (peak)
= { by lemma 38 }
  op(K(Z, X), op(X, Y))
= { by lemma 39 }
  op(X, op(Y, K(Z, X)))

Lemma 248: rdiv(op(T(X, Y), Z), K(X, Y)) = op(X, Z).
Proof:
  rdiv(op(T(X, Y), Z), K(X, Y))
= { by lemma 121 R->L }
  rdiv(op(T(X, Y), Z), K(T(X, Y), Y))
= { by lemma 110 R->L }
  op(T(X, Y), rdiv(Z, K(T(X, Y), Y)))
= { by lemma 64 R->L }
  op(T(X, Y), op(Z, K(Y, T(X, Y)))) (peak)
= { by lemma 247 R->L }
  op(rdiv(op(Y, T(X, Y)), Y), Z)
= { by lemma 65 }
  op(rdiv(op(X, Y), Y), Z)
= { by axiom 3 (sos) }
  op(X, Z)

Lemma 249: op(T(X, Y), rdiv(zero, Z)) = op(X, rdiv(K(X, Y), Z)).
Proof:
  op(T(X, Y), rdiv(zero, Z))
= { by lemma 246 R->L }
  rdiv(op(T(X, Y), rdiv(K(X, Y), Z)), K(X, Y)) (peak)
= { by lemma 248 }
  op(X, rdiv(K(X, Y), Z))

Lemma 250: rdiv(op(X, op(Y, Z)), op(Z, Y)) = rdiv(X, K(Z, Y)).
Proof:
  rdiv(op(X, op(Y, Z)), op(Z, Y))
= { by lemma 51 R->L }
  rdiv(op(X, T(op(Y, Z), K(Z, Y))), op(Z, Y))
= { by axiom 17 (sos) }
  rdiv(op(X, T(op(Y, Z), K(Z, Y))), op(op(Y, Z), K(Z, Y))) (peak)
= { by lemma 173 }
  R(rdiv(X, K(Z, Y)), K(Z, Y), T(op(Y, Z), K(Z, Y)))
= { by lemma 78 }
  rdiv(X, K(Z, Y))

Lemma 251: ldiv(X, op(T(X, Y), Z)) = rdiv(Z, K(Y, X)).
Proof:
  ldiv(X, op(T(X, Y), Z))
= { by lemma 78 R->L }
  ldiv(R(X, K(X, Y), Z), op(T(X, Y), Z))
= { by lemma 42 R->L }
  ldiv(R(X, K(X, Y), Z), op(op(X, K(X, Y)), Z)) (peak)
= { by lemma 79 }
  op(K(X, Y), Z)
= { by lemma 63 }
  rdiv(Z, K(Y, X))

Lemma 252: rdiv(X, op(ldiv(Y, X), Y)) = K(Y, ldiv(Y, X)).
Proof:
  rdiv(X, op(ldiv(Y, X), Y))
= { by axiom 8 (sos) R->L }
  rdiv(op(Y, ldiv(Y, X)), op(ldiv(Y, X), Y)) (peak)
= { by lemma 57 }
  K(Y, ldiv(Y, X))

Lemma 253: rdiv(op(Y, Z), op(ldiv(X, Y), Z)) = R(X, ldiv(X, Y), Z).
Proof:
  rdiv(op(Y, Z), op(ldiv(X, Y), Z))
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, ldiv(X, Y)), Z), op(ldiv(X, Y), Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(X, ldiv(X, Y), Z)

Lemma 254: R(X, ldiv(X, Y), rdiv(Z, ldiv(X, Y))) = rdiv(op(Y, ldiv(ldiv(X, Y), Z)), Z).
Proof:
  R(X, ldiv(X, Y), rdiv(Z, ldiv(X, Y)))
= { by lemma 216 R->L }
  R(X, ldiv(X, Y), ldiv(ldiv(X, Y), Z))
= { by lemma 253 R->L }
  rdiv(op(Y, ldiv(ldiv(X, Y), Z)), op(ldiv(X, Y), ldiv(ldiv(X, Y), Z))) (peak)
= { by axiom 8 (sos) }
  rdiv(op(Y, ldiv(ldiv(X, Y), Z)), Z)

Lemma 255: rdiv(op(X, T(Y, rdiv(X, Y))), X) = R(Y, ldiv(Y, X), Y).
Proof:
  rdiv(op(X, T(Y, rdiv(X, Y))), X) (peak)
= { by lemma 93 R->L }
  rdiv(op(X, ldiv(ldiv(Y, X), X)), X) (peak)
= { by lemma 254 R->L }
  R(Y, ldiv(Y, X), rdiv(X, ldiv(Y, X))) (peak)
= { by lemma 94 }
  R(Y, ldiv(Y, X), Y)

Lemma 256: ldiv(op(ldiv(X, Y), X), Y) = K(X, rdiv(Y, X)).
Proof:
  ldiv(op(ldiv(X, Y), X), Y)
= { by axiom 8 (sos) R->L }
  ldiv(op(ldiv(X, Y), X), op(X, ldiv(X, Y))) (peak)
= { by lemma 66 }
  K(X, ldiv(X, Y))
= { by lemma 117 }
  K(X, rdiv(Y, X))

Lemma 257: rdiv(op(X, op(ldiv(Y, X), Y)), X) = op(ldiv(Y, X), Y).
Proof:
  rdiv(op(X, op(ldiv(Y, X), Y)), X)
= { by lemma 51 R->L }
  rdiv(op(X, T(op(ldiv(Y, X), Y), K(Y, ldiv(Y, X)))), X)
= { by lemma 252 R->L }
  rdiv(op(X, T(op(ldiv(Y, X), Y), rdiv(X, op(ldiv(Y, X), Y)))), X) (peak)
= { by lemma 255 }
  R(op(ldiv(Y, X), Y), ldiv(op(ldiv(Y, X), Y), X), op(ldiv(Y, X), Y)) (peak)
= { by lemma 256 }
  R(op(ldiv(Y, X), Y), K(Y, rdiv(X, Y)), op(ldiv(Y, X), Y))
= { by lemma 78 }
  op(ldiv(Y, X), Y)

Lemma 258: op(T(X, Y), T(Z, X)) = op(Z, T(X, Y)).
Proof:
  op(T(X, Y), T(Z, X))
= { by lemma 206 R->L }
  rdiv(op(T(X, Y), Z), K(X, Z))
= { by lemma 250 R->L }
  rdiv(op(op(T(X, Y), Z), op(Z, X)), op(X, Z))
= { by lemma 248 R->L }
  rdiv(op(op(T(X, Y), Z), op(Z, X)), rdiv(op(T(X, Y), Z), K(X, Y)))
= { by lemma 146 R->L }
  rdiv(rdiv(op(op(T(X, Y), Z), op(Z, X)), K(Y, X)), op(T(X, Y), Z))
= { by lemma 110 R->L }
  rdiv(op(op(T(X, Y), Z), rdiv(op(Z, X), K(Y, X))), op(T(X, Y), Z))
= { by lemma 165 R->L }
  rdiv(op(op(T(X, Y), Z), op(rdiv(Z, K(Y, X)), X)), op(T(X, Y), Z))
= { by lemma 251 R->L }
  rdiv(op(op(T(X, Y), Z), op(ldiv(X, op(T(X, Y), Z)), X)), op(T(X, Y), Z)) (peak)
= { by lemma 257 }
  op(ldiv(X, op(T(X, Y), Z)), X)
= { by lemma 251 }
  op(rdiv(Z, K(Y, X)), X)
= { by lemma 165 }
  rdiv(op(Z, X), K(Y, X))
= { by lemma 206 }
  op(Z, T(X, Y))

Lemma 259: T(X, rdiv(K(Y, Z), W)) = T(X, rdiv(zero, W)).
Proof:
  T(X, rdiv(K(Y, Z), W))
= { by lemma 85 R->L }
  T(X, ldiv(W, K(Y, Z)))
= { by lemma 242 R->L }
  T(X, rdiv(ldiv(W, zero), K(Z, Y))) (peak)
= { by lemma 82 }
  T(X, ldiv(W, zero))
= { by lemma 85 }
  T(X, rdiv(zero, W))

Lemma 260: K(X, rdiv(K(Y, Z), W)) = K(X, rdiv(zero, W)).
Proof:
  K(X, rdiv(K(Y, Z), W))
= { by lemma 91 R->L }
  ldiv(X, T(X, rdiv(K(Y, Z), W))) (peak)
= { by lemma 259 }
  ldiv(X, T(X, rdiv(zero, W)))
= { by lemma 91 }
  K(X, rdiv(zero, W))

Lemma 261: op(rdiv(K(X, Y), Z), X) = op(rdiv(zero, Z), T(X, Y)).
Proof:
  op(rdiv(K(X, Y), Z), X)
= { by lemma 36 R->L }
  rdiv(op(X, rdiv(K(X, Y), Z)), K(X, rdiv(K(X, Y), Z))) (peak)
= { by lemma 249 R->L }
  rdiv(op(T(X, Y), rdiv(zero, Z)), K(X, rdiv(K(X, Y), Z))) (peak)
= { by lemma 260 }
  rdiv(op(T(X, Y), rdiv(zero, Z)), K(X, rdiv(zero, Z)))
= { by lemma 206 }
  op(T(X, Y), T(rdiv(zero, Z), X))
= { by lemma 258 }
  op(rdiv(zero, Z), T(X, Y))

Lemma 262: ldiv(X, op(Y, rdiv(X, Y))) = K(Y, rdiv(X, Y)).
Proof:
  ldiv(X, op(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(X, Y), Y), op(Y, rdiv(X, Y))) (peak)
= { by lemma 66 }
  K(Y, rdiv(X, Y))

Lemma 263: ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) = op(Y, Z).
Proof:
  ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) (peak)
= { by lemma 45 R->L }
  ldiv(rdiv(op(X, Z), op(Y, Z)), op(X, Z)) (peak)
= { by lemma 32 }
  op(Y, Z)

Lemma 264: ldiv(rdiv(X, Y), T(X, Z)) = rdiv(Y, K(Z, X)).
Proof:
  ldiv(rdiv(X, Y), T(X, Z))
= { by lemma 105 R->L }
  ldiv(R(rdiv(X, Y), Y, K(X, Z)), T(X, Z))
= { by lemma 42 R->L }
  ldiv(R(rdiv(X, Y), Y, K(X, Z)), op(X, K(X, Z))) (peak)
= { by lemma 263 }
  op(Y, K(X, Z))
= { by lemma 64 }
  rdiv(Y, K(Z, X))

Lemma 265: ldiv(T(X, Y), op(X, Y)) = T(Y, X).
Proof:
  ldiv(T(X, Y), op(X, Y))
= { by lemma 65 R->L }
  ldiv(T(X, Y), op(Y, T(X, Y))) (peak)
= { by axiom 5 (sos) R->L }
  T(Y, T(X, Y))
= { by lemma 84 }
  T(Y, X)

Lemma 266: ldiv(T(X, Y), op(X, Z)) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(T(X, Y), op(X, Z))
= { by lemma 42 R->L }
  ldiv(op(X, K(X, Y)), op(X, Z))
= { by lemma 74 }
  L(ldiv(K(X, Y), Z), K(X, Y), X) (peak)
= { by lemma 226 }
  ldiv(K(X, Y), Z)
= { by lemma 52 }
  rdiv(Z, K(X, Y))

Lemma 267: T(rdiv(X, K(X, Y)), op(Y, X)) = L(X, Y, rdiv(X, K(X, Y))).
Proof:
  T(rdiv(X, K(X, Y)), op(Y, X)) (peak)
= { by lemma 102 R->L }
  T(rdiv(op(Y, X), Y), op(Y, X))
= { by axiom 5 (sos) }
  ldiv(op(Y, X), op(rdiv(op(Y, X), Y), op(Y, X))) (peak)
= { by lemma 219 }
  L(X, Y, rdiv(op(Y, X), Y))
= { by lemma 102 }
  L(X, Y, rdiv(X, K(X, Y)))

Lemma 268: L(op(X, Y), K(Y, X), op(X, Y)) = T(op(X, Y), op(Y, X)).
Proof:
  L(op(X, Y), K(Y, X), op(X, Y))
= { by lemma 27 R->L }
  L(op(X, Y), K(Y, X), rdiv(op(X, Y), zero))
= { by lemma 24 R->L }
  L(op(X, Y), K(Y, X), rdiv(op(X, Y), 1))
= { by axiom 6 (sos) R->L }
  L(op(X, Y), K(Y, X), rdiv(op(X, Y), K(op(X, Y), K(Y, X))))
= { by lemma 267 R->L }
  T(rdiv(op(X, Y), K(op(X, Y), K(Y, X))), op(K(Y, X), op(X, Y))) (peak)
= { by lemma 40 }
  T(rdiv(op(X, Y), K(op(X, Y), K(Y, X))), op(Y, X))
= { by axiom 6 (sos) }
  T(rdiv(op(X, Y), 1), op(Y, X))
= { by lemma 24 }
  T(rdiv(op(X, Y), zero), op(Y, X))
= { by lemma 27 }
  T(op(X, Y), op(Y, X))

Lemma 269: rdiv(X, K(X, rdiv(Y, X))) = rdiv(Y, rdiv(Y, X)).
Proof:
  rdiv(X, K(X, rdiv(Y, X)))
= { by lemma 28 R->L }
  T(rdiv(X, K(X, rdiv(Y, X))), rdiv(X, K(X, rdiv(Y, X))))
= { by lemma 63 R->L }
  T(rdiv(X, K(X, rdiv(Y, X))), op(K(rdiv(Y, X), X), X))
= { by lemma 64 R->L }
  T(op(X, K(rdiv(Y, X), X)), op(K(rdiv(Y, X), X), X))
= { by lemma 268 R->L }
  L(op(X, K(rdiv(Y, X), X)), K(K(rdiv(Y, X), X), X), op(X, K(rdiv(Y, X), X))) (peak)
= { by lemma 191 }
  L(rdiv(Y, rdiv(Y, X)), K(K(rdiv(Y, X), X), X), op(X, K(rdiv(Y, X), X))) (peak)
= { by axiom 7 (sos) }
  L(rdiv(Y, rdiv(Y, X)), 1, op(X, K(rdiv(Y, X), X)))
= { by lemma 24 }
  L(rdiv(Y, rdiv(Y, X)), zero, op(X, K(rdiv(Y, X), X)))
= { by lemma 31 }
  rdiv(Y, rdiv(Y, X))

Lemma 270: T(X, rdiv(Y, rdiv(Y, Z))) = T(X, Z).
Proof:
  T(X, rdiv(Y, rdiv(Y, Z))) (peak)
= { by lemma 269 R->L }
  T(X, rdiv(Z, K(Z, rdiv(Y, Z)))) (peak)
= { by lemma 82 }
  T(X, Z)

Lemma 271: rdiv(X, rdiv(X, T(Y, Z))) = T(rdiv(X, rdiv(X, Y)), Z).
Proof:
  rdiv(X, rdiv(X, T(Y, Z)))
= { by lemma 97 R->L }
  rdiv(X, rdiv(X, rdiv(Y, K(Z, Y))))
= { by lemma 188 R->L }
  rdiv(X, rdiv(rdiv(X, Y), K(Y, Z)))
= { by lemma 188 R->L }
  rdiv(rdiv(X, rdiv(X, Y)), K(Z, Y))
= { by lemma 266 R->L }
  ldiv(T(Z, Y), op(Z, rdiv(X, rdiv(X, Y))))
= { by lemma 270 R->L }
  ldiv(T(Z, rdiv(X, rdiv(X, Y))), op(Z, rdiv(X, rdiv(X, Y)))) (peak)
= { by lemma 265 }
  T(rdiv(X, rdiv(X, Y)), Z)

Lemma 272: rdiv(op(X, Y), L(Z, rdiv(Y, Z), X)) = op(X, rdiv(Y, Z)).
Proof:
  rdiv(op(X, Y), L(Z, rdiv(Y, Z), X)) (peak)
= { by lemma 238 R->L }
  rdiv(op(X, Y), ldiv(op(X, rdiv(Y, Z)), op(X, Y))) (peak)
= { by lemma 94 }
  op(X, rdiv(Y, Z))

Lemma 273: rdiv(X, rdiv(Y, K(X, Z))) = rdiv(T(X, Z), Y).
Proof:
  rdiv(X, rdiv(Y, K(X, Z)))
= { by lemma 188 R->L }
  rdiv(rdiv(X, Y), K(Z, X))
= { by lemma 63 R->L }
  op(K(X, Z), rdiv(X, Y))
= { by lemma 272 R->L }
  rdiv(op(K(X, Z), X), L(Y, rdiv(X, Y), K(X, Z))) (peak)
= { by lemma 89 }
  rdiv(T(X, Z), L(Y, rdiv(X, Y), K(X, Z)))
= { by lemma 81 }
  rdiv(T(X, Z), Y)

Lemma 274: rdiv(X, K(Y, rdiv(X, Y))) = op(ldiv(Y, X), Y).
Proof:
  rdiv(X, K(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  rdiv(op(rdiv(X, Y), Y), K(Y, rdiv(X, Y))) (peak)
= { by lemma 144 }
  op(T(rdiv(X, Y), Y), Y)
= { by lemma 50 }
  op(ldiv(Y, X), Y)

Lemma 275: rdiv(ldiv(X, Y), K(X, Z)) = ldiv(T(X, Z), Y).
Proof:
  rdiv(ldiv(X, Y), K(X, Z))
= { by lemma 52 R->L }
  ldiv(K(X, Z), ldiv(X, Y))
= { by lemma 226 R->L }
  L(ldiv(K(X, Z), ldiv(X, Y)), K(X, Z), X) (peak)
= { by lemma 155 }
  ldiv(op(X, K(X, Z)), Y)
= { by lemma 42 }
  ldiv(T(X, Z), Y)

Lemma 276: rdiv(ldiv(X, Y), K(Z, Y)) = ldiv(X, T(Y, Z)).
Proof:
  rdiv(ldiv(X, Y), K(Z, Y))
= { by lemma 264 R->L }
  ldiv(rdiv(Y, ldiv(X, Y)), T(Y, Z)) (peak)
= { by lemma 94 }
  ldiv(X, T(Y, Z))

Lemma 277: rdiv(T(X, Y), K(Z, W)) = T(rdiv(X, K(Z, W)), Y).
Proof:
  rdiv(T(X, Y), K(Z, W))
= { by axiom 5 (sos) }
  rdiv(ldiv(Y, op(X, Y)), K(Z, W))
= { by lemma 158 R->L }
  ldiv(Y, rdiv(op(X, Y), K(Z, W)))
= { by lemma 156 R->L }
  ldiv(rdiv(Y, K(W, Z)), op(X, Y))
= { by lemma 50 R->L }
  T(rdiv(op(X, Y), rdiv(Y, K(W, Z))), rdiv(Y, K(W, Z))) (peak)
= { by lemma 218 }
  T(rdiv(X, K(Z, W)), rdiv(Y, K(W, Z)))
= { by lemma 82 }
  T(rdiv(X, K(Z, W)), Y)

Lemma 278: rdiv(op(Z, X), op(Y, T(Z, X))) = R(rdiv(X, Y), Y, T(Z, X)).
Proof:
  rdiv(op(Z, X), op(Y, T(Z, X)))
= { by lemma 65 R->L }
  rdiv(op(X, T(Z, X)), op(Y, T(Z, X))) (peak)
= { by lemma 45 }
  R(rdiv(X, Y), Y, T(Z, X)) (peak)

Lemma 279: rdiv(op(X, Y), rdiv(Z, K(Y, X))) = rdiv(op(Y, X), Z).
Proof:
  rdiv(op(X, Y), rdiv(Z, K(Y, X)))
= { by lemma 64 R->L }
  rdiv(op(X, Y), op(Z, K(X, Y)))
= { by lemma 68 R->L }
  rdiv(op(X, Y), op(Z, T(K(X, Y), op(Y, X))))
= { by lemma 40 R->L }
  rdiv(op(K(X, Y), op(Y, X)), op(Z, T(K(X, Y), op(Y, X)))) (peak)
= { by lemma 278 }
  R(rdiv(op(Y, X), Z), Z, T(K(X, Y), op(Y, X))) (peak)
= { by lemma 68 }
  R(rdiv(op(Y, X), Z), Z, K(X, Y))
= { by lemma 105 }
  rdiv(op(Y, X), Z)

Lemma 280: rdiv(op(X, rdiv(Y, X)), X) = rdiv(Y, rdiv(Y, rdiv(Y, X))).
Proof:
  rdiv(op(X, rdiv(Y, X)), X)
= { by lemma 279 R->L }
  rdiv(op(rdiv(Y, X), X), rdiv(X, K(X, rdiv(Y, X)))) (peak)
= { by lemma 269 }
  rdiv(op(rdiv(Y, X), X), rdiv(Y, rdiv(Y, X))) (peak)
= { by axiom 9 (sos) }
  rdiv(Y, rdiv(Y, rdiv(Y, X)))

Lemma 281: rdiv(op(X, Y), K(rdiv(X, Z), Z)) = op(op(Z, rdiv(X, Z)), Y).
Proof:
  rdiv(op(X, Y), K(rdiv(X, Z), Z))
= { by lemma 110 R->L }
  op(X, rdiv(Y, K(rdiv(X, Z), Z)))
= { by lemma 63 R->L }
  op(X, op(K(Z, rdiv(X, Z)), Y))
= { by lemma 111 R->L }
  rdiv(op(op(X, K(Z, rdiv(X, Z))), Y), a(X, K(Z, rdiv(X, Z)), Y)) (peak)
= { by lemma 48 }
  rdiv(op(op(Z, rdiv(X, Z)), Y), a(X, K(Z, rdiv(X, Z)), Y))
= { by axiom 12 (sos) }
  rdiv(op(op(Z, rdiv(X, Z)), Y), 1)
= { by lemma 24 }
  rdiv(op(op(Z, rdiv(X, Z)), Y), zero)
= { by lemma 27 }
  op(op(Z, rdiv(X, Z)), Y)

Lemma 282: L(T(X, rdiv(Y, Z)), rdiv(Y, Z), Z) = ldiv(Y, op(Z, op(X, ldiv(Z, Y)))).
Proof:
  L(T(X, rdiv(Y, Z)), rdiv(Y, Z), Z)
= { by lemma 85 R->L }
  L(T(X, ldiv(Z, Y)), rdiv(Y, Z), Z)
= { by lemma 193 R->L }
  L(T(X, ldiv(Z, Y)), ldiv(Z, Y), Z)
= { by lemma 187 R->L }
  ldiv(Y, op(Z, op(ldiv(Z, Y), T(X, ldiv(Z, Y))))) (peak)
= { by lemma 65 }
  ldiv(Y, op(Z, op(X, ldiv(Z, Y))))

Lemma 283: T(X, op(Y, op(Z, rdiv(W, Z)))) = T(X, op(Y, W)).
Proof:
  T(X, op(Y, op(Z, rdiv(W, Z)))) (peak)
= { by lemma 115 R->L }
  T(X, op(op(Z, rdiv(W, Z)), Y))
= { by lemma 81 R->L }
  L(T(X, op(op(Z, rdiv(W, Z)), Y)), op(W, Y), K(rdiv(W, Z), Z))
= { by lemma 189 R->L }
  L(T(X, op(op(Z, rdiv(W, Z)), Y)), rdiv(op(W, Y), K(rdiv(W, Z), Z)), K(rdiv(W, Z), Z))
= { by lemma 281 R->L }
  L(T(X, rdiv(op(W, Y), K(rdiv(W, Z), Z))), rdiv(op(W, Y), K(rdiv(W, Z), Z)), K(rdiv(W, Z), Z)) (peak)
= { by lemma 282 }
  ldiv(op(W, Y), op(K(rdiv(W, Z), Z), op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y)))))
= { by lemma 63 }
  ldiv(op(W, Y), rdiv(op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y))), K(Z, rdiv(W, Z))))
= { by lemma 158 }
  rdiv(ldiv(op(W, Y), op(X, ldiv(K(rdiv(W, Z), Z), op(W, Y)))), K(Z, rdiv(W, Z)))
= { by lemma 52 }
  rdiv(ldiv(op(W, Y), op(X, rdiv(op(W, Y), K(rdiv(W, Z), Z)))), K(Z, rdiv(W, Z)))
= { by lemma 110 }
  rdiv(ldiv(op(W, Y), rdiv(op(X, op(W, Y)), K(rdiv(W, Z), Z))), K(Z, rdiv(W, Z)))
= { by lemma 158 }
  rdiv(rdiv(ldiv(op(W, Y), op(X, op(W, Y))), K(rdiv(W, Z), Z)), K(Z, rdiv(W, Z)))
= { by lemma 146 }
  rdiv(ldiv(op(W, Y), op(X, op(W, Y))), rdiv(K(Z, rdiv(W, Z)), K(Z, rdiv(W, Z))))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, op(W, Y)), rdiv(K(Z, rdiv(W, Z)), K(Z, rdiv(W, Z))))
= { by lemma 26 }
  rdiv(T(X, op(W, Y)), zero)
= { by lemma 27 }
  T(X, op(W, Y))
= { by lemma 115 }
  T(X, op(Y, W))

Lemma 284: T(X, op(Y, T(Z, W))) = T(X, op(Y, Z)).
Proof:
  T(X, op(Y, T(Z, W))) (peak)
= { by lemma 115 R->L }
  T(X, op(T(Z, W), Y))
= { by lemma 144 R->L }
  T(X, rdiv(op(Z, Y), K(W, Z))) (peak)
= { by lemma 82 }
  T(X, op(Z, Y))
= { by lemma 115 }
  T(X, op(Y, Z))

Lemma 285: T(X, op(Y, ldiv(Z, W))) = T(X, op(Y, rdiv(W, Z))).
Proof:
  T(X, op(Y, ldiv(Z, W)))
= { by lemma 283 R->L }
  T(X, op(Y, op(K(rdiv(W, Z), Z), rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))))) (peak)
= { by lemma 163 }
  T(X, op(Y, op(K(rdiv(W, Z), Z), rdiv(W, Z))))
= { by lemma 89 }
  T(X, op(Y, T(rdiv(W, Z), Z)))
= { by lemma 284 }
  T(X, op(Y, rdiv(W, Z)))

Lemma 286: K(X, op(Y, ldiv(Z, W))) = K(X, op(Y, rdiv(W, Z))).
Proof:
  K(X, op(Y, ldiv(Z, W)))
= { by lemma 91 R->L }
  ldiv(X, T(X, op(Y, ldiv(Z, W)))) (peak)
= { by lemma 285 }
  ldiv(X, T(X, op(Y, rdiv(W, Z))))
= { by lemma 91 }
  K(X, op(Y, rdiv(W, Z)))

Lemma 287: K(X, op(Y, rdiv(Z, Y))) = K(X, Z).
Proof:
  K(X, op(Y, rdiv(Z, Y)))
= { by lemma 91 R->L }
  ldiv(X, T(X, op(Y, rdiv(Z, Y)))) (peak)
= { by lemma 208 }
  ldiv(X, T(X, Z))
= { by lemma 91 }
  K(X, Z)

Lemma 288: K(X, op(Y, K(X, Y))) = K(X, Y).
Proof:
  K(X, op(Y, K(X, Y))) (peak)
= { by lemma 44 }
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 67 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 69 }
  K(X, Y)

Lemma 289: T(X, op(Y, op(W, Z))) = T(X, op(Y, op(Z, W))).
Proof:
  T(X, op(Y, op(W, Z)))
= { by lemma 113 R->L }
  T(X, rdiv(op(Y, op(Z, W)), K(Z, W))) (peak)
= { by lemma 82 }
  T(X, op(Y, op(Z, W)))

Lemma 290: rdiv(op(X, Y), a(Z, rdiv(X, Z), Y)) = op(Z, op(ldiv(Z, X), Y)).
Proof:
  rdiv(op(X, Y), a(Z, rdiv(X, Z), Y))
= { by lemma 167 R->L }
  rdiv(op(X, Y), a(Z, ldiv(Z, X), Y))
= { by axiom 8 (sos) R->L }
  rdiv(op(op(Z, ldiv(Z, X)), Y), a(Z, ldiv(Z, X), Y)) (peak)
= { by lemma 111 }
  op(Z, op(ldiv(Z, X), Y))

Lemma 291: op(X, rdiv(Y, a(Z, W, V))) = rdiv(op(X, Y), a(Z, W, V)).
Proof:
  op(X, rdiv(Y, a(Z, W, V)))
= { by lemma 179 R->L }
  rdiv(op(X, op(rdiv(Y, a(Z, W, V)), a(Z, W, V))), a(Z, W, V)) (peak)
= { by axiom 9 (sos) }
  rdiv(op(X, Y), a(Z, W, V))

Lemma 292: T(X, op(Y, op(Z, ldiv(Y, W)))) = T(X, op(Z, W)).
Proof:
  T(X, op(Y, op(Z, ldiv(Y, W)))) (peak)
= { by lemma 289 }
  T(X, op(Y, op(ldiv(Y, W), Z)))
= { by lemma 197 R->L }
  L(T(X, op(Y, op(ldiv(Y, W), Z))), rdiv(op(W, Z), a(Y, rdiv(W, Y), Z)), a(Y, rdiv(W, Y), Z))
= { by lemma 290 R->L }
  L(T(X, rdiv(op(W, Z), a(Y, rdiv(W, Y), Z))), rdiv(op(W, Z), a(Y, rdiv(W, Y), Z)), a(Y, rdiv(W, Y), Z)) (peak)
= { by lemma 282 }
  ldiv(op(W, Z), op(a(Y, rdiv(W, Y), Z), op(X, ldiv(a(Y, rdiv(W, Y), Z), op(W, Z)))))
= { by lemma 136 }
  ldiv(op(W, Z), op(a(Y, rdiv(W, Y), Z), op(X, rdiv(op(W, Z), a(Y, rdiv(W, Y), Z)))))
= { by lemma 291 }
  ldiv(op(W, Z), op(a(Y, rdiv(W, Y), Z), rdiv(op(X, op(W, Z)), a(Y, rdiv(W, Y), Z))))
= { by lemma 135 }
  ldiv(op(W, Z), op(X, op(W, Z)))
= { by axiom 5 (sos) R->L }
  T(X, op(W, Z))
= { by lemma 115 }
  T(X, op(Z, W))

Lemma 293: T(X, op(Y, rdiv(Z, ldiv(W, Y)))) = T(X, op(Z, W)).
Proof:
  T(X, op(Y, rdiv(Z, ldiv(W, Y))))
= { by lemma 115 R->L }
  T(X, op(rdiv(Z, ldiv(W, Y)), Y))
= { by lemma 292 R->L }
  T(X, op(W, op(rdiv(Z, ldiv(W, Y)), ldiv(W, Y)))) (peak)
= { by axiom 9 (sos) }
  T(X, op(W, Z))
= { by lemma 115 }
  T(X, op(Z, W))

Lemma 294: T(X, op(Y, rdiv(Z, W))) = T(X, op(Z, rdiv(Y, W))).
Proof:
  T(X, op(Y, rdiv(Z, W)))
= { by lemma 293 R->L }
  T(X, op(Z, rdiv(Y, ldiv(rdiv(Z, W), Z)))) (peak)
= { by lemma 32 }
  T(X, op(Z, rdiv(Y, W)))

Lemma 295: K(X, op(Z, rdiv(Y, W))) = K(X, op(Y, rdiv(Z, W))).
Proof:
  K(X, op(Z, rdiv(Y, W)))
= { by lemma 91 R->L }
  ldiv(X, T(X, op(Z, rdiv(Y, W)))) (peak)
= { by lemma 294 R->L }
  ldiv(X, T(X, op(Y, rdiv(Z, W)))) (peak)
= { by lemma 91 }
  K(X, op(Y, rdiv(Z, W)))

Lemma 296: K(X, op(rdiv(Y, Z), W)) = K(X, op(Y, rdiv(W, Z))).
Proof:
  K(X, op(rdiv(Y, Z), W)) (peak)
= { by lemma 116 }
  K(X, op(W, rdiv(Y, Z))) (peak)
= { by lemma 295 R->L }
  K(X, op(Y, rdiv(W, Z))) (peak)

Lemma 297: op(op(X, Y), ldiv(op(Y, X), Z)) = rdiv(Z, K(Y, X)).
Proof:
  op(op(X, Y), ldiv(op(Y, X), Z))
= { by lemma 112 R->L }
  rdiv(op(op(Y, X), ldiv(op(Y, X), Z)), K(Y, X)) (peak)
= { by axiom 8 (sos) }
  rdiv(Z, K(Y, X))

Lemma 298: rdiv(ldiv(op(X, Y), Z), K(Y, X)) = ldiv(op(Y, X), Z).
Proof:
  rdiv(ldiv(op(X, Y), Z), K(Y, X))
= { by lemma 158 R->L }
  ldiv(op(X, Y), rdiv(Z, K(Y, X)))
= { by lemma 297 R->L }
  ldiv(op(X, Y), op(op(X, Y), ldiv(op(Y, X), Z))) (peak)
= { by axiom 4 (sos) }
  ldiv(op(Y, X), Z)

Lemma 299: T(X, rdiv(Y, op(W, Z))) = T(X, rdiv(Y, op(Z, W))).
Proof:
  T(X, rdiv(Y, op(W, Z)))
= { by lemma 85 R->L }
  T(X, ldiv(op(W, Z), Y))
= { by lemma 81 R->L }
  L(T(X, ldiv(op(W, Z), Y)), rdiv(Y, op(Z, W)), K(W, Z))
= { by lemma 193 R->L }
  L(T(X, ldiv(op(W, Z), Y)), ldiv(op(Z, W), Y), K(W, Z))
= { by lemma 189 R->L }
  L(T(X, ldiv(op(W, Z), Y)), rdiv(ldiv(op(Z, W), Y), K(W, Z)), K(W, Z))
= { by lemma 298 R->L }
  L(T(X, rdiv(ldiv(op(Z, W), Y), K(W, Z))), rdiv(ldiv(op(Z, W), Y), K(W, Z)), K(W, Z)) (peak)
= { by lemma 282 }
  ldiv(ldiv(op(Z, W), Y), op(K(W, Z), op(X, ldiv(K(W, Z), ldiv(op(Z, W), Y)))))
= { by lemma 63 }
  ldiv(ldiv(op(Z, W), Y), rdiv(op(X, ldiv(K(W, Z), ldiv(op(Z, W), Y))), K(Z, W)))
= { by lemma 158 }
  rdiv(ldiv(ldiv(op(Z, W), Y), op(X, ldiv(K(W, Z), ldiv(op(Z, W), Y)))), K(Z, W))
= { by lemma 52 }
  rdiv(ldiv(ldiv(op(Z, W), Y), op(X, rdiv(ldiv(op(Z, W), Y), K(W, Z)))), K(Z, W))
= { by lemma 110 }
  rdiv(ldiv(ldiv(op(Z, W), Y), rdiv(op(X, ldiv(op(Z, W), Y)), K(W, Z))), K(Z, W))
= { by lemma 158 }
  rdiv(rdiv(ldiv(ldiv(op(Z, W), Y), op(X, ldiv(op(Z, W), Y))), K(W, Z)), K(Z, W))
= { by lemma 146 }
  rdiv(ldiv(ldiv(op(Z, W), Y), op(X, ldiv(op(Z, W), Y))), rdiv(K(Z, W), K(Z, W)))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, ldiv(op(Z, W), Y)), rdiv(K(Z, W), K(Z, W)))
= { by lemma 85 }
  rdiv(T(X, rdiv(Y, op(Z, W))), rdiv(K(Z, W), K(Z, W)))
= { by lemma 26 }
  rdiv(T(X, rdiv(Y, op(Z, W))), zero)
= { by lemma 27 }
  T(X, rdiv(Y, op(Z, W)))

Lemma 300: K(X, rdiv(Y, op(W, Z))) = K(X, rdiv(Y, op(Z, W))).
Proof:
  K(X, rdiv(Y, op(W, Z)))
= { by lemma 91 R->L }
  ldiv(X, T(X, rdiv(Y, op(W, Z)))) (peak)
= { by lemma 299 }
  ldiv(X, T(X, rdiv(Y, op(Z, W)))) (peak)
= { by lemma 91 }
  K(X, rdiv(Y, op(Z, W)))

Lemma 301: ldiv(op(X, rdiv(Y, X)), op(Y, Z)) = rdiv(Z, K(X, rdiv(Y, X))).
Proof:
  ldiv(op(X, rdiv(Y, X)), op(Y, Z))
= { by lemma 78 R->L }
  ldiv(R(op(X, rdiv(Y, X)), K(rdiv(Y, X), X), Z), op(Y, Z))
= { by lemma 160 R->L }
  ldiv(R(rdiv(Y, K(rdiv(Y, X), X)), K(rdiv(Y, X), X), Z), op(Y, Z)) (peak)
= { by lemma 263 }
  op(K(rdiv(Y, X), X), Z)
= { by lemma 63 }
  rdiv(Z, K(X, rdiv(Y, X)))

Lemma 302: rdiv(ldiv(X, Y), K(Z, rdiv(X, Z))) = ldiv(op(Z, rdiv(X, Z)), Y).
Proof:
  rdiv(ldiv(X, Y), K(Z, rdiv(X, Z)))
= { by lemma 301 R->L }
  ldiv(op(Z, rdiv(X, Z)), op(X, ldiv(X, Y))) (peak)
= { by axiom 8 (sos) }
  ldiv(op(Z, rdiv(X, Z)), Y)

Lemma 303: T(X, rdiv(Y, op(Z, rdiv(W, Z)))) = T(X, rdiv(Y, W)).
Proof:
  T(X, rdiv(Y, op(Z, rdiv(W, Z))))
= { by lemma 85 R->L }
  T(X, ldiv(op(Z, rdiv(W, Z)), Y))
= { by lemma 81 R->L }
  L(T(X, ldiv(op(Z, rdiv(W, Z)), Y)), rdiv(Y, W), K(Z, rdiv(W, Z)))
= { by lemma 193 R->L }
  L(T(X, ldiv(op(Z, rdiv(W, Z)), Y)), ldiv(W, Y), K(Z, rdiv(W, Z)))
= { by lemma 189 R->L }
  L(T(X, ldiv(op(Z, rdiv(W, Z)), Y)), rdiv(ldiv(W, Y), K(Z, rdiv(W, Z))), K(Z, rdiv(W, Z)))
= { by lemma 302 R->L }
  L(T(X, rdiv(ldiv(W, Y), K(Z, rdiv(W, Z)))), rdiv(ldiv(W, Y), K(Z, rdiv(W, Z))), K(Z, rdiv(W, Z))) (peak)
= { by lemma 282 }
  ldiv(ldiv(W, Y), op(K(Z, rdiv(W, Z)), op(X, ldiv(K(Z, rdiv(W, Z)), ldiv(W, Y)))))
= { by lemma 63 }
  ldiv(ldiv(W, Y), rdiv(op(X, ldiv(K(Z, rdiv(W, Z)), ldiv(W, Y))), K(rdiv(W, Z), Z)))
= { by lemma 158 }
  rdiv(ldiv(ldiv(W, Y), op(X, ldiv(K(Z, rdiv(W, Z)), ldiv(W, Y)))), K(rdiv(W, Z), Z))
= { by lemma 52 }
  rdiv(ldiv(ldiv(W, Y), op(X, rdiv(ldiv(W, Y), K(Z, rdiv(W, Z))))), K(rdiv(W, Z), Z))
= { by lemma 110 }
  rdiv(ldiv(ldiv(W, Y), rdiv(op(X, ldiv(W, Y)), K(Z, rdiv(W, Z)))), K(rdiv(W, Z), Z))
= { by lemma 158 }
  rdiv(rdiv(ldiv(ldiv(W, Y), op(X, ldiv(W, Y))), K(Z, rdiv(W, Z))), K(rdiv(W, Z), Z))
= { by lemma 146 }
  rdiv(ldiv(ldiv(W, Y), op(X, ldiv(W, Y))), rdiv(K(rdiv(W, Z), Z), K(rdiv(W, Z), Z)))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, ldiv(W, Y)), rdiv(K(rdiv(W, Z), Z), K(rdiv(W, Z), Z)))
= { by lemma 85 }
  rdiv(T(X, rdiv(Y, W)), rdiv(K(rdiv(W, Z), Z), K(rdiv(W, Z), Z)))
= { by lemma 214 }
  rdiv(T(X, rdiv(Y, W)), rdiv(T(rdiv(W, Z), Z), T(rdiv(W, Z), Z)))
= { by lemma 26 }
  rdiv(T(X, rdiv(Y, W)), zero)
= { by lemma 27 }
  T(X, rdiv(Y, W))

Lemma 304: T(X, rdiv(Y, T(Z, W))) = T(X, rdiv(Y, Z)).
Proof:
  T(X, rdiv(Y, T(Z, W)))
= { by lemma 82 R->L }
  T(X, rdiv(rdiv(Y, T(Z, W)), K(W, Z)))
= { by lemma 63 R->L }
  T(X, op(K(Z, W), rdiv(Y, T(Z, W))))
= { by lemma 285 R->L }
  T(X, op(K(Z, W), ldiv(T(Z, W), Y)))
= { by lemma 275 R->L }
  T(X, op(K(Z, W), rdiv(ldiv(Z, Y), K(Z, W)))) (peak)
= { by lemma 208 }
  T(X, ldiv(Z, Y))
= { by lemma 85 }
  T(X, rdiv(Y, Z))

Lemma 305: T(X, rdiv(Y, ldiv(Z, W))) = T(X, rdiv(Y, rdiv(W, Z))).
Proof:
  T(X, rdiv(Y, ldiv(Z, W)))
= { by lemma 303 R->L }
  T(X, rdiv(Y, op(K(rdiv(W, Z), Z), rdiv(ldiv(Z, W), K(rdiv(W, Z), Z))))) (peak)
= { by lemma 163 }
  T(X, rdiv(Y, op(K(rdiv(W, Z), Z), rdiv(W, Z))))
= { by lemma 89 }
  T(X, rdiv(Y, T(rdiv(W, Z), Z)))
= { by lemma 304 }
  T(X, rdiv(Y, rdiv(W, Z)))

Lemma 306: K(X, rdiv(Y, ldiv(Z, W))) = K(X, rdiv(Y, rdiv(W, Z))).
Proof:
  K(X, rdiv(Y, ldiv(Z, W)))
= { by lemma 91 R->L }
  ldiv(X, T(X, rdiv(Y, ldiv(Z, W)))) (peak)
= { by lemma 305 }
  ldiv(X, T(X, rdiv(Y, rdiv(W, Z))))
= { by lemma 91 }
  K(X, rdiv(Y, rdiv(W, Z)))

Lemma 307: ldiv(R(X, ldiv(X, Y), Z), op(Y, Z)) = op(ldiv(X, Y), Z).
Proof:
  ldiv(R(X, ldiv(X, Y), Z), op(Y, Z)) (peak)
= { by lemma 253 R->L }
  ldiv(rdiv(op(Y, Z), op(ldiv(X, Y), Z)), op(Y, Z)) (peak)
= { by lemma 32 }
  op(ldiv(X, Y), Z)

Lemma 308: rdiv(ldiv(X, op(Y, Z)), K(Y, Z)) = ldiv(X, op(Z, Y)).
Proof:
  rdiv(ldiv(X, op(Y, Z)), K(Y, Z))
= { by lemma 64 R->L }
  op(ldiv(X, op(Y, Z)), K(Z, Y))
= { by lemma 307 R->L }
  ldiv(R(X, ldiv(X, op(Y, Z)), K(Z, Y)), op(op(Y, Z), K(Z, Y))) (peak)
= { by axiom 17 (sos) R->L }
  ldiv(R(X, ldiv(X, op(Y, Z)), K(Z, Y)), op(Z, Y))
= { by lemma 105 }
  ldiv(X, op(Z, Y))

Lemma 309: T(X, rdiv(op(Z, Y), W)) = T(X, rdiv(op(Y, Z), W)).
Proof:
  T(X, rdiv(op(Z, Y), W))
= { by lemma 85 R->L }
  T(X, ldiv(W, op(Z, Y)))
= { by lemma 81 R->L }
  L(T(X, ldiv(W, op(Z, Y))), rdiv(op(Y, Z), W), K(Y, Z))
= { by lemma 193 R->L }
  L(T(X, ldiv(W, op(Z, Y))), ldiv(W, op(Y, Z)), K(Y, Z))
= { by lemma 189 R->L }
  L(T(X, ldiv(W, op(Z, Y))), rdiv(ldiv(W, op(Y, Z)), K(Y, Z)), K(Y, Z))
= { by lemma 308 R->L }
  L(T(X, rdiv(ldiv(W, op(Y, Z)), K(Y, Z))), rdiv(ldiv(W, op(Y, Z)), K(Y, Z)), K(Y, Z)) (peak)
= { by lemma 282 }
  ldiv(ldiv(W, op(Y, Z)), op(K(Y, Z), op(X, ldiv(K(Y, Z), ldiv(W, op(Y, Z))))))
= { by lemma 63 }
  ldiv(ldiv(W, op(Y, Z)), rdiv(op(X, ldiv(K(Y, Z), ldiv(W, op(Y, Z)))), K(Z, Y)))
= { by lemma 158 }
  rdiv(ldiv(ldiv(W, op(Y, Z)), op(X, ldiv(K(Y, Z), ldiv(W, op(Y, Z))))), K(Z, Y))
= { by lemma 52 }
  rdiv(ldiv(ldiv(W, op(Y, Z)), op(X, rdiv(ldiv(W, op(Y, Z)), K(Y, Z)))), K(Z, Y))
= { by lemma 110 }
  rdiv(ldiv(ldiv(W, op(Y, Z)), rdiv(op(X, ldiv(W, op(Y, Z))), K(Y, Z))), K(Z, Y))
= { by lemma 158 }
  rdiv(rdiv(ldiv(ldiv(W, op(Y, Z)), op(X, ldiv(W, op(Y, Z)))), K(Y, Z)), K(Z, Y))
= { by lemma 146 }
  rdiv(ldiv(ldiv(W, op(Y, Z)), op(X, ldiv(W, op(Y, Z)))), rdiv(K(Z, Y), K(Z, Y)))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, ldiv(W, op(Y, Z))), rdiv(K(Z, Y), K(Z, Y)))
= { by lemma 85 }
  rdiv(T(X, rdiv(op(Y, Z), W)), rdiv(K(Z, Y), K(Z, Y)))
= { by lemma 26 }
  rdiv(T(X, rdiv(op(Y, Z), W)), zero)
= { by lemma 27 }
  T(X, rdiv(op(Y, Z), W))

Lemma 310: K(X, rdiv(op(Z, Y), W)) = K(X, rdiv(op(Y, Z), W)).
Proof:
  K(X, rdiv(op(Z, Y), W))
= { by lemma 91 R->L }
  ldiv(X, T(X, rdiv(op(Z, Y), W))) (peak)
= { by lemma 309 }
  ldiv(X, T(X, rdiv(op(Y, Z), W))) (peak)
= { by lemma 91 }
  K(X, rdiv(op(Y, Z), W))

Lemma 311: K(X, rdiv(rdiv(Y, Z), W)) = K(X, rdiv(Y, op(Z, W))).
Proof:
  K(X, rdiv(rdiv(Y, Z), W))
= { by lemma 181 R->L }
  K(X, R(rdiv(rdiv(Y, Z), W), W, Z)) (peak)
= { by lemma 145 }
  K(X, rdiv(Y, op(W, Z)))
= { by lemma 300 R->L }
  K(X, rdiv(Y, op(Z, W)))

Lemma 312: K(X, rdiv(T(Y, Z), W)) = K(X, rdiv(Y, W)).
Proof:
  K(X, rdiv(T(Y, Z), W))
= { by lemma 229 R->L }
  K(X, rdiv(rdiv(T(Y, Z), W), K(Y, Z)))
= { by lemma 63 R->L }
  K(X, op(K(Z, Y), rdiv(T(Y, Z), W)))
= { by lemma 286 R->L }
  K(X, op(K(Z, Y), ldiv(W, T(Y, Z))))
= { by lemma 276 R->L }
  K(X, op(K(Z, Y), rdiv(ldiv(W, Y), K(Z, Y)))) (peak)
= { by lemma 287 }
  K(X, ldiv(W, Y))
= { by lemma 119 }
  K(X, rdiv(Y, W))

Lemma 313: K(op(X, ldiv(Y, Z)), W) = K(op(X, rdiv(Z, Y)), W).
Proof:
  K(op(X, ldiv(Y, Z)), W)
= { by lemma 71 R->L }
  K(op(X, ldiv(Y, Z)), T(W, op(X, ldiv(Y, Z)))) (peak)
= { by lemma 73 }
  ldiv(T(W, op(X, ldiv(Y, Z))), W) (peak)
= { by lemma 285 }
  ldiv(T(W, op(X, rdiv(Z, Y))), W)
= { by lemma 86 }
  K(op(X, rdiv(Z, Y)), W)

Lemma 314: K(op(X, rdiv(Y, X)), Z) = K(Y, Z).
Proof:
  K(op(X, rdiv(Y, X)), Z)
= { by lemma 71 R->L }
  K(op(X, rdiv(Y, X)), T(Z, op(X, rdiv(Y, X)))) (peak)
= { by lemma 73 }
  ldiv(T(Z, op(X, rdiv(Y, X))), Z) (peak)
= { by lemma 208 }
  ldiv(T(Z, Y), Z)
= { by lemma 86 }
  K(Y, Z)

Lemma 315: L(ldiv(X, Y), X, rdiv(Z, X)) = ldiv(Z, op(rdiv(Z, X), Y)).
Proof:
  L(ldiv(X, Y), X, rdiv(Z, X))
= { by lemma 74 R->L }
  ldiv(op(rdiv(Z, X), X), op(rdiv(Z, X), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(Z, op(rdiv(Z, X), Y))

Lemma 316: L(ldiv(X, zero), X, rdiv(Y, X)) = ldiv(Y, rdiv(Y, X)).
Proof:
  L(ldiv(X, zero), X, rdiv(Y, X)) (peak)
= { by lemma 315 }
  ldiv(Y, op(rdiv(Y, X), zero)) (peak)
= { by axiom 1 (sos) }
  ldiv(Y, rdiv(Y, X))

Lemma 317: ldiv(op(T(X, Y), Z), op(X, Z)) = K(Y, X).
Proof:
  ldiv(op(T(X, Y), Z), op(X, Z))
= { by lemma 248 R->L }
  ldiv(op(T(X, Y), Z), rdiv(op(T(X, Y), Z), K(X, Y))) (peak)
= { by lemma 316 R->L }
  L(ldiv(K(X, Y), zero), K(X, Y), rdiv(op(T(X, Y), Z), K(X, Y))) (peak)
= { by lemma 226 }
  ldiv(K(X, Y), zero)
= { by lemma 52 }
  rdiv(zero, K(X, Y))
= { by lemma 58 }
  K(Y, X)

Lemma 318: K(op(Y, rdiv(X, Z)), W) = K(op(X, rdiv(Y, Z)), W).
Proof:
  K(op(Y, rdiv(X, Z)), W)
= { by lemma 317 R->L }
  ldiv(op(T(W, op(Y, rdiv(X, Z))), V), op(W, V)) (peak)
= { by lemma 294 R->L }
  ldiv(op(T(W, op(X, rdiv(Y, Z))), V), op(W, V)) (peak)
= { by lemma 317 }
  K(op(X, rdiv(Y, Z)), W)

Lemma 319: K(op(rdiv(X, Y), Z), W) = K(op(X, rdiv(Z, Y)), W).
Proof:
  K(op(rdiv(X, Y), Z), W) (peak)
= { by lemma 120 }
  K(op(Z, rdiv(X, Y)), W) (peak)
= { by lemma 318 R->L }
  K(op(X, rdiv(Z, Y)), W) (peak)

Lemma 320: K(rdiv(X, op(Z, Y)), W) = K(rdiv(X, op(Y, Z)), W).
Proof:
  K(rdiv(X, op(Z, Y)), W)
= { by lemma 86 R->L }
  ldiv(T(W, rdiv(X, op(Z, Y))), W) (peak)
= { by lemma 299 }
  ldiv(T(W, rdiv(X, op(Y, Z))), W) (peak)
= { by lemma 73 R->L }
  K(rdiv(X, op(Y, Z)), T(W, rdiv(X, op(Y, Z)))) (peak)
= { by lemma 71 }
  K(rdiv(X, op(Y, Z)), W)

Lemma 321: K(rdiv(X, ldiv(Y, Z)), W) = K(rdiv(X, rdiv(Z, Y)), W).
Proof:
  K(rdiv(X, ldiv(Y, Z)), W)
= { by lemma 317 R->L }
  ldiv(op(T(W, rdiv(X, ldiv(Y, Z))), V), op(W, V)) (peak)
= { by lemma 305 }
  ldiv(op(T(W, rdiv(X, rdiv(Z, Y))), V), op(W, V))
= { by lemma 317 }
  K(rdiv(X, rdiv(Z, Y)), W)

Lemma 322: K(rdiv(X, K(Y, Z)), W) = K(X, W).
Proof:
  K(rdiv(X, K(Y, Z)), W)
= { by lemma 71 R->L }
  K(rdiv(X, K(Y, Z)), T(W, rdiv(X, K(Y, Z)))) (peak)
= { by lemma 73 }
  ldiv(T(W, rdiv(X, K(Y, Z))), W) (peak)
= { by lemma 82 }
  ldiv(T(W, X), W)
= { by lemma 86 }
  K(X, W)

Lemma 323: K(rdiv(X, T(Y, Z)), W) = K(rdiv(X, Y), W).
Proof:
  K(rdiv(X, T(Y, Z)), W)
= { by lemma 322 R->L }
  K(rdiv(rdiv(X, T(Y, Z)), K(Z, Y)), W)
= { by lemma 63 R->L }
  K(op(K(Y, Z), rdiv(X, T(Y, Z))), W)
= { by lemma 313 R->L }
  K(op(K(Y, Z), ldiv(T(Y, Z), X)), W)
= { by lemma 275 R->L }
  K(op(K(Y, Z), rdiv(ldiv(Y, X), K(Y, Z))), W) (peak)
= { by lemma 314 }
  K(ldiv(Y, X), W)
= { by lemma 87 }
  K(rdiv(X, Y), W)

Lemma 324: K(rdiv(op(Y, X), Z), W) = K(rdiv(op(X, Y), Z), W).
Proof:
  K(rdiv(op(Y, X), Z), W)
= { by lemma 86 R->L }
  ldiv(T(W, rdiv(op(Y, X), Z)), W) (peak)
= { by lemma 309 }
  ldiv(T(W, rdiv(op(X, Y), Z)), W) (peak)
= { by lemma 73 R->L }
  K(rdiv(op(X, Y), Z), T(W, rdiv(op(X, Y), Z))) (peak)
= { by lemma 71 }
  K(rdiv(op(X, Y), Z), W)

Lemma 325: K(rdiv(rdiv(X, Y), Z), W) = K(rdiv(X, op(Y, Z)), W).
Proof:
  K(rdiv(rdiv(X, Y), Z), W)
= { by lemma 184 R->L }
  K(R(rdiv(rdiv(X, Y), Z), Z, Y), W) (peak)
= { by lemma 145 }
  K(rdiv(X, op(Z, Y)), W)
= { by lemma 320 R->L }
  K(rdiv(X, op(Y, Z)), W)

Lemma 326: K(rdiv(T(X, Y), Z), W) = K(rdiv(X, Z), W).
Proof:
  K(rdiv(T(X, Y), Z), W)
= { by lemma 322 R->L }
  K(rdiv(rdiv(T(X, Y), Z), K(X, Y)), W)
= { by lemma 63 R->L }
  K(op(K(Y, X), rdiv(T(X, Y), Z)), W)
= { by lemma 313 R->L }
  K(op(K(Y, X), ldiv(Z, T(X, Y))), W)
= { by lemma 276 R->L }
  K(op(K(Y, X), rdiv(ldiv(Z, X), K(Y, X))), W) (peak)
= { by lemma 314 }
  K(ldiv(Z, X), W)
= { by lemma 87 }
  K(rdiv(X, Z), W)

Lemma 327: L(ldiv(X, Y), X, rdiv(Z, Y)) = ldiv(op(rdiv(Z, Y), X), Z).
Proof:
  L(ldiv(X, Y), X, rdiv(Z, Y)) (peak)
= { by lemma 74 R->L }
  ldiv(op(rdiv(Z, Y), X), op(rdiv(Z, Y), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(op(rdiv(Z, Y), X), Z)

Lemma 328: rdiv(X, L(ldiv(Y, Z), Y, rdiv(X, Z))) = op(rdiv(X, Z), Y).
Proof:
  rdiv(X, L(ldiv(Y, Z), Y, rdiv(X, Z))) (peak)
= { by lemma 327 }
  rdiv(X, ldiv(op(rdiv(X, Z), Y), X)) (peak)
= { by lemma 94 }
  op(rdiv(X, Z), Y)

Lemma 329: L(X, Y, rdiv(R(Z, W, V), Z)) = X.
Proof:
  L(X, Y, rdiv(R(Z, W, V), Z))
= { by lemma 221 R->L }
  L(X, Y, ldiv(Z, R(Z, W, V))) (peak)
= { by lemma 129 }
  L(X, Y, a(Z, W, V))
= { by lemma 198 }
  X

Lemma 330: op(rdiv(R(X, Y, Z), X), W) = rdiv(R(X, Y, Z), ldiv(W, X)).
Proof:
  op(rdiv(R(X, Y, Z), X), W)
= { by lemma 328 R->L }
  rdiv(R(X, Y, Z), L(ldiv(W, X), W, rdiv(R(X, Y, Z), X))) (peak)
= { by lemma 329 }
  rdiv(R(X, Y, Z), ldiv(W, X))

Lemma 331: R(rdiv(X, K(X, Y)), Y, X) = rdiv(X, K(X, op(X, Y))).
Proof:
  R(rdiv(X, K(X, Y)), Y, X) (peak)
= { by lemma 102 R->L }
  R(rdiv(op(Y, X), Y), Y, X) (peak)
= { by lemma 45 R->L }
  rdiv(op(op(Y, X), X), op(Y, X)) (peak)
= { by lemma 44 R->L }
  op(X, K(op(Y, X), X))
= { by lemma 64 }
  rdiv(X, K(X, op(Y, X)))
= { by lemma 116 R->L }
  rdiv(X, K(X, op(X, Y)))

Lemma 332: T(op(L(X, Y, X), Y), X) = op(Y, X).
Proof:
  T(op(L(X, Y, X), Y), X)
= { by lemma 235 R->L }
  T(op(Y, T(X, op(Y, X))), X) (peak)
= { by lemma 115 R->L }
  T(op(Y, T(X, op(X, Y))), X)
= { by lemma 206 R->L }
  T(rdiv(op(Y, X), K(op(X, Y), X)), X)
= { by lemma 107 R->L }
  T(rdiv(op(T(Y, X), T(X, Y)), K(op(X, Y), X)), X)
= { by lemma 109 R->L }
  T(rdiv(op(rdiv(X, K(X, Y)), Y), K(op(X, Y), X)), X)
= { by lemma 277 R->L }
  rdiv(T(op(rdiv(X, K(X, Y)), Y), X), K(op(X, Y), X))
= { by axiom 5 (sos) }
  rdiv(ldiv(X, op(op(rdiv(X, K(X, Y)), Y), X)), K(op(X, Y), X))
= { by lemma 158 R->L }
  ldiv(X, rdiv(op(op(rdiv(X, K(X, Y)), Y), X), K(op(X, Y), X)))
= { by lemma 156 R->L }
  ldiv(rdiv(X, K(X, op(X, Y))), op(op(rdiv(X, K(X, Y)), Y), X))
= { by lemma 331 R->L }
  ldiv(R(rdiv(X, K(X, Y)), Y, X), op(op(rdiv(X, K(X, Y)), Y), X)) (peak)
= { by lemma 79 }
  op(Y, X)

Lemma 333: rdiv(R(X, Y, rdiv(zero, Y)), ldiv(Y, zero)) = op(X, Y).
Proof:
  rdiv(R(X, Y, rdiv(zero, Y)), ldiv(Y, zero))
= { by lemma 209 R->L }
  rdiv(R(X, Y, ldiv(Y, zero)), ldiv(Y, zero))
= { by lemma 205 R->L }
  rdiv(op(op(X, Y), ldiv(Y, zero)), ldiv(Y, zero)) (peak)
= { by axiom 3 (sos) }
  op(X, Y)

Lemma 334: R(X, rdiv(R(Y, Z, W), Y), V) = X.
Proof:
  R(X, rdiv(R(Y, Z, W), Y), V)
= { by lemma 210 R->L }
  R(X, ldiv(Y, R(Y, Z, W)), V) (peak)
= { by lemma 129 }
  R(X, a(Y, Z, W), V)
= { by lemma 149 }
  X

Lemma 335: ldiv(rdiv(R(X, Y, Z), X), zero) = ldiv(R(X, Y, Z), X).
Proof:
  ldiv(rdiv(R(X, Y, Z), X), zero)
= { by lemma 50 R->L }
  T(rdiv(zero, rdiv(R(X, Y, Z), X)), rdiv(R(X, Y, Z), X)) (peak)
= { by lemma 142 }
  T(ldiv(R(X, Y, Z), X), rdiv(R(X, Y, Z), X))
= { by lemma 133 }
  ldiv(R(X, Y, Z), X)

Lemma 336: op(X, rdiv(R(Y, Z, W), Y)) = rdiv(X, rdiv(Y, R(Y, Z, W))).
Proof:
  op(X, rdiv(R(Y, Z, W), Y))
= { by lemma 333 R->L }
  rdiv(R(X, rdiv(R(Y, Z, W), Y), rdiv(zero, rdiv(R(Y, Z, W), Y))), ldiv(rdiv(R(Y, Z, W), Y), zero)) (peak)
= { by lemma 334 }
  rdiv(X, ldiv(rdiv(R(Y, Z, W), Y), zero))
= { by lemma 335 }
  rdiv(X, ldiv(R(Y, Z, W), Y))
= { by lemma 152 }
  rdiv(X, rdiv(Y, R(Y, Z, W)))

Lemma 337: rdiv(R(Y, Z, W), ldiv(X, Y)) = rdiv(X, rdiv(Y, R(Y, Z, W))).
Proof:
  rdiv(R(Y, Z, W), ldiv(X, Y))
= { by lemma 330 R->L }
  op(rdiv(R(Y, Z, W), Y), X)
= { by lemma 133 R->L }
  T(op(rdiv(R(Y, Z, W), Y), X), rdiv(R(Y, Z, W), Y))
= { by lemma 329 R->L }
  T(op(L(rdiv(R(Y, Z, W), Y), X, rdiv(R(Y, Z, W), Y)), X), rdiv(R(Y, Z, W), Y)) (peak)
= { by lemma 332 }
  op(X, rdiv(R(Y, Z, W), Y))
= { by lemma 336 }
  rdiv(X, rdiv(Y, R(Y, Z, W)))

Lemma 338: op(rdiv(R(X, Y, Z), X), W) = ldiv(rdiv(X, R(X, Y, Z)), W).
Proof:
  op(rdiv(R(X, Y, Z), X), W)
= { by lemma 47 R->L }
  ldiv(R(rdiv(zero, rdiv(R(X, Y, Z), X)), rdiv(R(X, Y, Z), X), W), W) (peak)
= { by lemma 334 }
  ldiv(rdiv(zero, rdiv(R(X, Y, Z), X)), W)
= { by lemma 142 }
  ldiv(ldiv(R(X, Y, Z), X), W)
= { by lemma 152 }
  ldiv(rdiv(X, R(X, Y, Z)), W)

Lemma 339: rdiv(Z, op(ldiv(X, Y), ldiv(Y, Z))) = R(X, ldiv(X, Y), ldiv(Y, Z)).
Proof:
  rdiv(Z, op(ldiv(X, Y), ldiv(Y, Z)))
= { by axiom 8 (sos) R->L }
  rdiv(op(Y, ldiv(Y, Z)), op(ldiv(X, Y), ldiv(Y, Z))) (peak)
= { by lemma 253 }
  R(X, ldiv(X, Y), ldiv(Y, Z)) (peak)

Lemma 340: ldiv(R(X, rdiv(Y, X), ldiv(Y, Z)), Z) = op(ldiv(X, Y), ldiv(Y, Z)).
Proof:
  ldiv(R(X, rdiv(Y, X), ldiv(Y, Z)), Z)
= { by lemma 210 R->L }
  ldiv(R(X, ldiv(X, Y), ldiv(Y, Z)), Z) (peak)
= { by lemma 339 R->L }
  ldiv(rdiv(Z, op(ldiv(X, Y), ldiv(Y, Z))), Z) (peak)
= { by lemma 32 }
  op(ldiv(X, Y), ldiv(Y, Z))

Lemma 341: ldiv(R(X, rdiv(Y, X), Z), op(Y, Z)) = op(ldiv(X, Y), Z).
Proof:
  ldiv(R(X, rdiv(Y, X), Z), op(Y, Z))
= { by axiom 4 (sos) R->L }
  ldiv(R(X, rdiv(Y, X), ldiv(Y, op(Y, Z))), op(Y, Z)) (peak)
= { by lemma 340 }
  op(ldiv(X, Y), ldiv(Y, op(Y, Z)))
= { by axiom 4 (sos) }
  op(ldiv(X, Y), Z)

Lemma 342: ldiv(rdiv(X, R(X, Y, Z)), W) = ldiv(X, op(R(X, Y, Z), W)).
Proof:
  ldiv(rdiv(X, R(X, Y, Z)), W)
= { by lemma 338 R->L }
  op(rdiv(R(X, Y, Z), X), W)
= { by lemma 134 R->L }
  op(ldiv(X, R(X, Y, Z)), W)
= { by lemma 341 R->L }
  ldiv(R(X, rdiv(R(X, Y, Z), X), W), op(R(X, Y, Z), W)) (peak)
= { by lemma 334 }
  ldiv(X, op(R(X, Y, Z), W))

Lemma 343: R(X, Y, rdiv(R(Z, W, V), Z)) = X.
Proof:
  R(X, Y, rdiv(R(Z, W, V), Z))
= { by lemma 216 R->L }
  R(X, Y, ldiv(Z, R(Z, W, V))) (peak)
= { by lemma 129 }
  R(X, Y, a(Z, W, V))
= { by lemma 174 }
  X

Lemma 344: ldiv(X, op(op(Y, rdiv(X, Z)), Z)) = T(R(Y, rdiv(X, Z), Z), X).
Proof:
  ldiv(X, op(op(Y, rdiv(X, Z)), Z))
= { by lemma 50 R->L }
  T(rdiv(op(op(Y, rdiv(X, Z)), Z), X), X) (peak)
= { by lemma 104 }
  T(R(Y, rdiv(X, Z), Z), X)

Lemma 345: ldiv(X, op(op(ldiv(Y, X), Y), Z)) = rdiv(Z, K(Y, rdiv(X, Y))).
Proof:
  ldiv(X, op(op(ldiv(Y, X), Y), Z))
= { by lemma 78 R->L }
  ldiv(R(X, K(ldiv(Y, X), Y), Z), op(op(ldiv(Y, X), Y), Z))
= { by lemma 33 R->L }
  ldiv(R(X, K(ldiv(Y, X), Y), Z), op(op(X, K(ldiv(Y, X), Y)), Z)) (peak)
= { by lemma 79 }
  op(K(ldiv(Y, X), Y), Z)
= { by lemma 63 }
  rdiv(Z, K(Y, ldiv(Y, X)))
= { by lemma 117 }
  rdiv(Z, K(Y, rdiv(X, Y)))

Lemma 346: K(rdiv(X, Y), rdiv(X, rdiv(X, Y))) = K(rdiv(X, Y), Y).
Proof:
  K(rdiv(X, Y), rdiv(X, rdiv(X, Y))) (peak)
= { by lemma 191 R->L }
  K(rdiv(X, Y), op(Y, K(rdiv(X, Y), Y))) (peak)
= { by lemma 288 }
  K(rdiv(X, Y), Y)

Lemma 347: T(R(X, rdiv(Y, X), X), Y) = T(X, rdiv(Y, X)).
Proof:
  T(R(X, rdiv(Y, X), X), Y)
= { by lemma 32 R->L }
  T(R(ldiv(rdiv(Y, X), Y), rdiv(Y, X), X), Y)
= { by lemma 344 R->L }
  ldiv(Y, op(op(ldiv(rdiv(Y, X), Y), rdiv(Y, X)), X)) (peak)
= { by lemma 345 }
  rdiv(X, K(rdiv(Y, X), rdiv(Y, rdiv(Y, X))))
= { by lemma 346 }
  rdiv(X, K(rdiv(Y, X), X))
= { by lemma 97 }
  T(X, rdiv(Y, X))

Lemma 348: op(R(X, rdiv(Y, X), X), Y) = op(Y, T(X, rdiv(Y, X))).
Proof:
  op(R(X, rdiv(Y, X), X), Y)
= { by lemma 65 R->L }
  op(Y, T(R(X, rdiv(Y, X), X), Y)) (peak)
= { by lemma 347 }
  op(Y, T(X, rdiv(Y, X)))

Lemma 349: T(rdiv(R(X, Y, Z), X), W) = rdiv(R(X, Y, Z), X).
Proof:
  T(rdiv(R(X, Y, Z), X), W)
= { by lemma 134 R->L }
  T(ldiv(X, R(X, Y, Z)), W) (peak)
= { by lemma 129 }
  T(a(X, Y, Z), W)
= { by lemma 143 }
  a(X, Y, Z)
= { by lemma 129 R->L }
  ldiv(X, R(X, Y, Z))
= { by lemma 134 }
  rdiv(R(X, Y, Z), X)

Lemma 350: ldiv(X, op(R(X, Y, Z), W)) = rdiv(W, rdiv(X, R(X, Y, Z))).
Proof:
  ldiv(X, op(R(X, Y, Z), W))
= { by lemma 342 R->L }
  ldiv(rdiv(X, R(X, Y, Z)), W)
= { by lemma 338 R->L }
  op(rdiv(R(X, Y, Z), X), W)
= { by lemma 343 R->L }
  op(R(rdiv(R(X, Y, Z), X), rdiv(W, rdiv(R(X, Y, Z), X)), rdiv(R(X, Y, Z), X)), W) (peak)
= { by lemma 348 }
  op(W, T(rdiv(R(X, Y, Z), X), rdiv(W, rdiv(R(X, Y, Z), X))))
= { by lemma 349 }
  op(W, rdiv(R(X, Y, Z), X))
= { by lemma 336 }
  rdiv(W, rdiv(X, R(X, Y, Z)))

Lemma 351: L(T(Y, rdiv(Z, Y)), rdiv(Z, Y), X) = ldiv(op(X, ldiv(Y, Z)), op(X, Z)).
Proof:
  L(T(Y, rdiv(Z, Y)), rdiv(Z, Y), X)
= { by lemma 85 R->L }
  L(T(Y, ldiv(Y, Z)), rdiv(Z, Y), X)
= { by lemma 193 R->L }
  L(T(Y, ldiv(Y, Z)), ldiv(Y, Z), X) (peak)
= { by lemma 92 R->L }
  L(ldiv(ldiv(Y, Z), Z), ldiv(Y, Z), X) (peak)
= { by lemma 74 R->L }
  ldiv(op(X, ldiv(Y, Z)), op(X, Z)) (peak)

Lemma 352: L(T(X, rdiv(zero, X)), rdiv(zero, X), Y) = ldiv(op(Y, ldiv(X, zero)), Y).
Proof:
  L(T(X, rdiv(zero, X)), rdiv(zero, X), Y) (peak)
= { by lemma 351 }
  ldiv(op(Y, ldiv(X, zero)), op(Y, zero)) (peak)
= { by axiom 1 (sos) }
  ldiv(op(Y, ldiv(X, zero)), Y)

Lemma 353: rdiv(X, rdiv(X, a(Y, Z, W))) = a(Y, Z, W).
Proof:
  rdiv(X, rdiv(X, a(Y, Z, W)))
= { by lemma 135 R->L }
  rdiv(op(a(Y, Z, W), rdiv(X, a(Y, Z, W))), rdiv(X, a(Y, Z, W))) (peak)
= { by axiom 3 (sos) }
  a(Y, Z, W)

Lemma 354: L(X, rdiv(zero, rdiv(zero, Y)), Z) = L(X, Y, Z).
Proof:
  L(X, rdiv(zero, rdiv(zero, Y)), Z)
= { by lemma 225 R->L }
  L(X, L(Y, rdiv(zero, Y), Y), Z)
= { by lemma 224 R->L }
  L(X, rdiv(Y, K(Y, rdiv(zero, Y))), Z) (peak)
= { by lemma 189 }
  L(X, Y, Z)

Lemma 355: ldiv(op(X, a(Y, Z, W)), X) = rdiv(Y, R(Y, Z, W)).
Proof:
  ldiv(op(X, a(Y, Z, W)), X)
= { by lemma 32 R->L }
  ldiv(op(X, ldiv(rdiv(zero, a(Y, Z, W)), zero)), X) (peak)
= { by lemma 352 R->L }
  L(T(rdiv(zero, a(Y, Z, W)), rdiv(zero, rdiv(zero, a(Y, Z, W)))), rdiv(zero, rdiv(zero, a(Y, Z, W))), X) (peak)
= { by lemma 353 }
  L(T(rdiv(zero, a(Y, Z, W)), a(Y, Z, W)), rdiv(zero, rdiv(zero, a(Y, Z, W))), X)
= { by lemma 354 }
  L(T(rdiv(zero, a(Y, Z, W)), a(Y, Z, W)), a(Y, Z, W), X)
= { by lemma 140 }
  T(rdiv(zero, a(Y, Z, W)), a(Y, Z, W))
= { by lemma 50 }
  ldiv(a(Y, Z, W), zero)
= { by lemma 136 }
  rdiv(zero, a(Y, Z, W))
= { by lemma 151 }
  rdiv(Y, R(Y, Z, W))

Lemma 356: ldiv(op(X, a(Y, Z, W)), X) = rdiv(zero, a(Y, Z, W)).
Proof:
  ldiv(op(X, a(Y, Z, W)), X)
= { by lemma 32 R->L }
  ldiv(op(X, ldiv(rdiv(zero, a(Y, Z, W)), zero)), X) (peak)
= { by lemma 352 R->L }
  L(T(rdiv(zero, a(Y, Z, W)), rdiv(zero, rdiv(zero, a(Y, Z, W)))), rdiv(zero, rdiv(zero, a(Y, Z, W))), X) (peak)
= { by lemma 353 }
  L(T(rdiv(zero, a(Y, Z, W)), a(Y, Z, W)), rdiv(zero, rdiv(zero, a(Y, Z, W))), X)
= { by lemma 354 }
  L(T(rdiv(zero, a(Y, Z, W)), a(Y, Z, W)), a(Y, Z, W), X)
= { by lemma 140 }
  T(rdiv(zero, a(Y, Z, W)), a(Y, Z, W))
= { by lemma 50 }
  ldiv(a(Y, Z, W), zero)
= { by lemma 136 }
  rdiv(zero, a(Y, Z, W))

Lemma 357: op(ldiv(X, Y), a(Z, W, V)) = ldiv(X, op(Y, a(Z, W, V))).
Proof:
  op(ldiv(X, Y), a(Z, W, V))
= { by lemma 307 R->L }
  ldiv(R(X, ldiv(X, Y), a(Z, W, V)), op(Y, a(Z, W, V))) (peak)
= { by lemma 122 R->L }
  ldiv(R(X, ldiv(X, Y), a(Z, W, V)), op(a(Z, W, V), Y)) (peak)
= { by lemma 174 }
  ldiv(X, op(a(Z, W, V), Y))
= { by lemma 122 }
  ldiv(X, op(Y, a(Z, W, V)))

Lemma 358: rdiv(ldiv(X, op(Y, a(Z, W, V))), a(Z, W, V)) = ldiv(X, Y).
Proof:
  rdiv(ldiv(X, op(Y, a(Z, W, V))), a(Z, W, V))
= { by lemma 357 R->L }
  rdiv(op(ldiv(X, Y), a(Z, W, V)), a(Z, W, V)) (peak)
= { by axiom 3 (sos) }
  ldiv(X, Y)

Lemma 359: ldiv(X, rdiv(Y, a(Z, W, V))) = rdiv(ldiv(X, Y), a(Z, W, V)).
Proof:
  ldiv(X, rdiv(Y, a(Z, W, V)))
= { by lemma 358 R->L }
  rdiv(ldiv(X, op(rdiv(Y, a(Z, W, V)), a(Z, W, V))), a(Z, W, V)) (peak)
= { by axiom 9 (sos) }
  rdiv(ldiv(X, Y), a(Z, W, V))

Lemma 360: ldiv(X, op(R(X, Y, Z), W)) = op(W, a(X, Y, Z)).
Proof:
  ldiv(X, op(R(X, Y, Z), W))
= { by lemma 149 R->L }
  ldiv(R(X, a(X, Y, Z), W), op(R(X, Y, Z), W))
= { by lemma 128 R->L }
  ldiv(R(X, a(X, Y, Z), W), op(op(X, a(X, Y, Z)), W)) (peak)
= { by lemma 79 }
  op(a(X, Y, Z), W)
= { by lemma 122 }
  op(W, a(X, Y, Z))

Lemma 361: L(X, R(Y, Z, W), rdiv(Y, R(Y, Z, W))) = X.
Proof:
  L(X, R(Y, Z, W), rdiv(Y, R(Y, Z, W)))
= { by lemma 219 R->L }
  ldiv(Y, op(rdiv(Y, R(Y, Z, W)), op(R(Y, Z, W), X))) (peak)
= { by lemma 355 R->L }
  ldiv(Y, op(ldiv(op(V, a(Y, Z, W)), V), op(R(Y, Z, W), X))) (peak)
= { by lemma 356 }
  ldiv(Y, op(rdiv(zero, a(Y, Z, W)), op(R(Y, Z, W), X)))
= { by lemma 196 }
  ldiv(Y, rdiv(op(zero, op(R(Y, Z, W), X)), a(Y, Z, W)))
= { by lemma 359 }
  rdiv(ldiv(Y, op(zero, op(R(Y, Z, W), X))), a(Y, Z, W))
= { by axiom 2 (sos) }
  rdiv(ldiv(Y, op(R(Y, Z, W), X)), a(Y, Z, W))
= { by lemma 360 }
  rdiv(op(X, a(Y, Z, W)), a(Y, Z, W))
= { by lemma 175 }
  rdiv(X, rdiv(a(Y, Z, W), a(Y, Z, W)))
= { by lemma 26 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 362: ldiv(rdiv(zero, X), L(Y, X, rdiv(zero, X))) = op(X, Y).
Proof:
  ldiv(rdiv(zero, X), L(Y, X, rdiv(zero, X)))
= { by lemma 237 R->L }
  ldiv(rdiv(zero, X), op(rdiv(zero, X), op(X, Y))) (peak)
= { by axiom 4 (sos) }
  op(X, Y)

Lemma 363: ldiv(X, L(Y, rdiv(zero, X), X)) = op(ldiv(X, zero), Y).
Proof:
  ldiv(X, L(Y, rdiv(zero, X), X))
= { by lemma 94 R->L }
  ldiv(X, L(Y, rdiv(zero, X), rdiv(zero, ldiv(X, zero))))
= { by lemma 193 R->L }
  ldiv(X, L(Y, ldiv(X, zero), rdiv(zero, ldiv(X, zero))))
= { by lemma 94 R->L }
  ldiv(rdiv(zero, ldiv(X, zero)), L(Y, ldiv(X, zero), rdiv(zero, ldiv(X, zero)))) (peak)
= { by lemma 362 }
  op(ldiv(X, zero), Y)

Lemma 364: ldiv(rdiv(R(X, Y, Z), X), W) = rdiv(W, rdiv(R(X, Y, Z), X)).
Proof:
  ldiv(rdiv(R(X, Y, Z), X), W)
= { by lemma 134 R->L }
  ldiv(ldiv(X, R(X, Y, Z)), W) (peak)
= { by lemma 129 }
  ldiv(a(X, Y, Z), W)
= { by lemma 136 }
  rdiv(W, a(X, Y, Z))
= { by lemma 129 R->L }
  rdiv(W, ldiv(X, R(X, Y, Z)))
= { by lemma 134 }
  rdiv(W, rdiv(R(X, Y, Z), X))

Lemma 365: op(rdiv(X, R(X, Y, Z)), W) = rdiv(W, rdiv(R(X, Y, Z), X)).
Proof:
  op(rdiv(X, R(X, Y, Z)), W)
= { by lemma 152 R->L }
  op(ldiv(R(X, Y, Z), X), W)
= { by lemma 335 R->L }
  op(ldiv(rdiv(R(X, Y, Z), X), zero), W)
= { by lemma 363 R->L }
  ldiv(rdiv(R(X, Y, Z), X), L(W, rdiv(zero, rdiv(R(X, Y, Z), X)), rdiv(R(X, Y, Z), X))) (peak)
= { by lemma 329 }
  ldiv(rdiv(R(X, Y, Z), X), W)
= { by lemma 364 }
  rdiv(W, rdiv(R(X, Y, Z), X))

Lemma 366: K(X, rdiv(R(Y, Z, W), Y)) = zero.
Proof:
  K(X, rdiv(R(Y, Z, W), Y))
= { by lemma 119 R->L }
  K(X, ldiv(Y, R(Y, Z, W))) (peak)
= { by lemma 129 }
  K(X, a(Y, Z, W))
= { by lemma 170 }
  zero

Lemma 367: rdiv(R(X, Y, Z), rdiv(R(X, Y, Z), X)) = X.
Proof:
  rdiv(R(X, Y, Z), rdiv(R(X, Y, Z), X)) (peak)
= { by lemma 269 R->L }
  rdiv(X, K(X, rdiv(R(X, Y, Z), X))) (peak)
= { by lemma 366 }
  rdiv(X, zero)
= { by lemma 27 }
  X

Lemma 368: ldiv(R(X, Y, Z), rdiv(W, rdiv(X, R(X, Y, Z)))) = ldiv(X, W).
Proof:
  ldiv(R(X, Y, Z), rdiv(W, rdiv(X, R(X, Y, Z))))
= { by lemma 350 R->L }
  ldiv(R(X, Y, Z), ldiv(X, op(R(X, Y, Z), W)))
= { by lemma 342 R->L }
  ldiv(R(X, Y, Z), ldiv(rdiv(X, R(X, Y, Z)), W))
= { by lemma 361 R->L }
  L(ldiv(R(X, Y, Z), ldiv(rdiv(X, R(X, Y, Z)), W)), R(X, Y, Z), rdiv(X, R(X, Y, Z))) (peak)
= { by lemma 155 }
  ldiv(op(rdiv(X, R(X, Y, Z)), R(X, Y, Z)), W)
= { by lemma 365 }
  ldiv(rdiv(R(X, Y, Z), rdiv(R(X, Y, Z), X)), W)
= { by lemma 367 }
  ldiv(X, W)

Lemma 369: op(R(X, Y, Z), ldiv(X, W)) = rdiv(W, rdiv(X, R(X, Y, Z))).
Proof:
  op(R(X, Y, Z), ldiv(X, W))
= { by lemma 368 R->L }
  op(R(X, Y, Z), ldiv(R(X, Y, Z), rdiv(W, rdiv(X, R(X, Y, Z))))) (peak)
= { by axiom 8 (sos) }
  rdiv(W, rdiv(X, R(X, Y, Z)))

Lemma 370: rdiv(op(X, Y), rdiv(Y, a(Z, W, V))) = op(X, a(Z, W, V)).
Proof:
  rdiv(op(X, Y), rdiv(Y, a(Z, W, V)))
= { by lemma 198 R->L }
  rdiv(op(X, Y), rdiv(L(Y, X, a(Z, W, V)), a(Z, W, V)))
= { by lemma 175 R->L }
  rdiv(op(op(X, Y), a(Z, W, V)), L(Y, X, a(Z, W, V))) (peak)
= { by lemma 122 R->L }
  rdiv(op(a(Z, W, V), op(X, Y)), L(Y, X, a(Z, W, V))) (peak)
= { by lemma 178 }
  op(a(Z, W, V), X)
= { by lemma 122 }
  op(X, a(Z, W, V))

Lemma 371: rdiv(op(R(X, Y, W), op(Y, W)), op(Z, W)) = R(rdiv(op(X, Y), Z), Z, W).
Proof:
  rdiv(op(R(X, Y, W), op(Y, W)), op(Z, W)) (peak)
= { by lemma 203 }
  rdiv(op(op(X, Y), W), op(Z, W))
= { by lemma 45 }
  R(rdiv(op(X, Y), Z), Z, W) (peak)

Lemma 372: rdiv(op(X, T(Y, Z)), op(Y, Z)) = R(rdiv(X, Z), Z, Y).
Proof:
  rdiv(op(X, T(Y, Z)), op(Y, Z))
= { by lemma 65 R->L }
  rdiv(op(X, T(Y, Z)), op(Z, T(Y, Z))) (peak)
= { by lemma 45 }
  R(rdiv(X, Z), Z, T(Y, Z))
= { by lemma 217 }
  R(rdiv(X, Z), Z, Y)

Lemma 373: rdiv(op(X, Y), op(Y, a(Z, W, V))) = rdiv(X, a(Z, W, V)).
Proof:
  rdiv(op(X, Y), op(Y, a(Z, W, V))) (peak)
= { by lemma 122 R->L }
  rdiv(op(X, Y), op(a(Z, W, V), Y))
= { by lemma 132 R->L }
  rdiv(op(X, T(Y, a(Z, W, V))), op(a(Z, W, V), Y)) (peak)
= { by lemma 122 }
  rdiv(op(X, T(Y, a(Z, W, V))), op(Y, a(Z, W, V))) (peak)
= { by lemma 372 }
  R(rdiv(X, a(Z, W, V)), a(Z, W, V), Y)
= { by lemma 149 }
  rdiv(X, a(Z, W, V))

Lemma 374: R(X, Y, op(Z, a(W, V, U))) = R(X, Y, Z).
Proof:
  R(X, Y, op(Z, a(W, V, U)))
= { by lemma 212 R->L }
  rdiv(op(op(Y, X), op(Z, a(W, V, U))), op(T(Y, X), op(Z, a(W, V, U)))) (peak)
= { by lemma 171 R->L }
  rdiv(op(a(W, V, U), op(op(Y, X), Z)), op(T(Y, X), op(Z, a(W, V, U)))) (peak)
= { by lemma 176 }
  rdiv(op(op(Y, X), Z), rdiv(op(T(Y, X), op(Z, a(W, V, U))), a(W, V, U)))
= { by lemma 179 }
  rdiv(op(op(Y, X), Z), op(T(Y, X), Z))
= { by lemma 212 }
  R(X, Y, Z)

Lemma 375: op(rdiv(X, Y), a(Z, W, V)) = rdiv(X, rdiv(Y, a(Z, W, V))).
Proof:
  op(rdiv(X, Y), a(Z, W, V)) (peak)
= { by lemma 122 R->L }
  op(a(Z, W, V), rdiv(X, Y))
= { by lemma 272 R->L }
  rdiv(op(a(Z, W, V), X), L(Y, rdiv(X, Y), a(Z, W, V))) (peak)
= { by lemma 122 }
  rdiv(op(X, a(Z, W, V)), L(Y, rdiv(X, Y), a(Z, W, V))) (peak)
= { by lemma 175 }
  rdiv(X, rdiv(L(Y, rdiv(X, Y), a(Z, W, V)), a(Z, W, V)))
= { by lemma 198 }
  rdiv(X, rdiv(Y, a(Z, W, V)))

Lemma 376: op(a(X, Y, Z), rdiv(W, V)) = rdiv(W, rdiv(V, a(X, Y, Z))).
Proof:
  op(a(X, Y, Z), rdiv(W, V)) (peak)
= { by lemma 122 }
  op(rdiv(W, V), a(X, Y, Z)) (peak)
= { by lemma 375 }
  rdiv(W, rdiv(V, a(X, Y, Z)))

Lemma 377: rdiv(rdiv(X, a(Y, Z, W)), rdiv(V, a(Y, Z, W))) = rdiv(X, V).
Proof:
  rdiv(rdiv(X, a(Y, Z, W)), rdiv(V, a(Y, Z, W)))
= { by lemma 376 R->L }
  op(a(Y, Z, W), rdiv(rdiv(X, a(Y, Z, W)), V))
= { by lemma 272 R->L }
  rdiv(op(a(Y, Z, W), rdiv(X, a(Y, Z, W))), L(V, rdiv(rdiv(X, a(Y, Z, W)), V), a(Y, Z, W))) (peak)
= { by lemma 135 }
  rdiv(X, L(V, rdiv(rdiv(X, a(Y, Z, W)), V), a(Y, Z, W)))
= { by lemma 198 }
  rdiv(X, V)

Lemma 378: rdiv(rdiv(X, a(Y, Z, W)), V) = rdiv(X, op(V, a(Y, Z, W))).
Proof:
  rdiv(rdiv(X, a(Y, Z, W)), V)
= { by axiom 3 (sos) R->L }
  rdiv(rdiv(X, a(Y, Z, W)), rdiv(op(V, a(Y, Z, W)), a(Y, Z, W))) (peak)
= { by lemma 377 }
  rdiv(X, op(V, a(Y, Z, W)))

Lemma 379: R(X, rdiv(Y, a(Z, W, V)), U) = R(X, Y, U).
Proof:
  R(X, rdiv(Y, a(Z, W, V)), U)
= { by lemma 373 R->L }
  R(X, rdiv(op(Y, U), op(U, a(Z, W, V))), U)
= { by lemma 374 R->L }
  R(X, rdiv(op(Y, U), op(U, a(Z, W, V))), op(U, a(Z, W, V)))
= { by lemma 104 R->L }
  rdiv(op(op(X, rdiv(op(Y, U), op(U, a(Z, W, V)))), op(U, a(Z, W, V))), op(Y, U)) (peak)
= { by lemma 373 }
  rdiv(op(op(X, rdiv(Y, a(Z, W, V))), op(U, a(Z, W, V))), op(Y, U))
= { by lemma 291 }
  rdiv(op(rdiv(op(X, Y), a(Z, W, V)), op(U, a(Z, W, V))), op(Y, U))
= { by lemma 196 }
  rdiv(rdiv(op(op(X, Y), op(U, a(Z, W, V))), a(Z, W, V)), op(Y, U))
= { by lemma 378 }
  rdiv(op(op(X, Y), op(U, a(Z, W, V))), op(op(Y, U), a(Z, W, V)))
= { by lemma 125 }
  rdiv(op(op(X, Y), op(U, a(Z, W, V))), op(Y, op(U, a(Z, W, V))))
= { by axiom 18 (sos) R->L }
  R(X, Y, op(U, a(Z, W, V)))
= { by lemma 374 }
  R(X, Y, U)

Lemma 380: op(R(X, V, U), a(Y, Z, W)) = R(op(X, a(Y, Z, W)), V, U).
Proof:
  op(R(X, V, U), a(Y, Z, W))
= { by lemma 370 R->L }
  rdiv(op(R(X, V, U), op(V, U)), rdiv(op(V, U), a(Y, Z, W)))
= { by lemma 196 R->L }
  rdiv(op(R(X, V, U), op(V, U)), op(rdiv(V, a(Y, Z, W)), U)) (peak)
= { by lemma 371 }
  R(rdiv(op(X, V), rdiv(V, a(Y, Z, W))), rdiv(V, a(Y, Z, W)), U) (peak)
= { by lemma 370 }
  R(op(X, a(Y, Z, W)), rdiv(V, a(Y, Z, W)), U)
= { by lemma 379 }
  R(op(X, a(Y, Z, W)), V, U)

Lemma 381: K(R(R(X, T, S), X2, Y2), U) = K(R(R(X, Y, Z), W, V), U).
Proof:
  K(R(R(X, T, S), X2, Y2), U) (peak)
= { by lemma 184 }
  K(R(X, T, S), U)
= { by lemma 202 }
  K(R(X, Y, Z), U)
= { by lemma 86 R->L }
  ldiv(T(U, R(X, Y, Z)), U)
= { by lemma 200 R->L }
  ldiv(T(U, R(R(X, Y, Z), W, V)), U) (peak)
= { by lemma 96 }
  rdiv(U, T(U, R(R(X, Y, Z), W, V)))
= { by lemma 101 }
  K(R(R(X, Y, Z), W, V), U)

Lemma 382: ldiv(op(X, op(Y, Z)), op(X, op(Z, Y))) = K(Z, Y).
Proof:
  ldiv(op(X, op(Y, Z)), op(X, op(Z, Y)))
= { by lemma 36 R->L }
  ldiv(op(X, rdiv(op(Z, Y), K(Z, Y))), op(X, op(Z, Y))) (peak)
= { by lemma 238 }
  L(K(Z, Y), rdiv(op(Z, Y), K(Z, Y)), X)
= { by lemma 69 }
  K(Z, Y)

Lemma 383: T(R(rdiv(X, Y), Y, Z), op(Y, Z)) = ldiv(op(Y, Z), op(X, Z)).
Proof:
  T(R(rdiv(X, Y), Y, Z), op(Y, Z)) (peak)
= { by lemma 45 R->L }
  T(rdiv(op(X, Z), op(Y, Z)), op(Y, Z)) (peak)
= { by lemma 50 }
  ldiv(op(Y, Z), op(X, Z))

Lemma 384: T(X, op(a(Y, Z, W), V)) = T(X, V).
Proof:
  T(X, op(a(Y, Z, W), V)) (peak)
= { by lemma 122 }
  T(X, op(V, a(Y, Z, W))) (peak)
= { by lemma 199 }
  T(X, V)

Lemma 385: ldiv(op(X, a(Y, Z, W)), op(V, a(Y, Z, W))) = ldiv(X, V).
Proof:
  ldiv(op(X, a(Y, Z, W)), op(V, a(Y, Z, W)))
= { by lemma 383 R->L }
  T(R(rdiv(V, X), X, a(Y, Z, W)), op(X, a(Y, Z, W))) (peak)
= { by lemma 122 R->L }
  T(R(rdiv(V, X), X, a(Y, Z, W)), op(a(Y, Z, W), X)) (peak)
= { by lemma 384 }
  T(R(rdiv(V, X), X, a(Y, Z, W)), X)
= { by lemma 174 }
  T(rdiv(V, X), X)
= { by lemma 50 }
  ldiv(X, V)

Lemma 386: ldiv(rdiv(X, a(Y, Z, W)), V) = ldiv(X, op(V, a(Y, Z, W))).
Proof:
  ldiv(rdiv(X, a(Y, Z, W)), V)
= { by lemma 385 R->L }
  ldiv(op(rdiv(X, a(Y, Z, W)), a(Y, Z, W)), op(V, a(Y, Z, W))) (peak)
= { by axiom 9 (sos) }
  ldiv(X, op(V, a(Y, Z, W)))

Lemma 387: K(rdiv(X, a(Y, Z, W)), V) = K(X, V).
Proof:
  K(rdiv(X, a(Y, Z, W)), V)
= { by lemma 382 R->L }
  ldiv(op(U, op(V, rdiv(X, a(Y, Z, W)))), op(U, op(rdiv(X, a(Y, Z, W)), V))) (peak)
= { by lemma 196 }
  ldiv(op(U, op(V, rdiv(X, a(Y, Z, W)))), op(U, rdiv(op(X, V), a(Y, Z, W))))
= { by lemma 291 }
  ldiv(op(U, rdiv(op(V, X), a(Y, Z, W))), op(U, rdiv(op(X, V), a(Y, Z, W))))
= { by lemma 291 }
  ldiv(rdiv(op(U, op(V, X)), a(Y, Z, W)), op(U, rdiv(op(X, V), a(Y, Z, W))))
= { by lemma 386 }
  ldiv(op(U, op(V, X)), op(op(U, rdiv(op(X, V), a(Y, Z, W))), a(Y, Z, W)))
= { by lemma 125 }
  ldiv(op(U, op(V, X)), op(U, op(rdiv(op(X, V), a(Y, Z, W)), a(Y, Z, W))))
= { by lemma 196 }
  ldiv(op(U, op(V, X)), op(U, rdiv(op(op(X, V), a(Y, Z, W)), a(Y, Z, W))))
= { by lemma 291 }
  ldiv(op(U, op(V, X)), rdiv(op(U, op(op(X, V), a(Y, Z, W))), a(Y, Z, W)))
= { by lemma 179 }
  ldiv(op(U, op(V, X)), op(U, op(X, V)))
= { by lemma 382 }
  K(X, V)

Lemma 388: K(rdiv(X, rdiv(R(Y, Z, W), Y)), V) = K(X, V).
Proof:
  K(rdiv(X, rdiv(R(Y, Z, W), Y)), V)
= { by lemma 321 R->L }
  K(rdiv(X, ldiv(Y, R(Y, Z, W))), V) (peak)
= { by lemma 129 }
  K(rdiv(X, a(Y, Z, W)), V)
= { by lemma 387 }
  K(X, V)

Lemma 389: rdiv(op(R(X, Y, Z), W), rdiv(R(X, Y, Z), X)) = op(X, W).
Proof:
  rdiv(op(R(X, Y, Z), W), rdiv(R(X, Y, Z), X))
= { by lemma 365 R->L }
  op(rdiv(X, R(X, Y, Z)), op(R(X, Y, Z), W))
= { by lemma 185 R->L }
  op(op(rdiv(X, R(X, Y, Z)), R(X, Y, Z)), L(W, R(X, Y, Z), rdiv(X, R(X, Y, Z)))) (peak)
= { by lemma 361 }
  op(op(rdiv(X, R(X, Y, Z)), R(X, Y, Z)), W)
= { by lemma 365 }
  op(rdiv(R(X, Y, Z), rdiv(R(X, Y, Z), X)), W)
= { by lemma 367 }
  op(X, W)

Lemma 390: K(op(X, R(Y, W, V)), Z) = K(op(X, Y), Z).
Proof:
  K(op(X, R(Y, W, V)), Z)
= { by lemma 388 R->L }
  K(rdiv(op(X, R(Y, W, V)), rdiv(R(Y, W, V), Y)), Z) (peak)
= { by lemma 324 }
  K(rdiv(op(R(Y, W, V), X), rdiv(R(Y, W, V), Y)), Z) (peak)
= { by lemma 389 }
  K(op(Y, X), Z)
= { by lemma 120 R->L }
  K(op(X, Y), Z)

Lemma 391: K(op(Y, R(X, W, V)), Z) = K(op(X, Y), Z).
Proof:
  K(op(Y, R(X, W, V)), Z) (peak)
= { by lemma 390 }
  K(op(Y, X), Z)
= { by lemma 120 R->L }
  K(op(X, Y), Z)

Lemma 392: K(op(R(X, W, V), Y), Z) = K(op(X, Y), Z).
Proof:
  K(op(R(X, W, V), Y), Z) (peak)
= { by lemma 120 }
  K(op(Y, R(X, W, V)), Z) (peak)
= { by lemma 391 }
  K(op(X, Y), Z)

Lemma 393: K(op(X, R(Y, U, T)), V) = K(op(X, R(Y, Z, W)), V).
Proof:
  K(op(X, R(Y, U, T)), V) (peak)
= { by lemma 120 }
  K(op(R(Y, U, T), X), V) (peak)
= { by lemma 392 }
  K(op(Y, X), V)
= { by lemma 389 R->L }
  K(rdiv(op(R(Y, Z, W), X), rdiv(R(Y, Z, W), Y)), V) (peak)
= { by lemma 324 R->L }
  K(rdiv(op(X, R(Y, Z, W)), rdiv(R(Y, Z, W), Y)), V) (peak)
= { by lemma 388 }
  K(op(X, R(Y, Z, W)), V)

Lemma 394: K(op(R(X, Y, Z), W), V) = K(op(W, R(X, U, T)), V).
Proof:
  K(op(R(X, Y, Z), W), V) (peak)
= { by lemma 120 }
  K(op(W, R(X, Y, Z)), V) (peak)
= { by lemma 393 R->L }
  K(op(W, R(X, U, T)), V) (peak)

Lemma 395: K(op(R(X, U, T), W), V) = K(op(R(X, Y, Z), W), V).
Proof:
  K(op(R(X, U, T), W), V) (peak)
= { by lemma 120 }
  K(op(W, R(X, U, T)), V) (peak)
= { by lemma 394 R->L }
  K(op(R(X, Y, Z), W), V) (peak)

Lemma 396: K(op(X, R(R(Y, S, X2), Y2, Z2)), T) = K(op(X, R(R(Y, Z, W), V, U)), T).
Proof:
  K(op(X, R(R(Y, S, X2), Y2, Z2)), T) (peak)
= { by lemma 120 }
  K(op(R(R(Y, S, X2), Y2, Z2), X), T) (peak)
= { by lemma 392 }
  K(op(R(Y, S, X2), X), T)
= { by lemma 395 }
  K(op(R(Y, Z, W), X), T)
= { by lemma 389 R->L }
  K(rdiv(op(R(R(Y, Z, W), V, U), X), rdiv(R(R(Y, Z, W), V, U), R(Y, Z, W))), T) (peak)
= { by lemma 324 R->L }
  K(rdiv(op(X, R(R(Y, Z, W), V, U)), rdiv(R(R(Y, Z, W), V, U), R(Y, Z, W))), T) (peak)
= { by lemma 388 }
  K(op(X, R(R(Y, Z, W), V, U)), T)

Lemma 397: K(rdiv(R(R(X, S, X2), Y2, Z2), U), T) = K(rdiv(R(R(X, Y, Z), W, V), U), T).
Proof:
  K(rdiv(R(R(X, S, X2), Y2, Z2), U), T)
= { by lemma 326 R->L }
  K(rdiv(T(R(R(X, S, X2), Y2, Z2), W2), U), T)
= { by lemma 273 R->L }
  K(rdiv(R(R(X, S, X2), Y2, Z2), rdiv(U, K(R(R(X, S, X2), Y2, Z2), W2))), T) (peak)
= { by lemma 381 }
  K(rdiv(R(R(X, S, X2), Y2, Z2), rdiv(U, K(R(R(X, Y, Z), W, V), W2))), T)
= { by lemma 64 R->L }
  K(rdiv(R(R(X, S, X2), Y2, Z2), op(U, K(W2, R(R(X, Y, Z), W, V)))), T)
= { by lemma 325 R->L }
  K(rdiv(rdiv(R(R(X, S, X2), Y2, Z2), U), K(W2, R(R(X, Y, Z), W, V))), T)
= { by lemma 63 R->L }
  K(op(K(R(R(X, Y, Z), W, V), W2), rdiv(R(R(X, S, X2), Y2, Z2), U)), T)
= { by lemma 319 R->L }
  K(op(rdiv(K(R(R(X, Y, Z), W, V), W2), U), R(R(X, S, X2), Y2, Z2)), T) (peak)
= { by lemma 396 }
  K(op(rdiv(K(R(R(X, Y, Z), W, V), W2), U), R(R(X, Y, Z), W, V)), T) (peak)
= { by lemma 261 }
  K(op(rdiv(zero, U), T(R(R(X, Y, Z), W, V), W2)), T)
= { by lemma 319 }
  K(op(zero, rdiv(T(R(R(X, Y, Z), W, V), W2), U)), T)
= { by axiom 2 (sos) }
  K(rdiv(T(R(R(X, Y, Z), W, V), W2), U), T)
= { by lemma 326 }
  K(rdiv(R(R(X, Y, Z), W, V), U), T)

Lemma 398: op(X, op(Y, a(X, Z, ldiv(Z, Y)))) = op(op(X, Z), ldiv(Z, Y)).
Proof:
  op(X, op(Y, a(X, Z, ldiv(Z, Y))))
= { by lemma 125 R->L }
  op(op(X, Y), a(X, Z, ldiv(Z, Y)))
= { by axiom 8 (sos) R->L }
  op(op(X, op(Z, ldiv(Z, Y))), a(X, Z, ldiv(Z, Y))) (peak)
= { by axiom 20 (sos) R->L }
  op(op(X, Z), ldiv(Z, Y))

Lemma 399: ldiv(Y, op(op(Y, Z), ldiv(Z, X))) = op(X, a(Y, Z, ldiv(Z, X))).
Proof:
  ldiv(Y, op(op(Y, Z), ldiv(Z, X)))
= { by lemma 398 R->L }
  ldiv(Y, op(Y, op(X, a(Y, Z, ldiv(Z, X))))) (peak)
= { by axiom 4 (sos) }
  op(X, a(Y, Z, ldiv(Z, X)))

Lemma 400: op(X, a(rdiv(X, Y), Y, rdiv(X, Y))) = T(op(ldiv(Y, X), Y), rdiv(X, Y)).
Proof:
  op(X, a(rdiv(X, Y), Y, rdiv(X, Y)))
= { by lemma 164 R->L }
  op(X, a(rdiv(X, Y), Y, ldiv(Y, X)))
= { by lemma 169 R->L }
  op(X, a(ldiv(Y, X), Y, ldiv(Y, X)))
= { by lemma 399 R->L }
  ldiv(ldiv(Y, X), op(op(ldiv(Y, X), Y), ldiv(Y, X))) (peak)
= { by axiom 5 (sos) R->L }
  T(op(ldiv(Y, X), Y), ldiv(Y, X))
= { by lemma 85 }
  T(op(ldiv(Y, X), Y), rdiv(X, Y))

Lemma 401: op(X, op(Y, a(X, Z, rdiv(Y, Z)))) = op(op(X, Z), ldiv(Z, Y)).
Proof:
  op(X, op(Y, a(X, Z, rdiv(Y, Z))))
= { by lemma 164 R->L }
  op(X, op(Y, a(X, Z, ldiv(Z, Y))))
= { by lemma 125 R->L }
  op(op(X, Y), a(X, Z, ldiv(Z, Y)))
= { by axiom 8 (sos) R->L }
  op(op(X, op(Z, ldiv(Z, Y))), a(X, Z, ldiv(Z, Y))) (peak)
= { by axiom 20 (sos) R->L }
  op(op(X, Z), ldiv(Z, Y))

Lemma 402: op(op(ldiv(X, Y), X), rdiv(Y, X)) = op(Y, ldiv(X, Y)).
Proof:
  op(op(ldiv(X, Y), X), rdiv(Y, X))
= { by lemma 65 R->L }
  op(rdiv(Y, X), T(op(ldiv(X, Y), X), rdiv(Y, X)))
= { by lemma 400 R->L }
  op(rdiv(Y, X), op(Y, a(rdiv(Y, X), X, rdiv(Y, X)))) (peak)
= { by lemma 401 }
  op(op(rdiv(Y, X), X), ldiv(X, Y))
= { by axiom 9 (sos) }
  op(Y, ldiv(X, Y))

Lemma 403: rdiv(op(X, ldiv(Y, X)), rdiv(X, Y)) = op(ldiv(Y, X), Y).
Proof:
  rdiv(op(X, ldiv(Y, X)), rdiv(X, Y))
= { by lemma 402 R->L }
  rdiv(op(op(ldiv(Y, X), Y), rdiv(X, Y)), rdiv(X, Y)) (peak)
= { by axiom 3 (sos) }
  op(ldiv(Y, X), Y)

Lemma 404: rdiv(op(X, ldiv(ldiv(Y, X), X)), Y) = op(Y, rdiv(X, Y)).
Proof:
  rdiv(op(X, ldiv(ldiv(Y, X), X)), Y)
= { by lemma 94 R->L }
  rdiv(op(X, ldiv(ldiv(Y, X), X)), rdiv(X, ldiv(Y, X))) (peak)
= { by lemma 403 }
  op(ldiv(ldiv(Y, X), X), ldiv(Y, X))
= { by lemma 161 }
  op(Y, rdiv(X, Y))

Lemma 405: R(X, Y, rdiv(zero, a(Z, W, V))) = X.
Proof:
  R(X, Y, rdiv(zero, a(Z, W, V)))
= { by lemma 216 R->L }
  R(X, Y, ldiv(a(Z, W, V), zero))
= { by lemma 374 R->L }
  R(X, Y, op(ldiv(a(Z, W, V), zero), a(Z, W, V))) (peak)
= { by lemma 88 }
  R(X, Y, K(rdiv(zero, a(Z, W, V)), a(Z, W, V)))
= { by lemma 105 }
  X

Lemma 406: R(rdiv(X, Y), Y, ldiv(X, Z)) = rdiv(Z, op(Y, ldiv(X, Z))).
Proof:
  R(rdiv(X, Y), Y, ldiv(X, Z)) (peak)
= { by lemma 45 R->L }
  rdiv(op(X, ldiv(X, Z)), op(Y, ldiv(X, Z))) (peak)
= { by axiom 8 (sos) }
  rdiv(Z, op(Y, ldiv(X, Z)))

Lemma 407: ldiv(R(rdiv(X, Y), Y, rdiv(Z, X)), Z) = op(Y, ldiv(X, Z)).
Proof:
  ldiv(R(rdiv(X, Y), Y, rdiv(Z, X)), Z)
= { by lemma 216 R->L }
  ldiv(R(rdiv(X, Y), Y, ldiv(X, Z)), Z) (peak)
= { by lemma 406 }
  ldiv(rdiv(Z, op(Y, ldiv(X, Z))), Z) (peak)
= { by lemma 32 }
  op(Y, ldiv(X, Z))

Lemma 408: op(X, rdiv(zero, a(Y, Z, W))) = rdiv(X, a(Y, Z, W)).
Proof:
  op(X, rdiv(zero, a(Y, Z, W)))
= { by lemma 245 R->L }
  rdiv(X, L(a(Y, Z, W), rdiv(zero, a(Y, Z, W)), X)) (peak)
= { by lemma 177 }
  rdiv(X, a(Y, Z, W))

Lemma 409: ldiv(rdiv(R(X, Y, Z), W), X) = rdiv(W, a(X, Y, Z)).
Proof:
  ldiv(rdiv(R(X, Y, Z), W), X)
= { by lemma 405 R->L }
  ldiv(R(rdiv(R(X, Y, Z), W), W, rdiv(zero, a(X, Y, Z))), X)
= { by lemma 150 R->L }
  ldiv(R(rdiv(R(X, Y, Z), W), W, rdiv(V, op(V, a(X, Y, Z)))), X)
= { by lemma 216 R->L }
  ldiv(R(rdiv(R(X, Y, Z), W), W, ldiv(op(V, a(X, Y, Z)), V)), X) (peak)
= { by lemma 355 }
  ldiv(R(rdiv(R(X, Y, Z), W), W, rdiv(X, R(X, Y, Z))), X) (peak)
= { by lemma 407 }
  op(W, ldiv(R(X, Y, Z), X))
= { by lemma 141 }
  op(W, rdiv(zero, a(X, Y, Z)))
= { by lemma 408 }
  rdiv(W, a(X, Y, Z))

Lemma 410: ldiv(rdiv(R(X, Y, Z), W), X) = rdiv(W, rdiv(R(X, Y, Z), X)).
Proof:
  ldiv(rdiv(R(X, Y, Z), W), X) (peak)
= { by lemma 409 }
  rdiv(W, a(X, Y, Z))
= { by lemma 129 R->L }
  rdiv(W, ldiv(X, R(X, Y, Z)))
= { by lemma 134 }
  rdiv(W, rdiv(R(X, Y, Z), X))

Lemma 411: ldiv(op(X, Y), op(Y, op(T(X, Y), Z))) = L(Z, X, Y).
Proof:
  ldiv(op(X, Y), op(Y, op(T(X, Y), Z)))
= { by lemma 65 R->L }
  ldiv(op(Y, T(X, Y)), op(Y, op(T(X, Y), Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, T(X, Y), Y)
= { by lemma 227 }
  L(Z, X, Y)

Lemma 412: T(X, rdiv(Y, a(Z, W, V))) = T(X, Y).
Proof:
  T(X, rdiv(Y, a(Z, W, V)))
= { by lemma 199 R->L }
  T(X, op(rdiv(Y, a(Z, W, V)), a(Z, W, V))) (peak)
= { by axiom 9 (sos) }
  T(X, Y)

Lemma 413: L(X, Y, rdiv(Z, a(W, V, U))) = L(X, Y, Z).
Proof:
  L(X, Y, rdiv(Z, a(W, V, U)))
= { by lemma 411 R->L }
  ldiv(op(Y, rdiv(Z, a(W, V, U))), op(rdiv(Z, a(W, V, U)), op(T(Y, rdiv(Z, a(W, V, U))), X))) (peak)
= { by lemma 196 }
  ldiv(op(Y, rdiv(Z, a(W, V, U))), rdiv(op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X)), a(W, V, U)))
= { by lemma 359 }
  rdiv(ldiv(op(Y, rdiv(Z, a(W, V, U))), op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X))), a(W, V, U))
= { by lemma 291 }
  rdiv(ldiv(rdiv(op(Y, Z), a(W, V, U)), op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X))), a(W, V, U))
= { by lemma 386 }
  rdiv(ldiv(op(Y, Z), op(op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X)), a(W, V, U))), a(W, V, U))
= { by lemma 358 }
  ldiv(op(Y, Z), op(Z, op(T(Y, rdiv(Z, a(W, V, U))), X)))
= { by lemma 412 }
  ldiv(op(Y, Z), op(Z, op(T(Y, Z), X)))
= { by lemma 411 }
  L(X, Y, Z)

Lemma 414: L(X, Y, rdiv(Z, R(Z, W, V))) = X.
Proof:
  L(X, Y, rdiv(Z, R(Z, W, V))) (peak)
= { by lemma 355 R->L }
  L(X, Y, ldiv(op(U, a(Z, W, V)), U)) (peak)
= { by lemma 221 }
  L(X, Y, rdiv(U, op(U, a(Z, W, V))))
= { by lemma 150 }
  L(X, Y, rdiv(zero, a(Z, W, V)))
= { by lemma 413 }
  L(X, Y, zero)
= { by lemma 30 }
  X

Lemma 415: ldiv(rdiv(X, rdiv(R(Y, Z, W), Y)), Y) = ldiv(X, R(Y, Z, W)).
Proof:
  ldiv(rdiv(X, rdiv(R(Y, Z, W), Y)), Y)
= { by lemma 365 R->L }
  ldiv(op(rdiv(Y, R(Y, Z, W)), X), Y)
= { by lemma 327 R->L }
  L(ldiv(X, R(Y, Z, W)), X, rdiv(Y, R(Y, Z, W))) (peak)
= { by lemma 414 }
  ldiv(X, R(Y, Z, W))

Lemma 416: rdiv(op(X, ldiv(Y, Z)), rdiv(Z, Y)) = rdiv(X, K(Y, rdiv(Z, Y))).
Proof:
  rdiv(op(X, ldiv(Y, Z)), rdiv(Z, Y))
= { by lemma 163 R->L }
  rdiv(op(X, ldiv(Y, Z)), rdiv(ldiv(Y, Z), K(rdiv(Z, Y), Y))) (peak)
= { by lemma 218 }
  rdiv(X, K(Y, rdiv(Z, Y)))

Lemma 417: K(X, rdiv(Y, a(Z, W, V))) = K(X, Y).
Proof:
  K(X, rdiv(Y, a(Z, W, V)))
= { by lemma 180 R->L }
  K(X, op(rdiv(Y, a(Z, W, V)), a(Z, W, V))) (peak)
= { by axiom 9 (sos) }
  K(X, Y)

Lemma 418: K(X, rdiv(Y, rdiv(R(Z, W, V), Z))) = K(X, Y).
Proof:
  K(X, rdiv(Y, rdiv(R(Z, W, V), Z)))
= { by lemma 306 R->L }
  K(X, rdiv(Y, ldiv(Z, R(Z, W, V)))) (peak)
= { by lemma 129 }
  K(X, rdiv(Y, a(Z, W, V)))
= { by lemma 417 }
  K(X, Y)

Lemma 419: K(X, op(Y, R(Z, W, V))) = K(X, op(Y, Z)).
Proof:
  K(X, op(Y, R(Z, W, V)))
= { by lemma 418 R->L }
  K(X, rdiv(op(Y, R(Z, W, V)), rdiv(R(Z, W, V), Z))) (peak)
= { by lemma 310 }
  K(X, rdiv(op(R(Z, W, V), Y), rdiv(R(Z, W, V), Z))) (peak)
= { by lemma 389 }
  K(X, op(Z, Y))
= { by lemma 116 R->L }
  K(X, op(Y, Z))

Lemma 420: K(X, op(Y, R(Z, W, V))) = K(X, op(Z, Y)).
Proof:
  K(X, op(Y, R(Z, W, V))) (peak)
= { by lemma 419 }
  K(X, op(Y, Z))
= { by lemma 116 R->L }
  K(X, op(Z, Y))

Lemma 421: K(X, op(R(Y, W, V), Z)) = K(X, op(Y, Z)).
Proof:
  K(X, op(R(Y, W, V), Z)) (peak)
= { by lemma 116 }
  K(X, op(Z, R(Y, W, V))) (peak)
= { by lemma 420 }
  K(X, op(Y, Z))

Lemma 422: K(X, op(Y, R(Z, U, T))) = K(X, op(Y, R(Z, W, V))).
Proof:
  K(X, op(Y, R(Z, U, T))) (peak)
= { by lemma 116 }
  K(X, op(R(Z, U, T), Y)) (peak)
= { by lemma 421 }
  K(X, op(Z, Y))
= { by lemma 389 R->L }
  K(X, rdiv(op(R(Z, W, V), Y), rdiv(R(Z, W, V), Z))) (peak)
= { by lemma 310 R->L }
  K(X, rdiv(op(Y, R(Z, W, V)), rdiv(R(Z, W, V), Z))) (peak)
= { by lemma 418 }
  K(X, op(Y, R(Z, W, V)))

Lemma 423: K(X, op(R(Y, Z, W), V)) = K(X, op(V, R(Y, U, T))).
Proof:
  K(X, op(R(Y, Z, W), V)) (peak)
= { by lemma 116 }
  K(X, op(V, R(Y, Z, W))) (peak)
= { by lemma 422 R->L }
  K(X, op(V, R(Y, U, T))) (peak)

Lemma 424: K(X, op(R(Y, U, T), V)) = K(X, op(R(Y, Z, W), V)).
Proof:
  K(X, op(R(Y, U, T), V)) (peak)
= { by lemma 116 }
  K(X, op(V, R(Y, U, T))) (peak)
= { by lemma 423 R->L }
  K(X, op(R(Y, Z, W), V)) (peak)

Lemma 425: K(X, op(Y, R(R(Z, S, X2), Y2, Z2))) = K(X, op(Y, R(R(Z, W, V), U, T))).
Proof:
  K(X, op(Y, R(R(Z, S, X2), Y2, Z2))) (peak)
= { by lemma 116 }
  K(X, op(R(R(Z, S, X2), Y2, Z2), Y)) (peak)
= { by lemma 421 }
  K(X, op(R(Z, S, X2), Y))
= { by lemma 424 }
  K(X, op(R(Z, W, V), Y))
= { by lemma 389 R->L }
  K(X, rdiv(op(R(R(Z, W, V), U, T), Y), rdiv(R(R(Z, W, V), U, T), R(Z, W, V)))) (peak)
= { by lemma 310 R->L }
  K(X, rdiv(op(Y, R(R(Z, W, V), U, T)), rdiv(R(R(Z, W, V), U, T), R(Z, W, V)))) (peak)
= { by lemma 418 }
  K(X, op(Y, R(R(Z, W, V), U, T)))

Lemma 426: K(X, rdiv(R(R(Y, S, X2), Y2, Z2), T)) = K(X, rdiv(R(R(Y, Z, W), V, U), T)).
Proof:
  K(X, rdiv(R(R(Y, S, X2), Y2, Z2), T))
= { by lemma 312 R->L }
  K(X, rdiv(T(R(R(Y, S, X2), Y2, Z2), W2), T))
= { by lemma 273 R->L }
  K(X, rdiv(R(R(Y, S, X2), Y2, Z2), rdiv(T, K(R(R(Y, S, X2), Y2, Z2), W2)))) (peak)
= { by lemma 381 }
  K(X, rdiv(R(R(Y, S, X2), Y2, Z2), rdiv(T, K(R(R(Y, Z, W), V, U), W2))))
= { by lemma 64 R->L }
  K(X, rdiv(R(R(Y, S, X2), Y2, Z2), op(T, K(W2, R(R(Y, Z, W), V, U)))))
= { by lemma 311 R->L }
  K(X, rdiv(rdiv(R(R(Y, S, X2), Y2, Z2), T), K(W2, R(R(Y, Z, W), V, U))))
= { by lemma 63 R->L }
  K(X, op(K(R(R(Y, Z, W), V, U), W2), rdiv(R(R(Y, S, X2), Y2, Z2), T)))
= { by lemma 296 R->L }
  K(X, op(rdiv(K(R(R(Y, Z, W), V, U), W2), T), R(R(Y, S, X2), Y2, Z2))) (peak)
= { by lemma 425 }
  K(X, op(rdiv(K(R(R(Y, Z, W), V, U), W2), T), R(R(Y, Z, W), V, U))) (peak)
= { by lemma 261 }
  K(X, op(rdiv(zero, T), T(R(R(Y, Z, W), V, U), W2)))
= { by lemma 296 }
  K(X, op(zero, rdiv(T(R(R(Y, Z, W), V, U), W2), T)))
= { by axiom 2 (sos) }
  K(X, rdiv(T(R(R(Y, Z, W), V, U), W2), T))
= { by lemma 312 }
  K(X, rdiv(R(R(Y, Z, W), V, U), T))

Lemma 427: op(rdiv(R(R(X, Y, Z), W, V), U), rdiv(R(X, Y, Z), rdiv(R(R(X, Y, Z), W, V), U))) = rdiv(R(X, Y, Z), K(U, rdiv(R(R(X, T, S), X2, Y2), U))).
Proof:
  op(rdiv(R(R(X, Y, Z), W, V), U), rdiv(R(X, Y, Z), rdiv(R(R(X, Y, Z), W, V), U)))
= { by lemma 404 R->L }
  rdiv(op(R(X, Y, Z), ldiv(ldiv(rdiv(R(R(X, Y, Z), W, V), U), R(X, Y, Z)), R(X, Y, Z))), rdiv(R(R(X, Y, Z), W, V), U)) (peak)
= { by lemma 410 }
  rdiv(op(R(X, Y, Z), ldiv(rdiv(U, rdiv(R(R(X, Y, Z), W, V), R(X, Y, Z))), R(X, Y, Z))), rdiv(R(R(X, Y, Z), W, V), U))
= { by lemma 415 }
  rdiv(op(R(X, Y, Z), ldiv(U, R(R(X, Y, Z), W, V))), rdiv(R(R(X, Y, Z), W, V), U))
= { by lemma 416 }
  rdiv(R(X, Y, Z), K(U, rdiv(R(R(X, Y, Z), W, V), U)))
= { by lemma 426 R->L }
  rdiv(R(X, Y, Z), K(U, rdiv(R(R(X, T, S), X2, Y2), U))) (peak)

Lemma 428: T(X, rdiv(Y, rdiv(Z, K(W, V)))) = T(X, rdiv(Y, Z)).
Proof:
  T(X, rdiv(Y, rdiv(Z, K(W, V))))
= { by lemma 188 R->L }
  T(X, rdiv(rdiv(Y, Z), K(V, W))) (peak)
= { by lemma 82 }
  T(X, rdiv(Y, Z))

Lemma 429: T(X, rdiv(rdiv(Y, Z), W)) = T(X, rdiv(Y, op(Z, W))).
Proof:
  T(X, rdiv(rdiv(Y, Z), W))
= { by lemma 200 R->L }
  T(X, R(rdiv(rdiv(Y, Z), W), W, Z)) (peak)
= { by lemma 145 }
  T(X, rdiv(Y, op(W, Z)))
= { by lemma 299 R->L }
  T(X, rdiv(Y, op(Z, W)))

Lemma 430: T(X, op(rdiv(Y, Z), W)) = T(X, op(Y, rdiv(W, Z))).
Proof:
  T(X, op(rdiv(Y, Z), W)) (peak)
= { by lemma 115 R->L }
  T(X, op(W, rdiv(Y, Z))) (peak)
= { by lemma 294 }
  T(X, op(Y, rdiv(W, Z))) (peak)

Lemma 431: rdiv(X, L(ldiv(Y, zero), Y, X)) = op(X, Y).
Proof:
  rdiv(X, L(ldiv(Y, zero), Y, X)) (peak)
= { by lemma 137 }
  rdiv(X, ldiv(op(X, Y), X)) (peak)
= { by lemma 94 }
  op(X, Y)

Lemma 432: L(X, Y, op(Z, a(W, V, U))) = L(X, Y, Z).
Proof:
  L(X, Y, op(Z, a(W, V, U)))
= { by lemma 413 R->L }
  L(X, Y, rdiv(op(Z, a(W, V, U)), a(W, V, U))) (peak)
= { by axiom 3 (sos) }
  L(X, Y, Z)

Lemma 433: L(X, Y, R(Z, W, V)) = L(X, Y, Z).
Proof:
  L(X, Y, R(Z, W, V))
= { by lemma 128 R->L }
  L(X, Y, op(Z, a(Z, W, V))) (peak)
= { by lemma 432 }
  L(X, Y, Z)

Lemma 434: ldiv(rdiv(X, Y), R(X, Z, W)) = op(Y, a(X, Z, W)).
Proof:
  ldiv(rdiv(X, Y), R(X, Z, W))
= { by lemma 174 R->L }
  ldiv(R(rdiv(X, Y), Y, a(X, Z, W)), R(X, Z, W))
= { by lemma 128 R->L }
  ldiv(R(rdiv(X, Y), Y, a(X, Z, W)), op(X, a(X, Z, W))) (peak)
= { by lemma 263 }
  op(Y, a(X, Z, W))

Lemma 435: ldiv(rdiv(X, Y), R(X, Z, W)) = rdiv(Y, rdiv(X, R(X, Z, W))).
Proof:
  ldiv(rdiv(X, Y), R(X, Z, W))
= { by lemma 434 }
  op(Y, a(X, Z, W))
= { by lemma 129 R->L }
  op(Y, ldiv(X, R(X, Z, W))) (peak)
= { by lemma 134 }
  op(Y, rdiv(R(X, Z, W), X))
= { by lemma 336 }
  rdiv(Y, rdiv(X, R(X, Z, W)))

Lemma 436: T(X, rdiv(Y, rdiv(Z, R(Z, W, V)))) = T(X, Y).
Proof:
  T(X, rdiv(Y, rdiv(Z, R(Z, W, V))))
= { by lemma 336 R->L }
  T(X, op(Y, rdiv(R(Z, W, V), Z)))
= { by lemma 285 R->L }
  T(X, op(Y, ldiv(Z, R(Z, W, V)))) (peak)
= { by lemma 129 }
  T(X, op(Y, a(Z, W, V)))
= { by lemma 199 }
  T(X, Y)

Lemma 437: T(X, rdiv(R(Y, Z, W), rdiv(Y, V))) = T(X, V).
Proof:
  T(X, rdiv(R(Y, Z, W), rdiv(Y, V)))
= { by lemma 85 R->L }
  T(X, ldiv(rdiv(Y, V), R(Y, Z, W))) (peak)
= { by lemma 435 }
  T(X, rdiv(V, rdiv(Y, R(Y, Z, W))))
= { by lemma 436 }
  T(X, V)

Lemma 438: T(X, rdiv(R(Y, W, V), Z)) = T(X, rdiv(Y, Z)).
Proof:
  T(X, rdiv(R(Y, W, V), Z))
= { by lemma 94 R->L }
  T(X, rdiv(R(Y, W, V), rdiv(Y, ldiv(Z, Y)))) (peak)
= { by lemma 437 }
  T(X, ldiv(Z, Y))
= { by lemma 85 }
  T(X, rdiv(Y, Z))

Lemma 439: T(X, op(Y, R(Z, W, V))) = T(X, op(Y, Z)).
Proof:
  T(X, op(Y, R(Z, W, V))) (peak)
= { by lemma 115 R->L }
  T(X, op(R(Z, W, V), Y))
= { by lemma 431 R->L }
  T(X, rdiv(R(Z, W, V), L(ldiv(Y, zero), Y, R(Z, W, V)))) (peak)
= { by lemma 433 }
  T(X, rdiv(R(Z, W, V), L(ldiv(Y, zero), Y, Z)))
= { by lemma 438 }
  T(X, rdiv(Z, L(ldiv(Y, zero), Y, Z)))
= { by lemma 431 }
  T(X, op(Z, Y))
= { by lemma 115 }
  T(X, op(Y, Z))

Lemma 440: T(X, rdiv(Y, rdiv(R(Z, W, V), Z))) = T(X, Y).
Proof:
  T(X, rdiv(Y, rdiv(R(Z, W, V), Z)))
= { by lemma 305 R->L }
  T(X, rdiv(Y, ldiv(Z, R(Z, W, V)))) (peak)
= { by lemma 129 }
  T(X, rdiv(Y, a(Z, W, V)))
= { by lemma 412 }
  T(X, Y)

Lemma 441: T(X, op(Y, R(Z, U, T))) = T(X, op(Y, R(Z, W, V))).
Proof:
  T(X, op(Y, R(Z, U, T))) (peak)
= { by lemma 439 }
  T(X, op(Y, Z))
= { by lemma 115 R->L }
  T(X, op(Z, Y))
= { by lemma 389 R->L }
  T(X, rdiv(op(R(Z, W, V), Y), rdiv(R(Z, W, V), Z))) (peak)
= { by lemma 309 R->L }
  T(X, rdiv(op(Y, R(Z, W, V)), rdiv(R(Z, W, V), Z))) (peak)
= { by lemma 440 }
  T(X, op(Y, R(Z, W, V)))

Lemma 442: T(X, op(ldiv(W, Z), Y)) = T(X, op(Y, rdiv(Z, W))).
Proof:
  T(X, op(ldiv(W, Z), Y)) (peak)
= { by lemma 115 R->L }
  T(X, op(Y, ldiv(W, Z))) (peak)
= { by lemma 285 }
  T(X, op(Y, rdiv(Z, W)))

Lemma 443: T(X, op(ldiv(Y, Z), W)) = T(X, op(rdiv(Z, Y), W)).
Proof:
  T(X, op(ldiv(Y, Z), W)) (peak)
= { by lemma 442 }
  T(X, op(W, rdiv(Z, Y))) (peak)
= { by lemma 115 }
  T(X, op(rdiv(Z, Y), W)) (peak)

Lemma 444: ldiv(L(X, Y, rdiv(zero, Y)), X) = a(rdiv(zero, Y), Y, X).
Proof:
  ldiv(L(X, Y, rdiv(zero, Y)), X)
= { by axiom 2 (sos) R->L }
  ldiv(L(X, Y, rdiv(zero, Y)), op(zero, X))
= { by axiom 9 (sos) R->L }
  ldiv(L(X, Y, rdiv(zero, Y)), op(op(rdiv(zero, Y), Y), X))
= { by lemma 237 R->L }
  ldiv(op(rdiv(zero, Y), op(Y, X)), op(op(rdiv(zero, Y), Y), X)) (peak)
= { by lemma 154 }
  a(rdiv(zero, Y), Y, X)

Lemma 445: rdiv(X, a(rdiv(zero, Y), Y, X)) = L(X, Y, rdiv(zero, Y)).
Proof:
  rdiv(X, a(rdiv(zero, Y), Y, X))
= { by lemma 444 R->L }
  rdiv(X, ldiv(L(X, Y, rdiv(zero, Y)), X)) (peak)
= { by lemma 94 }
  L(X, Y, rdiv(zero, Y))

Lemma 446: T(X, L(Y, Z, rdiv(zero, Z))) = T(X, Y).
Proof:
  T(X, L(Y, Z, rdiv(zero, Z)))
= { by lemma 197 R->L }
  L(T(X, L(Y, Z, rdiv(zero, Z))), rdiv(Y, a(rdiv(zero, Z), Z, Y)), a(rdiv(zero, Z), Z, Y))
= { by lemma 445 R->L }
  L(T(X, rdiv(Y, a(rdiv(zero, Z), Z, Y))), rdiv(Y, a(rdiv(zero, Z), Z, Y)), a(rdiv(zero, Z), Z, Y)) (peak)
= { by lemma 282 }
  ldiv(Y, op(a(rdiv(zero, Z), Z, Y), op(X, ldiv(a(rdiv(zero, Z), Z, Y), Y))))
= { by lemma 136 }
  ldiv(Y, op(a(rdiv(zero, Z), Z, Y), op(X, rdiv(Y, a(rdiv(zero, Z), Z, Y)))))
= { by lemma 291 }
  ldiv(Y, op(a(rdiv(zero, Z), Z, Y), rdiv(op(X, Y), a(rdiv(zero, Z), Z, Y))))
= { by lemma 135 }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 447: T(X, op(Y, rdiv(zero, Z))) = T(X, rdiv(Y, Z)).
Proof:
  T(X, op(Y, rdiv(zero, Z))) (peak)
= { by lemma 115 R->L }
  T(X, op(rdiv(zero, Z), Y))
= { by lemma 27 R->L }
  T(X, rdiv(op(rdiv(zero, Z), Y), zero))
= { by axiom 9 (sos) R->L }
  T(X, rdiv(op(rdiv(zero, Z), Y), op(rdiv(zero, Z), Z)))
= { by lemma 85 R->L }
  T(X, ldiv(op(rdiv(zero, Z), Z), op(rdiv(zero, Z), Y))) (peak)
= { by lemma 74 }
  T(X, L(ldiv(Z, Y), Z, rdiv(zero, Z)))
= { by lemma 446 }
  T(X, ldiv(Z, Y))
= { by lemma 85 }
  T(X, rdiv(Y, Z))

Lemma 448: T(X, op(rdiv(zero, Y), Z)) = T(X, rdiv(Z, Y)).
Proof:
  T(X, op(rdiv(zero, Y), Z))
= { by lemma 443 R->L }
  T(X, op(ldiv(Y, zero), Z)) (peak)
= { by lemma 115 }
  T(X, op(Z, ldiv(Y, zero))) (peak)
= { by lemma 285 }
  T(X, op(Z, rdiv(zero, Y)))
= { by lemma 447 }
  T(X, rdiv(Z, Y))

Lemma 449: T(X, rdiv(T(Y, Z), W)) = T(X, rdiv(Y, W)).
Proof:
  T(X, rdiv(T(Y, Z), W))
= { by lemma 82 R->L }
  T(X, rdiv(rdiv(T(Y, Z), W), K(Y, Z)))
= { by lemma 63 R->L }
  T(X, op(K(Z, Y), rdiv(T(Y, Z), W)))
= { by lemma 285 R->L }
  T(X, op(K(Z, Y), ldiv(W, T(Y, Z))))
= { by lemma 276 R->L }
  T(X, op(K(Z, Y), rdiv(ldiv(W, Y), K(Z, Y)))) (peak)
= { by lemma 208 }
  T(X, ldiv(W, Y))
= { by lemma 85 }
  T(X, rdiv(Y, W))

Lemma 450: T(X, rdiv(R(Y, U, T), V)) = T(X, rdiv(R(Y, Z, W), V)).
Proof:
  T(X, rdiv(R(Y, U, T), V))
= { by lemma 428 R->L }
  T(X, rdiv(R(Y, U, T), rdiv(V, K(R(Y, Z, W), S))))
= { by lemma 64 R->L }
  T(X, rdiv(R(Y, U, T), op(V, K(S, R(Y, Z, W)))))
= { by lemma 429 R->L }
  T(X, rdiv(rdiv(R(Y, U, T), V), K(S, R(Y, Z, W))))
= { by lemma 63 R->L }
  T(X, op(K(R(Y, Z, W), S), rdiv(R(Y, U, T), V)))
= { by lemma 430 R->L }
  T(X, op(rdiv(K(R(Y, Z, W), S), V), R(Y, U, T))) (peak)
= { by lemma 441 }
  T(X, op(rdiv(K(R(Y, Z, W), S), V), R(Y, Z, W))) (peak)
= { by lemma 261 }
  T(X, op(rdiv(zero, V), T(R(Y, Z, W), S)))
= { by lemma 448 }
  T(X, rdiv(T(R(Y, Z, W), S), V))
= { by lemma 449 }
  T(X, rdiv(R(Y, Z, W), V))

Lemma 451: rdiv(X, rdiv(Y, rdiv(R(X, Z, W), X))) = rdiv(R(X, Z, W), Y).
Proof:
  rdiv(X, rdiv(Y, rdiv(R(X, Z, W), X)))
= { by lemma 410 R->L }
  rdiv(X, ldiv(rdiv(R(X, Z, W), Y), X)) (peak)
= { by lemma 94 }
  rdiv(R(X, Z, W), Y)

Lemma 452: T(X, rdiv(R(R(Y, Z, W), V, U), rdiv(R(R(Y, T, S), X2, Y2), Z2))) = T(X, Z2).
Proof:
  T(X, rdiv(R(R(Y, Z, W), V, U), rdiv(R(R(Y, T, S), X2, Y2), Z2))) (peak)
= { by lemma 438 }
  T(X, rdiv(R(Y, Z, W), rdiv(R(R(Y, T, S), X2, Y2), Z2)))
= { by lemma 450 }
  T(X, rdiv(R(Y, T, S), rdiv(R(R(Y, T, S), X2, Y2), Z2)))
= { by lemma 451 R->L }
  T(X, rdiv(R(Y, T, S), rdiv(R(Y, T, S), rdiv(Z2, rdiv(R(R(Y, T, S), X2, Y2), R(Y, T, S)))))) (peak)
= { by lemma 270 }
  T(X, rdiv(Z2, rdiv(R(R(Y, T, S), X2, Y2), R(Y, T, S))))
= { by lemma 440 }
  T(X, Z2)

Lemma 453: rdiv(R(R(X, Y, Z), W, V), T(U, rdiv(R(R(X, T, S), X2, Y2), U))) = ldiv(U, R(R(X, Y, Z), W, V)).
Proof:
  rdiv(R(R(X, Y, Z), W, V), T(U, rdiv(R(R(X, T, S), X2, Y2), U)))
= { by lemma 97 R->L }
  rdiv(R(R(X, Y, Z), W, V), rdiv(U, K(rdiv(R(R(X, T, S), X2, Y2), U), U)))
= { by lemma 188 R->L }
  rdiv(rdiv(R(R(X, Y, Z), W, V), U), K(U, rdiv(R(R(X, T, S), X2, Y2), U)))
= { by lemma 32 R->L }
  rdiv(ldiv(rdiv(R(X, Y, Z), rdiv(R(R(X, Y, Z), W, V), U)), R(X, Y, Z)), K(U, rdiv(R(R(X, T, S), X2, Y2), U)))
= { by lemma 158 R->L }
  ldiv(rdiv(R(X, Y, Z), rdiv(R(R(X, Y, Z), W, V), U)), rdiv(R(X, Y, Z), K(U, rdiv(R(R(X, T, S), X2, Y2), U)))) (peak)
= { by lemma 427 R->L }
  ldiv(rdiv(R(X, Y, Z), rdiv(R(R(X, Y, Z), W, V), U)), op(rdiv(R(R(X, Y, Z), W, V), U), rdiv(R(X, Y, Z), rdiv(R(R(X, Y, Z), W, V), U)))) (peak)
= { by axiom 5 (sos) R->L }
  T(rdiv(R(R(X, Y, Z), W, V), U), rdiv(R(X, Y, Z), rdiv(R(R(X, Y, Z), W, V), U)))
= { by lemma 450 R->L }
  T(rdiv(R(R(X, Y, Z), W, V), U), rdiv(R(X, Z2, W2), rdiv(R(R(X, Y, Z), W, V), U)))
= { by lemma 438 R->L }
  T(rdiv(R(R(X, Y, Z), W, V), U), rdiv(R(R(X, Z2, W2), V2, U2), rdiv(R(R(X, Y, Z), W, V), U))) (peak)
= { by lemma 452 }
  T(rdiv(R(R(X, Y, Z), W, V), U), U)
= { by lemma 50 }
  ldiv(U, R(R(X, Y, Z), W, V))

Lemma 454: op(T(X, Y), rdiv(Z, T(X, Y))) = op(X, rdiv(Z, X)).
Proof:
  op(T(X, Y), rdiv(Z, T(X, Y)))
= { by lemma 32 R->L }
  op(ldiv(rdiv(Z, T(X, Y)), Z), rdiv(Z, T(X, Y)))
= { by lemma 274 R->L }
  rdiv(Z, K(rdiv(Z, T(X, Y)), rdiv(Z, rdiv(Z, T(X, Y))))) (peak)
= { by lemma 271 }
  rdiv(Z, K(rdiv(Z, T(X, Y)), T(rdiv(Z, rdiv(Z, X)), Y)))
= { by lemma 323 }
  rdiv(Z, K(rdiv(Z, X), T(rdiv(Z, rdiv(Z, X)), Y)))
= { by lemma 118 }
  rdiv(Z, K(rdiv(Z, X), rdiv(Z, rdiv(Z, X))))
= { by lemma 274 }
  op(ldiv(rdiv(Z, X), Z), rdiv(Z, X))
= { by lemma 32 }
  op(X, rdiv(Z, X))

Lemma 455: rdiv(R(R(X, Y, Z), W, V), K(rdiv(R(R(X, U, T), S, X2), Y2), Y2)) = op(Y2, rdiv(R(R(X, Y, Z), W, V), Y2)).
Proof:
  rdiv(R(R(X, Y, Z), W, V), K(rdiv(R(R(X, U, T), S, X2), Y2), Y2))
= { by lemma 71 R->L }
  rdiv(R(R(X, Y, Z), W, V), K(rdiv(R(R(X, U, T), S, X2), Y2), T(Y2, rdiv(R(R(X, U, T), S, X2), Y2)))) (peak)
= { by lemma 397 }
  rdiv(R(R(X, Y, Z), W, V), K(rdiv(R(R(X, Y, Z), W, V), Y2), T(Y2, rdiv(R(R(X, U, T), S, X2), Y2))))
= { by lemma 87 R->L }
  rdiv(R(R(X, Y, Z), W, V), K(ldiv(Y2, R(R(X, Y, Z), W, V)), T(Y2, rdiv(R(R(X, U, T), S, X2), Y2))))
= { by lemma 453 R->L }
  rdiv(R(R(X, Y, Z), W, V), K(rdiv(R(R(X, Y, Z), W, V), T(Y2, rdiv(R(R(X, U, T), S, X2), Y2))), T(Y2, rdiv(R(R(X, U, T), S, X2), Y2)))) (peak)
= { by lemma 160 }
  op(T(Y2, rdiv(R(R(X, U, T), S, X2), Y2)), rdiv(R(R(X, Y, Z), W, V), T(Y2, rdiv(R(R(X, U, T), S, X2), Y2))))
= { by lemma 454 }
  op(Y2, rdiv(R(R(X, Y, Z), W, V), Y2))

Lemma 456: K(rdiv(R(X, W, V), Y), Z) = K(rdiv(X, Y), Z).
Proof:
  K(rdiv(R(X, W, V), Y), Z)
= { by lemma 326 R->L }
  K(rdiv(T(R(X, W, V), U), Y), Z)
= { by lemma 273 R->L }
  K(rdiv(R(X, W, V), rdiv(Y, K(R(X, W, V), U))), Z) (peak)
= { by lemma 184 }
  K(rdiv(R(X, W, V), rdiv(Y, K(X, U))), Z)
= { by lemma 64 R->L }
  K(rdiv(R(X, W, V), op(Y, K(U, X))), Z)
= { by lemma 325 R->L }
  K(rdiv(rdiv(R(X, W, V), Y), K(U, X)), Z)
= { by lemma 63 R->L }
  K(op(K(X, U), rdiv(R(X, W, V), Y)), Z)
= { by lemma 319 R->L }
  K(op(rdiv(K(X, U), Y), R(X, W, V)), Z)
= { by lemma 390 }
  K(op(rdiv(K(X, U), Y), X), Z)
= { by lemma 261 }
  K(op(rdiv(zero, Y), T(X, U)), Z)
= { by lemma 319 }
  K(op(zero, rdiv(T(X, U), Y)), Z)
= { by axiom 2 (sos) }
  K(rdiv(T(X, U), Y), Z)
= { by lemma 326 }
  K(rdiv(X, Y), Z)

Lemma 457: K(rdiv(R(X, U, T), W), V) = K(rdiv(R(X, Y, Z), W), V).
Proof:
  K(rdiv(R(X, U, T), W), V)
= { by lemma 326 R->L }
  K(rdiv(T(R(X, U, T), S), W), V)
= { by lemma 273 R->L }
  K(rdiv(R(X, U, T), rdiv(W, K(R(X, U, T), S))), V) (peak)
= { by lemma 202 }
  K(rdiv(R(X, U, T), rdiv(W, K(R(X, Y, Z), S))), V)
= { by lemma 64 R->L }
  K(rdiv(R(X, U, T), op(W, K(S, R(X, Y, Z)))), V)
= { by lemma 325 R->L }
  K(rdiv(rdiv(R(X, U, T), W), K(S, R(X, Y, Z))), V)
= { by lemma 63 R->L }
  K(op(K(R(X, Y, Z), S), rdiv(R(X, U, T), W)), V)
= { by lemma 319 R->L }
  K(op(rdiv(K(R(X, Y, Z), S), W), R(X, U, T)), V) (peak)
= { by lemma 393 }
  K(op(rdiv(K(R(X, Y, Z), S), W), R(X, Y, Z)), V) (peak)
= { by lemma 261 }
  K(op(rdiv(zero, W), T(R(X, Y, Z), S)), V)
= { by lemma 319 }
  K(op(zero, rdiv(T(R(X, Y, Z), S), W)), V)
= { by axiom 2 (sos) }
  K(rdiv(T(R(X, Y, Z), S), W), V)
= { by lemma 326 }
  K(rdiv(R(X, Y, Z), W), V)

Lemma 458: R(X, rdiv(Y, K(Z, W)), V) = R(X, Y, V).
Proof:
  R(X, rdiv(Y, K(Z, W)), V)
= { by lemma 128 R->L }
  op(X, a(X, rdiv(Y, K(Z, W)), V)) (peak)
= { by lemma 166 }
  op(X, a(X, Y, V))
= { by lemma 128 }
  R(X, Y, V)

Lemma 459: R(rdiv(X, K(Y, Z)), W, V) = rdiv(R(X, W, V), K(Y, Z)).
Proof:
  R(rdiv(X, K(Y, Z)), W, V)
= { by lemma 458 R->L }
  R(rdiv(X, K(Y, Z)), rdiv(W, K(Z, Y)), V)
= { by lemma 218 R->L }
  R(rdiv(op(X, W), rdiv(W, K(Z, Y))), rdiv(W, K(Z, Y)), V) (peak)
= { by lemma 371 R->L }
  rdiv(op(R(X, W, V), op(W, V)), op(rdiv(W, K(Z, Y)), V)) (peak)
= { by lemma 165 }
  rdiv(op(R(X, W, V), op(W, V)), rdiv(op(W, V), K(Z, Y)))
= { by lemma 218 }
  rdiv(R(X, W, V), K(Y, Z))

Lemma 460: op(X, rdiv(R(R(Y, Z, W), V, U), X)) = R(op(X, rdiv(R(Y, Z, W), X)), V, U).
Proof:
  op(X, rdiv(R(R(Y, Z, W), V, U), X))
= { by lemma 455 R->L }
  rdiv(R(R(Y, Z, W), V, U), K(rdiv(R(R(Y, T, S), X2, Y2), X), X)) (peak)
= { by lemma 456 }
  rdiv(R(R(Y, Z, W), V, U), K(rdiv(R(Y, T, S), X), X))
= { by lemma 457 }
  rdiv(R(R(Y, Z, W), V, U), K(rdiv(R(Y, Z, W), X), X))
= { by lemma 459 R->L }
  R(rdiv(R(Y, Z, W), K(rdiv(R(Y, Z, W), X), X)), V, U) (peak)
= { by lemma 160 }
  R(op(X, rdiv(R(Y, Z, W), X)), V, U)

Lemma 461: T(X, R(R(Y, T, S), X2, Y2)) = T(X, R(R(Y, Z, W), V, U)).
Proof:
  T(X, R(R(Y, T, S), X2, Y2)) (peak)
= { by lemma 200 }
  T(X, R(Y, T, S))
= { by lemma 200 }
  T(X, Y)
= { by lemma 82 R->L }
  T(X, rdiv(Y, K(Z2, W2)))
= { by lemma 200 R->L }
  T(X, R(rdiv(Y, K(Z2, W2)), Z, W)) (peak)
= { by lemma 459 }
  T(X, rdiv(R(Y, Z, W), K(Z2, W2)))
= { by lemma 82 }
  T(X, R(Y, Z, W))
= { by lemma 200 R->L }
  T(X, R(R(Y, Z, W), V, U)) (peak)

Lemma 462: rdiv(R(R(X, Y, Z), W, V), K(U, R(R(X, T, S), X2, Y2))) = T(R(R(X, Y, Z), W, V), U).
Proof:
  rdiv(R(R(X, Y, Z), W, V), K(U, R(R(X, T, S), X2, Y2)))
= { by lemma 213 R->L }
  rdiv(op(R(R(X, Y, Z), W, V), U), T(U, R(R(X, T, S), X2, Y2))) (peak)
= { by lemma 461 }
  rdiv(op(R(R(X, Y, Z), W, V), U), T(U, R(R(X, Y, Z), W, V))) (peak)
= { by lemma 130 }
  T(R(R(X, Y, Z), W, V), U)

Lemma 463: ldiv(op(rdiv(Z, op(Y, X)), Y), Z) = L(X, Y, rdiv(Z, op(Y, X))).
Proof:
  ldiv(op(rdiv(Z, op(Y, X)), Y), Z)
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(Z, op(Y, X)), Y), op(rdiv(Z, op(Y, X)), op(Y, X))) (peak)
= { by axiom 19 (sos) R->L }
  L(X, Y, rdiv(Z, op(Y, X)))

Lemma 464: rdiv(X, L(Y, Z, rdiv(X, op(Z, Y)))) = op(rdiv(X, op(Z, Y)), Z).
Proof:
  rdiv(X, L(Y, Z, rdiv(X, op(Z, Y)))) (peak)
= { by lemma 463 R->L }
  rdiv(X, ldiv(op(rdiv(X, op(Z, Y)), Z), X)) (peak)
= { by lemma 94 }
  op(rdiv(X, op(Z, Y)), Z)

Lemma 465: op(rdiv(X, op(Y, a(Z, W, V))), Y) = rdiv(X, a(Z, W, V)).
Proof:
  op(rdiv(X, op(Y, a(Z, W, V))), Y)
= { by lemma 464 R->L }
  rdiv(X, L(a(Z, W, V), Y, rdiv(X, op(Y, a(Z, W, V))))) (peak)
= { by lemma 122 R->L }
  rdiv(X, L(a(Z, W, V), Y, rdiv(X, op(a(Z, W, V), Y)))) (peak)
= { by lemma 177 }
  rdiv(X, a(Z, W, V))

Lemma 466: K(X, rdiv(Y, op(X, a(Z, W, V)))) = K(X, rdiv(Y, X)).
Proof:
  K(X, rdiv(Y, op(X, a(Z, W, V))))
= { by lemma 66 R->L }
  ldiv(op(rdiv(Y, op(X, a(Z, W, V))), X), op(X, rdiv(Y, op(X, a(Z, W, V))))) (peak)
= { by lemma 465 }
  ldiv(rdiv(Y, a(Z, W, V)), op(X, rdiv(Y, op(X, a(Z, W, V)))))
= { by lemma 386 }
  ldiv(Y, op(op(X, rdiv(Y, op(X, a(Z, W, V)))), a(Z, W, V)))
= { by lemma 125 }
  ldiv(Y, op(X, op(rdiv(Y, op(X, a(Z, W, V))), a(Z, W, V))))
= { by lemma 375 }
  ldiv(Y, op(X, rdiv(Y, rdiv(op(X, a(Z, W, V)), a(Z, W, V)))))
= { by lemma 175 }
  ldiv(Y, op(X, rdiv(Y, rdiv(X, rdiv(a(Z, W, V), a(Z, W, V))))))
= { by lemma 26 }
  ldiv(Y, op(X, rdiv(Y, rdiv(X, zero))))
= { by lemma 27 }
  ldiv(Y, op(X, rdiv(Y, X)))
= { by lemma 262 }
  K(X, rdiv(Y, X))

Lemma 467: K(X, rdiv(Y, R(X, Z, W))) = K(X, rdiv(Y, X)).
Proof:
  K(X, rdiv(Y, R(X, Z, W)))
= { by lemma 128 R->L }
  K(X, rdiv(Y, op(X, a(X, Z, W)))) (peak)
= { by lemma 466 }
  K(X, rdiv(Y, X))

Lemma 468: K(R(R(X, T, S), X2, Y2), rdiv(U, R(X, Z2, W2))) = K(R(R(X, Y, Z), W, V), rdiv(U, X)).
Proof:
  K(R(R(X, T, S), X2, Y2), rdiv(U, R(X, Z2, W2))) (peak)
= { by lemma 184 }
  K(R(X, T, S), rdiv(U, R(X, Z2, W2)))
= { by lemma 184 }
  K(X, rdiv(U, R(X, Z2, W2)))
= { by lemma 467 }
  K(X, rdiv(U, X))
= { by lemma 184 R->L }
  K(R(X, Y, Z), rdiv(U, X))
= { by lemma 184 R->L }
  K(R(R(X, Y, Z), W, V), rdiv(U, X)) (peak)

Lemma 469: K(R(R(X, X2, Y2), Z2, W2), rdiv(U, R(X, V2, U2))) = K(R(R(X, Y, Z), W, V), rdiv(U, R(X, T, S))).
Proof:
  K(R(R(X, X2, Y2), Z2, W2), rdiv(U, R(X, V2, U2))) (peak)
= { by lemma 468 }
  K(R(R(X, T2, S2), X3, Y3), rdiv(U, X)) (peak)
= { by lemma 184 }
  K(R(X, T2, S2), rdiv(U, X))
= { by lemma 184 }
  K(X, rdiv(U, X))
= { by lemma 467 R->L }
  K(X, rdiv(U, R(X, T, S)))
= { by lemma 184 R->L }
  K(R(X, Y, Z), rdiv(U, R(X, T, S)))
= { by lemma 184 R->L }
  K(R(R(X, Y, Z), W, V), rdiv(U, R(X, T, S))) (peak)

Lemma 470: K(rdiv(X, R(Y, X2, Y2)), R(R(Y, Z2, W2), V2, U2)) = K(rdiv(X, R(Y, Z, W)), R(R(Y, V, U), T, S)).
Proof:
  K(rdiv(X, R(Y, X2, Y2)), R(R(Y, Z2, W2), V2, U2))
= { by lemma 58 R->L }
  rdiv(zero, K(R(R(Y, Z2, W2), V2, U2), rdiv(X, R(Y, X2, Y2)))) (peak)
= { by lemma 469 }
  rdiv(zero, K(R(R(Y, V, U), T, S), rdiv(X, R(Y, Z, W)))) (peak)
= { by lemma 58 }
  K(rdiv(X, R(Y, Z, W)), R(R(Y, V, U), T, S))

Lemma 471: K(rdiv(R(X, Y, Z), X), W) = zero.
Proof:
  K(rdiv(R(X, Y, Z), X), W)
= { by lemma 87 R->L }
  K(ldiv(X, R(X, Y, Z)), W) (peak)
= { by lemma 129 }
  K(a(X, Y, Z), W)
= { by lemma 182 }
  zero

Lemma 472: K(rdiv(R(R(X, Y, Z), W, V), R(X, U, T)), R(R(X, S, X2), Y2, Z2)) = zero.
Proof:
  K(rdiv(R(R(X, Y, Z), W, V), R(X, U, T)), R(R(X, S, X2), Y2, Z2)) (peak)
= { by lemma 470 }
  K(rdiv(R(R(X, Y, Z), W, V), R(X, Y, Z)), R(R(X, W2, V2), U2, T2)) (peak)
= { by lemma 471 }
  zero

Lemma 473: T(R(R(X, Y, Z), W, V), rdiv(R(R(X, U, T), S, X2), R(X, Y2, Z2))) = R(R(X, Y, Z), W, V).
Proof:
  T(R(R(X, Y, Z), W, V), rdiv(R(R(X, U, T), S, X2), R(X, Y2, Z2)))
= { by lemma 462 R->L }
  rdiv(R(R(X, Y, Z), W, V), K(rdiv(R(R(X, U, T), S, X2), R(X, Y2, Z2)), R(R(X, W2, V2), U2, T2))) (peak)
= { by lemma 472 }
  rdiv(R(R(X, Y, Z), W, V), zero)
= { by lemma 27 }
  R(R(X, Y, Z), W, V)

Lemma 474: T(rdiv(X, Y), R(R(Y, Z, W), V, U)) = ldiv(Y, X).
Proof:
  T(rdiv(X, Y), R(R(Y, Z, W), V, U)) (peak)
= { by lemma 200 }
  T(rdiv(X, Y), R(Y, Z, W))
= { by lemma 200 }
  T(rdiv(X, Y), Y)
= { by lemma 50 }
  ldiv(Y, X)

Lemma 475: K(rdiv(X, R(Y, T, S)), R(R(Y, X2, Y2), Z2, W2)) = K(rdiv(X, Y), R(R(Y, Z, W), V, U)).
Proof:
  K(rdiv(X, R(Y, T, S)), R(R(Y, X2, Y2), Z2, W2))
= { by lemma 58 R->L }
  rdiv(zero, K(R(R(Y, X2, Y2), Z2, W2), rdiv(X, R(Y, T, S)))) (peak)
= { by lemma 468 }
  rdiv(zero, K(R(R(Y, Z, W), V, U), rdiv(X, Y))) (peak)
= { by lemma 58 }
  K(rdiv(X, Y), R(R(Y, Z, W), V, U))

Lemma 476: T(R(R(X, Y, Z), W, V), rdiv(U, R(X, T, S))) = T(R(R(X, Y, Z), W, V), rdiv(U, X)).
Proof:
  T(R(R(X, Y, Z), W, V), rdiv(U, R(X, T, S)))
= { by lemma 462 R->L }
  rdiv(R(R(X, Y, Z), W, V), K(rdiv(U, R(X, T, S)), R(R(X, V2, U2), T2, S2))) (peak)
= { by lemma 475 }
  rdiv(R(R(X, Y, Z), W, V), K(rdiv(U, X), R(R(X, X2, Y2), Z2, W2))) (peak)
= { by lemma 462 }
  T(R(R(X, Y, Z), W, V), rdiv(U, X))

Lemma 477: rdiv(ldiv(X, Y), K(rdiv(Y, Z), Z)) = ldiv(X, op(Z, rdiv(Y, Z))).
Proof:
  rdiv(ldiv(X, Y), K(rdiv(Y, Z), Z))
= { by lemma 64 R->L }
  op(ldiv(X, Y), K(Z, rdiv(Y, Z)))
= { by lemma 307 R->L }
  ldiv(R(X, ldiv(X, Y), K(Z, rdiv(Y, Z))), op(Y, K(Z, rdiv(Y, Z)))) (peak)
= { by lemma 48 }
  ldiv(R(X, ldiv(X, Y), K(Z, rdiv(Y, Z))), op(Z, rdiv(Y, Z)))
= { by lemma 105 }
  ldiv(X, op(Z, rdiv(Y, Z)))

Lemma 478: T(X, rdiv(op(Y, rdiv(Z, Y)), W)) = T(X, rdiv(Z, W)).
Proof:
  T(X, rdiv(op(Y, rdiv(Z, Y)), W))
= { by lemma 85 R->L }
  T(X, ldiv(W, op(Y, rdiv(Z, Y))))
= { by lemma 81 R->L }
  L(T(X, ldiv(W, op(Y, rdiv(Z, Y)))), rdiv(Z, W), K(rdiv(Z, Y), Y))
= { by lemma 193 R->L }
  L(T(X, ldiv(W, op(Y, rdiv(Z, Y)))), ldiv(W, Z), K(rdiv(Z, Y), Y))
= { by lemma 189 R->L }
  L(T(X, ldiv(W, op(Y, rdiv(Z, Y)))), rdiv(ldiv(W, Z), K(rdiv(Z, Y), Y)), K(rdiv(Z, Y), Y))
= { by lemma 477 R->L }
  L(T(X, rdiv(ldiv(W, Z), K(rdiv(Z, Y), Y))), rdiv(ldiv(W, Z), K(rdiv(Z, Y), Y)), K(rdiv(Z, Y), Y)) (peak)
= { by lemma 282 }
  ldiv(ldiv(W, Z), op(K(rdiv(Z, Y), Y), op(X, ldiv(K(rdiv(Z, Y), Y), ldiv(W, Z)))))
= { by lemma 63 }
  ldiv(ldiv(W, Z), rdiv(op(X, ldiv(K(rdiv(Z, Y), Y), ldiv(W, Z))), K(Y, rdiv(Z, Y))))
= { by lemma 158 }
  rdiv(ldiv(ldiv(W, Z), op(X, ldiv(K(rdiv(Z, Y), Y), ldiv(W, Z)))), K(Y, rdiv(Z, Y)))
= { by lemma 52 }
  rdiv(ldiv(ldiv(W, Z), op(X, rdiv(ldiv(W, Z), K(rdiv(Z, Y), Y)))), K(Y, rdiv(Z, Y)))
= { by lemma 110 }
  rdiv(ldiv(ldiv(W, Z), rdiv(op(X, ldiv(W, Z)), K(rdiv(Z, Y), Y))), K(Y, rdiv(Z, Y)))
= { by lemma 158 }
  rdiv(rdiv(ldiv(ldiv(W, Z), op(X, ldiv(W, Z))), K(rdiv(Z, Y), Y)), K(Y, rdiv(Z, Y)))
= { by lemma 146 }
  rdiv(ldiv(ldiv(W, Z), op(X, ldiv(W, Z))), rdiv(K(Y, rdiv(Z, Y)), K(Y, rdiv(Z, Y))))
= { by axiom 5 (sos) R->L }
  rdiv(T(X, ldiv(W, Z)), rdiv(K(Y, rdiv(Z, Y)), K(Y, rdiv(Z, Y))))
= { by lemma 85 }
  rdiv(T(X, rdiv(Z, W)), rdiv(K(Y, rdiv(Z, Y)), K(Y, rdiv(Z, Y))))
= { by lemma 26 }
  rdiv(T(X, rdiv(Z, W)), zero)
= { by lemma 27 }
  T(X, rdiv(Z, W))

Lemma 479: T(R(X, Y, X), op(X, Y)) = T(X, Y).
Proof:
  T(R(X, Y, X), op(X, Y)) (peak)
= { by lemma 115 R->L }
  T(R(X, Y, X), op(Y, X))
= { by lemma 207 R->L }
  ldiv(op(Y, X), op(op(X, Y), X)) (peak)
= { by lemma 80 }
  rdiv(X, K(Y, X))
= { by lemma 97 }
  T(X, Y)

Lemma 480: T(R(rdiv(X, Y), Y, rdiv(X, Y)), X) = ldiv(Y, X).
Proof:
  T(R(rdiv(X, Y), Y, rdiv(X, Y)), X)
= { by axiom 9 (sos) R->L }
  T(R(rdiv(X, Y), Y, rdiv(X, Y)), op(rdiv(X, Y), Y)) (peak)
= { by lemma 479 }
  T(rdiv(X, Y), Y)
= { by lemma 50 }
  ldiv(Y, X)

Lemma 481: R(rdiv(X, Y), Y, rdiv(X, Y)) = ldiv(Y, T(X, rdiv(X, Y))).
Proof:
  R(rdiv(X, Y), Y, rdiv(X, Y))
= { by lemma 83 R->L }
  rdiv(T(R(rdiv(X, Y), Y, rdiv(X, Y)), X), K(R(rdiv(X, Y), Y, rdiv(X, Y)), X)) (peak)
= { by lemma 480 }
  rdiv(ldiv(Y, X), K(R(rdiv(X, Y), Y, rdiv(X, Y)), X))
= { by lemma 276 }
  ldiv(Y, T(X, R(rdiv(X, Y), Y, rdiv(X, Y))))
= { by lemma 200 }
  ldiv(Y, T(X, rdiv(X, Y)))

Lemma 482: T(ldiv(X, T(Y, rdiv(Y, X))), Y) = ldiv(X, Y).
Proof:
  T(ldiv(X, T(Y, rdiv(Y, X))), Y)
= { by lemma 481 R->L }
  T(R(rdiv(Y, X), X, rdiv(Y, X)), Y)
= { by axiom 9 (sos) R->L }
  T(R(rdiv(Y, X), X, rdiv(Y, X)), op(rdiv(Y, X), X)) (peak)
= { by lemma 479 }
  T(rdiv(Y, X), X)
= { by lemma 50 }
  ldiv(X, Y)

Lemma 483: T(rdiv(T(X, rdiv(X, Y)), Y), X) = rdiv(X, Y).
Proof:
  T(rdiv(T(X, rdiv(X, Y)), Y), X)
= { by lemma 478 R->L }
  T(rdiv(T(X, rdiv(op(Y, rdiv(X, Y)), Y)), Y), X)
= { by lemma 273 R->L }
  T(rdiv(X, rdiv(Y, K(X, rdiv(op(Y, rdiv(X, Y)), Y)))), X)
= { by lemma 188 R->L }
  T(rdiv(rdiv(X, Y), K(rdiv(op(Y, rdiv(X, Y)), Y), X)), X)
= { by lemma 264 R->L }
  T(ldiv(rdiv(X, rdiv(X, Y)), T(X, rdiv(op(Y, rdiv(X, Y)), Y))), X) (peak)
= { by lemma 280 }
  T(ldiv(rdiv(X, rdiv(X, Y)), T(X, rdiv(X, rdiv(X, rdiv(X, Y))))), X) (peak)
= { by lemma 482 }
  ldiv(rdiv(X, rdiv(X, Y)), X)
= { by lemma 32 }
  rdiv(X, Y)

Lemma 484: ldiv(X, R(R(X, Y, Z), W, V)) = rdiv(R(R(X, Y, Z), W, V), X).
Proof:
  ldiv(X, R(R(X, Y, Z), W, V))
= { by lemma 473 R->L }
  ldiv(X, T(R(R(X, Y, Z), W, V), rdiv(R(R(X, Y, Z), W, V), R(X, U, T))))
= { by lemma 474 R->L }
  T(rdiv(T(R(R(X, Y, Z), W, V), rdiv(R(R(X, Y, Z), W, V), R(X, U, T))), X), R(R(X, Y, Z), W, V)) (peak)
= { by lemma 476 }
  T(rdiv(T(R(R(X, Y, Z), W, V), rdiv(R(R(X, Y, Z), W, V), X)), X), R(R(X, Y, Z), W, V))
= { by lemma 483 }
  rdiv(R(R(X, Y, Z), W, V), X)

Lemma 485: op(X, rdiv(R(R(X, Y, Z), W, V), X)) = R(R(X, Y, Z), W, V).
Proof:
  op(X, rdiv(R(R(X, Y, Z), W, V), X))
= { by lemma 484 R->L }
  op(X, ldiv(X, R(R(X, Y, Z), W, V))) (peak)
= { by axiom 8 (sos) }
  R(R(X, Y, Z), W, V)

Lemma 486: rdiv(R(X, Y, Z), rdiv(X, R(X, W, V))) = R(R(X, W, V), Y, Z).
Proof:
  rdiv(R(X, Y, Z), rdiv(X, R(X, W, V)))
= { by lemma 152 R->L }
  rdiv(R(X, Y, Z), ldiv(R(X, W, V), X)) (peak)
= { by lemma 337 }
  rdiv(R(X, W, V), rdiv(X, R(X, Y, Z)))
= { by lemma 369 R->L }
  op(R(X, Y, Z), ldiv(X, R(X, W, V))) (peak)
= { by lemma 129 }
  op(R(X, Y, Z), a(X, W, V))
= { by lemma 380 }
  R(op(X, a(X, W, V)), Y, Z)
= { by lemma 153 R->L }
  R(op(X, rdiv(R(X, W, V), X)), Y, Z)
= { by lemma 460 R->L }
  op(X, rdiv(R(R(X, W, V), Y, Z), X))
= { by lemma 485 }
  R(R(X, W, V), Y, Z)

Lemma 487: op(X, rdiv(R(Y, Z, W), X)) = R(op(X, rdiv(Y, X)), Z, W).
Proof:
  op(X, rdiv(R(Y, Z, W), X))
= { by lemma 160 R->L }
  rdiv(R(Y, Z, W), K(rdiv(R(Y, Z, W), X), X)) (peak)
= { by lemma 456 }
  rdiv(R(Y, Z, W), K(rdiv(Y, X), X))
= { by lemma 459 R->L }
  R(rdiv(Y, K(rdiv(Y, X), X)), Z, W)
= { by lemma 160 }
  R(op(X, rdiv(Y, X)), Z, W)

Lemma 488: R(R(X, Y, Z), W, V) = R(R(X, W, V), Y, Z).
Proof:
  R(R(X, Y, Z), W, V)
= { by lemma 486 R->L }
  rdiv(R(X, W, V), rdiv(X, R(X, Y, Z)))
= { by lemma 369 R->L }
  op(R(X, Y, Z), ldiv(X, R(X, W, V))) (peak)
= { by lemma 129 }
  op(R(X, Y, Z), a(X, W, V))
= { by lemma 380 }
  R(op(X, a(X, W, V)), Y, Z)
= { by lemma 153 R->L }
  R(op(X, rdiv(R(X, W, V), X)), Y, Z)
= { by lemma 487 R->L }
  op(X, rdiv(R(R(X, W, V), Y, Z), X))
= { by lemma 485 }
  R(R(X, W, V), Y, Z)

Goal 1 (goals): R(R(x11, x12, x13), x14, x15) = R(R(x11, x14, x15), x12, x13).
Proof:
  R(R(x11, x12, x13), x14, x15)
= { by lemma 488 R->L }
  R(R(x11, x14, x15), x12, x13) (peak)

RESULT: Theorem (the conjecture is true).
