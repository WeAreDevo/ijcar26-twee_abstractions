Lemma 52: R(rdiv(X, Y), Y, ldiv(Y, Z)) = rdiv(op(X, ldiv(Y, Z)), Z).
Proof:
  R(rdiv(X, Y), Y, ldiv(Y, Z))
= { by lemma 36 R->L }
  rdiv(op(X, ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 8 (sos) }
  rdiv(op(X, ldiv(Y, Z)), Z)

Lemma 53: R(K(X, Y), Z, ldiv(Z, W)) = K(X, Y).
Proof:
  R(K(X, Y), Z, ldiv(Z, W))
= { by lemma 51 R->L }
  R(rdiv(op(Z, K(X, Y)), Z), Z, ldiv(Z, W)) (peak)
= { by lemma 52 }
  rdiv(op(op(Z, K(X, Y)), ldiv(Z, W)), W) (peak)
= { by lemma 29 }
  rdiv(op(K(X, Y), op(Z, ldiv(Z, W))), W)
= { by axiom 8 (sos) }
  rdiv(op(K(X, Y), W), W)
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 54: R(K(X, Y), Z, W) = K(X, Y).
Proof:
  R(K(X, Y), Z, W)
= { by axiom 4 (sos) R->L }
  R(K(X, Y), Z, ldiv(Z, op(Z, W))) (peak)
= { by lemma 53 }
  K(X, Y)

Lemma 55: op(K(X, Y), Z) = rdiv(Z, K(Y, X)).
Proof:
  op(K(X, Y), Z)
= { by lemma 39 R->L }
  ldiv(R(rdiv(zero, K(X, Y)), K(X, Y), Z), Z) (peak)
= { by lemma 50 }
  ldiv(R(K(Y, X), K(X, Y), Z), Z)
= { by lemma 54 }
  ldiv(K(Y, X), Z)
= { by lemma 44 }
