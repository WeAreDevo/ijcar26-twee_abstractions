The conjecture is true! Here is a proof.

Axiom 1 (sos): op(X, zero) = X.
Axiom 2 (sos): op(zero, X) = X.
Axiom 3 (sos): rdiv(op(X, Y), Y) = X.
Axiom 4 (sos): ldiv(X, op(X, Y)) = Y.
Axiom 5 (sos): T(X, Y) = ldiv(Y, op(X, Y)).
Axiom 6 (sos): K(X, K(Y, Z)) = 1.
Axiom 7 (sos): K(K(X, Y), Z) = 1.
Axiom 8 (sos): op(X, ldiv(X, Y)) = Y.
Axiom 9 (sos): op(rdiv(X, Y), Y) = X.
Axiom 10 (sos): K(X, a(Y, Z, W)) = 1.
Axiom 11 (sos): K(a(X, Y, Z), W) = 1.
Axiom 12 (sos): a(X, K(Y, Z), W) = 1.
Axiom 13 (sos): a(K(X, Y), Z, W) = 1.
Axiom 14 (sos): a(X, Y, a(Z, W, V)) = 1.
Axiom 15 (sos): a(X, a(Y, Z, W), V) = 1.
Axiom 16 (sos): a(a(X, Y, Z), W, V) = 1.
Axiom 17 (sos): op(X, Y) = op(op(Y, X), K(X, Y)).
Axiom 18 (sos): R(X, Y, Z) = rdiv(op(op(X, Y), Z), op(Y, Z)).
Axiom 19 (sos): L(X, Y, Z) = ldiv(op(Z, Y), op(Z, op(Y, X))).
Axiom 20 (sos): op(op(X, Y), Z) = op(op(X, op(Y, Z)), a(X, Y, Z)).

Lemma 21: op(X, K(zero, X)) = X.
Proof:
  op(X, K(zero, X))
= { by axiom 1 (sos) R->L }
  op(op(X, zero), K(zero, X)) (peak)
= { by axiom 17 (sos) R->L }
  op(zero, X)
= { by axiom 2 (sos) }
  X

Lemma 22: ldiv(X, X) = zero.
Proof:
  ldiv(X, X)
= { by axiom 1 (sos) R->L }
  ldiv(X, op(X, zero)) (peak)
= { by axiom 4 (sos) }
  zero

Lemma 23: K(zero, X) = zero.
Proof:
  K(zero, X)
= { by axiom 4 (sos) R->L }
  ldiv(X, op(X, K(zero, X))) (peak)
= { by lemma 21 }
  ldiv(X, X)
= { by lemma 22 }
  zero

Lemma 24: 1 = zero.
Proof:
  1
= { by axiom 6 (sos) R->L }
  K(zero, K(X, Y)) (peak)
= { by lemma 23 }
  zero

Lemma 25: rdiv(X, X) = zero.
Proof:
  rdiv(X, X)
= { by axiom 2 (sos) R->L }
  rdiv(op(zero, X), X) (peak)
= { by axiom 3 (sos) }
  zero

Lemma 26: rdiv(X, zero) = X.
Proof:
  rdiv(X, zero)
= { by axiom 1 (sos) R->L }
  rdiv(op(X, zero), zero) (peak)
= { by axiom 3 (sos) }
  X

Lemma 27: rdiv(op(X, Y), K(X, Y)) = op(Y, X).
Proof:
  rdiv(op(X, Y), K(X, Y))
= { by axiom 17 (sos) }
  rdiv(op(op(Y, X), K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  op(Y, X)

Lemma 28: op(K(X, Y), Z) = op(Z, K(X, Y)).
Proof:
  op(K(X, Y), Z)
= { by lemma 27 R->L }
  rdiv(op(Z, K(X, Y)), K(Z, K(X, Y))) (peak)
= { by axiom 6 (sos) }
  rdiv(op(Z, K(X, Y)), 1)
= { by lemma 24 }
  rdiv(op(Z, K(X, Y)), zero)
= { by lemma 26 }
  op(Z, K(X, Y))

Lemma 29: op(op(X, K(Y, Z)), W) = op(K(Y, Z), op(X, W)).
Proof:
  op(op(X, K(Y, Z)), W) (peak)
= { by lemma 28 R->L }
  op(op(K(Y, Z), X), W)
= { by axiom 20 (sos) }
  op(op(K(Y, Z), op(X, W)), a(K(Y, Z), X, W)) (peak)
= { by lemma 28 }
  op(op(op(X, W), K(Y, Z)), a(K(Y, Z), X, W)) (peak)
= { by axiom 13 (sos) }
  op(op(op(X, W), K(Y, Z)), 1)
= { by lemma 24 }
  op(op(op(X, W), K(Y, Z)), zero)
= { by axiom 1 (sos) }
  op(op(X, W), K(Y, Z))
= { by lemma 28 R->L }
  op(K(Y, Z), op(X, W))

Lemma 30: op(K(X, Y), op(Z, W)) = op(Z, op(W, K(X, Y))).
Proof:
  op(K(X, Y), op(Z, W))
= { by lemma 29 R->L }
  op(op(Z, K(X, Y)), W)
= { by axiom 20 (sos) }
  op(op(Z, op(K(X, Y), W)), a(Z, K(X, Y), W)) (peak)
= { by lemma 28 }
  op(op(Z, op(W, K(X, Y))), a(Z, K(X, Y), W)) (peak)
= { by axiom 12 (sos) }
  op(op(Z, op(W, K(X, Y))), 1)
= { by lemma 24 }
  op(op(Z, op(W, K(X, Y))), zero)
= { by axiom 1 (sos) }
  op(Z, op(W, K(X, Y)))

Lemma 31: op(K(X, Y), op(Y, X)) = op(X, Y).
Proof:
  op(K(X, Y), op(Y, X))
= { by axiom 17 (sos) }
  op(op(op(Y, X), K(X, Y)), K(K(X, Y), op(Y, X))) (peak)
= { by axiom 17 (sos) R->L }
  op(op(X, Y), K(K(X, Y), op(Y, X)))
= { by axiom 7 (sos) }
  op(op(X, Y), 1)
= { by lemma 24 }
  op(op(X, Y), zero)
= { by axiom 1 (sos) }
  op(X, Y)

Lemma 32: op(X, op(Y, K(Y, X))) = op(Y, X).
Proof:
  op(X, op(Y, K(Y, X)))
= { by lemma 30 R->L }
  op(K(Y, X), op(X, Y)) (peak)
= { by lemma 31 }
  op(Y, X)

Lemma 33: op(X, K(X, Y)) = T(X, Y).
Proof:
  op(X, K(X, Y))
= { by axiom 4 (sos) R->L }
  ldiv(Y, op(Y, op(X, K(X, Y)))) (peak)
= { by lemma 32 }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 34: op(op(X, K(Y, X)), Y) = op(Y, X).
Proof:
  op(op(X, K(Y, X)), Y)
= { by lemma 28 R->L }
  op(op(K(Y, X), X), Y)
= { by axiom 20 (sos) }
  op(op(K(Y, X), op(X, Y)), a(K(Y, X), X, Y)) (peak)
= { by lemma 31 }
  op(op(Y, X), a(K(Y, X), X, Y))
= { by axiom 13 (sos) }
  op(op(Y, X), 1)
= { by lemma 24 }
  op(op(Y, X), zero)
= { by axiom 1 (sos) }
  op(Y, X)

Lemma 35: op(X, K(Y, X)) = rdiv(op(Y, X), Y).
Proof:
  op(X, K(Y, X))
= { by axiom 3 (sos) R->L }
  rdiv(op(op(X, K(Y, X)), Y), Y) (peak)
= { by lemma 34 }
  rdiv(op(Y, X), Y)

Lemma 36: rdiv(op(X, Z), op(Y, Z)) = R(rdiv(X, Y), Y, Z).
Proof:
  rdiv(op(X, Z), op(Y, Z))
= { by axiom 9 (sos) R->L }
  rdiv(op(op(rdiv(X, Y), Y), Z), op(Y, Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(rdiv(X, Y), Y, Z)

Lemma 37: R(rdiv(zero, X), X, Y) = rdiv(Y, op(X, Y)).
Proof:
  R(rdiv(zero, X), X, Y) (peak)
= { by lemma 36 R->L }
  rdiv(op(zero, Y), op(X, Y)) (peak)
= { by axiom 2 (sos) }
  rdiv(Y, op(X, Y))

Lemma 38: ldiv(rdiv(X, Y), X) = Y.
Proof:
  ldiv(rdiv(X, Y), X)
= { by axiom 9 (sos) R->L }
  ldiv(rdiv(X, Y), op(rdiv(X, Y), Y)) (peak)
= { by axiom 4 (sos) }
  Y

Lemma 39: ldiv(R(rdiv(zero, X), X, Y), Y) = op(X, Y).
Proof:
  ldiv(R(rdiv(zero, X), X, Y), Y) (peak)
= { by lemma 37 }
  ldiv(rdiv(Y, op(X, Y)), Y) (peak)
= { by lemma 38 }
  op(X, Y)

Lemma 40: op(X, K(Y, rdiv(X, Y))) = op(Y, rdiv(X, Y)).
Proof:
  op(X, K(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  op(op(rdiv(X, Y), Y), K(Y, rdiv(X, Y))) (peak)
= { by axiom 17 (sos) R->L }
  op(Y, rdiv(X, Y))

Lemma 41: op(K(X, Y), rdiv(Z, K(X, Y))) = Z.
Proof:
  op(K(X, Y), rdiv(Z, K(X, Y)))
= { by lemma 40 R->L }
  op(Z, K(K(X, Y), rdiv(Z, K(X, Y)))) (peak)
= { by axiom 7 (sos) }
  op(Z, 1)
= { by lemma 24 }
  op(Z, zero)
= { by axiom 1 (sos) }
  Z

Lemma 42: T(rdiv(X, Y), Y) = ldiv(Y, X).
Proof:
  T(rdiv(X, Y), Y)
= { by axiom 5 (sos) }
  ldiv(Y, op(rdiv(X, Y), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(Y, X)

Lemma 43: T(X, K(Y, Z)) = X.
Proof:
  T(X, K(Y, Z))
= { by axiom 5 (sos) }
  ldiv(K(Y, Z), op(X, K(Y, Z))) (peak)
= { by lemma 28 R->L }
  ldiv(K(Y, Z), op(K(Y, Z), X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 44: ldiv(K(X, Y), Z) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(K(X, Y), Z)
= { by lemma 42 R->L }
  T(rdiv(Z, K(X, Y)), K(X, Y)) (peak)
= { by lemma 43 }
  rdiv(Z, K(X, Y))

Lemma 45: rdiv(op(op(X, Y), ldiv(Y, Z)), Z) = R(X, Y, ldiv(Y, Z)).
Proof:
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z)
= { by axiom 8 (sos) R->L }
  rdiv(op(op(X, Y), ldiv(Y, Z)), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 18 (sos) R->L }
  R(X, Y, ldiv(Y, Z))

Lemma 46: op(op(K(X, Y), Z), W) = op(Z, op(W, K(X, Y))).
Proof:
  op(op(K(X, Y), Z), W) (peak)
= { by lemma 28 }
  op(op(Z, K(X, Y)), W) (peak)
= { by lemma 29 }
  op(K(X, Y), op(Z, W))
= { by lemma 30 }
  op(Z, op(W, K(X, Y)))

Lemma 47: R(X, K(Y, Z), rdiv(W, K(Y, Z))) = X.
Proof:
  R(X, K(Y, Z), rdiv(W, K(Y, Z)))
= { by lemma 44 R->L }
  R(X, K(Y, Z), ldiv(K(Y, Z), W))
= { by lemma 45 R->L }
  rdiv(op(op(X, K(Y, Z)), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 28 R->L }
  rdiv(op(op(K(Y, Z), X), ldiv(K(Y, Z), W)), W) (peak)
= { by lemma 46 }
  rdiv(op(X, op(ldiv(K(Y, Z), W), K(Y, Z))), W)
= { by lemma 44 }
  rdiv(op(X, op(rdiv(W, K(Y, Z)), K(Y, Z))), W)
= { by axiom 9 (sos) }
  rdiv(op(X, W), W)
= { by axiom 3 (sos) }
  X

Lemma 48: rdiv(rdiv(X, K(Y, Z)), X) = rdiv(zero, K(Y, Z)).
Proof:
  rdiv(rdiv(X, K(Y, Z)), X)
= { by lemma 41 R->L }
  rdiv(rdiv(X, K(Y, Z)), op(K(Y, Z), rdiv(X, K(Y, Z)))) (peak)
= { by lemma 37 R->L }
  R(rdiv(zero, K(Y, Z)), K(Y, Z), rdiv(X, K(Y, Z)))
= { by lemma 47 }
  rdiv(zero, K(Y, Z))

Lemma 49: rdiv(op(X, Y), op(Y, X)) = K(X, Y).
Proof:
  rdiv(op(X, Y), op(Y, X))
= { by lemma 31 R->L }
  rdiv(op(K(X, Y), op(Y, X)), op(Y, X)) (peak)
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 50: rdiv(zero, K(X, Y)) = K(Y, X).
Proof:
  rdiv(zero, K(X, Y))
= { by lemma 48 R->L }
  rdiv(rdiv(op(X, Y), K(X, Y)), op(X, Y)) (peak)
= { by lemma 27 }
  rdiv(op(Y, X), op(X, Y))
= { by lemma 49 }
  K(Y, X)

Lemma 51: rdiv(op(X, K(Y, Z)), X) = K(Y, Z).
Proof:
  rdiv(op(X, K(Y, Z)), X) (peak)
= { by lemma 28 R->L }
  rdiv(op(K(Y, Z), X), X) (peak)
= { by axiom 3 (sos) }
