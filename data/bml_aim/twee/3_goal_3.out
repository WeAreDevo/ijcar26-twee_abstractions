Lemma 56: op(X, K(Y, Z)) = rdiv(X, K(Z, Y)).
Proof:
  op(X, K(Y, Z))
= { by axiom 17 (sos) }
  op(op(K(Y, Z), X), K(X, K(Y, Z))) (peak)
= { by lemma 55 }
  op(rdiv(X, K(Z, Y)), K(X, K(Y, Z)))
= { by axiom 6 (sos) }
  op(rdiv(X, K(Z, Y)), 1)
= { by lemma 24 }
  op(rdiv(X, K(Z, Y)), zero)
= { by axiom 1 (sos) }
  rdiv(X, K(Z, Y))

Lemma 57: op(X, T(Y, X)) = op(Y, X).
Proof:
  op(X, T(Y, X))
= { by axiom 5 (sos) }
  op(X, ldiv(X, op(Y, X))) (peak)
= { by axiom 8 (sos) }
  op(Y, X)

Lemma 58: op(K(X, Y), X) = T(X, Y).
Proof:
  op(K(X, Y), X)
= { by axiom 17 (sos) }
  op(op(X, K(X, Y)), K(K(X, Y), X)) (peak)
= { by lemma 33 }
  op(T(X, Y), K(K(X, Y), X))
= { by axiom 7 (sos) }
  op(T(X, Y), 1)
= { by lemma 24 }
  op(T(X, Y), zero)
= { by axiom 1 (sos) }
  T(X, Y)

Lemma 59: op(K(X, Y), Y) = rdiv(op(X, Y), X).
Proof:
  op(K(X, Y), Y)
= { by axiom 17 (sos) }
  op(op(Y, K(X, Y)), K(K(X, Y), Y)) (peak)
= { by lemma 35 }
  op(rdiv(op(X, Y), X), K(K(X, Y), Y)) (peak)
= { by axiom 7 (sos) }
  op(rdiv(op(X, Y), X), 1)
= { by lemma 24 }
  op(rdiv(op(X, Y), X), zero)
= { by axiom 1 (sos) }
  rdiv(op(X, Y), X)

Lemma 60: ldiv(X, T(X, Y)) = K(X, Y).
Proof:
  ldiv(X, T(X, Y))
= { by lemma 33 R->L }
  ldiv(X, op(X, K(X, Y))) (peak)
= { by axiom 4 (sos) }
  K(X, Y)

Lemma 61: rdiv(X, ldiv(Y, X)) = Y.
Proof:
  rdiv(X, ldiv(Y, X))
= { by axiom 8 (sos) R->L }
  rdiv(op(Y, ldiv(Y, X)), ldiv(Y, X)) (peak)
= { by axiom 3 (sos) }
  Y

Lemma 62: rdiv(op(X, Y), T(X, Y)) = Y.
Proof:
  rdiv(op(X, Y), T(X, Y))
= { by axiom 5 (sos) }
  rdiv(op(X, Y), ldiv(Y, op(X, Y))) (peak)
= { by lemma 61 }
  Y

Lemma 63: rdiv(T(X, Y), X) = K(X, Y).
Proof:
  rdiv(T(X, Y), X)
= { by lemma 43 R->L }
  rdiv(T(X, Y), T(X, K(X, Y)))
= { by lemma 33 R->L }
  rdiv(op(X, K(X, Y)), T(X, K(X, Y))) (peak)
= { by lemma 62 }
  K(X, Y)

Lemma 64: ldiv(X, T(X, Y)) = rdiv(T(X, Y), X).
Proof:
  ldiv(X, T(X, Y)) (peak)
= { by lemma 60 }
  K(X, Y)
= { by lemma 63 R->L }
  rdiv(T(X, Y), X)

Lemma 65: ldiv(X, rdiv(op(Y, X), Y)) = K(Y, X).
Proof:
  ldiv(X, rdiv(op(Y, X), Y)) (peak)
= { by lemma 35 R->L }
  ldiv(X, op(X, K(Y, X))) (peak)
= { by axiom 4 (sos) }
  K(Y, X)

Lemma 66: K(X, T(Y, X)) = ldiv(T(Y, X), Y).
Proof:
  K(X, T(Y, X))
= { by lemma 65 R->L }
  ldiv(T(Y, X), rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 57 }
  ldiv(T(Y, X), rdiv(op(Y, X), X))
= { by axiom 3 (sos) }
  ldiv(T(Y, X), Y)

Lemma 67: ldiv(op(X, Y), op(Y, X)) = K(Y, X).
Proof:
  ldiv(op(X, Y), op(Y, X))
= { by axiom 17 (sos) }
  ldiv(op(X, Y), op(op(X, Y), K(Y, X))) (peak)
= { by axiom 4 (sos) }
  K(Y, X)

Lemma 68: K(X, rdiv(op(X, Y), X)) = L(K(X, Y), Y, X).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 35 R->L }
  K(X, op(Y, K(X, Y)))
= { by lemma 67 R->L }
  ldiv(op(op(Y, K(X, Y)), X), op(X, op(Y, K(X, Y)))) (peak)
= { by lemma 34 }
  ldiv(op(X, Y), op(X, op(Y, K(X, Y))))
= { by axiom 19 (sos) R->L }
  L(K(X, Y), Y, X)

Lemma 69: T(K(X, Y), Z) = K(X, Y).
Proof:
  T(K(X, Y), Z)
= { by axiom 5 (sos) }
  ldiv(Z, op(K(X, Y), Z)) (peak)
= { by lemma 28 }
  ldiv(Z, op(Z, K(X, Y))) (peak)
= { by axiom 4 (sos) }
  K(X, Y)

Lemma 70: L(K(X, Y), Z, W) = K(X, Y).
Proof:
  L(K(X, Y), Z, W)
= { by axiom 19 (sos) }
  ldiv(op(W, Z), op(W, op(Z, K(X, Y)))) (peak)
= { by lemma 30 R->L }
  ldiv(op(W, Z), op(K(X, Y), op(W, Z))) (peak)
= { by axiom 5 (sos) R->L }
  T(K(X, Y), op(W, Z))
= { by lemma 69 }
  K(X, Y)

Lemma 71: K(X, rdiv(op(X, Y), X)) = K(X, Y).
Proof:
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 68 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 70 }
  K(X, Y)

Lemma 72: K(X, T(Y, X)) = K(X, Y).
Proof:
  K(X, T(Y, X))
= { by lemma 71 R->L }
  K(X, rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 57 }
  K(X, rdiv(op(Y, X), X))
= { by axiom 3 (sos) }
  K(X, Y)

Lemma 73: ldiv(T(X, Y), X) = K(Y, X).
Proof:
  ldiv(T(X, Y), X) (peak)
= { by lemma 66 R->L }
  K(Y, T(X, Y)) (peak)
= { by lemma 72 }
  K(Y, X)

Lemma 74: T(X, ldiv(X, Y)) = ldiv(ldiv(X, Y), Y).
Proof:
  T(X, ldiv(X, Y))
= { by axiom 5 (sos) }
  ldiv(ldiv(X, Y), op(X, ldiv(X, Y))) (peak)
= { by axiom 8 (sos) }
  ldiv(ldiv(X, Y), Y)

Lemma 75: rdiv(X, T(Y, ldiv(Y, X))) = ldiv(Y, X).
Proof:
  rdiv(X, T(Y, ldiv(Y, X))) (peak)
= { by lemma 74 }
  rdiv(X, ldiv(ldiv(Y, X), X)) (peak)
= { by lemma 61 }
  ldiv(Y, X)

Lemma 76: T(X, ldiv(T(Y, Z), Y)) = X.
Proof:
  T(X, ldiv(T(Y, Z), Y)) (peak)
= { by lemma 66 R->L }
  T(X, K(Z, T(Y, Z))) (peak)
= { by lemma 43 }
  X

Lemma 77: ldiv(T(X, Y), X) = rdiv(X, T(X, Y)).
Proof:
  ldiv(T(X, Y), X)
= { by lemma 75 R->L }
  rdiv(X, T(T(X, Y), ldiv(T(X, Y), X))) (peak)
= { by lemma 76 }
  rdiv(X, T(X, Y))

Lemma 78: rdiv(X, K(Y, X)) = T(X, Y).
Proof:
  rdiv(X, K(Y, X))
= { by lemma 73 R->L }
  rdiv(X, ldiv(T(X, Y), X)) (peak)
= { by lemma 61 }
  T(X, Y)

Lemma 79: L(rdiv(X, T(X, Y)), Z, W) = rdiv(X, T(X, Y)).
Proof:
  L(rdiv(X, T(X, Y)), Z, W)
= { by lemma 77 R->L }
  L(ldiv(T(X, Y), X), Z, W) (peak)
= { by lemma 66 R->L }
  L(K(Y, T(X, Y)), Z, W) (peak)
= { by lemma 70 }
  K(Y, T(X, Y))
= { by lemma 66 }
  ldiv(T(X, Y), X) (peak)
= { by lemma 77 }
  rdiv(X, T(X, Y))

Lemma 80: ldiv(op(Z, X), op(Z, Y)) = L(ldiv(X, Y), X, Z).
Proof:
  ldiv(op(Z, X), op(Z, Y))
= { by axiom 8 (sos) R->L }
  ldiv(op(Z, X), op(Z, op(X, ldiv(X, Y)))) (peak)
= { by axiom 19 (sos) R->L }
  L(ldiv(X, Y), X, Z)

Lemma 81: L(rdiv(X, T(X, Y)), T(X, Y), Y) = K(Y, X).
Proof:
  L(rdiv(X, T(X, Y)), T(X, Y), Y)
= { by lemma 77 R->L }
  L(ldiv(T(X, Y), X), T(X, Y), Y) (peak)
= { by lemma 80 R->L }
  ldiv(op(Y, T(X, Y)), op(Y, X))
= { by lemma 57 }
  ldiv(op(X, Y), op(Y, X))
= { by lemma 67 }
  K(Y, X)

Lemma 82: rdiv(Y, T(Y, X)) = K(X, Y).
Proof:
  rdiv(Y, T(Y, X))
= { by lemma 79 R->L }
  L(rdiv(Y, T(Y, X)), T(Y, X), X) (peak)
= { by lemma 81 }
  K(X, Y)

Lemma 83: rdiv(T(X, Y), K(X, Y)) = X.
Proof:
  rdiv(T(X, Y), K(X, Y))
= { by lemma 33 R->L }
  rdiv(op(X, K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  X

Lemma 84: ldiv(T(X, Y), op(X, Y)) = T(Y, T(X, Y)).
Proof:
  ldiv(T(X, Y), op(X, Y))
= { by lemma 57 R->L }
  ldiv(T(X, Y), op(Y, T(X, Y))) (peak)
= { by axiom 5 (sos) R->L }
  T(Y, T(X, Y))

Lemma 85: ldiv(op(X, Y), op(X, op(Z, Y))) = L(T(Z, Y), Y, X).
Proof:
  ldiv(op(X, Y), op(X, op(Z, Y))) (peak)
= { by lemma 80 }
  L(ldiv(Y, op(Z, Y)), Y, X) (peak)
= { by axiom 5 (sos) R->L }
  L(T(Z, Y), Y, X)

Lemma 86: op(op(X, Y), K(Z, W)) = op(X, op(Y, K(Z, W))).
Proof:
  op(op(X, Y), K(Z, W)) (peak)
= { by lemma 28 R->L }
  op(K(Z, W), op(X, Y)) (peak)
= { by lemma 30 }
  op(X, op(Y, K(Z, W))) (peak)

Lemma 87: L(T(X, Y), Y, K(Z, W)) = T(X, rdiv(Y, K(W, Z))).
Proof:
  L(T(X, Y), Y, K(Z, W))
= { by lemma 85 R->L }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(X, Y))) (peak)
= { by lemma 28 }
  ldiv(op(K(Z, W), Y), op(op(X, Y), K(Z, W))) (peak)
= { by lemma 55 }
  ldiv(rdiv(Y, K(W, Z)), op(op(X, Y), K(Z, W)))
= { by lemma 86 }
  ldiv(rdiv(Y, K(W, Z)), op(X, op(Y, K(Z, W))))
= { by lemma 56 }
  ldiv(rdiv(Y, K(W, Z)), op(X, rdiv(Y, K(W, Z))))
= { by axiom 5 (sos) R->L }
  T(X, rdiv(Y, K(W, Z)))

Lemma 88: R(X, K(Y, Z), W) = X.
Proof:
  R(X, K(Y, Z), W)
= { by axiom 3 (sos) R->L }
  R(X, K(Y, Z), rdiv(op(W, K(Y, Z)), K(Y, Z))) (peak)
= { by lemma 47 }
  X

Lemma 89: ldiv(R(X, Y, Z), op(op(X, Y), Z)) = op(Y, Z).
Proof:
  ldiv(R(X, Y, Z), op(op(X, Y), Z))
= { by axiom 18 (sos) }
  ldiv(rdiv(op(op(X, Y), Z), op(Y, Z)), op(op(X, Y), Z)) (peak)
= { by lemma 38 }
  op(Y, Z)

Lemma 90: ldiv(op(X, Y), op(op(Y, X), Z)) = rdiv(Z, K(X, Y)).
Proof:
  ldiv(op(X, Y), op(op(Y, X), Z))
= { by lemma 88 R->L }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(Y, X), Z))
= { by axiom 17 (sos) }
  ldiv(R(op(X, Y), K(Y, X), Z), op(op(op(X, Y), K(Y, X)), Z)) (peak)
= { by lemma 89 }
  op(K(Y, X), Z)
= { by lemma 55 }
  rdiv(Z, K(X, Y))

Lemma 91: L(X, Y, K(Z, W)) = X.
Proof:
  L(X, Y, K(Z, W))
= { by axiom 19 (sos) }
  ldiv(op(K(Z, W), Y), op(K(Z, W), op(Y, X)))
= { by lemma 29 R->L }
  ldiv(op(K(Z, W), Y), op(op(Y, K(Z, W)), X)) (peak)
= { by lemma 90 }
  rdiv(X, K(K(Z, W), Y))
= { by axiom 7 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 26 }
  X

Lemma 92: T(X, rdiv(Y, K(Z, W))) = T(X, Y).
Proof:
  T(X, rdiv(Y, K(Z, W)))
= { by lemma 87 R->L }
  L(T(X, Y), Y, K(W, Z)) (peak)
= { by lemma 91 }
  T(X, Y)

Lemma 93: T(X, T(Y, Z)) = T(X, Y).
Proof:
  T(X, T(Y, Z))
= { by lemma 92 R->L }
  T(X, rdiv(T(Y, Z), K(Y, Z))) (peak)
= { by lemma 83 }
  T(X, Y)

Lemma 94: ldiv(ldiv(ldiv(X, Y), Y), Y) = T(ldiv(X, Y), X).
Proof:
  ldiv(ldiv(ldiv(X, Y), Y), Y)
= { by axiom 8 (sos) R->L }
  ldiv(ldiv(ldiv(X, Y), Y), op(X, ldiv(X, Y))) (peak)
= { by lemma 74 R->L }
  ldiv(T(X, ldiv(X, Y)), op(X, ldiv(X, Y))) (peak)
= { by lemma 84 }
  T(ldiv(X, Y), T(X, ldiv(X, Y)))
= { by lemma 93 }
  T(ldiv(X, Y), X)

Lemma 95: T(X, rdiv(Y, X)) = ldiv(ldiv(X, Y), Y).
Proof:
  T(X, rdiv(Y, X))
= { by lemma 38 R->L }
  T(ldiv(rdiv(Y, X), Y), rdiv(Y, X)) (peak)
= { by lemma 94 R->L }
  ldiv(ldiv(ldiv(rdiv(Y, X), Y), Y), Y) (peak)
= { by lemma 38 }
  ldiv(ldiv(X, Y), Y)

Lemma 96: T(X, rdiv(op(X, Y), X)) = T(X, Y).
Proof:
  T(X, rdiv(op(X, Y), X))
= { by lemma 95 }
  ldiv(ldiv(X, op(X, Y)), op(X, Y)) (peak)
= { by axiom 4 (sos) }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 97: K(rdiv(op(X, Y), X), X) = K(Y, X).
Proof:
  K(rdiv(op(X, Y), X), X)
= { by lemma 72 R->L }
  K(rdiv(op(X, Y), X), T(X, rdiv(op(X, Y), X))) (peak)
= { by lemma 66 }
  ldiv(T(X, rdiv(op(X, Y), X)), X)
= { by lemma 96 }
  ldiv(T(X, Y), X)
= { by lemma 73 }
  K(Y, X)

Lemma 98: rdiv(op(X, Y), X) = rdiv(Y, K(Y, X)).
Proof:
  rdiv(op(X, Y), X)
= { by lemma 83 R->L }
  rdiv(T(rdiv(op(X, Y), X), X), K(rdiv(op(X, Y), X), X)) (peak)
= { by lemma 97 }
  rdiv(T(rdiv(op(X, Y), X), X), K(Y, X))
= { by lemma 42 }
  rdiv(ldiv(X, op(X, Y)), K(Y, X))
= { by axiom 4 (sos) }
  rdiv(Y, K(Y, X))

Lemma 99: R(rdiv(zero, X), X, ldiv(X, Y)) = rdiv(ldiv(X, Y), Y).
Proof:
  R(rdiv(zero, X), X, ldiv(X, Y)) (peak)
= { by lemma 52 }
  rdiv(op(zero, ldiv(X, Y)), Y) (peak)
= { by axiom 2 (sos) }
  rdiv(ldiv(X, Y), Y)

Lemma 100: R(X, Y, K(Z, W)) = X.
Proof:
  R(X, Y, K(Z, W))
= { by axiom 18 (sos) }
  rdiv(op(op(X, Y), K(Z, W)), op(Y, K(Z, W))) (peak)
= { by lemma 86 }
  rdiv(op(X, op(Y, K(Z, W))), op(Y, K(Z, W)))
= { by axiom 3 (sos) }
  X

Lemma 101: rdiv(K(X, Y), Y) = rdiv(zero, T(Y, X)).
Proof:
  rdiv(K(X, Y), Y)
= { by lemma 72 R->L }
  rdiv(K(X, T(Y, X)), Y) (peak)
= { by lemma 66 }
  rdiv(ldiv(T(Y, X), Y), Y)
= { by lemma 99 R->L }
  R(rdiv(zero, T(Y, X)), T(Y, X), ldiv(T(Y, X), Y)) (peak)
= { by lemma 73 }
  R(rdiv(zero, T(Y, X)), T(Y, X), K(X, Y))
= { by lemma 100 }
  rdiv(zero, T(Y, X))

Lemma 102: K(X, ldiv(X, Y)) = K(X, rdiv(Y, X)).
Proof:
  K(X, ldiv(X, Y))
= { by lemma 71 R->L }
  K(X, rdiv(op(X, ldiv(X, Y)), X)) (peak)
= { by axiom 8 (sos) }
  K(X, rdiv(Y, X))

Lemma 103: K(X, T(Y, Z)) = K(X, Y).
Proof:
  K(X, T(Y, Z))
= { by lemma 60 R->L }
  ldiv(X, T(X, T(Y, Z))) (peak)
= { by lemma 93 }
  ldiv(X, T(X, Y))
= { by lemma 60 }
  K(X, Y)

Lemma 104: K(X, ldiv(Y, Z)) = K(X, rdiv(Z, Y)).
Proof:
  K(X, ldiv(Y, Z))
= { by lemma 42 R->L }
  K(X, T(rdiv(Z, Y), Y)) (peak)
= { by lemma 103 }
  K(X, rdiv(Z, Y))

Lemma 105: rdiv(op(X, T(Y, X)), X) = Y.
Proof:
  rdiv(op(X, T(Y, X)), X) (peak)
= { by lemma 57 }
  rdiv(op(Y, X), X)
= { by axiom 3 (sos) }
  Y

Lemma 106: K(X, T(Y, X)) = rdiv(Y, T(Y, X)).
Proof:
  K(X, T(Y, X))
= { by lemma 65 R->L }
  ldiv(T(Y, X), rdiv(op(X, T(Y, X)), X)) (peak)
= { by lemma 105 }
  ldiv(T(Y, X), Y)
= { by lemma 77 }
  rdiv(Y, T(Y, X))

Lemma 107: T(X, ldiv(X, Y)) = T(X, rdiv(Y, X)).
Proof:
  T(X, ldiv(X, Y))
= { by lemma 33 R->L }
  op(X, K(X, ldiv(X, Y))) (peak)
= { by lemma 102 }
  op(X, K(X, rdiv(Y, X)))
= { by lemma 33 }
  T(X, rdiv(Y, X))

Lemma 108: K(ldiv(X, Y), X) = K(rdiv(Y, X), X).
Proof:
  K(ldiv(X, Y), X)
= { by lemma 72 R->L }
  K(ldiv(X, Y), T(X, ldiv(X, Y))) (peak)
= { by lemma 66 }
  ldiv(T(X, ldiv(X, Y)), X)
= { by lemma 107 }
  ldiv(T(X, rdiv(Y, X)), X)
= { by lemma 73 }
  K(rdiv(Y, X), X)

Lemma 109: op(X, rdiv(Y, K(Y, X))) = op(T(X, Y), Y).
Proof:
  op(X, rdiv(Y, K(Y, X)))
= { by lemma 72 R->L }
  op(X, rdiv(Y, K(Y, T(X, Y))))
= { by lemma 56 R->L }
  op(X, op(Y, K(T(X, Y), Y)))
= { by lemma 86 R->L }
  op(op(X, Y), K(T(X, Y), Y))
= { by lemma 57 R->L }
  op(op(Y, T(X, Y)), K(T(X, Y), Y)) (peak)
= { by axiom 17 (sos) R->L }
  op(T(X, Y), Y)

Lemma 110: K(X, rdiv(Y, K(Y, X))) = K(X, Y).
Proof:
  K(X, rdiv(Y, K(Y, X)))
= { by lemma 55 R->L }
  K(X, op(K(X, Y), Y)) (peak)
= { by lemma 59 }
  K(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 68 }
  L(K(X, Y), Y, X) (peak)
= { by lemma 70 }
  K(X, Y)

Lemma 111: rdiv(X, T(ldiv(Y, X), Y)) = ldiv(ldiv(Y, X), X).
Proof:
  rdiv(X, T(ldiv(Y, X), Y)) (peak)
= { by lemma 94 R->L }
  rdiv(X, ldiv(ldiv(ldiv(Y, X), X), X)) (peak)
= { by lemma 61 }
  ldiv(ldiv(Y, X), X)

Lemma 112: rdiv(op(X, Y), T(Y, X)) = T(X, Y).
Proof:
  rdiv(op(X, Y), T(Y, X))
= { by axiom 4 (sos) R->L }
  rdiv(op(X, Y), T(ldiv(X, op(X, Y)), X)) (peak)
= { by lemma 111 }
  ldiv(ldiv(X, op(X, Y)), op(X, Y))
= { by axiom 4 (sos) }
  ldiv(Y, op(X, Y))
= { by axiom 5 (sos) R->L }
  T(X, Y)

Lemma 113: op(T(X, Y), T(Y, X)) = op(X, Y).
Proof:
  op(T(X, Y), T(Y, X))
= { by lemma 112 R->L }
  op(rdiv(op(X, Y), T(Y, X)), T(Y, X)) (peak)
= { by axiom 9 (sos) }
  op(X, Y)

Lemma 114: op(rdiv(X, K(X, Y)), Y) = op(Y, X).
Proof:
  op(rdiv(X, K(X, Y)), Y)
= { by axiom 17 (sos) }
  op(op(Y, rdiv(X, K(X, Y))), K(rdiv(X, K(X, Y)), Y)) (peak)
= { by lemma 109 }
  op(op(T(Y, X), X), K(rdiv(X, K(X, Y)), Y))
= { by lemma 86 }
  op(T(Y, X), op(X, K(rdiv(X, K(X, Y)), Y)))
= { by lemma 56 }
  op(T(Y, X), rdiv(X, K(Y, rdiv(X, K(X, Y)))))
= { by lemma 110 }
  op(T(Y, X), rdiv(X, K(Y, X)))
= { by lemma 78 }
  op(T(Y, X), T(X, Y))
= { by lemma 113 }
  op(Y, X)

Lemma 115: op(X, rdiv(Y, K(Z, W))) = rdiv(op(X, Y), K(Z, W)).
Proof:
  op(X, rdiv(Y, K(Z, W)))
= { by lemma 56 R->L }
  op(X, op(Y, K(W, Z)))
= { by lemma 46 R->L }
  op(op(K(W, Z), X), Y)
= { by lemma 114 R->L }
  op(op(rdiv(X, K(X, K(W, Z))), K(W, Z)), Y) (peak)
= { by lemma 29 }
  op(K(W, Z), op(rdiv(X, K(X, K(W, Z))), Y))
= { by lemma 55 }
  rdiv(op(rdiv(X, K(X, K(W, Z))), Y), K(Z, W))
= { by axiom 6 (sos) }
  rdiv(op(rdiv(X, 1), Y), K(Z, W))
= { by lemma 24 }
  rdiv(op(rdiv(X, zero), Y), K(Z, W))
= { by lemma 26 }
  rdiv(op(X, Y), K(Z, W))

Lemma 116: rdiv(op(op(X, Y), Z), a(X, Y, Z)) = op(X, op(Y, Z)).
Proof:
  rdiv(op(op(X, Y), Z), a(X, Y, Z))
= { by axiom 20 (sos) }
  rdiv(op(op(X, op(Y, Z)), a(X, Y, Z)), a(X, Y, Z)) (peak)
= { by axiom 3 (sos) }
  op(X, op(Y, Z))

Lemma 117: rdiv(op(op(X, Y), Z), K(X, Y)) = op(op(Y, X), Z).
Proof:
  rdiv(op(op(X, Y), Z), K(X, Y))
= { by lemma 115 R->L }
  op(op(X, Y), rdiv(Z, K(X, Y)))
= { by lemma 55 R->L }
  op(op(X, Y), op(K(Y, X), Z))
= { by lemma 116 R->L }
  rdiv(op(op(op(X, Y), K(Y, X)), Z), a(op(X, Y), K(Y, X), Z)) (peak)
= { by axiom 17 (sos) R->L }
  rdiv(op(op(Y, X), Z), a(op(X, Y), K(Y, X), Z))
= { by axiom 12 (sos) }
  rdiv(op(op(Y, X), Z), 1)
= { by lemma 24 }
  rdiv(op(op(Y, X), Z), zero)
= { by lemma 26 }
  op(op(Y, X), Z)

Lemma 118: rdiv(op(X, op(Y, Z)), K(Y, Z)) = op(X, op(Z, Y)).
Proof:
  rdiv(op(X, op(Y, Z)), K(Y, Z))
= { by lemma 55 R->L }
  op(K(Z, Y), op(X, op(Y, Z)))
= { by lemma 29 R->L }
  op(op(X, K(Z, Y)), op(Y, Z))
= { by axiom 20 (sos) }
  op(op(X, op(K(Z, Y), op(Y, Z))), a(X, K(Z, Y), op(Y, Z))) (peak)
= { by lemma 31 }
  op(op(X, op(Z, Y)), a(X, K(Z, Y), op(Y, Z)))
= { by axiom 12 (sos) }
  op(op(X, op(Z, Y)), 1)
= { by lemma 24 }
  op(op(X, op(Z, Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(Z, Y))

Lemma 119: op(op(X, Y), T(Z, op(Y, X))) = op(Z, op(X, Y)).
Proof:
  op(op(X, Y), T(Z, op(Y, X)))
= { by lemma 117 R->L }
  rdiv(op(op(Y, X), T(Z, op(Y, X))), K(Y, X)) (peak)
= { by lemma 57 }
  rdiv(op(Z, op(Y, X)), K(Y, X))
= { by lemma 118 }
  op(Z, op(X, Y))

Lemma 120: T(X, op(Y, Z)) = T(X, op(Z, Y)).
Proof:
  T(X, op(Y, Z))
= { by axiom 4 (sos) R->L }
  ldiv(op(Z, Y), op(op(Z, Y), T(X, op(Y, Z)))) (peak)
= { by lemma 119 }
  ldiv(op(Z, Y), op(X, op(Z, Y)))
= { by axiom 5 (sos) R->L }
  T(X, op(Z, Y))

Lemma 121: op(a(X, Y, Z), W) = op(W, a(X, Y, Z)).
Proof:
  op(a(X, Y, Z), W)
= { by lemma 27 R->L }
  rdiv(op(W, a(X, Y, Z)), K(W, a(X, Y, Z))) (peak)
= { by axiom 10 (sos) }
  rdiv(op(W, a(X, Y, Z)), 1)
= { by lemma 24 }
  rdiv(op(W, a(X, Y, Z)), zero)
= { by lemma 26 }
  op(W, a(X, Y, Z))

Lemma 122: op(a(X, Y, Z), rdiv(W, a(X, Y, Z))) = W.
Proof:
  op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))
= { by lemma 40 R->L }
  op(W, K(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 11 (sos) }
  op(W, 1)
= { by lemma 24 }
  op(W, zero)
= { by axiom 1 (sos) }
  W

Lemma 123: ldiv(a(X, Y, Z), W) = rdiv(W, a(X, Y, Z)).
Proof:
  ldiv(a(X, Y, Z), W)
= { by lemma 122 R->L }
  ldiv(a(X, Y, Z), op(a(X, Y, Z), rdiv(W, a(X, Y, Z)))) (peak)
= { by axiom 4 (sos) }
  rdiv(W, a(X, Y, Z))

Lemma 124: op(op(X, Y), a(Z, W, V)) = op(X, op(Y, a(Z, W, V))).
Proof:
  op(op(X, Y), a(Z, W, V))
= { by axiom 20 (sos) }
  op(op(X, op(Y, a(Z, W, V))), a(X, Y, a(Z, W, V))) (peak)
= { by lemma 121 R->L }
  op(op(X, op(a(Z, W, V), Y)), a(X, Y, a(Z, W, V))) (peak)
= { by axiom 14 (sos) }
  op(op(X, op(a(Z, W, V), Y)), 1)
= { by lemma 24 }
  op(op(X, op(a(Z, W, V), Y)), zero)
= { by axiom 1 (sos) }
  op(X, op(a(Z, W, V), Y))
= { by lemma 121 }
  op(X, op(Y, a(Z, W, V)))

Lemma 125: R(X, Y, a(Z, W, V)) = X.
Proof:
  R(X, Y, a(Z, W, V))
= { by axiom 18 (sos) }
  rdiv(op(op(X, Y), a(Z, W, V)), op(Y, a(Z, W, V))) (peak)
= { by lemma 124 }
  rdiv(op(X, op(Y, a(Z, W, V))), op(Y, a(Z, W, V)))
= { by axiom 3 (sos) }
  X

Lemma 126: op(X, op(Y, a(Z, X, Y))) = ldiv(Z, op(op(Z, X), Y)).
Proof:
  op(X, op(Y, a(Z, X, Y)))
= { by lemma 124 R->L }
  op(op(X, Y), a(Z, X, Y))
= { by lemma 89 R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, op(X, Y)), a(Z, X, Y))) (peak)
= { by axiom 20 (sos) R->L }
  ldiv(R(Z, op(X, Y), a(Z, X, Y)), op(op(Z, X), Y))
= { by lemma 125 }
  ldiv(Z, op(op(Z, X), Y))

Lemma 127: ldiv(Z, ldiv(Y, op(op(Y, Z), X))) = op(X, a(Y, Z, X)).
Proof:
  ldiv(Z, ldiv(Y, op(op(Y, Z), X))) (peak)
= { by lemma 126 R->L }
  ldiv(Z, op(Z, op(X, a(Y, Z, X)))) (peak)
= { by axiom 4 (sos) }
  op(X, a(Y, Z, X))

Lemma 128: op(op(X, Y), L(Z, Y, X)) = op(X, op(Y, Z)).
Proof:
  op(op(X, Y), L(Z, Y, X))
= { by axiom 19 (sos) }
  op(op(X, Y), ldiv(op(X, Y), op(X, op(Y, Z)))) (peak)
= { by axiom 8 (sos) }
  op(X, op(Y, Z))

Lemma 129: op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))) = X.
Proof:
  op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))) (peak)
= { by lemma 127 R->L }
  ldiv(Y, ldiv(Z, op(op(Z, Y), L(X, Y, Z))))
= { by lemma 128 }
  ldiv(Y, ldiv(Z, op(Z, op(Y, X))))
= { by axiom 4 (sos) }
  ldiv(Y, op(Y, X))
= { by axiom 4 (sos) }
  X

Lemma 130: a(X, Y, L(Z, Y, X)) = ldiv(L(Z, Y, X), Z).
Proof:
  a(X, Y, L(Z, Y, X))
= { by axiom 4 (sos) R->L }
  ldiv(L(Z, Y, X), op(L(Z, Y, X), a(X, Y, L(Z, Y, X)))) (peak)
= { by lemma 129 }
  ldiv(L(Z, Y, X), Z)

Lemma 131: T(X, a(Y, Z, W)) = X.
Proof:
  T(X, a(Y, Z, W))
= { by axiom 5 (sos) }
  ldiv(a(Y, Z, W), op(X, a(Y, Z, W))) (peak)
= { by lemma 121 R->L }
  ldiv(a(Y, Z, W), op(a(Y, Z, W), X)) (peak)
= { by axiom 4 (sos) }
  X

Lemma 132: ldiv(L(X, Y, Z), X) = rdiv(X, L(X, Y, Z)).
Proof:
  ldiv(L(X, Y, Z), X) (peak)
= { by lemma 130 R->L }
  a(Z, Y, L(X, Y, Z))
= { by lemma 62 R->L }
  rdiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), T(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))) (peak)
= { by lemma 129 }
  rdiv(X, T(L(X, Y, Z), a(Z, Y, L(X, Y, Z))))
= { by lemma 131 }
  rdiv(X, L(X, Y, Z))

Lemma 133: ldiv(op(X, op(Y, Z)), op(op(X, Y), Z)) = a(X, Y, Z).
Proof:
  ldiv(op(X, op(Y, Z)), op(op(X, Y), Z))
= { by lemma 116 R->L }
  ldiv(rdiv(op(op(X, Y), Z), a(X, Y, Z)), op(op(X, Y), Z)) (peak)
= { by lemma 38 }
  a(X, Y, Z)

Lemma 134: op(X, op(Y, op(Z, a(X, Y, Z)))) = op(op(X, Y), Z).
Proof:
  op(X, op(Y, op(Z, a(X, Y, Z))))
= { by lemma 124 R->L }
  op(X, op(op(Y, Z), a(X, Y, Z)))
= { by lemma 124 R->L }
  op(op(X, op(Y, Z)), a(X, Y, Z)) (peak)
= { by axiom 20 (sos) R->L }
  op(op(X, Y), Z)

Lemma 135: L(a(X, Y, Z), W, V) = a(X, Y, Z).
Proof:
  L(a(X, Y, Z), W, V)
= { by axiom 19 (sos) }
  ldiv(op(V, W), op(V, op(W, a(X, Y, Z))))
= { by lemma 124 R->L }
  ldiv(op(V, W), op(op(V, W), a(X, Y, Z))) (peak)
= { by axiom 4 (sos) }
  a(X, Y, Z)

Lemma 136: a(X, Y, op(Z, a(X, Y, Z))) = a(X, Y, Z).
Proof:
  a(X, Y, op(Z, a(X, Y, Z)))
= { by lemma 133 R->L }
  ldiv(op(X, op(Y, op(Z, a(X, Y, Z)))), op(op(X, Y), op(Z, a(X, Y, Z)))) (peak)
= { by lemma 134 }
  ldiv(op(op(X, Y), Z), op(op(X, Y), op(Z, a(X, Y, Z))))
= { by axiom 19 (sos) R->L }
  L(a(X, Y, Z), Z, op(X, Y))
= { by lemma 135 }
  a(X, Y, Z)

Lemma 137: rdiv(op(X, a(Y, Z, W)), X) = a(Y, Z, W).
Proof:
  rdiv(op(X, a(Y, Z, W)), X) (peak)
= { by lemma 121 R->L }
  rdiv(op(a(Y, Z, W), X), X) (peak)
= { by axiom 3 (sos) }
  a(Y, Z, W)

Lemma 138: a(X, Y, L(Z, Y, X)) = rdiv(Z, L(Z, Y, X)).
Proof:
  a(X, Y, L(Z, Y, X))
= { by lemma 137 R->L }
  rdiv(op(L(Z, Y, X), a(X, Y, L(Z, Y, X))), L(Z, Y, X)) (peak)
= { by lemma 129 }
  rdiv(Z, L(Z, Y, X))

Lemma 139: op(K(X, Y), op(Z, Y)) = op(Z, rdiv(op(X, Y), X)).
Proof:
  op(K(X, Y), op(Z, Y)) (peak)
= { by lemma 30 }
  op(Z, op(Y, K(X, Y))) (peak)
= { by lemma 35 }
  op(Z, rdiv(op(X, Y), X)) (peak)

Lemma 140: op(X, rdiv(op(Z, Y), Z)) = rdiv(op(X, Y), K(Y, Z)).
Proof:
  op(X, rdiv(op(Z, Y), Z)) (peak)
= { by lemma 139 R->L }
  op(K(Z, Y), op(X, Y)) (peak)
= { by lemma 28 }
  op(op(X, Y), K(Z, Y)) (peak)
= { by lemma 56 }
  rdiv(op(X, Y), K(Y, Z))

Lemma 141: K(rdiv(X, K(Y, Z)), W) = K(X, W).
Proof:
  K(rdiv(X, K(Y, Z)), W)
= { by lemma 72 R->L }
  K(rdiv(X, K(Y, Z)), T(W, rdiv(X, K(Y, Z)))) (peak)
= { by lemma 66 }
  ldiv(T(W, rdiv(X, K(Y, Z))), W) (peak)
= { by lemma 92 }
  ldiv(T(W, X), W)
= { by lemma 73 }
  K(X, W)

Lemma 142: rdiv(op(X, Y), K(Y, X)) = op(T(X, Y), Y).
Proof:
  rdiv(op(X, Y), K(Y, X))
= { by lemma 141 R->L }
  rdiv(op(X, Y), K(rdiv(Y, K(Y, X)), X))
= { by lemma 114 R->L }
  rdiv(op(rdiv(Y, K(Y, X)), X), K(rdiv(Y, K(Y, X)), X)) (peak)
= { by lemma 27 }
  op(X, rdiv(Y, K(Y, X)))
= { by lemma 109 }
  op(T(X, Y), Y)

Lemma 143: op(X, rdiv(op(X, Y), X)) = op(T(X, Y), Y).
Proof:
  op(X, rdiv(op(X, Y), X)) (peak)
= { by lemma 140 }
  rdiv(op(X, Y), K(Y, X)) (peak)
= { by lemma 142 }
  op(T(X, Y), Y)

Lemma 144: op(L(X, Y, Z), rdiv(X, L(X, Y, Z))) = X.
Proof:
  op(L(X, Y, Z), rdiv(X, L(X, Y, Z)))
= { by lemma 129 R->L }
  op(L(X, Y, Z), rdiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), L(X, Y, Z))) (peak)
= { by lemma 143 }
  op(T(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), a(Z, Y, L(X, Y, Z)))
= { by lemma 131 }
  op(L(X, Y, Z), a(Z, Y, L(X, Y, Z)))
= { by lemma 129 }
  X

Lemma 145: rdiv(Z, L(Z, Y, X)) = a(X, Y, Z).
Proof:
  rdiv(Z, L(Z, Y, X))
= { by lemma 132 R->L }
  ldiv(L(Z, Y, X), Z) (peak)
= { by lemma 130 R->L }
  a(X, Y, L(Z, Y, X))
= { by lemma 136 R->L }
  a(X, Y, op(L(Z, Y, X), a(X, Y, L(Z, Y, X)))) (peak)
= { by lemma 138 }
  a(X, Y, op(L(Z, Y, X), rdiv(Z, L(Z, Y, X)))) (peak)
= { by lemma 144 }
  a(X, Y, Z)

Lemma 146: L(ldiv(X, ldiv(Y, Z)), X, Y) = ldiv(op(Y, X), Z).
Proof:
  L(ldiv(X, ldiv(Y, Z)), X, Y) (peak)
= { by lemma 80 R->L }
  ldiv(op(Y, X), op(Y, ldiv(Y, Z))) (peak)
= { by axiom 8 (sos) }
  ldiv(op(Y, X), Z)

Lemma 147: ldiv(rdiv(X, K(Y, Z)), W) = ldiv(X, rdiv(W, K(Z, Y))).
Proof:
  ldiv(rdiv(X, K(Y, Z)), W)
= { by lemma 55 R->L }
  ldiv(op(K(Z, Y), X), W)
= { by lemma 146 R->L }
  L(ldiv(X, ldiv(K(Z, Y), W)), X, K(Z, Y)) (peak)
= { by lemma 91 }
  ldiv(X, ldiv(K(Z, Y), W))
= { by lemma 44 }
  ldiv(X, rdiv(W, K(Z, Y)))

Lemma 148: ldiv(X, rdiv(op(X, Y), K(Z, W))) = rdiv(Y, K(Z, W)).
Proof:
  ldiv(X, rdiv(op(X, Y), K(Z, W)))
= { by lemma 55 R->L }
  ldiv(X, op(K(W, Z), op(X, Y)))
= { by lemma 100 R->L }
  ldiv(R(X, Y, K(W, Z)), op(K(W, Z), op(X, Y))) (peak)
= { by lemma 28 }
  ldiv(R(X, Y, K(W, Z)), op(op(X, Y), K(W, Z))) (peak)
= { by lemma 89 }
  op(Y, K(W, Z))
= { by lemma 56 }
  rdiv(Y, K(Z, W))

Lemma 149: ldiv(X, rdiv(Y, K(Z, W))) = rdiv(ldiv(X, Y), K(Z, W)).
Proof:
  ldiv(X, rdiv(Y, K(Z, W)))
= { by axiom 8 (sos) R->L }
  ldiv(X, rdiv(op(X, ldiv(X, Y)), K(Z, W))) (peak)
= { by lemma 148 }
  rdiv(ldiv(X, Y), K(Z, W))

Lemma 150: R(rdiv(rdiv(X, Y), Z), Z, Y) = rdiv(X, op(Z, Y)).
Proof:
  R(rdiv(rdiv(X, Y), Z), Z, Y) (peak)
= { by lemma 36 R->L }
  rdiv(op(rdiv(X, Y), Y), op(Z, Y)) (peak)
= { by axiom 9 (sos) }
  rdiv(X, op(Z, Y))

Lemma 151: rdiv(rdiv(X, K(Y, Z)), W) = rdiv(X, rdiv(W, K(Z, Y))).
Proof:
  rdiv(rdiv(X, K(Y, Z)), W)
= { by lemma 100 R->L }
  R(rdiv(rdiv(X, K(Y, Z)), W), W, K(Y, Z)) (peak)
= { by lemma 150 }
  rdiv(X, op(W, K(Y, Z)))
= { by lemma 56 }
  rdiv(X, rdiv(W, K(Z, Y)))

Lemma 152: rdiv(op(X, T(Z, Y)), op(Z, Y)) = R(rdiv(X, Y), Y, T(Z, Y)).
Proof:
  rdiv(op(X, T(Z, Y)), op(Z, Y))
= { by lemma 57 R->L }
  rdiv(op(X, T(Z, Y)), op(Y, T(Z, Y))) (peak)
= { by lemma 36 }
  R(rdiv(X, Y), Y, T(Z, Y))

Lemma 153: rdiv(op(X, Y), T(Y, Z)) = rdiv(X, K(Y, Z)).
Proof:
  rdiv(op(X, Y), T(Y, Z))
= { by lemma 43 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), T(Y, Z))
= { by lemma 33 R->L }
  rdiv(op(X, T(Y, K(Y, Z))), op(Y, K(Y, Z)))
= { by lemma 152 }
  R(rdiv(X, K(Y, Z)), K(Y, Z), T(Y, K(Y, Z))) (peak)
= { by lemma 88 }
  rdiv(X, K(Y, Z))

Lemma 154: rdiv(K(X, Y), K(X, Z)) = rdiv(T(X, Y), T(X, Z)).
Proof:
  rdiv(K(X, Y), K(X, Z))
= { by lemma 153 R->L }
  rdiv(op(K(X, Y), X), T(X, Z)) (peak)
= { by lemma 58 }
  rdiv(T(X, Y), T(X, Z))

Lemma 155: a(X, Y, rdiv(Z, K(W, V))) = a(X, Y, Z).
Proof:
  a(X, Y, rdiv(Z, K(W, V)))
= { by lemma 133 R->L }
  ldiv(op(X, op(Y, rdiv(Z, K(W, V)))), op(op(X, Y), rdiv(Z, K(W, V)))) (peak)
= { by lemma 115 }
  ldiv(op(X, rdiv(op(Y, Z), K(W, V))), op(op(X, Y), rdiv(Z, K(W, V))))
= { by lemma 115 }
  ldiv(rdiv(op(X, op(Y, Z)), K(W, V)), op(op(X, Y), rdiv(Z, K(W, V))))
= { by lemma 147 }
  ldiv(op(X, op(Y, Z)), rdiv(op(op(X, Y), rdiv(Z, K(W, V))), K(V, W)))
= { by lemma 149 }
  rdiv(ldiv(op(X, op(Y, Z)), op(op(X, Y), rdiv(Z, K(W, V)))), K(V, W))
= { by lemma 115 }
  rdiv(ldiv(op(X, op(Y, Z)), rdiv(op(op(X, Y), Z), K(W, V))), K(V, W))
= { by lemma 149 }
  rdiv(rdiv(ldiv(op(X, op(Y, Z)), op(op(X, Y), Z)), K(W, V)), K(V, W))
= { by lemma 151 }
  rdiv(ldiv(op(X, op(Y, Z)), op(op(X, Y), Z)), rdiv(K(V, W), K(V, W)))
= { by lemma 133 }
  rdiv(a(X, Y, Z), rdiv(K(V, W), K(V, W)))
= { by lemma 154 }
  rdiv(a(X, Y, Z), rdiv(T(V, W), T(V, W)))
= { by lemma 25 }
  rdiv(a(X, Y, Z), zero)
= { by lemma 26 }
  a(X, Y, Z)

Lemma 156: a(X, Y, T(Z, W)) = a(X, Y, Z).
Proof:
  a(X, Y, T(Z, W))
= { by lemma 155 R->L }
  a(X, Y, rdiv(T(Z, W), K(Z, W))) (peak)
= { by lemma 83 }
  a(X, Y, Z)

Lemma 157: K(X, a(Y, Z, W)) = zero.
Proof:
  K(X, a(Y, Z, W)) (peak)
= { by axiom 10 (sos) }
  1
= { by lemma 24 }
  zero

Lemma 158: a(a(X, Y, Z), W, V) = zero.
Proof:
  a(a(X, Y, Z), W, V) (peak)
= { by axiom 16 (sos) }
  1
= { by lemma 24 }
  zero

Lemma 159: L(op(X, a(Y, Z, X)), Z, Y) = X.
Proof:
  L(op(X, a(Y, Z, X)), Z, Y)
= { by axiom 19 (sos) }
  ldiv(op(Y, Z), op(Y, op(Z, op(X, a(Y, Z, X))))) (peak)
= { by lemma 134 }
  ldiv(op(Y, Z), op(op(Y, Z), X))
= { by axiom 4 (sos) }
  X

Lemma 160: L(X, Y, a(Z, W, V)) = X.
Proof:
  L(X, Y, a(Z, W, V))
= { by axiom 1 (sos) R->L }
  L(op(X, zero), Y, a(Z, W, V))
= { by lemma 158 R->L }
  L(op(X, a(a(Z, W, V), Y, X)), Y, a(Z, W, V)) (peak)
= { by lemma 159 }
  X

Lemma 161: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, ldiv(Y, X), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by axiom 8 (sos) R->L }
  ldiv(op(Y, ldiv(Y, X)), op(Y, op(ldiv(Y, X), Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, ldiv(Y, X), Y)

Lemma 162: op(rdiv(X, K(Y, Z)), W) = rdiv(op(X, W), K(Y, Z)).
Proof:
  op(rdiv(X, K(Y, Z)), W)
= { by lemma 56 R->L }
  op(op(X, K(Z, Y)), W) (peak)
= { by lemma 28 R->L }
  op(op(K(Z, Y), X), W) (peak)
= { by lemma 46 }
  op(X, op(W, K(Z, Y)))
= { by lemma 56 }
  op(X, rdiv(W, K(Y, Z)))
= { by lemma 115 }
  rdiv(op(X, W), K(Y, Z))

Lemma 163: rdiv(rdiv(X, Y), K(Z, W)) = rdiv(X, rdiv(Y, K(W, Z))).
Proof:
  rdiv(rdiv(X, Y), K(Z, W))
= { by lemma 88 R->L }
  R(rdiv(rdiv(X, Y), K(Z, W)), K(Z, W), Y) (peak)
= { by lemma 150 }
  rdiv(X, op(K(Z, W), Y))
= { by lemma 55 }
  rdiv(X, rdiv(Y, K(W, Z)))

Lemma 164: L(X, rdiv(Y, K(Z, W)), V) = L(X, Y, V).
Proof:
  L(X, rdiv(Y, K(Z, W)), V)
= { by lemma 148 R->L }
  L(X, ldiv(V, rdiv(op(V, Y), K(Z, W))), V)
= { by lemma 161 R->L }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(ldiv(V, rdiv(op(V, Y), K(Z, W))), X))) (peak)
= { by lemma 148 }
  ldiv(rdiv(op(V, Y), K(Z, W)), op(V, op(rdiv(Y, K(Z, W)), X)))
= { by lemma 147 }
  ldiv(op(V, Y), rdiv(op(V, op(rdiv(Y, K(Z, W)), X)), K(W, Z)))
= { by lemma 149 }
  rdiv(ldiv(op(V, Y), op(V, op(rdiv(Y, K(Z, W)), X))), K(W, Z))
= { by lemma 162 }
  rdiv(ldiv(op(V, Y), op(V, rdiv(op(Y, X), K(Z, W)))), K(W, Z))
= { by lemma 115 }
  rdiv(ldiv(op(V, Y), rdiv(op(V, op(Y, X)), K(Z, W))), K(W, Z))
= { by lemma 149 }
  rdiv(rdiv(ldiv(op(V, Y), op(V, op(Y, X))), K(Z, W)), K(W, Z))
= { by lemma 163 }
  rdiv(ldiv(op(V, Y), op(V, op(Y, X))), rdiv(K(Z, W), K(Z, W)))
= { by axiom 19 (sos) R->L }
  rdiv(L(X, Y, V), rdiv(K(Z, W), K(Z, W)))
= { by lemma 25 }
  rdiv(L(X, Y, V), zero)
= { by lemma 26 }
  L(X, Y, V)

Lemma 165: L(X, op(Y, Z), W) = L(X, op(Z, Y), W).
Proof:
  L(X, op(Y, Z), W)
= { by lemma 164 R->L }
  L(X, rdiv(op(Y, Z), K(Y, Z)), W) (peak)
= { by lemma 27 }
  L(X, op(Z, Y), W)

Lemma 166: op(X, K(rdiv(Y, X), X)) = rdiv(Y, rdiv(Y, X)).
Proof:
  op(X, K(rdiv(Y, X), X))
= { by lemma 35 }
  rdiv(op(rdiv(Y, X), X), rdiv(Y, X)) (peak)
= { by axiom 9 (sos) }
  rdiv(Y, rdiv(Y, X))

Lemma 167: op(ldiv(X, Y), K(X, rdiv(Y, X))) = rdiv(Y, X).
Proof:
  op(ldiv(X, Y), K(X, rdiv(Y, X)))
= { by lemma 102 R->L }
  op(ldiv(X, Y), K(X, ldiv(X, Y)))
= { by lemma 61 R->L }
  op(ldiv(X, Y), K(rdiv(Y, ldiv(X, Y)), ldiv(X, Y))) (peak)
= { by lemma 166 }
  rdiv(Y, rdiv(Y, ldiv(X, Y)))
= { by lemma 61 }
  rdiv(Y, X)

Lemma 168: L(X, ldiv(Y, Z), W) = L(X, rdiv(Z, Y), W).
Proof:
  L(X, ldiv(Y, Z), W)
= { by lemma 164 R->L }
  L(X, rdiv(ldiv(Y, Z), K(rdiv(Z, Y), Y)), W)
= { by lemma 55 R->L }
  L(X, op(K(Y, rdiv(Z, Y)), ldiv(Y, Z)), W) (peak)
= { by lemma 165 R->L }
  L(X, op(ldiv(Y, Z), K(Y, rdiv(Z, Y))), W)
= { by lemma 167 }
  L(X, rdiv(Z, Y), W)

Lemma 169: ldiv(X, op(Y, op(ldiv(Y, X), Z))) = L(Z, rdiv(X, Y), Y).
Proof:
  ldiv(X, op(Y, op(ldiv(Y, X), Z)))
= { by axiom 8 (sos) R->L }
  ldiv(op(Y, ldiv(Y, X)), op(Y, op(ldiv(Y, X), Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, ldiv(Y, X), Y)
= { by lemma 168 }
  L(Z, rdiv(X, Y), Y)

Lemma 170: L(ldiv(ldiv(X, Y), Z), rdiv(Y, X), X) = ldiv(Y, op(X, Z)).
Proof:
  L(ldiv(ldiv(X, Y), Z), rdiv(Y, X), X)
= { by lemma 169 R->L }
  ldiv(Y, op(X, op(ldiv(X, Y), ldiv(ldiv(X, Y), Z)))) (peak)
= { by axiom 8 (sos) }
  ldiv(Y, op(X, Z))

Lemma 171: ldiv(rdiv(X, a(Y, Z, W)), V) = ldiv(X, op(V, a(Y, Z, W))).
Proof:
  ldiv(rdiv(X, a(Y, Z, W)), V)
= { by lemma 123 R->L }
  ldiv(ldiv(a(Y, Z, W), X), V)
= { by lemma 160 R->L }
  L(ldiv(ldiv(a(Y, Z, W), X), V), rdiv(X, a(Y, Z, W)), a(Y, Z, W)) (peak)
= { by lemma 170 }
  ldiv(X, op(a(Y, Z, W), V))
= { by lemma 121 }
  ldiv(X, op(V, a(Y, Z, W)))

Lemma 172: rdiv(op(op(X, rdiv(Y, Z)), Z), Y) = R(X, rdiv(Y, Z), Z).
Proof:
  rdiv(op(op(X, rdiv(Y, Z)), Z), Y)
= { by axiom 9 (sos) R->L }
  rdiv(op(op(X, rdiv(Y, Z)), Z), op(rdiv(Y, Z), Z)) (peak)
= { by axiom 18 (sos) R->L }
  R(X, rdiv(Y, Z), Z)

Lemma 173: ldiv(X, op(op(Y, rdiv(X, Z)), Z)) = T(R(Y, rdiv(X, Z), Z), X).
Proof:
  ldiv(X, op(op(Y, rdiv(X, Z)), Z))
= { by lemma 42 R->L }
  T(rdiv(op(op(Y, rdiv(X, Z)), Z), X), X) (peak)
= { by lemma 172 }
  T(R(Y, rdiv(X, Z), Z), X)

Lemma 174: T(X, rdiv(Y, a(Z, W, V))) = T(X, Y).
Proof:
  T(X, rdiv(Y, a(Z, W, V)))
= { by axiom 5 (sos) }
  ldiv(rdiv(Y, a(Z, W, V)), op(X, rdiv(Y, a(Z, W, V)))) (peak)
= { by lemma 171 }
  ldiv(Y, op(op(X, rdiv(Y, a(Z, W, V))), a(Z, W, V)))
= { by lemma 173 }
  T(R(X, rdiv(Y, a(Z, W, V)), a(Z, W, V)), Y)
= { by lemma 125 }
  T(X, Y)

Lemma 175: T(X, op(Y, a(Z, W, V))) = T(X, Y).
Proof:
  T(X, op(Y, a(Z, W, V)))
= { by lemma 174 R->L }
  T(X, rdiv(op(Y, a(Z, W, V)), a(Z, W, V))) (peak)
= { by axiom 3 (sos) }
  T(X, Y)

Lemma 176: T(X, op(a(Y, Z, W), V)) = T(X, V).
Proof:
  T(X, op(a(Y, Z, W), V)) (peak)
= { by lemma 121 }
  T(X, op(V, a(Y, Z, W))) (peak)
= { by lemma 175 }
  T(X, V)

Lemma 177: T(X, L(Y, W, V)) = T(X, T(Y, Z)).
Proof:
  T(X, L(Y, W, V))
= { by lemma 176 R->L }
  T(X, op(a(V, W, L(Y, W, V)), L(Y, W, V))) (peak)
= { by lemma 120 R->L }
  T(X, op(L(Y, W, V), a(V, W, L(Y, W, V))))
= { by lemma 129 }
  T(X, Y)
= { by lemma 93 R->L }
  T(X, T(Y, Z)) (peak)

Lemma 178: K(X, L(Y, W, V)) = K(X, T(Y, Z)).
Proof:
  K(X, L(Y, W, V))
= { by lemma 60 R->L }
  ldiv(X, T(X, L(Y, W, V))) (peak)
= { by lemma 177 }
  ldiv(X, T(X, T(Y, Z))) (peak)
= { by lemma 60 }
  K(X, T(Y, Z))

Lemma 179: op(rdiv(X, op(Y, Z)), op(Z, Y)) = rdiv(X, K(Y, Z)).
Proof:
  op(rdiv(X, op(Y, Z)), op(Z, Y))
= { by lemma 118 R->L }
  rdiv(op(rdiv(X, op(Y, Z)), op(Y, Z)), K(Y, Z)) (peak)
= { by axiom 9 (sos) }
  rdiv(X, K(Y, Z))

Lemma 180: rdiv(op(X, Y), K(Z, Y)) = op(X, T(Y, Z)).
Proof:
  rdiv(op(X, Y), K(Z, Y))
= { by lemma 55 R->L }
  op(K(Y, Z), op(X, Y)) (peak)
= { by lemma 30 }
  op(X, op(Y, K(Y, Z))) (peak)
= { by lemma 33 }
  op(X, T(Y, Z))

Lemma 181: op(R(X, Y, Z), op(Z, Y)) = op(op(X, Y), T(Z, Y)).
Proof:
  op(R(X, Y, Z), op(Z, Y))
= { by axiom 18 (sos) }
  op(rdiv(op(op(X, Y), Z), op(Y, Z)), op(Z, Y)) (peak)
= { by lemma 179 }
  rdiv(op(op(X, Y), Z), K(Y, Z))
= { by lemma 180 }
  op(op(X, Y), T(Z, Y))

Lemma 182: op(R(X, Y, rdiv(Z, Y)), Z) = op(op(X, Y), ldiv(Y, Z)).
Proof:
  op(R(X, Y, rdiv(Z, Y)), Z)
= { by axiom 9 (sos) R->L }
  op(R(X, Y, rdiv(Z, Y)), op(rdiv(Z, Y), Y)) (peak)
= { by lemma 181 }
  op(op(X, Y), T(rdiv(Z, Y), Y))
= { by lemma 42 }
  op(op(X, Y), ldiv(Y, Z))

Lemma 183: rdiv(op(op(X, Y), ldiv(Y, Z)), Z) = R(X, Y, rdiv(Z, Y)).
Proof:
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z)
= { by lemma 182 R->L }
  rdiv(op(R(X, Y, rdiv(Z, Y)), Z), Z) (peak)
= { by axiom 3 (sos) }
  R(X, Y, rdiv(Z, Y))

Lemma 184: R(X, Y, ldiv(Y, Z)) = R(X, Y, rdiv(Z, Y)).
Proof:
  R(X, Y, ldiv(Y, Z))
= { by axiom 3 (sos) R->L }
  R(rdiv(op(X, Y), Y), Y, ldiv(Y, Z)) (peak)
= { by lemma 52 }
  rdiv(op(op(X, Y), ldiv(Y, Z)), Z) (peak)
= { by lemma 183 }
  R(X, Y, rdiv(Z, Y))

Lemma 185: R(X, Y, T(Z, Y)) = R(X, Y, Z).
Proof:
  R(X, Y, T(Z, Y))
= { by axiom 5 (sos) }
  R(X, Y, ldiv(Y, op(Z, Y))) (peak)
= { by lemma 184 }
  R(X, Y, rdiv(op(Z, Y), Y))
= { by axiom 3 (sos) }
  R(X, Y, Z)

Lemma 186: L(X, K(Y, Z), W) = X.
Proof:
  L(X, K(Y, Z), W)
= { by lemma 43 R->L }
  L(T(X, K(Y, Z)), K(Y, Z), W)
= { by lemma 85 R->L }
  ldiv(op(W, K(Y, Z)), op(W, op(X, K(Y, Z))))
= { by lemma 46 R->L }
  ldiv(op(W, K(Y, Z)), op(op(K(Y, Z), W), X)) (peak)
= { by lemma 90 }
  rdiv(X, K(W, K(Y, Z)))
= { by axiom 6 (sos) }
  rdiv(X, 1)
= { by lemma 24 }
  rdiv(X, zero)
= { by lemma 26 }
  X

Lemma 187: T(X, L(Y, Z, W)) = T(X, Y).
Proof:
  T(X, L(Y, Z, W))
= { by lemma 175 R->L }
  T(X, op(L(Y, Z, W), a(W, Z, L(Y, Z, W)))) (peak)
= { by lemma 129 }
  T(X, Y)

Lemma 188: ldiv(rdiv(X, L(X, Y, Z)), W) = rdiv(W, rdiv(X, L(X, Y, Z))).
Proof:
  ldiv(rdiv(X, L(X, Y, Z)), W)
= { by lemma 132 R->L }
  ldiv(ldiv(L(X, Y, Z), X), W) (peak)
= { by lemma 130 R->L }
  ldiv(a(Z, Y, L(X, Y, Z)), W) (peak)
= { by lemma 123 }
  rdiv(W, a(Z, Y, L(X, Y, Z)))
= { by lemma 138 }
  rdiv(W, rdiv(X, L(X, Y, Z))) (peak)

Lemma 189: ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) = op(Y, Z).
Proof:
  ldiv(R(rdiv(X, Y), Y, Z), op(X, Z)) (peak)
= { by lemma 36 R->L }
  ldiv(rdiv(op(X, Z), op(Y, Z)), op(X, Z)) (peak)
= { by lemma 38 }
  op(Y, Z)

Lemma 190: ldiv(rdiv(X, Y), T(X, Z)) = rdiv(Y, K(Z, X)).
Proof:
  ldiv(rdiv(X, Y), T(X, Z))
= { by lemma 100 R->L }
  ldiv(R(rdiv(X, Y), Y, K(X, Z)), T(X, Z))
= { by lemma 33 R->L }
  ldiv(R(rdiv(X, Y), Y, K(X, Z)), op(X, K(X, Z))) (peak)
= { by lemma 189 }
  op(Y, K(X, Z))
= { by lemma 56 }
  rdiv(Y, K(Z, X))

Lemma 191: ldiv(rdiv(X, Y), T(X, Z)) = rdiv(Y, rdiv(X, T(X, Z))).
Proof:
  ldiv(rdiv(X, Y), T(X, Z)) (peak)
= { by lemma 190 }
  rdiv(Y, K(Z, X))
= { by lemma 82 R->L }
  rdiv(Y, rdiv(X, T(X, Z)))

Lemma 192: rdiv(L(X, Z, W), T(L(X, Z, W), Y)) = rdiv(X, T(X, Y)).
Proof:
  rdiv(L(X, Z, W), T(L(X, Z, W), Y)) (peak)
= { by lemma 82 }
  K(Y, L(X, Z, W))
= { by lemma 178 }
  K(Y, T(X, Y)) (peak)
= { by lemma 106 }
  rdiv(X, T(X, Y)) (peak)

Lemma 193: ldiv(rdiv(X, T(X, Y)), Z) = rdiv(Z, rdiv(X, T(X, Y))).
Proof:
  ldiv(rdiv(X, T(X, Y)), Z)
= { by lemma 77 R->L }
  ldiv(ldiv(T(X, Y), X), Z) (peak)
= { by lemma 66 R->L }
  ldiv(K(Y, T(X, Y)), Z) (peak)
= { by lemma 44 }
  rdiv(Z, K(Y, T(X, Y)))
= { by lemma 66 }
  rdiv(Z, ldiv(T(X, Y), X)) (peak)
= { by lemma 77 }
  rdiv(Z, rdiv(X, T(X, Y)))

Lemma 194: rdiv(X, rdiv(X, T(X, Y))) = T(X, Y).
Proof:
  rdiv(X, rdiv(X, T(X, Y)))
= { by lemma 193 R->L }
  ldiv(rdiv(X, T(X, Y)), X) (peak)
= { by lemma 38 }
  T(X, Y)

Lemma 195: rdiv(T(X, Y), rdiv(X, L(X, Z, W))) = T(L(X, Z, W), Y).
Proof:
  rdiv(T(X, Y), rdiv(X, L(X, Z, W)))
= { by lemma 188 R->L }
  ldiv(rdiv(X, L(X, Z, W)), T(X, Y))
= { by lemma 191 }
  rdiv(L(X, Z, W), rdiv(X, T(X, Y)))
= { by lemma 192 R->L }
  rdiv(L(X, Z, W), rdiv(L(X, Z, W), T(L(X, Z, W), Y))) (peak)
= { by lemma 194 }
  T(L(X, Z, W), Y)

Lemma 196: rdiv(X, K(X, rdiv(Y, X))) = rdiv(Y, rdiv(Y, X)).
Proof:
  rdiv(X, K(X, rdiv(Y, X)))
= { by lemma 43 R->L }
  rdiv(T(X, K(rdiv(Y, X), X)), K(X, rdiv(Y, X)))
= { by lemma 56 R->L }
  op(T(X, K(rdiv(Y, X), X)), K(rdiv(Y, X), X))
= { by lemma 142 R->L }
  rdiv(op(X, K(rdiv(Y, X), X)), K(K(rdiv(Y, X), X), X)) (peak)
= { by lemma 166 }
  rdiv(rdiv(Y, rdiv(Y, X)), K(K(rdiv(Y, X), X), X)) (peak)
= { by axiom 7 (sos) }
  rdiv(rdiv(Y, rdiv(Y, X)), 1)
= { by lemma 24 }
  rdiv(rdiv(Y, rdiv(Y, X)), zero)
= { by lemma 26 }
  rdiv(Y, rdiv(Y, X))

Lemma 197: op(rdiv(op(Z, X), Z), Y) = op(X, op(Y, K(Z, X))).
Proof:
  op(rdiv(op(Z, X), Z), Y) (peak)
= { by lemma 35 R->L }
  op(op(X, K(Z, X)), Y) (peak)
= { by lemma 29 }
  op(K(Z, X), op(X, Y))
= { by lemma 30 }
  op(X, op(Y, K(Z, X)))

Lemma 198: op(T(X, Y), op(Z, rdiv(X, T(X, Y)))) = op(X, Z).
Proof:
  op(T(X, Y), op(Z, rdiv(X, T(X, Y))))
= { by lemma 77 R->L }
  op(T(X, Y), op(Z, ldiv(T(X, Y), X))) (peak)
= { by lemma 66 R->L }
  op(T(X, Y), op(Z, K(Y, T(X, Y)))) (peak)
= { by lemma 197 R->L }
  op(rdiv(op(Y, T(X, Y)), Y), Z)
= { by lemma 105 }
  op(X, Z)

Lemma 199: op(X, rdiv(Y, T(Y, Z))) = ldiv(T(Y, Z), op(Y, X)).
Proof:
  op(X, rdiv(Y, T(Y, Z)))
= { by axiom 4 (sos) R->L }
  ldiv(T(Y, Z), op(T(Y, Z), op(X, rdiv(Y, T(Y, Z))))) (peak)
= { by lemma 198 }
  ldiv(T(Y, Z), op(Y, X))

Lemma 200: K(rdiv(X, T(X, Y)), Z) = zero.
Proof:
  K(rdiv(X, T(X, Y)), Z)
= { by lemma 77 R->L }
  K(ldiv(T(X, Y), X), Z) (peak)
= { by lemma 66 R->L }
  K(K(Y, T(X, Y)), Z) (peak)
= { by axiom 7 (sos) }
  1
= { by lemma 24 }
  zero

Lemma 201: op(rdiv(X, T(X, Y)), Z) = ldiv(T(X, Y), op(X, Z)).
Proof:
  op(rdiv(X, T(X, Y)), Z)
= { by axiom 17 (sos) }
  op(op(Z, rdiv(X, T(X, Y))), K(rdiv(X, T(X, Y)), Z)) (peak)
= { by lemma 199 }
  op(ldiv(T(X, Y), op(X, Z)), K(rdiv(X, T(X, Y)), Z))
= { by lemma 200 }
  op(ldiv(T(X, Y), op(X, Z)), zero)
= { by axiom 1 (sos) }
  ldiv(T(X, Y), op(X, Z))

Lemma 202: op(X, L(Y, ldiv(Z, X), Z)) = op(Z, op(ldiv(Z, X), Y)).
Proof:
  op(X, L(Y, ldiv(Z, X), Z))
= { by axiom 8 (sos) R->L }
  op(op(Z, ldiv(Z, X)), L(Y, ldiv(Z, X), Z)) (peak)
= { by lemma 128 }
  op(Z, op(ldiv(Z, X), Y))

Lemma 203: op(X, op(ldiv(X, zero), Y)) = L(Y, ldiv(X, zero), X).
Proof:
  op(X, op(ldiv(X, zero), Y))
= { by lemma 202 R->L }
  op(zero, L(Y, ldiv(X, zero), X)) (peak)
= { by axiom 2 (sos) }
  L(Y, ldiv(X, zero), X)

Lemma 204: op(X, ldiv(T(X, Y), zero)) = rdiv(X, T(X, Y)).
Proof:
  op(X, ldiv(T(X, Y), zero))
= { by lemma 198 R->L }
  op(T(X, Y), op(ldiv(T(X, Y), zero), rdiv(X, T(X, Y)))) (peak)
= { by lemma 203 }
  L(rdiv(X, T(X, Y)), ldiv(T(X, Y), zero), T(X, Y))
= { by lemma 79 }
  rdiv(X, T(X, Y))

Lemma 205: R(rdiv(X, Y), Y, ldiv(X, Z)) = rdiv(Z, op(Y, ldiv(X, Z))).
Proof:
  R(rdiv(X, Y), Y, ldiv(X, Z)) (peak)
= { by lemma 36 R->L }
  rdiv(op(X, ldiv(X, Z)), op(Y, ldiv(X, Z))) (peak)
= { by axiom 8 (sos) }
  rdiv(Z, op(Y, ldiv(X, Z)))

Lemma 206: ldiv(op(ldiv(X, Y), X), Y) = K(X, ldiv(X, Y)).
Proof:
  ldiv(op(ldiv(X, Y), X), Y)
= { by axiom 8 (sos) R->L }
  ldiv(op(ldiv(X, Y), X), op(X, ldiv(X, Y))) (peak)
= { by lemma 67 }
  K(X, ldiv(X, Y))

Lemma 207: ldiv(X, op(Y, T(X, Y))) = Y.
Proof:
  ldiv(X, op(Y, T(X, Y))) (peak)
= { by lemma 57 }
  ldiv(X, op(X, Y))
= { by axiom 4 (sos) }
  Y

Lemma 208: L(ldiv(X, T(X, Y)), X, Y) = K(X, Y).
Proof:
  L(ldiv(X, T(X, Y)), X, Y) (peak)
= { by lemma 80 R->L }
  ldiv(op(Y, X), op(Y, T(X, Y))) (peak)
= { by lemma 57 }
  ldiv(op(Y, X), op(X, Y))
= { by lemma 67 }
  K(X, Y)

Lemma 209: K(X, rdiv(op(Y, T(X, Y)), X)) = rdiv(T(X, Y), X).
Proof:
  K(X, rdiv(op(Y, T(X, Y)), X))
= { by lemma 102 R->L }
  K(X, ldiv(X, op(Y, T(X, Y))))
= { by lemma 206 R->L }
  ldiv(op(ldiv(X, op(Y, T(X, Y))), X), op(Y, T(X, Y))) (peak)
= { by lemma 207 }
  ldiv(op(Y, X), op(Y, T(X, Y)))
= { by lemma 80 }
  L(ldiv(X, T(X, Y)), X, Y)
= { by lemma 208 }
  K(X, Y)
= { by lemma 63 R->L }
  rdiv(T(X, Y), X)

Lemma 210: R(rdiv(T(X, Y), X), Z, W) = rdiv(T(X, Y), X).
Proof:
  R(rdiv(T(X, Y), X), Z, W)
= { by lemma 209 R->L }
  R(K(X, rdiv(op(Y, T(X, Y)), X)), Z, W) (peak)
= { by lemma 54 }
  K(X, rdiv(op(Y, T(X, Y)), X))
= { by lemma 209 }
  rdiv(T(X, Y), X)

Lemma 211: rdiv(zero, rdiv(X, T(X, Y))) = rdiv(T(X, Y), X).
Proof:
  rdiv(zero, rdiv(X, T(X, Y)))
= { by lemma 204 R->L }
  rdiv(zero, op(X, ldiv(T(X, Y), zero)))
= { by lemma 205 R->L }
  R(rdiv(T(X, Y), X), X, ldiv(T(X, Y), zero)) (peak)
= { by lemma 210 }
  rdiv(T(X, Y), X)

Lemma 212: ldiv(rdiv(T(X, Y), X), Z) = rdiv(Z, rdiv(T(X, Y), X)).
Proof:
  ldiv(rdiv(T(X, Y), X), Z)
= { by lemma 209 R->L }
  ldiv(K(X, rdiv(op(Y, T(X, Y)), X)), Z) (peak)
= { by lemma 44 }
  rdiv(Z, K(X, rdiv(op(Y, T(X, Y)), X)))
= { by lemma 209 }
  rdiv(Z, rdiv(T(X, Y), X))

Lemma 213: ldiv(T(X, Y), op(X, Z)) = rdiv(Z, rdiv(T(X, Y), X)).
Proof:
  ldiv(T(X, Y), op(X, Z))
= { by lemma 201 R->L }
  op(rdiv(X, T(X, Y)), Z)
= { by lemma 39 R->L }
  ldiv(R(rdiv(zero, rdiv(X, T(X, Y))), rdiv(X, T(X, Y)), Z), Z) (peak)
= { by lemma 211 }
  ldiv(R(rdiv(T(X, Y), X), rdiv(X, T(X, Y)), Z), Z)
= { by lemma 210 }
  ldiv(rdiv(T(X, Y), X), Z)
= { by lemma 212 }
  rdiv(Z, rdiv(T(X, Y), X))

Lemma 214: L(ldiv(X, Y), X, rdiv(Z, Y)) = ldiv(op(rdiv(Z, Y), X), Z).
Proof:
  L(ldiv(X, Y), X, rdiv(Z, Y)) (peak)
= { by lemma 80 R->L }
  ldiv(op(rdiv(Z, Y), X), op(rdiv(Z, Y), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(op(rdiv(Z, Y), X), Z)

Lemma 215: ldiv(X, op(ldiv(Y, X), Y)) = K(ldiv(Y, X), Y).
Proof:
  ldiv(X, op(ldiv(Y, X), Y))
= { by axiom 8 (sos) R->L }
  ldiv(op(Y, ldiv(Y, X)), op(ldiv(Y, X), Y)) (peak)
= { by lemma 67 }
  K(ldiv(Y, X), Y)

Lemma 216: K(rdiv(op(X, T(Y, X)), Y), Y) = rdiv(Y, T(Y, X)).
Proof:
  K(rdiv(op(X, T(Y, X)), Y), Y)
= { by lemma 108 R->L }
  K(ldiv(Y, op(X, T(Y, X))), Y)
= { by lemma 215 R->L }
  ldiv(op(X, T(Y, X)), op(ldiv(Y, op(X, T(Y, X))), Y)) (peak)
= { by lemma 207 }
  ldiv(op(X, T(Y, X)), op(X, Y))
= { by lemma 80 }
  L(ldiv(T(Y, X), Y), T(Y, X), X)
= { by lemma 77 }
  L(rdiv(Y, T(Y, X)), T(Y, X), X)
= { by lemma 81 }
  K(X, Y)
= { by lemma 82 R->L }
  rdiv(Y, T(Y, X))

Lemma 217: L(X, Y, rdiv(Z, T(Z, W))) = X.
Proof:
  L(X, Y, rdiv(Z, T(Z, W)))
= { by lemma 216 R->L }
  L(X, Y, K(rdiv(op(W, T(Z, W)), Z), Z)) (peak)
= { by lemma 91 }
  X

Lemma 218: ldiv(rdiv(X, rdiv(T(Y, Z), Y)), Y) = ldiv(X, T(Y, Z)).
Proof:
  ldiv(rdiv(X, rdiv(T(Y, Z), Y)), Y)
= { by lemma 213 R->L }
  ldiv(ldiv(T(Y, Z), op(Y, X)), Y)
= { by lemma 201 R->L }
  ldiv(op(rdiv(Y, T(Y, Z)), X), Y)
= { by lemma 214 R->L }
  L(ldiv(X, T(Y, Z)), X, rdiv(Y, T(Y, Z))) (peak)
= { by lemma 217 }
  ldiv(X, T(Y, Z))

Lemma 219: rdiv(Y, ldiv(X, T(Y, Z))) = rdiv(X, rdiv(T(Y, Z), Y)).
Proof:
  rdiv(Y, ldiv(X, T(Y, Z)))
= { by lemma 218 R->L }
  rdiv(Y, ldiv(rdiv(X, rdiv(T(Y, Z), Y)), Y)) (peak)
= { by lemma 61 }
  rdiv(X, rdiv(T(Y, Z), Y))

Lemma 220: R(X, rdiv(T(Y, Z), Y), W) = X.
Proof:
  R(X, rdiv(T(Y, Z), Y), W)
= { by lemma 209 R->L }
  R(X, K(Y, rdiv(op(Z, T(Y, Z)), Y)), W) (peak)
= { by lemma 88 }
  X

Lemma 221: T(rdiv(T(X, Y), X), Z) = rdiv(T(X, Y), X).
Proof:
  T(rdiv(T(X, Y), X), Z)
= { by lemma 64 R->L }
  T(ldiv(X, T(X, Y)), Z) (peak)
= { by lemma 60 }
  T(K(X, Y), Z)
= { by lemma 69 }
  K(X, Y)
= { by lemma 63 R->L }
  rdiv(T(X, Y), X)

Lemma 222: ldiv(X, op(Y, rdiv(X, Y))) = K(Y, rdiv(X, Y)).
Proof:
  ldiv(X, op(Y, rdiv(X, Y)))
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(X, Y), Y), op(Y, rdiv(X, Y))) (peak)
= { by lemma 67 }
  K(Y, rdiv(X, Y))

Lemma 223: rdiv(op(K(X, Y), Z), K(X, Y)) = Z.
Proof:
  rdiv(op(K(X, Y), Z), K(X, Y)) (peak)
= { by lemma 28 }
  rdiv(op(Z, K(X, Y)), K(X, Y)) (peak)
= { by axiom 3 (sos) }
  Z

Lemma 224: rdiv(op(rdiv(T(X, Y), X), Z), rdiv(T(X, Y), X)) = Z.
Proof:
  rdiv(op(rdiv(T(X, Y), X), Z), rdiv(T(X, Y), X))
= { by lemma 209 R->L }
  rdiv(op(rdiv(T(X, Y), X), Z), K(X, rdiv(op(Y, T(X, Y)), X)))
= { by lemma 209 R->L }
  rdiv(op(K(X, rdiv(op(Y, T(X, Y)), X)), Z), K(X, rdiv(op(Y, T(X, Y)), X))) (peak)
= { by lemma 223 }
  Z

Lemma 225: rdiv(zero, rdiv(T(X, Y), X)) = rdiv(X, T(X, Y)).
Proof:
  rdiv(zero, rdiv(T(X, Y), X))
= { by lemma 221 R->L }
  rdiv(zero, T(rdiv(T(X, Y), X), X))
= { by lemma 101 R->L }
  rdiv(K(X, rdiv(T(X, Y), X)), rdiv(T(X, Y), X))
= { by lemma 222 R->L }
  rdiv(ldiv(T(X, Y), op(X, rdiv(T(X, Y), X))), rdiv(T(X, Y), X))
= { by lemma 199 R->L }
  rdiv(op(rdiv(T(X, Y), X), rdiv(X, T(X, Y))), rdiv(T(X, Y), X)) (peak)
= { by lemma 224 }
  rdiv(X, T(X, Y))

Lemma 226: R(rdiv(X, T(X, Y)), Z, W) = rdiv(X, T(X, Y)).
Proof:
  R(rdiv(X, T(X, Y)), Z, W)
= { by lemma 77 R->L }
  R(ldiv(T(X, Y), X), Z, W) (peak)
= { by lemma 66 R->L }
  R(K(Y, T(X, Y)), Z, W) (peak)
= { by lemma 54 }
  K(Y, T(X, Y))
= { by lemma 66 }
  ldiv(T(X, Y), X) (peak)
= { by lemma 77 }
  rdiv(X, T(X, Y))

Lemma 227: op(rdiv(T(X, Y), X), Z) = rdiv(Z, rdiv(X, T(X, Y))).
Proof:
  op(rdiv(T(X, Y), X), Z)
= { by lemma 39 R->L }
  ldiv(R(rdiv(zero, rdiv(T(X, Y), X)), rdiv(T(X, Y), X), Z), Z) (peak)
= { by lemma 225 }
  ldiv(R(rdiv(X, T(X, Y)), rdiv(T(X, Y), X), Z), Z)
= { by lemma 226 }
  ldiv(rdiv(X, T(X, Y)), Z)
= { by lemma 193 }
  rdiv(Z, rdiv(X, T(X, Y)))

Lemma 228: rdiv(Z, ldiv(rdiv(X, Y), T(Z, W))) = rdiv(X, rdiv(Y, rdiv(Z, T(Z, W)))).
Proof:
  rdiv(Z, ldiv(rdiv(X, Y), T(Z, W))) (peak)
= { by lemma 219 }
  rdiv(rdiv(X, Y), rdiv(T(Z, W), Z))
= { by lemma 220 R->L }
  R(rdiv(rdiv(X, Y), rdiv(T(Z, W), Z)), rdiv(T(Z, W), Z), Y) (peak)
= { by lemma 150 }
  rdiv(X, op(rdiv(T(Z, W), Z), Y))
= { by lemma 227 }
  rdiv(X, rdiv(Y, rdiv(Z, T(Z, W))))

Lemma 229: rdiv(T(X, Y), rdiv(Z, rdiv(X, T(X, Y)))) = rdiv(X, Z).
Proof:
  rdiv(T(X, Y), rdiv(Z, rdiv(X, T(X, Y)))) (peak)
= { by lemma 228 R->L }
  rdiv(X, ldiv(rdiv(T(X, Y), Z), T(X, Y)))
= { by lemma 38 }
  rdiv(X, Z)

Lemma 230: K(rdiv(X, rdiv(X, Y)), Z) = K(Y, Z).
Proof:
  K(rdiv(X, rdiv(X, Y)), Z) (peak)
= { by lemma 196 R->L }
  K(rdiv(Y, K(Y, rdiv(X, Y))), Z) (peak)
= { by lemma 141 }
  K(Y, Z)

Lemma 231: K(rdiv(X, rdiv(Y, T(Y, Z))), W) = K(X, W).
Proof:
  K(rdiv(X, rdiv(Y, T(Y, Z))), W)
= { by lemma 77 R->L }
  K(rdiv(X, ldiv(T(Y, Z), Y)), W) (peak)
= { by lemma 66 R->L }
  K(rdiv(X, K(Z, T(Y, Z))), W) (peak)
= { by lemma 141 }
  K(X, W)

Lemma 232: K(rdiv(T(X, Y), rdiv(X, Z)), W) = K(Z, W).
Proof:
  K(rdiv(T(X, Y), rdiv(X, Z)), W)
= { by lemma 229 R->L }
  K(rdiv(T(X, Y), rdiv(T(X, Y), rdiv(Z, rdiv(X, T(X, Y))))), W) (peak)
= { by lemma 230 }
  K(rdiv(Z, rdiv(X, T(X, Y))), W)
= { by lemma 231 }
  K(Z, W)

Lemma 233: rdiv(op(X, T(Y, Z)), op(Y, Z)) = R(rdiv(X, Z), Z, Y).
Proof:
  rdiv(op(X, T(Y, Z)), op(Y, Z))
= { by lemma 57 R->L }
  rdiv(op(X, T(Y, Z)), op(Z, T(Y, Z))) (peak)
= { by lemma 36 }
  R(rdiv(X, Z), Z, T(Y, Z))
= { by lemma 185 }
  R(rdiv(X, Z), Z, Y)

Lemma 234: op(R(X, Y, Z), op(Y, Z)) = op(op(X, Y), Z).
Proof:
  op(R(X, Y, Z), op(Y, Z))
= { by axiom 18 (sos) }
  op(rdiv(op(op(X, Y), Z), op(Y, Z)), op(Y, Z)) (peak)
= { by axiom 9 (sos) }
  op(op(X, Y), Z)

Lemma 235: rdiv(op(X, T(Y, Z)), K(Y, Z)) = op(X, Y).
Proof:
  rdiv(op(X, T(Y, Z)), K(Y, Z))
= { by lemma 179 R->L }
  op(rdiv(op(X, T(Y, Z)), op(Y, Z)), op(Z, Y)) (peak)
= { by lemma 233 }
  op(R(rdiv(X, Z), Z, Y), op(Z, Y))
= { by lemma 234 }
  op(op(rdiv(X, Z), Z), Y)
= { by axiom 9 (sos) }
  op(X, Y)

Lemma 236: L(ldiv(X, Y), X, rdiv(Z, X)) = ldiv(Z, op(rdiv(Z, X), Y)).
Proof:
  L(ldiv(X, Y), X, rdiv(Z, X))
= { by lemma 80 R->L }
  ldiv(op(rdiv(Z, X), X), op(rdiv(Z, X), Y)) (peak)
= { by axiom 9 (sos) }
  ldiv(Z, op(rdiv(Z, X), Y))

Lemma 237: L(ldiv(X, zero), X, rdiv(Y, X)) = ldiv(Y, rdiv(Y, X)).
Proof:
  L(ldiv(X, zero), X, rdiv(Y, X)) (peak)
= { by lemma 236 }
  ldiv(Y, op(rdiv(Y, X), zero)) (peak)
= { by axiom 1 (sos) }
  ldiv(Y, rdiv(Y, X))

Lemma 238: ldiv(op(X, T(Y, Z)), op(X, Y)) = K(Z, Y).
Proof:
  ldiv(op(X, T(Y, Z)), op(X, Y))
= { by lemma 235 R->L }
  ldiv(op(X, T(Y, Z)), rdiv(op(X, T(Y, Z)), K(Y, Z))) (peak)
= { by lemma 237 R->L }
  L(ldiv(K(Y, Z), zero), K(Y, Z), rdiv(op(X, T(Y, Z)), K(Y, Z))) (peak)
= { by lemma 186 }
  ldiv(K(Y, Z), zero)
= { by lemma 44 }
  rdiv(zero, K(Y, Z))
= { by lemma 50 }
  K(Z, Y)

Lemma 239: T(X, L(T(Y, V), U, T)) = T(X, L(Y, Z, W)).
Proof:
  T(X, L(T(Y, V), U, T))
= { by lemma 176 R->L }
  T(X, op(a(T, U, L(T(Y, V), U, T)), L(T(Y, V), U, T))) (peak)
= { by lemma 120 R->L }
  T(X, op(L(T(Y, V), U, T), a(T, U, L(T(Y, V), U, T))))
= { by lemma 129 }
  T(X, T(Y, V))
= { by lemma 177 R->L }
  T(X, L(Y, Z, W)) (peak)

Lemma 240: K(L(T(X, V), U, T), W) = K(L(X, Y, Z), W).
Proof:
  K(L(T(X, V), U, T), W)
= { by lemma 238 R->L }
  ldiv(op(S, T(W, L(T(X, V), U, T))), op(S, W)) (peak)
= { by lemma 239 }
  ldiv(op(S, T(W, L(X, Y, Z))), op(S, W)) (peak)
= { by lemma 238 }
  K(L(X, Y, Z), W)

Lemma 241: L(X, Y, rdiv(T(Z, W), Z)) = X.
Proof:
  L(X, Y, rdiv(T(Z, W), Z))
= { by lemma 209 R->L }
  L(X, Y, K(Z, rdiv(op(W, T(Z, W)), Z))) (peak)
= { by lemma 91 }
  X

Lemma 242: ldiv(rdiv(X, rdiv(Y, T(Y, Z))), T(Y, Z)) = ldiv(X, Y).
Proof:
  ldiv(rdiv(X, rdiv(Y, T(Y, Z))), T(Y, Z))
= { by lemma 227 R->L }
  ldiv(op(rdiv(T(Y, Z), Y), X), T(Y, Z)) (peak)
= { by lemma 214 R->L }
  L(ldiv(X, Y), X, rdiv(T(Y, Z), Y)) (peak)
= { by lemma 241 }
  ldiv(X, Y)

Lemma 243: rdiv(T(Y, Z), ldiv(X, Y)) = rdiv(X, rdiv(Y, T(Y, Z))).
Proof:
  rdiv(T(Y, Z), ldiv(X, Y))
= { by lemma 242 R->L }
  rdiv(T(Y, Z), ldiv(rdiv(X, rdiv(Y, T(Y, Z))), T(Y, Z))) (peak)
= { by lemma 61 }
  rdiv(X, rdiv(Y, T(Y, Z)))

Lemma 244: K(rdiv(T(X, Y), ldiv(Z, X)), W) = K(Z, W).
Proof:
  K(rdiv(T(X, Y), ldiv(Z, X)), W) (peak)
= { by lemma 243 }
  K(rdiv(Z, rdiv(X, T(X, Y))), W) (peak)
= { by lemma 231 }
  K(Z, W)

Lemma 245: K(rdiv(T(X, W), Y), Z) = K(rdiv(X, Y), Z).
Proof:
  K(rdiv(T(X, W), Y), Z)
= { by lemma 38 R->L }
  K(rdiv(T(X, W), ldiv(rdiv(X, Y), X)), Z) (peak)
= { by lemma 244 }
  K(rdiv(X, Y), Z)

Lemma 246: K(X, rdiv(T(Y, W), Z)) = K(X, rdiv(Y, Z)).
Proof:
  K(X, rdiv(T(Y, W), Z))
= { by lemma 50 R->L }
  rdiv(zero, K(rdiv(T(Y, W), Z), X)) (peak)
= { by lemma 245 }
  rdiv(zero, K(rdiv(Y, Z), X))
= { by lemma 50 }
  K(X, rdiv(Y, Z))

Lemma 247: K(X, rdiv(T(Y, Z), L(Y, W, V))) = zero.
Proof:
  K(X, rdiv(T(Y, Z), L(Y, W, V))) (peak)
= { by lemma 246 }
  K(X, rdiv(Y, L(Y, W, V)))
= { by lemma 104 R->L }
  K(X, ldiv(L(Y, W, V), Y))
= { by lemma 130 R->L }
  K(X, a(V, W, L(Y, W, V))) (peak)
= { by lemma 157 }
  zero

Lemma 248: rdiv(T(X, W), T(L(X, Y, Z), W)) = rdiv(X, L(X, Y, Z)).
Proof:
  rdiv(T(X, W), T(L(X, Y, Z), W))
= { by lemma 195 R->L }
  rdiv(T(X, W), rdiv(T(X, W), rdiv(X, L(X, Y, Z)))) (peak)
= { by lemma 196 R->L }
  rdiv(rdiv(X, L(X, Y, Z)), K(rdiv(X, L(X, Y, Z)), rdiv(T(X, W), rdiv(X, L(X, Y, Z))))) (peak)
= { by lemma 163 }
  rdiv(X, rdiv(L(X, Y, Z), K(rdiv(T(X, W), rdiv(X, L(X, Y, Z))), rdiv(X, L(X, Y, Z)))))
= { by lemma 232 }
  rdiv(X, rdiv(L(X, Y, Z), K(L(X, Y, Z), rdiv(X, L(X, Y, Z)))))
= { by lemma 240 R->L }
  rdiv(X, rdiv(L(X, Y, Z), K(L(T(X, V), U, T), rdiv(X, L(X, Y, Z)))))
= { by lemma 246 R->L }
  rdiv(X, rdiv(L(X, Y, Z), K(L(T(X, V), U, T), rdiv(T(X, S), L(X, Y, Z))))) (peak)
= { by lemma 247 }
  rdiv(X, rdiv(L(X, Y, Z), zero))
= { by lemma 26 }
  rdiv(X, L(X, Y, Z))

Lemma 249: rdiv(T(Z, W), T(L(Z, Y, X), W)) = a(X, Y, L(Z, Y, X)).
Proof:
  rdiv(T(Z, W), T(L(Z, Y, X), W)) (peak)
= { by lemma 248 }
  rdiv(Z, L(Z, Y, X))
= { by lemma 129 R->L }
  rdiv(op(L(Z, Y, X), a(X, Y, L(Z, Y, X))), L(Z, Y, X)) (peak)
= { by lemma 137 }
  a(X, Y, L(Z, Y, X))

Lemma 250: a(X, a(Y, Z, W), V) = zero.
Proof:
  a(X, a(Y, Z, W), V) (peak)
= { by axiom 15 (sos) }
  1
= { by lemma 24 }
  zero

Lemma 251: L(X, a(Y, Z, W), V) = X.
Proof:
  L(X, a(Y, Z, W), V)
= { by axiom 1 (sos) R->L }
  L(op(X, zero), a(Y, Z, W), V)
= { by lemma 250 R->L }
  L(op(X, a(V, a(Y, Z, W), X)), a(Y, Z, W), V) (peak)
= { by lemma 159 }
  X

Lemma 252: rdiv(W, rdiv(T(X, V), T(L(X, Y, Z), V))) = ldiv(X, op(L(X, Y, Z), W)).
Proof:
  rdiv(W, rdiv(T(X, V), T(L(X, Y, Z), V))) (peak)
= { by lemma 248 }
  rdiv(W, rdiv(X, L(X, Y, Z)))
= { by lemma 138 R->L }
  rdiv(W, a(Z, Y, L(X, Y, Z)))
= { by lemma 123 R->L }
  ldiv(a(Z, Y, L(X, Y, Z)), W)
= { by lemma 251 R->L }
  L(ldiv(a(Z, Y, L(X, Y, Z)), W), a(Z, Y, L(X, Y, Z)), L(X, Y, Z)) (peak)
= { by lemma 80 R->L }
  ldiv(op(L(X, Y, Z), a(Z, Y, L(X, Y, Z))), op(L(X, Y, Z), W))
= { by lemma 129 }
  ldiv(X, op(L(X, Y, Z), W))

Lemma 253: ldiv(X, op(rdiv(X, Y), op(Y, Z))) = L(Z, Y, rdiv(X, Y)).
Proof:
  ldiv(X, op(rdiv(X, Y), op(Y, Z)))
= { by axiom 9 (sos) R->L }
  ldiv(op(rdiv(X, Y), Y), op(rdiv(X, Y), op(Y, Z))) (peak)
= { by axiom 19 (sos) R->L }
  L(Z, Y, rdiv(X, Y))

Lemma 254: T(rdiv(X, K(X, Y)), op(Y, X)) = L(X, Y, rdiv(X, K(X, Y))).
Proof:
  T(rdiv(X, K(X, Y)), op(Y, X)) (peak)
= { by lemma 98 R->L }
  T(rdiv(op(Y, X), Y), op(Y, X))
= { by axiom 5 (sos) }
  ldiv(op(Y, X), op(rdiv(op(Y, X), Y), op(Y, X))) (peak)
= { by lemma 253 }
  L(X, Y, rdiv(op(Y, X), Y))
= { by lemma 98 }
  L(X, Y, rdiv(X, K(X, Y)))

Lemma 255: T(X, op(X, a(Y, Z, W))) = X.
Proof:
  T(X, op(X, a(Y, Z, W))) (peak)
= { by lemma 121 R->L }
  T(X, op(a(Y, Z, W), X))
= { by lemma 26 R->L }
  T(rdiv(X, zero), op(a(Y, Z, W), X))
= { by lemma 24 R->L }
  T(rdiv(X, 1), op(a(Y, Z, W), X))
= { by axiom 10 (sos) R->L }
  T(rdiv(X, K(X, a(Y, Z, W))), op(a(Y, Z, W), X)) (peak)
= { by lemma 254 }
  L(X, a(Y, Z, W), rdiv(X, K(X, a(Y, Z, W))))
= { by axiom 10 (sos) }
  L(X, a(Y, Z, W), rdiv(X, 1))
= { by lemma 24 }
  L(X, a(Y, Z, W), rdiv(X, zero))
= { by lemma 26 }
  L(X, a(Y, Z, W), X)
= { by lemma 251 }
  X

Lemma 256: T(L(T(X, Y), Z, W), L(X, V, U)) = L(T(X, Y), Z, W).
Proof:
  T(L(T(X, Y), Z, W), L(X, V, U)) (peak)
= { by lemma 177 }
  T(L(T(X, Y), Z, W), T(X, Y))
= { by lemma 129 R->L }
  T(L(T(X, Y), Z, W), op(L(T(X, Y), Z, W), a(W, Z, L(T(X, Y), Z, W)))) (peak)
= { by lemma 255 }
  L(T(X, Y), Z, W)

Lemma 257: T(L(X, Y, Z), L(T(X, W), V, U)) = L(X, Y, Z).
Proof:
  T(L(X, Y, Z), L(T(X, W), V, U))
= { by lemma 112 R->L }
  rdiv(op(L(X, Y, Z), L(T(X, W), V, U)), T(L(T(X, W), V, U), L(X, Y, Z))) (peak)
= { by lemma 256 }
  rdiv(op(L(X, Y, Z), L(T(X, W), V, U)), L(T(X, W), V, U))
= { by axiom 3 (sos) }
  L(X, Y, Z)

Lemma 258: rdiv(X, rdiv(T(X, Y), T(L(X, Z, W), Y))) = L(X, Z, W).
Proof:
  rdiv(X, rdiv(T(X, Y), T(L(X, Z, W), Y))) (peak)
= { by lemma 252 }
  ldiv(X, op(L(X, Z, W), X))
= { by axiom 5 (sos) R->L }
  T(L(X, Z, W), X)
= { by lemma 187 R->L }
  T(L(X, Z, W), L(X, V, U)) (peak)
= { by lemma 239 R->L }
  T(L(X, Z, W), L(T(X, T), S, X2)) (peak)
= { by lemma 257 }
  L(X, Z, W)

Lemma 259: op(L(X, Y, Z), rdiv(T(X, W), T(L(X, Y, Z), W))) = X.
Proof:
  op(L(X, Y, Z), rdiv(T(X, W), T(L(X, Y, Z), W)))
= { by lemma 258 R->L }
  op(rdiv(X, rdiv(T(X, W), T(L(X, Y, Z), W))), rdiv(T(X, W), T(L(X, Y, Z), W))) (peak)
= { by axiom 9 (sos) }
  X

Lemma 260: rdiv(T(Z, W), T(L(Z, Y, X), W)) = a(X, Y, Z).
Proof:
  rdiv(T(Z, W), T(L(Z, Y, X), W)) (peak)
= { by lemma 248 }
  rdiv(Z, L(Z, Y, X))
= { by lemma 138 R->L }
  a(X, Y, L(Z, Y, X))
= { by lemma 136 R->L }
  a(X, Y, op(L(Z, Y, X), a(X, Y, L(Z, Y, X)))) (peak)
= { by lemma 249 R->L }
  a(X, Y, op(L(Z, Y, X), rdiv(T(Z, V), T(L(Z, Y, X), V)))) (peak)
= { by lemma 259 }
  a(X, Y, Z)

Lemma 261: rdiv(T(X, V), L(T(X, V), Z, W)) = rdiv(T(X, Y), T(L(X, Z, W), Y)).
Proof:
  rdiv(T(X, V), L(T(X, V), Z, W)) (peak)
= { by lemma 145 }
  a(W, Z, T(X, V))
= { by lemma 156 }
  a(W, Z, X)
= { by lemma 260 R->L }
  rdiv(T(X, Y), T(L(X, Z, W), Y)) (peak)

Lemma 262: rdiv(X, rdiv(X, L(X, Y, Z))) = L(X, Y, Z).
Proof:
  rdiv(X, rdiv(X, L(X, Y, Z)))
= { by lemma 132 R->L }
  rdiv(X, ldiv(L(X, Y, Z), X)) (peak)
= { by lemma 61 }
  L(X, Y, Z)

Lemma 263: T(L(X, Y, Z), W) = L(T(X, W), Y, Z).
Proof:
  T(L(X, Y, Z), W)
= { by lemma 38 R->L }
  ldiv(rdiv(T(X, W), T(L(X, Y, Z), W)), T(X, W)) (peak)
= { by lemma 261 R->L }
  ldiv(rdiv(T(X, W), L(T(X, W), Y, Z)), T(X, W))
= { by lemma 188 }
  rdiv(T(X, W), rdiv(T(X, W), L(T(X, W), Y, Z)))
= { by lemma 262 }
  L(T(X, W), Y, Z)

Goal 1 (goals): T(L(x7, x8, x9), x10) = L(T(x7, x10), x8, x9).
Proof:
  T(L(x7, x8, x9), x10) (peak)
= { by lemma 263 }
  L(T(x7, x10), x8, x9)

RESULT: Theorem (the conjecture is true).
