# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------

# Local environment configuration (TPTP_ROOT, LOG_DIR, TWEE_PATH, BABBLE_ROOT)
.env

# External tools built from source (babble; see README "Prerequisites")
third_party/

# Cluster job output
slurm*.out

# Experiment outputs: track only per-run summary.json / config.yaml.
# Raw twee output and TPTP-with-hints files live in $LOG_DIR, outside the repo;
# these rules keep anything else that lands in a run directory out of git.
data/experiments/*/*/*
!data/experiments/*/*/summary.json
!data/experiments/*/*/config.yaml

# Multi-MB aggregate result files at the stage level
# (base_times.json, axiom_proof_lengths.json, hint_proof_lengths.json, ...)
data/experiments/*/*.json
!data/experiments/hard_successes/*.json

# Scratch files written by the pipeline
data/experiments/*/tmp

# Derived term corpora, regenerable via `python src/corpus/build_corpora.py`
data/corpora/

# Raw prover output from the definition-free runs (~400 MB). The problems
# themselves are tracked; the outputs are gzipped in $LOG_DIR/definition_free_out
# and can be regenerated with `python src/corpus/run_phase35.py`.
data/definition_free/*/out/

